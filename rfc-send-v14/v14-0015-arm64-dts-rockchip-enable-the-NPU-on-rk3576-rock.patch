From 077499efc37b3036aeeef7601f6dc025f18966e3 Mon Sep 17 00:00:00 2001
From: Jiaxing Hu <gahing@gahingwoo.com>
Date: Thu, 6 Aug 2026 18:30:48 +1200
Subject: [PATCH v14 15/15] arm64: dts: rockchip: enable the NPU on
 rk3576-rock-4d

Enable both RKNN cores and their IOMMUs on the Radxa ROCK 4D, and give
vdd_npu_s0 to the NPU power domain as its domain-supply, so the rail
follows the domain that gates the block. Both cores keep npu-supply on the
same rail, which the binding requires.

On a ROCK 4D with this in place the rail reports use_count 1 during an
inference and 0 with the rail disabled at rest, and inferences either side
are 128 of 128 channels against the CPU reference. Both cores probe with
their IOMMUs, and a runtime that splits its submits across them returns the
same text as a one-core run on nine language models.

Signed-off-by: Jiaxing Hu <gahing@gahingwoo.com>
---
 .../boot/dts/rockchip/rk3576-rock-4d.dts      | 22 +++++++++++++++++++
 1 file changed, 22 insertions(+)

diff --git a/arch/arm64/boot/dts/rockchip/rk3576-rock-4d.dts b/arch/arm64/boot/dts/rockchip/rk3576-rock-4d.dts
index 272af1012..93d59c0a9 100644
--- a/arch/arm64/boot/dts/rockchip/rk3576-rock-4d.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3576-rock-4d.dts
@@ -722,6 +722,10 @@ &pcie0 {
 	status = "okay";
 };
 
+&pd_npu {
+	domain-supply = <&vdd_npu_s0>;
+};
+
 &pinctrl {
 	hdmi {
 		hdmi_tx_on_h: hdmi-tx-on-h {
@@ -779,6 +783,24 @@ wifi_en_h: wifi-en-h {
 	};
 };
 
+&rknn_core_0 {
+	npu-supply = <&vdd_npu_s0>;
+	status = "okay";
+};
+
+&rknn_mmu_0 {
+	status = "okay";
+};
+
+&rknn_core_1 {
+	npu-supply = <&vdd_npu_s0>;
+	status = "okay";
+};
+
+&rknn_mmu_1 {
+	status = "okay";
+};
+
 &sai6 {
 	status = "okay";
 };
