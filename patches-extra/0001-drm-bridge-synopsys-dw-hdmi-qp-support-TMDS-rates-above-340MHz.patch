From bf01e0353815239f5e450ec8a73bc2ecea0854ac Mon Sep 17 00:00:00 2001
From: Jiaxing Hu <gahing@gahingwoo.com>
Date: Thu, 17 Sep 2026 19:23:25 +1200
Subject: [PATCH] drm/bridge: synopsys: dw-hdmi-qp: support TMDS rates above
 340 MHz

The driver rejected every mode whose TMDS character rate exceeded
HDMI_1_3_TMDS_CHAR_RATE_MAX_HZ, so nothing beyond 4k30 or 1440p75
could be driven even where both the sink and the PHY were capable of
it. On an RK3576 with a 2560x1440 display that advertises 100 Hz at
397.98 MHz, the mode was pruned although the Samsung HDPTX PHY already
switches to the 1/40 TMDS bit clock ratio above 340 MHz on its own.

Above that rate HDMI requires scrambling, which the sink has to be told
about over SCDC, and the controller has a scrambler of its own. Set
both up when the rate calls for it, clear them when it does not, and
raise the limit to HDMI_2_0_TMDS_CHAR_RATE_MAX_HZ.

The old limit stays for a bridge with no HPD: without it there is no
moment at which the SCDC write is known to have reached the sink, which
is what the TODO this replaces was about.

Only TMDS is covered here. FRL, and scrambling below 340 MHz for sinks
that ask for it, are still not implemented.

Signed-off-by: Jiaxing Hu <gahing@gahingwoo.com>
---
 drivers/gpu/drm/bridge/synopsys/dw-hdmi-qp.c | 46 ++++++++++++++++++--
 drivers/gpu/drm/bridge/synopsys/dw-hdmi-qp.h |  1 +
 2 files changed, 43 insertions(+), 4 deletions(-)

diff --git a/drivers/gpu/drm/bridge/synopsys/dw-hdmi-qp.c b/drivers/gpu/drm/bridge/synopsys/dw-hdmi-qp.c
index c9568aea9..3e3c84bdc 100644
--- a/drivers/gpu/drm/bridge/synopsys/dw-hdmi-qp.c
+++ b/drivers/gpu/drm/bridge/synopsys/dw-hdmi-qp.c
@@ -7,6 +7,7 @@
  * Author: Cristian Ciocaltea <cristian.ciocaltea@collabora.com>
  */
 #include <linux/completion.h>
+#include <linux/delay.h>
 #include <linux/hdmi.h>
 #include <linux/export.h>
 #include <linux/i2c.h>
@@ -21,6 +22,7 @@
 #include <drm/display/drm_hdmi_helper.h>
 #include <drm/display/drm_hdmi_cec_helper.h>
 #include <drm/display/drm_hdmi_state_helper.h>
+#include <drm/display/drm_scdc_helper.h>
 #include <drm/drm_atomic.h>
 #include <drm/drm_atomic_helper.h>
 #include <drm/drm_bridge.h>
@@ -540,6 +542,34 @@ static struct i2c_adapter *dw_hdmi_qp_i2c_adapter(struct dw_hdmi_qp *hdmi)
 	return adap;
 }
 
+/*
+ * A TMDS character rate above HDMI_1_3_TMDS_CHAR_RATE_MAX_HZ needs scrambling
+ * and the 1/40 TMDS bit clock ratio. The sink is told about both over SCDC;
+ * the controller has a scrambler of its own, enabled here.
+ */
+static void dw_hdmi_qp_set_scrambling(struct dw_hdmi_qp *hdmi,
+				      struct drm_connector *connector)
+{
+	const struct drm_display_info *info = &connector->display_info;
+	bool scrambling = hdmi->tmds_char_rate > HDMI_1_3_TMDS_CHAR_RATE_MAX_HZ;
+
+	if (!info->hdmi.scdc.supported || !info->hdmi.scdc.scrambling.supported) {
+		if (scrambling)
+			drm_warn(connector->dev,
+				 "sink has no SCDC, cannot scramble at %lu Hz\n",
+				 hdmi->tmds_char_rate);
+		return;
+	}
+
+	drm_scdc_set_high_tmds_clock_ratio(connector, scrambling);
+	drm_scdc_set_scrambling(connector, scrambling);
+	dw_hdmi_qp_write(hdmi, scrambling ? SCRAMB_EN : 0, SCRAMB_CONFIG0);
+
+	/* the sink resumes TMDS clock and data once it has switched over */
+	if (scrambling)
+		msleep(100);
+}
+
 static void dw_hdmi_qp_bridge_atomic_enable(struct drm_bridge *bridge,
 					    struct drm_atomic_commit *state)
 {
@@ -572,6 +602,9 @@ static void dw_hdmi_qp_bridge_atomic_enable(struct drm_bridge *bridge,
 	dw_hdmi_qp_mod(hdmi, HDCP2_BYPASS, HDCP2_BYPASS, HDCP2LOGIC_CONFIG0);
 	dw_hdmi_qp_mod(hdmi, op_mode, OPMODE_DVI, LINK_CONFIG0);
 
+	if (connector->display_info.is_hdmi)
+		dw_hdmi_qp_set_scrambling(hdmi, connector);
+
 	drm_atomic_helper_connector_hdmi_update_infoframes(connector, state);
 }
 
@@ -581,6 +614,7 @@ static void dw_hdmi_qp_bridge_atomic_disable(struct drm_bridge *bridge,
 	struct dw_hdmi_qp *hdmi = bridge->driver_private;
 
 	hdmi->tmds_char_rate = 0;
+	dw_hdmi_qp_write(hdmi, 0, SCRAMB_CONFIG0);
 
 	hdmi->phy.ops->disable(hdmi, hdmi->phy.data);
 }
@@ -622,13 +656,17 @@ dw_hdmi_qp_bridge_tmds_char_rate_valid(const struct drm_bridge *bridge,
 				       unsigned long long rate)
 {
 	struct dw_hdmi_qp *hdmi = bridge->driver_private;
+	unsigned long long max_rate = HDMI_2_0_TMDS_CHAR_RATE_MAX_HZ;
 
 	/*
-	 * TODO: when hdmi->no_hpd is 1 we must not support modes that
-	 * require scrambling, including every mode with a clock above
-	 * HDMI_1_3_TMDS_CHAR_RATE_MAX_HZ.
+	 * Above HDMI_1_3_TMDS_CHAR_RATE_MAX_HZ the sink has to be switched to
+	 * scrambling over SCDC. Without HPD there is no moment at which that
+	 * is known to reach the sink, so stay below the rate that needs it.
 	 */
-	if (rate > HDMI_1_3_TMDS_CHAR_RATE_MAX_HZ) {
+	if (hdmi->no_hpd)
+		max_rate = HDMI_1_3_TMDS_CHAR_RATE_MAX_HZ;
+
+	if (rate > max_rate) {
 		dev_dbg(hdmi->dev, "Unsupported TMDS char rate: %lld\n", rate);
 		return MODE_CLOCK_HIGH;
 	}
diff --git a/drivers/gpu/drm/bridge/synopsys/dw-hdmi-qp.h b/drivers/gpu/drm/bridge/synopsys/dw-hdmi-qp.h
index c07847e8d..de7dc51ea 100644
--- a/drivers/gpu/drm/bridge/synopsys/dw-hdmi-qp.h
+++ b/drivers/gpu/drm/bridge/synopsys/dw-hdmi-qp.h
@@ -173,6 +173,7 @@
 #define HDCP14_STATUS1					0x938
 /* Scrambler Registers */
 #define SCRAMB_CONFIG0					0x960
+#define SCRAMB_EN					BIT(0)
 /* Video Configuration Registers */
 #define LINK_CONFIG0					0x968
 #define OPMODE_FRL_4LANES				BIT(8)
-- 
2.43.0

