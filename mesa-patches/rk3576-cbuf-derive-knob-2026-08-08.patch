From 100d2a400e87b0b0bff98217af6984a00d95eee3 Mon Sep 17 00:00:00 2001
From: Jiaxing Hu <huhuvmb88@outlook.com>
Date: Fri, 7 Aug 2026 23:40:25 +1200
Subject: [PATCH] rocket RK3576: ROCKET_CBUF_DERIVE knob for 0x1018 and 0x1040

The vendor does not key these off the stride. Compiling .rknn across a width and
channel sweep flips both exactly where the op stops fitting one row window: 16
channels at 128x128 reads 0x40000404 and 0x10000000, 144x144 splits and reads
0x40000505 and 0x14000000, and holding 80x80 while raising the input channels
flips at the same place.

Not the default: cal_s1 computes correctly with the stride-keyed value where the
vendor would use the other one, so these two tolerate being wrong at least
there. The knob exists so mn_pw24, where the stride and the split disagree, can
be run both ways in one boot.
---
 src/gallium/drivers/rocket/rkt_regcmd.c | 19 +++++++++++++++++--
 1 file changed, 17 insertions(+), 2 deletions(-)

diff --git a/src/gallium/drivers/rocket/rkt_regcmd.c b/src/gallium/drivers/rocket/rkt_regcmd.c
index a99a457..184a636 100644
--- a/src/gallium/drivers/rocket/rkt_regcmd.c
+++ b/src/gallium/drivers/rocket/rkt_regcmd.c
@@ -423,7 +423,22 @@ fill_regcmd_rk3576_normal(struct rkt_ml_subgraph *subgraph,
    R_CNA(0x1014, (s << 3) | s);
    /* stride-2 wants 0x...0404 (both the conv0 capture and this k=5 s=2 conv);
     * 0x...0505 was the stride-1 value the generic path was calibrated on. */
-   R_CNA(0x1018, (s == 2 ? 0x40000404 : 0x40000505) | (wnum > 0 ? 0x80000000 : 0));
+   /*
+    * ROCKET_CBUF_DERIVE: 0x1018 and 0x1040 are keyed off the stride here, and
+    * the vendor does not key them off the stride. Compiling .rknn across a width
+    * and channel sweep (vendor-capture/gen_geom.py) flips both exactly where the
+    * op stops fitting in one row window: 16 channels at 128x128 is one window
+    * and reads 0x40000404 / 0x10000000, 144x144 splits and reads 0x40000505 /
+    * 0x14000000, and holding 80x80 while raising the input channels flips at the
+    * same place (32 in one window, 48 split).
+    *
+    * ⚠ Not the default, because cal_s1 computes correctly WITH the stride-keyed
+    * value where the vendor would use the other one, so these two tolerate being
+    * wrong at least there. This is a knob to A/B, not a fix to ship.
+    */
+   bool cbuf_derive = getenv("ROCKET_CBUF_DERIVE") != NULL;
+   bool split = cbuf_derive ? capped : (s != 2);
+   R_CNA(0x1018, (split ? 0x40000505 : 0x40000404) | (wnum > 0 ? 0x80000000 : 0));
    R_CNA(0x101c, dw ? (oc * k * k * 2) : (ic * oc * k * k));
    R_CNA(0x1020, (dw ? oc : ic) * k * k);
    R_CNA(0x1024, (k_word << 16) | (dw ? 1 : (oc - 1)));
@@ -448,7 +463,7 @@ fill_regcmd_rk3576_normal(struct rkt_ml_subgraph *subgraph,
     * never fires (wt_rd=0) while the dw's small weights do -- an execution-state skip
     * ("weights already staged"). A fresh (empty) weight bank should force the pw layer
     * to DMA its weights. dw keeps bank 0 (it fetches fine). Test: pw wt_rd 0 -> >0? */
-   R_CNA(0x1040, (s == 2 ? 0x10000000 : 0x14000000)
+   R_CNA(0x1040, (split ? 0x14000000 : 0x10000000)
                  | ((wnum > 0 && (!tile_jobs || tile_cbuf)) ? task->cbuf_input_row_start * surf : 0)
                  | ((rkt_env_u32("ROCKET_FC_BANK", 0) & 0x7) << 8)
                  | CNA_CBUF_CON0_WEIGHT_BANK(dw ? 0 : rkt_env_u32("ROCKET_WT_BANK", 0)));
