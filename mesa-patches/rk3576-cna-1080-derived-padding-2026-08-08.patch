From 431604e367e2b21b099271cd6eed8cf08e7df9ce Mon Sep 17 00:00:00 2001
From: Jiaxing Hu <huhuvmb88@outlook.com>
Date: Fri, 7 Aug 2026 23:33:44 +1200
Subject: [PATCH] rocket RK3576: derive CNA 0x1080 from the task padding
 instead of hardcoding it

0x1080 packs the four padding amounts, confirmed by compiling vendor .rknn at
chosen geometries and reading the register back: at k=5 stride 1 on 80x80 the
ONNX pad 0/1/2 gives 0x00000000/0x01010101/0x02020202, an asymmetric before 1
after 2 gives 0x02020101, before 2 after 1 gives 0x01010202, and the vendor's
tiled depthwise gives the top pad only on the first row window and the bottom
pad only on the last.

  0x1080 = (pad_right << 24) | (pad_bottom << 16) | (pad_left << 8) | pad_top

The constant this replaces, 0x02020101 for any stride-2 conv, is tflite SAME
padding for a 5x5 stride-2 conv, which is the one conv it was captured from. A
stride-1 conv got 0, meaning no padding at all.

rkt_split_tasks already computes pad_top/bottom/left/right per task with the
windowing; the RK3576 path never read them. ROCKET_PAD_LADDER=1 restores the
constants as a control.
---
 src/gallium/drivers/rocket/rkt_regcmd.c | 82 +++++++++++++++++++++++--
 1 file changed, 76 insertions(+), 6 deletions(-)

diff --git a/src/gallium/drivers/rocket/rkt_regcmd.c b/src/gallium/drivers/rocket/rkt_regcmd.c
index c80a495..a99a457 100644
--- a/src/gallium/drivers/rocket/rkt_regcmd.c
+++ b/src/gallium/drivers/rocket/rkt_regcmd.c
@@ -475,11 +475,50 @@ fill_regcmd_rk3576_normal(struct rkt_ml_subgraph *subgraph,
     * single-task dw to the vendor tile-0 value 0x01000101 to test whether the
     * byte-2 flag gates the depthwise compute (clean: single-task, no multi-
     * task PC confound). */
-   R_CNA(0x1080, s == 2 ? (dw ? 0x101 : 0x02020101)
-                        : (dw ? (capped ? (wnum > 0 ? 0x01010100 : 0x01000101)
-                                        : (getenv("ROCKET_DW_SURF0")
-                                               ? 0x01000101 : 0x01010101))
-                              : 0));
+   /*
+    * 0x1080 is the PADDING register, and it is derivable. Compiling vendor
+    * .rknn files at chosen geometries on the host (vendor-capture/gen_geom.py)
+    * and reading this register back (ladder.py) pins the encoding:
+    *
+    *   0x1080 = (pad_after_w << 24) | (pad_after_h << 16)
+    *          | (pad_before_w << 8) | pad_before_h
+    *
+    * Direct test at k=5 stride 1 on 80x80, ONNX pads 0/1/2:
+    *   pad 0 -> 0x00000000   pad 1 -> 0x01010101   pad 2 -> 0x02020202
+    * and the asymmetric pair confirms which half is which: conv2d.onnx
+    * (before 1, after 2) gives 0x02020101, the same geometry with symmetric
+    * pad 2 (before 2, after 1) gives 0x01010202. The vendor's tiled depthwise
+    * gives 0x01000101 on tile 0 and 0x01010100 after it, which is the top pad
+    * on the first window and the bottom pad on the last, and nothing in the
+    * middle.
+    *
+    * The ladder this replaces emitted 0x02020101 for every stride-2 conv,
+    * which is exactly SAME padding for a 5x5 stride-2 conv. That is
+    * conv2d-cal's own padding, taken from the capture it was fitted to, and it
+    * is the reason conv2d-cal is the only geometry that has ever computed
+    * correctly here: a stride-1 conv got 0 (no padding at all) and every other
+    * stride-2 conv got 5x5's.
+    *
+    * ROCKET_PAD_LADDER=1 restores the old constants as a control.
+    */
+   uint32_t pad_reg;
+   if (getenv("ROCKET_PAD_LADDER")) {
+      pad_reg = s == 2 ? (dw ? 0x101 : 0x02020101)
+                       : (dw ? (capped ? (wnum > 0 ? 0x01010100 : 0x01000101)
+                                       : (getenv("ROCKET_DW_SURF0")
+                                              ? 0x01000101 : 0x01010101))
+                             : 0);
+   } else {
+      /*
+       * rkt_split_tasks already computes these per task, with the windowing the
+       * vendor's tiled depthwise shows: pad_top only on the first row window,
+       * pad_bottom only on the last. Until now the RK3576 path ignored them and
+       * only the legacy RK3588 PAD_CON0 emit used them at all.
+       */
+      pad_reg = (task->pad_right << 24) | (task->pad_bottom << 16) |
+                (task->pad_left << 8) | task->pad_top;
+   }
+   R_CNA(0x1080, pad_reg);
    /*
     * CNA pad value = input_zero_point - 0x80 (the value the CMAC sees for padded taps,
     * so a padded tap contributes 0 like tflite SAME padding). This was hardcoded to
@@ -714,6 +753,23 @@ fill_first_regcmd(struct rkt_ml_subgraph *subgraph,
    unsigned weights_zero_point = task->weights_zero_point;
    unsigned offset = output_zero_point - 0x80;
 
+   /*
+    * ROCKET_FP16 (a8w16 experiment, run-once diagnostic). rkt_coefs.c dequantises
+    * the int8 weights to real-valued fp16 (bypassing the value-dependent int8 SDP
+    * coefficient blob). The regcmd half is wired here: PROC_PRECISION=2 (fp16) on
+    * the CNA + CORE MAC, and OUT_CVT drops the weights_scale (already baked into the
+    * fp16 weights) so the requant is the derivable in_sc/out_sc.
+    *
+    * The input activation stays uint8 (it arrives at RUNTIME, so mesa cannot pre-
+    * convert it at compile time) -> this is an a8w16 MAC, NOT the vendor's captured
+    * a16w4. Whether the RK3576 CMAC accepts a8w16 is UNKNOWN; that is what this one
+    * run decides: structured/non-zero output = a8w16 engages (next: add the per-
+    * channel -in_zp*Sum(w_real) bias); zero-rail = HW needs a16w16 (fp16 input),
+    * which requires a runtime input-convert pass (the multi-day port, out of scope).
+    * Weight path already gates on !depthwise; mirror that here.
+    */
+   bool fp16 = getenv("ROCKET_FP16") && !operation->depthwise;
+
    /*
     * PP_CLEAR fires at the END of this regcmd (just before 0x0041), after all
     * shadow registers have been written.  This ensures each job triggers its
@@ -773,6 +829,10 @@ fill_first_regcmd(struct rkt_ml_subgraph *subgraph,
    if (operation->depthwise)
       con1 |= CNA_CONV_CON1_CONV_MODE(3);
 
+   /* fp16 MAC precision (a8w16): IN_PRECISION stays 0 (uint8 input). */
+   if (fp16)
+      con1 |= CNA_CONV_CON1_PROC_PRECISION(2);
+
    EMIT(REG_CNA_CONV_CON1, con1);
 
    /* Re-arm A: keep POINTER=0 so subsequent writes go to Group 0 shadow. */
@@ -959,6 +1019,10 @@ fill_first_regcmd(struct rkt_ml_subgraph *subgraph,
    if (operation->depthwise)
       misc_cfg |= CORE_MISC_CFG_DW_EN(1);
 
+   /* fp16 MAC precision on the CORE array (matches CNA PROC_PRECISION). */
+   if (fp16)
+      misc_cfg |= CORE_MISC_CFG_PROC_PRECISION(2);
+
    EMIT(REG_CORE_MISC_CFG, misc_cfg);
    EMIT(REG_CORE_DATAOUT_SIZE_0,
         CORE_DATAOUT_SIZE_0_DATAOUT_HEIGHT(task->output_height - 1) |
@@ -1172,8 +1236,14 @@ fill_first_regcmd(struct rkt_ml_subgraph *subgraph,
       EMIT(REG_DPU_EW_RELUX_CMP_VALUE, 0);
       EMIT(REG_DPU_OUT_CVT_OFFSET, offset);
 
+      /*
+       * fp16: the weights_scale is already baked into the real-valued fp16 weights
+       * (rkt_coefs.c), so the remaining requant is just in_sc/out_sc (derivable,
+       * not the value-dependent blob). int8 keeps the in_sc*wt_sc/out_sc form.
+       */
       float conv_scale =
-         (task->input_scale * task->weights_scale) / task->output_scale;
+         fp16 ? (task->input_scale / task->output_scale)
+              : (task->input_scale * task->weights_scale) / task->output_scale;
       // DBG("conv_scale %f\n", conv_scale);
       uint32_t scale_bits = fui(conv_scale);
       /* Taken from
-- 
