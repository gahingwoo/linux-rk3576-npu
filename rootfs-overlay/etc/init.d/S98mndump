# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-11 round 57. Is what is left of depthwise a single scale?
#
# Round 56's honest metric:
#
#   mn_dw1    9 of 32 match, but COMPUTED 1        baseline COMPUTED 0
#   mn_dw25   432 of 1024 match, but COMPUTED 2    baseline COMPUTED 0
#   regular   128 of 128 match, COMPUTED 128       the metric's control, passes
#
# So round 55's numbers were mostly a saturated output agreeing with a saturated
# reference, and the real depthwise state is 1 and 2 channels, not 9 and 432.
#
# What is NOT an artefact: on the shipped configuration mn_dw1 has ZERO channels
# where the hardware is constant and the reference varies, against 14 on the
# round 53 baseline, and mn_dw25 has 197 against 227. The depthwise conv now
# fires everywhere. Its numbers are wrong.
#
# Everything upstream is verified against the vendor capture: the weight buffer
# 288 of 288 lanes, the fourteen depthwise registers, the 48 byte record, and A
# and C at 32 of 32 channels each. Two things were checked offline this round
# and both came back closed:
#
#   the vendor's INPUT buffer is byte identical between the depthwise and the
#   regular model, same size, same ramp, so there is no depthwise-specific
#   feature layout to get wrong
#
#   the capture cannot answer the output question at all: it is taken before
#   the run, so every output buffer in it is zero. Do not try again.
#
# That leaves the one convention this driver picks rather than derives, the
# requant magnitude. mesa writes C in Q4 and the OUT_CVT shift it computes; the
# vendor writes C in Q14 with a shift two larger. If what remains is a single
# power of two, one shift on this sweep turns many channels COMPUTED at once.
# C and the shift are the same knob in opposite directions, so sweeping the
# shift alone covers both, and the sweep is on the honest metric.
#
# Nothing in the driver changed. Every knob here is already in the shipped
# libteflon.so.
#
# DECISION RULE, written before the run:
#   one shift makes mn_dw1 COMPUTED jump      what is left is a scale, and the
#                                             next round derives it properly
#   COMPUTED stays at 0 or 1 across the sweep the remaining error is NOT a
#                                             global scale, and the next round
#                                             must look per channel or at the
#                                             MAC itself
#   conv2d-cal at +1 does not break           the knob is not reaching the
#                                             hardware and the sweep is void
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
p() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== 0) the knob must MOVE a shape that works, or the sweep is void ====="
	p conv2d-cal.tflite ""
	p conv2d-cal.tflite ROCKET_OUT_SHIFT_ADD=1

	log ""
	log "===== 1..7) mn_dw1, OUT_CVT shift swept around the computed value ====="
	p mn_dw1.tflite ROCKET_OUT_SHIFT_ADD=-3
	p mn_dw1.tflite ROCKET_OUT_SHIFT_ADD=-2
	p mn_dw1.tflite ROCKET_OUT_SHIFT_ADD=-1
	p mn_dw1.tflite ""
	p mn_dw1.tflite ROCKET_OUT_SHIFT_ADD=1
	p mn_dw1.tflite ROCKET_OUT_SHIFT_ADD=2
	p mn_dw1.tflite ROCKET_OUT_SHIFT_ADD=3

	log ""
	log "===== 8..10) the same on mn_dw25, 1024 channels ====="
	p mn_dw25.tflite ROCKET_OUT_SHIFT_ADD=-2
	p mn_dw25.tflite ""
	p mn_dw25.tflite ROCKET_OUT_SHIFT_ADD=2

	log ""
	log "===== 11..12) C directly, in case it is not equivalent to the shift ====="
	p mn_dw1.tflite ROCKET_C_VALUE=64
	p mn_dw1.tflite ROCKET_C_VALUE=4

	log ""
	log "===== 13) regular shape, unswept, must still be 128 COMPUTED ====="
	p cal_k3.tflite ""

	log ""
	log "===== Read COMPUTED, not the match count. Check test 0 first: if   ====="
	log "===== conv2d-cal is still 128 COMPUTED at +1, the knob is inert.   ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
