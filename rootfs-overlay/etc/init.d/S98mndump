# ---------------------------------------------------------------------------
# 2026-08-11 round 92. Name the channel that is five percent out.
#
# Round 91's neutral fill is INERT. It and its control are byte for byte the
# same: a median 0.9991, minimum 0.9486, maximum 1.0009, residual 99.5, 99.5,
# 99.6, 99.7 and 7.9 percent at a rail, both ways. So the hardware does not
# read the fourth group of each 16 byte unit and that hypothesis is dead. The
# change stays because it removes a -23 weight from a lane that should be
# neutral, but it is recorded as verified inert, not as a fix.
#
# conv0's structural surface is now exhausted. All of these are excluded, each
# with a control or a vendor comparison:
#
#   22 of 22 hardcoded registers    identical to the vendor
#   the ARGB weight layout          864 of 864 lanes
#   the padding amounts             fixed, confirmed by the impulse decode
#   the pad value                   derived, inert here
#   the requant offset and shift    derived, confirmed by predicting a = 1
#   the multiplier's magnitude      swept, moves a exactly, residual unmoved
#   the int32 overflow              swept with a control that bites, unmoved
#   the unreached weight lanes      swept, byte for byte unmoved
#
# What is left is not global. Through every one of those the fit has held a
# median of 0.9991 with a MINIMUM of 0.9486: one channel five percent out while
# the rest sit at 1.000. A global multiplier cannot do that, and none of the
# knobs above touched it.
#
# The report has never said WHICH channel. perch.py now prints the three
# lowest and three highest per-channel a with their b, which is the only way to
# ask what is special about that channel's weights or bias, and mn_conv0.tflite
# is on the host so the answer is offline once the number is known.
#
# Nothing in the driver changed this round.
#
# DECISION RULE, written before the run:
#   one channel far out, the rest    look at its weights and bias offline; a
#     tight                          single channel is a data question, not a
#                                    register one
#   a spread of channels             it is not one bad channel but a gradient,
#                                    and the ordering will say along what
#   the extremes move run to run     it is noise in the fit, not a property of
#                                    the model
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
p() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== 1) conv0: which channels are the outliers? ====="
	p mn_conv0.tflite ""

	log ""
	log "===== 2) the same, twice, so the extremes can be checked stable ====="
	p mn_conv0.tflite ""

	log ""
	log "===== 3) with the measured multiplier, which shifts a but not the ====="
	log "=====    spread, so the outlier should keep its place            ====="
	p mn_conv0.tflite ROCKET_FC_SCALE=0x7699

	log ""
	log "===== 4..5) the impulse models, which have no bias and one tap ====="
	p fc_impb.tflite ""
	p fc_allw.tflite ""

	log ""
	log "===== 6) the chain ====="
	p mn_conv0dw1.tflite ""

	log ""
	log "===== 7..9) REGRESSION ====="
	p conv2d-cal.tflite ""
	p mn_dw1.tflite ""
	p mn_dw25.tflite ""

	log ""
	log "===== Tests 1 and 2 are the same run twice. If the outlier moves  ====="
	log "===== between them it is noise in the fit, not a bad channel.     ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
