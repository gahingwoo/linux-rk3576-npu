# ---------------------------------------------------------------------------
# 2026-08-21 round 301. A 4096 byte weight fetch budget, or the reason there is
# not one.
#
# 300 GAVE THREE DIFFERENT ANSWERS AND THEY ARE NOT THE SAME PROBLEM.
#
#   0x3020 at K = 256   111 -> 40, 127 -> 40, 143 -> 56, 175 -> 56, 207 -> 40,
#                       255 -> 40. Non monotonic, and exact is wrote - 8 in
#                       every one of them.
#   SIZE_E_2 at K = 256 1, 2, 3 give 32, 36 and 40 written, the same additive
#                       0, 4, 8 as K = 64, and exact stays 32 throughout.
#   K = 192             wrote 64 of 64 and 32 of 32, EVERYTHING written, and
#                       exact 0. That is a layout fault, not a count one.
#
# ⚠ SO AT K = 256 THIRTY TWO CHANNELS ARE CORRECT WHATEVER IS WRITTEN. Put that
# beside the K where everything works, in bytes of weight actually fetched, which
# is K/2 a channel:
#
#   K =  64  N = 88 correct    88 x 32  = 2816
#   K = 128  N = 64 correct    64 x 64  = 4096
#   K = 256  N = 32 correct    32 x 128 = 4096
#
# Two of them land on 4096 exactly and the third is under it. A 4096 byte weight
# fetch budget a job explains all three, and it is the shape of thing an LLM
# projection at K = 2048 has to be tiled against, which makes it a bound to
# measure rather than a mystery.
#
# ⚠ IT DOES NOT EXPLAIN K = 192, where 64 channels want 6144 bytes and all 64
# are written. That is the other fault and it gets its own entry.
#
# THE READING RULE, fixed before the run.
#
#   ⚠ ENTRIES 3 TO 6 ARE THE BUDGET, and every one is a derived prediction:
#
#     K =  64  N = 128   4096 exactly      predict all 128 correct
#     K =  64  N = 160   5120, over        predict 128 correct, 32 not
#     K = 128  N =  96   6144, over        predict 64 correct
#     K = 256  N =  32   4096 exactly      predict all 32 correct
#
#     all four land       the budget is 4096 bytes and int4 tiles against a
#                         known bound
#     the over ones cap
#     somewhere else      the budget is a different number and these say what
#     N = 128 at K = 64
#     is not exact        it is not a byte budget at all, since that shape sits
#                         exactly on the line that K = 128 N = 64 already passes
#
#   ⚠ ENTRY 7 IS K = 192, which is a different fault. Everything is written and
#   nothing is right, so its --map grid is what to read, not its score. 192 is
#   the first K tried that is not a power of two.
#
#   ENTRY 2 is K = 64 and K = 128, the fourteen geometry path.
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
MM=/opt/charsiu/charsiu_matmul
CH=/opt/charsiu/charsiu_int4
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

c() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $*"; return 0; }
	before=$(nbad)
	sleep 1
	env $1 $2 $3 $4 $5 $6 $7 $8 $9 > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This arm is VOID."; health; }
	return 0
}

M4="CHARSIU_W4=1 CHARSIU_W4_HALFK=1"

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	if [ -w /sys/module/rocket/parameters/reset_autosuspend ]; then
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend
		log "reset_autosuspend = $(cat /sys/module/rocket/parameters/reset_autosuspend)"
	else
		log "!! reset_autosuspend NOT WRITABLE. A timeout will kill the round."
	fi

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== 2) K = 64 and K = 128, the fourteen geometry path            ====="
	c "$M4" X=1 $MM 1 64 64
	c "$M4" X=1 $MM 1 64 88
	c "$M4" X=1 $MM 1 128 64
	c "$M4" X=1 $MM 1 128 24

	log ""
	log "##### THE ROUND. a 4096 byte weight fetch budget, four predictions. #####"
	log ""
	log "===== 3) K = 64  N = 128.  4096 exactly. Predict all 128 correct.  ====="
	c "$M4" X=1 $MM 1 64 128
	log ""
	log "===== 4) K = 64  N = 160.  5120, over. Predict 128 correct.        ====="
	c "$M4" X=1 $MM 1 64 160
	log ""
	log "===== 5) K = 128 N = 96.   6144, over. Predict 64 correct.         ====="
	c "$M4" X=1 $MM 1 128 96
	log ""
	log "===== 6) K = 256 N = 32.   4096 exactly. Predict all 32 correct.   ====="
	c "$M4" X=1 $MM 1 256 32

	log ""
	log "===== 7) K = 192, the other fault. Read the grid, not the score.   ====="
	c "$M4" X=1 $MM 1 192 64
	c X=1 X=1 $CH 1 192 64 --map 8

	log ""
	log "===== the control that must FAIL, and int8 at K = 64 N = 128       ====="
	c "CHARSIU_W4=1" X=1 $MM 1 128 64
	c X=1 X=1 $MM 1 64 128

	log ""
	log "===== the anchor again                                             ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== four predictions, and K = 192's grid.                        ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
