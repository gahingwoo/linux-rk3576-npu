# ---------------------------------------------------------------------------
# 2026-08-20 round 263. Turn 262's fit into a reading, and find the other
# forty eight channels.
#
# WHAT 262 GOT. The dense sweep hit the first branch of its own reading rule,
# with the control passing too: bytes 9 to 15 continued channel 4 at k = 18 to
# 30, and 17 to 31 came back channel 8 at k = 2 to 14 then channel 12 at k = 16
# upward. An eight byte block is one channel and one k block.
#
# A rule through every one of the 88 measured points, no miss:
#
#   G = B/128,  b = B%128,  blk = b/8
#   b >= 64             dead
#   channel = 4*blk + 32*(G & 1)
#   k       = 16*(blk & 1) + 2*(b % 8) + 32*(G >> 1), high nibble +1
#
# It also explains 261's K dependence without being asked to. A byte whose
# 32*(G >> 1) reaches K is out of range and dead, which is why 512 was dead at
# K = 64 and came back as k = 64 at K = 128.
#
# ⚠ IT IS STILL A FIT, and 262's own harness said not to put one in the tree
# from a single log. Six bytes nobody has measured are in this round with the
# rule's answers written above the byte list before the run:
#
#   byte  57  channel 28  k 18      byte 100  dead
#   byte 140  channel 36  k 24      byte 200  dead
#   byte 384  channel 32  k 32
#   byte 392  channel 36  k 48
#
# THE OTHER THING, and it is the bigger one. Every channel that rule produces
# is a multiple of four. At 64 output channels it addresses 16 of them and has
# nothing to say about the other 48. The probe was reporting the FIRST channel
# that lights and breaking, which cannot tell a nibble that feeds channel 4j
# from one that feeds 4j through 4j+3. It now prints all of them.
#
# THE READING RULE, fixed before the run.
#
#   Read the channel lists first, on bytes 0 and 8.
#
#     one channel each, 0 and 4      the map really does skip 1, 2 and 3, and
#                                    48 of 64 channels are somewhere unprobed
#     four channels, 0-3 and 4-7     the channel dimension is four wide per
#                                    nibble and the map is complete
#
#   Then the six predictions. Six for six turns the fit into a reading and the
#   packer can be written from it. Any miss and the rule is wrong somewhere
#   the dense sweep could not see, which is worth more than six hits.
#
#   ⚠ A partial result is the interesting one. If four of six land, read WHICH
#   two missed before touching the formula.
#
#   ⚠ Anchors either side. A dead byte with a dead block above it is not a
#   measurement.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	after=$(nbad)
	if [ "$after" != "$before" ]; then
		log "  !! POISON in this entry. The block faulted. This result is VOID."
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" \
			> /tmp/hc.txt 2>&1
		if grep -q "128/128 channels match" /tmp/hc.txt; then
			log "  !! health OK, the block recovered, continuing"
		else
			log "  !! health FAILED, the block is gone. ABORTING the round."
			ABORT=1
		fi
	fi
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	if [ -w /sys/module/rocket/parameters/reset_autosuspend ]; then
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend
		log "reset_autosuspend = $(cat /sys/module/rocket/parameters/reset_autosuspend)"
	else
		log "!! reset_autosuspend NOT WRITABLE. A timeout will kill the round."
	fi

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== 2) SIX PREDICTIONS AND THE CHANNEL LISTS.                    ====="
	log "=====    57 -> ch 28 k 18     140 -> ch 36 k 24                    ====="
	log "=====    384 -> ch 32 k 32    392 -> ch 36 k 48                    ====="
	log "=====    100 and 200 -> dead                                       ====="
	log "=====    and bytes 0, 8, 16, 24 with every channel printed         ====="
	log ""
	sleep 1
	/opt/charsiu/charsiu_int4 1 64 64 --kpair > "$C" 2>&1

	log ""
	log "===== 3) the same at K = 128, where 384 and 392 are in range for   ====="
	log "=====    a different reason, so the rule is not tested at one K    ====="
	sleep 1
	/opt/charsiu/charsiu_int4 1 128 64 --kpair > "$C" 2>&1

	log ""
	log "===== 4) the anchor again                                          ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== Read 1 and 2, then 3 against 4. The bar is the arm beside it ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
