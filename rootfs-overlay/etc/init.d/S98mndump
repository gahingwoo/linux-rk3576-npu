#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-23 round 341. THE LAST TWO REGISTERS, THEN THE CAPTURE.
#
# ROUND 340's CONTROLS BOTH REPRODUCED, so what it says can be trusted.
#
#   the map, both modes    w = 32*floor(s/K) + (s mod 32), unchanged
#   the k, 16 bit mode     byte j of a slot carries k = 2j and 2j+1
#   the k, A8_STRIDE1      byte j carries k = 4j+1 and 4j+3, and the SECOND
#                          slot of every word is dead: bytes 256, 260, 264 and
#                          1280 pair with nothing at all
#
# ⚠ **Odd k, spaced two apart, is what reading the HIGH BYTE of a two byte pair
# looks like.** The hatch changed OUR packing and the hardware kept its two byte
# activation stride, so that mode reaches a quarter of the k and is not a
# different arithmetic, it is the same arithmetic reading half a vector.
#
# Which leaves the register story short of two entries. The 117 register diff
# against the vendor's own int4 op has five differences and three are settled:
# 0x3020 and 0x40b8 are the pair that makes the write work, and 0x100c bit 29
# changes NOTHING, output identical to six digits. The other two have never been
# run with the packing right:
#
#     CNA  0x1098   vendor 00000001   charsiu 00000004
#     CORE 0x3018   vendor 10000200   charsiu 10000001
#
# 0x1098 was tried in round 329 with the old packing and 0x3018's only arm in
# round 339 timed out and returned zeros, which my metric then scored as a pass.
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# THE PLAIN WEIGHTED SUM LINE, and it prints a live word count now, so a dead
# arm says VOID instead of scoring. Entry 2 is the control and must print the
# old reference at 64 of 64 with the plain sum at 0.
#
# ⚠ IF NOTHING HERE MOVES IT, the register surface is exhausted and the next
# thing is a vendor capture: run their stack, take the register stream AND the
# buffers it points at, and replay the bytes rather than reasoning about them.
# That is the method that settled the dispatch wall, and it is the honest next
# step rather than a ninth guess.
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT
# ---------------------------------------------------------------------------
#
# Neither of these is it. 0x1098 is a rounded-up row count and 0x3018 sits with
# the other CORE geometry, and neither has the shape of something that picks an
# arithmetic. I am running them because they are the last two and because "we
# never tried it with the packing right" has already been the answer once.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
RUN=/opt/charsiu/charsiu_run
BE=/opt/charsiu/charsiu_bench
MM=/opt/charsiu/charsiu_matmul
I4=/opt/charsiu/charsiu_int4
M4="CHARSIU_W4=1 CHARSIU_W4_HALFK=1"
M8=/opt/charsiu/models/Llama-3.2-1B-Instruct-Q8_0.gguf
PROMPT="The capital of France is"
LIMIT=420
ARMCAP=240
CE=CHARSIU_COEF_ELEMS=65536
HEAD=CHARSIU_NPU_MAXN=131072
B8="CHARSIU_OVERRIDE=0x40b8=3"
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

# Igor's scorer, not ours: it compares against the RAW cpu output and prints
# the constant-reference-channel guard on every model.
ocp() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $1"; return 0; }
	before=$(nbad)
	log ""
	log "  -- $1"
	sleep 1
	capped "$ARMCAP" env TEFLON_LIB=$WORK python3 "$NPU_DIR/oc_perch.py" \
		"$NPU_DIR/$1" > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the arm exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This arm is VOID."; health; }
	return 0
}

capped() {
	lim="$1"; shift
	"$@" &
	pid=$!
	i=0
	while [ "$i" -lt "$lim" ]; do
		kill -0 "$pid" 2>/dev/null || { wait "$pid"; return $?; }
		sleep 1
		i=$((i + 1))
	done
	kill -9 "$pid" 2>/dev/null
	wait "$pid" 2>/dev/null
	return 124
}

c() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $*"; return 0; }
	before=$(nbad)
	sleep 1
	capped "$ARMCAP" env $1 $2 $3 $4 $5 $6 $7 $8 $9 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the arm exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This arm is VOID."; health; }
	return 0
}

rung() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $1"; return 0; }
	lbl="$1"; shift
	before=$(nbad)
	log ""
	log "  -- $lbl"
	sleep 1
	capped "$LIMIT" env "$@" "$RUN" "$M8" -p "$PROMPT" -n 32 \
		--ignore-eos -q -c 512 -t 4 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the rung exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This rung is VOID."; health; }
	return 0
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	[ -w /sys/module/rocket/parameters/reset_autosuspend ] && \
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend

	log ""
	log "===== 0) the limit's own control. expect rc 124 after ~3s.         ====="
	t0=$(cut -d. -f1 /proc/uptime)
	capped 3 sleep 60
	rc=$?
	t1=$(cut -d. -f1 /proc/uptime)
	log "  -- capped 3 sleep 60  ->  rc $rc after $((t1 - t0))s"
	[ "$rc" = "124" ] || log "  !! THE LIMIT DID NOT FIRE. Nothing below can be trusted to end."

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "##### ROUND 341: the last two registers, then the capture         #####"

	log ""
	log "===== 2) THE MEASUREMENT. every stage of the forward pass, NPU on. ====="
	log "=====    matmul stages minus the hardware path = the quantise.     ====="
	rung "the decode loop on the NPU, stages on" \
		CHARSIU_STAGES=1 CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 "$CE" "$HEAD"

	log ""
	log "===== 2b) the same stages with the NPU off, one boot apart.        ====="
	rung "the CPU path, stages on" CHARSIU_STAGES=1 CHARSIU_NPU_QUANT=1

	log ""
	log "===== 2) CONTROL: old reference 64 of 64, plain sum 0 of 64.       ====="
	c "CHARSIU_W4=1 CHARSIU_W4_PAIRED=1" "$CE" $MM 1 64 64

	log ""
	log "===== 3) the last two differences, with the packing right.        ====="
	log "===== 3a CNA 0x1098 = 1, the vendor's value"
	c "CHARSIU_W4=1 CHARSIU_W4_PAIRED=1 CHARSIU_CNA_1098=1" "$CE" $MM 1 64 64
	log "===== 3b CORE 0x3018 = 0x10000200"
	c "CHARSIU_W4=1 CHARSIU_W4_PAIRED=1" "CHARSIU_OVERRIDE=0x3018=0x10000200" "$CE" $MM 1 64 64
	log "===== 3c both"
	c "CHARSIU_W4=1 CHARSIU_W4_PAIRED=1 CHARSIU_CNA_1098=1" "CHARSIU_OVERRIDE=0x3018=0x10000200" "$CE" $MM 1 64 64
	log "===== 3d and the vendor's complete set, all five at once"
	c "CHARSIU_W4=1 CHARSIU_W4_PAIRED=1 CHARSIU_CNA_1098=1" "CHARSIU_OVERRIDE=0x3018=0x10000200,0x100c=0x00600120" "$CE" $MM 1 64 64
	log "===== 3e the complete set at a bigger shape"
	c "CHARSIU_W4=1 CHARSIU_W4_PAIRED=1 CHARSIU_CNA_1098=1" "CHARSIU_OVERRIDE=0x3018=0x10000200,0x100c=0x00600120" "$CE" $MM 1 2048 256

	log ""
	log "===== 5) the standing number, no timers, so they cannot be blamed  ====="
	rung "the decode loop on the NPU" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 "$CE" "$HEAD"

	log ""
	log "===== the anchor again                                             ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== the plain sum line, and VOID means the arm died.             ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
