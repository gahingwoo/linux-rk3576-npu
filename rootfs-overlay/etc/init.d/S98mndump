# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-20 round 279. The same reader bug, in a fourth place, and 278 ran the
# comparison anyway.
#
# ⚠ 278's int4 ARMS ARE VOID AND NOT FOR THE REASON THE SCRIPT LISTED. Two
# things were wrong at once and neither is about the hardware.
#
#   the output was read as BYTES. The giveaway is in 278's own log: every group
#   of four reads "X Y 255 255" or "X Y 0 0", which is a little endian int32
#   pulled apart. 159 229 255 255 is 0xFFFFE59F, which is -6753.
#
#   cpu_reference() returns a REQUANTISED int8 and w4a16 returns a raw
#   accumulator, since 0x40ac, 0x40b0 and 0x40b4 are 0, 1, 0. The two were never
#   in the same domain, so entry 3 could not have passed whatever the hardware
#   did, and its failure says nothing about the fetched half.
#
# That is the FOURTH place in this repo to read a four byte output as bytes,
# after --kpair in 265, --map in 267 and now the matmul. Every one of them was
# correct for int8, which is how each passed its int8 validation and kept the
# bug. The int8 arm of 278 was 64 of 64 BYTE EXACT, so the instrument was sound
# for the case it was written against and wrong for the one being asked.
#
# WHAT THE FIXED HARNESS COMPARES. The arithmetic is measured, seven nibbles for
# seven, once the activation is read as the raw 16 bit slot:
#
#   out = ((int16)fp16bits(w) * (int16)abits) >> 16      abits = (a-0x80) << 8
#
# ⚠ WHERE THE SHIFT GOES HAS NEVER BEEN MEASURED. Every point behind that
# formula had ONE live nibble, and with one term a shift per element and a shift
# on the sum are the same number. This is the first round with a dense buffer,
# so it is the first round that can tell them apart. Both are computed and both
# counts are printed rather than picking one and reporting its score.
#
# THE READING RULE, fixed before the run.
#
#   ⚠ ENTRY 3 IS THE ROUND. HALFK on, v = 111, and now two references.
#
#     64 of 64 exact on ONE of them    an int4 matmul works on this hardware
#                                      and the shift placement is settled in the
#                                      same line
#     64 of 64 on BOTH                 the test shape is too kind: the terms are
#                                      not mixing signs or magnitudes enough to
#                                      separate the two, and a harder shape is
#                                      needed before either is a reading
#     high on one, not exact           the formula is close and something else,
#                                      rounding most likely, is missing
#     neither                          the fetched set is not (k mod 32) < 16.
#                                      That map was read with ONE live nibble
#                                      and a dense buffer is not the same thing.
#
#   ENTRY 2 is still the control that must FAIL: no HALFK, so the reference
#   counts weights the hardware does not fetch. If it passes, HALFK did nothing
#   and entry 3 proves nothing either.
#
#   ENTRY 5 is int8, untouched, and was 64 of 64 in 278. It has to stay there or
#   the reader change broke the path it was already right about.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
MM=/opt/charsiu/charsiu_matmul
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

c() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $*"; return 0; }
	before=$(nbad)
	sleep 1
	env $1 $2 $3 $4 $5 $6 $7 $8 $9 > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This arm is VOID."; health; }
	return 0
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	if [ -w /sys/module/rocket/parameters/reset_autosuspend ]; then
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend
		log "reset_autosuspend = $(cat /sys/module/rocket/parameters/reset_autosuspend)"
	else
		log "!! reset_autosuspend NOT WRITABLE. A timeout will kill the round."
	fi

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== 2) the control that must FAIL. W4 dense, no HALFK, v=111     ====="
	log ""
	c "CHARSIU_W4=1" "CHARSIU_OVERRIDE=0x3020=111" $MM 1 64 64

	log ""
	log "===== 3) THE ROUND. HALFK on, v = 111, both shift placements.      ====="
	log ""
	c "CHARSIU_W4=1 CHARSIU_W4_HALFK=1" "CHARSIU_OVERRIDE=0x3020=111" $MM 1 64 64

	log ""
	log "===== 4) HALFK without v=111. 0..39 should be exact, 40..63 not.   ====="
	c "CHARSIU_W4=1 CHARSIU_W4_HALFK=1" X=1 $MM 1 64 64

	log ""
	log "===== 5) int8 dense. Was 64 of 64. Must still be.                  ====="
	c X=1 X=1 $MM 1 64 64

	log ""
	log "===== 6) N = 32 and N = 16, the same claim at other shapes         ====="
	c "CHARSIU_W4=1 CHARSIU_W4_HALFK=1" "CHARSIU_OVERRIDE=0x3020=111" $MM 1 64 32
	c "CHARSIU_W4=1 CHARSIU_W4_HALFK=1" "CHARSIU_OVERRIDE=0x3020=111" $MM 1 64 16

	log ""
	log "===== the anchor again                                             ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== one of the two references, or the fetched set is wrong.      ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
