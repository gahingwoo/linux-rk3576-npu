# ---------------------------------------------------------------------------
# 2026-08-20 round 284. The pair stride was only ever measured at N = 64.
#
# 283 SPLIT ITS OWN QUESTION CLEANLY. Rounding 0x3020 up to a multiple of 16
# fixed the WRITE: N of 24, 40 and 56 now report 24 of 24, 40 of 40 and 56 of 56
# words written where they reported 16, 32 and 48. The write quantum is sixteen
# channels and that part is settled.
#
# ⚠ AND THE SAME THREE ARE STILL WRONG, WHICH IS NOW A PLACEMENT FAULT. The per
# group line puts whole groups at 0 of 8 at the top: g2 at N = 24, g3 and g4 at
# N = 40, g4 to g6 at N = 56. The channels are written and the weights are in
# the wrong place, which is the opposite of what 282 concluded and is exactly
# what 283's second branch said it would mean.
#
# WHAT WAS WRONG, and it is a coincidence I did not see for four rounds.
#
#   the base expression used a pair stride of 8*K
#   the weight buffer is k*n/2 bytes, so at N = 64 it is k*32
#   therefore at N = 64, 8*K and wbytes/4 ARE THE SAME NUMBER
#
# Both measured tables, K = 64 and K = 32, were swept at N = 64. No data taken
# in this project can tell the two forms apart, and 283's N sweep is the first
# thing that could. It says the map has to scale with the buffer: at N = 24 the
# second group of g2 lands at byte 768, which is exactly the size of that
# buffer.
#
# So the stride is wbytes/4 now, and the second group sits half a stride on
# rather than a fixed 256.
#
# ⚠ THIS IS A HYPOTHESIS AND NOT A READING. It agrees with everything measured
# and disagrees with the failures, which is the most that can be said for it.
# The odd member offsets, 128 for a middle pair and 64 for the last, are still
# constants read only at N = 64 and this round does not touch them.
#
# THE READING RULE, fixed before the run.
#
#   ⚠ ENTRIES 2 TO 4 ARE THE ROUND. N of 24, 40 and 56.
#
#     all three exact, every group 8/8   the stride scales with the buffer and
#                                        seven N and two K close at M = 1
#     the top groups move but are not
#     exact                              the stride is right and the 128 and 64
#                                        offsets are the part that does not
#                                        scale, which is the next thing to sweep
#     unchanged                          wbytes/4 is not it either, and the
#                                        thing to do is sweep the map at N = 24
#                                        directly rather than reason about it
#
#   ⚠ ENTRIES 5 TO 8 MUST NOT REGRESS. N of 16, 32, 48 and 64, and K = 32, were
#   all exact in 283 and the stride change is a no-op at N = 64 by construction.
#   N = 16, 32 and 48 are NOT at N = 64, so they are a real test of the new
#   form and not a formality.
#
#   ENTRY 9 is the control that must FAIL and ENTRY 10 is int8.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
MM=/opt/charsiu/charsiu_matmul
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

c() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $*"; return 0; }
	before=$(nbad)
	sleep 1
	env $1 $2 $3 $4 $5 $6 $7 $8 $9 > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This arm is VOID."; health; }
	return 0
}

M4="CHARSIU_W4=1 CHARSIU_W4_HALFK=1"

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	if [ -w /sys/module/rocket/parameters/reset_autosuspend ]; then
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend
		log "reset_autosuspend = $(cat /sys/module/rocket/parameters/reset_autosuspend)"
	else
		log "!! reset_autosuspend NOT WRITABLE. A timeout will kill the round."
	fi

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "##### the three that were short. wrote must go to 32, 48, 64.      #####"
	log ""
	log "===== 3) N = 24. Was 16 of 24.                                     ====="
	c "$M4" X=1 $MM 1 64 24
	log ""
	log "===== 4) N = 40. Was 32 of 40.                                     ====="
	c "$M4" X=1 $MM 1 64 40
	log ""
	log "===== 5) N = 56. Was 48 of 56.                                     ====="
	c "$M4" X=1 $MM 1 64 56

	log ""
	log "##### the four that already worked. None may regress.              #####"
	log ""
	log "===== 6) N = 16                                                    ====="
	c "$M4" X=1 $MM 1 64 16
	log ""
	log "===== 7) N = 32                                                    ====="
	c "$M4" X=1 $MM 1 64 32
	log ""
	log "===== 8) N = 48                                                    ====="
	c "$M4" X=1 $MM 1 64 48
	log ""
	log "===== 2) N = 64                                                    ====="
	c "$M4" X=1 $MM 1 64 64
	log ""
	log "=====    and K = 32 at N = 64, the other K                         ====="
	c "$M4" X=1 $MM 1 32 64

	log ""
	log "===== 9) the control that must FAIL                                ====="
	c "CHARSIU_W4=1" X=1 $MM 1 64 64

	log ""
	log "===== 10) int8 dense                                               ====="
	c X=1 X=1 $MM 1 64 64

	log ""
	log "===== the anchor again                                             ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== seven N and two K exact with no override would close M = 1.  ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
