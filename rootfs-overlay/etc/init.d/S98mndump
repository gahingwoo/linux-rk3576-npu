# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-20 round 274. One k did the multiply. And three registers carrying the
# channel count have never been touched.
#
# ⚠ 273's ENTRY 3 IS THE FIRST TIME THE OUTPUT DEPENDED ON THE ACTIVATION IN
# THIS MODE. Under PROC_PRECISION = 0 with a ONE BYTE activation, a nibble pairs
# with TWO k and they do different things:
#
#   byte 0 low  -> k0 = 0x02bc = 700    which is 100 * 7, the one hot amplitude
#                                       times the nibble. a * w, exactly.
#               -> k1 = 0x0379 = 889    which is 127 * 7, the constant again.
#
# So the mode CAN multiply by the activation. Whatever the 127 is, it is not
# "this mode ignores the activation", because one of the two k did not ignore it.
#
# A8_STRIDE1 on its own changed nothing in the --map column: 127, 254, 508, 889,
# -127 for nibbles 1, 2, 4, 7, 15, identical to without it, and low and high
# nibble equal. That is consistent, since --map drives a ramp where both paired
# k are live and the 127 term wins.
#
# ⚠ ONE COST. A8_STRIDE1 halves the fetch back: 80 live groups where PP = 0
# alone gave 160, and byte 512 goes dark. It buys the multiply and gives back
# half the k.
#
# THE CHANNEL COUNT SURVIVED EVERYTHING AGAIN. All seven registers 269 found
# inert are still inert with the fix on, in the other arithmetic mode. wrote is
# 40 in every clean arm of five rounds. M = 4 gives 160, so M * (N/2 + 8) holds
# at M of 1, 2 and 4.
#
# ⚠ AND HERE IS WHAT I EXCLUDED WRONGLY. The sweep list came from diffing the
# int8 and int4 streams, so registers IDENTICAL in both were never swept. Three
# of them carry n - 1:
#
#   CORE 0x3020 = n-1     DPU 0x402c = n-1     DPU_RDMA 0x5014 = n-1
#
# A register that is the same on both paths cannot CAUSE the difference, which
# is why they were dropped, but it can perfectly well be the BOUND that int4
# reaches and int8 does not. Nothing else has moved in five rounds and these
# have never been asked.
#
# Also never swept, for the same reason: CNA 0x1010 CONV_CON2, which carries
# KERNEL_GROUP, currently 0, and FEATURE_GRAINS, currently 255. A kernel is an
# output channel and a group of them is exactly the shape of the missing factor.
#
# THE READING RULE, fixed before the run.
#
#   ⚠ ENTRY 3 IS THE CHANNEL ROUND. Each of the three n-1 registers set to 127
#   at N = 64, which claims 128 channels.
#
#     wrote goes to 72     that register is the source. 128/2 + 8 = 72, and the
#                          halving is downstream of whichever one it is
#     wrote goes to 128    that register is the source AND int4's halving is
#                          somewhere between it and the write
#     wrote stays 40       not that one. Three arms, and if all three stay the
#                          count is not written down anywhere I have looked
#
#   ENTRY 2 sweeps the one hot amplitude at the k that multiplied. --kpair drove
#   100 hardcoded for eleven rounds, which was fine while the question was which
#   k a nibble touches and useless once it became whether a is read at all.
#
#     700, 7, 14, 35, 70 for amp 100, 1, 2, 5, 10    out = a * w exactly, and
#                                                    this mode is a real integer
#                                                    matmul
#     the value does not track amp                   700 was a coincidence and
#                                                    the k0 reading is wrong
#
#   ENTRY 4 sweeps KERNEL_GROUP and FEATURE_GRAINS on CONV_CON2, and SIZE_E_0 on
#   0x4050, which is 4 on both paths and is the one BS_OW_CFG field never varied.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
CH=/opt/charsiu/charsiu_int4
FIX=0x100c=0x20600020
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

c() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $*"; return 0; }
	before=$(nbad)
	sleep 1
	env $1 $2 $CH $3 $4 $5 $6 $7 $8 > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This arm is VOID."; health; }
	return 0
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	if [ -w /sys/module/rocket/parameters/reset_autosuspend ]; then
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend
		log "reset_autosuspend = $(cat /sys/module/rocket/parameters/reset_autosuspend)"
	else
		log "!! reset_autosuspend NOT WRITABLE. A timeout will kill the round."
	fi

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "##### 2) is it a*w. amp 1 2 5 10 100 at byte 0, nibble 7.          #####"
	for A in 1 2 5 10 100
	do
		log ""
		log "===== amp $A   PP=0 + A8_STRIDE1   (a*w would be $A x 7)"
		c "CHARSIU_OVERRIDE=$FIX" "CHARSIU_A8_STRIDE1=1 CHARSIU_KPAIR_AMP=$A CHARSIU_KPAIR_BYTES=0" 1 64 64 --kpair
	done

	log ""
	log "##### 3) THE CHANNEL ROUND. the three n-1 registers, never swept.  #####"
	for a in "0x3020=0x7f" "0x402c=0x7f" "0x5014=0x7f"
	do
		log ""
		log "===== ARM $a   (claims 128 channels at N=64; 72 or 128 is a hit)"
		c "CHARSIU_OVERRIDE=$a" X=1 1 64 64 --map 8 128
	done

	log ""
	log "##### 4) CONV_CON2 and SIZE_E_0, the other never swept fields.     #####"
	for a in \
		"0x1010=0x00010fff" \
		"0x1010=0x00020fff" \
		"0x1010=0x00040fff" \
		"0x1010=0x000007ff" \
		"0x1010=0x00001fff" \
		"0x4050=0x00023303" \
		"0x4050=0x0002330b" \
		"0x4050=0x0002331b" \
		"0x4050=0x0002332b" \
		"0x1040=0x00000000" \
		"0x1040=0x20000000"
	do
		log ""
		log "===== ARM $a"
		c "CHARSIU_OVERRIDE=$a" X=1 1 64 64 --map 8 128
	done

	log ""
	log "===== 5) whichever of 3 hits, with the k fix on as well            ====="
	c "CHARSIU_OVERRIDE=$FIX,0x3020=0x7f" X=1 1 64 64 --map 8 128

	log ""
	log "===== the anchor again                                             ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== entry 3. If all three stay at 40 the count is somewhere new. ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
