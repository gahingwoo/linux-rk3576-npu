# ---------------------------------------------------------------------------
# 2026-08-20 round 268. Against int8, which is byte exact, at the same shapes.
#
# WHAT 267 SETTLED. The dense sweep closed the discriminator on the clean side:
# the number of words ever lit EQUALS the number written, at all three
# geometries. 16 of 16, 24 of 24, 40 of 40. Words 32 to 39 at N = 64 are lit;
# 266's sparse byte list simply never hit the bytes that reach them. So nothing
# is writing channels it does not compute, and the whole map is:
#
#   N=64            N=32              N=16
#      0: w0-7         0: w0-7           0: w0-7
#     64: .           64: .             64: w8-15
#    128: w8-15      128: w8-15        128: .
#    192: .          192: w16-23       192: .
#    256: w0-7'      256: w0-7'        256: w0-7'
#    320: .          320: .            320: w8-15'
#    384: w8-15'     384: w8-15'       384: .
#    448: .          448: w16-23'      448: .
#    512: w16-23     512+: all dark    (' is the same channel at k + 32)
#    640: w24-31
#    704: w32-39
#    768: w16-23'
#    896: w24-31'
#    960: w32-39'
#   1024+: all dark
#
# TWO NUMBERS COME OUT OF IT AND THEY ARE DIFFERENT PROBLEMS.
#
#   channels reached = N/2 + 8      16, 24, 40 at N = 16, 32, 64
#   k per channel    = 32           two groups of eight bytes, at B and B+256,
#                                   sixteen nibbles each, while K is 64
#
# The second one is not the first one in disguise. Every channel that exists at
# all gets exactly half its k, whatever N is.
#
# WHAT THIS ROUND DOES. Stops reasoning about it and diffs against int8, which
# is byte exact on this silicon and whose map this project has already validated
# --map against. Same K, same three N, same probe, same stride, one flag.
#
# ⚠ int8 writes ONE BYTE a channel where w4a16 writes four, so the line now
# carries hib, the highest byte written, as well as the word count. A 64 channel
# int8 job touches 64 bytes and 16 words; a 40 channel one touches 40 and 10.
# Read hib for the int8 arm and the word count for the int4 arm.
#
# THE READING RULE, fixed before the run.
#
#   ⚠ THE ORACLE, entries 2 to 4. int8 at N = 16, 32 and 64.
#
#     hib = N-1 every time    int8 computes every channel it is asked for, and
#                             both of the numbers above are int4 path defects,
#                             in the registers that differ between the paths
#     hib = N/2 + 7           the shortfall is not about int4 at all. It follows
#                             the probe's own geometry, m = 1, and the thing to
#                             fix is the job, not the precision
#     no dead region in int8  then the dead half is int4's too, and the k
#                             shortfall and the channel shortfall are one bug
#
#   ⚠ THE EXTENSION, entries 5 and 6. N = 48 and N = 128, neither a power of
#   two step from what has been measured. N/2 + 8 says 32 channels and 72, and
#   two groups a channel says 64 live groups and 144. Four numbers, and they are
#   derived rather than fitted, since the formula was read off 16, 32 and 64.
#
#     all four land           N/2 + 8 is a law and not three points in a row
#     N = 48 lands, 128 does not
#                             there is a ceiling, and 72 against 64 says where
#     neither                 the formula was three coincidences and the block
#                             layout above is what to fit instead
#
#   ⚠ THE CONTROL THAT MUST NOT MOVE. int8 at N = 16 must reproduce the map
#   this project already recorded for it, n = byte/32 with no dead region. If it
#   does not, --map is still broken and the int4 arms this round are void.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	after=$(nbad)
	if [ "$after" != "$before" ]; then
		log "  !! POISON in this entry. The block faulted. This result is VOID."
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" \
			> /tmp/hc.txt 2>&1
		if grep -q "128/128 channels match" /tmp/hc.txt; then
			log "  !! health OK, the block recovered, continuing"
		else
			log "  !! health FAILED, the block is gone. ABORTING the round."
			ABORT=1
		fi
	fi
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	if [ -w /sys/module/rocket/parameters/reset_autosuspend ]; then
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend
		log "reset_autosuspend = $(cat /sys/module/rocket/parameters/reset_autosuspend)"
	else
		log "!! reset_autosuspend NOT WRITABLE. A timeout will kill the round."
	fi

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== 2) INT8 N = 16, the oracle. hib must be 15 if it computes all ====="
	log ""
	sleep 1
	env CHARSIU_MAP_W8=1 /opt/charsiu/charsiu_int4 1 64 16 --map 8 > "$C" 2>&1

	log ""
	log "===== 3) INT8 N = 32. hib 31 if it computes all, 23 if it does not ====="
	sleep 1
	env CHARSIU_MAP_W8=1 /opt/charsiu/charsiu_int4 1 64 32 --map 8 > "$C" 2>&1

	log ""
	log "===== 4) INT8 N = 64. hib 63 if it computes all, 39 if it does not ====="
	sleep 1
	env CHARSIU_MAP_W8=1 /opt/charsiu/charsiu_int4 1 64 64 --map 8 > "$C" 2>&1

	log ""
	log "===== 5) int4 N = 48. N/2+8 says 32 channels and 64 live groups.   ====="
	sleep 1
	/opt/charsiu/charsiu_int4 1 64 48 --map 8 > "$C" 2>&1

	log ""
	log "===== 6) int4 N = 128. N/2+8 says 72 channels and 144 live groups. ====="
	sleep 1
	/opt/charsiu/charsiu_int4 1 64 128 --map 8 > "$C" 2>&1

	log ""
	log "===== 7) the anchor again                                          ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== int8's hib first. Everything else depends on which way it is ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
