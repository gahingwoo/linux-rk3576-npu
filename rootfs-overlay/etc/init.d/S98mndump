#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-21 round 294. Row 1's activation is never read, and that is the whole
# of what is left.
#
# ⚠ 293 COLLAPSED IT TO ONE FAULT. Holding one row live at a time:
#
#   --map M = 2 N = 16, ROW 0 only    byte 0 lights w0 AND w4, byte 8 lights
#                                     w1 and w5, byte 16 lights w2 and w6 ...
#   --map M = 2 N = 16, ROW 1 only    NOTHING LIT, 0 of 64 groups
#
# Under the surface [ni/4][mi][ni%4], w0 is row 0 channel 0 and w4 is row 1
# channel 0, so byte 8j feeds channel j in BOTH rows and its address is the same
# byte 8j that M = 1 uses.
#
# ⚠ SO THE WEIGHT LAYOUT HAS NO M TERM AFTER ALL, and 292's sparse grid was the
# instrument: a ramp driving every row at once, reported as the first lit word
# only. That was branch one of 293's reading rule and this is what it looks like.
#
# What is left is one thing: THE HARDWARE ONLY EVER READS ROW 0's ACTIVATION.
# Not reads it from the wrong place, which would light garbage. Row 1's bytes go
# in and are never fetched, so with row 0 held at the zero point nothing lights.
#
# ⚠ AND THE STREAM HAS A HARDCODED 1 IN IT. Twelve registers change between
# M = 1 and M = 2, so M is propagated widely, but CNA 0x1044 is not one of them.
# mesa's registers.xml calls it CBUF_CON1 and its only field is
# DATA_ENTRIES[13:0], which is how many entries of input data the CBUF holds.
# charsiu emits (1 << 16) | surf, where surf is entries per ROW, and never
# multiplies by m. 0x103c, which has no name in that file, carries surf << 16
# and likewise does not move.
#
# THE READING RULE, fixed before the run.
#
#   ⚠ THE TEST IS ONE BIT: does --map with CHARSIU_MAP_ROW=1 light anything.
#   Every arm below is that same question with one register changed.
#
#     an arm lights row 1     that register is the input row count and the M
#                             failure is one value. Run the matmul beside it.
#     none of them do         DATA_ENTRIES is not it, and the next place to look
#                             is 0x1078, 0x1094 and 0x118c, which DO move with M
#                             and have no names in mesa's file
#     an arm lights row 1 AND changes row 0
#                             it is a stride rather than a count, and row 0's
#                             map beside it says by how much
#
#   ⚠ ENTRIES 2 AND 3 ARE THE BASELINE PAIR and they are not a formality. Row 0
#   lit and row 1 dark is the fault; if the unmodified pair does not reproduce
#   that, nothing below it can be read.
#
#   ENTRIES 12 AND 13 are the M = 1 regression. No packer change this round, so
#   they must not move.
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
MM=/opt/charsiu/charsiu_matmul
CH=/opt/charsiu/charsiu_int4
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

c() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $*"; return 0; }
	before=$(nbad)
	sleep 1
	env $1 $2 $3 $4 $5 $6 $7 $8 $9 > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This arm is VOID."; health; }
	return 0
}

M4="CHARSIU_W4=1 CHARSIU_W4_HALFK=1"

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	if [ -w /sys/module/rocket/parameters/reset_autosuspend ]; then
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend
		log "reset_autosuspend = $(cat /sys/module/rocket/parameters/reset_autosuspend)"
	else
		log "!! reset_autosuspend NOT WRITABLE. A timeout will kill the round."
	fi

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "##### the baseline pair. row 0 lit, row 1 dark, or stop reading.   #####"
	log ""
	log "===== 2) --map M=2 N=16 row 0, unmodified                          ====="
	c CHARSIU_MAP_ROW=0 X=1 $CH 2 64 16 --map 8
	log ""
	log "===== 3) --map M=2 N=16 row 1, unmodified. Must be dark.           ====="
	c CHARSIU_MAP_ROW=1 X=1 $CH 2 64 16 --map 8

	log ""
	log "##### THE ROUND. one bit: does row 1 light.                        #####"
	for a in \
		"0x1044=0x00010004" \
		"0x1044=0x00020004" \
		"0x1044=0x00020002" \
		"0x103c=0x00040000" \
		"0x103c=0x00040000,0x1044=0x00010004" \
		"0x1078=0x00000000" \
		"0x1094=0x00000001" \
		"0x118c=0x00000000"
	do
		log ""
		log "===== ARM $a   row 1"
		c "CHARSIU_OVERRIDE=$a" CHARSIU_MAP_ROW=1 $CH 2 64 16 --map 8 64
	done

	log ""
	log "===== 12) the M = 1 regression. No packer change this round.       ====="
	c "$M4" X=1 $MM 1 64 16
	c "$M4" X=1 $MM 1 64 64
	log ""
	log "===== 13) the control that must FAIL, and int8 at M = 4            ====="
	c "CHARSIU_W4=1" X=1 $MM 1 64 64
	c X=1 X=1 $MM 4 64 64

	log ""
	log "===== the anchor again                                             ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== any arm that is not NOTHING LIT is the answer.               ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
