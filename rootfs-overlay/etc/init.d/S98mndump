# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-09 round 37. Test the RULE as a prediction, then test whether it is
# a constant across models.
#
# Round 36 mapped the word at groups*64. Twenty data points, and one rule fits
# every one of them:
#
#     (w & 0x3f) == 0x04    AND    (w & 0x3000) != 0
#
# that is, the low six bits are exactly 000100, and at least one of bits 12 and
# 13 is set. Bits 6, 7, 8, 9, 10, 11, 14, 15 and everything above are free.
#
#   passes  0x1a44 0x1a04 0x1a84 0x1044 0x2044 0xff44
#   fails   0x1a45 0x1a06 0x1a0c 0x1a14 0x1a40 0x1a00 0x1aff
#           0x0044 0x0144 0x0244 0x0444 0x0844 0x4044 0x8044
#
# The rule was fitted to those, so repeating them proves nothing. What tests it
# is a word it has never seen: 0x1004 is the SMALLEST word the rule allows and
# has never been run, and 0x3fc4 sets every free bit at once. Both must pass,
# and the two near misses beside them must fail.
#
# ⚠ FIXED THIS ROUND: the knobs wrote at a hardcoded 0x400, which is groups*64
# only because oc=128 in every model probed so far. With oc=16 it is 0x80, so
# on cal_oc16 they were writing into the A/B/C table. They now use groups*64,
# which is why the other models can be tried at all.
#
# DECISION RULE, written before the run:
#   0x1004 and 0x3fc4 pass, the two near misses fail
#       the rule holds on words it was not fitted to, and mesa can write one
#       constant and delete the 197888 byte surface
#   0x1004 fails
#       the rule is wrong or incomplete; the bits it calls free are not
#   the same constant works on cal_s1 and cal_oc16
#       it is a constant, not a function of the geometry
#   it works on cal_oc16 only with a different word
#       it scales with something, and oc is the first suspect
#   cal_k3 changes behaviour at all
#       unexpected, and worth far more than the rest of this round
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
run() { log ""; log "===== $1: $2  FS_F0=$3 ====="; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so ROCKET_FS_FLOATS=1 \
	ROCKET_FS_KEEP=4 ROCKET_FS_F0="$3" \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$2" > "$C" 2>&1; }
base() { log ""; log "===== $1: baseline $2 ====="; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so ROCKET_FS_FLOATS=1 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$2" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	base 1 conv2d-cal.tflite

	log ""
	log "===== THE PREDICTION: words the rule allows but has never seen ====="
	run 2 conv2d-cal.tflite 0x1004
	run 3 conv2d-cal.tflite 0x3fc4
	log "  and the two near misses, which must FAIL"
	run 4 conv2d-cal.tflite 0x1005
	run 5 conv2d-cal.tflite 0x0fc4

	log ""
	log "===== is it the SAME constant on other geometries ====="
	base 6 cal_s1.tflite
	run  7 cal_s1.tflite 0x1004
	base 8 cal_oc16.tflite
	run  9 cal_oc16.tflite 0x1004
	log "  (the knobs now use groups*64, so oc=16 lands in the right place)"

	log ""
	log "===== and the kernel size that has never worked ====="
	base 10 cal_k3.tflite
	run  11 cal_k3.tflite 0x1004

	log ""
	log "===== 12) CONTROL that can fail: the first baseline again ====="
	base 12 conv2d-cal.tflite

	log ""
	log "===== Read 1 and 12 first. Then 2 and 3: a rule that predicts    ====="
	log "===== words it was never fitted to is worth keeping.             ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
