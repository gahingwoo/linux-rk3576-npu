# ---------------------------------------------------------------------------
# 2026-08-19 round 254. Is the chain degradation propagation, or a layer bug.
#
# WHAT 253 LEFT. The clamp is closed and every single operator shape is right,
# but reading a whole network at increasing depth degrades. Scored per pixel
# rather than per channel, which is the honest way since the later layers have
# more channels and fewer pixels each:
#
#   layer  exact   within1  maxd  errors that are npu LOW
#   L00    99.80%  100.0%      1  100.0%
#   L01    89.31%   99.9%      3   99.3%
#   L02    84.18%   98.1%      6   58.6%     <- the change happens here
#   L03    73.42%   94.6%     13   78.6%
#   L07    60.25%   89.5%     10   53.1%
#   L18    66.52%   89.6%      8   53.3%
#   L26    85.07%   87.5%     28   50.0%
#
# Two things in that table. It SATURATES around 60 to 66 percent rather than
# collapsing, so it is not a per layer multiplier. And the errors stop being
# one sided at L02. At L00 and L01 every miss is the hardware reading LOW,
# which is the tflite rounding artefact this project already documented: its
# requant lands on exactly one half for half the pixels and rounds up every
# time. From L02 the sign is a coin flip, which is a different thing.
#
# L02 is the first pointwise.
#
# THE HYPOTHESIS. The degradation is error PROPAGATION and not a layer bug. The
# first layer is fed an exact image so its only error is its own rounding, which
# is one sided. Every later layer is fed an input that already carries plus or
# minus one, so its error is two sided. If that is right there is no bug to find
# in any single operator and the question becomes whether to accept one count
# per layer or to fix the reference.
#
# THE LADDER, and every isolated model here produces the SAME output tensor as
# the chained one beside it:
#
#   mn_conv0     1 op    224x224x3   -> 112x112x32    against mn_L00
#   mn_conv0dw1  2 ops   224x224x3   -> 112x112x32    against mn_L01
#   mn_dw1       1 op    112x112x32  -> 112x112x32
#   mn_pw2       1 op    112x112x32  -> 112x112x64    against mn_L02
#   mn_pw24      1 op    7x7x512     -> 7x7x1024      against mn_L24
#   mn_dw25      1 op    7x7x1024    -> 7x7x1024
#
# THE READING RULE, fixed before the run.
#
#   Read maxd and the npu LOW percentage of the ISOLATED models first.
#
#   If every isolated layer comes back maxd 1 with npu LOW near 100 percent,
#   the operators are accurate and one sided against the reference, the chain's
#   two sidedness is propagation, and there is no per layer bug to chase.
#
#   If any isolated layer is worse than maxd 1, THAT layer is the bug and the
#   propagation story is secondary. mn_pw2 is the one that decides it, since
#   L02 is where the one sidedness breaks.
#
#   ⚠ mn_conv0dw1 against mn_L01 is a control on a different axis. Same output
#   tensor, same two layers, 2 operators against 31. They must agree. If they
#   do not then depth is not the variable and graph size is, which would be a
#   dispatch question rather than an arithmetic one.
#
#   ⚠ CAVEAT I am not hiding. perch.py feeds a ramp, (i * 7) mod 251, so an
#   isolated layer sees a broad input range while in the network it would see a
#   post ReLU6 activation with a much narrower one. An isolated layer coming
#   back clean proves its arithmetic across the range, which is the stronger
#   claim, but it is not the same input. The two seed entries at the end are
#   there to say whether the answer depends on that distribution at all.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	after=$(nbad)
	if [ "$after" != "$before" ]; then
		log "  !! POISON in this entry. The block faulted. This result is VOID."
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" \
			> /tmp/hc.txt 2>&1
		if grep -q "128/128 channels match" /tmp/hc.txt; then
			log "  !! health OK, the block recovered, continuing"
		else
			log "  !! health FAILED, the block is gone. ABORTING the round."
			ABORT=1
		fi
	fi
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	if [ -w /sys/module/rocket/parameters/reset_autosuspend ]; then
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend
		log "reset_autosuspend = $(cat /sys/module/rocket/parameters/reset_autosuspend)"
	else
		log "!! reset_autosuspend NOT WRITABLE. A timeout will kill the round."
	fi

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== 2-4) DEPTH 1. One operator, two, and the whole graph read    ====="
	log "=====      at the same tensor.                                     ====="
	w mn_conv0.tflite ""
	w mn_L00.tflite ""
	w mn_conv0dw1.tflite ""

	log ""
	log "===== 5-6) DEPTH 2. The 31 op graph read at the same tensor as     ====="
	log "=====      mn_conv0dw1, and layer 1 alone.                         ====="
	w mn_L01.tflite ""
	w mn_dw1.tflite ""

	log ""
	log "===== 7-8) THE ONE THAT DECIDES IT. L02 is where the errors stop   ====="
	log "=====      being one sided, and it is the first pointwise.         ====="
	w mn_pw2.tflite ""
	w mn_L02.tflite ""

	log ""
	log "===== 9-11) DEEP IN THE NETWORK, same comparison                   ====="
	w mn_pw24.tflite ""
	w mn_dw25.tflite ""
	w mn_L24.tflite ""

	log ""
	log "===== 12-15) does the answer depend on the input distribution      ====="
	w mn_pw2.tflite "ROCKET_SEED=3"
	w mn_pw2.tflite "ROCKET_SEED=11"
	w mn_L02.tflite "ROCKET_SEED=3"
	w mn_L02.tflite "ROCKET_SEED=11"

	log ""
	log "===== a final anchor                                               ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== Read 1 and 2, then 3 against 4. The bar is the arm beside it ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
