#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-21 round 297. Three arrangements were three points of one axis.
#
# ⚠ 296 SHOWED THE PACKING MATTERS AND THAT NEITHER ALTERNATIVE IS RIGHT.
#
#   layout 0, shipped   M = 1  16/16 and 64/64      M = 2  16 of 32
#   layout 1            M = 1  16/16                M = 2   0 of 32, M = 4 0/64
#   layout 2            M = 1  16/16                M = 2   0 of 32, M = 4 0/64
#
# All three are exact at M = 1, which they must be, since m drops out of every
# one of them there. At M = 2 the two alternatives light row 1 on the map, 8 of
# 16 probes, and break row 0 doing it. So the packing is not inert and neither
# of the two guesses is the answer.
#
# ⚠ AND THE THREE ARE NOT THREE IDEAS. Layout 0 and layout 1 are the two ENDS of
# one axis: the granularity at which rows interleave. The shipped one switches
# rows every atom, 8 elements and 16 bytes; "rows outermost" switches every k,
# the whole row. Nothing between them has ever been written.
#
# 32 elements is the value with a reason behind it. charsiu_entries_per_row is 2
# at K = 64 and the input bo is allocated surf * 64 * m, so an entry is 64 bytes,
# which at two bytes an element is 32 of them. Rows interleaving per ENTRY rather
# than per atom is the natural reading of that allocation and it has never been
# written down.
#
# CHARSIU_A_GRAN is the axis: g elements of row 0, then g of row 1, and so on.
# g = 8 is the shipped layout and g = 64 is 296's layout 1, so the sweep contains
# both of the points already measured and they are the control.
#
# THE READING RULE, fixed before the run.
#
#   ⚠ g = 8 MUST BE 16 of 32 AND g = 64 MUST BE 0 of 32. They are 296's layout 0
#   and layout 1 written a different way. If either moves, the rewrite changed
#   the shipped path rather than generalising it, and nothing else in the round
#   can be read.
#
#   ⚠ THE ROUND IS g = 32, and 16 and 4 either side of the two known points.
#
#     a g is 32 of 32         the row interleave granularity was the fault, M > 1
#                             is done, and the eleven geometries get re-run
#     a g beats 16 of 32
#     without reaching it     the granularity is closer and something inside a
#                             group is still wrong
#     every g is 16 or 0      rows do not interleave on this axis at all, and
#                             what is left is that the hardware reads one row a
#                             job whatever it is told, which makes M > 1 a
#                             chaining problem rather than a layout one
#
#   ENTRY 2 is M = 1 at the default, which eleven geometries depend on.
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
MM=/opt/charsiu/charsiu_matmul
CH=/opt/charsiu/charsiu_int4
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

c() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $*"; return 0; }
	before=$(nbad)
	sleep 1
	env $1 $2 $3 $4 $5 $6 $7 $8 $9 > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This arm is VOID."; health; }
	return 0
}

M4="CHARSIU_W4=1 CHARSIU_W4_HALFK=1"

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	if [ -w /sys/module/rocket/parameters/reset_autosuspend ]; then
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend
		log "reset_autosuspend = $(cat /sys/module/rocket/parameters/reset_autosuspend)"
	else
		log "!! reset_autosuspend NOT WRITABLE. A timeout will kill the round."
	fi

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== 2) M = 1 at the default. Eleven geometries depend on it.     ====="
	c "$M4" X=1 $MM 1 64 16
	c "$M4" X=1 $MM 1 64 64

	log ""
	log "##### THE ROUND. the row interleave granularity, at M = 2.         #####"
	log "#####   g = 8 must be 16 of 32 and g = 64 must be 0 of 32.         #####"
	for G in 1 2 4 8 16 32 64
	do
		log ""
		log "===== M = 2  N = 16  g = $G"
		c "$M4 CHARSIU_A_GRAN=$G" X=1 $MM 2 64 16
	done

	log ""
	log "##### g = 32 at other shapes, if it is the one                     #####"
	log ""
	log "===== M = 2  N = 64  g = 32                                        ====="
	c "$M4 CHARSIU_A_GRAN=32" X=1 $MM 2 64 64
	log ""
	log "===== M = 4  N = 16  g = 32                                        ====="
	c "$M4 CHARSIU_A_GRAN=32" X=1 $MM 4 64 16
	log ""
	log "===== M = 4  N = 16  g = 16                                        ====="
	c "$M4 CHARSIU_A_GRAN=16" X=1 $MM 4 64 16

	log ""
	log "===== and the row 1 map at g = 32                                  ====="
	c "CHARSIU_MAP_ROW=1 CHARSIU_A_GRAN=32" X=1 $CH 2 64 16 --map 8 64

	log ""
	log "===== the control that must FAIL, and int8 at M = 4                ====="
	c "CHARSIU_W4=1" X=1 $MM 1 64 64
	c X=1 X=1 $MM 4 64 64

	log ""
	log "===== the anchor again                                             ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== g = 8 at 16 and g = 64 at 0 first, then look for 32 of 32.   ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
