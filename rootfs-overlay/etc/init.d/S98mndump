#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-21 round 308. THE SAME QUESTION 307 COULD NOT ANSWER, THROUGH A
# KERNEL THAT CAN ANSWER IT.
#
# 307 predicted q4_0 would beat q8_0 on this board and it did not: 2.68 against
# 2.86 at four threads, 2.86 against 2.99 at eight. Half the bytes, slower.
#
# ⚠ THE REASON WAS NOT THE BOARD, IT WAS MY KERNEL. charsiu converted every
# WEIGHT to a float in order to multiply it by a float activation, so the
# unpacking arithmetic dominated and reading half the bytes bought nothing.
# The q8_0/q4_0 ratio barely moved between the host (1.12) and the board
# (1.05-1.07), which says bandwidth was only a second order effect at that ALU
# cost. **307's prediction B is refuted, but so is any reading of 307 as a
# statement about the RK3576's memory system.**
#
# WHAT CHANGED. There are N*K weights and only K activations, so the activation
# is now quantised to int8 once per matvec and the dot product is INTEGER, with
# one float multiply per 32 element block. On the host, four threads:
#
#   q4_0   exact f32 activation  17.99  ->  quantised  36.85 tok/s
#   q8_0   exact f32 activation  17.10  ->  quantised  34.80 tok/s
#
# and the order flipped: **q4_0 now beats q8_0 on the host**, where it lost
# before. Host thread scaling flattened too, 1 -> 18.4, 2 -> 30.2, 4 -> 33.4,
# 6 -> 30.8, which is what a kernel that has stopped being ALU bound looks like.
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# 1) TEXT FIRST, AND THERE ARE NOW TWO CORRECT ANSWERS, one per path.
#
#    q4_0, either path, 32 tokens, greedy, --ignore-eos:
#      Paris. The capital of Germany is Berlin. The capital of Italy is Rome.
#      The capital of Spain is Madrid. The capital of Portugal is Lisbon. The
#      capital
#
#    q8_0 EXACT path (CHARSIU_NO_QACT=1) ends: ...Claude Monet painted many
#      landscapes            <- and this is byte for byte what 307 printed
#    q8_0 QUANTISED path ends: ...Claude Monet painted the water
#
#    The q8_0 pair differing is EXPECTED and is the approximation showing. The
#    q4_0 pair NOT differing is also expected: its own weight noise is larger.
#    Anything else in either and the numbers below are timings of a wrong
#    answer.
#
# 2) THE CONTROL. Entry 3 is CHARSIU_NO_QACT=1, the exact f32 activation. It
#    must be SLOWER and it must reproduce 307's q4_0 line exactly. If the exact
#    path has moved since 307, this commit broke something it had no business
#    touching, and the fast path cannot be read.
#
# 3) THE SCALAR CONTROL is still there, entry 4: no NEON at all, same text.
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT, AND 307 SHOWED THAT WRITING IT DOWN COSTS SOMETHING
# ---------------------------------------------------------------------------
#
# A) **q4_0 BEATS q8_0 THIS TIME.** It does on the host now. If it does here,
#    decode on this board is bandwidth bound, and what the NPU buys is bytes.
#    If q8_0 STILL wins with an integer kernel, then bytes are not the limit on
#    the RK3576 and the NPU's advantage would have to be arithmetic -- which
#    would change what step 2 is for. This is the whole round.
#
# B) FOUR AND EIGHT THREADS WILL BE CLOSER THAN IN 307. 307 got 2.68 at four
#    and 2.95 at eight, a 10% gain from four A53 cores. A kernel that is
#    bandwidth bound should get LESS from them, not more. If eight still gains
#    10% or more, the board is not bandwidth bound even now, and A) is probably
#    also going to fail.
#
# C) I do NOT predict the absolute number. The host gained 2.05x from this
#    change. If the board gains much less, the A72's own integer throughput is
#    the limit and that is worth knowing on its own.
#
# ⚠ PROMPT TOK/S IN THIS LOG IS I/O, NOT COMPUTE. In 307 the first read of the
# q8_0 file took 21.4 s for six tokens, which is 1.3 GB off an SD card at
# 62 MB/s. Entry 1 warms both files first so the later numbers are compute.
# Read the GEN column only.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
RUN=/opt/charsiu/charsiu_run
RUNS=/opt/charsiu/charsiu_run_scalar
M4=/opt/charsiu/models/Llama-3.2-1B-Instruct-Q4_0.gguf
M8=/opt/charsiu/models/Llama-3.2-1B-Instruct-Q8_0.gguf
PROMPT="The capital of France is"
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

# $1 binary, $2 model, $3 tokens, $4 threads, $5 env (or "-")
gen() {
	log ""
	if [ "$5" = "-" ]; then
		log "  -- $(basename $1)  $(basename $2)  -n $3  -t $4"
		"$1" "$2" -p "$PROMPT" -n "$3" --ignore-eos -q -c 512 -t "$4" > "$C" 2>&1
	else
		log "  -- $(basename $1)  $(basename $2)  -n $3  -t $4  [$5]"
		env "$5" "$1" "$2" -p "$PROMPT" -n "$3" --ignore-eos -q -c 512 -t "$4" > "$C" 2>&1
	fi
	return 0
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || log "no accel device (the charsiu entries do not need it)"
	dmesg -n 4 2>/dev/null
	[ -w /sys/module/rocket/parameters/reset_autosuspend ] && \
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend

	log ""
	log "===== 0) the NPU anchor, before anything                           ====="
	w conv2d-cal.tflite ""

	log ""
	log "##### ROUND 308: an integer kernel, and the question 307 could not #####"
	log "#####            answer through a kernel that was ALU bound.       #####"

	log ""
	log "===== 1) warm both files off the SD card. TIMINGS HERE ARE I/O.    ====="
	cat "$M4" > /dev/null 2>&1
	cat "$M8" > /dev/null 2>&1
	log "  -- both models read into the page cache"
	log "  -- $(free -m 2>/dev/null | head -2 | tail -1)"

	log ""
	log "===== 2) THE TEXT, quantised activation, q4_0 and q8_0             ====="
	gen "$RUN" "$M4" 32 4 -
	gen "$RUN" "$M8" 32 4 -

	log ""
	log "===== 3) THE CONTROL. exact f32 activation. slower, and q4_0 must  ====="
	log "=====    reproduce round 307's line byte for byte.                 ====="
	gen "$RUN" "$M4" 32 4 CHARSIU_NO_QACT=1
	gen "$RUN" "$M8" 32 4 CHARSIU_NO_QACT=1

	log ""
	log "===== 4) the scalar control, no NEON at all                        ====="
	gen "$RUNS" "$M4" 24 4 -

	log ""
	log "===== 5) THE ROUND. q4_0 against q8_0. I say q4_0 wins this time.  ====="
	for T in 1 2 4 6 8
	do
		gen "$RUN" "$M4" 24 "$T" -
		gen "$RUN" "$M8" 24 "$T" -
	done

	log ""
	log "===== 6) the same pair once more at the best two, for a repeat     ====="
	gen "$RUN" "$M4" 24 4 -
	gen "$RUN" "$M4" 24 8 -

	log ""
	log "===== the NPU anchor again                                         ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== text, then the control, then q4_0 against q8_0.              ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
