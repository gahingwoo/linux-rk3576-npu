#!/bin/sh
# ---------------------------------------------------------------------------
# 2026-08-08 round 5. The padding fix is confirmed and the set of geometries
# that compute went from one to two:
#
#   cal_s1, derived padding 0x02020202   3/3 OK, relu maxdiff 1, top1 exact
#   cal_s1, ROCKET_PAD_LADDER=1 (old 0)  0/3 FAIL, round 3's numbers exactly
#
# Same boot, same model, same inputs, one register apart.
#
# What is left splits three ways, and this round takes the first two.
#
# 1x1 CONVS. mn_pw2, md003 and mn_pw24 have padding 0 either way and stayed
# broken, as predicted. Both working geometries are 5x5, 16 in / 128 out, 80x80,
# one task, so every failure still differs in several ways at once. md003_80 is
# md003 resized to 80x80 (mutate_hw.py; a 1x1 kernel is valid at any size),
# which drops the row-window split and leaves the kernel as nearly the only
# difference from a model that computes.
#
# 0x1018 / 0x1040. The vendor does not key these off the stride. A width and
# channel sweep flips both exactly where the op stops fitting one row window:
# 16 channels at 128x128 reads 0x40000404 / 0x10000000, 144x144 splits and reads
# 0x40000505 / 0x14000000, and holding 80x80 while raising input channels flips
# at the same place. ROCKET_CBUF_DERIVE=1 keys them off mesa's own split instead.
#
# ⚠ That knob is NOT expected to fix anything on its own: cal_s1 computes with
# the stride-keyed value where the vendor would use the other, so these two
# tolerate being wrong at least there. It is here to be A/B'd, and mn_pw24 is
# the case where the stride and the split disagree.
#
# The third thread, mn_conv0, is not in this round: 3 input channels take
# fill_regcmd_firstconv, a different function that the padding change never
# touched. Its round 4 failure is unexplained by anything here.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }

run() {
	m="$1"; n="$2"; mark="$3"; shift 3
	echo "SMARK-$mark" > /dev/kmsg 2>/dev/null
	env TEFLON_LIB=/usr/lib/libteflon.so "$@" \
		python3 "$NPU_DIR/test_model.py" "$NPU_DIR/$m" "$n" > "$C" 2>&1
	dmesg | sed -n "/SMARK-$mark/,\$p" | grep -a "job: task_count=" | head -2 > "$C" 2>&1
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	# -n 8 floods the serial console and wedges the box. Learned the hard way.
	dmesg -n 4 2>/dev/null

	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/job_log 2>/dev/null
	log ""
	log "  task_con16=$(cat /sys/module/rocket/parameters/task_con16 2>/dev/null)"

	log ""
	log "===== 1) CONTROL: conv2d-cal ====="
	run conv2d-cal.tflite 2 cal-first

	log ""
	log "===== 2) CONTROL: cal_s1, the geometry the padding fix won ====="
	log "  must still be 3/3, or the round 4 result did not survive"
	sleep 2
	run cal_s1.tflite 3 s1-keep

	log ""
	log "===== 3) md003_80: 1x1 conv at 80x80, ONE row window ====="
	log "  md003 without the split. Nearly only the kernel differs from 2."
	sleep 2
	run md003_80.tflite 3 md003-80

	log ""
	log "===== 4) md003 at 160x160 for reference, still split ====="
	sleep 2
	run md003.tflite 3 md003-160

	log ""
	log "===== 5) mn_pw24, stride-keyed 0x1018/0x1040 (today's default) ====="
	sleep 2
	run mn_pw24.tflite 3 pw24-stride

	log ""
	log "===== 6) mn_pw24, ROCKET_CBUF_DERIVE=1, keyed off the split ====="
	log "  the case where stride and split disagree. A/B against 5."
	sleep 2
	run mn_pw24.tflite 3 pw24-derive ROCKET_CBUF_DERIVE=1

	log ""
	log "===== 7) cal_s1 with ROCKET_CBUF_DERIVE=1 ====="
	log "  the vendor value for it. Must NOT regress, it passes without it."
	sleep 2
	run cal_s1.tflite 2 s1-derive ROCKET_CBUF_DERIVE=1

	log ""
	log "===== 8) REPEAT CONTROL: conv2d-cal ====="
	sleep 2
	run conv2d-cal.tflite 2 cal-last

	log ""
	log "===== 3 is the one that matters: a 1x1 conv, one window, at the    ====="
	log "===== size that works for 5x5. If it fails, the kernel is next.    ====="
	log "===== 5 vs 6 says whether 0x1018/0x1040 are load bearing at all.   ====="
	sync
}

case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
