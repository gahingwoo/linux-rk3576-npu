# ---------------------------------------------------------------------------
# 2026-08-11 round 60. WHERE in the surface is the depthwise error?
#
# Round 59's impulse run is the strongest result depthwise has produced.
# dw_imp.tflite has one live tap per channel, so the correct output of channel
# c is its own input shifted by that tap, and the hardware decoded to
#
#   CPU control decodes to its own impulse   27/32
#   hardware decodes to the SAME impulse     27/32
#   hardware reads its OWN input channel     27/32
#   correlation on every printed row         +1.000
#
# The five that "miss" give the same answer for the CPU as for the hardware, so
# they are the decoder aliasing on a ramp input, not a hardware fact. The
# channel map, the tap map and the plane order are all correct. The wiring is
# not the bug.
#
# But the same run is 0 of 32 on maxdiff, with maxdiff 200 on every channel and
# the hardware's value range, 0..219 over 220 distinct values, IDENTICAL to the
# reference's. Perfect correlation on an interior crop plus a large maxdiff over
# the whole surface means the error is somewhere the crop did not look. The
# decoder cropped rows 8 to 38.
#
# The row profile says where, and there is a specific candidate. mesa splits
# these depthwise layers into TWO tasks, which is visible as two OUT_CVT lines
# per depthwise run in every log since round 54, while conv2d-cal emits one.
# A 3x3 conv across a row-window seam needs a halo row from the neighbouring
# window, and no coefficient sweep could ever have reached that. It would also
# explain why every regular shape in this project is perfect: none of them
# tile.
#
# The pad registers are already excluded offline: the vendor writes
# 0x1080 = 0x01000101 and 0x1084 = 0xffffff80 for BOTH the depthwise and the
# regular model of the single-variable pair, and mesa's pad value matches for
# an input zero point of 0.
#
# Nothing in the driver changed. perch.py now prints which rows and columns
# carry error, the row maxdiff profile, and the maxdiff with the outer ring
# excluded.
#
# DECISION RULE, written before the run:
#   error only in the outer ring        it is the padding, and the pad value or
#                                       the pad amounts are the next target
#   error concentrated near one row     it is the tile seam, and the halo
#     in the middle                     between row windows is the bug
#   error on every row                  neither, and the affine reading of
#                                       round 59 has to be re-derived
#   conv2d-cal shows no rows at all     the control, it has no error to place
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
p() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== 1) the impulse model: where is the error? ====="
	p dw_imp.tflite ""

	log ""
	log "===== 2) mn_dw1, the same question on the real weights ====="
	p mn_dw1.tflite ""

	log ""
	log "===== 3) mn_dw25, 7x7, too small to tile: does it still err? ====="
	p mn_dw25.tflite ""

	log ""
	log "===== 4) conv2d-cal, the control with no error to place ====="
	p conv2d-cal.tflite ""

	log ""
	log "===== Read the row list. An outer ring is padding; a band in the ====="
	log "===== middle is the seam between the two row windows.            ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
