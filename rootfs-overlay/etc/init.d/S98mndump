#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-23 round 356. FOUR PROMPTS, BECAUSE TWO ARE NOT A MEASUREMENT.
#
# ✅✅ ROUND 355. THE HOIST WORKED AND ITS CONTROL HELD.
#
#   int4 group 1024   20306 ms staging of which 4270 adding and 16036 quantising
#                     (was 148428, of which 143978 quantising)
#   int8              18368 ms of which 8858 adding and 9510 quantising
#                     (was 9557 quantising -- UNCHANGED, as it must be)
#
# Quantising 144 s to 16 s, nine times, and the prompt phase fell with it from
# 189 s to 26 s. int8 never took that branch and did not move in either column.
#
# And what must not move did not: **8.96 tok/s against 8.92, and the Louvre
# sentence byte for byte.** Hoisting a getenv cannot change arithmetic, and now
# there is evidence rather than an argument.
#
# The second prompt stands up too:
#
#   int4  "The color of the sky is blue because of the way that light interacts
#          with the Earth's atmosphere. When sunlight enters the atmosphere of
#          the Earth, it encounters"
#   cpu   "The sky appears blue because of a phenomenon called Rayleigh
#          scattering, which occurs when sunlight interacts with the tiny
#          molecules of gases in the atmosphere."
#
# The CPU names Rayleigh scattering and int4 does not, but int4 is correct,
# coherent and does not circle, at 8.82 tok/s.
#
# ---------------------------------------------------------------------------
# WHERE THIS STANDS
# ---------------------------------------------------------------------------
#
#   int4, group 1024   8.96 tok/s   int8   6.53 tok/s   +37%
#   CHARSIU_NPU_W4V=1 CHARSIU_NPU_KMAX=1024 CHARSIU_NPU_W4_GROUP=1024
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# ⚠ TWO SENTENCES ARE NOT AN ACCURACY MEASUREMENT AND I HAVE BEEN SAYING SO FOR
# TWO ROUNDS. Four prompts are not either, but they are four, and they are
# chosen to fail in different ways rather than to agree:
#
#   1  the standing one, so it can be compared with every round before this
#   2  an explanation, where being wrong is visible
#   3  code, where being wrong is unambiguous
#   4  arithmetic, which is the one a narrow quantiser fails first -- the GPTQ
#      work found its worst KL on exactly this kind of prompt
#
# Each runs on int4 group 1024 and on the CPU. Sampling is greedy already
# (temp defaults to 0), so the two are directly comparable and a divergence is
# the model changing its mind, not a die roll.
#
# READ THEM AS: does int4 say something TRUE, and does it stop circling. Word
# for word agreement with the CPU is NOT the bar -- four bit weights are four
# bit weights, and int8 is the arm that matches the CPU exactly.
#
# ENTRY 9 is int8 on prompt 1 as the control, and it must still be the standing
# sentence at 6.5 tok/s.
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT
# ---------------------------------------------------------------------------
#
# Prompts 1 and 2 fine, since they already ran. Code is the one I would bet
# against: a wrong token in a Python function is not a paraphrase. If 3 or 4
# come out wrong while 1 and 2 look fine, the honest summary of int4 is "good
# for prose, not yet for code", and the next thing is GPTQ rather than a
# smaller group.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
VD=/opt/charsiu/charsiu_vendor
V=/opt/charsiu/vendor
RGC=$V/vendor-int4-k2048-n1024.regcmd
WT=$V/vendor-wt-1M.bin
IN=$V/vendor-in.bin
RUN=/opt/charsiu/charsiu_run
M8=/opt/charsiu/models/Llama-3.2-1B-Instruct-Q8_0.gguf
PROMPT="The capital of France is"
LIMIT=420
# 32 tokens does not reach the answer to "17 times 24, show your working"
NGEN=64
CE=CHARSIU_COEF_ELEMS=65536
HEAD=CHARSIU_NPU_MAXN=131072
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block did not come back this time."
		ABORT=1
	fi
}

capped() {
	lim="$1"; shift
	"$@" &
	pid=$!
	i=0
	while [ "$i" -lt "$lim" ]; do
		kill -0 "$pid" 2>/dev/null || { wait "$pid"; return $?; }
		sleep 1
		i=$((i + 1))
	done
	kill -9 "$pid" 2>/dev/null
	wait "$pid" 2>/dev/null
	return 124
}
rung() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $1"; return 0; }
	lbl="$1"; shift
	before=$(nbad)
	log ""
	log "  -- $lbl"
	sleep 1
	capped "$LIMIT" env "$@" "$RUN" "$M8" -p "$PROMPT" -n "${NGEN:-32}" \
		--ignore-eos -q -c 512 -t 4 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the rung exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This rung is VOID."; health; }
	return 0
}
# arm: <label> <regcmd-or-dash> <byte> <high> [extra env, one assignment]
#
# ⚠ THE ENV GOES IN AS AN ARGUMENT, not as a "VAR=x arm ..." prefix. Whether an
# assignment before a FUNCTION call survives the call is unspecified -- dash
# drops it, other shells keep it -- and the arm whose whole job is to time out
# WITHOUT the trailer runs right after the one that has it. Not a question worth
# leaving to the shell.
arm() {
	before=$(nbad)
	log ""
	log "  ---- $1"
	sleep 1
	env ${5:-IGNORED=1} $VD "$2" "$WT" "$IN" "$3" "$4" 4096 > /tmp/vd.txt 2>&1
	cat /tmp/vd.txt > "$C"
	after=$(nbad)
	if [ "$after" != "$before" ]; then
		log "  !! POISONED: $((after - before)) new fault or timeout lines"
		health
		# ⚠ NOT a round abort. Round 342 threw away every arm after the
		# first poisoning and then measured the block healthy at the
		# end. The block recovers; give it a moment and carry on.
		ABORT=0
		sleep 2
	fi
}

start() {
	log ""
	log "###############################################################"
	log "##### round 356: four prompts, because two are not a measurement #####"
	log "###############################################################"
	log "  int4 is byte exact and 1.42 to 1.78x faster. now decode with it."

	log ""
	log "===== 1) the standing one                    ====="
	PROMPT="The capital of France is"
	rung "int4 g1024: the standing one" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 CHARSIU_NPU_W4V=1 CHARSIU_NPU_KMAX=1024 CHARSIU_NPU_W4_GROUP=1024 "$CE" "$HEAD"
	rung "cpu:       the standing one" CHARSIU_NO_NPU=1
	log ""
	log "===== 2) an explanation                    ====="
	PROMPT="Explain in one paragraph why the sky is blue"
	rung "int4 g1024: an explanation" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 CHARSIU_NPU_W4V=1 CHARSIU_NPU_KMAX=1024 CHARSIU_NPU_W4_GROUP=1024 "$CE" "$HEAD"
	rung "cpu:       an explanation" CHARSIU_NO_NPU=1
	log ""
	log "===== 3) code                    ====="
	PROMPT="Write a Python function that reverses a string:"
	rung "int4 g1024: code" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 CHARSIU_NPU_W4V=1 CHARSIU_NPU_KMAX=1024 CHARSIU_NPU_W4_GROUP=1024 "$CE" "$HEAD"
	rung "cpu:       code" CHARSIU_NO_NPU=1
	log ""
	log "===== 4) arithmetic                    ====="
	PROMPT="What is 17 times 24? Show your working."
	rung "int4 g1024: arithmetic" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 CHARSIU_NPU_W4V=1 CHARSIU_NPU_KMAX=1024 CHARSIU_NPU_W4_GROUP=1024 "$CE" "$HEAD"
	rung "cpu:       arithmetic" CHARSIU_NO_NPU=1

	log ""
	log "===== 5) CONTROL: int8 on prompt 1. the standing sentence.    ====="
	PROMPT="The capital of France is"
	rung "int8, the standing number" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 "$CE" "$HEAD"

	log ""
	log "===== 6) the anchor: int8 conv must still be exact           ====="
	health

	log ""
	log "===== read the CONTROL lines first. VOID means the arm died. ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
