#!/bin/sh
# ---------------------------------------------------------------------------
# 2026-08-08 round 22. Round 21's control worked and refuted B.
#
#   control: conv2d-cal with B forced to 0, real input -> relu maxdiff 1 to 14,
#            FAIL. So the knob reaches the hardware and B does matter.
#   but the constant input baselines were BYTE IDENTICAL with B and without it,
#            for all three kernel sizes. With a constant input the input sum
#            that B multiplies is zero, so B cannot be the k-dependent term.
#
# What the baselines actually show, on a constant input at in_zp where the MAC
# is zero by construction and the answer must be requant(bias):
#
#   k=5  matches the cpu exactly wherever the cpu is at or above 128, and sits
#        at 128 below that. That is the ReLU at out_zp, so k=5 is CORRECT.
#   k=3  128 everywhere. requant(bias) clamped away entirely.
#   k=1  goes BELOW the zero point, down to 0. Which the same ReLU should
#        forbid, and does forbid at k=5.
#
# mesa's A cannot explain it: calculate_bias_correction and calculate_weight_sum
# are both multiplied by (input_zero_point - 0x80), which is zero here, so A is
# just the bias and the three models share one bias tensor. C is 0x4000 for a
# per-tensor conv. B is refuted above.
#
# So dump the coefficient buffer for all three and compare it byte for byte.
#
#   identical -> identical coefficients, identical requant and a MAC of zero
#                produce three different answers, and the k dependence is below
#                everything the driver writes
#   different -> mesa is emitting different coefficients after all, and the
#                difference is the bug, visible here without any hardware
#
# ⚠ The three buffers are also compared against their own sizes: A is 4 bytes
# per output channel inside a 64 byte group of 8, so a size change alone would
# say the layout moved.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }

# $1 tag, $2 model
coefs() {
	d="/tmp/$1"; rm -rf "$d"; mkdir -p "$d"; cd "$d" || return 0
	env TEFLON_LIB=/usr/lib/libteflon.so ROCKET_DEBUG=dump_bos \
		python3 "$NPU_DIR/test_dw.py" "$NPU_DIR/$2" > /dev/null 2>&1
	log "  $2:"
	for f in "$d"/mesa-biases-*.bin; do
		[ -f "$f" ] && python3 "$NPU_DIR/bstat.py" "$f" > "$C" 2>&1
	done
	cd / || return 0
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	# -n 8 floods the serial console and wedges the box. Learned the hard way.
	dmesg -n 4 2>/dev/null

	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null
	log ""
	log "  task_con16=$(cat /sys/module/rocket/parameters/task_con16 2>/dev/null)"

	log ""
	log "===== 1) CONTROL: conv2d-cal computes ====="
	env TEFLON_LIB=/usr/lib/libteflon.so \
		python3 "$NPU_DIR/test_model.py" "$NPU_DIR/conv2d-cal.tflite" 2 > "$C" 2>&1

	log ""
	log "===== 2) COEFFICIENT BUFFERS: same md5 across the three kernels? ====="
	log "  same bias tensor, A = bias since (in_zp - 0x80) is zero, C = 0x4000"
	sleep 2
	coefs cf5 conv2d-cal.tflite
	coefs cf3 cal_k3.tflite
	coefs cf1 cal_k1.tflite

	log ""
	log "===== 3) and the weight buffers, for the sizes ====="
	sleep 2
	for t in cf5 cf3 cf1; do
		for f in /tmp/$t/mesa-weights-*.bin; do
			[ -f "$f" ] && python3 "$NPU_DIR/bstat.py" "$f" > "$C" 2>&1
		done
	done

	log ""
	log "===== 4) the constant input again, as the thing being explained ====="
	sleep 2
	env TEFLON_LIB=/usr/lib/libteflon.so python3 "$NPU_DIR/flatin.py" "$NPU_DIR/conv2d-cal.tflite" > "$C" 2>&1
	env TEFLON_LIB=/usr/lib/libteflon.so python3 "$NPU_DIR/flatin.py" "$NPU_DIR/cal_k3.tflite" > "$C" 2>&1
	env TEFLON_LIB=/usr/lib/libteflon.so python3 "$NPU_DIR/flatin.py" "$NPU_DIR/cal_k1.tflite" > "$C" 2>&1

	log ""
	log "===== 5) REPEAT CONTROL: conv2d-cal ====="
	sleep 2
	env TEFLON_LIB=/usr/lib/libteflon.so \
		python3 "$NPU_DIR/test_model.py" "$NPU_DIR/conv2d-cal.tflite" 2 > "$C" 2>&1

	log ""
	log "===== 2 is the round: three md5s. Identical means the k dependence   ====="
	log "===== is below everything the driver writes.                         ====="
	sync
}

case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
