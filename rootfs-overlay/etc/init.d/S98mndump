# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-22 round 322. FEWER TASKS, UNTIL SOMETHING BREAKS.
#
# ROUND 321 SPLIT THE HARDWARE PATH AND KILLED MY RESIDUAL. Per token, all 113
# on the NPU at N=1024 K=2048:
#
#     submitting     3.3 ms    2%
#     THE FENCE    148.4 ms   94%
#     reading back   5.4 ms    3.5%
#
# The fence contains the compute, so what matters is how far above the bytes it
# sits: 1236 MB at the bench's 10.35 GB/s is 119 ms, and the fence is 148.
#
# AND THE SLICE SWEEP WAS NOT FLAT, WHICH I HAD SAID WOULD CONTRADICT 319:
#
#     slices        606     542     319     287
#     hardware ms   157.2   154.4   148.2   146.0
#     GB/s          7.86    8.00    8.34    8.46
#     tok/s         5.55    5.62    5.83    5.90
#
# ⚠ IT IS NOT A CONTRADICTION, AND PUTTING THE TWO TOGETHER IS THE RESULT.
# Round 319 varied TASKS PER SUBMIT at a fixed 606 slices and got a flat line.
# Round 321 varied HOW MANY SLICES EXIST and got a real slope. So the submit is
# nearly free and **the cost is per TASK**: 606 to 287 slices saved 11.2 ms,
# which is about 35 us a task.
#
# Text identical at every slice size, including N = 2048 and K = 4096 which
# nothing had verified at acc_out before. Those are now the defaults.
#
#   NPU 5.90 against the best CPU path's 5.53. Ahead by 6.7%.
#
# ---------------------------------------------------------------------------
# WHY THIS ROUND EXISTS
# ---------------------------------------------------------------------------
#
# If a task costs 35 us then the way to spend less is to have fewer, and the
# fewest possible is ONE PER TENSOR: 113 slices against today's 287, which at
# 35 us each is about 6 ms a token, or roughly 6.2 tokens a second.
#
# ⚠ THAT MEANS N = 8192, WHICH IS EXACTLY THE SHAPE THAT WEDGED ROUND 313 AND
# COST A POWER CYCLE. It is worth asking again, because three things have
# changed since: the output is an accumulator rather than a requantised byte,
# the coefficient buffer is 65536 elements rather than k*n, and a submit that
# stops answering now retires the hardware path instead of repeating a timeout
# forever. **The failure, if it comes, will be loud rather than fatal** -- that
# is the whole reason this can be asked at all.
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# 1) THE TEXT FIRST, character for character against entry 7. Every wider slice
#    in this round is a shape nothing has verified. A timing for a wrong answer
#    is not a timing.
#
# 2) THEN "the NPU stopped answering" IF IT APPEARS. That line naming a K and an
#    N is the most valuable thing this round can produce, because it is the
#    first honest measurement of where the shape limit actually is -- round 313
#    found it with a power cable.
#
# 3) THEN slices, hardware ms and tok/s, which should keep improving until they
#    do not.
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT
# ---------------------------------------------------------------------------
#
# A) N = 4096 WORKS AND HELPS. 199 slices, about 5.95 to 6.0 tok/s.
#
# B) N = 8192 IS WHERE IT BREAKS, and it breaks loudly. If it does not break,
#    round 313's wedge was the byte output or the 67 MB coefficient buffer and
#    not the shape, and that is worth more than the speed.
#
# C) The gain flattens before 113 slices, because 35 us a task times 174 tasks
#    is 6 ms out of 146, and the fence is still 29 ms above what the bytes need.
#    ⚠ Five timing predictions of mine in a row have been wrong, so the number
#    to take from this round is the one printed, not the one above.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
RUN=/opt/charsiu/charsiu_run
M8=/opt/charsiu/models/Llama-3.2-1B-Instruct-Q8_0.gguf
PROMPT="The capital of France is"
LIMIT=420
CE=CHARSIU_COEF_ELEMS=65536
HEAD=CHARSIU_NPU_MAXN=131072
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

capped() {
	lim="$1"; shift
	"$@" &
	pid=$!
	i=0
	while [ "$i" -lt "$lim" ]; do
		kill -0 "$pid" 2>/dev/null || { wait "$pid"; return $?; }
		sleep 1
		i=$((i + 1))
	done
	kill -9 "$pid" 2>/dev/null
	wait "$pid" 2>/dev/null
	return 124
}

rung() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $1"; return 0; }
	lbl="$1"; shift
	before=$(nbad)
	log ""
	log "  -- $lbl"
	sleep 1
	capped "$LIMIT" env "$@" "$RUN" "$M8" -p "$PROMPT" -n 32 \
		--ignore-eos -q -c 512 -t 4 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the rung exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This rung is VOID."; health; }
	return 0
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	[ -w /sys/module/rocket/parameters/reset_autosuspend ] && \
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend

	log ""
	log "===== 0) the limit's own control. expect rc 124 after ~3s.         ====="
	t0=$(cut -d. -f1 /proc/uptime)
	capped 3 sleep 60
	rc=$?
	t1=$(cut -d. -f1 /proc/uptime)
	log "  -- capped 3 sleep 60  ->  rc $rc after $((t1 - t0))s"
	[ "$rc" = "124" ] || log "  !! THE LIMIT DID NOT FIRE. Nothing below can be trusted to end."

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "##### ROUND 322: a task costs 35 us, so have fewer of them.       #####"

	log ""
	log "===== 2) the new default, N=2048 K=4096. should reproduce 5.90.    ====="
	rung "N=2048 K=4096, 287 slices" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 "$CE" "$HEAD"

	log ""
	log "===== 3) N = 4096                                                  ====="
	rung "N=4096 K=4096" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 "$CE" "$HEAD" \
		CHARSIU_NPU_NMAX=4096

	log ""
	log "===== the anchor, before the shape that wedged 313                 ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== 4) N = 8192. THIS IS ROUND 313's SHAPE. loud, not fatal.     ====="
	rung "N=8192 K=4096" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 "$CE" "$HEAD" \
		CHARSIU_NPU_NMAX=8192

	log ""
	log "===== the anchor, straight after it                                 ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== 5) and K = 8192 with it: one slice a tensor, 113 in total    ====="
	rung "N=8192 K=8192, one slice a tensor" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 \
		"$CE" "$HEAD" CHARSIU_NPU_NMAX=8192 CHARSIU_NPU_KMAX=8192

	log ""
	log "===== 6) back to the default, to show the block is still fine      ====="
	rung "N=2048 K=4096 again" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 "$CE" "$HEAD"

	log ""
	log "===== 7) the CPU reference the text is diffed against              ====="
	rung "CPU, NPU number format" CHARSIU_NPU_QUANT=1

	log ""
	log "===== the anchor again                                             ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== text first, then where it stops answering, then tok/s.       ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
