#!/bin/sh
# ---------------------------------------------------------------------------
# 2026-08-08 round 21. Round 20's probe finally worked, and it killed the tap
# pairing theory while handing over a much simpler failing case.
#
# The input impulse lands in exactly the right place for every kernel size:
#   k=5 impulse at (20,20) -> rows 9..10 cols 9..10 on both cpu and npu
#   k=5 impulse at (30,14) -> rows 14..15 cols 6..7 on both
#   k=3                    -> rows 9..10 cols 9..10 on both
#   k=1                    -> row 10 col 10 on both
# So the spatial mapping is right and nothing is paired with the wrong pixel.
# What is wrong is the GAIN: against the cpu the k=3 response is about 80x too
# small and the k=1 response about 3.5x too large.
#
# ⚠ And the baselines say it more simply than the impulses do. The baseline is a
# constant input at exactly in_zp, where (in - 0x80) is zero, so the MAC is zero
# by construction and the answer must be requant(bias). cal_k3 and cal_k1 are
# conv2d-cal with the kernel cropped, so all three carry the SAME bias and the
# SAME requant, and every log line confirms shift=25 scale=0x7d34. The answer
# still comes out different:
#
#   k=5  baseline distinct=12      k=1  distinct=45      k=3  distinct=1, flat
#
# Something k-dependent is being added to a MAC that should be exactly zero.
# The only k-dependent term in that path is B, the weight zero point correction:
# the MAC computes sum((in - 0x80)(w - 0x80)) while the true conv wants
# sum((in - in_zp)(w - wt_zp)), and B carries the difference, which scales with
# the tap count, 400 against 144 against 16.
#
#   2,3,4  the constant input on all three kernel sizes. No input data, no
#          spatial mapping: just bias through the requant.
#   5,6    the same with B forced to 0. If the three baselines converge, B is
#          the k-dependent term that does not belong.
#   7      ⚠ THE CONTROL: conv2d-cal with B forced to 0. It computes correctly
#          today, so removing a correction it needs MUST break it. If it does
#          not, the knob is not reaching the hardware.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }

flat() {
	m="$1"; shift
	env TEFLON_LIB=/usr/lib/libteflon.so "$@" \
		python3 "$NPU_DIR/flatin.py" "$NPU_DIR/$m" > "$C" 2>&1
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	# -n 8 floods the serial console and wedges the box. Learned the hard way.
	dmesg -n 4 2>/dev/null

	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null
	log ""
	log "  task_con16=$(cat /sys/module/rocket/parameters/task_con16 2>/dev/null)"

	log ""
	log "===== 1) CONTROL: conv2d-cal computes ====="
	env TEFLON_LIB=/usr/lib/libteflon.so \
		python3 "$NPU_DIR/test_model.py" "$NPU_DIR/conv2d-cal.tflite" 2 > "$C" 2>&1

	log ""
	log "===== 2,3,4) CONSTANT INPUT AT in_zp: must be identical for all k ====="
	log "  same bias, same requant, MAC zero by construction"
	sleep 2
	flat conv2d-cal.tflite
	flat cal_k3.tflite
	flat cal_k1.tflite

	log ""
	log "===== 5,6) the same three with B forced to 0 ====="
	log "  if the three converge, B is the k-dependent term that misbehaves"
	sleep 2
	flat conv2d-cal.tflite ROCKET_B_VALUE=0
	flat cal_k3.tflite ROCKET_B_VALUE=0
	flat cal_k1.tflite ROCKET_B_VALUE=0

	log ""
	log "===== 7) THE CONTROL: conv2d-cal with B forced to 0, real input ====="
	log "  it computes correctly today, so removing a correction it needs"
	log "  MUST break it. Unchanged means the knob never reached the hardware."
	sleep 2
	env TEFLON_LIB=/usr/lib/libteflon.so ROCKET_B_VALUE=0 \
		python3 "$NPU_DIR/test_model.py" "$NPU_DIR/conv2d-cal.tflite" 2 > "$C" 2>&1

	log ""
	log "===== 8) k=3 with B forced to 0, real input ====="
	sleep 2
	env TEFLON_LIB=/usr/lib/libteflon.so ROCKET_B_VALUE=0 \
		python3 "$NPU_DIR/test_model.py" "$NPU_DIR/cal_k3.tflite" 2 > "$C" 2>&1

	log ""
	log "===== 9) REPEAT CONTROL: conv2d-cal untouched ====="
	sleep 2
	env TEFLON_LIB=/usr/lib/libteflon.so \
		python3 "$NPU_DIR/test_model.py" "$NPU_DIR/conv2d-cal.tflite" 2 > "$C" 2>&1

	log ""
	log "===== Read 7 first: it must break, or 5 and 6 mean nothing. Then    ====="
	log "===== compare the three baselines in 2,3,4 against those in 5,6.    ====="
	sync
}

case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
