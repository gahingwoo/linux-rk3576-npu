#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-19 round 256. Are the one count misses exact ties, or not.
#
# WHAT 255 REFUTED, and it was my reading that was wrong rather than the
# measurement. The knob reached the hardware, every value moved every model
# monotonically, so the round counts.
#
#   mn_pw2    99.22% exact at 0, then 87.75  74.53  59.66  46.41 at .25 to 1.0
#   mn_dw1    85.62% at 0, then 98.88  86.43  76.07  76.07
#   mn_conv0  99.80% at 0, 72.65 at .5
#   conv2d-cal 99.81% at 0, WORSE IN BOTH DIRECTIONS, 74.94 at +.25 and 75.18
#              at -.25, so it already sits at its own optimum
#
# maxdiff stayed 1 at every value on every layer. The term only moves WHICH
# pixels are off by one, never by how much.
#
# ⚠ THE MISTAKE. 100 percent of misses being low does NOT mean every pixel is
# half a count low. It means the FEW pixels that miss all miss low, and on
# mn_pw2 that is 0.78 percent of them. Adding half a count moves the rounding
# boundary under EVERY pixel, which fixes that 0.78 percent and breaks a much
# larger population that was exact. The fall is about 12 percent per 0.25,
# which is the fraction of pixels a shift of that size pushes across an integer
# boundary. A global constant cannot be the fix.
#
# ⚠ EXCEPT mn_dw1, which went 85.62 to 98.88 at 0.25 and is the one case this
# project already described. Its multiplier is 0.292, and the note in the readme
# says that for a multiplier of 0.2922 the final divide is by two, so the
# intermediate lands on exactly one half for half the pixels and the reference
# rounds up every time. When the divide is by a small power of two the ties are
# a large population and the rounding rule dominates.
#
# THE QUESTION THIS ROUND ASKS. Are the missing pixels EXACT TIES. 0.25 was
# already too coarse to tell and the small end was never measured.
#
# THE READING RULE, fixed before the run.
#
#   If they are ties, exactness jumps to its maximum at the SMALLEST positive
#   value and then sits flat until the value grows enough to start pushing
#   ordinary pixels across, because breaking a tie needs any epsilon at all and
#   costs nothing else. The curve would be a step, then a plateau, then the
#   linear fall 255 already measured.
#
#   If they are not ties, exactness moves smoothly from the very first step and
#   there is no plateau. Then no global constant fixes this and the one count
#   is the reference's own rounding, which is where the readme already had it.
#
#   ⚠ Read mn_dw1 first. It has the largest tie population by the multiplier
#   argument, so if anything shows a step it does.
#
#   ⚠ mn_pw2 and mn_conv0 are the control. They sit at 99.2 and 99.8 already,
#   so a tiny epsilon must cost them almost nothing. If they fall immediately
#   then even an epsilon moves ordinary pixels and the step cannot be clean.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	after=$(nbad)
	if [ "$after" != "$before" ]; then
		log "  !! POISON in this entry. The block faulted. This result is VOID."
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" \
			> /tmp/hc.txt 2>&1
		if grep -q "128/128 channels match" /tmp/hc.txt; then
			log "  !! health OK, the block recovered, continuing"
		else
			log "  !! health FAILED, the block is gone. ABORTING the round."
			ABORT=1
		fi
	fi
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	if [ -w /sys/module/rocket/parameters/reset_autosuspend ]; then
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend
		log "reset_autosuspend = $(cat /sys/module/rocket/parameters/reset_autosuspend)"
	else
		log "!! reset_autosuspend NOT WRITABLE. A timeout will kill the round."
	fi

	log ""
	log "===== 1) the anchor, knob off                                      ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== 2+) THE SMALL END on mn_dw1, which has the biggest tie       ====="
	log "=====     population by the multiplier argument. A step here is    ====="
	log "=====     the answer.                                              ====="
	w mn_dw1.tflite ""
	for r in 0.001 0.01 0.05 0.1 0.15 0.2 0.25; do
		w mn_dw1.tflite "ROCKET_ROUND=$r"
	done

	log ""
	log "===== the control: two layers already at 99 percent. A tiny        ====="
	log "=====   epsilon must cost them almost nothing.                     ====="
	w mn_pw2.tflite ""
	for r in 0.001 0.01 0.05 0.1; do
		w mn_pw2.tflite "ROCKET_ROUND=$r"
	done
	w mn_conv0.tflite ""
	w mn_conv0.tflite "ROCKET_ROUND=0.01"
	w mn_conv0.tflite "ROCKET_ROUND=0.1"

	log ""
	log "===== and the negative small end, in case the tie breaks the       ====="
	log "=====   other way on a layer whose misses are high                 ====="
	w conv2d-cal.tflite "ROCKET_ROUND=0.01"
	w conv2d-cal.tflite "ROCKET_ROUND=-0.01"
	w conv2d-cal.tflite "ROCKET_ROUND=-0.1"

	log ""
	log "===== the deep pair, same question at the other end of the net     ====="
	w mn_dw25.tflite ""
	w mn_dw25.tflite "ROCKET_ROUND=0.01"
	w mn_pw24.tflite ""
	w mn_pw24.tflite "ROCKET_ROUND=0.01"

	log ""
	log "===== a final anchor                                               ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== Read 1 and 2, then 3 against 4. The bar is the arm beside it ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
