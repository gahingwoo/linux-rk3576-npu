#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-23 round 360. LATE DATA, OR DATA THAT WAS NEVER WRITTEN.
#
# ✅ ROUND 359's CONTROL HELD AND THAT SETTLES THE FRAME. A solo process was
# clean three times out of three, 0 words differing, so this IS about
# concurrency and nothing else.
#
# ⛔ AND THE FAILURE IS SPECIFIC. Across eight concurrent processes it hit five,
# on A as often as on B, and the giveaway is in the live word counts:
#
#   solo, three times            1024 live, 0 differ, 0 differ, 0 differ
#   pair 1   A 1024 live 0       B 1024 live  88 differ
#   pair 2   A 1024 live 0       B **1022 live** 212 differ
#   pair 3   A 1024 live 0       B 1024 live   0 differ
#   pair 4   A **1022 live** 221 B 1024 live  97 differ
#   pair 5   A 1024 live 385
#   mixed    A **1020 live** 240 B (N=256) 256 live, 0 differ, clean
#
# **Words that should be live come back ZERO.** That is a missing write, not
# swapped data, and the small job at N = 256 was never once affected.
#
# ⚠ ROUND 359's ENTRY 3 MEASURED NOTHING. The glob
# /sys/devices/platform/2770*.npu/power/control matched no path, sh left it
# literal, and the write failed with "nonexistent directory" -- which the log
# printed and I should have caught before calling it a power management test.
# The devices are under /sys/bus/platform/devices. So the power hypothesis is
# still untested, not refuted.
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# ENTRY 2 IS THE QUESTION AND IT NEEDS NO TIMING GUESS. CHARSIU_REREAD takes the
# output buffer through another cache round trip -- fini then prep, so the lines
# are genuinely invalidated -- and reads it again:
#
#   the missing words are THERE the second time  -> the fence signalled before
#       the NPU's writes had landed, and the fix is ordering in the driver
#   they are still missing                       -> they were never written and
#       the fix is somewhere else entirely
#
# A plain second memcpy would have proved nothing, since the lines are in cache
# by then and would read back exactly what the first read saw.
#
# ENTRY 3 is the power management test done properly this time, at the path that
# exists. ENTRY 4 raises the autosuspend delay instead of pinning, which is the
# same hypothesis approached from the other side.
#
# ENTRY 1 is the solo control and must still be clean, or the whole frame moves.
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT
# ---------------------------------------------------------------------------
#
# The reread finds them. A fence that signals early is the ordinary way to get
# missing words with no fault and no error, it explains why only the bigger job
# suffers -- more bytes still in flight when the IRQ arrives -- and it explains
# why a solo run never sees it, because nothing else is competing for the write
# path.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
VD=/opt/charsiu/charsiu_vendor
V=/opt/charsiu/vendor
RGC=$V/vendor-int4-k2048-n1024.regcmd
WT=$V/vendor-wt-1M.bin
IN=$V/vendor-in.bin
RUN=/opt/charsiu/charsiu_run
M8=/opt/charsiu/models/Llama-3.2-1B-Instruct-Q8_0.gguf
PROMPT="The capital of France is"
LIMIT=420
# 32 tokens does not reach the answer to "17 times 24, show your working"
NGEN=64
CE=CHARSIU_COEF_ELEMS=65536
HEAD=CHARSIU_NPU_MAXN=131072
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block did not come back this time."
		ABORT=1
	fi
}

capped() {
	lim="$1"; shift
	"$@" &
	pid=$!
	i=0
	while [ "$i" -lt "$lim" ]; do
		kill -0 "$pid" 2>/dev/null || { wait "$pid"; return $?; }
		sleep 1
		i=$((i + 1))
	done
	kill -9 "$pid" 2>/dev/null
	wait "$pid" 2>/dev/null
	return 124
}
rung() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $1"; return 0; }
	lbl="$1"; shift
	before=$(nbad)
	log ""
	log "  -- $lbl"
	sleep 1
	capped "$LIMIT" env "$@" "$RUN" "$M8" -p "$PROMPT" -n "${NGEN:-32}" \
		--ignore-eos -q -c 512 -t 4 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the rung exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This rung is VOID."; health; }
	return 0
}
# arm: <label> <regcmd-or-dash> <byte> <high> [extra env, one assignment]
#
# ⚠ THE ENV GOES IN AS AN ARGUMENT, not as a "VAR=x arm ..." prefix. Whether an
# assignment before a FUNCTION call survives the call is unspecified -- dash
# drops it, other shells keep it -- and the arm whose whole job is to time out
# WITHOUT the trailer runs right after the one that has it. Not a question worth
# leaving to the shell.
arm() {
	before=$(nbad)
	log ""
	log "  ---- $1"
	sleep 1
	env ${5:-IGNORED=1} $VD "$2" "$WT" "$IN" "$3" "$4" 4096 > /tmp/vd.txt 2>&1
	cat /tmp/vd.txt > "$C"
	after=$(nbad)
	if [ "$after" != "$before" ]; then
		log "  !! POISONED: $((after - before)) new fault or timeout lines"
		health
		# ⚠ NOT a round abort. Round 342 threw away every arm after the
		# first poisoning and then measured the block healthy at the
		# end. The block recovers; give it a moment and carry on.
		ABORT=0
		sleep 2
	fi
}

# two concurrent probes, so the pair can be repeated without copy and paste
pair() {
	before=$(nbad)
	log ""
	log "  ---- $1"
	env CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_TIME=60 CHARSIU_OUT_KB=64 $2 $VD - "$WT" "$IN" 0 0 4096 > /tmp/vdA.txt 2>&1 &
	pidA=$!
	env CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_TIME=60 CHARSIU_OUT_KB=64 $3 $VD - "$WT" "$IN" 0 0 4096 > /tmp/vdB.txt 2>&1 &
	pidB=$!
	wait "$pidA"
	wait "$pidB"
	log "    A:"
	grep -E "M = |TIME:|baseline:|CONTROL repeat|VOID|REREAD" /tmp/vdA.txt > "$C"
	log "    B:"
	grep -E "M = |TIME:|baseline:|CONTROL repeat|VOID|REREAD" /tmp/vdB.txt > "$C"
	after=$(nbad)
	[ "$after" != "$before" ] && log "  !! POISONED: $((after - before)) new lines"
	return 0
}

start() {
	log ""
	log "###############################################################"
	log "##### round 360: late data, or data never written?           #####"
	log "###############################################################"
	log "  int4 is byte exact and 1.42 to 1.78x faster. now decode with it."

	log ""
	log "===== 0) the cores, and where their power knobs actually are   ====="
	dmesg 2>/dev/null | grep -i "NPU core" > "$C"
	for d in /sys/bus/platform/devices/2770*.npu; do
		log "  $d control=$(cat "$d/power/control" 2>/dev/null) delay=$(cat "$d/power/autosuspend_delay_ms" 2>/dev/null)"
	done

	log ""
	log "===== 1) CONTROL: one process. must still be clean.            ====="
	arm "solo" "-" 0 0 "CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_TIME=60 CHARSIU_OUT_KB=64"

	log ""
	log "===== 2) THE QUESTION: a pair, with the cache re-read on       ====="
	log "  REREAD lines mean the data was still landing when the fence"
	log "  said it was done. no REREAD line and a differing control"
	log "  means it was never written."
	pair "pair, reread 1" "CHARSIU_REREAD=1" "CHARSIU_REREAD=1"
	pair "pair, reread 2" "CHARSIU_REREAD=1" "CHARSIU_REREAD=1"
	pair "pair, reread 3" "CHARSIU_REREAD=1" "CHARSIU_REREAD=1"

	log ""
	log "===== 3) runtime PM pinned on, at the path that exists         ====="
	for d in /sys/bus/platform/devices/2770*.npu; do
		echo on > "$d/power/control" 2>/dev/null
		log "  $d control=$(cat "$d/power/control" 2>/dev/null)"
	done
	pair "pair, PM on 1" "CHARSIU_REREAD=1" "CHARSIU_REREAD=1"
	pair "pair, PM on 2" "CHARSIU_REREAD=1" "CHARSIU_REREAD=1"

	log ""
	log "===== 4) the same hypothesis from the other side: a long delay ====="
	for d in /sys/bus/platform/devices/2770*.npu; do
		echo auto > "$d/power/control" 2>/dev/null
		echo 60000 > "$d/power/autosuspend_delay_ms" 2>/dev/null
		log "  $d control=$(cat "$d/power/control" 2>/dev/null) delay=$(cat "$d/power/autosuspend_delay_ms" 2>/dev/null)"
	done
	pair "pair, 60 s autosuspend" "CHARSIU_REREAD=1" "CHARSIU_REREAD=1"
	for d in /sys/bus/platform/devices/2770*.npu; do
		echo 50 > "$d/power/autosuspend_delay_ms" 2>/dev/null
	done

	log ""
	log "===== 5) the anchor: int8 conv must still be exact            ====="
	health

	log ""
	log "===== read the CONTROL lines first. VOID means the arm died. ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
