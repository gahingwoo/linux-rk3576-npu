#!/bin/sh
# ---------------------------------------------------------------------------
# Two runs in one image (2026-08-05).
#
# Steps 1-4 are the v5 verification. Igor Paunovic refused the Tested-by on v4
# because patch 4 shipped the ping-pong experiment by mistake, including a
# state_init call that fires on RK3588 too. v5 trims it back to the two real
# fixes. These four steps are the evidence that the trim did not break anything
# here, with every debug knob left off.
#
# Step 5 is his question: on the submits that compute nothing, is the regcmd
# read at all? See test_probe.py. It runs last because a poisoned submit fails
# and gets recovered by a reset, and a reset re-arms the pipeline, which would
# contaminate anything measured after it.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	# -n 8 floods the serial console and wedges the box. Learned the hard way.
	dmesg -n 4 2>/dev/null

	log ""
	log "===== 1) does the NPU come up at all ====="
	log "  accel node: $(ls /dev/accel/ 2>/dev/null)"
	dmesg | grep -iE "rknn|rocket|failed to attach" | head -6 > "$C" 2>&1

	log ""
	log "===== 2) known good single conv, six times, must stay byte exact ====="
	env TEFLON_LIB=/usr/lib/libteflon.so \
		python3 "$NPU_DIR/test_twice.py" "$NPU_DIR/conv2d-cal.tflite" 6 > "$C" 2>&1

	log ""
	log "===== 3) A -> B -> A, unchanged behaviour expected ====="
	env TEFLON_LIB=/usr/lib/libteflon.so \
		python3 "$NPU_DIR/test_aba.py" "$NPU_DIR/conv2d-cal.tflite" "$NPU_DIR/conv2d.tflite" > "$C" 2>&1

	log ""
	log "===== 4) teardown: unbind and rebind, then run again ====="
	echo 27700000.npu > /sys/bus/platform/drivers/rocket/unbind 2>/dev/null
	sleep 1
	echo 27700000.npu > /sys/bus/platform/drivers/rocket/bind 2>/dev/null
	sleep 2
	log "  accel node after rebind: $(ls /dev/accel/ 2>/dev/null)"
	env TEFLON_LIB=/usr/lib/libteflon.so \
		python3 "$NPU_DIR/test_twice.py" "$NPU_DIR/conv2d-cal.tflite" 2 > "$C" 2>&1
	log "--- any oops or warning from the teardown? ---"
	dmesg | grep -iE "Unable to handle|Internal error|WARNING|use-after" | head -4 > "$C" 2>&1

	log ""
	log "===== v5 verdict: 1 shows accel0 and no attach failure, 2 six OKs, ====="
	log "===== 3 A ok B wrong A ok, 4 rebinds clean. Anything else blocks v5. ====="

	log ""
	log "===== 5) CONTROL: scribble the regcmd before the FIRST submit ====="
	log "  (nothing can be resident yet, so this one must come back WRONG)"
	env TEFLON_LIB=/usr/lib/libteflon.so \
		python3 "$NPU_DIR/test_scribble.py" "$NPU_DIR/conv2d-cal.tflite" control > "$C" 2>&1

	log ""
	log "===== 6) QUESTION: scribble the regcmd of a REPEAT submit ====="
	sleep 3
	env TEFLON_LIB=/usr/lib/libteflon.so \
		python3 "$NPU_DIR/test_scribble.py" "$NPU_DIR/conv2d-cal.tflite" question > "$C" 2>&1

	# Round 3 compared B's output with and without a corrupted regcmd. B writes a
	# flat zero point surface either way, so two constant buffers always compared
	# identical and the test could not fail. Replaced with one that can: mark the
	# output buffer and see whether anything overwrites the mark.

	log ""
	log "===== 7) CONTROL: prefill the output of a submit that DOES compute ====="
	log "  (the marker must be gone, or nothing below counts)"
	sleep 3
	env TEFLON_LIB=/usr/lib/libteflon.so \
		python3 "$NPU_DIR/test_written.py" "$NPU_DIR/conv2d-cal.tflite" control > "$C" 2>&1

	log ""
	log "===== 8) THE WALL: prefill the output of B's submit, the one that walls ====="
	sleep 3
	env TEFLON_LIB=/usr/lib/libteflon.so \
		python3 "$NPU_DIR/test_written.py" "$NPU_DIR/conv2d-cal.tflite" test \
			"$NPU_DIR/conv2d.tflite" > "$C" 2>&1

	# ---------------------------------------------------------------------
	# Single-op models are fixed by TASK_CON and complete on the real interrupt
	# with the poll off. Multi-task graphs all timed out in that same regime,
	# but no_poll=1 makes a timeout the only outcome for a job that does not
	# raise the interrupt, so that run could not tell "computes wrong" from
	# "computes fine but never signals". Run each model both ways, adjacent.
	# ---------------------------------------------------------------------
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/job_log 2>/dev/null
	log ""
	log "  task_con16=$(cat /sys/module/rocket/parameters/task_con16 2>/dev/null)"

	for m in conv2d-cal conv2x dwconv mobilenet_v1_1.0_224_quant; do
		for np in 0 1; do
			echo $np > /sys/module/rocket/parameters/no_poll 2>/dev/null
			log ""
			log "===== $m   no_poll=$np ($([ $np = 0 ] && echo 'poll on' || echo 'interrupt only')) ====="
			dmesg -C 2>/dev/null
			sleep 2
			env TEFLON_LIB=/usr/lib/libteflon.so \
				python3 "$NPU_DIR/test_model.py" "$NPU_DIR/$m.tflite" 3 > "$C" 2>&1
			log "  jobs this model: $(dmesg | grep -ac 'job: task_count')  first: $(dmesg | grep -a 'job: task_count' | head -1 | sed 's/.*job: //')"
			log "  timeouts: $(dmesg | grep -ac 'job timed out')"
		done
	done

	log ""
	log "===== done. For each model compare the two rows. Same failure both ways ====="
	log "===== means the compute is wrong; passes with poll on means the multi   ====="
	log "===== task completion interrupt is what is missing.                     ====="
	sync
}

case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
