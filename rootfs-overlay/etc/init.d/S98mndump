# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-18 round 245. Run the four claims the v8 cover letter makes and that
# I have not measured on this code.
#
# WHY. The "Where it stands" list in the cover letter was carried over from
# v7. Three of its lines I verified this week. Four I did not, and this build
# has moved the power rail, added synchronize_irq to the reset path and
# swapped a udelay for a sleep since those four were last run. Carrying a
# previous version's runs as if they were this version's is the exact habit
# this whole round is cleaning up, so either they reproduce here or they come
# out of the letter.
#
# THE FOUR
#   1 the NPU probes with the two domain list and no attach failure
#   2 a convolution submitted three times with three different inputs is byte
#     exact against the CPU reference each time, with nothing retiring the job
#     but the interrupt
#   3 the NPU interrupt count goes from zero to three across those submits,
#     one each and no more
#   4 unbind and rebind is clean with no warning
#
# READING RULES, fixed before the run.
#
#   Claim 2 has two halves and they are scored separately. perch.py's headline
#   is maxdiff at most 1, which tolerates an off by one, so this image adds a
#   strict line. If EXACT says BYTE EXACT on all three seeds the word stays in
#   the letter. If it says NOT byte exact the word comes out and is replaced
#   by what the strict count actually is. Either way the three seeds differ, so
#   a stale output buffer cannot pass as three recomputations.
#
#   Claim 3 is the interrupt line read before and after each submit. Exactly
#   one per submit and no more. Any other number and the claim is wrong as
#   worded, whichever direction it goes.
#
#   Claim 4 is dmesg between the unbind and the rebind. Any WARNING, any call
#   trace, any refcount message and it is not clean. The run after the rebind
#   is the part that matters most, since a rebind that leaves a dead block is
#   worse than one that warns.
#
#   ⚠ NOT A CLAIM AND NOT UNDER TEST HERE. The reset path still does not bring
#   the block back after a timeout, round 244 showed that twice with rk_iommu
#   reporting MMU_DTE_ADDR not functioning. Nothing below times a job out, so
#   nothing below says anything about that.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
log() { echo "$@" > "$C"; }
w() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }

irqs() { log "    IRQ $1  $(grep -iE 'npu|rknn' /proc/interrupts | tr -s ' ' | sed 's/^ //' | tr '\n' '|')"; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null

	log ""
	log "===== CLAIM 1) probe. Every rocket, rknn, iommu and power domain  ====="
	log "=====    line from the boot log. Any attach failure shows here.   ====="
	dmesg | grep -iE "rocket|rknn|27700000|27702000|power domain|genpd" > "$C" 2>&1
	log ""
	log "    the two domain list, from sysfs"
	ls -1 /sys/bus/platform/devices/27700000.npu/power/ 2>/dev/null | tr '\n' ' ' > "$C" 2>&1
	log ""
	for d in /sys/bus/platform/devices/27700000.npu/*power-domain*; do log "    $d"; done 2>/dev/null

	log ""
	log "===== CLAIM 2 and 3) three submits, three different inputs.       ====="
	log "=====    Read the EXACT line on each. The interrupt count must    ====="
	log "=====    rise by exactly one per submit.                          ====="
	irqs "before any submit"
	w conv2d-cal.tflite "ROCKET_SEED=7"
	irqs "after submit 1"
	w conv2d-cal.tflite "ROCKET_SEED=11"
	irqs "after submit 2"
	w conv2d-cal.tflite "ROCKET_SEED=23"
	irqs "after submit 3"

	log ""
	log "===== CLAIM 4) unbind and rebind                                  ====="
	dmesg -c > /dev/null 2>&1
	log "    unbinding"
	echo 27700000.npu > /sys/bus/platform/drivers/rocket/unbind 2>&1 > "$C"
	sleep 2
	log "    dmesg since the unbind"
	dmesg > "$C" 2>&1
	log "    rebinding"
	echo 27700000.npu > /sys/bus/platform/drivers/rocket/bind 2>&1 > "$C"
	sleep 3
	log "    dmesg since the rebind"
	dmesg > "$C" 2>&1
	log "    warnings and traces in that window: $(dmesg | grep -ciE 'WARNING|Call trace|refcount|BUG')"

	log ""
	log "===== CLAIM 4b) the rebound block must still compute              ====="
	irqs "after the rebind, before the submit"
	w conv2d-cal.tflite "ROCKET_SEED=7"
	irqs "after the post rebind submit"

	log ""
	log "===== Read the EXACT lines first. They decide one word in the     ====="
	log "=====    cover letter, and the word is currently wrong or right   ====="
	log "=====    with no evidence either way.                             ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
