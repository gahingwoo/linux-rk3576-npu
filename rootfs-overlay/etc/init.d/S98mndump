# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-20 round 277. Every round so far has been K = 64.
#
# ⚠ THE CHANNEL HALF IS SOLVED. 0x3020 = 111 at N = 64: 256 groups swept, 128
# live, 64 distinct words lit, range 0 to 63, and 64 written. Written AND
# reachable, which is the distinction 266 got wrong and this round checked
# properly. The derived prediction was 128 live groups and 64 words and that is
# what came back.
#
# WHAT THAT CONFIGURATION IS TODAY, with no other change:
#
#   64 channels, each fed by 16 weight bytes = 32 nibbles = 32 k
#   arithmetic is the SHIPPED mode, whose formula is known exactly:
#     out = ((int16)fp16bits(w) * (int16)abits) >> 16, seven for seven
#
# ⚠ AND HERE IS WHAT NOBODY HAS ASKED. K HAS BEEN 64 IN EVERY ROUND. If bytes
# per channel is K/4 rather than a fixed 16, then at K = 32 those same 16 bytes
# are ALL 32 of the k, and that configuration is a complete and correct matmul
# TODAY, with the exact arithmetic already in hand and no CONV_CON1 change at
# all. K = 64 would then be two chained jobs rather than a defect.
#
# That is the round. It is also the first path that does not need the k fix.
#
# THE k FIX INTERACTION, and a pattern worth one entry. Under it, v = 71, 79,
# 87, 95, 103 and 111 ALL hang, and the only two values that have ever survived
# it are 63 and 127. Both of those are 2^n - 1 and none of the six is. That is a
# clean split on eight points and it has never been tested as a rule.
#
# THE READING RULE, fixed before the run.
#
#   ⚠ ENTRY 2 IS THE ROUND. K = 32, N = 64, v = 111. The weight buffer is 1024
#   bytes and 64 channels times 16 is exactly 1024.
#
#     128 live groups of 128, 64 words lit    every byte of the buffer is
#                                             fetched and every channel reached.
#                                             With entry 3 confirming k 0..31 it
#                                             is a complete matmul at K = 32.
#     64 live groups                          bytes per channel is a fixed 16
#                                             regardless of K, so half the k is
#                                             missing at every K and the fix is
#                                             the only way
#     fewer channels than 64                  0x3020's meaning depends on K too,
#                                             which nothing has suggested
#
#   ENTRY 3 is the k map at K = 32. Bytes 0 and 8 must give k 0 and k 16 of the
#   same channel if the 16 bytes really span the whole reduction.
#
#   ENTRY 4 is K = 16 and K = 128 against the same question, so bytes per
#   channel is read as a function of K on three points rather than assumed from
#   one.
#
#   ENTRY 5 tests 2^n - 1 as a rule for surviving the k fix: 15, 31, 127 and 255
#   should live and 119 should hang. Four predictions from an eight point split.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
CH=/opt/charsiu/charsiu_int4
FIX=0x100c=0x20600020
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

c() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $*"; return 0; }
	before=$(nbad)
	sleep 1
	env $1 $2 $CH $3 $4 $5 $6 $7 $8 > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This arm is VOID."; health; }
	return 0
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	if [ -w /sys/module/rocket/parameters/reset_autosuspend ]; then
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend
		log "reset_autosuspend = $(cat /sys/module/rocket/parameters/reset_autosuspend)"
	else
		log "!! reset_autosuspend NOT WRITABLE. A timeout will kill the round."
	fi

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== 2) THE ROUND. K = 32, N = 64, v = 111. 1024 weight bytes.    ====="
	log "=====    64 channels x 16 bytes is exactly 1024. All of it, or half ====="
	log ""
	c "CHARSIU_OVERRIDE=0x3020=111" X=1 1 32 64 --map 8

	log ""
	log "===== 3) the k map at K = 32. byte 8 must be k 16 of the SAME word ====="
	c "CHARSIU_OVERRIDE=0x3020=111" CHARSIU_KPAIR_BYTES=0,4,8,12,16,512 1 32 64 --kpair

	log ""
	log "===== 4) K = 16 and K = 128, same question                         ====="
	c "CHARSIU_OVERRIDE=0x3020=111" X=1 1 16 64 --map 8
	c "CHARSIU_OVERRIDE=0x3020=111" X=1 1 128 64 --map 8 512

	log ""
	log "##### 5) is 2^n - 1 the rule for surviving the k fix.              #####"
	for v in 15 31 119 127 255
	do
		log ""
		log "===== ARM 0x3020=$v + k fix   (15 31 127 255 live, 119 hangs)"
		c "CHARSIU_OVERRIDE=$FIX,0x3020=$v" X=1 1 64 64 --map 8 128
	done

	log ""
	log "===== the anchor again                                             ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== entry 2. 128 live groups is a complete matmul at K = 32.     ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
