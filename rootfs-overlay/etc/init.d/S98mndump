#!/bin/sh
# ---------------------------------------------------------------------------
# 2026-08-08 round 3. Round 2 killed both of its own hypotheses:
#
#   cal_ozp0   conv2d-cal with out_zp forced to 0   -> 3/3 OK   (zero point is not it)
#   cal_izp0   conv2d-cal with in_zp forced to 0    -> 3/3 OK
#   mn_pw24    one task, zp 0                       -> 0/3 FAIL (task split is not it)
#   md003      16 in / 16 out channels, like cal    -> 0/3 FAIL (channel count is not it)
#
# What the table says now is blunter than any of those: conv2d-cal is the ONLY
# convolution geometry this driver has ever computed correctly, and it is the
# only one that is 5x5 STRIDE 2. Every failure is stride 1 except mn_conv0,
# which takes the separate first-conv path on 3 input channels.
#
# Two things run here, so the round is useful either way.
#
# PROBE. Change only the stride. SAME padding makes the output ceil(in/stride),
# which mutate_stride.py resizes; weights, scales and zero points do not move.
#   cal_s1     conv2d-cal 5x5 stride 2 -> 1.  Stride predicts FAIL
#   md003_s2   md003 1x1 stride 1 -> 2.       Stride predicts PASS
# Both must flip, or stride joins the list of refuted single variables.
#
# EVIDENCE. Dump and decode the regcmd mesa emits for the passing conv2d-cal and
# for cal_s1, which differ in one variable. That is a readable diff whatever the
# verdict, and it is the input to the vendor comparison on the host: the method
# that broke the TASK_CON wall was diffing an ordered register trace against the
# vendor's, not guessing which knob mattered.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }

# $1 model, $2 runs, $3 unique marker (two steps running the same model would
# otherwise share a marker and the dmesg slice would replay the first one, which
# is what made step 8 print step 1's task_count last round)
run() {
	echo "SMARK-$3" > /dev/kmsg 2>/dev/null
	env TEFLON_LIB=/usr/lib/libteflon.so \
		python3 "$NPU_DIR/test_model.py" "$NPU_DIR/$1" "${2:-3}" > "$C" 2>&1
	dmesg | sed -n "/SMARK-$3/,\$p" | grep -a "job: task_count=" | head -3 > "$C" 2>&1
}

# Emit the regcmd mesa built for one model, decoded.
regcmd() {
	rm -rf /tmp/rc; mkdir -p /tmp/rc; cd /tmp/rc || return 0
	env TEFLON_LIB=/usr/lib/libteflon.so ROCKET_DEBUG=dump_bos \
		python3 "$NPU_DIR/test_dw.py" "$NPU_DIR/$1" > /dev/null 2>&1
	for f in /tmp/rc/mesa-regcmd-*.bin; do
		[ -f "$f" ] || continue
		log "--- $1 $(basename "$f") ---"
		python3 "$NPU_DIR/extract_regcmd.py" "$f" 8 > "$C" 2>&1
	done
	cd / || return 0
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	# -n 8 floods the serial console and wedges the box. Learned the hard way.
	dmesg -n 4 2>/dev/null

	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/job_log 2>/dev/null
	log ""
	log "  task_con16=$(cat /sys/module/rocket/parameters/task_con16 2>/dev/null)" \
	    "job_log=$(cat /sys/module/rocket/parameters/job_log 2>/dev/null)"

	log ""
	log "===== 1) CONTROL: conv2d-cal, 5x5 stride 2, the one that computes ====="
	run conv2d-cal.tflite 3 cal-first

	log ""
	log "===== 2) cal_s1: conv2d-cal with ONLY the stride 2->1 ====="
	log "  stride hypothesis says FAIL. Everything else about it is unchanged."
	sleep 2
	run cal_s1.tflite 3 cal-s1

	log ""
	log "===== 3) md003_s2: md003 with ONLY the stride 1->2 ====="
	log "  stride hypothesis says PASS. It failed at stride 1 last round."
	sleep 2
	run md003_s2.tflite 3 md003-s2

	log ""
	log "===== 4) REPEAT CONTROL: conv2d-cal again ====="
	sleep 2
	run conv2d-cal.tflite 2 cal-last

	log ""
	log "===== 5) REGCMD: what mesa emits for the pass and for cal_s1 ====="
	log "  one variable apart, so this diff is readable whatever 2 says"
	sleep 2
	regcmd conv2d-cal.tflite
	log ""
	regcmd cal_s1.tflite

	log ""
	log "===== 2 and 3 must BOTH flip for stride to be the answer. If they   ====="
	log "===== do not, stride is refuted too and the regcmd in 5 is where    ====="
	log "===== the next step comes from.                                     ====="
	sync
}

case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
