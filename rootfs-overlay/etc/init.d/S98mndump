#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-22 round 313. A PROJECTION ON THE NPU, INSIDE THE DECODE LOOP.
#
# Round 312 finished the output stage. 0x40b8 = 3 was the last register between
# charsiu and the vendor's own w4a16 block, found by diffing the two offline,
# and the board swept it into a reading rather than a guess:
#
#     0x40b8      0    1    2    3    4    7   15
#     bytes     112  160  208  256  208  128   64
#     exact       4    8   12   64   16   16   16
#
# A peak on both columns, not a trend. And at a projection's shape, M=1 K=2048
# N=1024: **4096 of 4096 bytes written, 1024 of 1024 elements byte exact against
# the accumulator.** So the hardware hands back the complete raw int32 sum.
#
# ⚠ It did NOT undo int4's half width. int4 with 0x40b8=3 goes from 136 words
# written to 256 -- so int4's write geometry was short too -- but its exact
# count falls from 128 to 16 and the survivors are g0 and g30. The placement
# moved. int4 stays closed; that is a lead for whoever reopens it, not a result.
#
# ---------------------------------------------------------------------------
# WHAT IS NEW, AND WHY THE ACCEPTANCE TEST IS NOT "COHERENT TEXT"
# ---------------------------------------------------------------------------
#
# charsiu_run can now put a projection on the hardware. The substitution is
# exact rather than approximate, because the CPU already computes the same sum:
#
#     acc[n] = sum_k a_q[k] * w_q[n][k]        <- the CPU, and now the DPU
#     y[n]   = acc[n] * a_scale * w_scale[n]   <- always the CPU
#
# So the two runs must produce **the same tokens, character for character**.
# Not similar. Not coherent. The same. Anything else is a defect with a known
# reference to bisect against, which is the whole reason the CPU loop was built
# first.
#
#   CHARSIU_NPU=1        open the device and route what fits
#   CHARSIU_NPU_ONLY=S   route only tensors whose name contains S
#   CHARSIU_NPU_MAXN=N   skip anything wider (default 8192, which leaves the
#                        128256 wide output head on the CPU)
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# 1) ENTRY 2 IS THE REFERENCE, on the CPU, and every line below it is diffed
#    against this one and nothing else:
#
#      Paris. The Eiffel Tower is located in Paris. The Eiffel Tower is one of
#      the most famous landmarks in the world. It was built for
#
# 2) ENTRY 3 IS THE ROUND, and it is a LADDER. One projection, then all sixteen
#    of one kind, then attention, then the feed forward, then everything.
#    **Read the FIRST rung that differs.** A ladder exists so that a
#    disagreement names one tensor rather than a hundred and thirteen, and
#    reading only the last rung throws that away.
#
# 3) Each rung prints "on the NPU" or "on the CPU" per tensor when verbose. If a
#    rung says "on the CPU" for everything, no buffer could be allocated and the
#    rung is a CPU run wearing an NPU label. Check that before reading its text.
#
# 4) TOKENS PER SECOND ARE NOT THE POINT OF THIS ROUND. There is one submit per
#    projection and no chaining, so 112 submits a token at about 200 to 550 us
#    each is the floor. Record it; do not compare it to 5.53 yet.
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT
# ---------------------------------------------------------------------------
#
# A) EVERY RUNG PRODUCES THE REFERENCE TEXT EXACTLY. The arithmetic is the same
#    integer sum on both sides and round 312 measured 1024 of 1024 elements
#    exact at this very shape. If a rung diverges, the likeliest causes in
#    order: the input packing (a_q + 128 through charsiu_pack_input), the
#    coefficient buffer being read when acc_out should bypass it, and the
#    output surface at an N that is not 1024.
#
# B) THE FULL RUNG WILL ALLOCATE 973 MB OF WEIGHT BUFFERS ACROSS 112 BOs. That
#    has never been done on this driver. If it fails it fails gracefully -- the
#    tensor stays on the CPU and says so -- so the failure mode is a quiet
#    downgrade rather than a crash, and entry 3's per tensor lines are how it
#    is caught.
#
# C) 1 to 4 tokens a second, dominated by 112 unchained submits.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
RUN=/opt/charsiu/charsiu_run
M8=/opt/charsiu/models/Llama-3.2-1B-Instruct-Q8_0.gguf
PROMPT="The capital of France is"
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

# $1 label, $2.. env
rung() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $1"; return 0; }
	lbl="$1"; shift
	before=$(nbad)
	log ""
	log "  -- $lbl"
	sleep 1
	env "$@" "$RUN" "$M8" -p "$PROMPT" -n 32 --ignore-eos -q -c 512 -t 4 \
		> "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This rung is VOID."; health; }
	return 0
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	[ -w /sys/module/rocket/parameters/reset_autosuspend ] && \
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "##### ROUND 313: a projection on the NPU, in the decode loop.      #####"

	log ""
	log "===== 2) THE REFERENCE. the same arithmetic, on the CPU.           ====="
	rung "CPU, NPU number format" CHARSIU_NPU_QUANT=1

	log ""
	log "===== 3) THE LADDER. read the FIRST rung that differs.             ====="

	log ""
	log "===== one projection: blk.0.attn_q"
	rung "blk.0.attn_q on the NPU" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 \
		CHARSIU_NPU_ONLY=blk.0.attn_q CHARSIU_NPU_VERBOSE=1

	log ""
	log "===== all sixteen attn_q"
	rung "attn_q on the NPU" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 \
		CHARSIU_NPU_ONLY=attn_q

	log ""
	log "===== every attention projection"
	rung "attn on the NPU" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 \
		CHARSIU_NPU_ONLY=attn

	log ""
	log "===== every feed forward projection"
	rung "ffn on the NPU" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 \
		CHARSIU_NPU_ONLY=ffn

	log ""
	log "===== the anchor, before the biggest rung                          ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== everything under n = 8192, which is 112 tensors"
	rung "all projections on the NPU" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1

	log ""
	log "===== 4) the plain CPU loop, so the tree is still sane             ====="
	rung "plain CPU" X=1

	log ""
	log "===== the anchor again                                             ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== the reference, then the first rung that differs from it.     ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
