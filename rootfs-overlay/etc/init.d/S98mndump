# ---------------------------------------------------------------------------
# 2026-08-23 round 346. THE WHOLE THING IS DECODED. NOW CHECK IT PROPERLY.
#
# 🔑🔑🔑 ROUND 345 GAVE THE LAYOUT, AND IT CHECKS OUT ON THE HOST.
#
# The bisect said CORE, not DPU -- I guessed DPU and was wrong. CNA's eight
# values, the five inserted at 0x2810 and the DPU's four all leave the old
# fp16bits band in place. **CORE's three, alone, give 8744*s and a float32
# output.** They are
#
#     0x3018   charsiu 10000001   vendor 10000200
#     0x301c   charsiu 001f0000   vendor 0000001f
#     0x3020   charsiu 000007ef   vendor 000003ff
#
# ⚠ 0x3018 was judged "hangs" in rounds 339 and 341. It was tried alone, at a
# different shape, without the other two.
#
# THE SLOPE MAP DECODED THE LAYOUT. The slope is the activation the nibble
# meets, once it is divided by the right ulp -- and the ulp is PER OUTPUT WORD,
# because the output is float32, and it changes SIGN for a negative word.
# 122 of 128 nibbles then land on k = i mod 32 with the channel = i / 32, the
# six misses being small activations lost to fp32 rounding. Extrapolating that
# and checking against the eight words the log printed:
#
#     out[n][m] = sum_k s(n,k) * a(k,m), in float
#     weight nibble(n,k) = 32*16*(K/32)*(n/16) + 512*(k/32) + 32*(n%16) + k%32
#     activation (k,m)   = fp16 slot 8*M*(k/8) + 8*m + (k%8)
#     output word (n,m)  = 4*(M*(n/4) + m) + (n%4)
#
# **All eight words match to one fp32 ulp, worst relative error 1.04e-07.**
# Blocks of 32 k for each of SIXTEEN channels, which is the feature atom this
# project has met before.
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# ENTRIES 1 AND 2 ARE THE CLAIM. CHARSIU_VERIFY computes that reference on the
# board for EVERY live word, not the eight I could read off a log, and prints
# how many are within one part in 1e-5. Entry 1 does it under the merge, entry 2
# under the vendor's own stream with the three enables appended. A pass in
# entry 2 is the strongest form: their registers, their weights, their
# activations, our driver.
#
# ⚠ ONE THING I CANNOT PREDICT: the baseline has **1280 live words of 4096**,
# and the reference expects a value in every one of the 4096. So either the
# block writes only part of the buffer or my extent is wrong. The verify prints
# both counts and the first four mismatches, which is what will say which.
#
# ENTRIES 3 TO 6 finish the bisect: each CORE register alone on charsiu's own
# stream, then all three. The reading is not the constant -- the geometry
# differs -- it is LINEAR IN s against the 1.00 to 1.18 band.
#
# ENTRY 7 is the control and must still give the old sixteen values.
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT
# ---------------------------------------------------------------------------
#
# 0x3018, on its own, is the switch, and the other two are extent. I said DPU
# last round and was wrong, so this is a guess and nothing more.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
VD=/opt/charsiu/charsiu_vendor
V=/opt/charsiu/vendor
RGC=$V/vendor-int4-k2048-n1024.regcmd
WT=$V/vendor-wt-1M.bin
IN=$V/vendor-in.bin
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block did not come back this time."
		ABORT=1
	fi
}

# arm: <label> <regcmd-or-dash> <byte> <high> [extra env, one assignment]
#
# ⚠ THE ENV GOES IN AS AN ARGUMENT, not as a "VAR=x arm ..." prefix. Whether an
# assignment before a FUNCTION call survives the call is unspecified -- dash
# drops it, other shells keep it -- and the arm whose whole job is to time out
# WITHOUT the trailer runs right after the one that has it. Not a question worth
# leaving to the shell.
arm() {
	before=$(nbad)
	log ""
	log "  ---- $1"
	sleep 1
	env ${5:-IGNORED=1} $VD "$2" "$WT" "$IN" "$3" "$4" 4096 > /tmp/vd.txt 2>&1
	cat /tmp/vd.txt > "$C"
	after=$(nbad)
	if [ "$after" != "$before" ]; then
		log "  !! POISONED: $((after - before)) new fault or timeout lines"
		health
		# ⚠ NOT a round abort. Round 342 threw away every arm after the
		# first poisoning and then measured the block healthy at the
		# end. The block recovers; give it a moment and carry on.
		ABORT=0
		sleep 2
	fi
}

start() {
	log ""
	log "###############################################################"
	log "##### round 346: verify the decode, and finish the bisect #####"
	log "###############################################################"
	log "  no fitted reference. one nibble changes, the output difference"
	log "  is that nibble. a straight line means int4 is real."

	log ""
	log "===== 1) VERIFY the decode under the merge, every live word   ====="
	arm "verify, merge" "+$RGC" 0 0 CHARSIU_VERIFY=1

	log ""
	log "===== 2) VERIFY under the VENDOR'S OWN stream + the enables    ====="
	log "  their registers, their weights, their activations, our driver."
	arm "verify, verbatim + trailer" "$RGC" 0 0 "CHARSIU_VERIFY=1 CHARSIU_VENDOR_TRAILER=1"

	log ""
	log "===== 3) CORE bisect: 0x3018 alone                            ====="
	arm "0x3018 alone" "-" 0 0 CHARSIU_OVERRIDE=0x3018=0x10000200

	log ""
	log "===== 4) CORE bisect: 0x301c alone                            ====="
	arm "0x301c alone" "-" 0 0 CHARSIU_OVERRIDE=0x301c=0x0000001f

	log ""
	log "===== 5) CORE bisect: 0x3020 alone                            ====="
	arm "0x3020 alone" "-" 0 0 CHARSIU_OVERRIDE=0x3020=0x000003ff

	log ""
	log "===== 6) CORE bisect: all three                               ====="
	arm "all three CORE" "-" 0 0 CHARSIU_OVERRIDE=0x3018=0x10000200,0x301c=0x0000001f,0x3020=0x000003ff

	log ""
	log "===== 7) CONTROL: charsiu's own stream. the old sixteen.      ====="
	arm "control arm, this tree's stream" "-" 0 0

	log ""
	log "===== 8) the anchor: int8 conv must still be exact           ====="
	health

	log ""
	log "===== read the CONTROL lines first. VOID means the arm died. ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
