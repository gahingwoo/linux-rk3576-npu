# ---------------------------------------------------------------------------
# 2026-08-11 round 65. Measure the tap law instead of guessing at it.
#
# Round 64 killed both candidates and one of them died informatively.
#
#   ROCKET_DW_SPLITVALS   completely inert. dw25_imp 112/1024 and mn_dw25
#                         432/1024 COMPUTED 2, byte identical to the default,
#                         and the impulse decode identical too. So the two CNA
#                         words that a row-windowed layer gets and an
#                         unwindowed one does not are not the difference.
#
#   ROCKET_DW_TAPREV      WORSE, not better: dw25_imp 112 -> 82 and the dead
#                         channels 89 -> 160, and it takes the working 112x112
#                         case from 32/32 to 4/32 with maxdiff 218. Writing the
#                         permutation the decode reported does not cancel it,
#                         so the decode was not identifying a tap the hardware
#                         then applies.
#
# The 112x112 regression passed at the top of that round and passes here.
#
# What round 64 did leave is a pattern in WHICH channels come out right:
#
#   0 9 18 27 36 45 54 63   68 77 86 95 104 113 122 131 ... 194   199
#   |___ c = 0 mod 9 ___|   |________ c = 5 mod 9 ________|   c = 1 mod 9
#
# nine apart within a run, and the residue changes near 64 and near 192. Every
# mechanism that fits that contradicts another number in the same log. "One tap
# for a whole group of channels" fits the residue exactly, but it predicts that
# every channel whose impulse is not at that tap reads a zero weight and comes
# out CONSTANT, and only 89 of 1024 are constant.
#
# So stop fitting. dwimp.py now prints the law: the tap offset per channel as a
# histogram, the same per group of 64, the plane offset distribution, and rows
# sampled across the whole range instead of the first sixteen. perch.py prints
# 48 correct channels instead of 24.
#
# Nothing in the driver changed this round.
#
# DECISION RULE, written before the run:
#   one tap offset dominates            it is a fixed rotation and the group
#                                       table says where it changes
#   the offset tracks the channel       the weight buffer is being addressed
#     index                             with the wrong per-channel stride, and
#                                       the slope names it
#   the offsets are spread evenly       the decode is aliasing on a 7x7 ramp
#                                       and the whole tap reading goes, along
#                                       with the pattern above
#   plane offsets are not all 0         the channel map is wrong too, which the
#                                       32 channel case says it is not
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
p() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }
d() { log ""; log "  -- decode $1   $2"; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so $2 \
	python3 "$NPU_DIR/dwimp.py" "$NPU_DIR/$1" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== 1) REGRESSION: the 112x112 depthwise must still be exact ====="
	p mn_dw1.tflite ""

	log ""
	log "===== 2) the law: tap offset per channel, at 1024 channels ====="
	d dw25_imp.tflite

	log ""
	log "===== 3) the same law at 32 channels, where the answer is known ====="
	d dw_imp.tflite

	log ""
	log "===== 4) the correct-channel list, 48 of them ====="
	p dw25_imp.tflite ""

	log ""
	log "===== 5) a regular shape, which must be untouched ====="
	p conv2d-cal.tflite ""

	log ""
	log "===== Read test 3 first: at 32 channels the tap offset must be 0 ====="
	log "===== for every channel, or the decoder itself is the problem.    ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
