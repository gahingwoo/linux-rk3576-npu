# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-22 round 319. A BUFFER I SIZED WRONG, AND A SUBMIT THAT IS SLOW.
#
# ROUND 318 REFUTED ME IN THE OPPOSITE DIRECTION. Routing the 128256 wide output
# head made the model SLOWER, 5.08 to 4.18 tokens a second:
#
#   all 113, head on the NPU   606 slices  10.94 MB   239.0 ms/token   4.18
#   112, head on the CPU       480 slices   8.69 MB   197.0 ms/token   5.08
#   the head ALONE on the NPU  126 slices  262.67 MB  270.1 ms/token   3.70
#   everything on the CPU                             265.6 ms/token   3.77
#
# Text character for character in every rung, three clean anchors, zero IOMMU
# errors. **That is the third tokens per second prediction of mine in a row to be
# wrong, all three by assuming a cost I had not measured at the shape in hand.**
#
# THERE ARE TWO SEPARATE THINGS IN THOSE NUMBERS AND ONLY ONE IS THE HARDWARE'S.
#
# 1) MOST OF THE 42 ms IS A BUFFER I SIZED WRONG. The output buffer was SHARED
#    and therefore sized for the WIDEST tensor. Adding the head took it from
#    128 KB to 2.48 MB, and charsiu_bo_prep and _fini are cache maintenance over
#    a WHOLE buffer object, paid by every one of the 113 matvecs in a token:
#    280 MB of cache operations a token where there had been 14. The head alone
#    does not show it because only one matvec a token is on the hardware.
#    FIXED: every tensor now has its own output buffer, sized for its own slices.
#
# 2) THE HEAD REALLY IS SLOW ON THE NPU, AND THAT PART IS REAL. Working back
#    from the head alone rung, the CPU computes it in about 58 ms and the NPU in
#    about 62. 263 MB in 62 ms is 4.2 GB/s, where an eight task submit reaches
#    10. The suspect is the submit itself: the head is 126 chained tasks and
#    253 buffer handles in ONE ioctl, where round 306's bench chained 128 tasks
#    over about five handles and measured 10.35 GB/s.
#
#    CHARSIU_NPU_MAXTASK caps the tasks per submit so that can be asked directly.
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# 1) ENTRY 2 AGAINST ENTRY 3 IS THE BUFFER FIX. Both are round 318 rungs run
#    again with per tensor buffers. If entry 2 comes back near 5.0 from 4.18,
#    the cache maintenance was the 42 ms and the head costs about what the CPU
#    charges for it. If it stays at 4.18, the buffer was not it and the head is
#    simply expensive.
#
# 2) ENTRY 4 IS THE MEASUREMENT: the head alone, at 126, 32, 16 and 8 tasks a
#    submit. **Read the tokens per second across that sweep.** If smaller
#    submits are faster, the cost is per handle or per submit setup rather than
#    per byte, and the fix is to cap the chain rather than to lengthen it -- the
#    opposite of what round 317 was built on.
#
# 3) The text, character for character against entry 5, in every rung as always.
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT
# ---------------------------------------------------------------------------
#
# A) ENTRY 2 RECOVERS TO ABOUT 5.0 AND STILL DOES NOT BEAT ENTRY 3's 5.08,
#    because the head costs 62 ms on the NPU against 58 on the CPU. In other
#    words: the buffer was my bug, and routing the head is STILL not worth it.
#    ⚠ That is a prediction that the round is expected to end with the head
#    going back to the CPU, which is a result and not a failure.
#
# B) THE TASK CAP MATTERS. 8 or 16 tasks a submit beats 126 on the head. If it
#    does not, the 4.2 GB/s is not the handle count and the next suspect is the
#    weight buffers themselves: 126 distinct 2 MB objects scattered across the
#    IOMMU rather than one contiguous 263 MB.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
RUN=/opt/charsiu/charsiu_run
M8=/opt/charsiu/models/Llama-3.2-1B-Instruct-Q8_0.gguf
PROMPT="The capital of France is"
LIMIT=420
CE=CHARSIU_COEF_ELEMS=65536
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

capped() {
	lim="$1"; shift
	"$@" &
	pid=$!
	i=0
	while [ "$i" -lt "$lim" ]; do
		kill -0 "$pid" 2>/dev/null || { wait "$pid"; return $?; }
		sleep 1
		i=$((i + 1))
	done
	kill -9 "$pid" 2>/dev/null
	wait "$pid" 2>/dev/null
	return 124
}

rung() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $1"; return 0; }
	lbl="$1"; shift
	before=$(nbad)
	log ""
	log "  -- $lbl"
	sleep 1
	capped "$LIMIT" env "$@" "$RUN" "$M8" -p "$PROMPT" -n 32 \
		--ignore-eos -q -c 512 -t 4 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the rung exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This rung is VOID."; health; }
	return 0
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	[ -w /sys/module/rocket/parameters/reset_autosuspend ] && \
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend

	log ""
	log "===== 0) the limit's own control. expect rc 124 after ~3s.         ====="
	t0=$(cut -d. -f1 /proc/uptime)
	capped 3 sleep 60
	rc=$?
	t1=$(cut -d. -f1 /proc/uptime)
	log "  -- capped 3 sleep 60  ->  rc $rc after $((t1 - t0))s"
	[ "$rc" = "124" ] || log "  !! THE LIMIT DID NOT FIRE. Nothing below can be trusted to end."

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "##### ROUND 319: per tensor buffers, and why a 126 task submit    #####"
	log "#####            only reaches 4.2 GB/s.                           #####"

	log ""
	log "===== 2) all 113 with per tensor buffers. was 4.18.                ====="
	rung "all 113, head included" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 "$CE" \
		CHARSIU_NPU_MAXN=131072

	log ""
	log "===== 3) 112 without the head, the same fix. was 5.08.             ====="
	rung "112 projections, head on the CPU" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 "$CE"

	log ""
	log "===== 4) THE MEASUREMENT. the head alone, tasks per submit swept.  ====="
	for T in 0 32 16 8 4
	do
		log ""
		log "===== CHARSIU_NPU_MAXTASK = $T   (0 means all 126 in one)"
		rung "head alone, $T tasks a submit" CHARSIU_NPU_QUANT=1 \
			CHARSIU_NPU=1 "$CE" CHARSIU_NPU_MAXN=131072 \
			CHARSIU_NPU_ONLY=token_embd CHARSIU_NPU_MAXTASK=$T
	done

	log ""
	log "===== 5) and the same cap on everything, in case it helps there too ====="
	rung "all 113, 16 tasks a submit" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 "$CE" \
		CHARSIU_NPU_MAXN=131072 CHARSIU_NPU_MAXTASK=16

	log ""
	log "===== 6) the CPU reference the text is diffed against              ====="
	rung "CPU, NPU number format" CHARSIU_NPU_QUANT=1

	log ""
	log "===== the anchor again                                             ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== entry 2 against 3, then the task cap sweep.                  ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
