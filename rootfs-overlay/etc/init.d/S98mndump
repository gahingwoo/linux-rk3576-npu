#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-13 round 130. The pointwise weight stride says twice what it holds.
#
# Round 129's diff of pw32x64w56, which works, against pw64x64w56, which does
# not, differs in nine registers and every one scales exactly as its own
# formula says: 0x101c is ic*oc, 0x1020 is ic, 0x1028 carries surf*rows and
# ic-1, 0x1030 carries wbpk, 0x103c and 0x1044 carry surf, 0x107c is ic-1 and
# 0x4018 is an address that moves with the bigger input BO. Nothing there is
# wrong on its own terms.
#
# What the arithmetic did turn up is an inconsistency inside this driver:
#
#   regular conv weight buffer   ALIGN(ic, 32) * 2 bytes per output channel
#                                and tap, so two bytes per input channel
#   pointwise weight buffer      ic bytes per output channel, so ONE
#   wbpk at 0x1030               ic * k * k * 2, computed for the two byte form
#
# So for a pointwise the register says 64 bytes per kernel where the buffer
# holds 32, and 128 where it holds 64. It is the same factor at both counts, so
# it cannot by itself be what separates a working 32 from a failing 64, and it
# is a real error either way: one of those two places is wrong about the same
# buffer.
#
# DECISION RULE, written before the run:
#   halving it fixes 64 and leaves 32 alone
#             the stride was the fault and 32 survived it because one group
#             gives the hardware nothing to stride over
#   it fixes neither and breaks 32
#             the doubling is what the hardware wants and the buffer is what
#             should carry two bytes per input channel instead
#   nothing moves at all
#             0x1030's high half is not a stride the pointwise path uses, and
#             the input BO layout is the last thing left
#
# Test 3 is the control and it is the one that can embarrass this: 32 channels
# works today WITH the doubling, so if halving it also leaves 32 working then
# the register is not load bearing there and the reading is weaker than it
# looks. If halving BREAKS 32, the register is load bearing and the buffer is
# the half that is wrong.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
p() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== 1..2) THE TEST: halve the pointwise weight stride ====="
	p pw64x64w56.tflite "ROCKET_PW_WBPK=1"
	p pw64x128w56.tflite "ROCKET_PW_WBPK=1"

	log ""
	log "===== 3) CONTROL: 32 channels, which works WITH the doubling ====="
	p pw32x64w56.tflite "ROCKET_PW_WBPK=1"

	log ""
	log "===== 4..5) the same two at the default, for the record ====="
	p pw64x64w56.tflite ""
	p pw32x64w56.tflite ""

	log ""
	log "===== 6) and the flat layout as well, in case they interact ====="
	p pw64x64w56.tflite "ROCKET_PW_WBPK=1 ROCKET_PW_FLAT=1"

	log ""
	log "===== 7) op4 with whichever helps ====="
	p mn_L04.tflite "ROCKET_PW_WBPK=1"

	log ""
	log "===== 8..11) REGRESSION ====="
	p mn_L03.tflite ""
	p mn_dw1.tflite ""
	p conv2d-cal.tflite ""
	p mn_conv0.tflite ""

	log ""
	log "===== 1 vs 4 is the test, 3 vs 5 is what makes it mean something. ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
