#!/bin/sh
# ---------------------------------------------------------------------------
# 2026-08-08 round 14. Round 13's control settled round 12: the knob DID fire.
#
#   weight buffer without it   256 bytes  md5 c6cc3072  b7 b4 dc 06
#   weight buffer with it     9216 bytes  md5 799b978e  fe fe fe fe
#
# 0xfe is wt_zp - 0x80, the ring taps, exactly as designed. And the resulting
# regcmd matches a vendor .rknn compiled at that same 3x3 geometry on everything
# except the two registers already shown inert and the two requant fields that
# are not comparable. It still returns a uniform out_zp.
#
# So it is NOT 1x1 encoding. What the table says now:
#
#   5x5 stride 2, 128 out   OK        3x3 stride 1, 16 out    FAIL
#   5x5 stride 1, 128 out   OK        1x1 stride 1, 16 out    FAIL
#   5x5 stride 2,  16 out   OK        1x1 stride 1, 128 out   FAIL
#
# But every failing model so far came from somewhere other than conv2d.tflite,
# so "the kernel" and "the model" are still confounded. This round cuts that.
# mutate_k.py crops conv2d-cal's OWN kernel to the centre 3x3 and 1x1, which per
# tensor quantization makes safe, and SAME padding keeps the output shape at
# 40x40x128 either way. One variable, off the model that works, exactly the
# mutation that produced the padding result.
#
#   cal_k3 and cal_k1 FAIL -> it is the kernel size, full stop
#   cal_k3 and cal_k1 PASS -> it is not the kernel, it is something about the
#                             models themselves, and conv2d.tflite is special
#
# The second outcome would be the more useful one, and it is the one nothing so
# far has tested.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }

many() {
	m="$1"; n="$2"; mark="$3"; shift 3
	echo "SMARK-$mark" > /dev/kmsg 2>/dev/null
	env TEFLON_LIB=/usr/lib/libteflon.so "$@" \
		python3 "$NPU_DIR/test_model.py" "$NPU_DIR/$m" "$n" > "$C" 2>&1
	dmesg | sed -n "/SMARK-$mark/,\$p" | grep -a "job: task_count=" | head -2 > "$C" 2>&1
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	# -n 8 floods the serial console and wedges the box. Learned the hard way.
	dmesg -n 4 2>/dev/null

	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/job_log 2>/dev/null
	log ""
	log "  task_con16=$(cat /sys/module/rocket/parameters/task_con16 2>/dev/null)"

	log ""
	log "===== 1) CONTROL: conv2d-cal, the 5x5 it all comes from ====="
	many conv2d-cal.tflite 2 cal-first

	log ""
	log "===== 2) cal_k3: the SAME model, kernel cropped to the centre 3x3 ====="
	log "  one variable off a model that works"
	sleep 2
	many cal_k3.tflite 3 cal-k3

	log ""
	log "===== 3) cal_k1: the SAME model, kernel cropped to the centre 1x1 ====="
	sleep 2
	many cal_k1.tflite 3 cal-k1

	log ""
	log "===== 4) cal_k1 with the 3x3 rewrite on top ====="
	log "  a 1x1 from a model that works, run as a 3x3. If 3 fails and this"
	log "  passes, the rewrite is a usable workaround after all."
	sleep 2
	many cal_k1.tflite 3 cal-k1-3x3 ROCKET_PW_AS_3X3=1

	log ""
	log "===== 5) md003_80 for continuity ====="
	sleep 2
	many md003_80.tflite 2 md003-80

	log ""
	log "===== 6) REPEAT CONTROL: conv2d-cal ====="
	sleep 2
	many conv2d-cal.tflite 2 cal-last

	log ""
	log "===== 2 and 3 are the round. Same file, same scales, same shapes,  ====="
	log "===== only the kernel. Whichever way they go, the kernel and the   ====="
	log "===== model stop being confounded.                                 ====="
	sync
}

case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
