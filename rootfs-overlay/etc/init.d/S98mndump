#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-19 round 257. One count on the accumulator, asked of every operator.
#
# ⚠ WHAT WAS WRONG WITH 256, and it was the knob rather than the board.
# ROCKET_ROUND is in requant counts and lands in A as round(value/mult), which
# is an INTEGER. The smallest step it can make is one accumulator count, and
# which requant value produces that step depends entirely on the operator. So
# the sweep from 0.001 to 0.25 was asking different models different questions:
#
#   model       mult      what 0.01 actually added to A
#   mn_dw1      0.2922    0, and 1 only from 0.15 up
#   mn_pw2      0.0304    0, then 2 at 0.05 and 3 at 0.1
#   mn_conv0    0.0072    1
#   mn_pw24     0.0082    1
#   mn_dw25     0.1262    0, at every value in the round
#   conv2d-cal  0.000955  10, and -10 for the negative arm
#
# The step I read at 0.15 on mn_dw1 as a property of the pixel distribution is
# just round(0.15/0.2922) crossing from 0 to 1. The plateau above it and the
# flat below it are the same integer, which is why both were perfectly flat.
#
# WHAT 256 DID ESTABLISH, where it happened to land on 1:
#
#   mn_pw24   99.81% of pixels exact -> 100.00%, BYTE EXACT
#   mn_dw1    85.62% -> 98.88%
#   mn_conv0  99.80% -> 99.80%, unchanged, but every miss flipped from low to
#             high, so its misses sit within one count of the boundary
#
# conv2d-cal, mn_pw2 and mn_dw25 have never been tested at 1 at all.
#
# ROCKET_ABIAS adds an integer to A directly, so every operator is asked the
# same question. The multiplier is also verified not to be the story: the
# realized scale times two to the minus shift is within 0.0053 percent of the
# true multiplier on all six of these.
#
# THE READING RULE, fixed before the run.
#
#   The question is whether ONE count on the accumulator is a general fix or a
#   coincidence on two operators. Read the three that were never tested first,
#   since they carry the new information: conv2d-cal, mn_pw2, mn_dw25 at +1.
#
#     all three improve            it is general, and the next question is why
#     the two known ones improve
#       and the new three do not   it is per operator and there is no single
#                                  constant, which is a real answer too
#     nothing moves anywhere       the knob is not reaching and the round is
#                                  void rather than negative
#
#   ⚠ -1 is in the sweep on every model. If +1 and -1 both make a model worse
#   it is already at its optimum, which is what conv2d-cal looked like in 255
#   before I knew it was being moved by 10.
#
#   ⚠ BYTE EXACT is the bar worth watching, not the channel count. Every one of
#   these already passes at maxdiff 1.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	after=$(nbad)
	if [ "$after" != "$before" ]; then
		log "  !! POISON in this entry. The block faulted. This result is VOID."
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" \
			> /tmp/hc.txt 2>&1
		if grep -q "128/128 channels match" /tmp/hc.txt; then
			log "  !! health OK, the block recovered, continuing"
		else
			log "  !! health FAILED, the block is gone. ABORTING the round."
			ABORT=1
		fi
	fi
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	if [ -w /sys/module/rocket/parameters/reset_autosuspend ]; then
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend
		log "reset_autosuspend = $(cat /sys/module/rocket/parameters/reset_autosuspend)"
	else
		log "!! reset_autosuspend NOT WRITABLE. A timeout will kill the round."
	fi

	log ""
	log "===== 1) the anchor, knob off                                      ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== 2+) THE THREE NEVER TESTED AT ONE COUNT. These carry the     ====="
	log "=====     new information, so read them first.                     ====="
	for m in conv2d-cal mn_pw2 mn_dw25; do
		w "$m.tflite" ""
		w "$m.tflite" "ROCKET_ABIAS=1"
		w "$m.tflite" "ROCKET_ABIAS=-1"
		w "$m.tflite" "ROCKET_ABIAS=2"
	done

	log ""
	log "===== the two that improved at one count in 256, now asked with    ====="
	log "=====   the knob that means what it says                           ====="
	for m in mn_pw24 mn_dw1; do
		w "$m.tflite" ""
		w "$m.tflite" "ROCKET_ABIAS=1"
		w "$m.tflite" "ROCKET_ABIAS=-1"
		w "$m.tflite" "ROCKET_ABIAS=2"
	done

	log ""
	log "===== and the one whose misses flipped without its count changing  ====="
	w mn_conv0.tflite ""
	w mn_conv0.tflite "ROCKET_ABIAS=1"
	w mn_conv0.tflite "ROCKET_ABIAS=-1"

	log ""
	log "===== a chain, read last and not evidence on its own               ====="
	w mobilenet_v1_1.0_224_quant.tflite ""
	w mobilenet_v1_1.0_224_quant.tflite "ROCKET_ABIAS=1"

	log ""
	log "===== a final anchor                                               ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== Read 1 and 2, then 3 against 4. The bar is the arm beside it ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
