#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-11 round 59. Ask the hardware which input each multiply got.
#
# Round 58 finishes the coefficient surface off. A scaled on its own:
#
#   ASHIFT   -7  -4  -2  -1   0  +1  +4  +7
#   COMPUTED  0   0   0   0   1   0   0   0
#
# and C on the depthwise path, properly this time, gives 0, 1, 1 at 4, 64 and
# 256 against 1 at the default. The default is the best point of both sweeps,
# so A and C are already right, which is what the capture said. conv2d-cal with
# ROCKET_DW_ASHIFT=7 is still 128 of 128 COMPUTED, so the depthwise knobs are
# gated correctly and the round is not measuring a leak.
#
# Every scalar in the record is now either verified against the vendor or swept
# and found to be at its best value. The depthwise conv fires on every channel
# and computes the wrong number, and nothing this driver writes changes WHICH
# number. So the suspect is which INPUT each multiply gets, and a random model
# cannot see that: every wrong answer looks alike.
#
# dw_imp.tflite is mn_dw1 with every tap set to the weight zero point, exactly
# zero after dequantisation, except ONE tap per channel at position c mod 9,
# and a zero bias. Its input and output scales are equal, so the correct output
# of channel c is its own input shifted by that tap. dwimp.py scores each
# output channel against all nine shifts of all 32 input planes and says what
# actually fits.
#
#   right shift, right channel   the tap map and the channel map are right, and
#                                the error is in the ARITHMETIC, not the wiring
#   right shift, wrong channel   the channels are permuted. This is the live
#                                suspicion: the weight buffer packs channels in
#                                PAIRS and CNA 0x1024 carries 1, not 31
#   wrong shift, right channel   ky and kx are transposed or the planes are
#                                ordered differently than mesa writes them
#   nothing fits any single tap  more than one tap lands on a channel, so the
#                                4 byte group is read as 4 weights rather than
#                                2 weights and 2 zero points
#
# The CPU interpreter runs the same file and is decoded the same way. If its
# own answer is not the identity mapping then the model is not what the decoder
# thinks it is and the hardware column means nothing.
#
# DECISION RULE, written before the run:
#   CPU control not 32/32          void, fix the model or the decoder first
#   hardware 32/32                 the wiring is right and round 60 goes back
#                                  to arithmetic with that ruled out
#   hardware reads the wrong       read the permutation off the table; it is
#     channel                      the answer
#   hardware fits no single tap    the 4 byte group is being misread, and the
#                                  zero point lanes are the thing to move
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== 1) the impulse decode: which tap, which channel ====="
	sleep 2
	env TEFLON_LIB=/usr/lib/libteflon.so \
		python3 "$NPU_DIR/dwimp.py" > "$C" 2>&1

	log ""
	log "===== 2) the same model through the ordinary metric ====="
	sleep 2
	env TEFLON_LIB=/usr/lib/libteflon.so \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/dw_imp.tflite" > "$C" 2>&1

	log ""
	log "===== 3) mn_dw1 unchanged, so this round is comparable ====="
	sleep 2
	env TEFLON_LIB=/usr/lib/libteflon.so \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/mn_dw1.tflite" > "$C" 2>&1

	log ""
	log "===== 4) a regular shape, which must be untouched ====="
	sleep 2
	env TEFLON_LIB=/usr/lib/libteflon.so \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > "$C" 2>&1

	log ""
	log "===== Read the CONTROL line first: the CPU must decode to its own ====="
	log "===== impulse 32 of 32, or the hardware column says nothing.      ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
