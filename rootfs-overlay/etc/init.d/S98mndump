#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-18 round 241. Two independent questions, one card. They do not share
# a knob or a model, so neither can explain the other's result.
#
# QUESTION A, the NPU rail. Chaoyi asked on the list what consumes npu-supply.
# Nothing does. There is no regulator call in drivers/accel/rocket and no
# reader of npu-supply or sram-supply anywhere in the tree, so on the posted
# v7 the only thing holding vdd_npu_s0 up was the regulator-always-on line
# that same patch adds. The mechanism that does exist is domain-supply on the
# power domain node, which rockchip_pd_power enables before the domain goes on
# and disables after it goes off, and rk3588-rock-5b already wires the same
# rail that way. This image drops always-on and wires the rail to pd_npu.
#
#   READING RULE. Entry 1 must reproduce round 240 exactly, 128 of 128 with
#   npu min 128 max 255 across 128 distinct values. If it does not, the rail
#   change did it and nothing else in this log counts.
#
#   The rail dumps say which of three worlds we are in. num_users of 1 or more
#   with the rail enabled means genpd took it, which is the intended one. Zero
#   users and still enabled means the wiring did not take and something else
#   is holding it. Disabled while the NPU computes means the rail is not what
#   powers this block, which would make the whole property decorative.
#
# QUESTION B, the two output channel counts Igor asked for. 0x4050 is emitted
# by a parity rule here and by a modulo rule upstream, and the two disagree
# only where a count is a multiple of neither 32 nor 16.
#
#   count   DIV_ROUND_UP(oc,16)   parity says   oc % 32   modulo says
#     64            4 even         0x80011111      0        0x80011111
#     88            6 even         0x80011111     24        0x80011011
#    120            8 even         0x80011111     24        0x80011011
#
#   READING RULE. If the parity form is the right rule, 88 and 120 come back
#   whole by default and degrade under ROCKET_DPU4050_MOD32. If the two forms
#   give the same answer at both counts then these counts do not discriminate
#   either, which is what I told Igor about his 1001, and I say so rather than
#   read it as support.
#
#   THE KNOB CONTROL is 64, where the two forms agree by construction. It runs
#   with and without the knob and the two must match. If 64 moves, the knob
#   reaches further than the one register and question B is void.
#
# The knob runs last within each pair, since the entry after a timeout comes
# back flat 128 with an rk_iommu reset beside it and that collateral has been
# read as a result twice before.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
log() { echo "$@" > "$C"; }
w() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }

rail() {
	log ""
	log "  RAIL $1"
	for r in /sys/class/regulator/regulator.*; do
		[ -r "$r/name" ] || continue
		n=$(cat "$r/name" 2>/dev/null)
		case "$n" in vdd_npu*)
			log "    $n  state=$(cat $r/state 2>/dev/null)  num_users=$(cat $r/num_users 2>/dev/null)" ;;
		esac
	done
	for g in /sys/kernel/debug/pm_genpd/*npu*; do
		[ -r "$g/current_state" ] && log "    genpd $(basename $g) $(cat $g/current_state 2>/dev/null)"
	done
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null

	rail "at boot, before the NPU has been touched"

	log ""
	log "===== 1) THE CONTROL for the rail change. Round 240 got 128 of   ====="
	log "=====    128, npu min 128 max 255, 128 distinct. Anything else   ====="
	log "=====    and the rail change caused it.                          ====="
	w conv2d-cal.tflite ""

	rail "after one inference"

	log ""
	log "===== 2) THE KNOB CONTROL, 64 out. Both forms emit 0x80011111    ====="
	log "=====    here, so entries 2 and 6 must be identical.             ====="
	w pw33x64w56.tflite ""

	log ""
	log "===== 3) 88 out, parity form. Igor will mirror this on RK3588.   ====="
	w pw64x88w56.tflite ""

	log ""
	log "===== 4) 120 out, parity form                                    ====="
	w pw64x120w56.tflite ""

	log ""
	log "===== 5) 88 out, modulo form. The parity rule predicts this one  ====="
	log "=====    degrades. If it matches entry 3, 88 does not decide.    ====="
	w pw64x88w56.tflite "ROCKET_DPU4050_MOD32=1"

	log ""
	log "===== 6) the knob control again, under the knob                  ====="
	w pw33x64w56.tflite "ROCKET_DPU4050_MOD32=1"

	log ""
	log "===== 7) 120 out, modulo form. Runs last because it is the one   ====="
	log "=====    most likely to time out and take the next entry with it ====="
	w pw64x120w56.tflite "ROCKET_DPU4050_MOD32=1"

	rail "after the sweep"

	log ""
	log "===== Read entry 1 first. If the rail moved it, stop there.      ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
