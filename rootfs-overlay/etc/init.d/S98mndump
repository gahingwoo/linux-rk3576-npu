# ---------------------------------------------------------------------------
# 2026-08-11 round 66. One tap for every channel, which no other story survives.
#
# Round 65 measured the law. Two things came out of it.
#
# The tap the decoder reports for a WRONG channel is meaningless: over 1024
# channels the offsets are 112, 107, 99, 97, 104, 106, 99, 104, 107 and 89
# dead, which is flat. The 32 channel control is the opposite, offset 0 for all
# 27 channels the decoder can resolve, so the decoder works when the output is
# right and says nothing when it is not. Round 63's "the hardware uses tap
# (-p) mod 9" is withdrawn; round 64 had already shown that writing that
# permutation does not cancel it.
#
# What is real, because it comes from maxdiff and not from the decoder, is
# WHICH channels are right. Per group of 64:
#
#     0.. 63   8 channels   residue 0 mod 9
#    64..127   7 channels   residue 5
#   128..191   7 channels   residue 5
#   192..255  14 channels   residues 1 and 5
#   256..319   7 channels   residue 1
#   320..383   0 channels   none
#   384..447   5 channels   residue 6
#
# Exactly one residue mod 9 per group of 64, and 7 of 64 is exactly one ninth.
# That is the shape of a fixed tap per group: only the channels whose impulse
# happens to sit at that tap agree.
#
# It is stated here as a measurement, not a mechanism, because the mechanism it
# suggests contradicts another number in the same log. If a group really used
# one tap, every channel in it whose impulse is elsewhere would read a zero
# weight and come out CONSTANT, and only 89 of 1024 are constant.
#
# So build the model that separates them. dw25_t4 and dw25_t0 put the live tap
# at the SAME position for every channel, the centre and the top left corner.
# A fixed tap per group then has to light up WHOLE GROUPS of 64 at once and
# leave the others flat, which is a signature nothing else produces, and the
# groups that light up name the tap directly. dw1_t4 is the same model at 32
# channels, where the layer is already byte exact, as the control.
#
# Nothing in the driver changed. dwimp.py's per-group summary crashed on the
# dead channels last round and is fixed.
#
# DECISION RULE, written before the run:
#   dw25_t4 correct in whole 64 groups   fixed tap per group, and the group
#     and flat elsewhere                 table maps it
#   dw25_t4 correct at one residue       impossible for a model with one tap
#                                        everywhere, so the group reading is
#                                        wrong and the 9 periodicity is
#                                        something else entirely
#   dw25_t4 all correct                  the fault needs several taps present,
#                                        so it is in how taps are combined
#   dw25_t4 all wrong, t0 all correct    the tap position itself is the
#                                        variable
#   dw1_t4 not 32/32                     the control failed, read nothing else
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
p() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }
d() { log ""; log "  -- decode $1   $2"; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so $2 \
	python3 "$NPU_DIR/dwimp.py" "$NPU_DIR/$1" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== 1) CONTROL: one tap everywhere at 32 channels, must be 32/32 ====="
	p dw1_t4.tflite ""

	log ""
	log "===== 2..3) one tap everywhere at 1024 channels: centre, then corner ====="
	p dw25_t4.tflite ""
	p dw25_t0.tflite ""

	log ""
	log "===== 4) the per-channel-tap model again, for the group table ====="
	p dw25_imp.tflite ""

	log ""
	log "===== 5) and its decode, with the per-group summary fixed ====="
	d dw25_imp.tflite

	log ""
	log "===== 6) REGRESSION: the real 112x112 depthwise ====="
	p mn_dw1.tflite ""

	log ""
	log "===== 7) a regular shape, which must be untouched ====="
	p conv2d-cal.tflite ""

	log ""
	log "===== Read test 1 first. Then compare 2 with 4: one tap everywhere ====="
	log "===== cannot come out right at one residue in nine.                ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
