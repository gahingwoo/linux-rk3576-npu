#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-22 round 317. CHAINING. STEP 3.
#
# ROUND 316 FINISHED STEP 2. All 112 projections of Llama-3.2-1B on the NPU,
# 480 slices, 18240 jobs over 38 tokens, and the generated text was CHARACTER
# FOR CHARACTER the CPU's. Zero IOMMU errors, three clean anchors, and the whole
# log contained two distinct generated lines -- the four token warm up and the
# one every rung produced.
#
# ⚠ AND IT WAS SLOWER THAN THE CPU. 4.20 tokens a second against charsiu's best
# CPU path at 5.53. The cause is not the hardware and not the arithmetic: it is
# 480 UNCHAINED SUBMITS A TOKEN, each carrying about 190 us of fixed cost, which
# is roughly 91 ms a token of paying to start jobs rather than to do them.
#
# That number has been on the table since round 165 and the acceptance test with
# it: BREAK EVEN IS 2.2 MB OF WEIGHTS PER SUBMIT. A slice is 2 MB, right at it.
# A whole ffn_gate is 16.8 MB.
#
# WHAT CHANGED. The slices of one projection now go in ONE submit. That needed
# each slice to write somewhere different, so every slice gets its own region of
# a shared output buffer and its own region of a shared input buffer, baked into
# its register stream when it is built. 480 submits a token becomes 112, one per
# projection, and the average submit carries about 11 MB.
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# 1) THE REPORT LINE FIRST, EVERY TIME:
#
#      charsiu NPU: 112 tensors, 480 slices, S submits, X MB per submit
#
#    S must be about 112 per token, not 480. X must be well over 2.2. A rung
#    whose submit count did not fall is not chained, whatever its text says --
#    and round 315 is why that line is read before the text and not after.
#
# 2) THEN THE TEXT, against entry 5's CPU reference, character for character.
#    Chaining must not change a single token: the same jobs are being submitted,
#    only fewer times. If the text moves, the slices are writing over each
#    other, and the first suspect is the output region stride.
#
# 3) THEN TOKENS PER SECOND, which is the only rung in this round that is
#    supposed to be a MEASUREMENT rather than a check.
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT
# ---------------------------------------------------------------------------
#
# A) IDENTICAL TEXT, 112 submits a token, about 11 MB each.
#
# B) **ABOUT 6 TOKENS A SECOND, WHICH WOULD PUT THE NPU AHEAD OF THE CPU FOR
#    THE FIRST TIME.** 480 submits to 112 removes roughly 70 ms a token of fixed
#    cost from 238 ms. If it lands under 5.53 the fixed cost was not the whole
#    story and the next thing to measure is what else a submit costs.
#
# C) The per rung numbers below the full one exist so that a surprise can be
#    attributed: ffn is 384 of the 480 slices and 24 of the 112 submits, so it
#    is where chaining should show most.
#
# ⚠ Entry 3 is the deliberate control: the same run with chaining OFF, one
# submit per slice, so this round carries its own before and after instead of
# comparing against a different boot.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
RUN=/opt/charsiu/charsiu_run
M8=/opt/charsiu/models/Llama-3.2-1B-Instruct-Q8_0.gguf
PROMPT="The capital of France is"
LIMIT=420
CE=CHARSIU_COEF_ELEMS=65536
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

capped() {
	lim="$1"; shift
	"$@" &
	pid=$!
	i=0
	while [ "$i" -lt "$lim" ]; do
		kill -0 "$pid" 2>/dev/null || { wait "$pid"; return $?; }
		sleep 1
		i=$((i + 1))
	done
	kill -9 "$pid" 2>/dev/null
	wait "$pid" 2>/dev/null
	return 124
}

rung() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $1"; return 0; }
	lbl="$1"; shift
	before=$(nbad)
	log ""
	log "  -- $lbl"
	sleep 1
	capped "$LIMIT" env "$@" "$RUN" "$M8" -p "$PROMPT" -n 32 \
		--ignore-eos -q -c 512 -t 4 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the rung exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This rung is VOID."; health; }
	return 0
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	[ -w /sys/module/rocket/parameters/reset_autosuspend ] && \
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend

	log ""
	log "===== 0) the limit's own control. expect rc 124 after ~3s.         ====="
	t0=$(cut -d. -f1 /proc/uptime)
	capped 3 sleep 60
	rc=$?
	t1=$(cut -d. -f1 /proc/uptime)
	log "  -- capped 3 sleep 60  ->  rc $rc after $((t1 - t0))s"
	[ "$rc" = "124" ] || log "  !! THE LIMIT DID NOT FIRE. Nothing below can be trusted to end."

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "##### ROUND 317: chaining. read the submit count before the text.  #####"

	log ""
	log "===== 2) THE ROUND. all 112 projections, slices chained.           ====="
	rung "all projections, chained" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 "$CE"

	log ""
	log "===== 3) THE CONTROL. the same run with one submit per slice.      ====="
	log "=====    same boot, so this is a before and after and not a memory. ====="
	rung "all projections, UNCHAINED" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 "$CE" \
		CHARSIU_NPU_NOCHAIN=1

	log ""
	log "===== 4) where chaining should show most, and where least          ====="
	rung "ffn chained  (384 of the 480 slices)" CHARSIU_NPU_QUANT=1 \
		CHARSIU_NPU=1 "$CE" CHARSIU_NPU_ONLY=ffn
	rung "attn chained (96 of the 480 slices)" CHARSIU_NPU_QUANT=1 \
		CHARSIU_NPU=1 "$CE" CHARSIU_NPU_ONLY=attn

	log ""
	log "===== 5) the CPU reference the text is diffed against              ====="
	rung "CPU, NPU number format" CHARSIU_NPU_QUANT=1

	log ""
	log "===== 6) and charsiu's best CPU path, which is the real denominator ====="
	rung "plain CPU, q8_0" X=1

	log ""
	log "===== the anchor again                                             ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== submits per token, then the text, then tokens per second.    ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
