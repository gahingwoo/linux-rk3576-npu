# ---------------------------------------------------------------------------
# 2026-08-10 round 48. The slot holds the REQUANT MULTIPLIER, derived at last.
#
# Round 47 separated the two changes and both failed, but it also said why the
# table failed. conv2d-cal's weight_tensor->scale is 3.9125464 and fp16 of that
# is 0x43d3, exactly the value round 28 proved fails. So the slot is not the
# weight scale.
#
# Reading every word rounds 36 and 37 swept, as fp16, gives the window:
#
#   pass  0.000474 0.00049 0.000521 0.002937 0.003059 0.003181 0.008331
#   fail  0.00013 and below, 2.13 and above
#
# and in_sc * wt_sc / out_sc for conv2d-cal is 0.00095521, INSIDE it. The magic
# word 0x1004 is 0.00049, the same order. The vendor's captured entries are
# around 0.0012 for its own model. Everything lines up on the requant
# multiplier and nothing lines up on the weight scale.
#
# So ROCKET_SCALE_TABLE now writes in_sc * wt_sc[oc] / out_sc as fp16, one entry
# per output channel. For a per-tensor model that is one value repeated, which
# should behave like the constant; for depthwise it is 32 different values,
# which is where round 47 saw dwconv move from 6 distinct values to 28.
#
# DECISION RULE, written before the run:
#   2 is 128/128                 the derived multiplier replaces the magic word
#                                and the surface is fully derived at last
#   2 fails but 3 (weight scale)
#     fails the same way         the formula is still wrong, and the window says
#                                what magnitude to aim for
#   dwconv keeps moving          per-channel values are what depthwise needs;
#                                chase the remaining error there
#   1 or 9 not 128/128           the build is wrong, stop
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
p() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== 1) BASELINE: the magic word, must be 128/128 ====="
	p conv2d-cal.tflite ""

	log ""
	log "===== 2) THE TEST: in_sc * wt_sc / out_sc as fp16 ====="
	p conv2d-cal.tflite ROCKET_SCALE_TABLE=1

	log ""
	log "===== 3) the weight scale instead, which round 47 ran, must FAIL ====="
	p conv2d-cal.tflite "ROCKET_SCALE_TABLE=1 ROCKET_SCALE_TABLE_WT=1"

	log ""
	log "===== 4..5) the derived multiplier on the other regular shapes ====="
	p cal_k3.tflite ROCKET_SCALE_TABLE=1
	p cal_k1.tflite ROCKET_SCALE_TABLE=1

	log ""
	log "===== 6..8) and on depthwise, where round 47 saw it move ====="
	p dwconv.tflite ROCKET_SCALE_TABLE=1
	p mn_dw1.tflite ROCKET_SCALE_TABLE=1
	p dwconv.tflite "ROCKET_SCALE_TABLE=1 ROCKET_DW_REC48=1"

	log ""
	log "===== 9) CONTROL that can fail: baseline again ====="
	p conv2d-cal.tflite ""

	log ""
	log "===== Read 1 and 9, then 2. If it is 128/128 the whole surface is  ====="
	log "===== derived and the magic word can go.                           ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
