# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-21 round 286. Blocks and slots, and N = 56 is the only case not
# behind it.
#
# ⚠ 285 MEASURED THE MAP AWAY FROM N = 64 FOR THE FIRST TIME and both sweeps
# disagreed with 8*K:
#
#   N = 24  measured 0, 128, 192          8*K said 0, 128, 512
#   N = 40  measured 0, 128, 512, 576, 704   8*K said ... 640, 1024
#
# Laid beside the five geometries that already worked, the shape is regular and
# it is not a stride at all. Groups of eight channels sit two to a BLOCK of 8*K
# bytes at SLOTS of 64 bytes, and only the last block differs:
#
#   block stride S = 8*K            slot 64          k+ half at S/2, K > 32
#   a full block            slots 0 and 2
#   last block, 2 left      slots 0, 1
#   last block, 3 left      slots 0, 2, 3 if it is ALSO the first block,
#                           otherwise slots 0, 1, 3
#
# That reproduces every table measured, forty bases across seven geometries:
#
#   N=16 0 64                     N=48 0 128 512 640 1024 1088
#   N=24 0 128 192                N=64 0 128 512 640 1024 1152 1536 1600
#   N=32 0 128 512 576            N=64 K=32  0 128 256 384 512 640 768 832
#   N=40 0 128 512 576 704
#
# ⚠ N = 56 IS THE ONE GEOMETRY NOT BEHIND IT. It is the only case whose last
# block holds three groups and is not also the first, so the "0, 1, 3
# otherwise" arm rests on N = 40 alone. The rule predicts its bases:
#
#   1024, 1088, 1216   for g4, g5, g6, with g0..g3 at 0, 128, 512, 640
#
# 285 ALSO ANSWERED IGOR. SIZE_E_1 = 0 against the traced 1 came back IDENTICAL
# at all seven N, per group and per count. Inert on the int4 path as well as on
# the int8 one, which is where round 260 left it.
#
# THE READING RULE, fixed before the run.
#
#   ⚠ ENTRY 2 IS THE ROUND. N = 56, which has never been exact.
#
#     56 of 56, every group 8/8   the block and slot rule is read rather than
#                                 fitted, across eight geometries and two K,
#                                 and every N that is a multiple of 8 works
#     g4 to g6 still 0/8          the "otherwise" arm is wrong and N = 40 is
#                                 the special case, not N = 24. Sweep N = 56
#                                 with --map and read its bases directly.
#     a DIFFERENT group breaks    the rule is wrong somewhere it currently
#                                 agrees with a measurement, which would mean
#                                 one of the seven tables was misread
#
#   ⚠ ENTRIES 3 TO 9 ARE THE REGRESSION and they carry as much weight. Seven
#   geometries were exact before this change and the packer was rewritten, not
#   patched. 284 broke three working cases with one line; this is a bigger edit.
#
#   ENTRY 10 is the control that must FAIL and ENTRY 11 is int8.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
MM=/opt/charsiu/charsiu_matmul
CH=/opt/charsiu/charsiu_int4
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

c() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $*"; return 0; }
	before=$(nbad)
	sleep 1
	env $1 $2 $3 $4 $5 $6 $7 $8 $9 > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This arm is VOID."; health; }
	return 0
}

M4="CHARSIU_W4=1 CHARSIU_W4_HALFK=1"

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	if [ -w /sys/module/rocket/parameters/reset_autosuspend ]; then
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend
		log "reset_autosuspend = $(cat /sys/module/rocket/parameters/reset_autosuspend)"
	else
		log "!! reset_autosuspend NOT WRITABLE. A timeout will kill the round."
	fi

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== 2) THE ROUND. N = 56. Predicted bases 1024, 1088, 1216.      ====="
	log ""
	c "$M4" X=1 $MM 1 64 56

	log ""
	log "##### the regression. seven geometries, and the packer was rewritten ####"
	for nn in 16 24 32 40 48 64
	do
		log ""
		log "===== N = $nn"
		c "$M4" X=1 $MM 1 64 $nn
	done
	log ""
	log "===== K = 32 at N = 64                                             ====="
	c "$M4" X=1 $MM 1 32 64

	log ""
	log "===== 10) the control that must FAIL, and int8                     ====="
	c "CHARSIU_W4=1" X=1 $MM 1 64 64
	c X=1 X=1 $MM 1 64 64

	log ""
	log "===== 11) and the map at N = 56, so a miss is readable in one boot ====="
	c X=1 X=1 $CH 1 64 56 --map 8

	log ""
	log "===== the anchor again                                             ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== N = 56 exact would close every N that is a multiple of 8.    ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
