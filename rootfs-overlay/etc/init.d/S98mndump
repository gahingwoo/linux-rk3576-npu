#!/bin/sh
# ---------------------------------------------------------------------------
# 2026-08-08 round 2. The previous round refuted its own hypothesis and left a
# much sharper table:
#
#   model        ic  oc  in HxW   in_zp out_zp  tasks  result
#   conv2d-cal   16 128   80x80    128    128     1    OK
#   mn_pw2       32  64  112x112     0      0     2    FAIL, follows the input
#   mn_conv0      3  32  224x224   128      0     ?    FAIL, follows the input
#   mn_dw1       32  32  112x112     0      0     2    FAIL, constant
#
# So it is not int8, not per-axis, not depthwise and not chaining: a plain 1x1
# uint8 per-tensor conv fails in one job. Two variables survive, and every
# failing model changes BOTH at once:
#
#   A) output zero point 0, where the only passing model has 128
#   B) the job splits into 2 tasks, where the only passing model has 1
#      (2 OUT_CVT lines and 2 regcmd dumps for the mn_* models, 1 for
#      conv2d-cal, even though test_model.py counts jobs=1 for both)
#
# This round separates them. The mutated models change ONLY a zero point and
# leave geometry, weights and scales alone, so they keep their task count; the
# small MobileNet layers keep zero point 0 and drop the task count.
#
#   cal_ozp0   conv2d-cal, out_zp 128 -> 0.   A predicts FAIL, B predicts pass
#   cal_izp0   conv2d-cal, in_zp 128 -> 0.    isolates the input zero point
#   pw2_zp128  mn_pw2, both zp 0 -> 128.      A predicts PASS, B predicts fail
#   mn_pw24    MobileNet op24, 7x7, zp 0.     B predicts PASS, A predicts fail
#   mn_dw25    MobileNet op25 depthwise, 7x7
#   md003      in_zp 0 but out_zp 127, already in the image
#
# A and B make OPPOSITE predictions on all four, so the round decides.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }

# Print the driver's own task_count for the job this model submitted. jobs= in
# the run line counts SUBMITS; a job that splits into several tasks still
# counts as one, and the split is the thing under test here.
run() {
	echo "SMARK-$1" > /dev/kmsg 2>/dev/null
	env TEFLON_LIB=/usr/lib/libteflon.so \
		python3 "$NPU_DIR/test_model.py" "$NPU_DIR/$1" "${2:-3}" > "$C" 2>&1
	dmesg | sed -n "/SMARK-$1/,\$p" | grep -a "job: task_count=" | head -3 > "$C" 2>&1
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	# -n 8 floods the serial console and wedges the box. Learned the hard way.
	dmesg -n 4 2>/dev/null

	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/job_log 2>/dev/null
	log ""
	log "  task_con16=$(cat /sys/module/rocket/parameters/task_con16 2>/dev/null)" \
	    "job_log=$(cat /sys/module/rocket/parameters/job_log 2>/dev/null)"

	log ""
	log "===== 1) CONTROL: conv2d-cal, the one configuration known correct ====="
	log "  (must be 3/3 with task_count=1, or nothing below counts)"
	run conv2d-cal.tflite 3

	log ""
	log "===== 2) cal_ozp0: conv2d-cal with ONLY the output zero point 128->0 ====="
	log "  A says FAIL, B says pass"
	sleep 2
	run cal_ozp0.tflite 3

	log ""
	log "===== 3) cal_izp0: conv2d-cal with ONLY the input zero point 128->0 ====="
	sleep 2
	run cal_izp0.tflite 3

	log ""
	log "===== 4) pw2_zp128: mn_pw2 with both zero points 0->128 ====="
	log "  A says PASS, B says fail. Same geometry that failed last round."
	sleep 2
	run pw2_zp128.tflite 3

	log ""
	log "===== 5) mn_pw24: MobileNet op24, 1x1 conv on 7x7x512, zp 0 ====="
	log "  small enough to be one task. B says PASS, A says fail."
	sleep 2
	run mn_pw24.tflite 3

	log ""
	log "===== 6) mn_dw25: MobileNet op25, depthwise on 7x7x1024, zp 0 ====="
	sleep 2
	run mn_dw25.tflite 3

	log ""
	log "===== 7) md003: 1x1 conv, in_zp 0 but out_zp 127 ====="
	log "  the mixed case. A says pass, since 127 is not 0."
	sleep 2
	run md003.tflite 3

	log ""
	log "===== 8) REPEAT CONTROL: conv2d-cal again, last ====="
	log "  (proves the box did not degrade over the round)"
	sleep 2
	run conv2d-cal.tflite 2

	log ""
	log "===== read 1 and 8 first. Then 2 vs 4: if cal_ozp0 fails and       ====="
	log "===== pw2_zp128 passes it is the OUTPUT ZERO POINT. If instead     ====="
	log "===== mn_pw24 passes and pw2_zp128 fails it is the TASK SPLIT.     ====="
	sync
}

case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
