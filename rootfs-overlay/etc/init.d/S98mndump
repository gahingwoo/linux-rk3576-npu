# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-20 round 275. 111. Both halves at once, or the reason they will not.
#
# ⚠ THE ARITHMETIC IS SOLVED. PROC_PRECISION = 0 with a one byte activation is
# a plain integer multiply, exact at five of five:
#
#   amp    1   2    5    10   100
#   out    7   14   35   70   700      against a nibble of 7. out = a * w.
#
# No fp16 bit pattern, no logarithm. That is the operation an int4 matmul wants.
# The paired second k still returns 127 * w whatever the amplitude, so it reads
# something that is not in the activation buffer, and that is a separate defect.
#
# ⚠ AND THE CHANNEL COUNT HAS A SOURCE. CORE 0x3020 set to 127, claiming 128
# channels at N = 64, gives wrote = 72. 0x402c and 0x5014 carry the same n-1 and
# are inert; CONV_CON2 is inert in all five arms; SIZE_E_0 is inert or hangs;
# CBUF_CON0 turns the fetch dark without moving the count. Five rounds of
# sweeping and the answer was in a register excluded for being IDENTICAL on both
# paths.
#
#   channels = ceil((v+1)/2) + extra(SIZE_E_2)      v = 0x3020, extra 0,0,4,8
#   v = 63  -> 32 + 8 = 40      v = 127 -> 64 + 8 = 72       both measured
#
# ⚠ AND THE TWO FIXES FOUGHT. 0x3020 = 127 together with the k fix came back at
# 40, not 72. There is a reason to expect that and it is arithmetic: with the k
# fix a channel eats 32 weight bytes rather than 16, so 72 channels want 2304
# bytes out of a buffer that holds 2048. 40 is what fits with room over.
#
# THE ROUND IS ONE NUMBER. 111.
#
#   ceil(112/2) + 8 = 64 channels, and 64 channels times 32 bytes is 2048,
#   which is EXACTLY charsiu_weight_bytes at K = 64, N = 64.
#
# So the same value is predicted to give the full channel count AND to be the
# largest one that fits with the k fix on. If the buffer size is why they fought,
# 111 does not fight.
#
# THE READING RULE, fixed before the run.
#
#   ⚠ ENTRY 3 IS THE ROUND. 0x3020 = 111 with the k fix, full sweep.
#
#     wrote 64 and 64 words lit    both halves are solved. Every channel, every
#                                  k, and the remaining defect is the 127.
#     wrote 64, fewer lit          the write reaches 64 and the fetch does not,
#                                  and the difference says how many bytes short
#     wrote 40                     the buffer size was not why they fought and
#                                  the interaction is something else
#
#   ENTRY 2 tests the formula on six values before combining anything, and they
#   are derived from two measured points, not fitted to six:
#
#     v =  31 -> 24     v =  79 -> 48     v = 111 -> 64
#     v =  47 -> 32     v =  95 -> 56     v = 127 -> 72   (already measured)
#
#   ENTRY 4 is the other route to 64: v = 127 with SIZE_E_2 = 1, which removes
#   the +8. If entry 2's formula is right this is 64 as well, from a different
#   pair of fields, and it wants 2304 bytes so it should fight the k fix where
#   111 does not.
#
#   ENTRY 5 is the whole thing: 111, the k fix, and a one byte activation. If
#   entry 3 is clean this is a complete int4 matmul geometry and the values in
#   it are the last thing to check.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
CH=/opt/charsiu/charsiu_int4
FIX=0x100c=0x20600020
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

c() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $*"; return 0; }
	before=$(nbad)
	sleep 1
	env $1 $2 $CH $3 $4 $5 $6 $7 $8 > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This arm is VOID."; health; }
	return 0
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	if [ -w /sys/module/rocket/parameters/reset_autosuspend ]; then
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend
		log "reset_autosuspend = $(cat /sys/module/rocket/parameters/reset_autosuspend)"
	else
		log "!! reset_autosuspend NOT WRITABLE. A timeout will kill the round."
	fi

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "##### 2) the formula. derived from two points, six predictions.    #####"
	for v in 31 47 79 95 111 127
	do
		log ""
		log "===== 0x3020 = $v"
		c "CHARSIU_OVERRIDE=0x3020=$v" X=1 1 64 64 --map 8 128
	done

	log ""
	log "===== 3) THE ROUND. 0x3020 = 111 with the k fix, full sweep.       ====="
	log ""
	c "CHARSIU_OVERRIDE=$FIX,0x3020=111" X=1 1 64 64 --map 8

	log ""
	log "===== 4) the other route: 0x3020 = 127 with SIZE_E_2 = 1           ====="
	c "CHARSIU_OVERRIDE=0x3020=127,0x4050=0x00023133" X=1 1 64 64 --map 8 128
	log "=====    and the same with the k fix, which should fight           ====="
	c "CHARSIU_OVERRIDE=$FIX,0x3020=127,0x4050=0x00023133" X=1 1 64 64 --map 8 128

	log ""
	log "===== 5) everything: 111, the k fix, a one byte activation         ====="
	c "CHARSIU_OVERRIDE=$FIX,0x3020=111" "CHARSIU_A8_STRIDE1=1 CHARSIU_KPAIR_BYTES=0,8,16,512" 1 64 64 --kpair
	c "CHARSIU_OVERRIDE=$FIX,0x3020=111" CHARSIU_A8_STRIDE1=1 1 64 64 --map 8

	log ""
	log "===== the anchor again                                             ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== 64 words written and 64 words lit is both halves solved.     ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
