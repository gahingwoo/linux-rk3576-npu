#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-21 round 309. THE CONFOUND 308 COULD NOT SEPARATE.
#
# 308 answered its own question and then showed the answer was not clean.
#
# The integer kernel worked: q4_0 went 2.65 -> 4.94 tok/s on this board at four
# threads, and the best number moved 2.68 -> 5.08. Both controls held: the
# CHARSIU_NO_QACT line reproduced 307's byte for byte, and the scalar build
# still matched. So the arithmetic is right and the speedup is real.
#
# Its prediction, q4_0 beats q8_0, held at four and six threads and FAILED at
# one and two:
#
#     t=1   q4_0 2.14   q8_0 2.96        t=4   q4_0 5.08   q8_0 3.73
#     t=2   q4_0 3.40   q8_0 3.71        t=8   q4_0 4.78   q8_0 4.80
#
# ⚠ I read that crossover as "few cores are ALU bound, four cores are byte
# bound". THAT READING HAS A CONFOUND AND IT IS MINE: the two files do not
# differ only in the projections. **llama.cpp quantises token_embd to q6_K in a
# q4_0 file and to q8_0 in a q8_0 file**, Llama 3.2 ties the output head to it,
# and at a 128256 vocabulary that tensor is a fifth of the weights. q6_K costs
# far more ALU per byte than q8_0 does. So "q4_0 versus q8_0" was never a
# bytes-against-bytes comparison.
#
# WHAT IS NEW. A third file, built with llama-quantize --pure, whose token_embd
# is q4_0 like everything else in it. On the host, four threads:
#
#     q4_0 (q6_K head)  35.29        q4_0 --pure  40.70        q8_0  34.43
#
# so the head alone was worth 15%, and with it gone the host crossover
# DISAPPEARS -- pure q4_0 is ahead at every thread count, by more as threads are
# added:
#
#     t=1  21.67 / 21.45     t=2  34.26 / 32.92
#     t=4  40.70 / 34.74     t=8  31.73 / 30.41       (pure q4_0 / q8_0)
#
# ⚠ THE PURE FILE IS AN INSTRUMENT, NOT A GOOD MODEL. It was requantised from
# the q8_0 file, so it is quantised twice, and its output head is 4 bit. It says
# true sentences about grammar and false ones about the world. It exists to hold
# ONE format constant across a whole model, and its text is only ever compared
# against ITSELF on the host.
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# 1) TEXT FIRST. Six lines, and here is every one of them.
#
#    q4_0, both paths, and q4_0-pure, both paths, are each internally identical:
#      q4_0       ...is Rome. The capital of Spain is Madrid. The capital of
#                 Portugal is Lisbon. The capital
#      q4_0-pure  Paris. Paris is the most populous city in the world, with a
#                 population of over 2 million people. The city is known for
#                 its rich history, art
#
#    q8_0 is the one whose two paths legitimately differ:
#      quantised  ...Claude Monet painted the water
#      exact      ...Claude Monet painted many landscapes
#
#    The q4_0 exact line must also still match ROUND 307's. Anything else and
#    the timings below are timings of a wrong answer.
#
# 2) THEN THE ROUND, entry 4. Read q4_0-pure against q8_0 at every thread count.
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT
# ---------------------------------------------------------------------------
#
# A) **q4_0-pure IS AHEAD OF q8_0 AT EVERY THREAD COUNT, INCLUDING ONE AND
#    TWO.** That is what the host does once the head is the same format. If the
#    board still crosses over at low thread counts, then something about the
#    RK3576 and not the file makes 4 bit unpacking expensive there, and 308's
#    ALU-versus-bytes reading survives after all.
#
# B) **THE BOARD'S BEST NUMBER GOES FROM 5.08 TO ABOUT 6 tok/s.** The host
#    gained 15% from the pure head; the board should gain at least that, since
#    it is the more bandwidth starved of the two and the pure file is 9%
#    smaller as well.
#
# C) q4_0-pure at 8 threads will still be no better than at 4, as in 308. Four
#    A53 cores added contention and not throughput there and nothing here
#    changes that.
#
# ⚠ Entry 0 warms all three files. PROMPT TOK/S IS I/O; READ THE GEN COLUMN.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
RUN=/opt/charsiu/charsiu_run
RUNS=/opt/charsiu/charsiu_run_scalar
M4=/opt/charsiu/models/Llama-3.2-1B-Instruct-Q4_0.gguf
MP=/opt/charsiu/models/Llama-3.2-1B-Instruct-Q4_0-pure.gguf
M8=/opt/charsiu/models/Llama-3.2-1B-Instruct-Q8_0.gguf
PROMPT="The capital of France is"
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

# $1 binary, $2 model, $3 tokens, $4 threads, $5 env (or "-")
gen() {
	log ""
	if [ "$5" = "-" ]; then
		log "  -- $(basename $1)  $(basename $2)  -n $3  -t $4"
		"$1" "$2" -p "$PROMPT" -n "$3" --ignore-eos -q -c 512 -t "$4" > "$C" 2>&1
	else
		log "  -- $(basename $1)  $(basename $2)  -n $3  -t $4  [$5]"
		env "$5" "$1" "$2" -p "$PROMPT" -n "$3" --ignore-eos -q -c 512 -t "$4" > "$C" 2>&1
	fi
	return 0
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || log "no accel device (the charsiu entries do not need it)"
	dmesg -n 4 2>/dev/null
	[ -w /sys/module/rocket/parameters/reset_autosuspend ] && \
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend

	log ""
	log "===== 0) warm all three files. TIMINGS IN THIS ENTRY ARE I/O.      ====="
	cat "$M4" > /dev/null 2>&1
	cat "$MP" > /dev/null 2>&1
	cat "$M8" > /dev/null 2>&1
	log "  -- three models in the page cache"
	log "  -- $(free -m 2>/dev/null | head -2 | tail -1)"

	log ""
	log "===== 1) the NPU anchor                                            ====="
	w conv2d-cal.tflite ""

	log ""
	log "##### ROUND 309: the same format all the way through a file.       #####"

	log ""
	log "===== 2) THE TEXT. three files, quantised activation.              ====="
	gen "$RUN" "$M4" 32 4 -
	gen "$RUN" "$MP" 32 4 -
	gen "$RUN" "$M8" 32 4 -

	log ""
	log "===== 3) THE CONTROL. exact f32 activation, same three.            ====="
	log "=====    q4_0 must still be round 307's line, byte for byte.       ====="
	gen "$RUN" "$M4" 32 4 CHARSIU_NO_QACT=1
	gen "$RUN" "$MP" 32 4 CHARSIU_NO_QACT=1
	gen "$RUN" "$M8" 32 4 CHARSIU_NO_QACT=1

	log ""
	log "===== 4) THE ROUND. pure q4_0 against q8_0, every thread count.    ====="
	log "=====    I say pure is ahead at ALL of them, including 1 and 2.    ====="
	for T in 1 2 4 6 8
	do
		gen "$RUN" "$MP" 24 "$T" -
		gen "$RUN" "$M8" 24 "$T" -
	done

	log ""
	log "===== 5) and the q6_K head's own cost, on this board               ====="
	log "=====    same projections, only the output head differs            ====="
	for T in 1 4 8
	do
		gen "$RUN" "$M4" 24 "$T" -
		gen "$RUN" "$MP" 24 "$T" -
	done

	log ""
	log "===== 6) the scalar control, no NEON at all                        ====="
	gen "$RUNS" "$MP" 24 4 -

	log ""
	log "===== the NPU anchor again                                         ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== text, then pure against q8_0, then what the q6_K head cost.  ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
