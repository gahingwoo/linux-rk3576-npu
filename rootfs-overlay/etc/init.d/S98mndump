# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-20 round 282. "Last pair" means the last one PRESENT, and an N whose
# last group is even has never been run.
#
# 281 STOOD WITHOUT THE OVERRIDE. Two of four geometries were exact with nothing
# on the command line, which settles two things at once:
#
#   K=64 N=64  64 of 64   the 0x3020 the driver emits, 2*(n-8)-1, is the value
#                         the whole layout was measured at
#   K=32 N=64  64 of 64   base[g] = (g/2)*8K + ... holds at BOTH K, so the two
#                         tables really were one expression and not a table
#                         memorised at 64
#   no HALFK    0 of 64   the control still fails
#   int8       64 of 64   the instrument is still sound
#
# ⚠ AND TWO WERE PARTIAL, BY EXACTLY ONE GROUP OF EIGHT. N = 32 gave 24 of 32
# and N = 16 gave 8 of 16. The base expression has one irregular term, the last
# pair sitting 64 bytes in rather than 128, and it was written as g == 7 because
# the map was read at N = 64 where the last group IS 7. At N = 32 the last group
# is 3 and at N = 16 it is 1, and those are exactly the sizes of the shortfalls.
#
# So "last" is the highest group in use, not 7. The packer now says
# g == (n-1)/8.
#
# ⚠ THAT IS FITTED TO TWO FAILURES AND ONE SUCCESS AND IT IS NOT READ. Every N
# it has seen has an ODD highest group: 7 at 64, 3 at 32, 1 at 16. At an N whose
# highest group is EVEN the rule predicts no 64 anywhere, and nothing has ever
# run there.
#
# ⚠ AND 281's LOG COULD NOT SAY WHICH CHANNELS FAILED. It printed channels 0 to
# 7 and a count, so "24 of 32" was consistent with a scattered eight as much as
# with a group of eight, and the reading above is an inference from the SIZE of
# the shortfall. The harness now prints an exact count per group of eight, so
# this round can see the difference the last one could not.
#
# THE READING RULE, fixed before the run.
#
#   ⚠ ENTRY 3 AND 4 ARE THE FIX. N = 32 and N = 16, which were 24 of 32 and 8
#   of 16, and nothing changed but which group gets the 64.
#
#     both exact, and the per group line shows 8/8 everywhere
#                          the irregular term is "the last group present" and
#                          the layout now holds at three N and two K
#     still short by one group, and the group is the LAST one
#                          the term is not about being last either
#     short somewhere else  281's shortfall was never a group at all and the
#                          inference from its size was wrong
#
#   ⚠ ENTRIES 5 TO 7 ARE THE PART THAT IS NOT FITTED. N = 24, 40 and 56 all
#   have an EVEN highest group, 2, 4 and 6, where the rule says no group takes
#   the 64. N = 48 has an odd one, 5, and should behave like 16, 32 and 64.
#
#     the three even ones exact and 48 exact    the rule is read, not fitted,
#                                               across seven values of N
#     the even ones short by a group            the last group needs the 64
#                                               whether it is odd or even and
#                                               the pairing story is wrong
#
#   ENTRY 8 is the control that must FAIL and ENTRY 9 is int8.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
MM=/opt/charsiu/charsiu_matmul
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

c() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $*"; return 0; }
	before=$(nbad)
	sleep 1
	env $1 $2 $3 $4 $5 $6 $7 $8 $9 > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This arm is VOID."; health; }
	return 0
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	if [ -w /sys/module/rocket/parameters/reset_autosuspend ]; then
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend
		log "reset_autosuspend = $(cat /sys/module/rocket/parameters/reset_autosuspend)"
	else
		log "!! reset_autosuspend NOT WRITABLE. A timeout will kill the round."
	fi

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== 2) N = 64, the one that already worked. Must not regress.    ====="
	log ""
	c "CHARSIU_W4=1 CHARSIU_W4_HALFK=1" X=1 $MM 1 64 64

	log ""
	log "===== 3) N = 32. Was 24 of 32.                                     ====="
	c "CHARSIU_W4=1 CHARSIU_W4_HALFK=1" X=1 $MM 1 64 32

	log ""
	log "===== 4) N = 16. Was 8 of 16.                                      ====="
	c "CHARSIU_W4=1 CHARSIU_W4_HALFK=1" X=1 $MM 1 64 16

	log ""
	log "##### the part that is NOT fitted: an EVEN highest group           #####"
	log ""
	log "===== 5) N = 24, highest group 2                                   ====="
	c "CHARSIU_W4=1 CHARSIU_W4_HALFK=1" X=1 $MM 1 64 24

	log ""
	log "===== 6) N = 40, highest group 4                                   ====="
	c "CHARSIU_W4=1 CHARSIU_W4_HALFK=1" X=1 $MM 1 64 40

	log ""
	log "===== 7) N = 56, highest group 6.  and N = 48, odd, must behave.   ====="
	c "CHARSIU_W4=1 CHARSIU_W4_HALFK=1" X=1 $MM 1 64 56
	c "CHARSIU_W4=1 CHARSIU_W4_HALFK=1" X=1 $MM 1 64 48

	log ""
	log "===== 8) the control that must FAIL                                ====="
	c "CHARSIU_W4=1" X=1 $MM 1 64 64

	log ""
	log "===== 9) int8 dense                                                ====="
	c X=1 X=1 $MM 1 64 64

	log ""
	log "===== the anchor again                                             ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== read the per group line, not just the count.                 ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
