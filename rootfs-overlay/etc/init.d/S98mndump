#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-20 round 269. Fourteen registers separate a path that computes every
# channel from one that computes forty. Flip them one at a time.
#
# ⚠ FIRST, THE HARNESS. Round 268's entry 2 DIED AND NOTHING SAID SO. Its first
# probe timed out, the iommu raw reset failed 125 times, and 105 of its 108
# lines reported "wrote 0" on a block that was already gone. The poison gate has
# been in this script since round 250 and it only ever wrapped the tflite runs;
# the charsiu runs had none. Same mistake, new place. Every charsiu arm goes
# through the gate now.
#
# Entries 3 to 7 of 268 were clean, 0 timeouts and 0 reset failures, and the
# closing anchor was 128/128, so what follows stands on those.
#
# WHAT 268 SETTLED. int8 is the oracle and it computes everything it is asked
# for. Its highest written byte is N-1 at both N = 32 and N = 64, no weight byte
# anywhere in its buffer is dead, and its law came out whole:
#
#   int8:  channel = 32*(B/2048) + (B/32) mod 32
#          k       = B mod 32 + 32*((B/1024) mod 2)
#          64 bytes a channel, 64 k, nothing left over
#
#   int4:  two groups of eight bytes, at B and B+256, 16 nibbles each
#          32 k a channel against a K of 64, and 8*(N/16 + 1) channels
#
# The two are the SAME SHAPE with int4's runs half as long. int8 reads 32 bytes
# a channel a pass and takes two passes to cover 64 k. int4 reads 8 and takes
# two, so it covers 32. To cover 64 it would have to read 16.
#
# N/2 + 8 is now five points, and 48 and 128 were derived rather than fitted:
# 32 channels and 64 live groups at N = 48, 72 and 144 at N = 128, four for
# four. Written as an iteration it is 8*(N/16 + 1) groups of eight, where N/8
# would be right, so the count is HALVED AND THEN INCREMENTED.
#
# WHAT THIS ROUND DOES. A stream dump went into the tool, so the baseline is in
# this log rather than recomputed by hand, and CHARSIU_OVERRIDE sets any single
# register from the environment. Diffing int8's stream against int4's at the
# same K and N leaves exactly fourteen registers, three of which are the requant
# and settled, one of which is the precision itself. Ten are left and each gets
# an arm.
#
# THE READING RULE, fixed before the run.
#
#   ⚠ TWO NUMBERS PER ARM, and they are independent.
#
#     wrote      the channel count. 40 at baseline, 64 would be right.
#     the words  baseline is w0 w1 w2 w3 w4 w5 w6 w7 then eight dark, one group
#                a channel. Two groups a channel reads w0 w0 w1 w1 w2 w2 w3 w3.
#
#     an arm that changes wrote        found the channel count
#     an arm that doubles the groups   found the k shortfall
#     an arm that does both            they were one bug
#     an arm that hangs                the gate says so and the round continues
#
#   ⚠ THE BASELINE MUST REPRODUCE. Entry 3 is the same probe 267 and 268 ran.
#   40 channels, w0 through w7, bytes 64 to 127 dark. If it does not, the
#   override plumbing broke the stream and every arm below is void.
#
#   ⚠ 0x101c IS NOT SWEPT and that is deliberate: it is the real size of the
#   weight buffer, and int8's value is twice what is allocated here.
#
#   No prediction on which of the ten. Written predictions have gone 4 of 6 and
#   then 3 of 6, and both times the misses were extrapolation rather than
#   reading. Ten arms is cheap enough not to need a guess.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
CH=/opt/charsiu/charsiu_int4
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

# the charsiu gate, which round 268 did not have
c() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $*"; return 0; }
	before=$(nbad)
	sleep 1
	env $1 $CH $2 $3 $4 $5 $6 $7 > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This arm is VOID."; health; }
	return 0
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	if [ -w /sys/module/rocket/parameters/reset_autosuspend ]; then
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend
		log "reset_autosuspend = $(cat /sys/module/rocket/parameters/reset_autosuspend)"
	else
		log "!! reset_autosuspend NOT WRITABLE. A timeout will kill the round."
	fi

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== 2) the int4 baseline stream, so the sweep has a reference    ====="
	log ""
	c "X=1" 1 64 64 --stream

	log ""
	log "===== 3) BASELINE int4 N=64. Must be 40 channels, w0..w7, 64+ dark ====="
	sleep 1
	c "X=1" 1 64 64 --map 8 256

	for a in \
		"0x100c=0" \
		"0x1020=0x40" \
		"0x1028=0x0001003f" \
		"0x1030=0x00800000" \
		"0x103c=0x00010000" \
		"0x1044=0x00010001" \
		"0x4030=0x003f0710" \
		"0x4038=0x00120080" \
		"0x4044=0x00000001" \
		"0x4050=0x80011111"
	do
		log ""
		log "===== ARM $a   (int4 -> its int8 value)"
		c "CHARSIU_OVERRIDE=$a" 1 64 64 --map 8 128
	done

	log ""
	log "===== the anchor again                                             ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== wrote != 40 found the channels. w0 w0 w1 w1 found the k.     ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
