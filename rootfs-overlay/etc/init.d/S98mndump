# ---------------------------------------------------------------------------
# 2026-08-11 round 89. conv0's last half percent: the requant multiply wraps.
#
# Round 88 re-ran identically, digit for digit, so the numbers are stable:
#
#   fc_imp     within 1 100.0%
#   fc_allw    within 1  99.6%   of the failures 100.0% at a rail
#   fc_impb    within 1  99.8%   of the failures  16.7% at a rail
#   mn_conv0   within 1  99.5%   of the failures   7.9% at a rail
#
# conv0's tail is NOT clipping: 92 percent of what it gets wrong is away from
# both rails, and 0.3 percent of pixels are off by more than 8, which rounding
# cannot do.
#
# ⚠ AND ROUND 88'S CVT_DOWN TEST WAS VOID, WHICH IS MY MISTAKE AND THE THIRD OF
# ITS KIND. ROCKET_CVT_DOWN lives in the generic emitter; conv0 goes through
# fill_regcmd_firstconv, which never reads it. Round 50 was void for a knob
# that did not apply to the model, round 57 for a knob that did not apply to
# the path, and now this. The rule that catches it is the one this file keeps
# writing down: before believing a sweep, check the knob reaches the thing
# being swept.
#
# The arithmetic says a wrap is the right size. The OUT_CVT computes
# (accumulator * cvt_scale) >> shift in signed int32. conv0's accumulator
# reaches 27 * 128 * 151, which is 2^19, and cvt_scale is 0x76be at 2^14.9, so
# the product is 2^33.9 and wraps for any accumulator above 70646. Scaling the
# multiplier down by T bits and the shift by T is arithmetically identical and
# keeps the product in range:
#
#   T=0  product 2^33.9  overflows      T=4  product 2^29.9  fits
#   T=2  product 2^31.9  overflows      T=6  product 2^27.9  fits
#
# So 2 would not have been enough even if it had reached, which is why that
# void test is void twice over.
#
# DECISION RULE, written before the run:
#   the tail collapses at T=4 or 6    the wrap was it; pick the smallest T that
#                                     fits and derive it rather than sweep
#   T=2 already helps                 the overflow model is wrong about where
#                                     the boundary is
#   nothing changes at any T          the knob still does not reach, or the
#                                     tail is not a wrap; check that a large T
#                                     visibly damages the output before
#                                     believing either
#   fc_allw's rail failures move      they should not: those are clipping, and
#                                     T is arithmetically neutral
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
p() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== 1..5) conv0, the multiplier scaled down by T bits ====="
	p mn_conv0.tflite ""
	p mn_conv0.tflite ROCKET_FC_CVT_DOWN=2
	p mn_conv0.tflite ROCKET_FC_CVT_DOWN=4
	p mn_conv0.tflite ROCKET_FC_CVT_DOWN=6
	p mn_conv0.tflite ROCKET_FC_CVT_DOWN=10

	log ""
	log "===== 6) VOID CHECK: a big T must visibly damage the output ====="
	p mn_conv0.tflite ROCKET_FC_CVT_DOWN=20

	log ""
	log "===== 7..8) the impulse models at the winner ====="
	p fc_imp.tflite ROCKET_FC_CVT_DOWN=4
	p fc_allw.tflite ROCKET_FC_CVT_DOWN=4

	log ""
	log "===== 9) the chain ====="
	p mn_conv0dw1.tflite ROCKET_FC_CVT_DOWN=4

	log ""
	log "===== 10..12) REGRESSION ====="
	p conv2d-cal.tflite ""
	p mn_dw1.tflite ""
	p mn_dw25.tflite ""

	log ""
	log "===== Read test 6 first. If T=20 does not wreck conv0, the knob   ====="
	log "===== is not reaching it and tests 2 to 5 mean nothing.           ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
