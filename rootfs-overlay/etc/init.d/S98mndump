#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-11 round 72. What is the RULE behind the +32?
#
# Round 71 closed the tail:
#
#   dw25_t4  +0    992/1024, live 0..991
#   dw25_t4  +32  1024/1024, every one COMPUTED
#   dw25_t4  +64  1024/1024
#   mn_dw25  +32  1024/1024
#   mn_dw1   -16  32/32 -> 0/32 with live 0..15      the void check, passes
#
# So the output side is told 32 channels too few, and the four registers that
# carry the count are the right place. The void check is what makes the rest
# readable: the knob demonstrably reaches the hardware.
#
# But +32 is a magic number until the rule behind it is known, and this project
# has been burned by shipping a constant fitted to one capture before: CNA
# 0x1080's padding constant was exactly SAME padding for one 5x5 stride 2 conv
# and wrong for every other geometry, and it stood for months.
#
# Two things distinguish the cases. mn_dw1 has 32 channels and is correct at
# +0; mn_dw25 has 1024 and needs +32. So the rule is not "always add 32", or
# mn_dw1 would be wrong today. It could be
#
#   oc + 32 for oc > 32          a threshold
#   oc + oc/32                   proportional, giving 33 at 32 channels
#   ALIGN(oc, 64) + 32           tied to the weight group size
#   oc rounded up past a         something else entirely, and the minimum
#     boundary the count is       addition at 1024 says which
#     compared against
#
# This round measures three things: whether a 32 channel depthwise tolerates
# the addition at all, what the MINIMUM addition is that closes the tail at
# 1024, and whether a regular conv is affected, since the knob currently
# applies to every op and the shipped fix must not touch the shapes that are
# already byte exact.
#
# DECISION RULE, written before the run:
#   mn_dw1 correct at +32 too    the addition is harmless below the threshold,
#                                so a single unconditional rule can work
#   mn_dw1 breaks at +32         the rule has to depend on the channel count,
#                                and the minimum at 1024 says how
#   minimum is 32                it is a whole group of 32
#   minimum is smaller           it is a rounding boundary, not a group
#   conv2d-cal breaks at +32     the fix must be depthwise only
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
p() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== 1..3) does a 32 channel depthwise tolerate the addition? ====="
	p mn_dw1.tflite ""
	p mn_dw1.tflite ROCKET_OC_OUT_ADD=32
	p dw1_t4.tflite ROCKET_OC_OUT_ADD=32

	log ""
	log "===== 4..8) the MINIMUM addition that closes the tail at 1024 ====="
	p dw25_t4.tflite ROCKET_OC_OUT_ADD=1
	p dw25_t4.tflite ROCKET_OC_OUT_ADD=8
	p dw25_t4.tflite ROCKET_OC_OUT_ADD=16
	p dw25_t4.tflite ROCKET_OC_OUT_ADD=24
	p dw25_t4.tflite ROCKET_OC_OUT_ADD=32

	log ""
	log "===== 9..10) does a REGULAR conv tolerate it? ====="
	p conv2d-cal.tflite ROCKET_OC_OUT_ADD=32
	p cal_oc16.tflite ROCKET_OC_OUT_ADD=32

	log ""
	log "===== 11) the real 1024 channel layer at the winner ====="
	p mn_dw25.tflite ROCKET_OC_OUT_ADD=32

	log ""
	log "===== Read tests 1 and 2 together: if 32 channels survives +32,   ====="
	log "===== one unconditional rule can cover both sizes.                ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
