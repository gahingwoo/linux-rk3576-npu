#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-22 round 332. ONE QUESTION: DO THE PHANTOM WORDS CARRY DIFFERENT k?
#
# ⚠ ROUND 331 IS A CLEAN NEGATIVE. The pairing search found 15 of 64, 38 of 256
# and 309 of 512 -- and the pairs are scattered (`11=w2+w88`, `20=w31+w83`),
# with no rule and no arm of the sweep standing out from the others. Those
# counts scale with the number of PAIRS, not with anything real: they are
# coincidences. Odd k, bit-4 parity and the other intra-slot order all scored
# the same. **The second half of a channel's k is not in the buffer in any form
# tried, and no sum of two written words is its dot product.**
#
# ---------------------------------------------------------------------------
# SO STOP SWEEPING PACKINGS AND ASK THE HARDWARE WHICH k IT READ
# ---------------------------------------------------------------------------
#
# Everything about the WORD a byte feeds was measured (`--map`, 1376 points).
# Nothing about the k inside it has been, at these settings -- it has only ever
# been guessed, three times, and all three failed. There is already a probe for
# exactly this: `--kpair` lights one nibble, walks a one-hot input across k, and
# prints which k the nibble multiplied with.
#
# At K=64 N=64 the block is 64 slots = 512 bytes, so
#
#   word  0   slots 0 and 32     bytes 0..7    and 256..263
#   word  1   slots 1 and 33     bytes 8..15   and 264..271
#   word 64   slots 128 and 160  bytes 1024..  and 1280..     (the PHANTOM half)
#   word 65   slots 129 and 161  bytes 1032..  and 1288..
#
# **THE WHOLE ROUND IS ONE COMPARISON: does word 64 pair with the same k as
# word 0, or with different k?**
#
#   different k   the phantom words hold the rest of the sum, the packer just
#                 has to put the right k there, and int4 goes to full width
#   the same k    the phantom words are a redundant copy, a channel really can
#                 only ever see K/2, and int4 is closed for good on a
#                 measurement rather than on a sixth failed guess
#
# Either answer ends the search, which is why this is worth one more boot.
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# 1) ENTRY 3a IS THE CONTROL: --kpair at TODAY's settings, where the answer is
#    already known from rounds 265 to 288 -- byte j of a slot carries k = 2j in
#    its low nibble and k = 2j+1 in its high. If that does not come back, the
#    probe is not reading what it used to and nothing below counts.
# 2) ENTRY 3b IS THE ROUND, the same probe with 0x40b8 = 3 and 0x3020 = 2N-1.
#    Read the k column for bytes 1024 and 1280 against bytes 0 and 256.
# 3) ENTRY 2 IS THE STANDING CONTROL, unchanged: 64 of 64 and 128 of 256.
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT
# ---------------------------------------------------------------------------
#
# No prediction, and this time there is a reason beyond my record: the two
# outcomes are equally consistent with everything measured so far. The count in
# round 330 says the phantom words are fed from the unused half of the buffer;
# the halfk rule says a channel only ever sees the k whose bit 4 matches its
# parity, and both words in a pair share that parity. **Those two cannot both
# be true, and --kpair says which.**
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
RUN=/opt/charsiu/charsiu_run
BE=/opt/charsiu/charsiu_bench
MM=/opt/charsiu/charsiu_matmul
I4=/opt/charsiu/charsiu_int4
M4="CHARSIU_W4=1 CHARSIU_W4_HALFK=1"
M8=/opt/charsiu/models/Llama-3.2-1B-Instruct-Q8_0.gguf
PROMPT="The capital of France is"
LIMIT=420
ARMCAP=240
CE=CHARSIU_COEF_ELEMS=65536
HEAD=CHARSIU_NPU_MAXN=131072
B8="CHARSIU_OVERRIDE=0x40b8=3"
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

capped() {
	lim="$1"; shift
	"$@" &
	pid=$!
	i=0
	while [ "$i" -lt "$lim" ]; do
		kill -0 "$pid" 2>/dev/null || { wait "$pid"; return $?; }
		sleep 1
		i=$((i + 1))
	done
	kill -9 "$pid" 2>/dev/null
	wait "$pid" 2>/dev/null
	return 124
}

c() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $*"; return 0; }
	before=$(nbad)
	sleep 1
	capped "$ARMCAP" env $1 $2 $3 $4 $5 $6 $7 $8 $9 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the arm exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This arm is VOID."; health; }
	return 0
}

rung() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $1"; return 0; }
	lbl="$1"; shift
	before=$(nbad)
	log ""
	log "  -- $lbl"
	sleep 1
	capped "$LIMIT" env "$@" "$RUN" "$M8" -p "$PROMPT" -n 32 \
		--ignore-eos -q -c 512 -t 4 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the rung exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This rung is VOID."; health; }
	return 0
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	[ -w /sys/module/rocket/parameters/reset_autosuspend ] && \
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend

	log ""
	log "===== 0) the limit's own control. expect rc 124 after ~3s.         ====="
	t0=$(cut -d. -f1 /proc/uptime)
	capped 3 sleep 60
	rc=$?
	t1=$(cut -d. -f1 /proc/uptime)
	log "  -- capped 3 sleep 60  ->  rc $rc after $((t1 - t0))s"
	[ "$rc" = "124" ] || log "  !! THE LIMIT DID NOT FIRE. Nothing below can be trusted to end."

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "##### ROUND 332: do the phantom words carry different k?          #####"

	log ""
	log "===== 2) THE MEASUREMENT. every stage of the forward pass, NPU on. ====="
	log "=====    matmul stages minus the hardware path = the quantise.     ====="
	rung "the decode loop on the NPU, stages on" \
		CHARSIU_STAGES=1 CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 "$CE" "$HEAD"

	log ""
	log "===== 2b) the same stages with the NPU off, one boot apart.        ====="
	rung "the CPU path, stages on" CHARSIU_STAGES=1 CHARSIU_NPU_QUANT=1

	log ""
	log "===== 2) the standing control: today's packing                     ====="
	c "$M4" $MM 1 64 64
	c "$M4" $MM 1 2048 256

	log ""
	log "===== 3) WHICH k DOES EACH BYTE CARRY? the one thing never measured ====="
	log "===== 3a CONTROL: --kpair today. rounds 265-288 say k=2j and 2j+1."
	c "CHARSIU_W4=1 CHARSIU_KPAIR_BYTES=0,4,8,256,260,264,1024,1028,1032,1280,1284,1288" \
	  $I4 1 64 64 --kpair
	log "===== 3b THE ROUND: the same probe at 0x40b8=3 and 0x3020=2N-1"
	log "=====    word 0 is bytes 0 and 256; word 64 is bytes 1024 and 1280"
	c "CHARSIU_W4=1 CHARSIU_KPAIR_BYTES=0,4,8,256,260,264,1024,1028,1032,1280,1284,1288" \
	  "CHARSIU_OVERRIDE=0x40b8=3,0x3020=0x7f" $I4 1 64 64 --kpair
	log "===== 3c and the map at the same settings, so the WORD is confirmed"
	c "CHARSIU_W4=1" "CHARSIU_OVERRIDE=0x40b8=3,0x3020=0x7f" $I4 1 64 64 --map 8

	log ""
	log "===== 5) the standing number, no timers, so they cannot be blamed  ====="
	rung "the decode loop on the NPU" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 "$CE" "$HEAD"

	log ""
	log "===== the anchor again                                             ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== 3a is the control; 3b answers it; either answer ends it.      ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
