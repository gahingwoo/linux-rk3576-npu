# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-23 round 355. GROUP 1024 IS THE ANSWER. AND THE LOAD WAS getenv.
#
# 🔑 ROUND 354. GROUP 1024, WHICH NOBODY HAD RUN, IS THE ONE.
#
#   int4 group 1024   8.92 tok/s  "The Eiffel Tower is located in Paris. The
#                                  Louvre Museum is also located in Paris. The
#                                  famous painting "The Mona Lisa" is on"
#   int4 group 512    7.51 tok/s  the tower, a thousand feet, the late 19th
#   int4 one scale   10.13 tok/s  circling
#   int8 standing     6.53 tok/s  the standing sentence
#
# **37% faster than int8, and the same content the CPU arm gives.** All three
# repeats reproduced their round 353 numbers (7.51 against 7.50, 10.13 against
# 10.09, 6.53 exactly), so the boot to boot spread is small here.
#
# 🔑🔑 AND THE HEARTBEAT SPLIT SETTLED THE LOAD IN ONE LINE.
#
#   int4 group 1024   148428 ms of which   4450 adding and 143978 quantising
#   int4 group 512    136727 ms of which   5180 adding and 131547 quantising
#   int4 one scale    118535 ms of which   3964 adding and 114571 quantising
#   int8               18436 ms of which   8879 adding and   9557 quantising
#
# It was never the packer. int4's ADDING is FASTER than int8's -- half the bytes
# -- and all of the loss is in npu_tensor_build.
#
# ⛔ THE CAUSE: **getenv() inside the loop over every weight.**
#
#     if (bits == 4 && !getenv("CHARSIU_NPU_W4_SYM"))
#
# getenv walks the environment with a strcmp an entry, and this ran 1.24 BILLION
# times. int8 never noticed because "bits == 4 &&" short circuits before the
# call, which is exactly why it read as an int4 problem for two rounds. I
# guessed a strided write to the buffer object twice and was wrong twice; the
# split heartbeat found it without a guess.
#
# Three of them hoisted in npuquant.c, and one more in charsiu_build_coefs that
# ran once an output channel rather than once a call.
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# ENTRY 1 IS THE FIX AND ITS NUMBER IS THE QUANTISING COLUMN. int8 quantises
# 113 tensors in 9.6 s and int4 should now be in the same country. If it is
# still over a minute there is a second one of these and the split will say so
# again.
#
# ENTRY 1'S SENTENCE AND RATE MUST NOT MOVE: 8.92 tok/s and the Louvre. Hoisting
# a getenv cannot change arithmetic, so if either moved, something else in this
# change did.
#
# ENTRY 2 is int8, which must still be 6.53 and about 9.6 s quantising -- it is
# the control for the hoist, since int8 never took that branch and must be
# unaffected in both columns.
#
# ENTRY 3 is group 1024 with a DIFFERENT PROMPT, because four sentences about
# Paris are not an accuracy measurement and one about something else is at
# least a second draw from the same urn.
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT
# ---------------------------------------------------------------------------
#
# Quantising near 10 s and everything else unchanged. The prompt phase should
# fall with it: 189 s of "prompt" in round 354 was mostly this.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
VD=/opt/charsiu/charsiu_vendor
V=/opt/charsiu/vendor
RGC=$V/vendor-int4-k2048-n1024.regcmd
WT=$V/vendor-wt-1M.bin
IN=$V/vendor-in.bin
RUN=/opt/charsiu/charsiu_run
M8=/opt/charsiu/models/Llama-3.2-1B-Instruct-Q8_0.gguf
PROMPT="The capital of France is"
LIMIT=420
CE=CHARSIU_COEF_ELEMS=65536
HEAD=CHARSIU_NPU_MAXN=131072
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block did not come back this time."
		ABORT=1
	fi
}

capped() {
	lim="$1"; shift
	"$@" &
	pid=$!
	i=0
	while [ "$i" -lt "$lim" ]; do
		kill -0 "$pid" 2>/dev/null || { wait "$pid"; return $?; }
		sleep 1
		i=$((i + 1))
	done
	kill -9 "$pid" 2>/dev/null
	wait "$pid" 2>/dev/null
	return 124
}
rung() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $1"; return 0; }
	lbl="$1"; shift
	before=$(nbad)
	log ""
	log "  -- $lbl"
	sleep 1
	capped "$LIMIT" env "$@" "$RUN" "$M8" -p "$PROMPT" -n 32 \
		--ignore-eos -q -c 512 -t 4 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the rung exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This rung is VOID."; health; }
	return 0
}
# arm: <label> <regcmd-or-dash> <byte> <high> [extra env, one assignment]
#
# ⚠ THE ENV GOES IN AS AN ARGUMENT, not as a "VAR=x arm ..." prefix. Whether an
# assignment before a FUNCTION call survives the call is unspecified -- dash
# drops it, other shells keep it -- and the arm whose whole job is to time out
# WITHOUT the trailer runs right after the one that has it. Not a question worth
# leaving to the shell.
arm() {
	before=$(nbad)
	log ""
	log "  ---- $1"
	sleep 1
	env ${5:-IGNORED=1} $VD "$2" "$WT" "$IN" "$3" "$4" 4096 > /tmp/vd.txt 2>&1
	cat /tmp/vd.txt > "$C"
	after=$(nbad)
	if [ "$after" != "$before" ]; then
		log "  !! POISONED: $((after - before)) new fault or timeout lines"
		health
		# ⚠ NOT a round abort. Round 342 threw away every arm after the
		# first poisoning and then measured the block healthy at the
		# end. The block recovers; give it a moment and carry on.
		ABORT=0
		sleep 2
	fi
}

start() {
	log ""
	log "###############################################################"
	log "##### round 355: group 1024 is the answer, and the load was getenv #####"
	log "###############################################################"
	log "  int4 is byte exact and 1.42 to 1.78x faster. now decode with it."

	log ""
	log "===== 1) int4 group 1024. read the QUANTISING column.         ====="
	log "  8.92 tok/s and the Louvre must not move; the load should."
	rung "int4, group 1024" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 CHARSIU_NPU_W4V=1 \
		CHARSIU_NPU_KMAX=1024 CHARSIU_NPU_W4_GROUP=1024 "$CE" "$HEAD"

	log ""
	log "===== 2) CONTROL: int8. never took that branch, must not move. ====="
	rung "int8, the standing number" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 "$CE" "$HEAD"

	log ""
	log "===== 3) group 1024 on a DIFFERENT PROMPT                     ====="
	log "  one sentence about Paris is not an accuracy measurement."
	# ⚠ set it and put it back. "PROMPT=... rung ..." is an assignment before
	# a FUNCTION call and whether it survives the call is unspecified.
	P0="$PROMPT"
	PROMPT="Explain in one paragraph why the sky is blue"
	rung "int4, group 1024, second prompt" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 \
		CHARSIU_NPU_W4V=1 CHARSIU_NPU_KMAX=1024 CHARSIU_NPU_W4_GROUP=1024 \
		"$CE" "$HEAD"

	log ""
	log "===== 4) the same prompt on the CPU, to face it with          ====="
	rung "cpu, second prompt" CHARSIU_NO_NPU=1
	PROMPT="$P0"

	log ""
	log "===== 6) the anchor: int8 conv must still be exact           ====="
	health

	log ""
	log "===== read the CONTROL lines first. VOID means the arm died. ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
