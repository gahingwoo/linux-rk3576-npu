# ---------------------------------------------------------------------------
# 2026-08-22 round 320. STOP INFERRING THE SPLIT AND MEASURE IT.
#
# ROUND 319 REFUTED BOTH OF MY PREDICTIONS, USEFULLY.
#
# The buffer I sized wrong WAS the whole of round 318's regression:
#
#     all 113, head on the NPU     4.18  ->  5.49 tok/s
#     112, head on the CPU         5.08  ->  5.13
#
# so routing the head is worth 7% and my "it will still not be worth it" was
# wrong. And the task cap sweep on the head alone came back FLAT across a
# thirty-two fold range:
#
#     tasks a submit  126    32     16     8      4
#     MB a submit     262.7  65.7   32.8   16.4   8.2
#     tok/s           3.68   3.59   3.61   3.66   3.58
#
# **So the per submit and per handle cost is NOT the limiter.** That hypothesis
# is dead, and capping the chain does nothing: entry 5 ran everything at 16
# tasks a submit and got the same 5.49.
#
# WHERE THAT LEAVES IT:
#
#     same q8_0 file, CPU        3.68
#     NPU, everything            5.49      1.49x
#     best CPU on this board     5.53      pure q4_0, round 309 -- LEVEL, not ahead
#
# ---------------------------------------------------------------------------
# WHY THIS ROUND EXISTS
# ---------------------------------------------------------------------------
#
# 182 ms a token. If the NPU fetches 1236 MB at the 10 GB/s round 306 measured,
# that is 124 ms, leaving 58 for the CPU.
#
# ⚠ THAT SENTENCE IS AN INFERENCE, AND I HAVE NOW BEEN WRONG THREE TIMES RUNNING
# BY INFERRING A COST INSTEAD OF MEASURING IT: the 190 us submit that was 79,
# the head that would be worth 32 ms and was worth minus 42, the handle count
# that explained nothing. So charsiu now times the hardware path itself and the
# report says:
#
#     charsiu NPU: N ms in the hardware path, X GB/s of weights, Y us a submit
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# 1) THE NEW REPORT LINE IS THE ROUND. Against the rung's own generation time it
#    splits the token three ways with no arithmetic on my part:
#      the hardware path       what the NPU and its read back actually took
#      the rest                everything the CPU still does
#      GB/s of weights         whether the fetch is at the 10 the bench measured
#
# 2) IF GB/s IS NEAR 10, the NPU side is at the hardware's measured ceiling and
#    every remaining win is on the CPU side or in fetching fewer bytes.
#    IF IT IS WELL UNDER 10, the runtime is losing something the bench did not,
#    and that is the next thing to find.
#
# 3) The text, character for character against entry 6, as always.
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT
# ---------------------------------------------------------------------------
#
# A) ABOUT 124 ms IN THE HARDWARE PATH, near 10 GB/s. ⚠ This is the fourth time
#    I have predicted a timing this week and the first three were wrong, so the
#    useful outcome is the number and not the prediction.
#
# B) THE READ BACK IS INSIDE THAT NUMBER AND MAY NOT BE SMALL. Every submit is
#    followed by a bo_prep, a scan of the output regions on the CPU, and a
#    bo_fini. For the head that is 126 regions and 504 KB a token; for the whole
#    model 606 regions. Entry 3 runs with the accumulate loop as the only
#    difference it can be, by capping to one task a submit -- if the hardware
#    path time barely moves while the submit count grows sixteen fold, the read
#    back rather than the submit is what it is made of.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
RUN=/opt/charsiu/charsiu_run
M8=/opt/charsiu/models/Llama-3.2-1B-Instruct-Q8_0.gguf
PROMPT="The capital of France is"
LIMIT=420
CE=CHARSIU_COEF_ELEMS=65536
HEAD=CHARSIU_NPU_MAXN=131072
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

capped() {
	lim="$1"; shift
	"$@" &
	pid=$!
	i=0
	while [ "$i" -lt "$lim" ]; do
		kill -0 "$pid" 2>/dev/null || { wait "$pid"; return $?; }
		sleep 1
		i=$((i + 1))
	done
	kill -9 "$pid" 2>/dev/null
	wait "$pid" 2>/dev/null
	return 124
}

rung() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $1"; return 0; }
	lbl="$1"; shift
	before=$(nbad)
	log ""
	log "  -- $lbl"
	sleep 1
	capped "$LIMIT" env "$@" "$RUN" "$M8" -p "$PROMPT" -n 32 \
		--ignore-eos -q -c 512 -t 4 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the rung exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This rung is VOID."; health; }
	return 0
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	[ -w /sys/module/rocket/parameters/reset_autosuspend ] && \
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend

	log ""
	log "===== 0) the limit's own control. expect rc 124 after ~3s.         ====="
	t0=$(cut -d. -f1 /proc/uptime)
	capped 3 sleep 60
	rc=$?
	t1=$(cut -d. -f1 /proc/uptime)
	log "  -- capped 3 sleep 60  ->  rc $rc after $((t1 - t0))s"
	[ "$rc" = "124" ] || log "  !! THE LIMIT DID NOT FIRE. Nothing below can be trusted to end."

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "##### ROUND 320: how many of the 182 ms are actually the NPU.     #####"

	log ""
	log "===== 2) THE ROUND. everything, and the hardware path timed.       ====="
	rung "all 113" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 "$CE" "$HEAD"

	log ""
	log "===== 3) the same, one task a submit. sixteen times the submits,   ====="
	log "=====    the same read back. what does the hardware path do?       ====="
	rung "all 113, one task a submit" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 \
		"$CE" "$HEAD" CHARSIU_NPU_MAXTASK=1

	log ""
	log "===== 4) without the head, so its share can be attributed          ====="
	rung "112, head on the CPU" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 "$CE"

	log ""
	log "===== 5) the head alone                                            ====="
	rung "head alone" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 "$CE" "$HEAD" \
		CHARSIU_NPU_ONLY=token_embd

	log ""
	log "===== 6) the CPU reference the text is diffed against              ====="
	rung "CPU, NPU number format" CHARSIU_NPU_QUANT=1

	log ""
	log "===== 7) and charsiu's plain CPU path on the same file             ====="
	rung "plain CPU, q8_0" X=1

	log ""
	log "===== the anchor again                                             ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== ms in the hardware path, and the GB/s beside it.             ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
