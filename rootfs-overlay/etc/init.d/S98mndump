# ---------------------------------------------------------------------------
# 2026-08-11 round 93. Is it the third kernel column?
#
# Round 92 named the outliers and they are stable: two identical runs of conv0
# give the same three, channels 5, 25 and 6 at a 0.9486, 0.9614 and 0.9786,
# and the measured multiplier keeps them in the same order. Not fit noise.
#
# The cross reference is the find. fc_impb, one live tap per channel plus the
# real bias, fails exactly channels 6, 7, 15, 17, 25 and 26. Its tap is
# (c / 3) mod 9, so those are taps 2, 2, 5, 5, 8 and 8, and with p = ky*3 + kx
# every one of them is kx = 2. Nine of the 32 channels are in that group and
# six of them are the only failures; the other 23 channels have none.
#
# And fc_imp, the SAME taps with no bias, is 32 of 32. So the bias is not the
# fault. It lifts the output clear of the ReLU clip, and the fault becomes
# visible where before it was clipped away.
#
# ⚠ It is NOT the right edge, which was the first thing that came to mind. With
# pad_left 0 and stride 2, kx = 2 reads input column 2*xout + 2, in range for
# 111 of the 112 output columns, and conv0's error covers all 112 rows and all
# 112 columns.
#
# So this round asks the column directly: three models, every channel's live
# tap in one kernel column, the real bias kept in all three.
#
# DECISION RULE, written before the run:
#   kx2 fails and kx0, kx1 pass     the third column is the fault, and the
#                                   weight buffer's third group at byte 8 of
#                                   each 16 byte unit is where to look
#   all three fail                  it is not the column; the association in
#                                   fc_impb was the bias values coinciding
#   all three pass                  a single column is fine and the fault needs
#                                   more than one live column at a time
#   the failing set is not by kx    read the new grouping off the channels
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
p() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== 1..3) one kernel column at a time, real bias in all three ====="
	p fc_kx0.tflite ""
	p fc_kx1.tflite ""
	p fc_kx2.tflite ""

	log ""
	log "===== 4) the mixed-tap model that started this ====="
	p fc_impb.tflite ""

	log ""
	log "===== 5) and the no-bias one, which is exact ====="
	p fc_imp.tflite ""

	log ""
	log "===== 6) conv0 itself ====="
	p mn_conv0.tflite ""

	log ""
	log "===== 7..9) REGRESSION ====="
	p conv2d-cal.tflite ""
	p mn_dw1.tflite ""
	p mn_dw25.tflite ""

	log ""
	log "===== Compare 1, 2 and 3. If only kx2 fails, the third group of   ====="
	log "===== each 16 byte weight unit is the place to look.              ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
