#!/bin/sh
# ---------------------------------------------------------------------------
# 2026-08-08 round 12. Round 11's control worked and could have failed:
#
#   conv2d-cal untouched          mean 145.72  md5 80e64aab  relu maxdiff 1
#   conv2d-cal, A forced 0x2000   mean 149.45  md5 cb4a71b8  relu maxdiff 17
#
# So ROCKET_ATEST reaches the hardware. And md003_80 at A=0x2000 and A=0x40000
# returned md5 f999f370e8b4 both times, identical to untouched, still a uniform
# 127. So the DPU does not read the coefficient buffer for a 1x1 conv either.
#
# The state for a 1x1 conv is now: the regcmd matches a vendor .rknn compiled at
# the same geometry, the weight layout matches the vendor's own compiled buffer,
# and the DPU runs, writes every byte of the output, and emits exactly
# out_offset while ignoring the weights, the input AND the A operand. Every
# payload and every comparable register is accounted for.
#
# So stop hunting and route around it. A 1x1 conv is exactly a 3x3 conv whose
# outer ring sits at the weight zero point: the MAC computes
# sum((in - 0x80) * (w - wt_zp)), so a tap with w == wt_zp contributes nothing,
# and that holds for the SAME padding taps at the border too. ROCKET_PW_AS_3X3
# synthesises that kernel and widens the geometry, so the op goes down the 3x3
# path that demonstrably works and every derived register follows.
#
#   md003_80 computes  -> the answer is right, most of MobileNet is pointwise,
#                         and the 1x1 path is narrowed to something specific
#   md003_80 still 127 -> even the working shape cannot carry these values, and
#                         the problem is not the kernel encoding at all
#
# ⚠ Step 2 is the control that can fail: conv2d-cal is 5x5, so the knob must not
# touch it. If its md5 moves, the rewrite is firing where it should not.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }

one() {
	m="$1"; mark="$2"; shift 2
	echo "SMARK-$mark" > /dev/kmsg 2>/dev/null
	env TEFLON_LIB=/usr/lib/libteflon.so "$@" \
		python3 "$NPU_DIR/test_dw.py" "$NPU_DIR/$m" > "$C" 2>&1
}

many() {
	m="$1"; n="$2"; mark="$3"; shift 3
	echo "SMARK-$mark" > /dev/kmsg 2>/dev/null
	env TEFLON_LIB=/usr/lib/libteflon.so "$@" \
		python3 "$NPU_DIR/test_model.py" "$NPU_DIR/$m" "$n" > "$C" 2>&1
	dmesg | sed -n "/SMARK-$mark/,\$p" | grep -a "job: task_count=" | head -2 > "$C" 2>&1
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	# -n 8 floods the serial console and wedges the box. Learned the hard way.
	dmesg -n 4 2>/dev/null

	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/job_log 2>/dev/null
	log ""
	log "  task_con16=$(cat /sys/module/rocket/parameters/task_con16 2>/dev/null)"

	log ""
	log "===== 1) CONTROL: conv2d-cal untouched ====="
	many conv2d-cal.tflite 2 cal-first

	log ""
	log "===== 2) CONTROL THAT CAN FAIL: conv2d-cal WITH the knob ====="
	log "  it is 5x5, so the rewrite must not touch it. md5 must not move."
	sleep 2
	one conv2d-cal.tflite cal-knob ROCKET_PW_AS_3X3=1

	log ""
	log "===== 3) md003_80 untouched: the uniform 127 reference ====="
	sleep 2
	one md003_80.tflite md003-plain

	log ""
	log "===== 4) THE TEST: md003_80 as a 3x3 with a zero point ring ====="
	sleep 2
	many md003_80.tflite 3 md003-3x3 ROCKET_PW_AS_3X3=1

	log ""
	log "===== 5) md003_oc128 as a 3x3, 128 output channels ====="
	sleep 2
	many md003_oc128.tflite 3 oc128-3x3 ROCKET_PW_AS_3X3=1

	log ""
	log "===== 6) mn_pw2, a real MobileNet pointwise layer, as a 3x3 ====="
	sleep 2
	many mn_pw2.tflite 3 pw2-3x3 ROCKET_PW_AS_3X3=1

	log ""
	log "===== 7) REPEAT CONTROL: conv2d-cal untouched ====="
	sleep 2
	many conv2d-cal.tflite 2 cal-last

	log ""
	log "===== Read 2 first: conv2d-cal must be unchanged by the knob.      ====="
	log "===== Then 4 against 3. jobs= and task_count matter here, the 3x3  ====="
	log "===== costs 9x the CBUF and may split where the 1x1 did not.       ====="
	sync
}

case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
