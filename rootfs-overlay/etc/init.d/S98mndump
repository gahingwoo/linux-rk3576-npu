# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-24 round 378. A CLEAN REGRESSION, AND THE OUTPUT FIXED.
#
# 🏁 ROUND 377: 14.86 tok/s at 64 tokens and 12.32 at 384, and the clause that
# could have failed did not. quantising x went 8.09 ms a token to 0.01 and the
# token went 75.0 to 67.0 -- the row lost 8.08 and the token lost 8.00, so the
# attribution was right. The two 64 token arms were byte identical.
#
#   r366  9.71   r369 11.62   r370 12.30   r372 12.95   r374 13.19   r377 14.86
#   = 2.32x the int8 baseline of 6.4, and 8.84 -> 12.32 at 384 tokens.
#
# ---------------------------------------------------------------------------
# ⚠ AND A REAL OUTPUT DEFECT, WHICH I INTRODUCED IN ROUND 374
# ---------------------------------------------------------------------------
#
# The 384 token arms print a bare "assistant" glued to the previous sentence,
# and repeat a paragraph four times. Two different things, and only one is a
# bug.
#
# THE BARE WORD IS MINE. Llama 3 writes a turn header as
# <|start_header_id|>assistant<|end_header_id|>, and the middle one is an
# ORDINARY TEXT token. Round 374 hid control tokens BY TYPE, which took the
# frame away and left the contents -- so from 374 the logs read as though the
# model had said the word. Before 374 the same text was there with its tags
# visible, which was ugly but honest. **Checked across the archive: the loop
# appears in r372 and r373 too, the first two long runs ever made. The bare
# word appears from r374 exactly.**
#
# THE LOOP IS --ignore-eos DOING WHAT IT SAYS. The model finishes, emits
# <|eot_id|>, the flag ignores it, and the natural continuation of a finished
# turn is a new turn -- which greedy decoding on an unchanged context fills
# with near-identical text. That is not a runtime fault; it is asking a
# six-token completion prompt for 384 tokens.
#
# THREE FIXES, AND THE FIRST TWO OF MINE WERE WRONG:
#
#   1. the whole header is suppressed, not just its markers.
#      ⚠ Suppressing until the close LATCHED: pushed past its own end this
#      model opens a header and NEVER CLOSES IT -- <|end_header_id|> appears
#      ZERO times in 384 tokens -- so the first version ate everything after.
#      ⚠ Giving up after a budget ate the budget.
#      ⚠ And holding the decoded POINTERS printed garbage, because
#      tokenizer_decode returns a reused per-thread buffer. It holds the BYTES.
#      A state machine over model output must assume the closing token never
#      comes, and must lose nothing when it does not.
#   2. the run now says where the model wanted to stop, so a log cannot read
#      as though it had lost the thread when it was pushed past its own end.
#   3. **the long arm gets a prompt that actually wants a long answer.** On the
#      host it runs all 384 tokens without reaching EOG at all, coherent
#      throughout. Asking "the capital of France is" for 384 was the real
#      mistake and it was mine, in round 372.
#
# ---------------------------------------------------------------------------
# THIS ROUND ADDS NO OPTIMISATION. It is a regression.
# ---------------------------------------------------------------------------
#
# ⚠ Arm 2 uses a DIFFERENT PROMPT, so its text is not comparable with any
# earlier 384 token arm. That is the point of changing it. Arm 1 is the
# standing anchor and must be exactly round 377's.
#
# HOW TO READ IT
#   * arm 1: the Louvre sentence, 14.86 tok/s, quantising x at 0.01
#   * arm 2: coherent English for all 384 tokens, NO "reached its own end"
#     line, and no bare "assistant" anywhere in the log
#   * arm 3: the exact arithmetic still reproduces its own sentence and lands
#     near 13.3 tok/s
#   * probe exact, anchor clean
#
# Anything outside the 0.8% band round 374's repeat established is a real
# change and this round changed no arithmetic.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
VD=/opt/charsiu/charsiu_vendor
V=/opt/charsiu/vendor
RGC=$V/vendor-int4-k2048-n1024.regcmd
WT=$V/vendor-wt-1M.bin
IN=$V/vendor-in.bin
RUN=/opt/charsiu/charsiu_run
M8=/opt/charsiu/models/Llama-3.2-1B-Instruct-Q8_0.gguf
PROMPT="The capital of France is"
LIMIT=420
# 32 tokens does not reach the answer to "17 times 24, show your working"
NGEN=64
CE=CHARSIU_COEF_ELEMS=65536
HEAD=CHARSIU_NPU_MAXN=131072
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block did not come back this time."
		ABORT=1
	fi
}

capped() {
	lim="$1"; shift
	"$@" &
	pid=$!
	i=0
	while [ "$i" -lt "$lim" ]; do
		kill -0 "$pid" 2>/dev/null || { wait "$pid"; return $?; }
		sleep 1
		i=$((i + 1))
	done
	kill -9 "$pid" 2>/dev/null
	wait "$pid" 2>/dev/null
	return 124
}
rung() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $1"; return 0; }
	lbl="$1"; shift
	before=$(nbad)
	log ""
	log "  -- $lbl"
	sleep 1
	capped "$LIMIT" env "$@" "$RUN" "$M8" -p "$PROMPT" -n "${NGEN:-32}" \
		--ignore-eos -q -c 512 -t 4 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the rung exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This rung is VOID."; health; }
	return 0
}
# arm: <label> <regcmd-or-dash> <byte> <high> [extra env, one assignment]
#
# ⚠ THE ENV GOES IN AS AN ARGUMENT, not as a "VAR=x arm ..." prefix. Whether an
# assignment before a FUNCTION call survives the call is unspecified -- dash
# drops it, other shells keep it -- and the arm whose whole job is to time out
# WITHOUT the trailer runs right after the one that has it. Not a question worth
# leaving to the shell.
arm() {
	before=$(nbad)
	log ""
	log "  ---- $1"
	sleep 1
	env ${5:-IGNORED=1} $VD "$2" "$WT" "$IN" "$3" "$4" 4096 > /tmp/vd.txt 2>&1
	cat /tmp/vd.txt > "$C"
	after=$(nbad)
	if [ "$after" != "$before" ]; then
		log "  !! POISONED: $((after - before)) new fault or timeout lines"
		health
		# ⚠ NOT a round abort. Round 342 threw away every arm after the
		# first poisoning and then measured the block healthy at the
		# end. The block recovers; give it a moment and carry on.
		ABORT=0
		sleep 2
	fi
}

# two concurrent probes, so the pair can be repeated without copy and paste
pair() {
	before=$(nbad)
	log ""
	log "  ---- $1"
	env CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_TIME=60 CHARSIU_OUT_KB=64 $2 $VD - "$WT" "$IN" 0 0 4096 > /tmp/vdA.txt 2>&1 &
	pidA=$!
	env CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_TIME=60 CHARSIU_OUT_KB=64 $3 $VD - "$WT" "$IN" 0 0 4096 > /tmp/vdB.txt 2>&1 &
	pidB=$!
	wait "$pidA"
	wait "$pidB"
	log "    A:"
	grep -E "M = |TIME:|baseline:|VERIFY:|CONTROL repeat|VOID|REREAD" /tmp/vdA.txt > "$C"
	log "    B:"
	grep -E "M = |TIME:|baseline:|VERIFY:|CONTROL repeat|VOID|REREAD" /tmp/vdB.txt > "$C"
	after=$(nbad)
	[ "$after" != "$before" ] && log "  !! POISONED: $((after - before)) new lines"
	return 0
}

BW=/opt/charsiu/charsiu_membw
DEC="CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 CHARSIU_NPU_W4V=1 CHARSIU_NPU_KMAX=1024 CHARSIU_NPU_W4_GROUP=1024"

# decode and a memory reader at the same time, both numbers kept
squeeze() {
	log ""
	log "  ---- $1"
	sleep 1
	env $DEC "$CE" "$HEAD" "$RUN" "$M8" -p "$PROMPT" -n 128 --ignore-eos \
		-q -c 512 -t 4 > /tmp/dec.txt 2>&1 &
	dpid=$!
	# past staging and into generation before the reader starts
	sleep "$2"
	if [ -n "$3" ]; then
		env CHARSIU_THREADS=4 CHARSIU_SECONDS="$3" $BW > /tmp/bw.txt 2>&1
	fi
	wait "$dpid"
	grep -E "tensors staged|gen 128|GB/s of weights|of that," /tmp/dec.txt > "$C"
	[ -n "$3" ] && cat /tmp/bw.txt > "$C"
	return 0
}

LONG="Write a long and detailed description of the Eiffel Tower: its history, its construction, and why people visit it."

start() {
	log ""
	log "###############################################################"
	log "##### round 378: a clean regression, and the output fixed   #####"
	log "###############################################################"
	log "  no optimisation in this round. nothing should move."

	B="CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 CHARSIU_NPU_W4V=1 CHARSIU_NPU_KMAX=1024 CHARSIU_NPU_W4_GROUP=1024 CHARSIU_STAGES=1"

	log ""
	log "===== 1) 64 tokens, the standing anchor                        ====="
	log "  the Louvre sentence, about 14.86 tok/s, quantising x 0.01."
	rung "int4 g1024, 64 tokens" $B "$CE" "$HEAD"

	log ""
	log "===== 2) 384 tokens, a prompt that WANTS a long answer         ====="
	log "  coherent all the way, no 'reached its own end' line, and"
	log "  no bare assistant anywhere. different prompt, so the text"
	log "  is NOT comparable with earlier 384 token arms."
	NGEN=384
	PROMPT="$LONG"
	rung "int4 g1024, 384 tokens, long prompt" $B "$CE" "$HEAD"
	NGEN=64
	PROMPT="The capital of France is"

	log ""
	log "===== 3) THE CONTROL: the exact arithmetic                     ====="
	rung "int4 g1024, EXACT_ATTN + EXACT_SILU" $B CHARSIU_EXACT_ATTN=1 CHARSIU_EXACT_SILU=1 "$CE" "$HEAD"

	log ""
	log "===== 4) the probe, still exact                                ====="
	arm "solo verify" "-" 0 0 "CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_VERIFY=1 CHARSIU_OUT_KB=64"

	log ""
	log "===== 5) the anchor: int8 conv must still be exact            ====="
	health

	log ""
	log "===== read the CONTROL lines first. VOID means the arm died. ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
