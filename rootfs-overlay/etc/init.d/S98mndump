# ---------------------------------------------------------------------------
# 2026-08-22 round 323. ONE FENCE FOR q, k AND v.
#
# ROUND 322 REFUTED THE PREDICTION THAT MATTERED, AND THE REFUTATION IS THE
# RESULT. N = 8192 DOES NOT WEDGE.
#
#     slices        287     192     144     128
#     hardware ms   146.1   141.2   141.0   1901
#     GB/s          8.46    8.75    8.76    0.65
#     tok/s         5.90    6.08    6.09    0.55   <- K=8192
#
# That is the shape round 313 needed a power cycle to escape, so **313's hang
# was the requantised byte output or the 67 MB coefficient buffer, not the
# width**. The limit is on K: K = 4096 works at every N up to 8192, and K = 8192
# collapses to 0.65 GB/s with 131 driver timeouts -- and COLLAPSES rather than
# hanging, with the text still correct and the block recovering afterwards.
#
# N = 8192, K = 4096 is the default now. 6.09 tokens a second against the best
# CPU path's 5.53, ahead by 10%.
#
# ⚠ AND MY OWN GUARD WAS BLIND TO IT. Thirteen times slower, 131 timeouts, 3718
# IOMMU errors, and nothing printed: the budget is 100 ms plus a millisecond a
# megabyte, which is 1 GB/s, and 0.65 sat just under it. "It stopped answering"
# and "it is thirteen times slower than it has ever been" are different things
# and a run has to say which. There is now a separate, non fatal notice for the
# second, because the answers in that rung were still correct.
#
# ---------------------------------------------------------------------------
# WHAT THIS ROUND CHANGES
# ---------------------------------------------------------------------------
#
# Round 321 measured the fence at 94% of the hardware path. A fence removed is
# therefore worth more than a submit removed, and 48 of them a token are removed
# for free: **q, k and v all multiply the same RMSNorm output, and so do gate and
# up**, so there is no reason to wait for one before starting the next.
#
# 113 fences a token becomes 65. The arithmetic is untouched.
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# 1) THE SUBMIT COUNT. Entry 2 must be about 65 a token where entry 3 is 113.
#    If it is not, the grouping did not engage and the rung is entry 3 twice.
#
# 2) THE TEXT, character for character against entry 4. Grouping changes WHEN
#    jobs are waited for and nothing else, so a difference means the three
#    outputs are landing on top of each other.
#
# 3) THEN the fence column, which is the whole point: 141 ms of hardware path is
#    about 119 ms of bytes at the bench's rate and about 22 ms of something else.
#    If that 22 falls with the fence count, it was per fence.
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT
# ---------------------------------------------------------------------------
#
# ABOUT 6.4 TOKENS A SECOND, if the 22 ms is 195 us a fence and 48 of them go.
# ⚠ Five of my timing predictions in a row have been wrong, and the one that was
# right last round was right for the wrong reason, so this is the thing being
# tested. The number to take away is the printed one.
#
# The honest floor: if the fence overhead is per BYTE rather than per fence,
# entry 2 equals entry 3 and the remaining 22 ms is simply the difference
# between this runtime's 8.76 GB/s and the bench's 10.35, which no amount of
# batching will touch.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
RUN=/opt/charsiu/charsiu_run
M8=/opt/charsiu/models/Llama-3.2-1B-Instruct-Q8_0.gguf
PROMPT="The capital of France is"
LIMIT=420
CE=CHARSIU_COEF_ELEMS=65536
HEAD=CHARSIU_NPU_MAXN=131072
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

capped() {
	lim="$1"; shift
	"$@" &
	pid=$!
	i=0
	while [ "$i" -lt "$lim" ]; do
		kill -0 "$pid" 2>/dev/null || { wait "$pid"; return $?; }
		sleep 1
		i=$((i + 1))
	done
	kill -9 "$pid" 2>/dev/null
	wait "$pid" 2>/dev/null
	return 124
}

rung() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $1"; return 0; }
	lbl="$1"; shift
	before=$(nbad)
	log ""
	log "  -- $lbl"
	sleep 1
	capped "$LIMIT" env "$@" "$RUN" "$M8" -p "$PROMPT" -n 32 \
		--ignore-eos -q -c 512 -t 4 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the rung exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This rung is VOID."; health; }
	return 0
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	[ -w /sys/module/rocket/parameters/reset_autosuspend ] && \
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend

	log ""
	log "===== 0) the limit's own control. expect rc 124 after ~3s.         ====="
	t0=$(cut -d. -f1 /proc/uptime)
	capped 3 sleep 60
	rc=$?
	t1=$(cut -d. -f1 /proc/uptime)
	log "  -- capped 3 sleep 60  ->  rc $rc after $((t1 - t0))s"
	[ "$rc" = "124" ] || log "  !! THE LIMIT DID NOT FIRE. Nothing below can be trusted to end."

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "##### ROUND 323: one fence for q, k and v. 113 becomes 65.        #####"

	log ""
	log "===== 2) THE ROUND. grouped: q,k,v in one submit, gate,up in one.  ====="
	rung "grouped" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 "$CE" "$HEAD"

	log ""
	log "===== 3) THE CONTROL. the same run, one projection at a time.      ====="
	log "=====    same boot, so this is a before and after.                 ====="
	rung "ungrouped" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 "$CE" "$HEAD" \
		CHARSIU_NPU_NOGROUP=1

	log ""
	log "===== 4) the CPU reference the text is diffed against              ====="
	rung "CPU, NPU number format" CHARSIU_NPU_QUANT=1

	log ""
	log "===== 5) and grouped again, to show it is not drift                ====="
	rung "grouped, repeat" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 "$CE" "$HEAD"

	log ""
	log "===== the anchor again                                             ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== submits a token, then the text, then the fence column.       ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
