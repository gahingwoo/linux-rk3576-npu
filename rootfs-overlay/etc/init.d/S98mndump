#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-23 round 357. WHICH REGISTERS CHANGE THE SPEED. NOBODY ASKED.
#
# 🔑 ROUND 356 LOCATED THE WHOLE OF THE REMAINING GAP, once the submit count
# was read correctly:
#
#   4550 submits, 6460 ms busy = 142 submitting + 5696 fence + 620 readback
#
# It adds up, so there is no hidden CPU cost. Per token, of 117 ms: **89 ms is
# the fence**, 9.7 readback, 2.2 submitting, 16 outside the NPU path.
#
# And 71 submits a token times 9.5 real MB is 620 MB -- **a token reads the
# whole model once**, which at int4's 6.7 GB/s is 92 ms. That IS the 89.
#
# ⇒ **THE DECODE IS WEIGHT BANDWIDTH BOUND AT THE MODEL LEVEL.** The earlier
# "MAC bound" reading came from a single job microbenchmark where the fixed
# submit cost dominates; in the LLM the tasks are chained and it amortises away.
# Both readings were of real data and only one of them describes the decode.
#
# So the question is now exactly one line:
#
#   ⚠ int8 fetches at 9.46 GB/s. int4 fetches at 6.7. WHY.
#
# ---------------------------------------------------------------------------
# THE THING NOBODY ASKED
# ---------------------------------------------------------------------------
#
# Round 345 bisected the vendor's twenty register values and asked **which of
# them change the ARITHMETIC**. The answer was CORE's three, and the other
# seventeen were set aside as "not the switch" -- which is true and was never
# the same question as **which of them change the SPEED**.
#
# Those seventeen are all fetch geometry:
#
#     0x103c  surf         charsiu 64        vendor 2048     <- a factor of 32
#     0x1044  CBUF_CON1    (1<<16)|64        (32<<16)|2048
#     0x1040  CBUF_CON0    10000000          differs
#     0x2810..0x2820       NEVER WRITTEN     five registers, the CBUF split
#
# ⚠ AND THE NATIVE int4 PATH WRITES NONE OF THEM. job.c sets the three CORE
# values and nothing else, so the five at 0x2810 and the CNA block have only
# ever run inside the probe's merge, never in the decode.
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# Entry 1 is charsiu's own stream and is the baseline. Entry 6 is int8 at the
# same shape and is the target: if int4 with the vendor's values lands near
# int8's us per MiB, the missing 30% is those registers and the decode goes from
# 8.5 tok/s to about 12.
#
# Entries 2 to 5 are the full merge and then CNA, the 0x2810 block and the DPU
# on their own. **Read us per submit, not GB/s** -- the tool's GB/s divides by
# the real int4 bytes now, but time is the thing that is not a derived quantity.
#
# Entry 7 verifies the merge still computes exactly. A faster stream that is
# wrong is not a result, and round 345 only ever checked correctness on the
# whole merge, not on each group alone.
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT
# ---------------------------------------------------------------------------
#
# CNA, and 0x103c inside it, because surf is a fetch stride and 64 against 2048
# is not a rounding difference. If the whole merge is no faster than entry 1
# then the deficit is in the layout itself -- sixteen channels and thirty-two k
# a block against int8's contiguous rows -- and the way out is a different
# packing, not a register.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
VD=/opt/charsiu/charsiu_vendor
V=/opt/charsiu/vendor
RGC=$V/vendor-int4-k2048-n1024.regcmd
WT=$V/vendor-wt-1M.bin
IN=$V/vendor-in.bin
RUN=/opt/charsiu/charsiu_run
M8=/opt/charsiu/models/Llama-3.2-1B-Instruct-Q8_0.gguf
PROMPT="The capital of France is"
LIMIT=420
# 32 tokens does not reach the answer to "17 times 24, show your working"
NGEN=64
CE=CHARSIU_COEF_ELEMS=65536
HEAD=CHARSIU_NPU_MAXN=131072
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block did not come back this time."
		ABORT=1
	fi
}

capped() {
	lim="$1"; shift
	"$@" &
	pid=$!
	i=0
	while [ "$i" -lt "$lim" ]; do
		kill -0 "$pid" 2>/dev/null || { wait "$pid"; return $?; }
		sleep 1
		i=$((i + 1))
	done
	kill -9 "$pid" 2>/dev/null
	wait "$pid" 2>/dev/null
	return 124
}
rung() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $1"; return 0; }
	lbl="$1"; shift
	before=$(nbad)
	log ""
	log "  -- $lbl"
	sleep 1
	capped "$LIMIT" env "$@" "$RUN" "$M8" -p "$PROMPT" -n "${NGEN:-32}" \
		--ignore-eos -q -c 512 -t 4 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the rung exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This rung is VOID."; health; }
	return 0
}
# arm: <label> <regcmd-or-dash> <byte> <high> [extra env, one assignment]
#
# ⚠ THE ENV GOES IN AS AN ARGUMENT, not as a "VAR=x arm ..." prefix. Whether an
# assignment before a FUNCTION call survives the call is unspecified -- dash
# drops it, other shells keep it -- and the arm whose whole job is to time out
# WITHOUT the trailer runs right after the one that has it. Not a question worth
# leaving to the shell.
arm() {
	before=$(nbad)
	log ""
	log "  ---- $1"
	sleep 1
	env ${5:-IGNORED=1} $VD "$2" "$WT" "$IN" "$3" "$4" 4096 > /tmp/vd.txt 2>&1
	cat /tmp/vd.txt > "$C"
	after=$(nbad)
	if [ "$after" != "$before" ]; then
		log "  !! POISONED: $((after - before)) new fault or timeout lines"
		health
		# ⚠ NOT a round abort. Round 342 threw away every arm after the
		# first poisoning and then measured the block healthy at the
		# end. The block recovers; give it a moment and carry on.
		ABORT=0
		sleep 2
	fi
}

start() {
	log ""
	log "###############################################################"
	log "##### round 357: which registers change the speed. nobody asked. #####"
	log "###############################################################"
	log "  int4 is byte exact and 1.42 to 1.78x faster. now decode with it."

	log ""
	log "===== 1) BASELINE: charsiu's own stream, int4, K2048 N1024    ====="
	arm "int4 native" "-" 0 0 "CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_TIME=200 CHARSIU_OUT_KB=64"

	log ""
	log "===== 2) the FULL merge: all twenty vendor values             ====="
	arm "int4 merge all" "+$RGC" 0 0 "CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_TIME=200 CHARSIU_OUT_KB=64"

	log ""
	log "===== 3) CNA only. 0x103c surf is 64 here and 2048 there.     ====="
	arm "int4 merge CNA" "+$RGC" 0 0 "CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_TIME=200 CHARSIU_OUT_KB=64 CHARSIU_MERGE_UNITS=1"

	log ""
	log "===== 4) the five at 0x2810, which nothing here ever writes    ====="
	arm "int4 merge 0x2810" "+$RGC" 0 0 "CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_TIME=200 CHARSIU_OUT_KB=64 CHARSIU_MERGE_UNITS=2"

	log ""
	log "===== 5) DPU only                                             ====="
	arm "int4 merge DPU" "+$RGC" 0 0 "CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_TIME=200 CHARSIU_OUT_KB=64 CHARSIU_MERGE_UNITS=4"

	log ""
	log "===== 6) THE TARGET: int8 at the same shape                   ====="
	arm "int8 native" "-" 0 0 "CHARSIU_M=1 CHARSIU_W8=1 CHARSIU_TIME=200 CHARSIU_OUT_KB=64"

	log ""
	log "===== 7) and the merge must still compute exactly              ====="
	arm "verify, merge" "+$RGC" 0 0 "CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_VERIFY=1 CHARSIU_OUT_KB=64"

	log ""
	log "===== 5) CONTROL: int8 on prompt 1. the standing sentence.    ====="
	PROMPT="The capital of France is"
	rung "int8, the standing number" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 "$CE" "$HEAD"

	log ""
	log "===== 6) the anchor: int8 conv must still be exact           ====="
	health

	log ""
	log "===== read the CONTROL lines first. VOID means the arm died. ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
