#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-11 round 56. Make the depthwise metric honest before believing it.
#
# Round 55 attributed round 54 cleanly and moved depthwise a long way:
#
#   mn_dw1    3/32 on the round 53 baseline  ->  9/32
#   mn_dw25   188/1024                       ->  432/1024
#
# and settled that the record COUNT is inert: 4, 8 and 16 records on mn_dw1,
# 128 against 256 on mn_dw25, all byte identical, even though each moves the
# fp16 table and the 0x5024 operand with it. What is load bearing is the 48
# byte record stride and the weight buffer's zero point lane.
#
# ⚠ Then the offline read of WHICH channels matched came back suspicious.
# Sorted by |A| the nine matching channels on mn_dw1 are the nine largest,
# every one of them, and A is added to the MAC before the requant. An A large
# enough saturates the whole surface to one value, and if the CPU reference
# saturates too then the channel scores a match without one multiply having to
# be right. mn_dw1 reported 8 constant channels and 5 pinned at the zero point,
# which is the same order as the 9 it called correct.
#
# That is the proxy trap this project has been caught by before, so the count
# gets split before another hypothesis is built on it. perch.py now reports
# COMPUTED, meaning the channel matches AND the reference varies across it, and
# trivial, meaning it matches a reference that is constant. Only the first is
# evidence of arithmetic.
#
# Nothing in the driver changed this round. Same libteflon.so, same everything;
# only the measurement.
#
# DECISION RULE, written before the run:
#   COMPUTED stays near 9 and 432   the gains are real and the next round goes
#                                   after the remaining channels
#   COMPUTED collapses to near 0    round 55's numbers were saturation, the
#                                   real state is much worse than reported, and
#                                   every conclusion drawn from the channel
#                                   count has to be re-read
#   COMPUTED on the baseline (4)    tells the same for the round 53 numbers, so
#                                   the comparison stays valid either way
#   regular shapes unchanged        they were 128/128 before and must still be,
#                                   with COMPUTED equal to the match count
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
p() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== 1..2) mn_dw1: shipped, then the round 53 baseline ====="
	p mn_dw1.tflite ""
	p mn_dw1.tflite "ROCKET_DW_REC64=1 ROCKET_DW_ZP_POS=1"

	log ""
	log "===== 3..4) mn_dw25: shipped, then the round 53 baseline ====="
	p mn_dw25.tflite ""
	p mn_dw25.tflite "ROCKET_DW_REC64=1 ROCKET_DW_ZP_POS=1"

	log ""
	log "===== 5) mn_dw1 with the zero point lane sign alone reverted ====="
	p mn_dw1.tflite ROCKET_DW_ZP_POS=1

	log ""
	log "===== 6..8) REGULAR shapes: COMPUTED must equal the match count ====="
	p conv2d-cal.tflite ""
	p cal_k3.tflite ""
	p cal_oc16.tflite ""

	log ""
	log "===== 9) whole model, for the record ====="
	sleep 2
	env TEFLON_LIB=/usr/lib/libteflon.so \
		python3 "$NPU_DIR/test_model.py" "$NPU_DIR/conv2d-cal.tflite" 2 > "$C" 2>&1

	log ""
	log "===== Read the COMPUTED line, not the match count. A channel whose ====="
	log "===== reference is constant can be matched by a saturated output.  ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
