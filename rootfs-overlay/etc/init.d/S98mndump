# ---------------------------------------------------------------------------
# 2026-08-09 round 40. Sweep the word on the models that still fail.
#
# Round 39, both baselines 128/128:
#   mn_pw2   64/64      real pointwise, ic 32 -> oc 64, NOW WORKS
#   md003    16/16      NOW WORKS
#   mn_pw24  297/1024   partial, oc = 1024
#   mn_dw1   3/32       partial, depthwise
#   dwconv   0/16       depthwise
#   mn_conv0 0/32       first conv, the 4-channel ARGB path
#   conv2x   0/16       chained
#   mn_conv0dw1 1/32    chained
#   MobileNet v1        FAIL, top1 0 against 754
#   md011               NO OUTPUT AT ALL, header printed and nothing after
#
# Partial per-channel results are new. Everything used to be all or nothing, so
# 297 of 1024 and 3 of 32 are signal, not noise.
#
# 0x1004 was fitted on conv2d-cal, which has oc=128. There is no reason the same
# word is right for a depthwise layer, for a 4 channel first conv, or for oc =
# 1024, and the way to find out is the sweep that already worked once. The words
# below are all known-good on conv2d-cal, so if one of them fixes dwconv the
# requirement is not a single constant but something the driver has to compute.
#
# DECISION RULE, written before the run:
#   some word fixes dwconv        depthwise was the same bug with a different
#                                 required word; find what it depends on
#   no word changes dwconv at all depthwise has a genuinely separate cause, and
#                                 the coefficient word is settled for it
#   dwconv changes but never
#     reaches 16/16               the word matters AND something else is wrong
#   a word improves mn_pw24       the count is a function of the word, so the
#                                 region is bigger than one word at oc=1024
#   the old float surface beats
#     the constant anywhere        say so plainly, it would mean the constant is
#                                 not a strict improvement
#   step 1 or 14 not 128/128      the build is wrong, stop
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
sweep() {
	m="$1"
	log ""
	log "===== $m: default 0x1004, then other known-good words ====="
	for v in "" 0x3fc4 0x1044 0x2044 0xff44 0x0fc4; do
		if [ -z "$v" ]; then lbl="default"; else lbl="$v"; fi
		log "  -- $m  FS_F0=$lbl"
		sleep 1
		if [ -z "$v" ]; then
			env TEFLON_LIB=/usr/lib/libteflon.so \
				python3 "$NPU_DIR/perch.py" "$NPU_DIR/$m" > "$C" 2>&1
		else
			env TEFLON_LIB=/usr/lib/libteflon.so ROCKET_FS_KEEP=4 \
				ROCKET_FS_F0="$v" \
				python3 "$NPU_DIR/perch.py" "$NPU_DIR/$m" > "$C" 2>&1
		fi
	done
	log "  -- $m  the OLD float surface, for contrast"
	sleep 1
	env TEFLON_LIB=/usr/lib/libteflon.so ROCKET_FS_FLOATS=1 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$m" > "$C" 2>&1
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== 1) BASELINE: conv2d-cal, must be 128/128 ====="
	env TEFLON_LIB=/usr/lib/libteflon.so \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > "$C" 2>&1

	sweep dwconv.tflite
	sweep conv2x.tflite
	sweep mn_pw24.tflite

	log ""
	log "===== md011, which printed nothing last round ====="
	sleep 2
	env TEFLON_LIB=/usr/lib/libteflon.so \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/md011.tflite" > "$C" 2>&1
	log "  (if this is silent again it is the script or the model, not the NPU)"

	log ""
	log "===== 14) CONTROL that can fail: conv2d-cal again ====="
	sleep 2
	env TEFLON_LIB=/usr/lib/libteflon.so \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > "$C" 2>&1

	log ""
	log "===== Read 1 and 14 first. Then: does ANY word move dwconv off   ====="
	log "===== 0/16? That is the whole question of this round.             ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
