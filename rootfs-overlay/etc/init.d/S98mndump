# ---------------------------------------------------------------------------
# 2026-08-12 round 104. Name the first broken operator.
#
# Round 103's ladder walked MobileNet itself, output moved to each layer by a
# four byte patch of the subgraph's output index. Its two controls held: L00
# reproduced mn_conv0's file exactly and L01 reproduced mn_conv0dw1's exactly,
# so the patch is what it claims to be.
#
# Then the whole chain was simulated offline with the hardware's own
# arithmetic on one side and tflite's on the other, and the two agree layer by
# layer until they suddenly do not:
#
#   op0 conv0  3->32   s2   model 32/32  md 1     board 32/32  md 1
#   op1 dw     32      s1   model 28/32  md 3     board 28/32  md 3
#   op2 pw     32->64  s1   model 22/64  md 6     board 22/64  md 6
#   op4 pw     64->128 s1   model 18/128 md 14    board  1/128 md 255
#   op6 pw    128->128 s1   model  4/128 md 23    board  0/128 md 255
#   op8 pw    128->256 s1   model 34/256 md  7    board  0/256 md 255
#
# So through op2 the hardware is EXACTLY what correct hardware produces. The
# rising maxdiff there is the tflite reference artifact compounding through the
# chain, not a defect, and mn_pw24's 297 of 1024 is downstream of the same
# thing rather than a target of its own.
#
# The first real divergence is op3 or op4, and op3 is the interesting one: a
# DEPTHWISE at stride 2. Everything depthwise that has ever been verified here
# is stride 1, mn_dw1 and mn_dw25 both. A stride 2 SAME layer, 112 to 56, pads
# before 0 and after 1, which is the asymmetric trailing padding that round 98
# found the hardware feeds a raw zero on the first conv path. The generic path
# has never once been asked for it: conv2d-cal, mn_dw1 and mn_dw25 are all
# stride 1 with symmetric padding.
#
# L03, L05 and L07 are new probes so the ladder has no gaps from op0 to op8.
#
# DECISION RULE, written before the run, with the model's number for each:
#   op    model      if the board matches      if the board is far below
#   L03   21/64  md13   op3 is correct, and op4 is the first defect
#   L04   18/128 md14   op4 correct too, and the cliff is later
#   L05    9/128 md13
#   L06    4/128 md23
#   L07    7/128 md10
#   L08   34/256 md 7
#
# The first L whose board number falls far below its model number is the
# operator to fix, and its kind, stride and channel counts name the case. L00,
# L01 and L02 are the control: all three matched their model last round and
# must do so again, or this build moved something and nothing here can be read.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
p() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== 1..3) CONTROL: must reproduce 32/32 md1, 28/32 md3, 22/64 md6 ====="
	p mn_L00.tflite ""
	p mn_L01.tflite ""
	p mn_L02.tflite ""

	log ""
	log "===== 4) op3, DEPTHWISE AT STRIDE 2. Model says 21/64 maxdiff 13 ====="
	p mn_L03.tflite ""

	log ""
	log "===== 5) op4, pw 64->128.  Model says 18/128 maxdiff 14 ====="
	p mn_L04.tflite ""

	log ""
	log "===== 6) op5, dw 128 s1.   Model says 9/128 maxdiff 13 ====="
	p mn_L05.tflite ""

	log ""
	log "===== 7) op6, pw 128->128. Model says 4/128 maxdiff 23 ====="
	p mn_L06.tflite ""

	log ""
	log "===== 8) op7, dw 128 s2.   Model says 7/128 maxdiff 10 ====="
	p mn_L07.tflite ""

	log ""
	log "===== 9) op8, pw 128->256. Model says 34/256 maxdiff 7 ====="
	p mn_L08.tflite ""

	log ""
	log "===== 10..11) REGRESSION ====="
	p conv2d-cal.tflite ""
	p mn_dw1.tflite ""

	log ""
	log "===== The first L far below its model number is the operator.     ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
