#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-23 round 339. THE BIT THAT TURNED int4 INTO A LOGARITHM.
#
# ROUND 338 CONFIRMED THE BAD NEWS AND THEN NAMED THE CAUSE.
#
# The control did exactly what it had to: with today's packing the old
# reference scores 64 of 64 and the plain weighted sum scores 0 of 64. So the
# hardware really is not computing a weighted sum, and everything int4 has been
# signed off on since round 265 was exact against a nonlinear reference.
#
# Then a real half in the slot scored ZERO against both references, and fitting
# candidate arithmetics to the measured numbers found the one that matches at
# r = 1.0000:
#
#     out = sum over k of ( fp16bits(w) * fp16bits(a) ) >> 16
#
#     npu      -15034  61030  37592 103264  41052  36342   7792 -18048
#     f16xf16  -15211  61267  37592 103037  40854  36225   7990 -17866
#
# **The DPU multiplies the two sixteen bit slots as INTEGER BIT PATTERNS.** And
# since fp16bits(x) is about 1024*(15 + log2 x), that is a multiply in the LOG
# domain. Whatever goes in the activation slot, the weight side can only ever be
# 0 or the band 1.00 to 1.18, so no weighted sum is reachable down this path.
#
# ---------------------------------------------------------------------------
# AND THE ONE REGISTER THAT PUTS IT THERE
# ---------------------------------------------------------------------------
#
# The 117 register diff against the vendor's own int4 op left five differences,
# and the first is the one that matters:
#
#     CNA 0x100c   vendor 00600120   charsiu 20600120
#
# ⚠**Bit 29 is SIXTEEN BIT ACTIVATIONS, charsiu sets it and the vendor does
# not.** charsiu sets it because charsiu_effective_adtype returns FP16 for int4
# to get an atom of 8, which is a LAYOUT decision that silently changed the
# ARITHMETIC mode: in the sixteen bit mode the weight goes through an fp16
# conversion, which is where fp16bits comes from.
#
# Clear it and the same nibble should meet an int8 activation in an integer
# multiply, which is a weighted sum. The code already has the hatch:
# CHARSIU_A8_STRIDE1 makes effective_adtype return the real type.
#
# ⚠ Round 329 did try 0x100c and got zero, but with the OLD packing and before
# the pair was known. Nothing has been tried since the packing was right.
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# THE PLAIN WEIGHTED SUM LINE IS THE WHOLE ROUND, and entry 2 is the control
# that must still show the old behaviour. If any arm in entry 3 prints n of n
# on the plain sum, int4 becomes a matmul and everything measured about the
# layout, the pair and the speed applies to it at once.
#
# ⚠ CORE 0x3018 is in there too, the other untested difference, because it has
# never been run with the packing right either.
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT
# ---------------------------------------------------------------------------
#
# Bit 29 is it. The arithmetic's shape, the vendor clearing it, and charsiu
# setting it for a reason that has nothing to do with arithmetic all point one
# way. ⚠ Seven wrong predictions on int4 says discount it; the difference is
# that this one came from fitting the measured numbers rather than from a story
# about them.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
RUN=/opt/charsiu/charsiu_run
BE=/opt/charsiu/charsiu_bench
MM=/opt/charsiu/charsiu_matmul
I4=/opt/charsiu/charsiu_int4
M4="CHARSIU_W4=1 CHARSIU_W4_HALFK=1"
M8=/opt/charsiu/models/Llama-3.2-1B-Instruct-Q8_0.gguf
PROMPT="The capital of France is"
LIMIT=420
ARMCAP=240
CE=CHARSIU_COEF_ELEMS=65536
HEAD=CHARSIU_NPU_MAXN=131072
B8="CHARSIU_OVERRIDE=0x40b8=3"
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

# Igor's scorer, not ours: it compares against the RAW cpu output and prints
# the constant-reference-channel guard on every model.
ocp() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $1"; return 0; }
	before=$(nbad)
	log ""
	log "  -- $1"
	sleep 1
	capped "$ARMCAP" env TEFLON_LIB=$WORK python3 "$NPU_DIR/oc_perch.py" \
		"$NPU_DIR/$1" > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the arm exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This arm is VOID."; health; }
	return 0
}

capped() {
	lim="$1"; shift
	"$@" &
	pid=$!
	i=0
	while [ "$i" -lt "$lim" ]; do
		kill -0 "$pid" 2>/dev/null || { wait "$pid"; return $?; }
		sleep 1
		i=$((i + 1))
	done
	kill -9 "$pid" 2>/dev/null
	wait "$pid" 2>/dev/null
	return 124
}

c() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $*"; return 0; }
	before=$(nbad)
	sleep 1
	capped "$ARMCAP" env $1 $2 $3 $4 $5 $6 $7 $8 $9 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the arm exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This arm is VOID."; health; }
	return 0
}

rung() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $1"; return 0; }
	lbl="$1"; shift
	before=$(nbad)
	log ""
	log "  -- $lbl"
	sleep 1
	capped "$LIMIT" env "$@" "$RUN" "$M8" -p "$PROMPT" -n 32 \
		--ignore-eos -q -c 512 -t 4 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the rung exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This rung is VOID."; health; }
	return 0
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	[ -w /sys/module/rocket/parameters/reset_autosuspend ] && \
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend

	log ""
	log "===== 0) the limit's own control. expect rc 124 after ~3s.         ====="
	t0=$(cut -d. -f1 /proc/uptime)
	capped 3 sleep 60
	rc=$?
	t1=$(cut -d. -f1 /proc/uptime)
	log "  -- capped 3 sleep 60  ->  rc $rc after $((t1 - t0))s"
	[ "$rc" = "124" ] || log "  !! THE LIMIT DID NOT FIRE. Nothing below can be trusted to end."

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "##### ROUND 339: the bit that turned int4 into a logarithm        #####"

	log ""
	log "===== 2) THE MEASUREMENT. every stage of the forward pass, NPU on. ====="
	log "=====    matmul stages minus the hardware path = the quantise.     ====="
	rung "the decode loop on the NPU, stages on" \
		CHARSIU_STAGES=1 CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 "$CE" "$HEAD"

	log ""
	log "===== 2b) the same stages with the NPU off, one boot apart.        ====="
	rung "the CPU path, stages on" CHARSIU_STAGES=1 CHARSIU_NPU_QUANT=1

	log ""
	log "===== 2) CONTROL: as it is today. old reference 64, plain sum 0.   ====="
	c "CHARSIU_W4=1 CHARSIU_W4_PAIRED=1" "$CE" $MM 1 64 64

	log ""
	log "===== 3) THE ROUND: clear bit 29, an int8 activation, real multiply ====="
	log "===== 3a via the emitter's own hatch"
	c "CHARSIU_W4=1 CHARSIU_W4_PAIRED=1 CHARSIU_A8_STRIDE1=1" "$CE" $MM 1 64 64
	log "===== 3b by forcing the register instead"
	c "CHARSIU_W4=1 CHARSIU_W4_PAIRED=1" "CHARSIU_OVERRIDE=0x100c=0x00600120" "$CE" $MM 1 64 64
	log "===== 3c both"
	c "CHARSIU_W4=1 CHARSIU_W4_PAIRED=1 CHARSIU_A8_STRIDE1=1" "CHARSIU_OVERRIDE=0x100c=0x00600120" "$CE" $MM 1 64 64
	log "===== 3d and with the vendor's CORE 0x3018 on top"
	c "CHARSIU_W4=1 CHARSIU_W4_PAIRED=1 CHARSIU_A8_STRIDE1=1" "CHARSIU_OVERRIDE=0x100c=0x00600120,0x3018=0x10000200" "$CE" $MM 1 64 64
	log "===== 3e whichever it is, at a bigger shape"
	c "CHARSIU_W4=1 CHARSIU_W4_PAIRED=1 CHARSIU_A8_STRIDE1=1" "CHARSIU_OVERRIDE=0x100c=0x00600120" "$CE" $MM 1 2048 256

	log ""
	log "===== 5) the standing number, no timers, so they cannot be blamed  ====="
	rung "the decode loop on the NPU" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 "$CE" "$HEAD"

	log ""
	log "===== the anchor again                                             ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== the PLAIN WEIGHTED SUM line is the round.                     ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
