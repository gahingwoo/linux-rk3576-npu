# ---------------------------------------------------------------------------
# 2026-08-09 round 42. The coefficient region is closed. Go at depthwise, with
# a difference found offline.
#
# Round 41 closed the region. mn_pw24 is 297 of 1024 for EVERY fill count, 1, 2,
# 8, 32, 128, 512, 1024 and the whole region, so the region is not copies of the
# word and the constant cannot be pushed further there. Filling is harmless:
# conv2d-cal 128/128, cal_k3 128/128, mn_pw2 64/64 with the whole thing filled.
# And dwconv and conv2x are unmoved by any of it, as in round 40.
#
# So the region is characterised, fixed, and is not the cause of what remains.
#
# Depthwise next, and the first concrete lead came for free on the host.
# Comparing a vendor .rknn compiled depthwise against one compiled as a regular
# conv, 41 registers differ, most of them geometry. Two are not:
#
#   0x1018   vendor depthwise 0x40000505     regular 0x40000404
#   0x1040   vendor depthwise 0x14000000     regular 0x10000000
#
# and those are exactly the values rkt_regcmd.c selects on `split`. A depthwise
# layer that is not split gets the regular values from mesa and the split ones
# from the vendor. ROCKET_DW_SPLITVALS makes depthwise take them.
#
# DECISION RULE, written before the run:
#   dwconv moves off 0/16       the lead is real; then find whether it is one
#                               register or both, steps 4 and 5 say which
#   dwconv unchanged            these two registers are not it, and the offline
#                               diff has 39 more rows to work through
#   mn_dw1 improves but dwconv
#     does not                  the two depthwise models differ in something
#                               else and that difference is the next question
#   a regular conv regresses    the knob is leaking outside depthwise, which
#                               would be a bug in the knob, not a finding
#   step 1 or 8 not 128/128     the build is wrong, stop
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
p() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== 1) BASELINE: conv2d-cal, must be 128/128 ====="
	p conv2d-cal.tflite ""

	log ""
	log "===== 2..3) depthwise as it is now ====="
	p dwconv.tflite ""
	p mn_dw1.tflite ""

	log ""
	log "===== 4..5) THE TEST: depthwise takes the split values ====="
	p dwconv.tflite ROCKET_DW_SPLITVALS=1
	p mn_dw1.tflite ROCKET_DW_SPLITVALS=1

	log ""
	log "===== 6) and the chained model that contains a depthwise ====="
	p mn_conv0dw1.tflite ROCKET_DW_SPLITVALS=1

	log ""
	log "===== 7) the knob must NOT touch a regular conv ====="
	p conv2d-cal.tflite ROCKET_DW_SPLITVALS=1
	p cal_k3.tflite ROCKET_DW_SPLITVALS=1

	log ""
	log "===== 8) CONTROL that can fail: conv2d-cal plain again ====="
	p conv2d-cal.tflite ""

	log ""
	log "===== Read 1 and 8 first. Then 2 against 4: does dwconv move at   ====="
	log "===== all? Anything other than 0/16 is the first movement there.  ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
