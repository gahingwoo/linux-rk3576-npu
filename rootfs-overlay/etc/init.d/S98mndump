#!/bin/sh
# ---------------------------------------------------------------------------
# 2026-08-08 round 9. Round 8's headline result is real but its control was not,
# and there is a gap in the reasoning that led to it.
#
# ROUND 8: md003_80 plain, with every pointwise weight forced to 0x7f, and with
# the input zero point term dropped from A, all three gave BYTE IDENTICAL output
# (raw 116, relu 71, top1 0, stale). So the weights do not reach the MAC and the
# A term is not what pins the output.
#
# ⚠ BUT THE CONTROL WAS WORTHLESS. It used where.py, which counts NONZERO bytes.
# 0x7f is nonzero and so is nearly every real weight, so a forced buffer and a
# real one both read 100 percent. It could not tell whether the knob fired. That
# is the exact failure this project has a rule against, and I wrote the rule
# into the script and then broke it in the next line. bstat.py reports DISTINCT,
# which does discriminate, and step 4 dumps the buffer BOTH ways.
#
# ⚠ AND A GAP: 0x1018 and 0x1040 were called inert on the strength of mn_pw24,
# which has 512 input channels and 7x7 spatial. md003_80 has never been run with
# them at the vendor value at all, and for md003_80 mesa emits 0x40000505 and
# 0x14000000 where the vendor .rknn at that geometry has 0x40000404 and
# 0x10000000. It is one task, so ROCKET_CBUF_DERIVE=1 gives it the vendor pair.
# Closing that on this model costs one step.
#
# So: step 3 closes the gap, step 4 makes the round 8 null result trustworthy or
# throws it away.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }

run() {
	m="$1"; n="$2"; mark="$3"; shift 3
	echo "SMARK-$mark" > /dev/kmsg 2>/dev/null
	env TEFLON_LIB=/usr/lib/libteflon.so "$@" \
		python3 "$NPU_DIR/test_model.py" "$NPU_DIR/$m" "$n" > "$C" 2>&1
	dmesg | sed -n "/SMARK-$mark/,\$p" | grep -a "job: task_count=" | head -2 > "$C" 2>&1
}

# Dump one model's buffers into a named directory.
dump() {
	d="/tmp/$1"; shift
	rm -rf "$d"; mkdir -p "$d"; cd "$d" || return 0
	env TEFLON_LIB=/usr/lib/libteflon.so ROCKET_DEBUG=dump_bos "$@" \
		python3 "$NPU_DIR/test_dw.py" "$NPU_DIR/md003_80.tflite" > /dev/null 2>&1
	cd / || return 0
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	# -n 8 floods the serial console and wedges the box. Learned the hard way.
	dmesg -n 4 2>/dev/null

	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/job_log 2>/dev/null
	log ""
	log "  task_con16=$(cat /sys/module/rocket/parameters/task_con16 2>/dev/null)"

	log ""
	log "===== 1) CONTROL: conv2d-cal ====="
	run conv2d-cal.tflite 2 cal-first

	log ""
	log "===== 2) md003_80 plain, the reference numbers ====="
	sleep 2
	run md003_80.tflite 3 md003-plain

	log ""
	log "===== 3) md003_80 with ROCKET_CBUF_DERIVE=1 ====="
	log "  gives it the vendor's 0x40000404 and 0x10000000. Never tried on"
	log "  THIS model; the inert verdict came from a very different one."
	sleep 2
	run md003_80.tflite 3 md003-cbuf ROCKET_CBUF_DERIVE=1

	log ""
	log "===== 4) DOES THE KNOB FIRE? weight buffer, plain vs forced ====="
	log "  distinct must be many for plain and exactly 1 for forced."
	log "  Round 8 used where.py here, which counts nonzero, and proved nothing."
	sleep 2
	dump wplain
	dump wforce ROCKET_PW_WTEST=1
	log "  plain:"
	for f in /tmp/wplain/mesa-weights-*.bin; do
		[ -f "$f" ] && python3 "$NPU_DIR/bstat.py" "$f" > "$C" 2>&1
	done
	log "  forced 0x7f:"
	for f in /tmp/wforce/mesa-weights-*.bin; do
		[ -f "$f" ] && python3 "$NPU_DIR/bstat.py" "$f" > "$C" 2>&1
	done

	log ""
	log "===== 5) md003_80 forced weights, both knobs on ====="
	log "  if 3 changes anything, the weight test has to be redone on top of it"
	sleep 2
	run md003_80.tflite 3 md003-both ROCKET_CBUF_DERIVE=1 ROCKET_PW_WTEST=1

	log ""
	log "===== 6) REPEAT CONTROL: conv2d-cal ====="
	sleep 2
	run conv2d-cal.tflite 2 cal-last

	log ""
	log "===== Read 4 FIRST. If forced is not distinct=1 the knob never fired ====="
	log "===== and round 8's weight result is void. Then 2 against 3.        ====="
	sync
}

case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
