# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-21 round 289. M has been 1 in every matmul this project has ever run.
#
# ⚠⚠ 288 CLOSED THE LAYOUT. Eleven geometries exact in one boot, no override:
#
#   N = 16 24 32 40 48 56 64 72 80 88 at K = 64,  and N = 64 at K = 32
#   control 0 of 64, int8 64 of 64
#
# N = 80 and N = 88 are the ones that matter. They are G = 10 and G = 11,
# neither swept, both PREDICTED outright by the slot form, and both came back
# exact. Their --map grids, taken in the same boot, reproduce all 21 predicted
# bases to the byte.
#
# That is the difference between this form and the two before it. wbytes/4 in
# 284 and "the last block takes the odd slots" in 286 were each fitted to one
# point and each died in the round after they were written. This one was written
# from eight tables and then predicted two more before they were measured.
#
# ⚠ AND M HAS ALWAYS BEEN 1. Every matmul in this project, int4 and int8 alike,
# has run one row. The only M that was ever varied is the write extent probe in
# 272 and 273, which read wrote = M * (N/2 + 8) at M of 1, 2 and 4 and never
# checked a single value.
#
# THAT ALSO MEANS THE int4 READER HAS NEVER BEEN RIGHT ABOUT M. The output
# surface is [n/atom][m][n%atom], which at M = 1 collapses to n, so a row major
# read is accidentally correct there and wrong everywhere else. The int8 path has
# read the surface since round 199. Fixed, which is a change to how the result is
# READ and touches no register, no packing and no buffer.
#
# THE READING RULE, fixed before the run.
#
#   ⚠ ENTRIES 5 TO 7 ARE THE ROUND. M = 2, 4 and 8 at N = 64.
#
#     exact                the layout, the arithmetic and the surface reading all
#                          generalise in M, and int4 is a matmul rather than a
#                          matrix vector product
#     row 0 exact, the rest not
#                          the reading or the input packing is wrong in M and the
#                          weights are fine, since row 0 does not depend on either
#     nothing exact        the surface reading change broke M = 1 too, which
#                          entries 2 to 4 will say first
#
#   ⚠ ENTRIES 2 TO 4 COME FIRST FOR THAT REASON. M = 1 at three N, to separate a
#   reader regression from an M result before reading anything below it.
#
#   ENTRIES 8 AND 9 ask a different question that has also never been asked: an N
#   that is NOT a multiple of 8. Every N ever run here is, so the group count has
#   always been exact and a partial last group has never existed. N = 20 and
#   N = 36. The packer places by n/8 and n%8 and does not special case a short
#   group, so if these fail the interesting part is WHICH channels.
#
#   ENTRY 10 is the control that must FAIL and ENTRY 11 is int8, which also gets
#   an M = 4 arm since it has read the surface all along and should not care.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
MM=/opt/charsiu/charsiu_matmul
CH=/opt/charsiu/charsiu_int4
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

c() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $*"; return 0; }
	before=$(nbad)
	sleep 1
	env $1 $2 $3 $4 $5 $6 $7 $8 $9 > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This arm is VOID."; health; }
	return 0
}

M4="CHARSIU_W4=1 CHARSIU_W4_HALFK=1"

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	if [ -w /sys/module/rocket/parameters/reset_autosuspend ]; then
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend
		log "reset_autosuspend = $(cat /sys/module/rocket/parameters/reset_autosuspend)"
	else
		log "!! reset_autosuspend NOT WRITABLE. A timeout will kill the round."
	fi

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "##### M = 1 first, so a reader regression cannot be read as an M    ####"
	for nn in 16 64 88
	do
		log ""
		log "===== M = 1  N = $nn"
		c "$M4" X=1 $MM 1 64 $nn
	done

	log ""
	log "##### THE ROUND. M has never been anything but 1.                  #####"
	for mm in 2 4 8
	do
		log ""
		log "===== M = $mm  N = 64"
		c "$M4" X=1 $MM $mm 64 64
	done
	log ""
	log "===== M = 4  N = 24, a second shape                                ====="
	c "$M4" X=1 $MM 4 64 24

	log ""
	log "##### an N that is not a multiple of 8. Never tried.               #####"
	log ""
	log "===== N = 20                                                       ====="
	c "$M4" X=1 $MM 1 64 20
	log ""
	log "===== N = 36                                                       ====="
	c "$M4" X=1 $MM 1 64 36

	log ""
	log "===== the control that must FAIL, and int8 at M = 1 and M = 4      ====="
	c "CHARSIU_W4=1" X=1 $MM 1 64 64
	c X=1 X=1 $MM 1 64 64
	c X=1 X=1 $MM 4 64 64

	log ""
	log "===== the anchor again                                             ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== M = 1 must hold before any M > 1 line is worth reading.      ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
