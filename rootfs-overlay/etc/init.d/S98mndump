# ---------------------------------------------------------------------------
# 2026-08-20 round 273. k is solved. Make the activation count, and find the
# halving in a mode where it might now be visible.
#
# ⚠ THE k SHORTFALL IS FIXED, by CONV_CON1 PROC_PRECISION = 0. The full sweep
# under it closes:
#
#      0- 127: w0..w7      512- 639: w0..w7  k+32      1024-1151: w16..w23
#    128- 255: dark        640- 767: dark              1280-1407: w24..w31
#    256- 383: w8..w15     768- 895: w8..w15 k+32      1408-1535: w32..w39
#    384- 511: dark        896-1023: dark              1536-2047: the k+32 half
#
# Four groups of eight bytes a channel, 32 bytes, 64 nibbles, 64 k. 0x1020 says
# 32 bytes a kernel and 32 is now what gets fetched. The dark 768 bytes are
# EXACTLY 24 channels times 32, so the buffer is the right size and 24 channels'
# worth is simply never read. What is left is only the channel count.
#
# ⚠ AND I OWE A CORRECTION. 272's script said the output formula in charsiu's
# README "has no standing" under the new mode. Wrong, and backwards. The formula
# reproduces the SHIPPED column exactly, seven for seven, once the activation is
# read as the raw 16 bit slot rather than an fp16 of the value:
#
#   out = ((int16)fp16bits(w) * (int16)abits) >> 16     abits = 256 for a = 1
#   w 1 2 3 4 5 7 15  ->  60 64 66 68 69 71 -68        all seven exact,
#                                                       and the high nibble,
#                                                       abits 512, is 2x each
#
# PROC_PRECISION = 0 is a DIFFERENT operation, not a broken one:
#
#   out = 127 * w      w signed 4 bit, 15 gives -127, seven for seven linear
#
# That is what an int4 matmul wants, except for the 127: the output does not
# depend on the activation at all. --map with a ramp and --kpair with a one hot
# of 100 both return 889 for a nibble of 7, so it is measured twice.
#
# WHY THAT MIGHT BE THE PACKING RATHER THAN THE MODE. charsiu packs the
# activation as a 2 byte fp16 whenever the weight is int4, with the int8 value
# in the HIGH byte and the low byte zero, so the slot reads 256 for a = 1. An
# integer mode reading a 1 byte activation would read the low byte, which is 0.
# CHARSIU_A8_STRIDE1 already exists and switches the packing to a 1 byte element
# with atom 16, and it has never been run against PROC_PRECISION = 0.
#
# THE READING RULE, fixed before the run.
#
#   ⚠ ENTRY 2 IS THE ROUND. PROC_PRECISION = 0 with a one byte activation.
#
#     values scale with the activation   PROC_PRECISION = 0 is a real integer
#                                        multiply and the mode is usable
#     values stay at 127 * w             the activation is not read in this mode
#                                        at all, and the 127 is coming from
#                                        somewhere else, most likely the A
#                                        record of the coefficient buffer
#     it hangs or goes dark              the packing and the mode are not
#                                        compatible and w4a16 is the only way
#
#   ENTRY 3 is --kpair under the same, because A8_STRIDE1 changes the atom from
#   8 to 16 and the whole k mapping with it, so the map has to be re-read rather
#   than assumed.
#
#   ⚠ ENTRY 5 RE-SWEEPS THE REGISTERS 269 FOUND INERT, WITH THE FIX ON. They
#   were swept in fp16 mode. A size register that does nothing when the
#   activation is two bytes wide may do something when it is one, and the
#   channel count has resisted four rounds, so the cheapest thing left is to ask
#   the same question in the mode that changed.
#
#   ENTRY 6 confirms wrote = M * (N/2 + 8) at M = 4. 272 measured 80 at M = 2
#   against 40 at M = 1, so the 40 is per row and the halving is not about M.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
CH=/opt/charsiu/charsiu_int4
FIX=0x100c=0x20600020
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

c() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $*"; return 0; }
	before=$(nbad)
	sleep 1
	env $1 $2 $CH $3 $4 $5 $6 $7 $8 > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This arm is VOID."; health; }
	return 0
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	if [ -w /sys/module/rocket/parameters/reset_autosuspend ]; then
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend
		log "reset_autosuspend = $(cat /sys/module/rocket/parameters/reset_autosuspend)"
	else
		log "!! reset_autosuspend NOT WRITABLE. A timeout will kill the round."
	fi

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "##### 2) THE ROUND. PROC_PRECISION=0 with a ONE BYTE activation.   #####"
	for L in 1 2 4 7 15
	do
		log ""
		log "===== nibble $L   PP=0 + A8_STRIDE1"
		c "CHARSIU_OVERRIDE=$FIX" "CHARSIU_A8_STRIDE1=1 CHARSIU_INT4_LIVE=$L" 1 64 64 --map 8 8
	done

	log ""
	log "===== 3) the k map under PP=0 + A8_STRIDE1. The atom changed.      ====="
	c "CHARSIU_OVERRIDE=$FIX" "CHARSIU_A8_STRIDE1=1 CHARSIU_KPAIR_BYTES=0,8,16,256,512,1024" 1 64 64 --kpair

	log ""
	log "===== 4) the whole buffer under PP=0 + A8_STRIDE1                  ====="
	c "CHARSIU_OVERRIDE=$FIX" CHARSIU_A8_STRIDE1=1 1 64 64 --map 8

	log ""
	log "##### 5) the inert registers again, WITH the fix on.               #####"
	for a in \
		"0x1020=0x40" \
		"0x1028=0x0001003f" \
		"0x1030=0x00800000" \
		"0x103c=0x00010000" \
		"0x1044=0x00010001" \
		"0x4030=0x003f0710" \
		"0x4044=0x00000001"
	do
		log ""
		log "===== ARM $a  + fix"
		c "CHARSIU_OVERRIDE=$FIX,$a" X=1 1 64 64 --map 8 128
	done

	log ""
	log "===== 6) M = 4 under the fix. wrote should be 160 if it is M*(N/2+8) ====="
	c "CHARSIU_OVERRIDE=$FIX" X=1 4 64 64 --map 8 128

	log ""
	log "===== the anchor again                                             ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== does the value move with the activation. That is the round.  ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
