# ---------------------------------------------------------------------------
# 2026-08-21 round 304. What does int4 actually buy.
#
# ⚠⚠ THE ENVELOPE IS MEASURED. 303 closed the K line:
#
#   K = 224  N = 64 and 32     64 of 64 and 32 of 32, full
#   K = 256  N = 16            16 of 16 EXACT
#   K = 256  N = 32            wrote 24, exact 16
#   K = 256  N = 64            wrote 40, exact 32
#
# and the sharp prediction landed. At K = 256 the channel count is N/2 and
# SIZE_E_2's additive 8 writes garbage on top, so exact is N/2 and wrote is
# N/2 + 8 exactly. At N = 16 those coincide with N, which is why N = 16 alone is
# clean there, and that is what asking a small N was for.
#
#   K a multiple of 32, 32 through 224      every N tried, 16 through 160
#   K = 144 and 176, K/32 not whole         8 of 64
#   K = 256                                 N/2 channels
#   M = 1,  K/2 real k a channel a job
#
# ⚠ AND THE WHOLE int4 LINE, ROUNDS 265 TO 303, EXISTS TO ANSWER ONE QUESTION
# THAT COULD NOT BE ASKED. charsiu_bench had no int4 path at all, so "what does
# int4 buy" had no instrument. It has one now, and the GB/s column counts the
# weight bytes a shape really moves, k*n/2 for int4 against k*n for int8, since
# a GB/s that means different things on the two paths is worse than none.
#
# THE READING RULE, fixed before the run.
#
#   ⚠ THE PRIOR IS EXPLICIT AND IT IS NOT "int4 IS TWICE AS FAST". The bench
#   header in this repo already says this workload tracks WEIGHT BYTES at about
#   10 GB/s and is bound by them rather than by arithmetic. int4 halves the
#   bytes at the same shape, so a bytes bound predicts about half the time and a
#   fixed per submit cost eats into that.
#
#     int4 is near half the us of int8 at the same K and N
#                        the bound is bytes, int4 is worth what it claims, and
#                        the tiling to K <= 224 is the only cost
#     int4 is the same us as int8
#                        the bound is not bytes at these shapes, and the 180 to
#                        195 us fixed submit cost this repo already measured is
#                        what is being timed
#     int4 is slower     something in the w4a16 path costs more than the bytes
#                        save, and the per task column says whether it is fixed
#                        or per byte
#
#   ⚠ THE SHAPES ARE INSIDE THE ENVELOPE. K = 224 N = 160 is the largest legal
#   one and is 17920 weight bytes against int8's 35840. A projection is K = 2048
#   by N = 1024 and cannot be run whole, which is itself the headline number:
#   int4 needs about 19 jobs where int8 needs 1.
#
#   ENTRY 2 is the matmul regression, because a bench that times a wrong answer
#   is worth nothing.
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
MM=/opt/charsiu/charsiu_matmul
BE=/opt/charsiu/charsiu_bench
CH=/opt/charsiu/charsiu_int4
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

c() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $*"; return 0; }
	before=$(nbad)
	sleep 1
	env $1 $2 $3 $4 $5 $6 $7 $8 $9 > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This arm is VOID."; health; }
	return 0
}

M4="CHARSIU_W4=1 CHARSIU_W4_HALFK=1"

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	if [ -w /sys/module/rocket/parameters/reset_autosuspend ]; then
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend
		log "reset_autosuspend = $(cat /sys/module/rocket/parameters/reset_autosuspend)"
	else
		log "!! reset_autosuspend NOT WRITABLE. A timeout will kill the round."
	fi

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "##### 2) the matmul regression. A bench of a wrong answer is worth #####"
	log "#####    nothing, so the shapes benched below are checked first.   #####"
	for KK in 64 128 224
	do
		log ""
		log "===== K = $KK  N = 160"
		c "$M4" X=1 $MM 1 $KK 160
	done

	log ""
	log "##### THE ROUND. int4 against int8 at the same shape.              #####"
	log ""
	log "===== 3) K = 224  N = 160   int8 then int4                         ====="
	c X=1 X=1 $BE 1 224 160 100
	c "CHARSIU_W4=1" X=1 $BE 1 224 160 100
	log ""
	log "===== 4) K = 128  N = 160   int8 then int4                         ====="
	c X=1 X=1 $BE 1 128 160 100
	c "CHARSIU_W4=1" X=1 $BE 1 128 160 100
	log ""
	log "===== 5) K = 224  N = 64    int8 then int4                         ====="
	c X=1 X=1 $BE 1 224 64 100
	c "CHARSIU_W4=1" X=1 $BE 1 224 64 100

	log ""
	log "===== 6) and int8 at a real projection, for the scale of the tile  ====="
	c X=1 X=1 $BE 1 2048 1024 50

	log ""
	log "===== the anchor again                                             ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== us/matmul, int4 against int8 at the same K and N.            ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
