#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-24 round 373. ATTENTION AT LENGTH.
#
# ROUND 372 LOCKED IN THE TWO SWITCHES. Arm 1 and its control wrote the SAME
# sentence, word for word, so the board really does not see the difference the
# host sees: 12.95 tok/s against 12.36, and the reordered dot product and the
# polynomial exponential are the default now.
#
# 🔑 AND ARM 3 FOUND SOMETHING NOBODY HAD LOOKED FOR. At 384 tokens:
#
#     attention           36.90 ms a token    33.0%   <- the LARGEST row
#     gate + up           22.57                20.2
#     down                20.89                18.7
#     q k v               10.68                 9.6
#     output head          8.88                 7.9
#
# against 4.53 ms at 64 tokens. **I predicted 20 to 25 and it is 36.90.** The
# whole token went 76.9 ms to 111.8, and the run averaged 8.92 tok/s where a 64
# token run gets 12.95.
#
# ⚠ AND IT GREW FASTER THAN THE CONTEXT DID: 8.15x while the average position
# grew 5.27x. Superlinear is what falling out of cache looks like -- the kv
# cache is 4.6 MB at position 70 and 25.6 MB at 390.
#
# ---------------------------------------------------------------------------
# WHAT CHANGED, AND WHY IT SHOULD BE FREE
# ---------------------------------------------------------------------------
#
# This model has 32 query heads and 8 key/value heads, so FOUR QUERIES SHARE
# EVERY KV ROW -- and the loop walked the whole cache once for each of them,
# reading every row four times. Invisible at the sixty-odd positions every
# round since 352 has run at; a third of the token at 384.
#
# A group is processed together now, so each row is read once. The ARITHMETIC
# IS UNTOUCHED: every head still sums over the same i in the same order and the
# same t in the same order, and only the interleaving changes. Checked on the
# host across five configurations including a ragged head range from the thread
# pool at -t 6, and every one reproduced its hash exactly.
#
# CHARSIU_ATTN_PERHEAD takes the group back to one, which IS the old walk. It
# exists because a bit identical change has nothing else that could tell the
# two apart, and round 368 is the reason every change carries a control.
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# THE SENTENCES FIRST. Arms 1 and 2 must be identical to each other, and arm 3
# must be the Louvre sentence. Nothing here is allowed to change a word: if
# anything does, the regrouping is wrong and the host check missed it.
#
# THEN THE attention ROW, arm 1 against arm 2, both at 384 tokens. Round 372
# measured 36.90 ms and arm 2 should reproduce it.
#
# ⚠ AND HERE IS THE WAY THIS ROUND IS WRONG. **On the host the regrouping was
# worth 9%**: 2.11 ms to 1.93 at the same 384 tokens. The host has caches large
# enough and memory fast enough that reading a row four times costs almost
# nothing, which is exactly why it is the wrong machine to ask. **If the board
# also says about 9%, then the redundant reads were NOT the cost, the
# superlinear growth has some other cause, and the diagnosis in this header is
# wrong.** Say that, rather than calling a 9% win a success.
#
# THEN ARM 3, which is the short case, to be sure nothing regressed there: 64
# tokens should still be about 12.95 tok/s with attention at or below 4.53.
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT
# ---------------------------------------------------------------------------
#
# A memory bound loop reading a quarter as much: attention 36.90 down to
# somewhere near 15 to 20 ms, the token from 111.8 to about 92 to 97, and the
# 384 token rate from 8.92 to about 10.3 to 10.9. Not a quarter of 36.90,
# because the arithmetic does not shrink at all -- only the traffic does.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
VD=/opt/charsiu/charsiu_vendor
V=/opt/charsiu/vendor
RGC=$V/vendor-int4-k2048-n1024.regcmd
WT=$V/vendor-wt-1M.bin
IN=$V/vendor-in.bin
RUN=/opt/charsiu/charsiu_run
M8=/opt/charsiu/models/Llama-3.2-1B-Instruct-Q8_0.gguf
PROMPT="The capital of France is"
LIMIT=420
# 32 tokens does not reach the answer to "17 times 24, show your working"
NGEN=64
CE=CHARSIU_COEF_ELEMS=65536
HEAD=CHARSIU_NPU_MAXN=131072
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block did not come back this time."
		ABORT=1
	fi
}

capped() {
	lim="$1"; shift
	"$@" &
	pid=$!
	i=0
	while [ "$i" -lt "$lim" ]; do
		kill -0 "$pid" 2>/dev/null || { wait "$pid"; return $?; }
		sleep 1
		i=$((i + 1))
	done
	kill -9 "$pid" 2>/dev/null
	wait "$pid" 2>/dev/null
	return 124
}
rung() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $1"; return 0; }
	lbl="$1"; shift
	before=$(nbad)
	log ""
	log "  -- $lbl"
	sleep 1
	capped "$LIMIT" env "$@" "$RUN" "$M8" -p "$PROMPT" -n "${NGEN:-32}" \
		--ignore-eos -q -c 512 -t 4 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the rung exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This rung is VOID."; health; }
	return 0
}
# arm: <label> <regcmd-or-dash> <byte> <high> [extra env, one assignment]
#
# ⚠ THE ENV GOES IN AS AN ARGUMENT, not as a "VAR=x arm ..." prefix. Whether an
# assignment before a FUNCTION call survives the call is unspecified -- dash
# drops it, other shells keep it -- and the arm whose whole job is to time out
# WITHOUT the trailer runs right after the one that has it. Not a question worth
# leaving to the shell.
arm() {
	before=$(nbad)
	log ""
	log "  ---- $1"
	sleep 1
	env ${5:-IGNORED=1} $VD "$2" "$WT" "$IN" "$3" "$4" 4096 > /tmp/vd.txt 2>&1
	cat /tmp/vd.txt > "$C"
	after=$(nbad)
	if [ "$after" != "$before" ]; then
		log "  !! POISONED: $((after - before)) new fault or timeout lines"
		health
		# ⚠ NOT a round abort. Round 342 threw away every arm after the
		# first poisoning and then measured the block healthy at the
		# end. The block recovers; give it a moment and carry on.
		ABORT=0
		sleep 2
	fi
}

# two concurrent probes, so the pair can be repeated without copy and paste
pair() {
	before=$(nbad)
	log ""
	log "  ---- $1"
	env CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_TIME=60 CHARSIU_OUT_KB=64 $2 $VD - "$WT" "$IN" 0 0 4096 > /tmp/vdA.txt 2>&1 &
	pidA=$!
	env CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_TIME=60 CHARSIU_OUT_KB=64 $3 $VD - "$WT" "$IN" 0 0 4096 > /tmp/vdB.txt 2>&1 &
	pidB=$!
	wait "$pidA"
	wait "$pidB"
	log "    A:"
	grep -E "M = |TIME:|baseline:|VERIFY:|CONTROL repeat|VOID|REREAD" /tmp/vdA.txt > "$C"
	log "    B:"
	grep -E "M = |TIME:|baseline:|VERIFY:|CONTROL repeat|VOID|REREAD" /tmp/vdB.txt > "$C"
	after=$(nbad)
	[ "$after" != "$before" ] && log "  !! POISONED: $((after - before)) new lines"
	return 0
}

BW=/opt/charsiu/charsiu_membw
DEC="CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 CHARSIU_NPU_W4V=1 CHARSIU_NPU_KMAX=1024 CHARSIU_NPU_W4_GROUP=1024"

# decode and a memory reader at the same time, both numbers kept
squeeze() {
	log ""
	log "  ---- $1"
	sleep 1
	env $DEC "$CE" "$HEAD" "$RUN" "$M8" -p "$PROMPT" -n 128 --ignore-eos \
		-q -c 512 -t 4 > /tmp/dec.txt 2>&1 &
	dpid=$!
	# past staging and into generation before the reader starts
	sleep "$2"
	if [ -n "$3" ]; then
		env CHARSIU_THREADS=4 CHARSIU_SECONDS="$3" $BW > /tmp/bw.txt 2>&1
	fi
	wait "$dpid"
	grep -E "tensors staged|gen 128|GB/s of weights|of that," /tmp/dec.txt > "$C"
	[ -n "$3" ] && cat /tmp/bw.txt > "$C"
	return 0
}

start() {
	log ""
	log "###############################################################"
	log "##### round 373: attention at length                        #####"
	log "###############################################################"
	log "  four queries share every kv row. it used to read each"
	log "  row four times."

	B="CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 CHARSIU_NPU_W4V=1 CHARSIU_NPU_KMAX=1024 CHARSIU_NPU_W4_GROUP=1024 CHARSIU_STAGES=1"

	log ""
	log "===== 1) 384 tokens, one pass over the kv cache per group      ====="
	log "  read the attention row against round 372's 36.90 ms."
	NGEN=384
	rung "int4 g1024, 384 tokens, grouped" $B "$CE" "$HEAD"

	log ""
	log "===== 2) THE CONTROL: 384 tokens, one pass PER HEAD            ====="
	log "  the old walk. must reproduce 36.90 and the SAME words."
	rung "int4 g1024, 384 tokens, per head" $B CHARSIU_ATTN_PERHEAD=1 "$CE" "$HEAD"
	NGEN=64

	log ""
	log "===== 3) 64 tokens, to be sure the short case did not regress  ====="
	log "  about 12.95 tok/s, attention at or below 4.53 ms."
	rung "int4 g1024, 64 tokens" $B "$CE" "$HEAD"

	log ""
	log "===== 4) the probe, still exact                                ====="
	arm "solo verify" "-" 0 0 "CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_VERIFY=1 CHARSIU_OUT_KB=64"

	log ""
	log "===== 5) the anchor: int8 conv must still be exact            ====="
	health

	log ""
	log "===== read the CONTROL lines first. VOID means the arm died. ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
