#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-22 round 334. THE PACKING IS RIGHT. THE WRITE COUNT IS SHORT.
#
# 🔑 ROUND 333 GOT int4 TO FULL WIDTH FOR THE FIRST TIME, at one shape:
#
#   N=64  K=64   paired packing, NO halfk, against the FULL K reference
#                -> **64 EXACT of 64**
#
# That is not the old 64 of 64. The old one scored against a reference over half
# the k because halfk had zeroed the rest; this one uses every k and the
# hardware still gets every channel exactly right. The pair (2r, 2r+1) read out
# of --kpair in round 332 is the real one.
#
# ⚠ AND THE BIGGER SHAPES STOPPED AT EXACTLY HALF, for a reason the log states
# rather than one I have to infer:
#
#   N=256   256 words written, highest index 255   (512 are needed)  128 of 256
#   N=512   512 words written, highest index 511  (1024 are needed)  256 of 512
#   N=64    128 words written                                  ->    64 of 64
#
# **Channels 128..255 live in words 256..511 and those words were never
# written.** The packing put their weights in the buffer and the hardware never
# emitted the second half of the sum. Nothing about the layout is wrong here --
# the write count is.
#
# ---------------------------------------------------------------------------
# WHAT THIS ROUND CHANGES
# ---------------------------------------------------------------------------
#
# `0x3020` was set to 2N-1 at all three shapes and it was enough at N=64 and not
# at N=256. ⚠ **The DPU carries the channel count too and I did not touch it**:
#
#   0x402c   n - 1              0xff at N=256
#   0x4030   (n - 1) << 16      0x00ff0310
#
# So this round declares 2N to the DPU as well, one register at a time, with the
# write count as the acceptance: **512 words written, highest index 511** at
# N=256, and then 256 EXACT of 256 follows or the packing was not what 333 says.
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# 1) ENTRY 2b MUST REPRODUCE 64 of 64 at N=64. That is now the control for the
#    packing itself, and it is a stronger one than 2a because it runs without
#    halfk against the full reference.
# 2) THE `placement: N words written` LINE IS THE ROUND, before the exact count.
#    If it still says 256 at N=256, the register that caps the write is not any
#    of the three tried and the exact count cannot move.
# 3) ⚠ ONE ARM POISONED IN 333 (the bench at 0x3020 = 0x3ff) and the block
#    recovered. The bench is dropped this round; the price can wait until the
#    arithmetic is right.
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT
# ---------------------------------------------------------------------------
#
# The DPU's own channel count is the cap. It is the only thing left that carries
# n and was not doubled, the failure is exactly a factor of two in the WRITE and
# not in the values, and the shape where it worked is the shape where the
# default 0x3020 happened to already exceed n.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
RUN=/opt/charsiu/charsiu_run
BE=/opt/charsiu/charsiu_bench
MM=/opt/charsiu/charsiu_matmul
I4=/opt/charsiu/charsiu_int4
M4="CHARSIU_W4=1 CHARSIU_W4_HALFK=1"
M8=/opt/charsiu/models/Llama-3.2-1B-Instruct-Q8_0.gguf
PROMPT="The capital of France is"
LIMIT=420
ARMCAP=240
CE=CHARSIU_COEF_ELEMS=65536
HEAD=CHARSIU_NPU_MAXN=131072
B8="CHARSIU_OVERRIDE=0x40b8=3"
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

capped() {
	lim="$1"; shift
	"$@" &
	pid=$!
	i=0
	while [ "$i" -lt "$lim" ]; do
		kill -0 "$pid" 2>/dev/null || { wait "$pid"; return $?; }
		sleep 1
		i=$((i + 1))
	done
	kill -9 "$pid" 2>/dev/null
	wait "$pid" 2>/dev/null
	return 124
}

c() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $*"; return 0; }
	before=$(nbad)
	sleep 1
	capped "$ARMCAP" env $1 $2 $3 $4 $5 $6 $7 $8 $9 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the arm exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This arm is VOID."; health; }
	return 0
}

rung() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $1"; return 0; }
	lbl="$1"; shift
	before=$(nbad)
	log ""
	log "  -- $lbl"
	sleep 1
	capped "$LIMIT" env "$@" "$RUN" "$M8" -p "$PROMPT" -n 32 \
		--ignore-eos -q -c 512 -t 4 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the rung exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This rung is VOID."; health; }
	return 0
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	[ -w /sys/module/rocket/parameters/reset_autosuspend ] && \
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend

	log ""
	log "===== 0) the limit's own control. expect rc 124 after ~3s.         ====="
	t0=$(cut -d. -f1 /proc/uptime)
	capped 3 sleep 60
	rc=$?
	t1=$(cut -d. -f1 /proc/uptime)
	log "  -- capped 3 sleep 60  ->  rc $rc after $((t1 - t0))s"
	[ "$rc" = "124" ] || log "  !! THE LIMIT DID NOT FIRE. Nothing below can be trusted to end."

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "##### ROUND 334: the packing is right, the write count is short   #####"

	log ""
	log "===== 2) THE MEASUREMENT. every stage of the forward pass, NPU on. ====="
	log "=====    matmul stages minus the hardware path = the quantise.     ====="
	rung "the decode loop on the NPU, stages on" \
		CHARSIU_STAGES=1 CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 "$CE" "$HEAD"

	log ""
	log "===== 2b) the same stages with the NPU off, one boot apart.        ====="
	rung "the CPU path, stages on" CHARSIU_STAGES=1 CHARSIU_NPU_QUANT=1

	log ""
	log "===== 2) declare 2N to the DPU as well, one register at a time.    ====="
	log "===== 2a the packing's own control: N=64 must stay 64 of 64"
	c "CHARSIU_W4=1 CHARSIU_W4_PHANTOM=1" "CHARSIU_OVERRIDE=0x40b8=3,0x3020=0x7f" $MM 1 64 64
	log "===== 2b N=256 with 0x3020 only, which must reproduce 128 of 256"
	c "CHARSIU_W4=1 CHARSIU_W4_PHANTOM=1" "CHARSIU_OVERRIDE=0x40b8=3,0x3020=0x1ff" $MM 1 2048 256
	log "===== 2c + DPU 0x402c = 2N-1"
	c "CHARSIU_W4=1 CHARSIU_W4_PHANTOM=1" "CHARSIU_OVERRIDE=0x40b8=3,0x3020=0x1ff,0x402c=0x1ff" $MM 1 2048 256
	log "===== 2d + DPU 0x4030 high half = 2N-1"
	c "CHARSIU_W4=1 CHARSIU_W4_PHANTOM=1" "CHARSIU_OVERRIDE=0x40b8=3,0x3020=0x1ff,0x402c=0x1ff,0x4030=0x01ff0310" $MM 1 2048 256
	log "===== 2e + a coefficient buffer for 2N channels"
	c "CHARSIU_W4=1 CHARSIU_W4_PHANTOM=1 CHARSIU_COEF_ELEMS=65536" "CHARSIU_OVERRIDE=0x40b8=3,0x3020=0x1ff,0x402c=0x1ff,0x4030=0x01ff0310" $MM 1 2048 256
	log "===== 2f the same full set at N=512 K=1024"
	c "CHARSIU_W4=1 CHARSIU_W4_PHANTOM=1 CHARSIU_COEF_ELEMS=65536" "CHARSIU_OVERRIDE=0x40b8=3,0x3020=0x3ff,0x402c=0x3ff,0x4030=0x03ff0310" $MM 1 1024 512
	log "===== 2g and at a projection's shape, N=1024 K=2048"
	c "CHARSIU_W4=1 CHARSIU_W4_PHANTOM=1 CHARSIU_COEF_ELEMS=65536" "CHARSIU_OVERRIDE=0x40b8=3,0x3020=0x7ff,0x402c=0x7ff,0x4030=0x07ff0310" $MM 1 2048 1024

	log ""
	log "===== 5) the standing number, no timers, so they cannot be blamed  ====="
	rung "the decode loop on the NPU" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 "$CE" "$HEAD"

	log ""
	log "===== the anchor again                                             ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== read \"words written\" first; 512 at N=256 is the round.       ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
