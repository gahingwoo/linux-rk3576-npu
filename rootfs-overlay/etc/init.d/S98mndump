#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-13 round 128. The pointwise weight buffer is grouped in 32s.
#
# ⚠ Round 127's two knobs were BOTH null and the reason is mine, not the
# hardware's. RK3576 1x1 convolutions take their own packing path,
# is_rk3576_pointwise, which returns before the generic loop I had put the
# knobs in. That is the fifth knob in this project that could not reach the
# code it was meant to test, and this time nothing caught it but the numbers
# being suspiciously identical: two different groupings cannot give the same
# 40 of 128 channels AND the same maxdiff 149.
#
# Settled offline instead, which needs no board. posprobe_pw.py compiles a
# position encoded 1x1 with the vendor toolkit and reads the weight blob back
# out of the .rknn. At 64 input channels and 4 output:
#
#   ic  0..31 for oc 0, then oc 1, oc 2, oc 3     first 128 bytes
#   ic 32..63 for oc 0, then oc 1, oc 2, oc 3     second 128 bytes
#
# So the vendor writes [ic/32][oc][ic%32] and mesa writes one flat oc-major run
# with all 64 input channels contiguous. At 32 channels or fewer there is one
# group and the two are the SAME buffer, which is exactly why mn_pw2 has always
# passed and why an earlier host check at small ic reported oc-major: it was,
# within its range.
#
# DECISION RULE, written before the run:
#   the four failing pointwise shapes come good
#             the grouping is the fault and op4 should come with them
#   they improve but are not exact
#             the grouping is right and something else in this path is not
#   they do not move
#             the host probe and the board disagree, which would be the first
#             time, and the probe would need re-running at another shape
#
# Test 5 is the control: ROCKET_PW_FLAT restores the flat form and
# pw64x128w56 must go back to 40 of 128. Test 6 is the other control, 32
# channels, where the two forms are the same buffer, so it must not move at
# all under either setting.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
p() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== 1..4) the four pointwise shapes that failed ====="
	p pw64x128w56.tflite ""
	p pw64x64w56.tflite ""
	p pw128x128w56.tflite ""
	p pw128x256w28.tflite ""

	log ""
	log "===== 5) CONTROL: flat form back, must return to 40 of 128 ====="
	p pw64x128w56.tflite "ROCKET_PW_FLAT=1"

	log ""
	log "===== 6..7) CONTROL: 32 channels, same buffer either way ====="
	p pw32x64w56.tflite ""
	p mn_pw2.tflite ""

	log ""
	log "===== 8..10) MobileNet: op4 and the ladder past it ====="
	p mn_L04.tflite ""
	p mn_L06.tflite ""
	p mn_L08.tflite ""

	log ""
	log "===== 11..14) REGRESSION ====="
	p mn_L03.tflite ""
	p mn_dw1.tflite ""
	p conv2d-cal.tflite ""
	p mn_conv0.tflite ""

	log ""
	log "===== 1..4 are the round, 5 says whether to believe it.           ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
