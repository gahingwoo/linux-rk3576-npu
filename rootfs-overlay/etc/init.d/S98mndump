# ---------------------------------------------------------------------------
# 2026-08-12 round 120. What the budget did not fix.
#
# Round 119 shipped the derived budget and it took three of the five:
#
#   dw64w72    0/64  ->  64/64
#   dw64w80    0/64  ->  64/64
#   dw64w96    0/64  ->  64/64
#   dw32w111   0/32  ->   0/32     still wrong
#   mn_L03     1/64  ->   1/64     still wrong
#
# Every control held. mn_dw1, dw32, conv2d-cal and mn_dw25 are unmoved, so the
# derivation gives back the same 91 rows for the case the literal came from,
# and ROCKET_CBUF_ENTRIES=100000 breaks dw64w72 again, so the knob bites.
# Committed and pushed.
#
# Two are left and they may be one thing or two. What is untested about them:
#
#   dw32w111   111 is the only ODD width ever run here. Everything else has
#              been 7, 40, 44, 48, 64, 70, 72, 80, 96 or 112.
#   mn_L03     112 wide, 64 channels, stride 2, and fourth in a 31 operator
#              graph. Its standalone twin dw64_s2 has not been rerun since the
#              budget landed, and at 56 entries a row it now gets a 45 row
#              window where it used to get 91.
#
# DECISION RULE, written before the run:
#   dw32w110 passes and dw32w109 fails    it is the odd width, and the line
#                                         stride or the window arithmetic
#                                         rounds it away
#   both pass                             111 was something else entirely and
#                                         needs its own look
#   both fail                             it is not parity, it is being just
#                                         under 112 and over budget
#   dw64_s2 passes while mn_L03 fails     op3's fault needs the graph around
#                                         it, not its own shape
#   dw64_s2 fails too                     stride 2 at 112 wide with four
#                                         atomics, reproducible standalone
#
# Test 8 is the control for the parity pair: dw64w110 is even, over budget and
# three windows, so if it fails the reading is not parity but window count.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
p() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== 1..3) the parity question: 110 even, 109 odd, 111 odd ====="
	p dw32w110.tflite ""
	p dw32w109.tflite ""
	p dw32w111.tflite ""

	log ""
	log "===== 4..5) 112 wide at 64 channels, standalone, both strides ====="
	p dw64.tflite ""
	p dw64_s2.tflite ""

	log ""
	log "===== 6) and the same shape inside the graph ====="
	p mn_L03.tflite ""

	log ""
	log "===== 7) CONTROL: even, over budget, three windows ====="
	p dw64w110.tflite ""

	log ""
	log "===== 8..11) REGRESSION ====="
	p mn_dw1.tflite ""
	p dw64w96.tflite ""
	p conv2d-cal.tflite ""
	p mn_dw25.tflite ""

	log ""
	log "===== 1 vs 2 is parity. 5 vs 6 says whether op3 needs the graph.  ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
