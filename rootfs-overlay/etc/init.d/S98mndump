#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-23 round 349. THE RATE, WITH AN INSTRUMENT THAT CAN BE CHECKED.
#
# ✅ ROUND 348's FIRST TWO ARMS ARE CLEAN AND SAY WHAT THEY WERE ASKED TO SAY.
#
#   native int4 at M=1, NOTHING in the environment   1024 of 1024 within 1e-4
#   CHARSIU_W4_BITPAT, the fault brought back        0 of 1024, and its sweep
#                                                    is the old band 1920, 2176,
#                                                    -1792, -2176
#
# So the three registers moving from an override into job.c did not change the
# answer, and the control can still fail.
#
# ⛔ ROUND 348's TIMING MEASURED THIS TOOL, NOT THE HARDWARE.
#
#   int4  1418.6 us/submit  0.74 GB/s
#   int8  1606.4 us/submit  1.31 GB/s
#
# **int8 at 1.31 GB/s against a standing 9.38 is the giveaway.** run() memsets
# the whole output buffer and cache maintains it twice per submit, and at 4 MiB
# that is most of the 1418 us. The 188 us between the two arms is probably the
# real difference, but a 188 us signal on a 1400 us pedestal is not a
# measurement, it is a subtraction -- and round 327 was lost to exactly that.
#
# So the overhead is REMOVED, not subtracted. run_bare() does the submit and
# the wait and nothing else, and CHARSIU_OUT_KB sizes the output BO, which is
# where all of it was.
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# ⚠ ENTRY 1 IS THE INSTRUMENT CHECK AND IT CAN FAIL. int8 at K=2048 N=1024 is a
# shape this project has measured many times: **about 9.4 GB/s and roughly 210
# us for its 2 MiB.** If entry 1 does not land near that, the harness is still
# measuring itself and entry 2 means nothing. Nothing else in this round should
# be read until entry 1 is checked against that number.
#
# ENTRY 2 is the answer. int4 moves 1 MiB at this shape against int8's 2, so
#
#   int4 above about 4.7 GB/s  -> a projection finishes sooner and the decode
#                                 loop should move to int4
#   int4 below that            -> correctness bought nothing at this shape
#
# ENTRY 3 is the control for the FIX: the same int8 job with the 4 MiB output
# buffer back, which must reproduce round 348's ~1.3 GB/s. A fix whose control
# does not bring the fault back has not been shown to be the fix.
#
# ENTRIES 4 AND 5 keep correctness under the eye while the buffer size changes.
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT
# ---------------------------------------------------------------------------
#
# Entry 1 near 9.4 GB/s. For entry 2 I have no honest prior: the fetch pattern
# is a different one now, half the bytes but sixteen channels a block, and the
# only int4 rate this project has ever recorded was taken on the broken mode.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
VD=/opt/charsiu/charsiu_vendor
V=/opt/charsiu/vendor
RGC=$V/vendor-int4-k2048-n1024.regcmd
WT=$V/vendor-wt-1M.bin
IN=$V/vendor-in.bin
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block did not come back this time."
		ABORT=1
	fi
}

# arm: <label> <regcmd-or-dash> <byte> <high> [extra env, one assignment]
#
# ⚠ THE ENV GOES IN AS AN ARGUMENT, not as a "VAR=x arm ..." prefix. Whether an
# assignment before a FUNCTION call survives the call is unspecified -- dash
# drops it, other shells keep it -- and the arm whose whole job is to time out
# WITHOUT the trailer runs right after the one that has it. Not a question worth
# leaving to the shell.
arm() {
	before=$(nbad)
	log ""
	log "  ---- $1"
	sleep 1
	env ${5:-IGNORED=1} $VD "$2" "$WT" "$IN" "$3" "$4" 4096 > /tmp/vd.txt 2>&1
	cat /tmp/vd.txt > "$C"
	after=$(nbad)
	if [ "$after" != "$before" ]; then
		log "  !! POISONED: $((after - before)) new fault or timeout lines"
		health
		# ⚠ NOT a round abort. Round 342 threw away every arm after the
		# first poisoning and then measured the block healthy at the
		# end. The block recovers; give it a moment and carry on.
		ABORT=0
		sleep 2
	fi
}

start() {
	log ""
	log "###############################################################"
	log "##### round 349: the rate, with an instrument that can be checked #####"
	log "###############################################################"
	log "  no fitted reference. one nibble changes, the output difference"
	log "  is that nibble. a straight line means int4 is real."

	log ""
	log "===== 1) INSTRUMENT CHECK: int8. must land near 9.4 GB/s.     ====="
	log "  if it does not, stop reading: the harness is still timing"
	log "  itself and entry 2 means nothing."
	arm "int8 rate, small out bo" "-" 0 0 "CHARSIU_M=1 CHARSIU_TIME=200 CHARSIU_W8=1 CHARSIU_OUT_KB=64"

	log ""
	log "===== 2) THE ANSWER: int4, same shape, same boot              ====="
	log "  1 MiB against int8's 2, so above about 4.7 GB/s it wins."
	arm "int4 rate, small out bo" "-" 0 0 "CHARSIU_M=1 CHARSIU_TIME=200 CHARSIU_OUT_KB=64"

	log ""
	log "===== 3) CONTROL for the fix: int8 with the 4 MiB buffer back ====="
	log "  must reproduce round 348's ~1.3 GB/s."
	arm "int8 rate, 4 MiB out bo" "-" 0 0 "CHARSIU_M=1 CHARSIU_TIME=200 CHARSIU_W8=1 CHARSIU_OUT_KB=4096"

	log ""
	log "===== 4) correctness, still 1024 of 1024 with the small bo    ====="
	arm "native int4, M=1" "-" 0 0 "CHARSIU_M=1 CHARSIU_VERIFY=1 CHARSIU_OUT_KB=64"

	log ""
	log "===== 5) CONTROL: the fault back. must be 0 of 1024.          ====="
	arm "M=1, W4_BITPAT" "-" 0 0 "CHARSIU_M=1 CHARSIU_VERIFY=1 CHARSIU_W4_BITPAT=1 CHARSIU_OUT_KB=64"

	log ""
	log "===== 6) the anchor: int8 conv must still be exact           ====="
	health

	log ""
	log "===== read the CONTROL lines first. VOID means the arm died. ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
