# ---------------------------------------------------------------------------
# 2026-08-22 round 333. THE PAIR IS (2r, 2r+1), AND IT WAS READ NOT GUESSED.
#
# ROUND 332 ASKED THE ONE QUESTION AND GOT A CLEAN ANSWER. --kpair at the
# phantom settings, K=64 N=64, printing the k each byte multiplies with:
#
#   w0    byte 0 -> k 0,1     byte 4 -> k 8,9     byte 256 -> k 32,33
#   w1    byte 8 -> k 16,17                       byte 264 -> k 48,49
#   w64   byte 1024 -> k 0,1                      byte 1280 -> k 32,33
#
# ⚠ **w64 carries the SAME k as w0.** The phantom word is a duplicate of one
# half, not the other half, so round 330's out[c] + out[c+N] was two copies of
# the same partial sum and could never have worked.
#
# 🔑 **But w0 and w1 TOGETHER cover all 64 k.** That is the halfk parity rule
# itself, seen from the hardware's side: an even word takes k 0..15 and 32..47,
# an odd word takes 16..31 and 48..63. So a real channel is the PAIR (2r, 2r+1),
# and with 0x3020 = 2N-1 there are 2N words -- N real channels, each with the
# whole of K, and N*K nibbles is exactly the N*K/2 byte buffer. Nothing is
# padded and nothing is wasted.
#
#   k = 16*(w mod 2) + 32*j + 2*byte_in_slot + nibble
#
# with j indexing the slots the measured map gives word w. Every term of that
# came off the board: the slots from --map at 1376 points, the k from --kpair
# this round, the intra-slot order from rounds 265-288 and reproduced by 332's
# own control.
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# 1) ENTRY 2a IS THE CONTROL, today's packing: 64 of 64 at N=64 and the
#    128 of 256 that twenty rounds have printed. Unchanged means the build is
#    what I think it is.
# 2) ENTRY 2b IS THE ROUND: paired packing, no halfk, 0x40b8 = 3 and
#    0x3020 = 2N-1, scoring out[2r] + out[2r+1].
#    **256 EXACT of 256 is int4 at full width for the first time.**
# 3) ⚠ THE HALFK ZEROING IS OFF and must be: the paired packing uses every k,
#    so the reference is the full dot product. If it needs halfk to score, it
#    has not done what it claims.
# 4) THREE SHAPES, because a packing that works at one is a coincidence.
# 5) ENTRY 3 IS THE PRICE, if 2b lands: the bench at the same settings, on
#    medians with the stall count. int4 has to beat 9.3 GB/s of int8 bytes with
#    half as many, so anything above 4.7 GB/s is a real win and below it is not.
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT
# ---------------------------------------------------------------------------
#
# ⚠ Six wrong predictions on int4, so the record says discount this. What is
# different: nothing in the packing is assumed any more. The slots were
# measured, the k were measured this round, the intra-slot order was measured
# and re-confirmed by 332's control, and the arithmetic closes exactly with no
# spare bytes. If 2b still fails, the failure is in something none of those
# three probes can see, and int4 stops there.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
RUN=/opt/charsiu/charsiu_run
BE=/opt/charsiu/charsiu_bench
MM=/opt/charsiu/charsiu_matmul
I4=/opt/charsiu/charsiu_int4
M4="CHARSIU_W4=1 CHARSIU_W4_HALFK=1"
M8=/opt/charsiu/models/Llama-3.2-1B-Instruct-Q8_0.gguf
PROMPT="The capital of France is"
LIMIT=420
ARMCAP=240
CE=CHARSIU_COEF_ELEMS=65536
HEAD=CHARSIU_NPU_MAXN=131072
B8="CHARSIU_OVERRIDE=0x40b8=3"
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

capped() {
	lim="$1"; shift
	"$@" &
	pid=$!
	i=0
	while [ "$i" -lt "$lim" ]; do
		kill -0 "$pid" 2>/dev/null || { wait "$pid"; return $?; }
		sleep 1
		i=$((i + 1))
	done
	kill -9 "$pid" 2>/dev/null
	wait "$pid" 2>/dev/null
	return 124
}

c() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $*"; return 0; }
	before=$(nbad)
	sleep 1
	capped "$ARMCAP" env $1 $2 $3 $4 $5 $6 $7 $8 $9 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the arm exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This arm is VOID."; health; }
	return 0
}

rung() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $1"; return 0; }
	lbl="$1"; shift
	before=$(nbad)
	log ""
	log "  -- $lbl"
	sleep 1
	capped "$LIMIT" env "$@" "$RUN" "$M8" -p "$PROMPT" -n 32 \
		--ignore-eos -q -c 512 -t 4 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the rung exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This rung is VOID."; health; }
	return 0
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	[ -w /sys/module/rocket/parameters/reset_autosuspend ] && \
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend

	log ""
	log "===== 0) the limit's own control. expect rc 124 after ~3s.         ====="
	t0=$(cut -d. -f1 /proc/uptime)
	capped 3 sleep 60
	rc=$?
	t1=$(cut -d. -f1 /proc/uptime)
	log "  -- capped 3 sleep 60  ->  rc $rc after $((t1 - t0))s"
	[ "$rc" = "124" ] || log "  !! THE LIMIT DID NOT FIRE. Nothing below can be trusted to end."

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "##### ROUND 333: a channel is the pair (2r, 2r+1)                 #####"

	log ""
	log "===== 2) THE MEASUREMENT. every stage of the forward pass, NPU on. ====="
	log "=====    matmul stages minus the hardware path = the quantise.     ====="
	rung "the decode loop on the NPU, stages on" \
		CHARSIU_STAGES=1 CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 "$CE" "$HEAD"

	log ""
	log "===== 2b) the same stages with the NPU off, one boot apart.        ====="
	rung "the CPU path, stages on" CHARSIU_STAGES=1 CHARSIU_NPU_QUANT=1

	log ""
	log "===== 2) THE ROUND: a channel is the pair (2r, 2r+1)               ====="
	log "===== 2a CONTROL, today's packing: 64 of 64 and 128 of 256"
	c "$M4" $MM 1 64 64
	c "$M4" $MM 1 2048 256
	log "===== 2b PAIRED packing, no halfk, 0x40b8=3 and 0x3020=2N-1"
	c "CHARSIU_W4=1 CHARSIU_W4_PHANTOM=1" "CHARSIU_OVERRIDE=0x40b8=3,0x3020=0x7f" $MM 1 64 64
	c "CHARSIU_W4=1 CHARSIU_W4_PHANTOM=1" "CHARSIU_OVERRIDE=0x40b8=3,0x3020=0x1ff" $MM 1 2048 256
	c "CHARSIU_W4=1 CHARSIU_W4_PHANTOM=1" "CHARSIU_OVERRIDE=0x40b8=3,0x3020=0x3ff" $MM 1 1024 512
	log "===== 2c the same without the register pair, which must be WORSE"
	c "CHARSIU_W4=1 CHARSIU_W4_PHANTOM=1" $MM 1 64 64
	c "CHARSIU_W4=1 CHARSIU_W4_PHANTOM=1" $MM 1 2048 256

	log ""
	log "===== 3) and the price, if it landed: medians and stalls           ====="
	log "=====    int8 fits 9.3 GB/s, so int4 needs 4.7 to be worth it      ====="
	c "CHARSIU_W4=1" "CHARSIU_OVERRIDE=0x40b8=3,0x3020=0x3ff" "$CE" $BE --nsweep 2048 50
	c "$CE" $BE --nsweep 2048 50

	log ""
	log "===== 5) the standing number, no timers, so they cannot be blamed  ====="
	rung "the decode loop on the NPU" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 "$CE" "$HEAD"

	log ""
	log "===== the anchor again                                             ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== 2a is the control; 2b is the round; 256 of 256 is full width. ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
