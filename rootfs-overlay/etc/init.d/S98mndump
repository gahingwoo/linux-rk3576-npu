#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-22 round 312. ONE REGISTER: 0x40b8.
#
# ROUND 311 ANSWERED THE GATING QUESTION AND IT IS YES. With the whole w4a16
# output stage forced onto an int8 WEIGHT job (CHARSIU_WIDE8=63), the output
# came back as the raw signed 32 bit accumulator:
#
#     0  bytes f3 73 00 00   word    29683   accumulator    29683
#     2  bytes c5 b1 ff ff   word   -20027   accumulator   -20027
#     5  bytes d5 91 ff ff   word   -28203   accumulator   -28203
#     7  bytes 55 74 ff ff   word   -35755   accumulator   -35755
#
# byte for byte, sign extension included. So a projection CAN leave this NPU as
# an accumulator, which is what it has to do: a coefficient buffer's output
# scale is frozen at build time and ffn_down's magnitude moves 2971x between
# tokens.
#
# ⚠ MY PREDICTION WAS WRONG. I said 0x4050 carried the width. Alone it writes
# FEWER bytes (32 of 256) and wedges the block; so does 0x4010 alone (128 bytes,
# wedged). Only the COMPLETE bundle works, and it does not wedge. The half of
# the prediction that held is that the identity requant alone changes nothing.
#
# WHAT IS STILL WRONG: only 160 of 256 bytes are written and only 8 of 64
# elements are right. The output stage is in w4a16 mode; the geometry is not.
#
# ---------------------------------------------------------------------------
# AND THE ANSWER WAS READ OFF THE VENDOR, NOT GUESSED
# ---------------------------------------------------------------------------
#
# The .rkllm's CORE+DPU streams carry the w4a16 output stage as 67 registers, at
# oc = 1024. Diffed against what charsiu emits at M=1 K=4096 N=1024 with
# CHARSIU_WIDE8=63, on the host, with no board:
#
#     0x4004  absent / 0000000e     the conv stream carries this one, not a diff
#     0x4008  absent / 0000001d     same
#     0x4018  0 / 00005000          charsiu's output address, not a diff
#     0x40b8  00000003 / 00000001   <-- THE ONLY REAL DIFFERENCE
#
# Set 0x40b8 = 3 and the two blocks are identical. job.c calls that register
# `ow * (2*oh - window)` and computes 1 at M = 1; the vendor writes 3.
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# 1) ENTRY 2 IS THE CONTROL and must REPRODUCE 311: 160 of 256 bytes, 8 of 64
#    words exact. If it does not, something else moved and entry 3 means nothing.
#
# 2) ENTRY 3 IS THE ROUND. The two numbers:
#      "output bytes moved off the sentinel"   256 of 256 is a full write
#      "reading as WORDS ... exact"            64 of 64 is a correct one
#    Both, or say which one is missing. 256 written with 8 right is a different
#    result from 160 written with 8 right and has to be reported as such.
#
# 3) ENTRY 4 sweeps 0x40b8 anyway. If 3 is not it, the sweep turns a miss into a
#    reading instead of another round.
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT, AND ONE THING WORTH MORE THAN THE ROUND
# ---------------------------------------------------------------------------
#
# A) 0x40b8 = 3 GIVES 256 OF 256 BYTES AND 64 OF 64 WORDS EXACT. The register is
#    the last difference from a stream the vendor actually runs, and the symptom
#    is a partial write.
#
# B) ⚠**IT MAY ALSO UNDO int4's HALF WIDTH.** charsiu's int4 has given
#    `exact = N/2` at every N since round 280 and that was read as a property of
#    the int4 layout. But int4 emits the SAME 0x40b8 = rows, and the vendor
#    writes 3 there too. If entry 5 turns int4's 128 of 256 into 256 of 256,
#    then the "half width" that closed int4 in round 310 was this register all
#    along, and int4 reopens with its 2x intact. That is worth more than
#    everything else in this round, which is why it is here rather than in a
#    later one -- and why it is a PREDICTION and not a hope: N/2 exactly, at
#    four different N, is what a wrong write geometry looks like, not what a
#    wrong weight layout looks like.
#
# C) I do NOT expect the int8 byte path to change. Entry 7 is the regression.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
WD=/opt/charsiu/charsiu_wide
MM=/opt/charsiu/charsiu_matmul
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

c() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $*"; return 0; }
	before=$(nbad)
	sleep 1
	env $1 $2 $3 $4 $5 $6 $7 $8 $9 > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This arm is VOID."; health; }
	return 0
}

M4="CHARSIU_W4=1 CHARSIU_W4_HALFK=1"

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	[ -w /sys/module/rocket/parameters/reset_autosuspend ] && \
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "##### ROUND 312: 0x40b8, the last register between charsiu and    #####"
	log "#####            the vendor's own w4a16 output stage.             #####"

	log ""
	log "===== 2) THE CONTROL. WIDE8=63 alone. must reproduce 311:          ====="
	log "=====    160 of 256 bytes, 8 of 64 words exact.                    ====="
	c "CHARSIU_WIDE8=63" X=1 $WD 1 64 64

	log ""
	log "===== 3) THE ROUND. WIDE8=63 plus 0x40b8 = 3.                      ====="
	c "CHARSIU_WIDE8=63" "CHARSIU_OVERRIDE=0x40b8=3" $WD 1 64 64

	log ""
	log "===== 4) and sweep it, so a miss is still a reading                ====="
	for V in 0 2 4 7 15
	do
		log ""
		log "===== 0x40b8 = $V"
		c "CHARSIU_WIDE8=63" "CHARSIU_OVERRIDE=0x40b8=$V" $WD 1 64 64
	done

	log ""
	log "===== 5) THE ONE WORTH MORE THAN THE ROUND: does it undo int4's    ====="
	log "=====    half width? exact has been N/2 at every N since r280.     ====="
	log ""
	log "===== int4 K=2048 N=256, as it is today"
	c "$M4" X=1 $MM 1 2048 256
	log ""
	log "===== int4 K=2048 N=256 with 0x40b8 = 3"
	c "$M4" "CHARSIU_OVERRIDE=0x40b8=3" $MM 1 2048 256

	log ""
	log "===== 6) and if it worked, at a projection's shape                 ====="
	c "CHARSIU_WIDE8=63" "CHARSIU_OVERRIDE=0x40b8=3" $WD 1 2048 1024

	log ""
	log "===== 7) the int8 byte regression, unchanged either way            ====="
	c X=1 X=1 $MM 1 64 64

	log ""
	log "===== the anchor again                                             ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== control, then 256 of 256 and 64 of 64, then int4's exact.    ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
