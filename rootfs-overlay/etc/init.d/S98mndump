#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-24 round 377. THE 8 MS WAS ALL OF IT, AND IT IS NOT NEEDED.
#
# 🏁 ROUND 376 CLOSED THE ACCOUNT. quantising x came back at 8.10 ms a token at
# 384 tokens and 8.09 at 64 -- the same at both lengths, exactly as the residue
# was. The books now balance:
#
#   384 tok: stage rows 71.39 = quantising x 8.10 + npudev 63.24 + 0.05 left
#    64 tok: stage rows 69.78 = quantising x 8.09 + npudev 62.07 - 0.38 left
#
# So charsiu_act_set IS the residue. Nothing else is hiding.
#
# ⚠ I predicted 3 to 5 ms and wrote "nearer 3, I have been optimistic more
# often than not". It is 8.10. The host to board factor was 12x, not the 5 to 8
# I assumed -- so this time being pessimistic was the error.
#
# ---------------------------------------------------------------------------
# WHAT CHANGED
# ---------------------------------------------------------------------------
#
# The activation is RECORDED, not quantised. Two forms were being built at the
# top of every matvec, 65 times a token, 231 thousand elements twice over:
#
#   blocks of 32   what gguf_matvec's dot kernels take
#   one scale q1   what the NPU's INT8 operand wants, and what npu_matvec
#                  falls back on
#
# **A fully routed int4 run reads NEITHER.** It takes the float activation. The
# quantisations survived only because q1_valid was what gated routing to the
# hardware -- "the hardware may have it" and "it has been computed" being two
# different questions that one flag was answering.
#
# So there is a->npu_ok for the gate, and charsiu_act_blocks and
# charsiu_act_q1 for the consumers. Three call sites, all in llama.c.
#
# ⚠ AND ALL THREE ARE BEFORE THE FAN OUT, never inside gguf_matvec or
# npu_matvec. Those run on four pool workers, and realising a shared buffer
# from all of them would be a race that no sentence check would catch reliably.
#
# ⚠ THE INSTRUMENT HAD TO FOLLOW THE WORK. Timing only charsiu_act_set would
# have read 0.00 whether the quantisation VANISHED or merely MOVED into a
# fallback, and those are the two answers this number exists to separate. The
# realisers are timed as well, so quantising x still means all of it.
#
# CHARSIU_ACT_EAGER builds both up front, which is every round before this one.
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# THE SENTENCES. Arms 1 and 2 must match each other exactly -- lazy and eager
# compute the same numbers, they only differ in when. Five host configurations
# agree, including both quantisation paths.
#
# THEN quantising x IN ARM 1. It should be at or near ZERO: every tensor is
# routed, the hardware takes the float, and nothing asks for either form.
#
# ⚠ AND THEN CHECK THE TOKEN ACTUALLY SHRANK BY WHAT THE ROW LOST. If
# quantising x goes to zero and the token does NOT drop by about 8 ms, then
# those 8 ms were overlapping something else and the stage attribution is wrong
# again. That would be the fourth derived number to go wrong today and it
# should be said, not filed.
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT
# ---------------------------------------------------------------------------
#
# quantising x to zero, the 64 token case 75.9 ms to about 68, which is 13.11
# to about 14.5 tok/s, and the 384 token case 90.5 to about 82.5. Arm 2 to
# reproduce round 376 exactly.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
VD=/opt/charsiu/charsiu_vendor
V=/opt/charsiu/vendor
RGC=$V/vendor-int4-k2048-n1024.regcmd
WT=$V/vendor-wt-1M.bin
IN=$V/vendor-in.bin
RUN=/opt/charsiu/charsiu_run
M8=/opt/charsiu/models/Llama-3.2-1B-Instruct-Q8_0.gguf
PROMPT="The capital of France is"
LIMIT=420
# 32 tokens does not reach the answer to "17 times 24, show your working"
NGEN=64
CE=CHARSIU_COEF_ELEMS=65536
HEAD=CHARSIU_NPU_MAXN=131072
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block did not come back this time."
		ABORT=1
	fi
}

capped() {
	lim="$1"; shift
	"$@" &
	pid=$!
	i=0
	while [ "$i" -lt "$lim" ]; do
		kill -0 "$pid" 2>/dev/null || { wait "$pid"; return $?; }
		sleep 1
		i=$((i + 1))
	done
	kill -9 "$pid" 2>/dev/null
	wait "$pid" 2>/dev/null
	return 124
}
rung() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $1"; return 0; }
	lbl="$1"; shift
	before=$(nbad)
	log ""
	log "  -- $lbl"
	sleep 1
	capped "$LIMIT" env "$@" "$RUN" "$M8" -p "$PROMPT" -n "${NGEN:-32}" \
		--ignore-eos -q -c 512 -t 4 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the rung exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This rung is VOID."; health; }
	return 0
}
# arm: <label> <regcmd-or-dash> <byte> <high> [extra env, one assignment]
#
# ⚠ THE ENV GOES IN AS AN ARGUMENT, not as a "VAR=x arm ..." prefix. Whether an
# assignment before a FUNCTION call survives the call is unspecified -- dash
# drops it, other shells keep it -- and the arm whose whole job is to time out
# WITHOUT the trailer runs right after the one that has it. Not a question worth
# leaving to the shell.
arm() {
	before=$(nbad)
	log ""
	log "  ---- $1"
	sleep 1
	env ${5:-IGNORED=1} $VD "$2" "$WT" "$IN" "$3" "$4" 4096 > /tmp/vd.txt 2>&1
	cat /tmp/vd.txt > "$C"
	after=$(nbad)
	if [ "$after" != "$before" ]; then
		log "  !! POISONED: $((after - before)) new fault or timeout lines"
		health
		# ⚠ NOT a round abort. Round 342 threw away every arm after the
		# first poisoning and then measured the block healthy at the
		# end. The block recovers; give it a moment and carry on.
		ABORT=0
		sleep 2
	fi
}

# two concurrent probes, so the pair can be repeated without copy and paste
pair() {
	before=$(nbad)
	log ""
	log "  ---- $1"
	env CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_TIME=60 CHARSIU_OUT_KB=64 $2 $VD - "$WT" "$IN" 0 0 4096 > /tmp/vdA.txt 2>&1 &
	pidA=$!
	env CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_TIME=60 CHARSIU_OUT_KB=64 $3 $VD - "$WT" "$IN" 0 0 4096 > /tmp/vdB.txt 2>&1 &
	pidB=$!
	wait "$pidA"
	wait "$pidB"
	log "    A:"
	grep -E "M = |TIME:|baseline:|VERIFY:|CONTROL repeat|VOID|REREAD" /tmp/vdA.txt > "$C"
	log "    B:"
	grep -E "M = |TIME:|baseline:|VERIFY:|CONTROL repeat|VOID|REREAD" /tmp/vdB.txt > "$C"
	after=$(nbad)
	[ "$after" != "$before" ] && log "  !! POISONED: $((after - before)) new lines"
	return 0
}

BW=/opt/charsiu/charsiu_membw
DEC="CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 CHARSIU_NPU_W4V=1 CHARSIU_NPU_KMAX=1024 CHARSIU_NPU_W4_GROUP=1024"

# decode and a memory reader at the same time, both numbers kept
squeeze() {
	log ""
	log "  ---- $1"
	sleep 1
	env $DEC "$CE" "$HEAD" "$RUN" "$M8" -p "$PROMPT" -n 128 --ignore-eos \
		-q -c 512 -t 4 > /tmp/dec.txt 2>&1 &
	dpid=$!
	# past staging and into generation before the reader starts
	sleep "$2"
	if [ -n "$3" ]; then
		env CHARSIU_THREADS=4 CHARSIU_SECONDS="$3" $BW > /tmp/bw.txt 2>&1
	fi
	wait "$dpid"
	grep -E "tensors staged|gen 128|GB/s of weights|of that," /tmp/dec.txt > "$C"
	[ -n "$3" ] && cat /tmp/bw.txt > "$C"
	return 0
}

start() {
	log ""
	log "###############################################################"
	log "##### round 377: the activation nobody reads                #####"
	log "###############################################################"
	log "  8.09 ms a token quantising what int4 never looks at."

	B="CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 CHARSIU_NPU_W4V=1 CHARSIU_NPU_KMAX=1024 CHARSIU_NPU_W4_GROUP=1024 CHARSIU_STAGES=1"

	log ""
	log "===== 1) 64 tokens, lazy                                       ====="
	log "  quantising x should be at or near ZERO, and the token"
	log "  must shrink by what the row lost."
	rung "int4 g1024, 64 tokens, lazy" $B "$CE" "$HEAD"

	log ""
	log "===== 2) THE CONTROL: 64 tokens, eager                         ====="
	log "  every round before this one. must reproduce 8.09 ms"
	log "  and 13.11 tok/s, and the SAME sentence as arm 1."
	rung "int4 g1024, 64 tokens, eager" $B CHARSIU_ACT_EAGER=1 "$CE" "$HEAD"

	log ""
	log "===== 3) 384 tokens, lazy                                      ====="
	NGEN=384
	rung "int4 g1024, 384 tokens, lazy" $B "$CE" "$HEAD"
	NGEN=64

	log ""
	log "===== 4) the probe, still exact                                ====="
	arm "solo verify" "-" 0 0 "CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_VERIFY=1 CHARSIU_OUT_KB=64"

	log ""
	log "===== 5) the anchor: int8 conv must still be exact            ====="
	health

	log ""
	log "===== read the CONTROL lines first. VOID means the arm died. ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
