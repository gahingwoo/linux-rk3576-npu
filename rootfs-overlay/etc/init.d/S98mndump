#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-15 round 160. Stop sweeping. Mesa runs this shape across the whole
# byte, so put the two streams side by side and read the difference.
#
# WHAT ROUND 159 SETTLED, AND WHAT IT DID NOT.
#
# Settled: CNA 0x1098 does not matter at M = 1. Entry 4 forced the vendor's 1
# where charsiu writes Mesa's 4 and the output was byte identical, so the one
# register where charsiu's whole stream differed from a vendor convolution at
# this exact shape is closed.
#
# NOT settled, and the failure is mine: entry 3's control was UNFALSIFIABLE. It
# set the stage minimum to 0, which can only floor the channels whose
# accumulator is already negative, and those are exactly the channels the
# symptom already floors. Both branches of the rule predicted the same bytes and
# the run produced them. A control that cannot fail is not a control, and
# "nothing moved" from that entry means nothing at all.
#
# What the new signed print did earn: the floor sits at exactly requant = 0, the
# output zero point, and it is applied BEFORE 0x40ac's offset. Channels 31 to 63
# track the CPU to about 3 counts; channels 0 to 30 are pinned at -128 signed.
#
# THE THING THAT CHANGES THE PLAN, and it was in the same log, in the regression
# entries rather than in charsiu's:
#
#   llm512x1024m1.tflite out(1, 1, 1024): 1024/1024 channels match
#     npu distinct=146 min=0 max=255 | out_zp=0
#
# That is M = 1, 512 to 1024, and MESA SPANS THE WHOLE BYTE on it. Mesa's rule
# for 0x40ac is out_zp - 0x80 and that model's zero point is 0, so Mesa writes
# -128 there, which is exactly what charsiu writes. Same M, same 0x40ac, no
# floor for Mesa and a floor for charsiu. So the floor is not a property of this
# silicon and not the meaning of 0x40ac: there is still a difference between the
# two, and sweeping output registers is guessing at it.
#
# ROUND 160's QUESTION, and its decision rule, written before the run.
#
#   ENTRIES 2 AND 3, THE TEST. Mesa's stream and charsiu's stream for the SAME
#   shape, M = 1, 512 to 1024, dumped in the same boot in the same format. This
#   is the instrument that found the PC_TASK_CON field layout and it has worked
#   every time it has been pointed at anything.
#
#     a register where the two differ
#               that is the answer, and no sweep was needed.
#     the streams are identical entry for entry
#               then the difference is in the COEFFICIENT BUFFER, the one thing
#               a register diff cannot see. Mesa's A is bias - (in_zp-0x80)*sw
#               and charsiu's is its own; that becomes the next round and it is
#               a much smaller place to look than the whole output stage.
#
#   ENTRY 4. CHARSIU_OUT_OFF=0, which is Mesa's own formula for charsiu's output
#   zero point of 128, run on the bias ramp with the signed print. charsiu
#   hardcodes -128 regardless of the zero point; conv2d-cal shows Mesa writing 0
#   for a zero point of 128 and getting output that runs 128 to 255, so the
#   hardware adds that 0x80 itself.
#
#     the ramp comes back 80 to 180 and matches the CPU
#               charsiu's offset rule was simply wrong and Mesa's is right.
#     the ramp caps at 127
#               the clamp is real and independent of the offset, which is what
#               round 157 recorded; entries 2 and 3 then carry the round.
#
#   ENTRIES 5 AND 6, THE CONTROLS, rewritten so they can fail. A minimum ABOVE
#   the whole accumulator range and a maximum BELOW it, both of which bite where
#   the output is currently CORRECT.
#
#     0x406c = 0x2000  every channel flattens high   the minimum is connected
#     0x4070 = 0x100   every channel flattens low    the maximum is connected
#     neither moves
#               the whole 0x406c / 0x4070 stage is not in this datapath, and the
#               activation registers the vendor's compiler names are being
#               written into something that does not read them.
#
# ---------------------------------------------------------------------------
# What earlier rounds settled, kept because the rules below were written against
# it.
#
# 2026-08-15 round 159. There is no fused ReLU. The activation registers were
# already off, and the clamp that looked like one is a sign convention.
#
# ROUND 159's QUESTION, and its decision rule, written before the run.
#
# Rounds 155 to 158 read charsiu's output as clamped into 0 to 127 before
# 0x40ac's offset, called the floor a fused ReLU that no Teflon model has ever
# needed switched off, and set out to sweep the DPU output registers for its
# enable. Two things settled offline before this image was built say that plan
# was aimed at nothing.
#
# FIRST, the enable has a name and charsiu already writes it. Compiling ONE int8
# convolution twice, with and without a ReLU, and diffing the two register
# streams (vendor-capture/gen_act.py) names three registers: 0x4060 is 0x0902
# with the ReLU and 0x0903 without, and 0x406c and 0x4074 are stage minimums, 0
# with it and INT32_MIN without. The maximums at 0x4070 and 0x4078 do not move,
# which is what a ReLU is, a floor and not a ceiling. A third model, linear again
# with different weights, is the control that separates activation from data, and
# it bites: 0x40ac and 0x40b0 move between the two linears and those three do
# not. charsiu has emitted all three at their linear values since round 143.
#
# SECOND, the 0x0310 that round 158 spent itself on was a misreading of mine.
# The .rkllm streams that carry 0x03ff0310 have ONE output channel and ZERO
# weight bytes, so they are not the vendor's matmuls; the 8308 streams that ARE
# the projections do not write 0x4030 at all. The vendor's compiler, asked for
# charsiu's exact shape, writes 0x003f0710, which is what charsiu already had.
#
# So the fused ReLU is refuted, and what is left is what 0x40ac actually means.
# The vendor writes the output zero point there in the hardware's SIGNED domain:
# -27 for a model whose zero point is 101. charsiu's is 128, so it writes -128,
# and the byte that comes back is requant - 128 in two's complement, whose
# UNSIGNED reading is the correct output byte because the wrap does the +128.
# An output that is right is then indistinguishable from one stuck at 128 unless
# the signed reading is printed beside it, and it never was.
#
#   ENTRY 2, the test. CHARSIU_CONST holds every input at the zero point so the
#   MAC is exactly zero and the output is requant(bias) alone, a ramp the CPU
#   says runs 80 to 180. charsiu_matmul now prints four rows: the npu unsigned,
#   the cpu, the npu read as SIGNED, and the cpu's requant before the zero point.
#
#     npu unsigned tracks cpu across all 64 channels
#               charsiu's arithmetic is finished and the runtime is next.
#     npu signed tracks cpu requant while unsigned does not
#               the output is signed, the clamp never existed, and only the
#               comparison was wrong.
#     the low channels come back at ONE value and the high ones ramp
#               a real floor exists. It is not the activation stage, because
#               entry 3 shows that stage responds, so the next suspect is the
#               A record of the coefficient buffer.
#
#   ENTRY 3, THE CONTROL THAT CAN FAIL. The same run with CHARSIU_DPU_406C=0,
#   which is the value the vendor's compiler emits for a ReLU.
#
#     the output loses its low half against entry 2
#               0x406c IS the minimum, the offline identification holds, and
#               entry 2's setting was already correct.
#     nothing changes at all
#               the identification is WRONG. 0x406c is not the activation
#               minimum on this path and the offline diff has to be redone
#               before any more board time goes on the output stage.
#
#   ENTRY 4. CHARSIU_CNA_1098=1, the vendor's value. It is the ONLY register in
#   charsiu's whole 142 entry stream that differs from the vendor's convolution
#   at this exact shape once addresses, this model's quantisation and the four op
#   enables are set aside, and it has never been tested.
#
#     identical to entry 2   the register does not matter at M = 1.
#     different              an input DMA size that has been wrong throughout.
#
# ---------------------------------------------------------------------------
# What earlier rounds settled, kept because the rules below were written against
# it.
#
# 2026-08-14 round 158. 0x0310 opened the clamp; where did the ramp go?
#
# Round 139 finished the pointwise: every odd output channel count came out
# exact, its ROCKET_OC_ODD control reproduced the old failure to the channel,
# and MobileNet reached 1000 of its 1001 outputs within one count of the CPU.
# It also settled the question charsiu starts from: 512 to 1024 at M = 1, 2, 3,
# 4 and 8 are all exact, so a single row matmul is a shape this silicon computes
# and the RK3588 height-below-four constraint is not on it.
#
# Nothing in Mesa or the kernel changed for this round. The new thing is a
# BINARY, /opt/charsiu/charsiu_probe, which is charsiu talking to the NPU
# through the rocket uAPI directly, with no Mesa and no delegate in the path.
#
# It computes nothing. It opens /dev/accel/accel0, allocates a buffer object,
# checks the DMA address it gets back is inside the 32 bit window a register
# stream can address, writes a pattern through the CPU mapping, hands the buffer
# back with FINI, takes it again with PREP, and reads the pattern back. That is
# the whole of the path a real submit needs underneath it, and every later
# charsiu failure is easier to read once this line is known good.
#
# DECISION RULE, written before the run:
#
#   ROUND 141 adds the real thing: /opt/charsiu/charsiu_matmul packs the
#   operands, builds the coefficient buffer, emits the whole register stream,
#   submits it through rocket and compares what comes back against the same
#   arithmetic on the cores. No Mesa, no vendor runtime, nothing borrowed at
#   run time.
#
#   Every register value in that stream is ported from the Mesa RK3576 path,
#   which is verified byte exact on this silicon, and the geometry is checked
#   against the vendor's own LLM dispatches offline. Nothing in it was guessed.
#
#   DECISION RULE for entry 2, written before the run:
#
#     output written and within one count of the CPU
#               charsiu computes. The runtime is then engineering.
#     output written but wrong
#               the operand packing or the coefficient buffer is wrong, and the
#               values printed beside it say which: a wrong scale moves every
#               byte together, a wrong layout moves some and not others.
#     the sentinel 0xa5 survives
#               an EMPTY convolution: nothing was written at all. That is the
#               coefficient buffer, every time it has happened here.
#     submit fails
#               the stream is malformed and the kernel rejected it, which is a
#               different and much shorter list of causes.
#
#   ROUND 157's QUESTION. The output stage clamps the requant result into 0 to
#   127 before 0x40ac's offset is applied, so with the offset the top of the
#   byte is reachable and the bottom is stuck at 128, and with the fold the
#   bottom is right and the top caps at 127. One register has to open that
#   clamp.
#
#   The vendor names a candidate. Its convolution streams carry exactly ONE DPU
#   register, 0x4030, and its low half is 0x0310 where Mesa's regular
#   convolution path writes 0x0710. Mesa uses 0x0310 for a DEPTHWISE layer, so
#   the field is not "depthwise": it selects something about the output that a
#   depthwise and a vendor matmul share and a Teflon convolution does not.
#
#     the ramp reaches both 80 and 180 under any of these
#               the clamp is open and charsiu's arithmetic is finished
#     nothing moves
#               the field is elsewhere; the remaining unswept output registers
#               are 0x40c0, 0x40d0 and 0x4060, and 0x40d0's 0x0040ffff looks
#               most like a pair of limits
#
#   ROUND 155's QUESTION, and its decision rule. charsiu's output saturates at
#   127 where the reference reaches 180, so 128 to 255 cannot be represented at
#   all. Every register in the stream matches Mesa's except the four that carry
#   the model's own quantisation, and 0x40ac is among them. It is already known
#   NOT to be an output domain addend (round 153 saturated the surface by
#   writing the zero point there), so the sweep asks whether it selects the
#   output's sign convention instead.
#
#     any value makes the ramp exceed 127
#               that value is the unsigned output mode and charsiu can finish
#               the calibration.
#     all four cap at 127
#               the mode is elsewhere, and the next place to look is the four
#               DPU registers whose values were excluded from the stream diff
#               as "quantisation" without checking what they do.
#
#   ROUND 141 hit a fifth outcome the rule did not name: the kernel ACCEPTED the
#   stream and the job timed out, with the IOMMU failing its stall on the way
#   down. The cause was that nothing in the stream engaged the units. A register
#   stream is not a program until its last four entries turn the units on, at
#   their own op enables, with the 0x1d mask, in reverse data flow order: DPU,
#   RDMA, CORE, then CNA last. Round 142 adds exactly that, and the four
#   S_POINTER writes at 0x1004, 0x3004, 0x4004 and 0x5004 rather than two.
#
#   open ok, dma in the window, readback ok
#             charsiu's device layer works, and the next piece is the register
#             stream, which already matches the vendor's geometry offline.
#   the DMA address is above the 32 bit window
#             a register stream BO has to be allocated differently, and that is
#             better learned now than while debugging a wrong result.
#   readback MISMATCH
#             the cache maintenance is wrong, which would silently corrupt every
#             weight buffer later. Nothing else charsiu does could be trusted
#             until it is fixed.
#
# The rest is regression, so the image itself is known sane, plus the two shapes
# still open in Mesa, measured rather than chased:
#
#   pw33x64w56    33 input channels, still wrong after the packed row cost that
#                 fixed 48.
#   pw64x56w56    56 output channels TIMES the NPU out. Even, and its coefficient
#                 operand is aligned, so none of the last three fixes touch it.
#
# The timing out shape runs LAST, as it has since round 138: the entry after a
# timeout comes back flat 128 with an rk_iommu reset error beside it, and that
# collateral was read as a result twice before it was understood.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
p() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== 1) THE TEST: charsiu opens the NPU on its own ====="
	log ""
	/opt/charsiu/charsiu_probe > "$C" 2>&1
	log "  charsiu_probe exit $?"

	log ""
	log "===== 2) THE TEST: MESA's stream for M=1 512 to 1024, which ====="
	log "=====    spans 0 to 255 on this hardware.  Lines are RC ...  ====="
	log ""
	env TEFLON_LIB=/usr/lib/libteflon.so ROCKET_DUMP_REGCMD=1 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/llm512x1024m1.tflite" > "$C" 2>&1

	log ""
	log "===== 3) THE TEST: CHARSIU's stream for the SAME shape.      ====="
	log "=====    Lines are CS ...  Diff them by register.            ====="
	log ""
	CHARSIU_DUMP=1 /opt/charsiu/charsiu_matmul 1 512 1024 > "$C" 2>&1
	log "  charsiu_matmul exit $?"

	log ""
	log "===== 4) MESA's offset rule on charsiu's ramp: 0x40ac = 0 ====="
	log ""
	CHARSIU_CONST=1 CHARSIU_OUT_OFF=0 /opt/charsiu/charsiu_matmul 1 64 64 > "$C" 2>&1
	log ""
	log "  -- and the baseline it has to be read against, -128"
	CHARSIU_CONST=1 /opt/charsiu/charsiu_matmul 1 64 64 > "$C" 2>&1

	log ""
	log "===== 5) CONTROL: minimum 0x2000, ABOVE the whole range ====="
	log ""
	CHARSIU_CONST=1 CHARSIU_DPU_406C=0x2000 /opt/charsiu/charsiu_matmul 1 64 64 > "$C" 2>&1

	log ""
	log "===== 6) CONTROL: maximum 0x100, BELOW the whole range ====="
	log ""
	CHARSIU_CONST=1 CHARSIU_DPU_4070=0x100 /opt/charsiu/charsiu_matmul 1 64 64 > "$C" 2>&1

	log ""
	log "===== 7) REGRESSION, so the image is known sane ====="
	p mn_conv0.tflite ""
	p conv2d-cal.tflite ""
	p pw64x41w56.tflite ""

	log ""
	log "===== 8) MobileNet end to end ====="
	p mobilenet_v1_1.0_224_quant.tflite ""

	log ""
	log "===== 9) still open: 33 input channels ====="
	p pw33x64w56.tflite ""

	log ""
	log "===== 10) LAST, because it times out and poisons whatever follows ====="
	p pw64x56w56.tflite ""

	log ""
	log "===== Entries 2 and 3 are the round. Everything else is a rule that ====="
	log "===== was written before a stream diff was available.                ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
