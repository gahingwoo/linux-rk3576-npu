#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-23 round 352. int4 IN THE DECODE LOOP. COUNT THE TOKENS.
#
# ✅✅ ROUND 351: int4 IS BYTE EXACT THROUGH OUR OWN PACKERS, AND FASTER AT
# EVERY SHAPE.
#
#   K=2048 N=256    256 of 256    worst 0.00e+00
#   K=2048 N=1024  1024 of 1024   worst 0.00e+00
#   K=1024 N=2048  2048 of 2048   worst 0.00e+00
#   CHARSIU_W4_BITPAT                0 of 1024, nan and zero in the output
#
# Not "within a tolerance" -- EQUAL. Round 350's 2.4e-04 really was my
# reference multiplying by a float32 the fp16 packer never handed the hardware.
#
#     N      int4      int8      int4 is
#     256    151.3     229.0     1.51x faster
#     512    158.8     283.0     1.78x
#     1024   239.0     353.0     1.48x
#     2048   367.0     520.0     1.42x
#
# Slopes: int4 128.8 us per MiB (8.14 GB/s), int8 81.6 (12.85 GB/s). int4 moves
# each byte slower and has half as many, and the halving wins at every point.
#
# ---------------------------------------------------------------------------
# WHAT IS NEW IN THE CODE
# ---------------------------------------------------------------------------
#
# CHARSIU_NPU_W4V is the int4 DECODE path, and it is OPT IN. The int8 path
# produces tokens identical to the CPU at 6.55 tok/s and is not being replaced
# by one that has never decoded a sentence.
#
# It takes the REAL float activation, not the int8 quantised one, so it has no
# input zero point, no wsum correction and no d1 in the dequantisation -- and
# it skips charsiu_act's quantisation entirely, which is 10.1 ms of a 153 ms
# token on the CPU side. So there are two savings in this arm and they are not
# separable in the total; the stage table separates them.
#
# CHARSIU_NPU_W4V also forces the quantiser to four bits, because one switch
# choosing the layout and the registers while another leaves the weights at
# eight would be a fault nobody could see.
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# ENTRY 1 IS THE STANDING NUMBER and it is the control: int8, which must still
# be 6.55 tok/s and must still print the same sentence. If it moved, something
# in this change touched the path it was not supposed to touch.
#
# ENTRY 2 IS THE ANSWER. Two things to read and they are different questions:
#
#   THE RATE. The bounded estimate from round 351 is 8.8 to 10.6 tok/s. Below
#   6.55 means the projections are not where the time goes and the arithmetic
#   was for nothing at this scale.
#
#   THE TEXT. int4 weights are int4 weights: the sentence WILL differ from the
#   int8 one somewhere, and that is not a bug. What would be a bug is garbage,
#   repetition, or a wall of one token.
#
# ENTRY 3 is the same prompt on the CPU, so the two NPU arms have something
# that is not each other to be compared against.
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT
# ---------------------------------------------------------------------------
#
# Somewhere between 8 and 10 tok/s and a sentence that reads as English but is
# not word for word the int8 one. The way this goes wrong, if it does, is the
# weight scales: the hardware returns sum of code times activation and the
# dequantisation is now ONE multiply per channel with no d1, which is a line I
# changed in two places and have not run once.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
VD=/opt/charsiu/charsiu_vendor
V=/opt/charsiu/vendor
RGC=$V/vendor-int4-k2048-n1024.regcmd
WT=$V/vendor-wt-1M.bin
IN=$V/vendor-in.bin
RUN=/opt/charsiu/charsiu_run
M8=/opt/charsiu/models/Llama-3.2-1B-Instruct-Q8_0.gguf
PROMPT="The capital of France is"
LIMIT=420
CE=CHARSIU_COEF_ELEMS=65536
HEAD=CHARSIU_NPU_MAXN=131072
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block did not come back this time."
		ABORT=1
	fi
}

capped() {
	lim="$1"; shift
	"$@" &
	pid=$!
	i=0
	while [ "$i" -lt "$lim" ]; do
		kill -0 "$pid" 2>/dev/null || { wait "$pid"; return $?; }
		sleep 1
		i=$((i + 1))
	done
	kill -9 "$pid" 2>/dev/null
	wait "$pid" 2>/dev/null
	return 124
}
rung() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $1"; return 0; }
	lbl="$1"; shift
	before=$(nbad)
	log ""
	log "  -- $lbl"
	sleep 1
	capped "$LIMIT" env "$@" "$RUN" "$M8" -p "$PROMPT" -n 32 \
		--ignore-eos -q -c 512 -t 4 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the rung exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This rung is VOID."; health; }
	return 0
}
# arm: <label> <regcmd-or-dash> <byte> <high> [extra env, one assignment]
#
# ⚠ THE ENV GOES IN AS AN ARGUMENT, not as a "VAR=x arm ..." prefix. Whether an
# assignment before a FUNCTION call survives the call is unspecified -- dash
# drops it, other shells keep it -- and the arm whose whole job is to time out
# WITHOUT the trailer runs right after the one that has it. Not a question worth
# leaving to the shell.
arm() {
	before=$(nbad)
	log ""
	log "  ---- $1"
	sleep 1
	env ${5:-IGNORED=1} $VD "$2" "$WT" "$IN" "$3" "$4" 4096 > /tmp/vd.txt 2>&1
	cat /tmp/vd.txt > "$C"
	after=$(nbad)
	if [ "$after" != "$before" ]; then
		log "  !! POISONED: $((after - before)) new fault or timeout lines"
		health
		# ⚠ NOT a round abort. Round 342 threw away every arm after the
		# first poisoning and then measured the block healthy at the
		# end. The block recovers; give it a moment and carry on.
		ABORT=0
		sleep 2
	fi
}

start() {
	log ""
	log "###############################################################"
	log "##### round 352: int4 in the decode loop. count the tokens. #####"
	log "###############################################################"
	log "  int4 is byte exact and 1.42 to 1.78x faster. now decode with it."

	log ""
	log "===== 1) CONTROL: the standing int8 decode. 6.55 tok/s.       ====="
	rung "int8 decode, the standing number" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 "$CE" "$HEAD"

	log ""
	log "===== 2) THE ANSWER: int4 decode                              ====="
	log "  read the RATE and the TEXT separately. the sentence WILL"
	log "  differ from int8's; garbage or repetition is the bug."
	rung "int4 decode" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 CHARSIU_NPU_W4V=1 "$CE" "$HEAD"

	log ""
	log "===== 3) the CPU, so the two arms have a third thing to face  ====="
	rung "cpu only" CHARSIU_NO_NPU=1

	log ""
	log "===== 4) the matmul is still exact under the decode's own      ====="
	log "  packers, so a bad sentence cannot be blamed on the block.    "
	arm "generated, N=1024" "-" 0 0 "CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_VERIFY=1 CHARSIU_OUT_KB=64"

	log ""
	log "===== 5) the anchor: int8 conv must still be exact           ====="
	health

	log ""
	log "===== read the CONTROL lines first. VOID means the arm died. ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
