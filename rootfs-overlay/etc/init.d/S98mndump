# ---------------------------------------------------------------------------
# 2026-08-11 round 90. The last 0.12 percent of conv0's multiplier.
#
# Round 89's void check worked and its answer was negative. T=20 wrecks conv0,
# within 1 falling to 42.3 percent, and T=10 degrades it to 59.5, so the knob
# reaches. T=2, 4 and 6 change NOTHING: 99.5, 99.5, 99.6, 99.7 and 7.9 percent
# at a rail, identical at every one. So the requant multiply is not wrapping
# int32 and that hypothesis is dead, killed with a control that demonstrably
# bites.
#
# A second thing died offline. The nine channels conv0 gets right are exactly
# the nine with a NEGATIVE bias, whose reference is ReLU clipped flat to zero,
# which is why perch counts all nine as trivial and none as COMPUTED. So "the
# wrong channels have larger biases" is an artefact of which references are
# constant, not a per-channel fault: every channel whose reference varies is
# wrong.
#
# conv0 is therefore uniformly slightly off rather than broken in a few places,
# and the one number left is the multiplier. The affine fit measured the need
# as 0.000452413, precise to about 0.014 percent since a itself is good to
# 0.0001, and the derived value writes 0.000452965, which is 0.122 percent
# high. In counts that is 0.31 of an LSB at full scale, enough to push a pixel
# already near a boundary over it, and 0.5 percent of pixels are off by more
# than one.
#
#   0x7699 at shift 26   0.000452414   the measured need, to six digits
#   0x76be at shift 26   0.000452965   what the generic mantissa gives
#
# The generic formula truncates the float mantissa and adds one, which lands on
# 0x76be. Whether the remaining gap is that truncation or something structural
# is what this asks: if 0x7699 improves the residual, the multiplier wants
# rounding rather than truncation and it is derivable; if it does not, the
# gap is not what is costing the 0.5 percent.
#
# DECISION RULE, written before the run:
#   0x7699 improves the residual     the multiplier is the last of it, and
#                                    rounding the mantissa is the fix
#   no scale in the sweep helps      0.12 percent is not what costs the half
#                                    percent, and the next question is the
#                                    rounding MODE of the requant rather than
#                                    its magnitude
#   the sweep does not move at all   the knob is not reaching, which the two
#                                    far values in it are there to disprove
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
p() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== 1) conv0 as it stands, 0x76be ====="
	p mn_conv0.tflite ""

	log ""
	log "===== 2..4) the measured need and its neighbours ====="
	p mn_conv0.tflite ROCKET_FC_SCALE=0x7699
	p mn_conv0.tflite ROCKET_FC_SCALE=0x7698
	p mn_conv0.tflite ROCKET_FC_SCALE=0x76a8

	log ""
	log "===== 5..6) far either way, so the knob is proved to bite ====="
	p mn_conv0.tflite ROCKET_FC_SCALE=0x7000
	p mn_conv0.tflite ROCKET_FC_SCALE=0x7fff

	log ""
	log "===== 7) the impulse model at the measured need ====="
	p fc_imp.tflite ROCKET_FC_SCALE=0x7699

	log ""
	log "===== 8) the chain ====="
	p mn_conv0dw1.tflite ROCKET_FC_SCALE=0x7699

	log ""
	log "===== 9..11) REGRESSION ====="
	p conv2d-cal.tflite ""
	p mn_dw1.tflite ""
	p mn_dw25.tflite ""

	log ""
	log "===== Read the residual line, not the channel count: a channel    ====="
	log "===== fails on one pixel out of 12544, so within-1 is the signal. ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
