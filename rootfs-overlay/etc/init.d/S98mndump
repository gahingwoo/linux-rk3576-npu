#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-23 round 347. DOES IT SURVIVE M = 1, WHICH IS THE ONE WE NEED.
#
# 🔑🔑🔑 ROUND 346 VERIFIED THE WHOLE int4 PATH ON THE BOARD.
#
#   VERIFY: 1275 of 1280 words within 1e-5 relative, worst 1.44e-05
#
# under the merge AND, identically, under the vendor's own 123 registers with
# the three enables appended. Their registers, their weights, their
# activations, our driver, every live word against a CPU reference.
#
# ⚠ The five that missed 1e-5 are not misses: the board and the reference agree
# to every printed digit (+0.086638 against +0.086639). 1e-5 was too tight for a
# float32 result summed against 2048 double terms with cancellation. The tool
# now prints 1e-4 and 1e-5 side by side and 1e-4 is the one to read.
#
# A check I did not design and which passed anyway: **2816 words where the board
# wrote zero are exactly the ones where the reference computes zero**, because
# only 15% of the vendor's activation buffer is nonzero.
#
# THE BISECT, honestly: 0x3018 is the register that changes the arithmetic --
# its baseline's first four words equal the merged ones exactly -- but alone it
# wedged the block (19 fault lines), 0x301c alone was VOID, and 0x3020 alone
# FAILED ITS REPEAT CONTROL so it is not readable at all. All three together is
# clean and reproduces. So: 0x3018 switches, the other two are needed to run.
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# EVERYTHING ABOVE IS AT M = 32, BECAUSE THAT IS WHAT THE VENDOR CAPTURED. The
# decode loop charsiu actually needs is M = 1, and every stride in the decode
# depends on M:
#
#     input  slot (k,m) = 8*M*(k/8) + 8*m + k%8    ->  k     at M = 1
#     output word (n,m) = 4*(M*(n/4) + m) + n%4    ->  n     at M = 1
#     weight nibble(n,k)                            unchanged, no M in it
#
# So at M = 1 both surfaces collapse to plain order, which is either very
# convenient or a sign that M = 1 takes a different path entirely.
#
# ENTRY 1 is the anchor: the merge at M = 32, which must reproduce 1280 of 1280.
# If it does not, the tool changed and nothing else counts.
#
# ENTRY 2 is the question: M = 1 with only the three CORE registers, which are
# the ones that are M safe -- 0x3018 is constant, 0x301c is M-1 in the low half
# and charsiu already writes 0 there at M = 1, 0x3020 is N-1.
#
# ENTRY 3 maps the layout at M = 1 whatever entry 2 says, so a failure is
# located rather than just recorded.
#
# ENTRY 4 is the contrast: the FULL merge at M = 1, which carries M = 32
# geometry and should therefore be wrong. If it passes anyway, the other
# seventeen registers do not depend on M and I have the wrong model of them.
#
# ENTRY 5 is M = 8, so the M dependence is three points and not two.
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT
# ---------------------------------------------------------------------------
#
# Entry 2 passes. The weight formula has no M in it, the two surfaces collapse
# to the identity, and the three CORE registers carry no M except through a
# field charsiu already computes. But the live word count moved between the
# merge and CORE-only at M = 32 (1280 against 1756), so the extent is not
# something I understand yet, and extent is exactly what M changes.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
VD=/opt/charsiu/charsiu_vendor
V=/opt/charsiu/vendor
RGC=$V/vendor-int4-k2048-n1024.regcmd
WT=$V/vendor-wt-1M.bin
IN=$V/vendor-in.bin
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block did not come back this time."
		ABORT=1
	fi
}

# arm: <label> <regcmd-or-dash> <byte> <high> [extra env, one assignment]
#
# ⚠ THE ENV GOES IN AS AN ARGUMENT, not as a "VAR=x arm ..." prefix. Whether an
# assignment before a FUNCTION call survives the call is unspecified -- dash
# drops it, other shells keep it -- and the arm whose whole job is to time out
# WITHOUT the trailer runs right after the one that has it. Not a question worth
# leaving to the shell.
arm() {
	before=$(nbad)
	log ""
	log "  ---- $1"
	sleep 1
	env ${5:-IGNORED=1} $VD "$2" "$WT" "$IN" "$3" "$4" 4096 > /tmp/vd.txt 2>&1
	cat /tmp/vd.txt > "$C"
	after=$(nbad)
	if [ "$after" != "$before" ]; then
		log "  !! POISONED: $((after - before)) new fault or timeout lines"
		health
		# ⚠ NOT a round abort. Round 342 threw away every arm after the
		# first poisoning and then measured the block healthy at the
		# end. The block recovers; give it a moment and carry on.
		ABORT=0
		sleep 2
	fi
}

start() {
	log ""
	log "###############################################################"
	log "##### round 347: does it survive M = 1 #####"
	log "###############################################################"
	log "  no fitted reference. one nibble changes, the output difference"
	log "  is that nibble. a straight line means int4 is real."

	log ""
	log "===== 1) ANCHOR: the merge at M=32. must give 1280 of 1280.   ====="
	arm "anchor, merge M=32" "+$RGC" 0 0 CHARSIU_VERIFY=1

	log ""
	log "===== 2) THE QUESTION: M=1, the three CORE registers          ====="
	log "  0x301c is M-1 in the low half, so it is 0 at M=1."
	arm "M=1, CORE three" "-" 0 0 "CHARSIU_M=1 CHARSIU_VERIFY=1 CHARSIU_OVERRIDE=0x3018=0x10000200,0x301c=0x00000000,0x3020=0x000003ff"

	log ""
	log "===== 3) the layout at M=1, 32 bytes, whatever entry 2 said   ====="
	arm "M=1 slope map" "-" 0 0 "CHARSIU_M=1 CHARSIU_SLOPE_MAP=32 CHARSIU_OVERRIDE=0x3018=0x10000200,0x301c=0x00000000,0x3020=0x000003ff"

	log ""
	log "===== 4) CONTRAST: the full merge at M=1. carries M=32 values ====="
	log "  and should therefore be wrong. if it passes, my model of the"
	log "  other seventeen registers is wrong."
	arm "M=1, full merge" "+$RGC" 0 0 "CHARSIU_M=1 CHARSIU_VERIFY=1"

	log ""
	log "===== 5) M=8, so the M dependence is three points not two     ====="
	log "  0x301c = M-1 = 7 here, NOT the 0x1f the M=32 capture carries."
	arm "M=8, CORE three" "-" 0 0 "CHARSIU_M=8 CHARSIU_VERIFY=1 CHARSIU_OVERRIDE=0x3018=0x10000200,0x301c=0x00000007,0x3020=0x000003ff"

	log ""
	log "===== 6) CONTROL: charsiu's own stream at M=32. old sixteen.  ====="
	arm "control arm, this tree's stream" "-" 0 0

	log ""
	log "===== 8) the anchor: int8 conv must still be exact           ====="
	health

	log ""
	log "===== read the CONTROL lines first. VOID means the arm died. ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
