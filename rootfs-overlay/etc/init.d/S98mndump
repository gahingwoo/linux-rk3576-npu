# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-13 round 139. The CNA counts output channels in pairs.
#
# Round 138 landed the operand alignment and it was the right call:
#
#   oc 34   EMPTY -> 34 of 34 maxdiff 1      the control, ROCKET_SCALE_NOPAD=1,
#   oc 36   EMPTY -> 36 of 36 maxdiff 1      put the empty convolution straight
#   oc 40   40 of 40, untouched              back, and 40, 64, 48-input, mn_L03,
#   oc 64   64 of 64, untouched              mn_L04, conv2d-cal and mn_conv0 all
#                                            came out unchanged
#
#   MOBILENET produced a real output for the first time: 995 of 1001 within one
#   count of the CPU, with 10 distinct values against the CPU's 10, where every
#   run before this was 1001 channels of zero.
#
# What is left is exactly the ODD output channel counts. 33, 41 and 47 compute
# now, but every one of their wrong channels is in the second weight tile:
#
#   oc 33   wrong {32}                   oc 34, 36, 40, 64   nothing wrong
#   oc 41   wrong {32, 35, 37, 40}
#   oc 47   wrong {32, 35, 37, 40, 42, 45, 46}
#
# and their COMPUTED-correct lists stop at channel 31 in all three.
#
# The vendor says why, in one number. At 64 input and 41 output channels it
# emits 2688 weight bytes, which is 64 by 42, and 0x1024 reads 41, which is 42
# channels less one. Its CORE 0x3020, DPU 0x402c and RDMA 0x5014 all still read
# 40, the real count less one. So the CNA is told a whole number of output
# channel PAIRS and reads the weights for all of them, and nothing else is.
#
# This driver emitted 2624 bytes and 40, and laid the weight tiles out with an
# odd stride, which moves every address in the second tile.
#
# DECISION RULE, written before the run:
#
#   33, 41 and 47 come out whole and the even counts do not move
#             the pair padding was it, and the pointwise is finished.
#   they improve but keep wrong channels in the second tile
#             the stride is right and the padding channel's CONTENT matters.
#             It is zeroed here; the vendor's blob suggests a copy.
#   an even count moves at all
#             impossible by construction: ALIGN(oc, 2) is oc for all of them,
#             so their bytes and registers are identical. That would mean the
#             change is reaching something it should not.
#
# CONTROL that can fail: entry 4 runs 41 with ROCKET_OC_ODD=1, which puts the
# unpadded count back and must reproduce today's 37 of 41 with the same four
# wrong channels.
#
# ⚠ pw64x56w56 still TIMES OUT, and the entry after a timeout comes back flat
# 128 with an rk_iommu reset error. It runs last, as in round 138.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
p() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== 1..3) THE TEST: the odd output channel counts ====="
	p pw64x41w56.tflite ""
	p pw64x33w56.tflite ""
	p pw64x47w56.tflite ""

	log ""
	log "===== 4) CONTROL: 41 with the odd count left alone ====="
	p pw64x41w56.tflite "ROCKET_OC_ODD=1"

	log ""
	log "===== 5..8) the even counts, whose bytes cannot change ====="
	p pw64x34w56.tflite ""
	p pw64x36w56.tflite ""
	p pw64x40w56.tflite ""
	p pw64x64w56.tflite ""

	log ""
	log "===== 9) the whole MobileNet ====="
	p mobilenet_v1_1.0_224_quant.tflite ""

	log ""
	log "===== 10..14) REGRESSION ====="
	p pw48x64w56.tflite ""
	p mn_L04.tflite ""
	p mn_L03.tflite ""
	p conv2d-cal.tflite ""
	p mn_conv0.tflite ""

	log ""
	log "===== 15) LAST, because it times out and poisons whatever follows ====="
	p pw64x56w56.tflite ""

	log ""
	log "===== Entry 4 must reproduce 37 of 41 with wrong {32,35,37,40}. ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
