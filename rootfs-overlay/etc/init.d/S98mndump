#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-19 round 248. The lift, and whether the clamp was always the silicon.
#
# WHAT CHANGED. charsiu measured this output stage on this silicon in its own
# round 163, with a control that separates a floor at zero from a rail at -128,
# and wrote the result into src/job.c:
#
#     out = clamp(max(requant, 0) + offset, -128, 127)
#
# The clamp comes BEFORE the offset, so a negative requant is gone before the
# offset can do anything about it. There IS a fused ReLU. That is the floor
# conv2d-cal has shown since June, and it means the MR's "It is not the
# silicon" is wrong, whatever the vendor does on top of it.
#
# charsiu also has the compensation and says it costs nothing. Add 128/mult to
# A, which raises the surface by exactly 128 in the requant domain and puts
# every value a signed byte can hold above the floor; offset = out_zp - 0x80,
# which this driver already emits, takes the same 128 back. The lift lives in
# an int32 accumulator and comes out in the output domain.
#
# ⚠ WHAT IS NOT SETTLED. charsiu's 128 was measured against charsiu's output
# convention and I could not settle offline whether Mesa's is the same one. So
# the amount is a knob, not a constant, and entries 3 to 5 sweep it. If the two
# conventions agree, 128 is right. If they do not, the sweep says by how much.
#
# THE READING RULE, fixed before the run.
#
#   Read entry 1 FIRST. It is ROCKET_NO_LIFT=1 and it must reproduce rounds 240
#   through 247 exactly: 128 of 128 against max(cpu,zp), npu min 128, and 0 of
#   128 against the UNCLAMPED cpu. If it does not, the default changed the build
#   in a way I did not intend and the whole round is void.
#
#   The answer is entry 2's "vs UNCLAMPED cpu" count, which has been 0 of 128
#   every round since the metric existed. 128 of 128 means solved. 0 of 128
#   means the lift does nothing in this direction and the sweep is what is left
#   to read.
#
#   Entries 7 and 8 are the regression guard, and they are NOT a formality. The
#   lift is not invisible at out_zp 0: it shifts the requant up and the offset,
#   which is -128 there, is what takes it back. If those two break, the offset
#   does not compensate and the port is wrong even if entry 2 looks better.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
log() { echo "$@" > "$C"; }
w() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null

	log ""
	log "===== 1) THE CONTROL, and read it first. No lift, so this must    ====="
	log "=====    reproduce 240 to 247 exactly: 128/128 clamped, npu min   ====="
	log "=====    128, and 0/128 against the UNCLAMPED cpu. If it does     ====="
	log "=====    not, the round is void.                                  ====="
	w conv2d-cal.tflite "ROCKET_NO_LIFT=1"

	log ""
	log "===== 2) THE QUESTION. charsiu's 128. Read the UNCLAMPED count.   ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== 3-5) the sweep, in case 128 is the wrong amount for this    ====="
	log "=====      driver's convention. Whichever maximises UNCLAMPED     ====="
	log "=====      names the convention.                                  ====="
	w conv2d-cal.tflite "ROCKET_LIFT=64"
	w conv2d-cal.tflite "ROCKET_LIFT=192"
	w conv2d-cal.tflite "ROCKET_LIFT=256"

	log ""
	log "===== 6) the control again, so a drift across the log is visible  ====="
	w conv2d-cal.tflite "ROCKET_NO_LIFT=1"

	log ""
	log "===== 7-8) THE REGRESSION GUARD. Both were correct before. Both   ====="
	log "=====      have out_zp 0, where the offset is -128 and is what    ====="
	log "=====      cancels the lift. If they break, the port is wrong.    ====="
	w pw33x64w56.tflite "ROCKET_NO_LIFT=1"
	w pw33x64w56.tflite ""
	w cal_k3.tflite "ROCKET_NO_LIFT=1"
	w cal_k3.tflite ""

	log ""
	log "===== Read entry 1 first. Then entry 2's UNCLAMPED count.         ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
