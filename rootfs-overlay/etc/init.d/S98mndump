#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-20 round 265. The probe was reading the wrong width, and two of the
# three anomalies are the read, not the map.
#
# WHAT WENT WRONG. --kpair cleared and read m*n BYTES and called byte i channel
# i. The w4a16 path does not write bytes. 0x4010 carries a non zero
# OUT_PRECISION and 0x40ac, 0x40b0, 0x40b4 are 0, 1, 0, an identity requant, so
# nothing narrows the accumulator. Every other w4a16 probe in that file reads
# m*n*4. Only --kpair read m*n, which is the int8 era reading that round 189
# already removed once from --bmap, and the buffer is ALLOCATED m*n*4 under a
# comment that says two bytes an element. Three widths in one file.
#
# WHAT THAT EXPLAINS ON PAPER. Read the reported index R as a byte offset with a
# four byte element. "Two consecutive channels, only c mod 4 in {0,1}" is the
# two LOW bytes of one little endian word: a live nibble of 7 measured +5112,
# which is 000013f8, nonzero at offsets 0 and 1 and zero at 2 and 3. "b >= 64 is
# dead" is an element that fell outside the window, and at N of 16, 32 and 64
# the window ends exactly where 264's dead rows begin.
#
# ⚠ THIS IS NOT A GUESS BETWEEN TWO READINGS. The last three of those went
# nought for three. This is a consequence of a fact already read off the source
# and the register stream, so it makes a four point prediction that can be
# wrong in one line.
#
# THE READING RULE, fixed before the run.
#
#   ENTRY 2, N = 16, is the whole round. Bytes 32, 40, 48 and 56 were DEAD at
#   N = 16 in round 264. The window is now 64 bytes instead of 16, so they have
#   room, and the rule already says where:
#
#       byte 32 low -> word 4 at k 0     byte 48 low -> word 6 at k 0
#       byte 40 low -> word 5 at k 16    byte 56 low -> word 7 at k 16
#       byte 128 low -> word 8 at k 0    byte 136 low -> word 9 at k 16
#
#     all six land there    the window WAS the story. Anomaly 1 and anomaly 3
#                           are both gone, the map covers every channel, and
#                           what is left is only the factor of two in k.
#     they stay dark        the read width was never the reason. b >= 64 and
#                           the missing channels are real and a size or stride
#                           register goes back on the table.
#     they light elsewhere  write down where. Do not force it into either.
#
#   ENTRY 3, N = 64, carries the byte pattern. Every hit prints w<i>=<value>
#   and which of the four bytes were nonzero, as /b<b0><b1><b2><b3>.
#
#     /b1100 everywhere     a four byte element holding a small positive
#                           number, and the word index is the channel
#     /b1111 or /b0011      the value is not what round 185 read it as, and
#                           that reading has to be redone before any of this
#                           arithmetic means anything
#     two words of similar magnitude, not one number split
#                           the element really is narrower and all three
#                           written explanations are wrong
#
#   ⚠ BYTE 512 AT N = 64 IS AN IN BAND CONTROL. The rule puts it at k 64, past
#   the end of a K of 64, so it must stay DARK. If it lights, the window is not
#   the story and the address function is wrong somewhere else. Bytes 256 and
#   384 are round 263's two K invariant rows and must not have moved.
#
#   ENTRY 4 flips the live nibble to f. A signed 32 bit -4896 lights all four
#   bytes of its word where +5112 lights two. If entry 4 lights two, the value
#   is not a signed 32 bit integer. --kpair used to hardcode the nibble and
#   ignore CHARSIU_INT4_LIVE, which is why this arm has never run.
#
#   ⚠ Byte 0 must be word 0 at k = 0 in entries 2, 3 and 4 alike. Same byte,
#   three different runs, it must not move.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	after=$(nbad)
	if [ "$after" != "$before" ]; then
		log "  !! POISON in this entry. The block faulted. This result is VOID."
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" \
			> /tmp/hc.txt 2>&1
		if grep -q "128/128 channels match" /tmp/hc.txt; then
			log "  !! health OK, the block recovered, continuing"
		else
			log "  !! health FAILED, the block is gone. ABORTING the round."
			ABORT=1
		fi
	fi
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	if [ -w /sys/module/rocket/parameters/reset_autosuspend ]; then
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend
		log "reset_autosuspend = $(cat /sys/module/rocket/parameters/reset_autosuspend)"
	else
		log "!! reset_autosuspend NOT WRITABLE. A timeout will kill the round."
	fi

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== 2) N = 16. Bytes 32 40 48 56 128 136 were dead here in 264.  ====="
	log "=====    Widened read says words 4 5 6 7 8 9. THE ROUND IS THIS.   ====="
	log ""
	sleep 1
	/opt/charsiu/charsiu_int4 1 64 16 --kpair > "$C" 2>&1

	log ""
	log "===== 3) N = 64, same bytes as 263 and 264, plus 512 as a control  ====="
	sleep 1
	/opt/charsiu/charsiu_int4 1 64 64 --kpair > "$C" 2>&1

	log ""
	log "===== 4) N = 64 with the live nibble at f. Negative lights four.   ====="
	sleep 1
	env CHARSIU_INT4_LIVE=15 /opt/charsiu/charsiu_int4 1 64 64 --kpair > "$C" 2>&1

	log ""
	log "===== 5) the anchor again                                          ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== Read 2 first. Six bytes, six named words. Then 3 against 4.  ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
