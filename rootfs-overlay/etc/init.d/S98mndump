#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-09 round 32. The slice is at most 256 bytes. Bisect inside it.
#
# Round 31, both baselines 128/128:
#   KEEP 1936, 1600, 1024, 512, 256   all 128/128
#   KEEP 0                            0/128
# and round 30 showed zeroing those same first 256 bytes fails. So everything
# from 0x500 to 0x0b90 is IRRELEVANT and the load bearing part is at most the
# first 256 bytes. Against mesa's 197888 byte float surface, and against the
# 1936 bytes rounds 26 and 27 believed in.
#
# Computed on the host, those 256 bytes are 64 float32, and they are output
# channel 0's first 64 taps, 4 spatial positions by 16 input channels, values
# from -344.30 to 328.65 with one exact zero. Not a table of anything obvious.
#
# Landmarks worth landing on, at ic=16 k=5:
#     4 = 1 float, a single scalar the whole layer needs
#    64 = 16 floats = ic, one spatial position across the input channels
#   128 = 32 floats
#
# DECISION RULE, written before the run:
#   smallest passing n is 4     one float. Then it is a scalar, and the reason
#                               every substitution failed is that a scalar has
#                               to be the RIGHT number
#   is 64                       ic floats, one spatial position: the hardware
#                               primes something per input channel from here
#   is 128 or 256               report it; 256 means the whole 64 floats matter
#                               and the unit is channel 0's tap block
#   nothing between 0 and 256   the boundary is not a prefix at all, so the
#                               next probe has to zero the MIDDLE, not a tail
#   step 1 or 10 not 128/128    the build is wrong, stop and check the image
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
perch() { m="$1"; shift; env TEFLON_LIB=/usr/lib/libteflon.so "$@" \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$m" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null
	log ""
	log "  task_con16=$(cat /sys/module/rocket/parameters/task_con16 2>/dev/null)"

	log ""
	log "===== 1) BASELINE, untouched float surface: must be 128/128 ====="
	perch conv2d-cal.tflite ROCKET_FS_FLOATS=1

	for n in 256 128 64 32 16 8 4 0; do
		log ""
		log "===== KEEP $n bytes ($((n / 4)) floats), zero the rest ====="
		sleep 2
		perch conv2d-cal.tflite ROCKET_FS_FLOATS=1 ROCKET_FS_KEEP=$n
	done

	log ""
	log "===== 10) CONTROL that can fail: baseline again ====="
	log "  not 128/128 here and the sweep above says nothing"
	sleep 2
	perch conv2d-cal.tflite ROCKET_FS_FLOATS=1

	log ""
	log "===== Read 1 and 10 first. KEEP 256 must pass, KEEP 0 must fail.  ====="
	log "===== The smallest passing n, in floats, is the answer.           ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
