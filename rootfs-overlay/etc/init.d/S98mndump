# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-11 round 71. The last 32 channels are an output side count.
#
# Round 70 localised the tail by elimination, and both knobs came back inert:
#
#   ROCKET_DW_GROUP=32    live 0..991, values wrong (wrong layout, expected)
#   ROCKET_DW_GROUP=128   live 0..991, values wrong
#   ROCKET_DW_RECS=256    992/1024 all COMPUTED, identical to the default
#   ROCKET_DW_RECS=512    992/1024 all COMPUTED, identical to the default
#
# The dead tail is 992..1023 whatever the weight group size is and whatever the
# coefficient table holds. So neither buffer owns it, which by the rule written
# before that run puts it on the output side.
#
# And 992 is 1023 with its low five bits cleared: 0x3ff becomes 0x3e0. That is
# the shape of a channel count being rounded DOWN to a multiple of 32
# somewhere, losing the last partial group of 32.
#
# ROCKET_OC_OUT_ADD adds to the value written into the four registers that
# carry the output channel count, CORE 0x3020, DPU 0x402c, DPU 0x4030 and RDMA
# 0x5014, and to nothing else. If the tail is an off-by-a-group in one of
# those, +32 closes it. If it is somewhere that does not take a count at all,
# the sweep does nothing and the next round goes to the output surface
# geometry.
#
# The 32 channel layers are the control in both directions: they must be
# unchanged at +0, and they must BREAK at -32, or the knob is not reaching the
# hardware and the sweep is void.
#
# DECISION RULE, written before the run:
#   +32 gives live 0..1023        the count was short by one group of 32, and
#                                 the fix is to round it up
#   -32 gives live 0..959         the knob works and the tail tracks it, so
#                                 even if +32 does not close it the register is
#                                 the right place to look
#   nothing moves at all          the knob is inert and the tail is not a
#                                 channel count; go to the output surface
#                                 stride and the surfaces-per-row
#   mn_dw1 breaks at +0           regression, that comes first
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
p() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== 1..2) REGRESSION at +0: 32 channels and a regular conv ====="
	p mn_dw1.tflite ""
	p conv2d-cal.tflite ""

	log ""
	log "===== 3) the baseline: live 0..991 ====="
	p dw25_t4.tflite ""

	log ""
	log "===== 4..6) sweep the output channel count ====="
	p dw25_t4.tflite ROCKET_OC_OUT_ADD=32
	p dw25_t4.tflite ROCKET_OC_OUT_ADD=64
	p dw25_t4.tflite ROCKET_OC_OUT_ADD=-32

	log ""
	log "===== 7) VOID CHECK: the knob must break a 32 channel layer ====="
	p mn_dw1.tflite ROCKET_OC_OUT_ADD=-16

	log ""
	log "===== 8..9) the real 1024 channel layer, at +0 and at the winner ====="
	p mn_dw25.tflite ""
	p mn_dw25.tflite ROCKET_OC_OUT_ADD=32

	log ""
	log "===== 10) whole model, for the record ====="
	sleep 2
	env TEFLON_LIB=/usr/lib/libteflon.so \
		python3 "$NPU_DIR/test_model.py" "$NPU_DIR/conv2d-cal.tflite" 2 > "$C" 2>&1

	log ""
	log "===== Read test 7 first: if a 32 channel layer is unmoved at -16, ====="
	log "===== the knob is inert and tests 4 to 6 mean nothing.            ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
