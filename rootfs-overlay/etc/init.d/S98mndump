# ---------------------------------------------------------------------------
# 2026-08-19 round 252. The lift on the depthwise record, which 249 missed.
#
# WHAT 251 FOUND. The gate worked, the block survived to the last entry, and
# the log is clean. Two results out of it.
#
#   The 0x4050 sweep Igor is owed is COMPLETE and the parity rule wins at both
#   counts. 88 of 88 and 120 of 120 with it, 64 of 88 and 96 of 120 with the
#   modulo rule it replaced, and the modulo arm hangs the block at both.
#
#   And the lift broke every model carrying a depthwise. MobileNet went 1000 of
#   1001 without it to 977 with it, which is below the 983 an empty buffer
#   scores. mn_L02 went 22 of 64 to 6 of 64 and its maxdiff 6 to 255. mn_L00,
#   which is a plain first convolution with no depthwise in it, stayed at 32 of
#   32.
#
# WHY, and it is the same mistake as round 248 in a second place. A is written
# in TWO records. The regular convolution's 64 byte record got the lift in 249;
# the depthwise 48 byte record at rkt_coefs.c did not. rkt_fill_regcmd takes
# the lift back out of the output offset for EVERY task either way, so a
# depthwise got the compensation without the thing being compensated. Fixed by
# adding the same term to the depthwise A.
#
# THE READING RULE, fixed before the run.
#
#   Entries 1 and 2 are the anchor and must reproduce 249, 250 and 251.
#
#   ⚠ THE BAR IS THE NO-LIFT NUMBER, NOT PERFECTION. These models have out_zp
#   0, where the floor was invisible, so the no-lift arm was already the honest
#   score and the lift should return them to it, not beat it. mn_L02 must come
#   back to 22 of 64 at maxdiff 6, mn_L26 to 574 of 1024, MobileNet to 1000 of
#   1001. Landing there means the depthwise lift was the whole story. Landing
#   short means it was not, and the remaining gap is the result.
#
#   ⚠ mn_L02 at 22 of 64 was ALREADY WRONG before any of this. Do not read a
#   return to 22 as success at anything except undoing my own regression.
#
#   ⚠ Any entry printing POISON is void, and so is everything after it until an
#   OK health check.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	after=$(nbad)
	if [ "$after" != "$before" ]; then
		log "  !! POISON in this entry. The block faulted. This result is VOID."
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" \
			> /tmp/hc.txt 2>&1
		if grep -q "128/128 channels match" /tmp/hc.txt; then
			log "  !! health OK, the block recovered, continuing"
		else
			log "  !! health FAILED, the block is gone. ABORTING the round."
			ABORT=1
		fi
	fi
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	if [ -w /sys/module/rocket/parameters/reset_autosuspend ]; then
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend
		log "reset_autosuspend = $(cat /sys/module/rocket/parameters/reset_autosuspend)"
	else
		log "!! reset_autosuspend NOT WRITABLE. A timeout will kill the round."
	fi

	log ""
	log "===== 1-2) THE ANCHOR, a regular conv. The depthwise change must   ====="
	log "=====      not touch it.                                           ====="
	w conv2d-cal.tflite ""
	w conv2d-cal.tflite "ROCKET_NO_LIFT=1"

	log ""
	log "===== 3-8) THE QUESTION. Each pair is its own control. The bar is  ====="
	log "=====      the no-lift arm beside it, not 100 percent.             ====="
	w mn_L02.tflite ""
	w mn_L02.tflite "ROCKET_NO_LIFT=1"
	w mn_L26.tflite ""
	w mn_L26.tflite "ROCKET_NO_LIFT=1"
	w mobilenet_v1_1.0_224_quant.tflite ""
	w mobilenet_v1_1.0_224_quant.tflite "ROCKET_NO_LIFT=1"

	log ""
	log "===== 9-14) bare depthwise, where the record being fixed is the    ====="
	log "=====       only one in play                                       ====="
	w mn_dw1.tflite ""
	w mn_dw1.tflite "ROCKET_NO_LIFT=1"
	w mn_dw25.tflite ""
	w mn_dw25.tflite "ROCKET_NO_LIFT=1"
	w dwconv.tflite ""
	w dwconv.tflite "ROCKET_NO_LIFT=1"

	log ""
	log "===== 15-16) a single pointwise at out_zp 0, which 249 showed is   ====="
	log "=====        byte for byte identical either way. Must stay so.     ====="
	w pw33x64w56.tflite ""
	w pw33x64w56.tflite "ROCKET_NO_LIFT=1"

	log ""
	log "===== 17+) the rest of the MobileNet slices, lift on, against 251  ====="
	for m in mn_L00 mn_L01 mn_L03 mn_L04 mn_L05 mn_L06 mn_L07 mn_L08 \
	         mn_L12 mn_L18 mn_L24; do
		w "$m.tflite" ""
	done

	log ""
	log "===== and the two that were never attributable, each with a arm    ====="
	w conv2x.tflite ""
	w conv2x.tflite "ROCKET_NO_LIFT=1"
	w md003_s2.tflite ""
	w md003_s2.tflite "ROCKET_NO_LIFT=1"

	log ""
	log "===== a final anchor, so the log says whether the block survived   ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== Read 1 and 2, then 3 against 4. The bar is the arm beside it ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
