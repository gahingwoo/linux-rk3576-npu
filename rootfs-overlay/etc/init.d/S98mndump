#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-23 round 340. RE-READ THE MAP IN THE MODE THAT MIGHT BE A MATMUL.
#
# ⚠ ROUND 339 CONTAINED A CHECK THAT COULD NOT FAIL, AND IT PASSED. Arm 3d
# printed "PLAIN WEIGHTED SUM: 64 of 64" with a fitted scale of 0.000000: the
# job TIMED OUT, every output word was zero, and every channel was trivially
# within one percent of zero. The tool now refuses that: it counts the live
# words and prints VOID when there are none. My own rule, broken by my own
# metric, one round after writing it down.
#
# WHAT 339 DID SETTLE:
#
#   3b  force 0x100c = 0x00600120        output IDENTICAL to the control,
#                                        old reference 64 of 64, scale 0.308023
#   3a  the emitter's A8_STRIDE1 hatch   both references 0, and the header says
#                                        "1 entries per row" against 2
#
# **So bit 29 is not the switch.** Clearing it changed nothing at all. What
# changes the arithmetic is the hatch, and the hatch changes the input STRIDE,
# which is the activation atom: 8 for a two byte type, 16 for one byte.
#
# ---------------------------------------------------------------------------
# WHICH MAKES 3a AND 3c INCONCLUSIVE BY CONSTRUCTION, NOT NEGATIVE
# ---------------------------------------------------------------------------
#
# The paired packing is built from a map measured with the SIXTEEN BIT atom:
#
#     w = 32*floor(s/K) + (s mod 32),   k = 16*(w mod 2) + 32*j + 2*byte + nib
#
# Change the atom and there is no reason for that to hold, so in 3a the weights
# the hardware read were not the weights the packer meant. Neither reference
# could match and neither failing says anything about the arithmetic.
#
# So do what worked twice before: READ THE MAP IN THE NEW MODE, then pack for
# it, then ask about the arithmetic. --map gives which word a byte feeds and
# --kpair gives which k it multiplies with, and both have a control at the
# settings where their answer is already known.
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# 1) ENTRY 2 IS THE CONTROL: both probes at today's settings must reproduce
#    w = 32*floor(s/K) + s mod 32, and byte j of a slot carrying k = 2j and
#    2j+1. If they do not, the probes moved and nothing below counts.
# 2) ENTRY 3 IS THE ROUND: the same two probes with A8_STRIDE1. Read the block
#    length, how many words before the base steps, and the k a byte pairs with.
# 3) A DEAD ARM IS NOT A RESULT. Every line has a live-word count now.
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT
# ---------------------------------------------------------------------------
#
# The map changes, because the atom is in every formula that produced it. What
# I cannot predict is whether the arithmetic in that mode is a weighted sum, and
# that is the question this round is clearing the way for rather than answering.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
RUN=/opt/charsiu/charsiu_run
BE=/opt/charsiu/charsiu_bench
MM=/opt/charsiu/charsiu_matmul
I4=/opt/charsiu/charsiu_int4
M4="CHARSIU_W4=1 CHARSIU_W4_HALFK=1"
M8=/opt/charsiu/models/Llama-3.2-1B-Instruct-Q8_0.gguf
PROMPT="The capital of France is"
LIMIT=420
ARMCAP=240
CE=CHARSIU_COEF_ELEMS=65536
HEAD=CHARSIU_NPU_MAXN=131072
B8="CHARSIU_OVERRIDE=0x40b8=3"
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

# Igor's scorer, not ours: it compares against the RAW cpu output and prints
# the constant-reference-channel guard on every model.
ocp() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $1"; return 0; }
	before=$(nbad)
	log ""
	log "  -- $1"
	sleep 1
	capped "$ARMCAP" env TEFLON_LIB=$WORK python3 "$NPU_DIR/oc_perch.py" \
		"$NPU_DIR/$1" > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the arm exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This arm is VOID."; health; }
	return 0
}

capped() {
	lim="$1"; shift
	"$@" &
	pid=$!
	i=0
	while [ "$i" -lt "$lim" ]; do
		kill -0 "$pid" 2>/dev/null || { wait "$pid"; return $?; }
		sleep 1
		i=$((i + 1))
	done
	kill -9 "$pid" 2>/dev/null
	wait "$pid" 2>/dev/null
	return 124
}

c() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $*"; return 0; }
	before=$(nbad)
	sleep 1
	capped "$ARMCAP" env $1 $2 $3 $4 $5 $6 $7 $8 $9 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the arm exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This arm is VOID."; health; }
	return 0
}

rung() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $1"; return 0; }
	lbl="$1"; shift
	before=$(nbad)
	log ""
	log "  -- $lbl"
	sleep 1
	capped "$LIMIT" env "$@" "$RUN" "$M8" -p "$PROMPT" -n 32 \
		--ignore-eos -q -c 512 -t 4 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the rung exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This rung is VOID."; health; }
	return 0
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	[ -w /sys/module/rocket/parameters/reset_autosuspend ] && \
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend

	log ""
	log "===== 0) the limit's own control. expect rc 124 after ~3s.         ====="
	t0=$(cut -d. -f1 /proc/uptime)
	capped 3 sleep 60
	rc=$?
	t1=$(cut -d. -f1 /proc/uptime)
	log "  -- capped 3 sleep 60  ->  rc $rc after $((t1 - t0))s"
	[ "$rc" = "124" ] || log "  !! THE LIMIT DID NOT FIRE. Nothing below can be trusted to end."

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "##### ROUND 340: re-read the map in the int8-activation mode      #####"

	log ""
	log "===== 2) THE MEASUREMENT. every stage of the forward pass, NPU on. ====="
	log "=====    matmul stages minus the hardware path = the quantise.     ====="
	rung "the decode loop on the NPU, stages on" \
		CHARSIU_STAGES=1 CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 "$CE" "$HEAD"

	log ""
	log "===== 2b) the same stages with the NPU off, one boot apart.        ====="
	rung "the CPU path, stages on" CHARSIU_STAGES=1 CHARSIU_NPU_QUANT=1

	log ""
	log "===== 2) CONTROL: both probes where the answer is known.           ====="
	log "===== 2a the map today: w = 32*floor(s/K) + s mod 32"
	c "CHARSIU_W4=1" "CHARSIU_OVERRIDE=0x40b8=3,0x3020=0x7f" $I4 1 64 64 --map 16
	log "===== 2b the k today: byte j of a slot carries k = 2j and 2j+1"
	c "CHARSIU_W4=1 CHARSIU_KPAIR_BYTES=0,4,8,256,260,264,1024,1280" \
	  "CHARSIU_OVERRIDE=0x40b8=3,0x3020=0x7f" $I4 1 64 64 --kpair

	log ""
	log "===== 3) THE ROUND: the same two probes with an int8 activation.   ====="
	log "===== 3a the map with A8_STRIDE1"
	c "CHARSIU_W4=1 CHARSIU_A8_STRIDE1=1" "CHARSIU_OVERRIDE=0x40b8=3,0x3020=0x7f" $I4 1 64 64 --map 16
	log "===== 3b the k with A8_STRIDE1"
	c "CHARSIU_W4=1 CHARSIU_A8_STRIDE1=1 CHARSIU_KPAIR_BYTES=0,4,8,256,260,264,1024,1280" \
	  "CHARSIU_OVERRIDE=0x40b8=3,0x3020=0x7f" $I4 1 64 64 --kpair
	log "===== 3c and the map with A8_STRIDE1 and no register override"
	c "CHARSIU_W4=1 CHARSIU_A8_STRIDE1=1" $I4 1 64 64 --map 16

	log ""
	log "===== 4) the matmul arms again, with a live-word count this time.  ====="
	c "CHARSIU_W4=1 CHARSIU_W4_PAIRED=1" "$CE" $MM 1 64 64
	c "CHARSIU_W4=1 CHARSIU_W4_PAIRED=1 CHARSIU_A8_STRIDE1=1" "$CE" $MM 1 64 64

	log ""
	log "===== 5) the standing number, no timers, so they cannot be blamed  ====="
	rung "the decode loop on the NPU" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 "$CE" "$HEAD"

	log ""
	log "===== the anchor again                                             ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== 2 is the control; 3 is the map; a dead arm is not a result.  ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
