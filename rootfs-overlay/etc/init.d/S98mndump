#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-22 round 329. I DIFFED HALF THE STREAM AND CALLED IT A MATCH.
#
# ⚠ THE CORRECTION FIRST. Round 327 said charsiu's int4 stream and the vendor's
# "agree on 44 of 44 registers". That comparison was the CNA block ONLY -- the
# weight fetch half. The vendor's op continues past a gap into its CORE and DPU
# streams, and diffing the WHOLE op, 117 registers, leaves four real
# differences instead of two:
#
#   CNA  100c   vendor 00600120   charsiu 20600120   bit 29, 8 vs 16 bit acts
#   CNA  1098   vendor 00000001   charsiu 00000004   known since the int8 diff
#   CORE 3018   vendor 10000200   charsiu 10000001   NEW
#   CORE 3020   vendor 000003ff   charsiu 000007ef   NEW, and it is the one
#   DPU  40b8   vendor 00000003   charsiu 00000001   NEW
#
# ---------------------------------------------------------------------------
# WHY 0x3020 AND 0x40b8 TOGETHER ARE THE WHOLE int4 STORY
# ---------------------------------------------------------------------------
#
# 0x3020 is the channel count. **The vendor writes oc-1, which is what int8
# gets. charsiu writes 2*(ALIGN_UP(n,16)-8)-1, which is roughly TWICE that.**
#
# It does so for a reason recorded in job.c: rounds 274-276 measured that int4
# asking for n-1 gets back n/2+8 channels, so round 280 inverted the formula and
# doubled the request. ⚠ **Every one of those rounds ran with 0x40b8 = 1**,
# because 0x40b8 = 3 was not found until round 312, and it was only ever tried
# for int8 and for int4 WITH THE DOUBLED 0x3020 STILL IN PLACE.
#
# So the two are the same workaround seen from both ends, and that explains the
# thing round 325 could not: with 0x40b8 = 3 the placement moved to a stride of
# SIXTEEN words per group of eight channels. **A stride of exactly double, on a
# job that asked for exactly double the channels.**
#
# ---------------------------------------------------------------------------
# WHAT THIS ROUND DOES
# ---------------------------------------------------------------------------
#
# Sets them TOGETHER, which has never been done, and adds the other three one at
# a time on top. The acceptance is the line that has read 128 of 256 for twenty
# rounds. And `--map` reads the block indexing at the same settings: today it is
# `s mod 32`, thirty two channels in a block sized for sixteen. **If the pair is
# the fix, the map becomes `s mod 16` and a channel gets twice the slots, which
# is the whole of K instead of half.**
#
# ⚠ The halfk zeroing is a REFERENCE, not a setting: it zeroes the weights a
# channel is not fed. If the hardware now fetches every k, the arms WITHOUT it
# are the ones that match. Both are run.
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# 1) ENTRY 2a IS THE CONTROL: 64 of 64 at N=64 and 128 of 256 at N=256, all at
#    their own index. If that moved, the build is not what I think it is.
# 2) ENTRY 2d IS THE ROUND. `found` reaching 256 of 256, or `exact` reaching
#    256, is int4 at full width for the first time.
# 3) THE MAPS IN ENTRY 3: where does the word base step, and how many distinct
#    words before it. Control is every 512 bytes and 32 words. **16 words is
#    the answer.**
# 4) ENTRY 4 IS THE BENCH, on medians with a stall count. int8 at K=2048 fits
#    9.40 GB/s and is reproducible to 1%; that is the only denominator worth
#    quoting.
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT
# ---------------------------------------------------------------------------
#
# The pair is the fix. I am saying it plainly: 0x3020 doubled and 0x40b8 = 1 are
# one workaround, the vendor uses neither, and the doubled stride round 325
# measured is the fingerprint of asking for twice the channels.
#
# ⚠ I have been wrong about int4 four times now, and three of those were stated
# before the data in exactly this box. The difference this time is that the
# claim came out of the vendor's own register stream rather than out of my
# reasoning about a score -- and entry 2d kills it in one line either way.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
RUN=/opt/charsiu/charsiu_run
BE=/opt/charsiu/charsiu_bench
MM=/opt/charsiu/charsiu_matmul
I4=/opt/charsiu/charsiu_int4
M4="CHARSIU_W4=1 CHARSIU_W4_HALFK=1"
M8=/opt/charsiu/models/Llama-3.2-1B-Instruct-Q8_0.gguf
PROMPT="The capital of France is"
LIMIT=420
ARMCAP=240
CE=CHARSIU_COEF_ELEMS=65536
HEAD=CHARSIU_NPU_MAXN=131072
B8="CHARSIU_OVERRIDE=0x40b8=3"
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

capped() {
	lim="$1"; shift
	"$@" &
	pid=$!
	i=0
	while [ "$i" -lt "$lim" ]; do
		kill -0 "$pid" 2>/dev/null || { wait "$pid"; return $?; }
		sleep 1
		i=$((i + 1))
	done
	kill -9 "$pid" 2>/dev/null
	wait "$pid" 2>/dev/null
	return 124
}

c() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $*"; return 0; }
	before=$(nbad)
	sleep 1
	capped "$ARMCAP" env $1 $2 $3 $4 $5 $6 $7 $8 $9 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the arm exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This arm is VOID."; health; }
	return 0
}

rung() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $1"; return 0; }
	lbl="$1"; shift
	before=$(nbad)
	log ""
	log "  -- $lbl"
	sleep 1
	capped "$LIMIT" env "$@" "$RUN" "$M8" -p "$PROMPT" -n 32 \
		--ignore-eos -q -c 512 -t 4 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the rung exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This rung is VOID."; health; }
	return 0
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	[ -w /sys/module/rocket/parameters/reset_autosuspend ] && \
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend

	log ""
	log "===== 0) the limit's own control. expect rc 124 after ~3s.         ====="
	t0=$(cut -d. -f1 /proc/uptime)
	capped 3 sleep 60
	rc=$?
	t1=$(cut -d. -f1 /proc/uptime)
	log "  -- capped 3 sleep 60  ->  rc $rc after $((t1 - t0))s"
	[ "$rc" = "124" ] || log "  !! THE LIMIT DID NOT FIRE. Nothing below can be trusted to end."

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "##### ROUND 329: 0x3020 and 0x40b8 are one workaround seen twice  #####"

	log ""
	log "===== 2) THE MEASUREMENT. every stage of the forward pass, NPU on. ====="
	log "=====    matmul stages minus the hardware path = the quantise.     ====="
	rung "the decode loop on the NPU, stages on" \
		CHARSIU_STAGES=1 CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 "$CE" "$HEAD"

	log ""
	log "===== 2b) the same stages with the NPU off, one boot apart.        ====="
	rung "the CPU path, stages on" CHARSIU_STAGES=1 CHARSIU_NPU_QUANT=1

	log ""
	log "===== 2) THE ROUND: 0x3020 and 0x40b8, which have never been set  ====="
	log "=====    together. acceptance is the 128-of-256 line.              ====="
	log "===== 2a CONTROL, today"
	c "$M4" $MM 1 64 64
	c "$M4" $MM 1 2048 256
	log "===== 2b 0x40b8 = 3 alone, which is round 325"
	c "$M4" "CHARSIU_OVERRIDE=0x40b8=3" $MM 1 64 64
	c "$M4" "CHARSIU_OVERRIDE=0x40b8=3" $MM 1 2048 256
	log "===== 2c 0x3020 = oc-1 alone, the vendor's channel count"
	c "$M4" "CHARSIU_OVERRIDE=0x3020=0x3f" $MM 1 64 64
	c "$M4" "CHARSIU_OVERRIDE=0x3020=0xff" $MM 1 2048 256
	log "===== 2d THE PAIR. 0x40b8 = 3 AND 0x3020 = oc-1."
	c "$M4" "CHARSIU_OVERRIDE=0x40b8=3,0x3020=0x3f" $MM 1 64 64
	c "$M4" "CHARSIU_OVERRIDE=0x40b8=3,0x3020=0xff" $MM 1 2048 256
	log "===== 2e the pair WITHOUT the halfk zeroing: does it fetch all k?"
	c "CHARSIU_W4=1" "CHARSIU_OVERRIDE=0x40b8=3,0x3020=0x3f" $MM 1 64 64
	c "CHARSIU_W4=1" "CHARSIU_OVERRIDE=0x40b8=3,0x3020=0xff" $MM 1 2048 256
	log "===== 2f the pair plus CORE 0x3018 = 0x10000200"
	c "$M4" "CHARSIU_OVERRIDE=0x40b8=3,0x3020=0x3f,0x3018=0x10000200" $MM 1 64 64
	c "$M4" "CHARSIU_OVERRIDE=0x40b8=3,0x3020=0xff,0x3018=0x10000200" $MM 1 2048 256
	log "===== 2g and the vendor's complete set, 8 bit activations too"
	log "=====    (charsiu packs the input for 16, so read the GEOMETRY)"
	c "$M4" "CHARSIU_OVERRIDE=0x40b8=3,0x3020=0xff,0x3018=0x10000200,0x100c=0x00600120" "CHARSIU_CNA_1098=1" $MM 1 2048 256

	log ""
	log "===== 3) the map at the same settings. today it is s mod 32.       ====="
	log "=====    32 channels in a block sized for 16. Look for 16.         ====="
	c "CHARSIU_W4=1" "CHARSIU_OVERRIDE=0x40b8=3,0x3020=0x3f" $I4 1 64 64 --map 16
	c "CHARSIU_W4=1" "CHARSIU_OVERRIDE=0x3020=0x3f" $I4 1 64 64 --map 16

	log ""
	log "===== 4) and the bench, on medians with the stall count.           ====="
	c "CHARSIU_W4=1" "CHARSIU_OVERRIDE=0x40b8=3" "$CE" $BE --nsweep 2048 50
	c "$CE" $BE --nsweep 2048 50

	log ""
	log "===== 5) the standing number, no timers, so they cannot be blamed  ====="
	rung "the decode loop on the NPU" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 "$CE" "$HEAD"

	log ""
	log "===== the anchor again                                             ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== 2a is the control, 2d is the round, the map confirms it.     ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
