#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-09 round 31. Measure how BIG the load bearing slice is, having run out
# of ways to guess what it MEANS.
#
# Round 30, with both baselines clean at 128/128:
#   the 256 bytes zeroed        0/128 channels, maxdiff 128 on every one
#   the 256 bytes as fp16       0/128 channels
# All 128 channels, not the 64 a 4-byte-per-channel layout would touch. So this
# is not a per-channel table in mesa's hands, and a plausible large float fails
# exactly like a zero does. Three rounds of substituting a meaning have all
# failed the same way, so stop.
#
# What was never measured is the SIZE. 0x0b90 is where the VENDOR's constant
# tail starts, which says nothing about this driver. All that is known is that
# keeping 0x400..0x0b90 works and zeroing all of it fails, so the boundary is
# somewhere inside those 1936 bytes. ROCKET_FS_KEEP=<n> keeps the first n and
# zeroes the rest of the slice, so a sweep finds it.
#
# Sizes that would mean something, at ic=16 oc=128 k=5:
#    512 = 128 floats = one per output channel
#   1600 = 400 floats = ic*k*k, exactly one output channel's weights
#
# DECISION RULE, written before the run:
#   the boundary lands on 512    one float per output channel: the surface is
#                                512 bytes, not 200 KB, and the fp16 attempt
#                                failed on ELEMENT SIZE alone
#   lands on 1600                one output channel's worth of weights, which
#                                says the hardware reads channel 0's weights
#                                from here and the rest from the weight buffer
#   lands somewhere else         report the number, it is the measurement
#   no boundary, only 1936 works every byte matters and the slice is opaque;
#                                then the next move is the vendor's own value
#                                at each offset, not mesa's
#   step 1 or 8 not 128/128      the build is wrong, stop and check the image
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
perch() { m="$1"; shift; env TEFLON_LIB=/usr/lib/libteflon.so "$@" \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$m" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null
	log ""
	log "  task_con16=$(cat /sys/module/rocket/parameters/task_con16 2>/dev/null)"

	log ""
	log "===== 1) BASELINE, untouched float surface: must be 128/128 ====="
	perch conv2d-cal.tflite ROCKET_FS_FLOATS=1

	for n in 1936 1600 1024 512 256 0; do
		log ""
		log "===== KEEP $n bytes of the slice, zero the rest to 0x0b90 ====="
		sleep 2
		perch conv2d-cal.tflite ROCKET_FS_FLOATS=1 ROCKET_FS_KEEP=$n
	done

	log ""
	log "===== 8) CONTROL that can fail: baseline again ====="
	log "  not 128/128 here and the sweep above says nothing"
	sleep 2
	perch conv2d-cal.tflite ROCKET_FS_FLOATS=1

	log ""
	log "===== Read 1 and 8 first. KEEP 1936 must pass and KEEP 0 must     ====="
	log "===== fail; the smallest passing n is the answer.                 ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
