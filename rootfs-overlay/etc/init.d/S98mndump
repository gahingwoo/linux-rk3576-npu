# ---------------------------------------------------------------------------
# 2026-08-11 round 79. Give the first conv its operand back.
#
# Round 78 bisected my own regression cleanly. On conv0:
#
#   default, the round 52 block   distinct 1, 32 of 32 constant, output is
#                                 exactly 128 + the OUT_CVT offset
#   ROCKET_SCALE_OFF, one word     distinct 60, 10 of 32 constant
#   ROCKET_FS_ZERO                 distinct 254, 4 of 32 constant
#   ROCKET_FS_FLOATS               distinct 254, 4 of 32 constant, IDENTICAL
#
# The operand VALUE is inert on conv0: 0x0e0e, 0 and 0x3fc4 all give the same
# dead output. So does changing what the table holds. Only whether the region
# is written at all matters, and the two knobs that skip it entirely agree to
# the digit.
#
# The mechanism is an address collision, and it is checkable in the source
# rather than inferred. fill_regcmd_firstconv points 0x5024, the second SDP
# operand, at bias_addr + 0x100 and always has, while the generic path computes
# it. For 32 output channels rkt_coef_table_bytes() is 4 * 64 = 256, which IS
# 0x100. So round 52 began writing the fp16 scale entries exactly on top of the
# first conv's operand.
#
# So the first conv now leaves that region zero, and does not get the single
# constant word either. ROCKET_FC_SCALE_TABLE forces the table back on as the
# control.
#
# This does not make conv0 CORRECT. Its best state is 1 of 32 with 0 COMPUTED,
# a full range output that disagrees with the reference. It un-regresses it
# from computing nothing to computing something wrong, which is where it was
# before round 52 and is a state that can be debugged.
#
# DECISION RULE, written before the run:
#   conv0 reaches distinct 254     the collision was it, and conv0's remaining
#     with 4 constant              wrongness is the older separate problem
#   conv0 stays at distinct 1      the gate is not reaching the first conv, and
#                                  the detection of it is wrong
#   ROCKET_FC_SCALE_TABLE gives    the control passes and the comparison is
#     back distinct 1              real
#   any other model moves          the gate is catching operations it should
#                                  not, and that comes first
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
p() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== 1..2) conv0 with the region left zero, and the control ====="
	p mn_conv0.tflite ""
	p mn_conv0.tflite ROCKET_FC_SCALE_TABLE=1

	log ""
	log "===== 3) and the two-op chain that needs conv0 ====="
	p mn_conv0dw1.tflite ""

	log ""
	log "===== 4..9) REGRESSION: everything that passes must keep passing ====="
	p conv2d-cal.tflite ""
	p cal_k3.tflite ""
	p cal_k1.tflite ""
	p cal_oc16.tflite ""
	p mn_dw1.tflite ""
	p mn_dw25.tflite ""

	log ""
	log "===== 10) whole model ====="
	sleep 2
	env TEFLON_LIB=/usr/lib/libteflon.so \
		python3 "$NPU_DIR/test_model.py" "$NPU_DIR/conv2d-cal.tflite" 2 > "$C" 2>&1

	log ""
	log "===== Test 2 must reproduce distinct 1 and 32 constant channels,  ====="
	log "===== or test 1 is not measuring the gate.                        ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
