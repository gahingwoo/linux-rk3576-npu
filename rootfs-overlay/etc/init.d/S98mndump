#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-20 round 278. A real int4 matmul against a CPU reference, or the
# reason there still is not one.
#
# THIRTEEN ROUNDS OF PROBES AND THIS IS THE FIRST ONE THAT RUNS A MATMUL.
#
# WHAT 277 SETTLED. Bytes per channel is K/4, measured at two K:
#
#   K = 32 -> 8 bytes a channel      K = 64 -> 16 bytes a channel
#
# so half the k is missing at EVERY K and it is not a fixed cap. K = 16 lit
# nothing at all. And the 2^n - 1 rule is REFUTED: 15 and 31 both hang under the
# k fix. The predicate that fits all twelve points is (v+1) mod 64 == 0, and
# under the k fix v stops driving the count at all, since 63, 127 and 255 all
# give 40 and only SIZE_E_2 moves it. So the k fix pins the channels at 32 plus
# SIZE_E_2's term, and the two halves cannot be had together.
#
# ⚠ BUT THE HALF THAT IS FETCHED IS A KNOWN HALF. With 0x3020 = 111 at N = 64,
# K = 64, every channel is written and reachable and gets 16 bytes in two runs,
# its own and one 256 bytes later, which --kpair reads as k 0..15 and k 32..47:
#
#   fetched  <=>  (k mod 32) < 16
#
# A weight the hardware never reads is only wrong if it matters. Zero the ones
# it does not read and the partial sum it computes IS the full sum, so the CPU
# reference and the hardware are answering the same question. That is a real 32
# deep int4 matmul on all 64 channels, with the arithmetic already known exact,
# at the cost of half the weight buffer. No change to the packer, no k fix.
#
# CHARSIU_W4_HALFK does the zeroing and prints how many it zeroed, because a
# knob that cannot be seen working is not a knob and this file has lost five
# comparisons to exactly that.
#
# THE READING RULE, fixed before the run.
#
#   ⚠ ENTRY 3 IS THE ROUND. W4 dense, HALFK on, 0x3020 = 111.
#
#     it matches cpu_reference      an int4 matmul works on this hardware for
#                                   the first time. 64 channels, 32 real k,
#                                   exact arithmetic. Everything after that is
#                                   about the wasted half, not about whether it
#                                   computes.
#     it is wrong on some channels  the ones it is wrong on say what else the
#                                   fetch is missing. Compare against entry 4.
#     it is wrong everywhere        the fetched set is not (k mod 32) < 16 and
#                                   the map that says so was read at N = 64
#                                   with one live nibble, which is not the same
#                                   thing as a dense buffer.
#
#   ENTRY 2 is the control that must be WRONG: same thing without HALFK. If the
#   unfetched weights really are unread, adding them to the reference and not to
#   the hardware has to break it. A control that passes means HALFK did nothing.
#
#   ENTRY 4 is HALFK without 0x3020 = 111, so only 40 channels exist. Channels
#   0 to 39 should match and 40 to 63 should not, which is the second, separate
#   confirmation that 111 is what buys the channels.
#
#   ENTRY 5 is int8 dense, untouched, as the instrument check. It is byte exact
#   on this silicon and if it is not right here then nothing else in this log is
#   worth reading.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
CH=/opt/charsiu/charsiu_int4
MM=/opt/charsiu/charsiu_matmul
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

# $1 and $2 are environment, $3.. are the binary and its arguments
c() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $*"; return 0; }
	before=$(nbad)
	sleep 1
	env $1 $2 $3 $4 $5 $6 $7 $8 $9 > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This arm is VOID."; health; }
	return 0
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	if [ -w /sys/module/rocket/parameters/reset_autosuspend ]; then
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend
		log "reset_autosuspend = $(cat /sys/module/rocket/parameters/reset_autosuspend)"
	else
		log "!! reset_autosuspend NOT WRITABLE. A timeout will kill the round."
	fi

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== 2) the control that must be WRONG. W4 dense, no HALFK, v=111 ====="
	log ""
	c "CHARSIU_W4=1" "CHARSIU_OVERRIDE=0x3020=111" $MM 1 64 64

	log ""
	log "===== 3) THE ROUND. W4 dense, HALFK on, v = 111.                   ====="
	log "=====    64 channels, 32 real k, against cpu_reference.            ====="
	log ""
	c "CHARSIU_W4=1 CHARSIU_W4_HALFK=1" "CHARSIU_OVERRIDE=0x3020=111" $MM 1 64 64

	log ""
	log "===== 4) HALFK without v=111. 0..39 should match, 40..63 not.      ====="
	c "CHARSIU_W4=1 CHARSIU_W4_HALFK=1" X=1 $MM 1 64 64

	log ""
	log "===== 5) int8 dense, the instrument check                          ====="
	c X=1 X=1 $MM 1 64 64

	log ""
	log "===== 6) and the same at N = 32, where v=111 is more than enough   ====="
	c "CHARSIU_W4=1 CHARSIU_W4_HALFK=1" "CHARSIU_OVERRIDE=0x3020=111" $MM 1 64 32

	log ""
	log "===== the anchor again                                             ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== entry 3 against entry 2. One must match and one must not.    ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
