#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-11 round 91. Twelve lanes per channel carrying a weight of -23.
#
# Round 90 excluded the multiplier's magnitude. The far values bite hard,
# 0x7000 giving 48.8 percent within 1 and 0x7fff 47.2, so the knob works, and
# the fitted a moved exactly as computed, 0.9991 at 0x76be and 0.9999 at
# 0x7699. The residual did not move at all: 99.5, 99.5, 99.6, 99.7 and 7.9
# percent at a rail, identical at every scale in the sweep.
#
# So the 0.12 percent is not what costs the half percent, and what survives is
# the per-channel spread, whose minimum sits at 0.949 whatever the global scale
# is. A per-channel multiplicative error cannot come from a global multiplier.
#
# It comes from the weight buffer. Each 16 byte unit is three [R,G,B,pad]
# groups and a FOURTH group that no kx ever reaches, because kx runs 0 to 2.
# Those four bytes keep whatever the memset left, which was zero. A stored byte
# is w - 0x80 and the hardware subtracts the weight zero point through B, so a
# lane's effective weight is stored - (wt_zp - 0x80). Zero is therefore not
# nothing: for conv0, whose weight zero point is 151, it is -23. Twelve lanes
# per output channel, three ky by four bytes, multiply real input data by -23.
#
# The neutral value is pad, exactly what the alpha lane beside them already
# gets. This is the same mistake the depthwise weight buffer had in its zero
# point lanes, and it hides on any per-axis tensor because there the zero point
# is 0 and the two agree. conv0 is the only per-TENSOR weight tensor in this
# project with a zero point that is not 128.
#
# DECISION RULE, written before the run:
#   the residual improves            those lanes were it, and the fix is one
#                                    memset
#   COMPUTED channels appear         conv0 is fixed
#   nothing changes                  the hardware ignores that fourth group
#                                    after all, and the half percent is
#                                    elsewhere
#   ROCKET_FC_ZERO_PAD restores      the control; it must put the old residual
#     the old numbers                back exactly
#   any other model moves            the first conv path is leaking
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
p() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== 1..2) conv0 with the neutral fill, and the control ====="
	p mn_conv0.tflite ""
	p mn_conv0.tflite ROCKET_FC_ZERO_PAD=1

	log ""
	log "===== 3) and with the measured multiplier as well ====="
	p mn_conv0.tflite ROCKET_FC_SCALE=0x7699

	log ""
	log "===== 4..5) the impulse models, which have the same lanes ====="
	p fc_imp.tflite ""
	p fc_allw.tflite ""

	log ""
	log "===== 6) the chain ====="
	p mn_conv0dw1.tflite ""

	log ""
	log "===== 7..9) REGRESSION ====="
	p conv2d-cal.tflite ""
	p mn_dw1.tflite ""
	p mn_dw25.tflite ""

	log ""
	log "===== 10) whole model ====="
	sleep 2
	env TEFLON_LIB=/usr/lib/libteflon.so \
		python3 "$NPU_DIR/test_model.py" "$NPU_DIR/conv2d-cal.tflite" 2 > "$C" 2>&1

	log ""
	log "===== Compare 1 with 2. The control must put the old 99.5 percent ====="
	log "===== back, or test 1 is not measuring the fill.                  ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
