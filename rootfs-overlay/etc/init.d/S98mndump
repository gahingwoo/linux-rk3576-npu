# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-24 round 376. THE 8 MS, AND THE DENOMINATOR THAT HID IT.
#
# ⚠ ROUND 375 ANSWERED BOTH ITS QUESTIONS AND THEN FOUND A THIRD THING: I HAD
# BEEN DIVIDING BY THE WRONG NUMBER SINCE ROUND 369.
#
# The stage table is reset after the prompt, so it counts GENERATED tokens.
# npudev's counters are never reset, so they cover the prompt as well -- six
# more forward passes. Dividing npudev by the generated count over-states it by
# 9.4% at 64 tokens and 1.6% at 384, and every "residue" computed from the two
# has been wrong by that difference.
#
#   ⛔ "the hardware path is 3.29 ms a token FASTER at 384" was that error.
#      Per PASS it is 58.66 and 59.93, which is the same, as it has to be.
#   ⛔ "the residue grows with context, 1.95 to 7.22 ms" was that error.
#      Per pass it is 7.77 and 8.17: constant, and not attention's.
#   ⛔ AND ROUND 369'S HEADLINE WAS WRONG. "The hole is closed, 1.67 ms left"
#      recomputes to 7.92 ms. The hole was never closed. Packing WAS most of
#      it -- the control proved that and still does -- but eight milliseconds
#      stayed and I filed them as under two.
#
# There is a comment beside llama_stages_reset about round 327 being lost to
# exactly this. The stage table was fixed then and npudev's counters were not.
#
# ✅ AND THE TWO QUESTIONS IT WAS ASKED:
#
#   the residue INSIDE npudev   0.047 ms a token at BOTH lengths -- nothing
#                               hides in there and its own accounting is whole
#   slow submits                1 of 9100, in the SHORT arm this time and not
#                               the long one, which inverts the pattern I twice
#                               offered a hardware story for. Random. Closed.
#
# ---------------------------------------------------------------------------
# SO WHERE ARE THE 8 MS
# ---------------------------------------------------------------------------
#
# Outside npudev, inside the stage rows: what llama.c does around the call. It
# is about 9% of a 90 ms token and it does not scale with the conversation.
#
# The first suspect is charsiu_act_set, which runs at the top of every matvec
# and quantises the activation TWICE -- once into blocks of 32 for the CPU path
# and once under a single scale for the NPU's operand shape. That is 231
# thousand elements a token, and **the int4 path reads the FLOAT activation and
# looks at neither result**. It survives only because q1_valid is what gates
# routing to the hardware at all.
#
# It is TIMED, not skipped. Skipping it is a correctness cliff -- any tensor
# that falls back to the CPU would read a stale quantisation -- and three
# derived numbers have already been read wrong today. On the host it is 0.67 ms
# a token of a 29.6 ms token; this board's CPU is five to eight times slower at
# that kind of work.
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# Nothing changes behaviour. The sentences must be round 375's and the rates
# must land inside the 0.8% band the repeat established.
#
# THE NEW ROW IS "quantising x", printed under the table and marked as being
# INSIDE the rows above rather than another row -- it is a slice through them,
# not a stage.
#
#   * near 4 ms would make it half the residue and worth the work to remove
#   * near 1 ms and it is not the story, and the rest of that 8 ms is somewhere
#     I have not looked -- say so rather than attacking it anyway
#
# ⚠ AND COMPUTE THE RESIDUE PER FORWARD PASS THIS TIME: generated tokens PLUS
# the six of the prompt. That is the whole lesson of round 375.
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT
# ---------------------------------------------------------------------------
#
# 3 to 5 ms, from the host's 0.67 and this CPU being several times slower. I
# have been optimistic more often than not, so nearer 3.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
VD=/opt/charsiu/charsiu_vendor
V=/opt/charsiu/vendor
RGC=$V/vendor-int4-k2048-n1024.regcmd
WT=$V/vendor-wt-1M.bin
IN=$V/vendor-in.bin
RUN=/opt/charsiu/charsiu_run
M8=/opt/charsiu/models/Llama-3.2-1B-Instruct-Q8_0.gguf
PROMPT="The capital of France is"
LIMIT=420
# 32 tokens does not reach the answer to "17 times 24, show your working"
NGEN=64
CE=CHARSIU_COEF_ELEMS=65536
HEAD=CHARSIU_NPU_MAXN=131072
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block did not come back this time."
		ABORT=1
	fi
}

capped() {
	lim="$1"; shift
	"$@" &
	pid=$!
	i=0
	while [ "$i" -lt "$lim" ]; do
		kill -0 "$pid" 2>/dev/null || { wait "$pid"; return $?; }
		sleep 1
		i=$((i + 1))
	done
	kill -9 "$pid" 2>/dev/null
	wait "$pid" 2>/dev/null
	return 124
}
rung() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $1"; return 0; }
	lbl="$1"; shift
	before=$(nbad)
	log ""
	log "  -- $lbl"
	sleep 1
	capped "$LIMIT" env "$@" "$RUN" "$M8" -p "$PROMPT" -n "${NGEN:-32}" \
		--ignore-eos -q -c 512 -t 4 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the rung exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This rung is VOID."; health; }
	return 0
}
# arm: <label> <regcmd-or-dash> <byte> <high> [extra env, one assignment]
#
# ⚠ THE ENV GOES IN AS AN ARGUMENT, not as a "VAR=x arm ..." prefix. Whether an
# assignment before a FUNCTION call survives the call is unspecified -- dash
# drops it, other shells keep it -- and the arm whose whole job is to time out
# WITHOUT the trailer runs right after the one that has it. Not a question worth
# leaving to the shell.
arm() {
	before=$(nbad)
	log ""
	log "  ---- $1"
	sleep 1
	env ${5:-IGNORED=1} $VD "$2" "$WT" "$IN" "$3" "$4" 4096 > /tmp/vd.txt 2>&1
	cat /tmp/vd.txt > "$C"
	after=$(nbad)
	if [ "$after" != "$before" ]; then
		log "  !! POISONED: $((after - before)) new fault or timeout lines"
		health
		# ⚠ NOT a round abort. Round 342 threw away every arm after the
		# first poisoning and then measured the block healthy at the
		# end. The block recovers; give it a moment and carry on.
		ABORT=0
		sleep 2
	fi
}

# two concurrent probes, so the pair can be repeated without copy and paste
pair() {
	before=$(nbad)
	log ""
	log "  ---- $1"
	env CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_TIME=60 CHARSIU_OUT_KB=64 $2 $VD - "$WT" "$IN" 0 0 4096 > /tmp/vdA.txt 2>&1 &
	pidA=$!
	env CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_TIME=60 CHARSIU_OUT_KB=64 $3 $VD - "$WT" "$IN" 0 0 4096 > /tmp/vdB.txt 2>&1 &
	pidB=$!
	wait "$pidA"
	wait "$pidB"
	log "    A:"
	grep -E "M = |TIME:|baseline:|VERIFY:|CONTROL repeat|VOID|REREAD" /tmp/vdA.txt > "$C"
	log "    B:"
	grep -E "M = |TIME:|baseline:|VERIFY:|CONTROL repeat|VOID|REREAD" /tmp/vdB.txt > "$C"
	after=$(nbad)
	[ "$after" != "$before" ] && log "  !! POISONED: $((after - before)) new lines"
	return 0
}

BW=/opt/charsiu/charsiu_membw
DEC="CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 CHARSIU_NPU_W4V=1 CHARSIU_NPU_KMAX=1024 CHARSIU_NPU_W4_GROUP=1024"

# decode and a memory reader at the same time, both numbers kept
squeeze() {
	log ""
	log "  ---- $1"
	sleep 1
	env $DEC "$CE" "$HEAD" "$RUN" "$M8" -p "$PROMPT" -n 128 --ignore-eos \
		-q -c 512 -t 4 > /tmp/dec.txt 2>&1 &
	dpid=$!
	# past staging and into generation before the reader starts
	sleep "$2"
	if [ -n "$3" ]; then
		env CHARSIU_THREADS=4 CHARSIU_SECONDS="$3" $BW > /tmp/bw.txt 2>&1
	fi
	wait "$dpid"
	grep -E "tensors staged|gen 128|GB/s of weights|of that," /tmp/dec.txt > "$C"
	[ -n "$3" ] && cat /tmp/bw.txt > "$C"
	return 0
}

start() {
	log ""
	log "###############################################################"
	log "##### round 376: the 8 ms, and where it is not              #####"
	log "###############################################################"
	log "  read quantising x. and divide by 390 and 70, not 384 and 64."

	B="CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 CHARSIU_NPU_W4V=1 CHARSIU_NPU_KMAX=1024 CHARSIU_NPU_W4_GROUP=1024 CHARSIU_STAGES=1"

	log ""
	log "===== 1) 384 tokens                                            ====="
	NGEN=384
	rung "int4 g1024, 384 tokens" $B "$CE" "$HEAD"
	NGEN=64

	log ""
	log "===== 2) 64 tokens                                             ====="
	rung "int4 g1024, 64 tokens" $B "$CE" "$HEAD"

	log ""
	log "===== 3) the probe, still exact                                ====="
	arm "solo verify" "-" 0 0 "CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_VERIFY=1 CHARSIU_OUT_KB=64"

	log ""
	log "===== 4) the anchor: int8 conv must still be exact            ====="
	health

	log ""
	log "===== read the CONTROL lines first. VOID means the arm died. ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
