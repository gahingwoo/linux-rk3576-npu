# ---------------------------------------------------------------------------
# 2026-08-22 round 336. THE CONTROL IGOR'S ANSWER IS MISSING.
#
# A reply to Igor has been sitting unsent since the 21st, and checking it before
# posting caught two things. That check has now earned its keep four times.
#
# 1) ⚠ IT SAID "I HAVE NOT RUN IT" AND WE HAD. Round 285 entry 9 is literally
#    titled "SIZE_E_1 crossed with the channel count. Owed to Igor."
#
# 2) ⚠ AND THE ROUND THAT RAN IT IS HALF A ROUND. It swept N of 16, 24, 32, 40,
#    48, 56 and 64 with SIZE_E_1 forced to 0 and never ran them at the traced
#    value of 1. Four of the seven happen to have a control elsewhere in the
#    same log and are inert. The other three do not:
#
#      N               16   24   32   40   48   56   64
#      words written   16   24   32   40   48   56   64
#      correct         16   16   32   24   48   32   64
#                           ^^        ^^        ^^   no same-round control
#
# ⚠ AND THE LOOSE END THAT MAKES THIS A ROUND RATHER THAN A SENTENCE. An earlier
# round at the TRACED value measured that asking for n channels writes
# floor(n/16)*16 of them: ask for 24 and 16 arrive. The table above, at
# SIZE_E_1 = 0, writes all 24. **If that survives a same-round control then
# SIZE_E_1 is NOT inert at the N that are not multiples of sixteen, and what it
# moves is the write count** -- the opposite of what Igor has been told twice.
#
# Two different rounds is not a comparison. This is the missing half.
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# ONE TABLE, SEVEN PAIRS, back to back in one boot at 0x4050 = 0x00023333 (the
# traced value, SIZE_E_1 = 1) and 0x00023133 (upstream, SIZE_E_1 = 0):
#
#   the pairs agree     SIZE_E_1 is inert at every N and the reply can say so
#   the 1 arm writes 16, 32, 48 where the 0 arm writes 24, 40, 56
#                       SIZE_E_1 moves the write count, the reply has to be
#                       rewritten, and Igor's conservative choice was right for
#                       a reason neither of us had
#
# The four multiples of sixteen run too, as the control that must show nothing.
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT
# ---------------------------------------------------------------------------
#
# The pairs agree, and the 24/40/56 shortfall is the sixteen quantum with
# nothing to do with SIZE_E_1 -- because that quantum was measured on a round
# where SIZE_E_1 sat at its traced value throughout. That is the boring reading
# and it is the one the cross-round numbers actually point at.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
RUN=/opt/charsiu/charsiu_run
BE=/opt/charsiu/charsiu_bench
MM=/opt/charsiu/charsiu_matmul
I4=/opt/charsiu/charsiu_int4
M4="CHARSIU_W4=1 CHARSIU_W4_HALFK=1"
M8=/opt/charsiu/models/Llama-3.2-1B-Instruct-Q8_0.gguf
PROMPT="The capital of France is"
LIMIT=420
ARMCAP=240
CE=CHARSIU_COEF_ELEMS=65536
HEAD=CHARSIU_NPU_MAXN=131072
B8="CHARSIU_OVERRIDE=0x40b8=3"
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

capped() {
	lim="$1"; shift
	"$@" &
	pid=$!
	i=0
	while [ "$i" -lt "$lim" ]; do
		kill -0 "$pid" 2>/dev/null || { wait "$pid"; return $?; }
		sleep 1
		i=$((i + 1))
	done
	kill -9 "$pid" 2>/dev/null
	wait "$pid" 2>/dev/null
	return 124
}

c() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $*"; return 0; }
	before=$(nbad)
	sleep 1
	capped "$ARMCAP" env $1 $2 $3 $4 $5 $6 $7 $8 $9 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the arm exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This arm is VOID."; health; }
	return 0
}

rung() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $1"; return 0; }
	lbl="$1"; shift
	before=$(nbad)
	log ""
	log "  -- $lbl"
	sleep 1
	capped "$LIMIT" env "$@" "$RUN" "$M8" -p "$PROMPT" -n 32 \
		--ignore-eos -q -c 512 -t 4 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the rung exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This rung is VOID."; health; }
	return 0
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	[ -w /sys/module/rocket/parameters/reset_autosuspend ] && \
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend

	log ""
	log "===== 0) the limit's own control. expect rc 124 after ~3s.         ====="
	t0=$(cut -d. -f1 /proc/uptime)
	capped 3 sleep 60
	rc=$?
	t1=$(cut -d. -f1 /proc/uptime)
	log "  -- capped 3 sleep 60  ->  rc $rc after $((t1 - t0))s"
	[ "$rc" = "124" ] || log "  !! THE LIMIT DID NOT FIRE. Nothing below can be trusted to end."

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "##### ROUND 336: the control Igor is owed                         #####"

	log ""
	log "===== 2) THE MEASUREMENT. every stage of the forward pass, NPU on. ====="
	log "=====    matmul stages minus the hardware path = the quantise.     ====="
	rung "the decode loop on the NPU, stages on" \
		CHARSIU_STAGES=1 CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 "$CE" "$HEAD"

	log ""
	log "===== 2b) the same stages with the NPU off, one boot apart.        ====="
	rung "the CPU path, stages on" CHARSIU_STAGES=1 CHARSIU_NPU_QUANT=1

	log ""
	log "===== 2) SIZE_E_1 against the channel count, WITH the control.     ====="
	log "=====    traced 0x00023333 vs upstream 0x00023133, same boot.      ====="
	for NN in 24 40 56 16 32 48 64; do
		log ""
		log "===== N = $NN   SIZE_E_1 = 1  (traced)   <-- THE CONTROL"
		c "$M4" "CHARSIU_OVERRIDE=0x4050=0x00023333" $MM 1 64 $NN
		log "===== N = $NN   SIZE_E_1 = 0  (upstream)"
		c "$M4" "CHARSIU_OVERRIDE=0x4050=0x00023133" $MM 1 64 $NN
	done

	log ""
	log "===== 5) the standing number, no timers, so they cannot be blamed  ====="
	rung "the decode loop on the NPU" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 "$CE" "$HEAD"

	log ""
	log "===== the anchor again                                             ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== read the pairs: agree = inert, differ = the reply is wrong.   ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
