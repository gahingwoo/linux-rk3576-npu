# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-22 round 335. int4 IS CORRECT AT A PROJECTION'S SHAPE. WHAT DOES IT COST?
#
# 🔑🔑 ROUND 334 FINISHED THE ARITHMETIC. The missing register was DPU 0x4030's
# high half -- 0x3020 alone and 0x3020 with 0x402c both wrote N words and got
# half the channels, and 0x4030 is the one that was capping the write:
#
#   N=256  K=2048    512 words written   **256 EXACT of 256**
#   N=512  K=1024   1024 words written   **512 EXACT of 512**
#   N=1024 K=2048   2048 words written  **1024 EXACT of 1024**
#
# **That last one is a projection's shape at 1 MiB of weights, byte exact, with
# no halfk and against the full K reference** -- the shape where int4 used to
# collapse to nine milliseconds.
#
# Nothing in it is guessed. The slots came from --map at 1376 points, the k from
# --kpair, the intra-slot order from rounds 265-288 and re-confirmed by 332's
# control, and the three count registers from 334 one at a time.
#
# The whole recipe is now one flag, CHARSIU_W4_PAIRED, in the emitter:
#
#   channel r is the pair of words (2r, 2r+1)
#   k = 16*(w mod 2) + 32*j + 2*byte_in_slot + nibble
#   CORE 0x3020 = 2N-1,  DPU 0x4030 high = 2N-1,  DPU 0x40b8 = 3
#   read out[2r] + out[2r+1];  buffer unchanged at N*K/2 bytes
#
# ---------------------------------------------------------------------------
# SO THIS ROUND IS THE PRICE, AND IT IS THE ONLY THING LEFT THAT DECIDES int4
# ---------------------------------------------------------------------------
#
# Correct is not enough. int8 fits **9.3 GB/s** on medians and never stalls, and
# int4 moves half the bytes, so **int4 has to beat 4.7 GB/s to be worth
# anything at all**. Everything measured before this round said it does not --
# 1.37 GB/s at K=512, 3.5 with 0x40b8 = 3, and nine to fifteen reps in fifty
# stalling to 100 ms above N=1024.
#
# ⚠ But every one of those numbers was taken with the OLD register set, which
# asked for N words and half the channels. **The paired recipe changes what the
# hardware is being asked to do, so the price has to be measured again.**
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# 1) ENTRY 2 IS THE CORRECTNESS ANCHOR: N=1024 K=2048 must print 1024 EXACT of
#    1024 again. If it does not, 334 was a one-boot accident.
# 2) ENTRY 3 IS THE ROUND: the same sweep as int8, on MEDIANS with the stall
#    count, at the paired recipe. Read the `reps > 2x median` column first --
#    a median of 300 us with fifteen stalls is a different problem from a
#    median of 9000.
# 3) THE NUMBER THAT DECIDES IT: int4's us/MB against int8's in the same boot.
#    **Below half of int8's us/MB and int4 wins the token; above it and int4 is
#    correct and useless**, and that is a clean place to stop.
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT
# ---------------------------------------------------------------------------
#
# No prediction on the speed. The correctness came from measurement and so
# should this.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
RUN=/opt/charsiu/charsiu_run
BE=/opt/charsiu/charsiu_bench
MM=/opt/charsiu/charsiu_matmul
I4=/opt/charsiu/charsiu_int4
M4="CHARSIU_W4=1 CHARSIU_W4_HALFK=1"
M8=/opt/charsiu/models/Llama-3.2-1B-Instruct-Q8_0.gguf
PROMPT="The capital of France is"
LIMIT=420
ARMCAP=240
CE=CHARSIU_COEF_ELEMS=65536
HEAD=CHARSIU_NPU_MAXN=131072
B8="CHARSIU_OVERRIDE=0x40b8=3"
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

capped() {
	lim="$1"; shift
	"$@" &
	pid=$!
	i=0
	while [ "$i" -lt "$lim" ]; do
		kill -0 "$pid" 2>/dev/null || { wait "$pid"; return $?; }
		sleep 1
		i=$((i + 1))
	done
	kill -9 "$pid" 2>/dev/null
	wait "$pid" 2>/dev/null
	return 124
}

c() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $*"; return 0; }
	before=$(nbad)
	sleep 1
	capped "$ARMCAP" env $1 $2 $3 $4 $5 $6 $7 $8 $9 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the arm exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This arm is VOID."; health; }
	return 0
}

rung() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $1"; return 0; }
	lbl="$1"; shift
	before=$(nbad)
	log ""
	log "  -- $lbl"
	sleep 1
	capped "$LIMIT" env "$@" "$RUN" "$M8" -p "$PROMPT" -n 32 \
		--ignore-eos -q -c 512 -t 4 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the rung exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This rung is VOID."; health; }
	return 0
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	[ -w /sys/module/rocket/parameters/reset_autosuspend ] && \
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend

	log ""
	log "===== 0) the limit's own control. expect rc 124 after ~3s.         ====="
	t0=$(cut -d. -f1 /proc/uptime)
	capped 3 sleep 60
	rc=$?
	t1=$(cut -d. -f1 /proc/uptime)
	log "  -- capped 3 sleep 60  ->  rc $rc after $((t1 - t0))s"
	[ "$rc" = "124" ] || log "  !! THE LIMIT DID NOT FIRE. Nothing below can be trusted to end."

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "##### ROUND 335: int4 is correct. what does it cost?              #####"

	log ""
	log "===== 2) THE MEASUREMENT. every stage of the forward pass, NPU on. ====="
	log "=====    matmul stages minus the hardware path = the quantise.     ====="
	rung "the decode loop on the NPU, stages on" \
		CHARSIU_STAGES=1 CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 "$CE" "$HEAD"

	log ""
	log "===== 2b) the same stages with the NPU off, one boot apart.        ====="
	rung "the CPU path, stages on" CHARSIU_STAGES=1 CHARSIU_NPU_QUANT=1

	log ""
	log "===== 2) the correctness anchor: the whole recipe behind one flag  ====="
	c "CHARSIU_W4=1 CHARSIU_W4_PAIRED=1 CHARSIU_COEF_ELEMS=65536" $MM 1 64 64
	c "CHARSIU_W4=1 CHARSIU_W4_PAIRED=1 CHARSIU_COEF_ELEMS=65536" $MM 1 2048 256
	c "CHARSIU_W4=1 CHARSIU_W4_PAIRED=1 CHARSIU_COEF_ELEMS=65536" $MM 1 2048 1024

	log ""
	log "===== 3) THE PRICE. int8 is 9.3 GB/s, so int4 needs 4.7 to win.    ====="
	log "===== 3a int4, the paired recipe"
	c "CHARSIU_W4=1 CHARSIU_W4_PAIRED=1" "$CE" $BE --nsweep 2048 50
	log "===== 3b int4 as it was, for the before and after"
	c "CHARSIU_W4=1" "$CE" $BE --nsweep 2048 50
	log "===== 3c int8 in the same boot, the denominator"
	c "$CE" $BE --nsweep 2048 50
	log "===== 3d and at K=512, where no cliff can hide the slope"
	c "CHARSIU_W4=1 CHARSIU_W4_PAIRED=1" "$CE" $BE --nsweep 512 50
	c "$CE" $BE --nsweep 512 50

	log ""
	log "===== 5) the standing number, no timers, so they cannot be blamed  ====="
	rung "the decode loop on the NPU" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 "$CE" "$HEAD"

	log ""
	log "===== the anchor again                                             ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== entry 2 must reproduce 1024 of 1024; entry 3 decides int4.    ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
