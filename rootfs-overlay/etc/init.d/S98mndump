# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-24 round 375. TWO DERIVED NUMBERS, MEASURED INSTEAD.
#
# 🏁 ROUND 374 RAN TWICE, and the repeat is worth as much as the first.
#
#                              run 1    run 2   spread
#   384 head major tok/s       10.98    11.06    0.73%
#   384 head major attention   16.28    16.37    0.55%
#   384 pos major attention    22.76    22.89    0.57%
#   64  head major tok/s       13.19    13.28    0.68%
#
# **Run to run spread is 0.3 to 0.8 percent.** Nothing in this project had ever
# measured that, and it is the scale to read every earlier number against: under
# a percent is noise, five percent is real. The layout gain reproduced at 6.48
# and 6.52 ms.
#
# ⚠ AND THE FLOOR I STATED BEFORE ROUND 374 WAS WRONG IN BOTH RUNS. I wrote
# that attention could not go below about 20.2 ms; it came back at 16.28 and
# 16.37. The model behind the floor -- attention = compute + bytes over a rate
# -- needs NEGATIVE traffic to fit the third point, so it is refuted by its own
# data. Strided against contiguous is prefetch and latency, not throughput.
#
#   per head + position major   37.93 ms
#   grouped  + position major   22.76
#   grouped  + head major       16.28      **-57% over two rounds**
#
# ---------------------------------------------------------------------------
# TWO THINGS THAT LOOKED LIKE FINDINGS AND WERE INSTRUMENTS
# ---------------------------------------------------------------------------
#
# ⛔ THE "NPU IS SLOW" NOTICE IS NOT ABOUT THE NPU IDLING. It fired in all three
# long context runs and no short one, always at K=2048 N=2048, and I twice
# offered the same guess: that attention's 16 to 38 ms gaps let the clock drop.
# Arithmetic settles it without a board round.
#
#   * the floor is a RATE, so the stall needed to trip it scales with the
#     tensor: o_proj is 2.1 MB and trips on 1.0 ms, down is 8.4 MB and needs
#     4.2, the head is 131 MB and needs 65.7.
#   * the GROUPED path has no check at all, so q, k, v, gate and up can never
#     trip it. Three tensors are watched and o_proj is the smallest.
#   * and it cannot be per token: o_proj at 0.84 GB/s would take 98 ms instead
#     of 8, and the token would be 180 ms rather than 90.
#
# So it is a rare stall, and a long run trips it because it has six times the
# submits. It COUNTS them now instead of printing one and going quiet.
#
# ⚠ AND THE WRAPPER RESIDUE WAS A SUBTRACTION. Five NPU rows minus the hardware
# path minus the packing left 1.95 ms a token at 64 and 7.22 at 384 -- while the
# hardware path itself was 3.16 ms a token FASTER at the longer context. That is
# time moving between timers, not work being done, and two derived numbers have
# already been read wrong today. npudev now times the whole call, entry to
# return, so what is left over is only what llama.c does around it.
#
# ⚠ A BUG DIED IN THAT CHANGE THAT THE HOST COULD NOT HAVE CAUGHT. The timer
# line went in between an if and its unbraced return, so the early return became
# unconditional and the final conversion loop -- the one int8 and ungrouped int4
# need -- would never have run. The host hash was still correct, because the
# host does not go through npudev at all. gcc caught it on indentation.
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# Nothing here changes behaviour, so the sentences must be exactly round 374's
# and the rates must land inside the 0.8% band the repeat established.
#
# THEN THE NEW END TO END LINE, at both lengths. The subtraction said 1.95 ms at
# 64 and 7.22 at 384.
#   * if the measured one agrees, the residue is real AND grows with context,
#     which is a new thing to chase and nothing in that wrapper should scale
#     with the conversation.
#   * if it disagrees, the subtraction was wrong a third time and the stage
#     table and npudev are not measuring the same interval.
#
# THEN THE SLOW COUNT out of about 50700 submits at 384 tokens. One or two says
# rare stall and closes it. Hundreds says something systematic and the count
# will say which shape.
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT
# ---------------------------------------------------------------------------
#
# The end to end number to come out NEAR the hardware path plus the packing at
# 64 tokens and well above it at 384, confirming the residue -- and I have no
# story for why it would scale, which is the point of measuring it. A handful of
# slow submits, not hundreds.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
VD=/opt/charsiu/charsiu_vendor
V=/opt/charsiu/vendor
RGC=$V/vendor-int4-k2048-n1024.regcmd
WT=$V/vendor-wt-1M.bin
IN=$V/vendor-in.bin
RUN=/opt/charsiu/charsiu_run
M8=/opt/charsiu/models/Llama-3.2-1B-Instruct-Q8_0.gguf
PROMPT="The capital of France is"
LIMIT=420
# 32 tokens does not reach the answer to "17 times 24, show your working"
NGEN=64
CE=CHARSIU_COEF_ELEMS=65536
HEAD=CHARSIU_NPU_MAXN=131072
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block did not come back this time."
		ABORT=1
	fi
}

capped() {
	lim="$1"; shift
	"$@" &
	pid=$!
	i=0
	while [ "$i" -lt "$lim" ]; do
		kill -0 "$pid" 2>/dev/null || { wait "$pid"; return $?; }
		sleep 1
		i=$((i + 1))
	done
	kill -9 "$pid" 2>/dev/null
	wait "$pid" 2>/dev/null
	return 124
}
rung() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $1"; return 0; }
	lbl="$1"; shift
	before=$(nbad)
	log ""
	log "  -- $lbl"
	sleep 1
	capped "$LIMIT" env "$@" "$RUN" "$M8" -p "$PROMPT" -n "${NGEN:-32}" \
		--ignore-eos -q -c 512 -t 4 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the rung exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This rung is VOID."; health; }
	return 0
}
# arm: <label> <regcmd-or-dash> <byte> <high> [extra env, one assignment]
#
# ⚠ THE ENV GOES IN AS AN ARGUMENT, not as a "VAR=x arm ..." prefix. Whether an
# assignment before a FUNCTION call survives the call is unspecified -- dash
# drops it, other shells keep it -- and the arm whose whole job is to time out
# WITHOUT the trailer runs right after the one that has it. Not a question worth
# leaving to the shell.
arm() {
	before=$(nbad)
	log ""
	log "  ---- $1"
	sleep 1
	env ${5:-IGNORED=1} $VD "$2" "$WT" "$IN" "$3" "$4" 4096 > /tmp/vd.txt 2>&1
	cat /tmp/vd.txt > "$C"
	after=$(nbad)
	if [ "$after" != "$before" ]; then
		log "  !! POISONED: $((after - before)) new fault or timeout lines"
		health
		# ⚠ NOT a round abort. Round 342 threw away every arm after the
		# first poisoning and then measured the block healthy at the
		# end. The block recovers; give it a moment and carry on.
		ABORT=0
		sleep 2
	fi
}

# two concurrent probes, so the pair can be repeated without copy and paste
pair() {
	before=$(nbad)
	log ""
	log "  ---- $1"
	env CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_TIME=60 CHARSIU_OUT_KB=64 $2 $VD - "$WT" "$IN" 0 0 4096 > /tmp/vdA.txt 2>&1 &
	pidA=$!
	env CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_TIME=60 CHARSIU_OUT_KB=64 $3 $VD - "$WT" "$IN" 0 0 4096 > /tmp/vdB.txt 2>&1 &
	pidB=$!
	wait "$pidA"
	wait "$pidB"
	log "    A:"
	grep -E "M = |TIME:|baseline:|VERIFY:|CONTROL repeat|VOID|REREAD" /tmp/vdA.txt > "$C"
	log "    B:"
	grep -E "M = |TIME:|baseline:|VERIFY:|CONTROL repeat|VOID|REREAD" /tmp/vdB.txt > "$C"
	after=$(nbad)
	[ "$after" != "$before" ] && log "  !! POISONED: $((after - before)) new lines"
	return 0
}

BW=/opt/charsiu/charsiu_membw
DEC="CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 CHARSIU_NPU_W4V=1 CHARSIU_NPU_KMAX=1024 CHARSIU_NPU_W4_GROUP=1024"

# decode and a memory reader at the same time, both numbers kept
squeeze() {
	log ""
	log "  ---- $1"
	sleep 1
	env $DEC "$CE" "$HEAD" "$RUN" "$M8" -p "$PROMPT" -n 128 --ignore-eos \
		-q -c 512 -t 4 > /tmp/dec.txt 2>&1 &
	dpid=$!
	# past staging and into generation before the reader starts
	sleep "$2"
	if [ -n "$3" ]; then
		env CHARSIU_THREADS=4 CHARSIU_SECONDS="$3" $BW > /tmp/bw.txt 2>&1
	fi
	wait "$dpid"
	grep -E "tensors staged|gen 128|GB/s of weights|of that," /tmp/dec.txt > "$C"
	[ -n "$3" ] && cat /tmp/bw.txt > "$C"
	return 0
}

start() {
	log ""
	log "###############################################################"
	log "##### round 375: two derived numbers, measured instead      #####"
	log "###############################################################"
	log "  nothing changes behaviour. read the new end-to-end line."

	B="CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 CHARSIU_NPU_W4V=1 CHARSIU_NPU_KMAX=1024 CHARSIU_NPU_W4_GROUP=1024 CHARSIU_STAGES=1"

	log ""
	log "===== 1) 384 tokens                                            ====="
	log "  the subtraction said 7.22 ms a token was neither"
	log "  hardware nor packing. is it?"
	NGEN=384
	rung "int4 g1024, 384 tokens" $B "$CE" "$HEAD"
	NGEN=64

	log ""
	log "===== 2) 64 tokens                                             ====="
	log "  the subtraction said 1.95 ms here."
	rung "int4 g1024, 64 tokens" $B "$CE" "$HEAD"

	log ""
	log "===== 3) the probe, still exact                                ====="
	arm "solo verify" "-" 0 0 "CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_VERIFY=1 CHARSIU_OUT_KB=64"

	log ""
	log "===== 4) the anchor: int8 conv must still be exact            ====="
	health

	log ""
	log "===== read the CONTROL lines first. VOID means the arm died. ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
