# ---------------------------------------------------------------------------
# 2026-08-23 round 354. THE MIDDLE OF THE GROUP SWEEP, AND WHERE THE LOAD GOES.
#
# 🔑 ROUND 353: GROUPING FIXES THE SENTENCE AND int4 STILL WINS.
#
#   int4, one scale a row   10.09 tok/s  "Paris. Paris is the most populous
#                                         city... most famous... most beautiful"
#   int4, group 512          7.50 tok/s  "The Eiffel Tower is a famous landmark
#                                         in Paris. The tower is over 1,000 feet
#                                         tall and was built in the late 19"
#   int4, group 128          3.51 tok/s  "known for its beautiful architecture,
#                                         art museums, and fashion industry..."
#   int8, KMAX 512           5.26 tok/s  the standing sentence
#   int8, standing           6.53 tok/s  the standing sentence
#
# **Group 512 is 15% faster than int8 AND says true things**: the tower, a
# thousand feet, the late nineteenth century. Group 128 reads better still and
# is slower than int8, so it is not the answer.
#
# WHAT GROUPING COSTS, and it is not submits. All three int4 arms made 2470
# submits. The SLICES went 144, 704, 2816 and with them the hardware path
# (3051, 4361, 10060 ms) and the read back (153, 670, 4360 ms). The cost is a
# task and a CPU accumulate per slice, so the sweep between 2048 and 512 has
# never been looked at -- 1024 would be 288 slices.
#
# ⚠ AND MY STAGING FIX DID NOT WORK. Arm 1 still took 102 s. I also had the
# comparison wrong last round: int8's staging is 16 s, not 303 ms -- the 303 ms
# line is the gguf mmap, and the heartbeat shows int8's real staging. So int4 is
# SIX times slower to stage, not three hundred, and packing into ordinary memory
# and copying did not move it. That was my only guess, so this round measures
# rather than guessing again: the heartbeat now splits the time into what is
# spent inside charsiu_npu_add and what is left over, which is the quantiser.
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# THE HEARTBEAT SPLIT IS THE DIAGNOSTIC AND IT IS FREE. If "adding" carries the
# time, it is the packer or the buffer objects; if "quantising" carries it, it
# is npu_tensor_build and the packer was never the problem. The two are far
# enough apart that one line settles it.
#
# ENTRY 1 is group 1024, the point nobody has run: 288 slices, half the extra
# cost of 512. If its sentence is as good as 512's it is the answer.
#
# ENTRIES 2 AND 3 reproduce 512 and 2048 so the three sit in one boot with one
# thermal state. ⚠ Round 349 to 350 showed a single shape timing moving 20%
# between boots, and a tok/s is a single measurement too.
#
# ENTRY 4 is the int8 control, which must still be 6.53.
#
# ⚠ FOUR SENTENCES ARE NOT AN ACCURACY MEASUREMENT. They are enough to tell
# circling from not circling and nothing more. If group 1024 lands between the
# two, that is a judgement call and it should be made against KL over several
# prompts, not against one sentence about Paris.
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT
# ---------------------------------------------------------------------------
#
# Group 1024 near 8.7 tok/s, and the sentence is the coin flip. On the load, I
# expect the quantiser rather than the packer, because the packer got faster
# twice and the number did not move.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
VD=/opt/charsiu/charsiu_vendor
V=/opt/charsiu/vendor
RGC=$V/vendor-int4-k2048-n1024.regcmd
WT=$V/vendor-wt-1M.bin
IN=$V/vendor-in.bin
RUN=/opt/charsiu/charsiu_run
M8=/opt/charsiu/models/Llama-3.2-1B-Instruct-Q8_0.gguf
PROMPT="The capital of France is"
LIMIT=420
CE=CHARSIU_COEF_ELEMS=65536
HEAD=CHARSIU_NPU_MAXN=131072
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block did not come back this time."
		ABORT=1
	fi
}

capped() {
	lim="$1"; shift
	"$@" &
	pid=$!
	i=0
	while [ "$i" -lt "$lim" ]; do
		kill -0 "$pid" 2>/dev/null || { wait "$pid"; return $?; }
		sleep 1
		i=$((i + 1))
	done
	kill -9 "$pid" 2>/dev/null
	wait "$pid" 2>/dev/null
	return 124
}
rung() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $1"; return 0; }
	lbl="$1"; shift
	before=$(nbad)
	log ""
	log "  -- $lbl"
	sleep 1
	capped "$LIMIT" env "$@" "$RUN" "$M8" -p "$PROMPT" -n 32 \
		--ignore-eos -q -c 512 -t 4 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the rung exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This rung is VOID."; health; }
	return 0
}
# arm: <label> <regcmd-or-dash> <byte> <high> [extra env, one assignment]
#
# ⚠ THE ENV GOES IN AS AN ARGUMENT, not as a "VAR=x arm ..." prefix. Whether an
# assignment before a FUNCTION call survives the call is unspecified -- dash
# drops it, other shells keep it -- and the arm whose whole job is to time out
# WITHOUT the trailer runs right after the one that has it. Not a question worth
# leaving to the shell.
arm() {
	before=$(nbad)
	log ""
	log "  ---- $1"
	sleep 1
	env ${5:-IGNORED=1} $VD "$2" "$WT" "$IN" "$3" "$4" 4096 > /tmp/vd.txt 2>&1
	cat /tmp/vd.txt > "$C"
	after=$(nbad)
	if [ "$after" != "$before" ]; then
		log "  !! POISONED: $((after - before)) new fault or timeout lines"
		health
		# ⚠ NOT a round abort. Round 342 threw away every arm after the
		# first poisoning and then measured the block healthy at the
		# end. The block recovers; give it a moment and carry on.
		ABORT=0
		sleep 2
	fi
}

start() {
	log ""
	log "###############################################################"
	log "##### round 354: the middle of the group sweep, and where the load goes #####"
	log "###############################################################"
	log "  int4 is byte exact and 1.42 to 1.78x faster. now decode with it."

	log ""
	log "===== 1) int4, group 1024. THE POINT NOBODY HAS RUN.          ====="
	log "  288 slices, half of 512's extra cost. read the sentence."
	rung "int4, group 1024" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 CHARSIU_NPU_W4V=1 \
		CHARSIU_NPU_KMAX=1024 CHARSIU_NPU_W4_GROUP=1024 "$CE" "$HEAD"

	log ""
	log "===== 2) int4, group 512. must reproduce 7.50 and the tower.   ====="
	rung "int4, group 512" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 CHARSIU_NPU_W4V=1 \
		CHARSIU_NPU_KMAX=512 CHARSIU_NPU_W4_GROUP=512 "$CE" "$HEAD"

	log ""
	log "===== 3) int4, one scale a row. must reproduce 10.09, circling. ====="
	rung "int4, one scale a row" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 CHARSIU_NPU_W4V=1 "$CE" "$HEAD"

	log ""
	log "===== 4) CONTROL: the standing int8 decode, 6.53 tok/s        ====="
	rung "int8, the standing number" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 "$CE" "$HEAD"

	log ""
	log "===== 6) the anchor: int8 conv must still be exact           ====="
	health

	log ""
	log "===== read the CONTROL lines first. VOID means the arm died. ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
