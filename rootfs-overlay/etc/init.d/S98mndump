#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-23 round 359. THE SECOND CORE IS REAL. IS IT CORRECT?
#
# ✅✅ ROUND 358: BOTH CORES PROBE AND TWO PROCESSES GET 2.3x.
#
#   rocket 27700000.npu: Rockchip NPU core 0 version: 1179210311
#   rocket 27708000.npu: Rockchip NPU core 1 version: 1179210311
#
#   one process alone   295.8 us a submit
#   two at once, A      223.9 us
#   two at once, B      253.9 us
#
# Both concurrent processes beat the solo one, so 400 submits finished in about
# the time 170 would have taken alone: **2.3x aggregate**. The factor of two is
# there. The decode did not move, 8.51 tok/s, exactly as predicted -- charsiu
# opens one DRM file and waits on every submit, so a second core cannot reach it.
#
# ⛔ AND PROCESS B FAILED ITS REPEAT CONTROL: 552 of 1024 words differed between
# two submits with nothing changed in between. **A 2x that returns a different
# answer each time is worth nothing.** This round characterises that before
# anything is built on it.
#
# RULED OUT ALREADY, from the boot log and the driver source:
#   the cores are in SEPARATE iommu groups, 2 and 3, so one process's domain
#   cannot be yanked from under the other's job;
#   each open DRM file has its own domain and its own scheduler entity, and the
#   scheduler serialises jobs within a core.
#
# NOT RULED OUT: both cores claim BOTH power domains, in opposite order, and
# rocket runs a 50 ms autosuspend per core.
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# ENTRY 1 is the control that has to hold: ONE process, three times. If a solo
# repeat control ever differs, this is not about concurrency at all and every
# number in round 358 is suspect.
#
# ENTRY 2 is two processes, three times. Reliable, or a one off, and does it
# stay with B or move.
#
# ENTRY 3 is the same with runtime power management pinned on for both cores.
# Corruption that disappears there is a power domain race and the fix is in the
# driver.
#
# ENTRY 4 runs the pair at DIFFERENT shapes. If one ever sees the other's data,
# the live word count says so, because N differs.
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT
# ---------------------------------------------------------------------------
#
# Entry 1 clean, entry 2 reproducing. On entry 3 I have no prior worth stating:
# the autosuspend delay is 50 ms and these are 200 submits back to back, so a
# core should never idle that long -- which argues it is NOT power management,
# and the honest thing is to measure rather than reason from the delay.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
VD=/opt/charsiu/charsiu_vendor
V=/opt/charsiu/vendor
RGC=$V/vendor-int4-k2048-n1024.regcmd
WT=$V/vendor-wt-1M.bin
IN=$V/vendor-in.bin
RUN=/opt/charsiu/charsiu_run
M8=/opt/charsiu/models/Llama-3.2-1B-Instruct-Q8_0.gguf
PROMPT="The capital of France is"
LIMIT=420
# 32 tokens does not reach the answer to "17 times 24, show your working"
NGEN=64
CE=CHARSIU_COEF_ELEMS=65536
HEAD=CHARSIU_NPU_MAXN=131072
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block did not come back this time."
		ABORT=1
	fi
}

capped() {
	lim="$1"; shift
	"$@" &
	pid=$!
	i=0
	while [ "$i" -lt "$lim" ]; do
		kill -0 "$pid" 2>/dev/null || { wait "$pid"; return $?; }
		sleep 1
		i=$((i + 1))
	done
	kill -9 "$pid" 2>/dev/null
	wait "$pid" 2>/dev/null
	return 124
}
rung() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $1"; return 0; }
	lbl="$1"; shift
	before=$(nbad)
	log ""
	log "  -- $lbl"
	sleep 1
	capped "$LIMIT" env "$@" "$RUN" "$M8" -p "$PROMPT" -n "${NGEN:-32}" \
		--ignore-eos -q -c 512 -t 4 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the rung exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This rung is VOID."; health; }
	return 0
}
# arm: <label> <regcmd-or-dash> <byte> <high> [extra env, one assignment]
#
# ⚠ THE ENV GOES IN AS AN ARGUMENT, not as a "VAR=x arm ..." prefix. Whether an
# assignment before a FUNCTION call survives the call is unspecified -- dash
# drops it, other shells keep it -- and the arm whose whole job is to time out
# WITHOUT the trailer runs right after the one that has it. Not a question worth
# leaving to the shell.
arm() {
	before=$(nbad)
	log ""
	log "  ---- $1"
	sleep 1
	env ${5:-IGNORED=1} $VD "$2" "$WT" "$IN" "$3" "$4" 4096 > /tmp/vd.txt 2>&1
	cat /tmp/vd.txt > "$C"
	after=$(nbad)
	if [ "$after" != "$before" ]; then
		log "  !! POISONED: $((after - before)) new fault or timeout lines"
		health
		# ⚠ NOT a round abort. Round 342 threw away every arm after the
		# first poisoning and then measured the block healthy at the
		# end. The block recovers; give it a moment and carry on.
		ABORT=0
		sleep 2
	fi
}

# two concurrent probes, so the pair can be repeated without copy and paste
pair() {
	before=$(nbad)
	log ""
	log "  ---- $1"
	env CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_TIME=60 CHARSIU_OUT_KB=64 $2 $VD - "$WT" "$IN" 0 0 4096 > /tmp/vdA.txt 2>&1 &
	pidA=$!
	env CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_TIME=60 CHARSIU_OUT_KB=64 $3 $VD - "$WT" "$IN" 0 0 4096 > /tmp/vdB.txt 2>&1 &
	pidB=$!
	wait "$pidA"
	wait "$pidB"
	log "    A:"
	grep -E "M = |TIME:|baseline:|CONTROL repeat|VOID" /tmp/vdA.txt > "$C"
	log "    B:"
	grep -E "M = |TIME:|baseline:|CONTROL repeat|VOID" /tmp/vdB.txt > "$C"
	after=$(nbad)
	[ "$after" != "$before" ] && log "  !! POISONED: $((after - before)) new lines"
	return 0
}

start() {
	log ""
	log "###############################################################"
	log "##### round 359: the second core is real. is it correct?     #####"
	log "###############################################################"
	log "  int4 is byte exact and 1.42 to 1.78x faster. now decode with it."

	log ""
	log "===== 0) both cores, and their power policy                   ====="
	dmesg 2>/dev/null | grep -i "NPU core" > "$C"
	for d in /sys/devices/platform/2770*.npu/power/control; do
		log "  $d = $(cat "$d" 2>/dev/null)"
	done

	log ""
	log "===== 1) CONTROL: ONE process, three times. must never differ. ====="
	arm "solo 1" "-" 0 0 "CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_TIME=60 CHARSIU_OUT_KB=64"
	arm "solo 2" "-" 0 0 "CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_TIME=60 CHARSIU_OUT_KB=64"
	arm "solo 3" "-" 0 0 "CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_TIME=60 CHARSIU_OUT_KB=64"

	log ""
	log "===== 2) two at once, three times. reliable, or a one off?     ====="
	pair "pair 1" "" ""
	pair "pair 2" "" ""
	pair "pair 3" "" ""

	log ""
	log "===== 3) the same with runtime PM pinned on for both cores     ====="
	for d in /sys/devices/platform/2770*.npu/power/control; do
		echo on > "$d" 2>/dev/null
		log "  $d = $(cat "$d" 2>/dev/null)"
	done
	pair "pair, PM on 1" "" ""
	pair "pair, PM on 2" "" ""
	for d in /sys/devices/platform/2770*.npu/power/control; do
		echo auto > "$d" 2>/dev/null
	done

	log ""
	log "===== 4) two at DIFFERENT shapes. a swap shows in the counts.  ====="
	log "  A is N=1024 and must show 1024 live; B is N=256."
	pair "mixed shapes" "" "CHARSIU_N=256"

	log ""
	log "===== 5) the anchor: int8 conv must still be exact            ====="
	health

	log ""
	log "===== read the CONTROL lines first. VOID means the arm died. ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
