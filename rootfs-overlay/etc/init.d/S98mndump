# ---------------------------------------------------------------------------
# 2026-08-21 round 303. K is a multiple of 32, and where the CHANNEL count
# stops.
#
# ⚠ 302 GAVE THE RULE, and it is the second branch of its own reading rule:
#
#   K = 144, K/32 = 4.5     8 of 64 exact
#   K = 160, K/32 = 5      64 of 64
#   K = 176, K/32 = 5.5     8 of 64 exact
#   K = 192, K/32 = 6      64 of 64
#
# K must be a MULTIPLE OF 32, which is the run count K/32 being whole. Not the
# size of K, and not a power of two.
#
# ⚠ AND I HAVE A CORRECTION TO MAKE. Rounds 300 and 301 recorded K = 192 as
# "writes every channel and computes none, a layout fault, the first non power of
# two K tried". That was wrong and it was not the hardware: the packer's K
# whitelist held 32, 64, 128 and 256, so at 192 it returned without writing a
# byte, and --map lit anyway because it writes raw bytes and never goes through
# the packer. With the guard widened, K = 192 is 64 of 64. A refusal I wrote
# myself was read as a hardware result for two rounds.
#
# ⚠ WHAT IS ACTUALLY LEFT IS K = 256, and it is a COUNT fault, not a layout one.
# K/32 is 8 there, whole, so the layout should hold. What fails is the channel
# count: N = 64 writes 40 and N = 32 writes 24, which is N/2 + 8, the value from
# before 0x3020 was fixed. K = 192 writes all 64. So the count stops somewhere
# between 192 and 256.
#
# THE READING RULE, fixed before the run.
#
#   ⚠ ENTRIES 3 TO 5 ARE THE ROUND: K = 224, and K = 256 at three N.
#
#   K = 224 is K/32 = 7, whole, and between the last K whose count is right and
#   the first whose is not.
#
#     224 writes all 64      the count stops at 256 exactly and the usable range
#                            is 32 to 224 in steps of 32
#     224 writes 40          it stops between 192 and 224, and N/2 + 8 is what
#                            it falls back to in both
#     224 writes something else
#                            write it down. Two points on the fallback are worth
#                            more than one.
#
#   ⚠ K = 256 AT N = 16 IS THE SHARP ONE. If the fallback is N/2 + 8 then at
#   N = 16 that is 16, the whole thing, so N = 16 should be EXACT at K = 256
#   even though N = 32 and N = 64 are not. A fallback that cannot be seen at
#   small N is a very different thing from a layout that breaks.
#
#   ENTRY 2 is the regression: K of 32, 64, 128, 160 and 192.
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
MM=/opt/charsiu/charsiu_matmul
CH=/opt/charsiu/charsiu_int4
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

c() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $*"; return 0; }
	before=$(nbad)
	sleep 1
	env $1 $2 $3 $4 $5 $6 $7 $8 $9 > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This arm is VOID."; health; }
	return 0
}

M4="CHARSIU_W4=1 CHARSIU_W4_HALFK=1"

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	if [ -w /sys/module/rocket/parameters/reset_autosuspend ]; then
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend
		log "reset_autosuspend = $(cat /sys/module/rocket/parameters/reset_autosuspend)"
	else
		log "!! reset_autosuspend NOT WRITABLE. A timeout will kill the round."
	fi

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "##### the regression. every K that is a multiple of 32 up to 192.  #####"
	for KK in 32 64 128 160 192
	do
		log ""
		log "===== K = $KK  N = 64"
		c "$M4" X=1 $MM 1 $KK 64
	done
	log ""
	log "===== and K = 64 at N = 160, the widest N that works               ====="
	c "$M4" X=1 $MM 1 64 160

	log ""
	log "##### THE ROUND. K = 224, and K = 256 at three N.                  #####"
	log ""
	log "===== 3) K = 224  N = 64.  K/32 = 7, whole.                        ====="
	c "$M4" X=1 $MM 1 224 64
	log ""
	log "===== 4) K = 224  N = 32                                           ====="
	c "$M4" X=1 $MM 1 224 32
	log ""
	log "===== 5) K = 256 at N = 16, 32, 64.  N/2+8 is 16, 24, 40.          ====="
	log "=====    N = 16 should be EXACT if the fallback is all it is.      ====="
	c "$M4" X=1 $MM 1 256 16
	c "$M4" X=1 $MM 1 256 32
	c "$M4" X=1 $MM 1 256 64

	log ""
	log "===== 6) and K = 192 at N = 16 and 160, the last K that is whole   ====="
	c "$M4" X=1 $MM 1 192 16
	c "$M4" X=1 $MM 1 192 160

	log ""
	log "===== the control that must FAIL, and int8 at K = 224              ====="
	c "CHARSIU_W4=1" X=1 $MM 1 192 64
	c X=1 X=1 $MM 1 224 64

	log ""
	log "===== the anchor again                                             ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== read wrote at K = 224 first, then N = 16 at K = 256.         ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
