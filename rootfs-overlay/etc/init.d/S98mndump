# ---------------------------------------------------------------------------
# 2026-08-10 round 53. Lock in round 52: the vendor's layout is now the DEFAULT.
#
# Round 52 measured it. The fp16 per-channel weight scale table, with the second
# operand moved past it and kept at 0x1004, gives 128/128 on conv2d-cal, cal_k3
# and cal_k1, the same as the arrangement it replaces, and the same layout with
# the vendor's 0x0E0E gives 0/128 exactly as round 49 predicted.
#
# So mesa now writes, by default:
#
#     0x5020 -> [A/B/C table][oc x fp16 weight scale]
#     0x5024 -> the operand, four bytes
#
# instead of a lone constant sitting where the scale table belongs. Every part
# of that is derived from the model except the four-byte operand.
#
# ROCKET_SCALE_OFF restores the old arrangement, which is the control here: it
# has to still pass, or the comparison in round 52 was not what it looked like.
#
# DECISION RULE, written before the run:
#   1, 2, 3 all 128/128        the new default is a clean replacement and the
#                              old path can eventually go
#   any of them regresses      the default flip is wrong, revert it
#   ROCKET_SCALE_OFF differs
#     from the new default      the two paths are not equivalent on that model,
#                              which is worth knowing per shape
#   depthwise unchanged        expected; it does not read this chain
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
p() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== 1..4) THE NEW DEFAULT, no knobs at all ====="
	p conv2d-cal.tflite ""
	p cal_k3.tflite ""
	p cal_k1.tflite ""
	p cal_s1.tflite ""

	log ""
	log "===== 5..6) more shapes on the new default ====="
	p cal_oc16.tflite ""
	p mn_pw2.tflite ""

	log ""
	log "===== 7..8) the OLD arrangement, which must still pass ====="
	p conv2d-cal.tflite ROCKET_SCALE_OFF=1
	p cal_k3.tflite ROCKET_SCALE_OFF=1

	log ""
	log "===== 9..10) depthwise, expected unchanged ====="
	p dwconv.tflite ""
	p mn_dw1.tflite ""

	log ""
	log "===== 11) whole model, for the record ====="
	sleep 2
	env TEFLON_LIB=/usr/lib/libteflon.so \
		python3 "$NPU_DIR/test_model.py" "$NPU_DIR/conv2d-cal.tflite" 2 > "$C" 2>&1

	log ""
	log "===== Every shape that worked before must still work, with the     ====="
	log "===== scale table derived instead of a constant standing in for it.====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
