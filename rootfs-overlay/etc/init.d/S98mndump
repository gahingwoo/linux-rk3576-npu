# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-21 round 299. K = 128's addresses were right and its group COUNT was
# another K = 64 coincidence.
#
# ⚠ THE BLOCK STRIDE SCALES. --map at K = 128, N = 64 gave group bases
# 0, 128, 1024, 1152, 2048, 2176, 3072, 3136, which is 8*K exactly as predicted,
# and int8 at K = 128 is 64 of 64 byte exact so the job setup is fine there.
#
# ⚠ AND THE MATMUL WAS 0 of 64 ANYWAY, because of the OTHER half of the layout.
# Channel 0 at K = 128 is fed by FOUR eight byte runs, at 0, 256, 512 and 768,
# where K = 64 has two at 0 and 256. The packer wrote two, at an offset of
# half * 4 * K.
#
# 4*K is 256 exactly when K is 64. That is the same trap as 8*K against wbytes/4
# in round 284: an expression fitted at the one K everything had been measured
# at, agreeing with the data for exactly that reason. The spacing is a CONSTANT
# 256 at both K and it is the COUNT that scales, K/32, which is 1, 2 and 4 at K
# of 32, 64 and 128 and matches the K/2 k a channel already known.
#
#   K= 32  channel 0 <- 0                       measured
#   K= 64  channel 0 <- 0, 256                  measured
#   K=128  channel 0 <- 0, 256, 512, 768        measured
#   K=256  channel 0 <- 0, 256, ... , 1792      PREDICTED
#
# ⚠ AND K = 256's BASES DID NOT MATCH. The sweep was capped at 2304 bytes of an
# 8192 byte buffer, so it is truncated and its group leaders cannot be trusted;
# it is re-swept in full here rather than argued about.
#
# THE READING RULE, fixed before the run.
#
#   ⚠ ENTRY 3 IS THE ROUND. K = 128 at N = 64, 32 and 24. Its addresses and its
#   group count are both measured now, so nothing about it is a prediction.
#
#     exact          the layout scales in K, and what is left before an LLM
#                    shape is only how far
#     not exact      the k the four runs carry is not 16*(n&1) + 32*half + j,
#                    and that expression was also only ever checked at two runs
#
#   ENTRY 4 IS THE PREDICTION. K = 256, eight runs a channel. If K = 128 is
#   exact and 256 is not, the count is not K/32 above some bound.
#
#   ENTRY 5 sweeps K = 256's map in FULL, so a miss in entry 4 is readable in
#   the same boot. That is what has saved three rounds already.
#
#   ENTRY 2 is K = 64 and K = 32, the eleven geometry path, which must not move.
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
MM=/opt/charsiu/charsiu_matmul
CH=/opt/charsiu/charsiu_int4
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

c() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $*"; return 0; }
	before=$(nbad)
	sleep 1
	env $1 $2 $3 $4 $5 $6 $7 $8 $9 > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This arm is VOID."; health; }
	return 0
}

M4="CHARSIU_W4=1 CHARSIU_W4_HALFK=1"

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	if [ -w /sys/module/rocket/parameters/reset_autosuspend ]; then
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend
		log "reset_autosuspend = $(cat /sys/module/rocket/parameters/reset_autosuspend)"
	else
		log "!! reset_autosuspend NOT WRITABLE. A timeout will kill the round."
	fi

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== 2) K = 64 and K = 32. The eleven geometry path.              ====="
	c "$M4" X=1 $MM 1 64 16
	c "$M4" X=1 $MM 1 64 64
	c "$M4" X=1 $MM 1 64 88
	c "$M4" X=1 $MM 1 32 64

	log ""
	log "##### THE ROUND. K = 128, whose count and addresses are measured.  #####"
	log ""
	log "===== 3) M = 1  K = 128  N = 64, 32, 24                            ====="
	c "$M4" X=1 $MM 1 128 64
	c "$M4" X=1 $MM 1 128 32
	c "$M4" X=1 $MM 1 128 24

	log ""
	log "##### THE PREDICTION. K = 256, eight runs a channel.               #####"
	log ""
	log "===== 4) M = 1  K = 256  N = 64 and N = 32                         ====="
	c "$M4" X=1 $MM 1 256 64
	c "$M4" X=1 $MM 1 256 32

	log ""
	log "===== 5) --map K = 256 N = 64 in FULL, so a miss is readable here  ====="
	c X=1 X=1 $CH 1 256 64 --map 8

	log ""
	log "===== the control that must FAIL, and int8 at K = 128 and 256      ====="
	c "CHARSIU_W4=1" X=1 $MM 1 128 64
	c X=1 X=1 $MM 1 128 64
	c X=1 X=1 $MM 1 256 64

	log ""
	log "===== the anchor again                                             ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== entry 3 first. K = 128 has no prediction left in it.         ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
