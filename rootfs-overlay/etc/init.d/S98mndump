# ---------------------------------------------------------------------------
# 2026-08-13 round 131. Which input channel actually arrives.
#
# Round 130 excluded the last register. 0x1030's weight bytes per kernel says
# double what the pointwise buffer holds, and halving it moves nothing: 64
# input channels stays at 25 of 64 and maxdiff 92, 128 output stays at 41 of
# 128 and maxdiff 199, and 32 channels stays correct. With the nine registers
# from round 129's diff all scaling correctly and the weight buffer now
# matching the vendor's own compiled layout, what is left is the INPUT.
#
# So decode it. pwimp32x32w40 and pwimp64x64w40 are 1x1 convolutions with one
# live input channel per output channel, everything else at the weight zero
# point, and a zero bias. Output channel k should then be input channel k and
# nothing else, so the surface says directly which input channel arrived.
#
# The 32 channel one is the control: it is the shape that works, so it must
# decode cleanly, and if it does not the construction is wrong and the 64
# channel one says nothing.
#
# DECISION RULE, written before the run:
#   32 decodes as k, 64 decodes as a permutation
#             the input surfaces are being read in the wrong order past the
#             first two, and the permutation names the order
#   64 decodes as k for the first 32 and rubbish above
#             only the surfaces past the first are wrong, which points at the
#             surface stride rather than the order
#   both decode cleanly
#             the input arrives correctly and the fault is in the accumulation
#             across surfaces, not in what is fetched
#
# perch.py reports per output channel, and for these models the reference is
# the CPU running the same impulse, so a channel that matches means the right
# input channel arrived AND was scaled right. The interesting output is the
# WRONG channel list, because for an impulse that list is the permutation.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
p() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== 1) CONTROL: the impulse at 32 channels, which must decode ====="
	p pwimp32x32w40.tflite ""

	log ""
	log "===== 2) THE TEST: the same impulse at 64 ====="
	p pwimp64x64w40.tflite ""

	log ""
	log "===== 3) and with the flat weight layout, for comparison ====="
	p pwimp64x64w40.tflite "ROCKET_PW_FLAT=1"

	log ""
	log "===== 4..5) the real shapes, for the record ====="
	p pw32x64w56.tflite ""
	p pw64x64w56.tflite ""

	log ""
	log "===== 6..8) REGRESSION ====="
	p mn_L03.tflite ""
	p conv2d-cal.tflite ""
	p mn_conv0.tflite ""

	log ""
	log "===== Read the WRONG channel list in 2. For an impulse that list   ====="
	log "===== is the permutation.                                          ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
