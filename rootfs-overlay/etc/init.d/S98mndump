#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-24 round 371. SPENDING THE SPARE BANDWIDTH.
#
# 🏁 ROUND 370: 12.30 tok/s exact, 13.13 with both opt-ins, from 11.62.
#
#   everything on              12.30 tok/s  80.9 ms  attn 6.63  sum 3.47
#   + FAST_ATTN                12.71        78.4     attn 4.53
#   CONTROL, vector paths off  10.55        94.5     attn 8.14  sum 8.64
#   + FAST_ATTN + FAST_SILU    13.13        75.8     silu 1.93
#
# All four sentences identical -- including both opt-in arms that were
# predicted to differ. **All four predictions were right**, after round 368's
# three of four wrong.
#
# 🔑 AND THE BANDWIDTH QUESTION HAS A NUMBER
#
#   CPU read alone   1 thread 7.13   2 threads 6.65   4 threads 6.32 GB/s
#                    ^ MORE THREADS IS WORSE. One already saturates it.
#   NPU alone        10.46 GB/s, 11.68 tok/s
#   NPU + 4 readers   9.84 GB/s, 10.32 tok/s;  the readers got 5.62
#   AGGREGATE        15.46 against 10.46 alone  ->  about 5 GB/s spare
#
# So the practical ceiling is 15.5, not the 21.9 the bus suggests, and taking
# the spare cost the decode 11.6% end to end. **This round is that experiment
# with the reader doing something useful instead of nothing.**
#
# ---------------------------------------------------------------------------
# WHAT CHANGED
# ---------------------------------------------------------------------------
#
# CHARSIU_NPU_CPU_FRAC gives the CPU that fraction of every projection's output
# channels. It costs NO scheduling: the submit is already asynchronous, so the
# CPU's rows are computed in the window the calling thread was going to spend
# BLOCKED in prep_bo, on the calling thread, with no fan out and no extra
# ioctl. Round 370 is also why there is no fan out -- one thread already
# saturates the controller, so a second would buy nothing and cost a barrier.
#
#   * rows are rounded DOWN to a multiple of 16, the feature atom the int4
#     weight layout blocks by, and the hardware keeps the rest.
#   * the CPU's rows get their own NIBBLE PACKED copy. t->q keeps one whole
#     BYTE per int4 weight, so reading them out of it would cost twice the
#     bytes the hardware pays for the same weights -- and bandwidth is the
#     entire point. It is f * 620 MB, so 186 MB at f = 0.30.
#   * the activation is rounded through fp16 first, so both halves of the
#     split see the same numbers the hardware sees.
#   * only where the sum already lands in the caller's buffer, which is
#     grouped int4 with the vector paths on.
#
# The kernel was checked on the host against a plain double reference at seven
# shapes: **worst absolute miss 3.3e-07 of the vector's own RMS**, about one
# float last place. Two bugs died in that check and neither would have shown up
# on this board: a vector path that assumed a group starts on an EVEN index
# (2.26 relative at k = 34, groups of 17) and an accumulator that was assigned
# where it should have been added to, which silently dropped the scalar step.
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# ⚠ THE SENTENCE IS EXPECTED TO CHANGE, and for once that is not a caveat but
# the definition: rows moved to the CPU are summed in a different order by a
# different engine. What must hold is that it stays coherent English on the
# topic, and that arms 5 and 6 -- which do not use the split at all -- are
# still exact. **A sentence that turns to salad means the split is wrong, not
# imprecise.**
#
# THEN tok/s AGAINST f. Arm 1 is f = 0 and must reproduce 12.30.
#   * a peak that then falls = the balance point, and the peak is the answer
#   * a monotonic fall from f = 0 = the CPU cannot convert the spare bandwidth
#     into tokens, and the whole heterogeneous idea is finished for decode.
#     Say that plainly and stop, rather than reaching for the GPU next.
#
# ⚠ THEN THE NEW LINE, "the CPU's own share ... inside the fence window". That
# time is FREE only while it is smaller than the fence. If it approaches or
# passes the fence, the CPU has become the critical path and the fence number
# has stopped meaning what it says -- check that before reading anything else
# into a slowdown.
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT
# ---------------------------------------------------------------------------
#
# The arithmetic says a CPU doing useful int4 at 4 GB/s balances near f = 0.29
# and would take the fence from 59 to 45 ms, which is 15 tok/s. I do not
# believe it: round 370 measured a dummy reader costing the decode 11.6% while
# it took 5.62 GB/s, and this reader has to unpack nibbles and scale as well.
# **I expect a peak between f = 0.15 and 0.25 worth 5 to 10%, and I would not
# be surprised by a monotonic loss.**
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
VD=/opt/charsiu/charsiu_vendor
V=/opt/charsiu/vendor
RGC=$V/vendor-int4-k2048-n1024.regcmd
WT=$V/vendor-wt-1M.bin
IN=$V/vendor-in.bin
RUN=/opt/charsiu/charsiu_run
M8=/opt/charsiu/models/Llama-3.2-1B-Instruct-Q8_0.gguf
PROMPT="The capital of France is"
LIMIT=420
# 32 tokens does not reach the answer to "17 times 24, show your working"
NGEN=64
CE=CHARSIU_COEF_ELEMS=65536
HEAD=CHARSIU_NPU_MAXN=131072
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block did not come back this time."
		ABORT=1
	fi
}

capped() {
	lim="$1"; shift
	"$@" &
	pid=$!
	i=0
	while [ "$i" -lt "$lim" ]; do
		kill -0 "$pid" 2>/dev/null || { wait "$pid"; return $?; }
		sleep 1
		i=$((i + 1))
	done
	kill -9 "$pid" 2>/dev/null
	wait "$pid" 2>/dev/null
	return 124
}
rung() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $1"; return 0; }
	lbl="$1"; shift
	before=$(nbad)
	log ""
	log "  -- $lbl"
	sleep 1
	capped "$LIMIT" env "$@" "$RUN" "$M8" -p "$PROMPT" -n "${NGEN:-32}" \
		--ignore-eos -q -c 512 -t 4 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the rung exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This rung is VOID."; health; }
	return 0
}
# arm: <label> <regcmd-or-dash> <byte> <high> [extra env, one assignment]
#
# ⚠ THE ENV GOES IN AS AN ARGUMENT, not as a "VAR=x arm ..." prefix. Whether an
# assignment before a FUNCTION call survives the call is unspecified -- dash
# drops it, other shells keep it -- and the arm whose whole job is to time out
# WITHOUT the trailer runs right after the one that has it. Not a question worth
# leaving to the shell.
arm() {
	before=$(nbad)
	log ""
	log "  ---- $1"
	sleep 1
	env ${5:-IGNORED=1} $VD "$2" "$WT" "$IN" "$3" "$4" 4096 > /tmp/vd.txt 2>&1
	cat /tmp/vd.txt > "$C"
	after=$(nbad)
	if [ "$after" != "$before" ]; then
		log "  !! POISONED: $((after - before)) new fault or timeout lines"
		health
		# ⚠ NOT a round abort. Round 342 threw away every arm after the
		# first poisoning and then measured the block healthy at the
		# end. The block recovers; give it a moment and carry on.
		ABORT=0
		sleep 2
	fi
}

# two concurrent probes, so the pair can be repeated without copy and paste
pair() {
	before=$(nbad)
	log ""
	log "  ---- $1"
	env CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_TIME=60 CHARSIU_OUT_KB=64 $2 $VD - "$WT" "$IN" 0 0 4096 > /tmp/vdA.txt 2>&1 &
	pidA=$!
	env CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_TIME=60 CHARSIU_OUT_KB=64 $3 $VD - "$WT" "$IN" 0 0 4096 > /tmp/vdB.txt 2>&1 &
	pidB=$!
	wait "$pidA"
	wait "$pidB"
	log "    A:"
	grep -E "M = |TIME:|baseline:|VERIFY:|CONTROL repeat|VOID|REREAD" /tmp/vdA.txt > "$C"
	log "    B:"
	grep -E "M = |TIME:|baseline:|VERIFY:|CONTROL repeat|VOID|REREAD" /tmp/vdB.txt > "$C"
	after=$(nbad)
	[ "$after" != "$before" ] && log "  !! POISONED: $((after - before)) new lines"
	return 0
}

BW=/opt/charsiu/charsiu_membw
DEC="CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 CHARSIU_NPU_W4V=1 CHARSIU_NPU_KMAX=1024 CHARSIU_NPU_W4_GROUP=1024"

# decode and a memory reader at the same time, both numbers kept
squeeze() {
	log ""
	log "  ---- $1"
	sleep 1
	env $DEC "$CE" "$HEAD" "$RUN" "$M8" -p "$PROMPT" -n 128 --ignore-eos \
		-q -c 512 -t 4 > /tmp/dec.txt 2>&1 &
	dpid=$!
	# past staging and into generation before the reader starts
	sleep "$2"
	if [ -n "$3" ]; then
		env CHARSIU_THREADS=4 CHARSIU_SECONDS="$3" $BW > /tmp/bw.txt 2>&1
	fi
	wait "$dpid"
	grep -E "tensors staged|gen 128|GB/s of weights|of that," /tmp/dec.txt > "$C"
	[ -n "$3" ] && cat /tmp/bw.txt > "$C"
	return 0
}

start() {
	log ""
	log "###############################################################"
	log "##### round 371: spending the spare bandwidth              #####"
	log "###############################################################"
	log "  the CPU takes part of every projection, in the window it"
	log "  was going to spend blocked in prep_bo anyway."

	B="CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 CHARSIU_NPU_W4V=1 CHARSIU_NPU_KMAX=1024 CHARSIU_NPU_W4_GROUP=1024 CHARSIU_STAGES=1"

	log ""
	log "===== 1) f = 0. THE CONTROL. must reproduce 12.30 tok/s        ====="
	rung "int4 g1024, CPU_FRAC=0" $B "$CE" "$HEAD"

	log ""
	log "===== 2) f = 0.10                                              ====="
	rung "int4 g1024, CPU_FRAC=0.10" $B CHARSIU_NPU_CPU_FRAC=0.10 "$CE" "$HEAD"

	log ""
	log "===== 3) f = 0.20                                              ====="
	rung "int4 g1024, CPU_FRAC=0.20" $B CHARSIU_NPU_CPU_FRAC=0.20 "$CE" "$HEAD"

	log ""
	log "===== 4) f = 0.30                                              ====="
	log "  read the CPU-share line: it is free only while it is"
	log "  smaller than the fence."
	rung "int4 g1024, CPU_FRAC=0.30" $B CHARSIU_NPU_CPU_FRAC=0.30 "$CE" "$HEAD"

	log ""
	log "===== 5) the probe, still exact (the split is not in it)       ====="
	arm "solo verify" "-" 0 0 "CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_VERIFY=1 CHARSIU_OUT_KB=64"

	log ""
	log "===== 6) the anchor: int8 conv must still be exact            ====="
	health

	log ""
	log "===== read the CONTROL lines first. VOID means the arm died. ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
