# ---------------------------------------------------------------------------
# 2026-08-11 round 88. How big is what is left of conv0, and where?
#
# Round 87 separated the two things conv0 has that the exact impulse does not:
#
#   fc_imp    1 tap, no bias      32/32, every one COMPUTED
#   fc_allw   27 taps, no bias     0/32, but a = 1.0003 with min AND max both
#                                  1.0003 across 32 channels, b -0.04,
#                                  correlation 1.0000
#   fc_impb   1 tap, real bias    26/32 with 25 COMPUTED
#   mn_conv0  both                 9/32 with 0 COMPUTED, a 0.9991, spread
#                                  0.9486 to 1.0009, correlation 0.9994
#
# So the bias path works, 25 channels of fc_impb compute exactly. And fc_allw
# fails every channel while its affine map is PERFECT: a identical to four
# decimals across all 32 and correlation 1.0000. That is not a wrong
# computation. It is a small residual, or a difference in where the two
# saturate, and 0.0003 of a 255 range is 0.08 of a count, which cannot fail a
# maxdiff of 1 on its own.
#
# A maxdiff cannot tell those apart. A surface uniformly two counts out and a
# surface exact apart from a handful of wild pixels both score the same and
# need completely different next steps, so perch.py now prints the residual
# distribution and how much of it sits at a rail.
#
# Nothing in the driver changed this round.
#
# DECISION RULE, written before the run:
#   nearly all pixels within 1 and    the arithmetic is right and the failure
#     the rest at a rail              is saturation; the accumulator overflows
#                                     before the requant, which the generic
#                                     path has ROCKET_CVT_DOWN for
#   a broad spread with few at a      the multiplier is quantised too coarsely,
#     rail                            and the scale field is 15 bits
#   bimodal, most exact and a few     a per-channel term is wrong for those
#     channels far out                channels only
#   fc_imp regresses                  that comes first
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
p() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== 1..4) the ladder, with the residual distribution ====="
	p fc_imp.tflite ""
	p fc_allw.tflite ""
	p fc_impb.tflite ""
	p mn_conv0.tflite ""

	log ""
	log "===== 5..6) if it is overflow, scaling the multiplier down helps ====="
	p fc_allw.tflite ROCKET_CVT_DOWN=2
	p mn_conv0.tflite ROCKET_CVT_DOWN=2

	log ""
	log "===== 7) the chain ====="
	p mn_conv0dw1.tflite ""

	log ""
	log "===== 8..10) REGRESSION ====="
	p conv2d-cal.tflite ""
	p mn_dw1.tflite ""
	p mn_dw25.tflite ""

	log ""
	log "===== Read the residual line on test 2. Almost all within 1 with  ====="
	log "===== the rest at a rail is saturation, not arithmetic.           ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
