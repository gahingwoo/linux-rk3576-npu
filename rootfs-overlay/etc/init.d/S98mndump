# ---------------------------------------------------------------------------
# 2026-08-10 round 51. The one combination the capture says is right and that
# has never been run.
#
# A is now confirmed exactly. Using the EXACT per-channel scale from the
# captured fp16 table rather than an approximation, A / swq is 127.5 to 133.7
# and the fit is A = 127.993*swq with a maximum error of 572 over a range of
# +-196872. That is mesa's own formula, A = bias_q - (in_zp - 0x80)*sw, with
# in_zp = 0, and rknn quantises its input as int8 zp 0 while these tflite models
# are uint8 zp 128. So A agrees, B was closed last round, C is mesa's formula.
#
# What is left is the LAYOUT, and the combination that matters was never run:
#
#   round 47   the WEIGHT SCALE in the table, pointer NOT moved
#   round 49   the REQUANT MULTIPLIER in the table, pointer moved
#   never      the WEIGHT SCALE in the table, pointer moved
#
# The capture says the table holds the weight scale: those entries match the
# scale implied by A at +0.998. Round 49 moved the pointer with the wrong
# content in the table, and round 47 had the right content with the pointer
# still aimed at it. ROCKET_SCALE_TABLE_WT plus ROCKET_SCALE_PTR is the vendor's
# actual arrangement.
#
# DECISION RULE, written before the run:
#   2 is 128/128            the vendor's layout is adoptable and the surface is
#                           derived end to end; the magic word retires
#   2 fails, 3 (multiplier
#     + pointer) also fails  the content is not the issue and the layout move
#                           itself is wrong, so stop moving the pointer
#   depthwise moves on 4     the layout matters there even if the regular
#                           shapes are indifferent
#   1 or 9 not 128/128      the build is wrong, stop
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
p() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== 1) BASELINE: must be 128/128 ====="
	p conv2d-cal.tflite ""

	log ""
	log "===== 2) THE UNTESTED ONE: weight scale in the table, pointer moved ====="
	p conv2d-cal.tflite "ROCKET_SCALE_TABLE=1 ROCKET_SCALE_TABLE_WT=1 ROCKET_SCALE_PTR=1"
	p cal_k3.tflite "ROCKET_SCALE_TABLE=1 ROCKET_SCALE_TABLE_WT=1 ROCKET_SCALE_PTR=1"

	log ""
	log "===== 3) for contrast, the multiplier with the pointer, round 49 ====="
	p conv2d-cal.tflite "ROCKET_SCALE_TABLE=1 ROCKET_SCALE_PTR=1"

	log ""
	log "===== 4) the vendor arrangement on depthwise ====="
	p dwconv.tflite "ROCKET_SCALE_TABLE=1 ROCKET_SCALE_TABLE_WT=1 ROCKET_SCALE_PTR=1"
	p mn_dw1.tflite "ROCKET_SCALE_TABLE=1 ROCKET_SCALE_TABLE_WT=1 ROCKET_SCALE_PTR=1"
	p dwconv.tflite "ROCKET_SCALE_TABLE=1 ROCKET_SCALE_TABLE_WT=1 ROCKET_SCALE_PTR=1 ROCKET_DW_REC48=1"

	log ""
	log "===== 9) CONTROL that can fail: baseline again ====="
	p conv2d-cal.tflite ""

	log ""
	log "===== Read 1 and 9, then 2. This is the vendor's own arrangement:  ====="
	log "===== weight scale in the table, second operand past it.           ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
