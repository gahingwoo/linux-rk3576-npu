#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-20 round 270. Two defects, two units, one field at a time.
#
# THE GATE EARNED ITS PLACE THE ROUND IT WENT IN. Two arms of 269 hung, 0x4038
# and 0x4050 set to their int8 values, and the gate caught both, ran a health
# check, saw the block come back and carried on. 268 lost a whole entry to the
# same thing in silence.
#
# WHAT 269 SETTLED, and most of it is by elimination. The baseline reproduced
# exactly, 40 channels and w0 through w7 with 64 onward dark. Nine arms were
# clean and NOT ONE of them moved either number:
#
#   0x1020 0x1028 0x1030 0x103c 0x1044   five CNA size registers, excluded
#   0x4030 0x4044                        excluded
#
# 0x1020 set to int8's 64 and 0x1030 to int8's 128 left the eight byte run
# exactly where it was, so bytes per kernel is not what bounds the fetch.
#
# ⚠ THE ONE STRUCTURAL RESULT. Setting 0x100c to int8's 0 left "wrote" at 40
# and turned every byte in the sweep dark. So the write extent does not depend
# on the weights being read at all. The two shortfalls are in different units:
#
#   k per channel is 32 and not 64   -> CNA. 0x100c is the only CNA register
#                                       that did anything, and it is CONV_CON1.
#   channels is 8*(N/16+1) not N/8   -> DPU, since no CNA arm touched it.
#
# The names come from mesa's registers.xml, which has both, and 0x100c is spelt
# 0x100C there, which is why a grep for it came back empty the first time.
#
#   CNA 0x100C CONV_CON1   CONV_MODE 0, IN_PRECISION 2, PROC_PRECISION 2,
#                          RESERVED_1 48, GROUP_LINE_OFF 1
#   DPU 0x4050 BS_OW_CFG   the field table round 260 measured
#   DPU 0x4038 DATA_CUBE_NOTCH_ADDR   NOTCH_ADDR_0 0x53, NOTCH_ADDR_1 0
#   DPU 0x4058 WDMA_SIZE_0  CHANNEL_WDMA and SIZE_C_WDMA
#
# ⚠ RESERVED_1 IS 48, IN A FIELD CALLED RESERVED. That is exactly the shape
# round 260 found on 0x4050, where four of five fields were load bearing and
# two of them were in the reserved range. It gets four arms rather than one.
#
# ⚠ 0x4058 IS NOT IN THE FOURTEEN. charsiu writes 0x80000000 on BOTH paths and
# at every N, so CHANNEL_WDMA is 0 and SIZE_C_WDMA is 0 whatever the job asks
# for, and int8 still writes all of its channels. It cannot be the difference.
# It is here anyway because it is the register that NAMES the output channel
# count and it has never been varied, and two arms is cheap.
#
# THE READING RULE, fixed before the run.
#
#   TWO NUMBERS A LINE, independent, same as 269.
#
#     wrote      40 at baseline. 64 would be right.
#     the words  w0 w1 w2 w3 w4 w5 w6 w7 then eight dark at baseline, one group
#                a channel. Two groups a channel reads w0 w0 w1 w1 w2 w2 w3 w3.
#
#   ⚠ A CONV_CON1 ARM THAT GOES ALL DARK IS NOT A FAILURE. 0x100c = 0 did that
#   and it is how we know the register is load bearing. What separates the
#   fields is WHICH of them can be changed without going dark, and of those,
#   whether any changes the run.
#
#   ⚠ THE BASELINE MUST REPRODUCE, entry 3, or every arm below is void.
#
#   No prediction on which field. 269 ran ten arms and nine were null, which is
#   the honest prior here.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
CH=/opt/charsiu/charsiu_int4
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

c() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $*"; return 0; }
	before=$(nbad)
	sleep 1
	env $1 $CH $2 $3 $4 $5 $6 $7 > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This arm is VOID."; health; }
	return 0
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	if [ -w /sys/module/rocket/parameters/reset_autosuspend ]; then
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend
		log "reset_autosuspend = $(cat /sys/module/rocket/parameters/reset_autosuspend)"
	else
		log "!! reset_autosuspend NOT WRITABLE. A timeout will kill the round."
	fi

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== 2) BASELINE int4 N=64. 40 channels, w0..w7, 64+ dark.        ====="
	log ""
	c "X=1" 1 64 64 --map 8 256

	log ""
	log "##### CNA. CONV_CON1 field by field. The k shortfall lives here.   #####"
	for a in \
		"0x100c=0x00600120" \
		"0x100c=0x20000120" \
		"0x100c=0x20200120" \
		"0x100c=0x20400120" \
		"0x100c=0x20c00120" \
		"0x100c=0x20600100" \
		"0x100c=0x20600020" \
		"0x100c=0x20600121"
	do
		log ""
		log "===== ARM $a"
		c "CHARSIU_OVERRIDE=$a" 1 64 64 --map 8 128
	done

	log ""
	log "##### DPU. The channel shortfall lives here.                       #####"
	for a in \
		"0x4050=0x80023333" \
		"0x4050=0x00011333" \
		"0x4050=0x00023133" \
		"0x4050=0x00023313" \
		"0x4050=0x00023331" \
		"0x4038=0x00000080" \
		"0x4038=0x00120053" \
		"0x4058=0x8000003f" \
		"0x4058=0x803f0000"
	do
		log ""
		log "===== ARM $a"
		c "CHARSIU_OVERRIDE=$a" 1 64 64 --map 8 128
	done

	log ""
	log "===== the anchor again                                             ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== which CONV_CON1 fields survive, and does any DPU arm move 40 ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
