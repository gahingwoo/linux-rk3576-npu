#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-19 round 255. The one count is a rounding rule, and this measures it.
#
# WHAT 254 SETTLED, and the rule it was read by was fixed in advance.
#
#   EVERY isolated operator came back at maxdiff 1 with 100.0 percent of its
#   misses being the hardware reading LOW. mn_conv0 32 of 32, mn_dw1 32 of 32,
#   mn_pw2 64 of 64 at three input seeds, mn_pw24 1024 of 1024, mn_dw25 1024 of
#   1024. There is no per layer bug.
#
#   The graph size control passed exactly. mn_conv0dw1 at 2 operators and
#   mn_L01 at 31 agreed in every column, 28 of 32 and 89.31 percent exact and
#   maxdiff 3 and 99.3 percent low. So the variable is depth, not graph size,
#   and the chain degradation is propagation of that one count.
#
# WHAT IT POINTS AT. 100.0 percent one sided is a systematic rounding
# difference, not noise. The hardware computes floor((acc + A) * mult) while
# tflite's requant rounds a half away from zero. A is added before the
# multiply, so adding 0.5/mult to it turns that floor into a round. It is the
# same mechanism as the lift, in the same place, and the offset deliberately
# does not take it back.
#
# ⚠ WHY THIS IS A SWEEP AND NOT 0.5. The sign is not uniform. conv2d-cal's
# misses are all the other way, the hardware reading HIGH, and rkt_out_cvt adds
# 1 to the emitted scale, which biases the multiplier up. Two opposed sources
# of one count exist and their balance depends on the model, so the amount is
# measured. ROCKET_ROUND defaults to 0 and reproduces every round through 254.
#
# THE READING RULE, fixed before the run.
#
#   The isolated layers decide it, because their answer is unambiguous. Read
#   mn_pw2 and mn_dw1 first, at maxd and npu LOW.
#
#     maxd 1 -> 0 anywhere        that value is the rounding and it is real
#     maxd stays 1, LOW 100 -> 0  overshoot, the true value is smaller
#     nothing moves at any value  the term is not reaching the hardware and
#                                 the round is void, not negative
#
#   ⚠ conv2d-cal is the counter case and must be read the OTHER way. Its misses
#   are already HIGH, so a positive round should make it WORSE. If it improves
#   too then the story is wrong and something else is going on.
#
#   ⚠ A chain improving is not evidence on its own. If the isolated layers do
#   not move, a chain that moves is noise.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	after=$(nbad)
	if [ "$after" != "$before" ]; then
		log "  !! POISON in this entry. The block faulted. This result is VOID."
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" \
			> /tmp/hc.txt 2>&1
		if grep -q "128/128 channels match" /tmp/hc.txt; then
			log "  !! health OK, the block recovered, continuing"
		else
			log "  !! health FAILED, the block is gone. ABORTING the round."
			ABORT=1
		fi
	fi
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	if [ -w /sys/module/rocket/parameters/reset_autosuspend ]; then
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend
		log "reset_autosuspend = $(cat /sys/module/rocket/parameters/reset_autosuspend)"
	else
		log "!! reset_autosuspend NOT WRITABLE. A timeout will kill the round."
	fi

	log ""
	log "===== 1) the anchor, round off, must reproduce 254                 ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== 2-9) THE SWEEP on the two isolated layers whose misses are   ====="
	log "=====      100 percent low. maxd 1 going to 0 is the answer.       ====="
	for r in 0.25 0.5 0.75 1.0; do
		w mn_pw2.tflite "ROCKET_ROUND=$r"
		w mn_dw1.tflite "ROCKET_ROUND=$r"
	done

	log ""
	log "===== 10-11) the same two with the knob off, so the sweep has a    ====="
	log "=====        baseline in this same boot                            ====="
	w mn_pw2.tflite ""
	w mn_dw1.tflite ""

	log ""
	log "===== 12-15) THE COUNTER CASE. conv2d-cal's misses are already     ====="
	log "=====        HIGH, so a positive round must make it WORSE.         ====="
	w conv2d-cal.tflite "ROCKET_ROUND=0.25"
	w conv2d-cal.tflite "ROCKET_ROUND=0.5"
	w conv2d-cal.tflite "ROCKET_ROUND=-0.25"
	w conv2d-cal.tflite "ROCKET_ROUND=-0.5"

	log ""
	log "===== 16-19) the other isolated layers at the best guess           ====="
	w mn_conv0.tflite "ROCKET_ROUND=0.5"
	w mn_conv0.tflite ""
	w mn_pw24.tflite "ROCKET_ROUND=0.5"
	w mn_dw25.tflite "ROCKET_ROUND=0.5"

	log ""
	log "===== 20-23) and only then the chains, which are not evidence on   ====="
	log "=====        their own                                             ====="
	w mn_L02.tflite "ROCKET_ROUND=0.5"
	w mn_L02.tflite ""
	w mobilenet_v1_1.0_224_quant.tflite "ROCKET_ROUND=0.5"
	w mobilenet_v1_1.0_224_quant.tflite ""

	log ""
	log "===== a final anchor                                               ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== Read 1 and 2, then 3 against 4. The bar is the arm beside it ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
