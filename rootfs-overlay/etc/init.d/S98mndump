#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-21 round 293. The weight layout has an M term and the packer has none.
#
# ⚠ 292 ANSWERED ITS OWN QUESTION: THE BASES MOVE. --map at M = 2, N = 16, on a
# 512 byte buffer where M = 1 lights 32 groups, lights EIGHT:
#
#   264 -> w1   280 -> w3   296 -> w5   312 -> w7
#   328 -> w9   344 -> w11  360 -> w13  376 -> w15
#
# which is channel 2j+1 at byte 264 + 16j. At M = 1 the same shape is channel c
# at byte 8c starting from 0. Nothing about that is a small correction, and the
# packer has no M term at all.
#
# ⚠ AND IT IS NOT "SLOT 2". 292's entry 7 ran M = 2 at N = 24, which is G = 3
# with slots 0, 2 and 3, and BOTH the slot 2 group and the slot 3 group failed:
# mismatches 8 through 23, with only g0 clean. So at M > 1 only slots 0 and 1
# work, which at M = 2, N = 16 is the whole of G = 2 and is why that one shape
# has a clean row 0.
#
# ⚠ THE GRID IS NOT READABLE YET AND THAT IS THE INSTRUMENT'S FAULT. --map
# reports only the FIRST lit word, which was the whole answer for eleven
# geometries because at M = 1 a live nibble lights exactly one. At M > 1 a byte
# can light a word in more than one row and everything after the lowest index
# was dropped. And the probe drives a ramp over all m*k activations, so every
# row contributes and the result is a sum.
#
# Both fixed. All lit words are printed, up to eight, and CHARSIU_MAP_ROW zeroes
# every row but one so the row dimension can be held still.
#
# THE READING RULE, fixed before the run.
#
#   ⚠ ENTRIES 5 AND 6 ARE THE ROUND. --map at M = 2, N = 16, once with row 0
#   alone and once with row 1 alone. N = 16 because M = 1 fills its buffer with
#   32 groups and M = 2 lit 8, so whatever the M term is, it is large here.
#
#     row 0 alone gives the M = 1 map      the layout does not move and 292's
#                                          grid was the ramp summing rows
#     row 0 alone gives a different map    the layout has an M term. Read the
#                                          bases off it; the row 1 grid beside
#                                          it says whether rows interleave in
#                                          the WEIGHTS, which would be new
#     row 0 alone lights nothing           row 0's weights are not fetched at
#                                          M = 2 at all, and every correct row 0
#                                          value so far is an accident
#
#   ENTRY 7 is the same pair at N = 64, where the M = 1 table is the one all
#   eleven geometries were built on.
#
#   ENTRIES 2 TO 4 are the M = 1 regression. The probe changed, not the packer,
#   so nothing should move, and if it does the change broke the instrument.
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
MM=/opt/charsiu/charsiu_matmul
CH=/opt/charsiu/charsiu_int4
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

c() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $*"; return 0; }
	before=$(nbad)
	sleep 1
	env $1 $2 $3 $4 $5 $6 $7 $8 $9 > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This arm is VOID."; health; }
	return 0
}

M4="CHARSIU_W4=1 CHARSIU_W4_HALFK=1"

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	if [ -w /sys/module/rocket/parameters/reset_autosuspend ]; then
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend
		log "reset_autosuspend = $(cat /sys/module/rocket/parameters/reset_autosuspend)"
	else
		log "!! reset_autosuspend NOT WRITABLE. A timeout will kill the round."
	fi

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "##### the M = 1 regression. The probe changed, not the packer.     #####"
	for nn in 16 64
	do
		log ""
		log "===== M = 1  N = $nn"
		c "$M4" X=1 $MM 1 64 $nn
	done
	log ""
	log "===== --map M = 1 N = 16, which must be the table it always was    ====="
	c X=1 X=1 $CH 1 64 16 --map 8

	log ""
	log "##### THE ROUND. one row at a time, all lit words printed.         #####"
	log ""
	log "===== 5) --map  M = 2  N = 16  row 0 only                          ====="
	c CHARSIU_MAP_ROW=0 X=1 $CH 2 64 16 --map 8
	log ""
	log "===== 6) --map  M = 2  N = 16  row 1 only                          ====="
	c CHARSIU_MAP_ROW=1 X=1 $CH 2 64 16 --map 8

	log ""
	log "===== 7) --map  M = 2  N = 64  row 0 only                          ====="
	c CHARSIU_MAP_ROW=0 X=1 $CH 2 64 64 --map 8

	log ""
	log "===== 8) and the matmuls, for the mismatch lists                   ====="
	c "$M4" X=1 $MM 2 64 16
	c "$M4" X=1 $MM 2 64 64

	log ""
	log "===== 9) the control that must FAIL, and int8 at M = 1 and M = 4   ====="
	c "CHARSIU_W4=1" X=1 $MM 1 64 64
	c X=1 X=1 $MM 1 64 64
	c X=1 X=1 $MM 4 64 64

	log ""
	log "===== the anchor again                                             ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== entry 5 against the M = 1 map above it. That is the round.   ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
