# ---------------------------------------------------------------------------
# 2026-08-11 round 78. Which half of round 52 emptied conv0's MAC?
#
# Round 77 settled two things about conv0 and one of them is my own regression.
#
# The MAC is EMPTY. Sweeping the output shift from 22 down to 6, an
# amplification of 2^16, leaves the output bit for bit identical: distinct 1,
# min and max both 126, every channel constant. Changing the scale from 0x5391
# to 0x76be changes nothing either. Only the OFFSET moves it, from 126 at -2 to
# 0 at -128, so the output is exactly 128 plus the offset and the accumulator
# contributes nothing. The requant literals are innocent, and the comment
# beside them stands.
#
# And ROCKET_SCALE_OFF=1 brings the MAC BACK: distinct 60, min 126 max 185, 10
# of 32 channels constant instead of 32. That arrangement is the one this
# driver used before round 52. So round 52 took conv0 from computing something
# wrong to computing nothing, and it was invisible because conv0 was not in the
# regression set. That is my mistake twice over: the change and the gap that
# hid it.
#
# Round 52 did two things at once, which is the mistake this log keeps
# recording, and they were split then for the shapes that pass but never
# retested on conv0:
#
#   the fp16 table      oc entries of the per-channel weight scale, written at
#                       the end of the A/B/C records
#   the second operand  0x5024 moved past that table, with 0x1004 written at
#                       the new target
#
# ROCKET_SCALE_OFF turns off both. This round separates them on conv0, and asks
# whether the operand VALUE matters there, since 0x1004 was fitted on a regular
# conv and conv0 takes a different path through everything else.
#
# DECISION RULE, written before the run:
#   the table alone empties it     conv0 reads the region the fp16 entries now
#                                  occupy, and it needs its own layout
#   the operand alone empties it   the pointer move is what conv0 cannot take
#   a different operand value      the value is fitted, not derived, and conv0
#     revives it                   wants another one
#   nothing but SCALE_OFF works    the two are not separable and conv0 needs
#                                  the whole old arrangement until it is
#                                  understood
#   any other model regresses      that comes first
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
p() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== 1..2) conv0: the two end points ====="
	p mn_conv0.tflite ""
	p mn_conv0.tflite ROCKET_SCALE_OFF=1

	log ""
	log "===== 3..5) the operand VALUE, with everything else as it is ====="
	p mn_conv0.tflite ROCKET_OP2=0x0e0e
	p mn_conv0.tflite ROCKET_OP2=0
	p mn_conv0.tflite ROCKET_OP2=0x3fc4

	log ""
	log "===== 6) the fp16 table holding the requant multiplier instead ====="
	p mn_conv0.tflite ROCKET_SCALE_MUL=1

	log ""
	log "===== 7..8) the old float surface, for the record ====="
	p mn_conv0.tflite ROCKET_FS_FLOATS=1
	p mn_conv0.tflite ROCKET_FS_ZERO=1

	log ""
	log "===== 9..12) REGRESSION: nothing else may move ====="
	p conv2d-cal.tflite ""
	p cal_k3.tflite ""
	p mn_dw1.tflite ""
	p mn_dw25.tflite ""

	log ""
	log "===== Compare 1 and 2 first, then find which single knob between  ====="
	log "===== them reproduces 2. That names the half that emptied conv0.  ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
