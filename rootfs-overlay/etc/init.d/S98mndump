# ---------------------------------------------------------------------------
# 2026-08-23 round 364. BOTH CORES, IN THE DECODE.
#
# ✅✅✅ ROUND 363 CLOSED IT, INCLUDING THE HOLE ROUND 362 LEFT.
#
#   solo, window 0     1024 of 1024, worst 0.00e+00
#   solo, window 1     1024 of 1024, worst 0.00e+00   <- the window is CORRECT,
#                                                        not merely repeatable
#   pair, same window  125 and 13 words differing     <- the fault reproduces
#   pair, split, x3    six processes, EVERY one 0 words differing AND
#                      1024 of 1024 exact
#
# **Two NPU cores, concurrent, repeatable and byte exact, as long as the two
# jobs in flight carry different CBUF windows.** The CBUF is shared and charsiu
# was handing both cores the same one.
#
# ---------------------------------------------------------------------------
# WHAT CHANGED IN THE CODE
# ---------------------------------------------------------------------------
#
# charsiu_npu opens the device TWICE. rocket gives every open DRM file its own
# drm_sched_entity over the list of every core, and an entity runs one job at a
# time, so one file never reaches more than one core however deep the queue.
# Entries alternate between the two files, which puts a group -- q, k, v or
# gate, up, consecutive adds -- on different devices, and each device's streams
# carry its own CBUF window.
#
# charsiu_npu_matvec_group builds ONE JOBLIST PER DEVICE and submits both
# BEFORE waiting on either. Submitting is a queueing ioctl and the fence is
# waited separately, so both cores run at once without a thread anywhere.
#
# The activation is packed into both devices' input buffers, because a group
# shares one input vector but a buffer object belongs to the file that made it.
# A few kilobytes against the megabytes of weights each submit fetches.
#
# CHARSIU_NPU_ONEDEV puts it back to one file, which is the control.
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# ⚠ THE TEXT IS THE FIRST THING TO READ, NOT THE RATE. Splitting a projection
# across two files changes NOTHING arithmetically -- the same weights, the same
# activation, the same registers apart from a CBUF base. **Entry 2 and entry 3
# must produce the SAME SENTENCE, word for word.** If they do not, the split is
# wrong and the rate does not matter.
#
# Then the rate. Round 356 put 89 ms of a 117 ms token inside the fence, so a
# perfect halving would be about 73 ms and 13.7 tok/s. Nothing will be perfect:
# only the grouped projections split, the single ones still run on one device,
# and a group of three splits two against one.
#
#   entry 2 near 11 tok/s or better  -> the second core is in the decode
#   entry 2 near entry 3's 8.5       -> the split is not reaching the hardware,
#                                       and the next question is whether both
#                                       files really landed on both cores
#
# ENTRY 1 is int8 and must still be 6.4 with the standing sentence. ENTRY 3 is
# the one device control and must reproduce 8.5.
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT
# ---------------------------------------------------------------------------
#
# 10 to 12 tok/s. Not 13.7, because the single projections and the output head
# do not split and a group of three cannot divide evenly. My predictions have
# been wrong more often than right lately, so read entry 2 against entry 3 and
# not against this paragraph.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
VD=/opt/charsiu/charsiu_vendor
V=/opt/charsiu/vendor
RGC=$V/vendor-int4-k2048-n1024.regcmd
WT=$V/vendor-wt-1M.bin
IN=$V/vendor-in.bin
RUN=/opt/charsiu/charsiu_run
M8=/opt/charsiu/models/Llama-3.2-1B-Instruct-Q8_0.gguf
PROMPT="The capital of France is"
LIMIT=420
# 32 tokens does not reach the answer to "17 times 24, show your working"
NGEN=64
CE=CHARSIU_COEF_ELEMS=65536
HEAD=CHARSIU_NPU_MAXN=131072
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block did not come back this time."
		ABORT=1
	fi
}

capped() {
	lim="$1"; shift
	"$@" &
	pid=$!
	i=0
	while [ "$i" -lt "$lim" ]; do
		kill -0 "$pid" 2>/dev/null || { wait "$pid"; return $?; }
		sleep 1
		i=$((i + 1))
	done
	kill -9 "$pid" 2>/dev/null
	wait "$pid" 2>/dev/null
	return 124
}
rung() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $1"; return 0; }
	lbl="$1"; shift
	before=$(nbad)
	log ""
	log "  -- $lbl"
	sleep 1
	capped "$LIMIT" env "$@" "$RUN" "$M8" -p "$PROMPT" -n "${NGEN:-32}" \
		--ignore-eos -q -c 512 -t 4 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the rung exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This rung is VOID."; health; }
	return 0
}
# arm: <label> <regcmd-or-dash> <byte> <high> [extra env, one assignment]
#
# ⚠ THE ENV GOES IN AS AN ARGUMENT, not as a "VAR=x arm ..." prefix. Whether an
# assignment before a FUNCTION call survives the call is unspecified -- dash
# drops it, other shells keep it -- and the arm whose whole job is to time out
# WITHOUT the trailer runs right after the one that has it. Not a question worth
# leaving to the shell.
arm() {
	before=$(nbad)
	log ""
	log "  ---- $1"
	sleep 1
	env ${5:-IGNORED=1} $VD "$2" "$WT" "$IN" "$3" "$4" 4096 > /tmp/vd.txt 2>&1
	cat /tmp/vd.txt > "$C"
	after=$(nbad)
	if [ "$after" != "$before" ]; then
		log "  !! POISONED: $((after - before)) new fault or timeout lines"
		health
		# ⚠ NOT a round abort. Round 342 threw away every arm after the
		# first poisoning and then measured the block healthy at the
		# end. The block recovers; give it a moment and carry on.
		ABORT=0
		sleep 2
	fi
}

# two concurrent probes, so the pair can be repeated without copy and paste
pair() {
	before=$(nbad)
	log ""
	log "  ---- $1"
	env CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_TIME=60 CHARSIU_OUT_KB=64 $2 $VD - "$WT" "$IN" 0 0 4096 > /tmp/vdA.txt 2>&1 &
	pidA=$!
	env CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_TIME=60 CHARSIU_OUT_KB=64 $3 $VD - "$WT" "$IN" 0 0 4096 > /tmp/vdB.txt 2>&1 &
	pidB=$!
	wait "$pidA"
	wait "$pidB"
	log "    A:"
	grep -E "M = |TIME:|baseline:|VERIFY:|CONTROL repeat|VOID|REREAD" /tmp/vdA.txt > "$C"
	log "    B:"
	grep -E "M = |TIME:|baseline:|VERIFY:|CONTROL repeat|VOID|REREAD" /tmp/vdB.txt > "$C"
	after=$(nbad)
	[ "$after" != "$before" ] && log "  !! POISONED: $((after - before)) new lines"
	return 0
}

start() {
	log ""
	log "###############################################################"
	log "##### round 364: both cores, in the decode                   #####"
	log "###############################################################"
	log "  int4 is byte exact and 1.42 to 1.78x faster. now decode with it."

	log ""
	log "===== 1) CONTROL: int8 decode. 6.4 tok/s, standing sentence.   ====="
	dmesg 2>/dev/null | grep -i "NPU core" > "$C"
	rung "int8" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 "$CE" "$HEAD"

	log ""
	log "===== 2) int4 g1024 on BOTH cores. read the SENTENCE first.    ====="
	rung "int4 g1024, two devices" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 CHARSIU_NPU_W4V=1 CHARSIU_NPU_KMAX=1024 CHARSIU_NPU_W4_GROUP=1024 "$CE" "$HEAD"

	log ""
	log "===== 3) the same on ONE device. must reproduce 8.5 tok/s AND  ====="
	log "  the SAME sentence as entry 2, word for word."
	rung "int4 g1024, one device" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 CHARSIU_NPU_W4V=1 CHARSIU_NPU_KMAX=1024 CHARSIU_NPU_W4_GROUP=1024 CHARSIU_NPU_ONEDEV=1 "$CE" "$HEAD"

	log ""
	log "===== 4) the probe, still exact under the two device build     ====="
	arm "solo verify" "-" 0 0 "CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_VERIFY=1 CHARSIU_OUT_KB=64"

	log ""
	log "===== 5) the anchor: int8 conv must still be exact            ====="
	health

	log ""
	log "===== read the CONTROL lines first. VOID means the arm died. ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
