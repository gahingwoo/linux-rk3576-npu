#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-22 round 330. THE HALF WIDTH IS NOT A DEFECT, IT IS THE OTHER HALF.
#
# ⚠ ROUND 329 WAS HALF A CHANGE AND THAT IS WHY IT DID NOTHING. It set
# 0x40b8 = 3 and 0x3020 = 2N-1, which is what makes the hardware COMPUTE and
# WRITE 2N words, and left the packing alone -- so those extra words held
# nothing. The registers were never the whole change.
#
# ---------------------------------------------------------------------------
# COUNT WHAT THE MEASURED MAP ACTUALLY DELIVERS
# ---------------------------------------------------------------------------
#
# Round 325 read the address map at every live byte of three geometries, 1376
# points, one form:
#
#     w = 32 * floor(s / K) + (s mod 32),      s = byte / 8
#
# A declared channel is fed by the slots with `s mod 32 == w mod 32` inside its
# own block. That is K/32 slots of 16 nibbles, so **every channel gets exactly
# K/2 nibbles.** And a buffer of N*K/2 bytes holds N*K nibbles, so the other
# half of it feeds words N..2N-1.
#
# **Those words are not spare and they are not a defect. They are real computed
# outputs of the same buffer.** Put the second half of each channel's k in them
# and add:
#
#     out[c] + out[c+N] = the full dot product
#
# with the buffer still exactly N*K/2 bytes and every nibble in it used. That is
# int4 at full width with no register left to find -- the arithmetic closes.
#
# ---------------------------------------------------------------------------
# AND THE VENDOR'S FILE, WHICH IS WHY I TRUST THE COUNT
# ---------------------------------------------------------------------------
#
# The .rkllm was taken apart offline this round. It is the same model, and the
# method was validated on a POSITIVE CONTROL before anything was concluded:
# its fp16 region is the token embedding, 2048 halfs a row, and the row at
# 0x1afeda0 matches our own token_embd row 4999 at **r = +1.0000**.
#
# Its int4 region starts at 0x21000000, and the nibble histogram is symmetric,
# peaked at 0, 18.8% at each end and 0.1% in the middle: **signed two's
# complement nibbles, 3.13 bits of entropy.** Real weights, not compressed.
#
# ⚠ And a full value correlation of one channel's 2048 weights against every
# byte and nibble alignment of that whole region peaks at **0.13, which is the
# noise floor**. So a channel's weights are NOT contiguous anywhere in the file:
# **the vendor stores them pre-shuffled into the hardware's layout**, which is
# the layout the count above describes.
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# 1) ENTRY 2a IS THE CONTROL, today's packing: 64 of 64 at N=64 and the
#    128 of 256 that twenty rounds have printed.
# 2) ENTRY 2b IS THE ROUND. Same shapes, CHARSIU_W4_PHANTOM packing, 0x40b8 = 3
#    and 0x3020 = 2N-1. **256 of 256 exact is int4 at full width.**
# 3) ⚠ THE HALFK ZEROING IS OFF in 2b and must be: the phantom packing uses
#    every k, so the reference is the full dot product. If 2b needs halfk to
#    score, it has not done what it claims.
# 4) ENTRY 3 SWEEPS THE TWO THINGS THE PACKER GUESSES, because the map fixes
#    which SLOTS a word owns but not which k goes in them: the half split
#    (first half of k vs the even k) and the intra-slot order.
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT
# ---------------------------------------------------------------------------
#
# ⚠ I have been wrong about int4 five times. What is different here is that
# nothing is being guessed about the hardware: the map was measured at 1376
# points, the count that follows from it is arithmetic, and the vendor's file
# independently says the weights are stored pre-shuffled rather than contiguous.
# The two things this round can still get wrong are which HALF of k goes in the
# phantom word and the order inside a slot, and entry 3 sweeps both.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
RUN=/opt/charsiu/charsiu_run
BE=/opt/charsiu/charsiu_bench
MM=/opt/charsiu/charsiu_matmul
I4=/opt/charsiu/charsiu_int4
M4="CHARSIU_W4=1 CHARSIU_W4_HALFK=1"
M8=/opt/charsiu/models/Llama-3.2-1B-Instruct-Q8_0.gguf
PROMPT="The capital of France is"
LIMIT=420
ARMCAP=240
CE=CHARSIU_COEF_ELEMS=65536
HEAD=CHARSIU_NPU_MAXN=131072
B8="CHARSIU_OVERRIDE=0x40b8=3"
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

capped() {
	lim="$1"; shift
	"$@" &
	pid=$!
	i=0
	while [ "$i" -lt "$lim" ]; do
		kill -0 "$pid" 2>/dev/null || { wait "$pid"; return $?; }
		sleep 1
		i=$((i + 1))
	done
	kill -9 "$pid" 2>/dev/null
	wait "$pid" 2>/dev/null
	return 124
}

c() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $*"; return 0; }
	before=$(nbad)
	sleep 1
	capped "$ARMCAP" env $1 $2 $3 $4 $5 $6 $7 $8 $9 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the arm exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This arm is VOID."; health; }
	return 0
}

rung() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $1"; return 0; }
	lbl="$1"; shift
	before=$(nbad)
	log ""
	log "  -- $lbl"
	sleep 1
	capped "$LIMIT" env "$@" "$RUN" "$M8" -p "$PROMPT" -n 32 \
		--ignore-eos -q -c 512 -t 4 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the rung exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This rung is VOID."; health; }
	return 0
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	[ -w /sys/module/rocket/parameters/reset_autosuspend ] && \
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend

	log ""
	log "===== 0) the limit's own control. expect rc 124 after ~3s.         ====="
	t0=$(cut -d. -f1 /proc/uptime)
	capped 3 sleep 60
	rc=$?
	t1=$(cut -d. -f1 /proc/uptime)
	log "  -- capped 3 sleep 60  ->  rc $rc after $((t1 - t0))s"
	[ "$rc" = "124" ] || log "  !! THE LIMIT DID NOT FIRE. Nothing below can be trusted to end."

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "##### ROUND 330: the phantom words are the other half of the sum  #####"

	log ""
	log "===== 2) THE MEASUREMENT. every stage of the forward pass, NPU on. ====="
	log "=====    matmul stages minus the hardware path = the quantise.     ====="
	rung "the decode loop on the NPU, stages on" \
		CHARSIU_STAGES=1 CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 "$CE" "$HEAD"

	log ""
	log "===== 2b) the same stages with the NPU off, one boot apart.        ====="
	rung "the CPU path, stages on" CHARSIU_STAGES=1 CHARSIU_NPU_QUANT=1

	log ""
	log "===== 2) THE ROUND: the phantom words are the other half of the   ====="
	log "=====    sum. out[c] + out[c+N], same buffer, every nibble used.   ====="
	log "===== 2a CONTROL, today's packing"
	c "$M4" $MM 1 64 64
	c "$M4" $MM 1 2048 256
	log "===== 2b THE PHANTOM PACKING, no halfk, 0x40b8=3 and 0x3020=2N-1"
	c "CHARSIU_W4=1 CHARSIU_W4_PHANTOM=1" "CHARSIU_OVERRIDE=0x40b8=3,0x3020=0x7f" $MM 1 64 64
	c "CHARSIU_W4=1 CHARSIU_W4_PHANTOM=1" "CHARSIU_OVERRIDE=0x40b8=3,0x3020=0x1ff" $MM 1 2048 256
	log "===== 2c the same without the register pair, which must be WORSE"
	c "CHARSIU_W4=1 CHARSIU_W4_PHANTOM=1" $MM 1 64 64
	c "CHARSIU_W4=1 CHARSIU_W4_PHANTOM=1" $MM 1 2048 256
	log "===== 2d and with 0x40b8=3 only, to separate the two registers"
	c "CHARSIU_W4=1 CHARSIU_W4_PHANTOM=1" "CHARSIU_OVERRIDE=0x40b8=3" $MM 1 64 64
	c "CHARSIU_W4=1 CHARSIU_W4_PHANTOM=1" "CHARSIU_OVERRIDE=0x40b8=3" $MM 1 2048 256

	log ""
	log "===== 3) a third shape, so a fit on two points is not a law        ====="
	c "CHARSIU_W4=1 CHARSIU_W4_PHANTOM=1" "CHARSIU_OVERRIDE=0x40b8=3,0x3020=0x3ff" $MM 1 1024 512
	c "$M4" $MM 1 1024 512

	log ""
	log "===== 5) the standing number, no timers, so they cannot be blamed  ====="
	rung "the decode loop on the NPU" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 "$CE" "$HEAD"

	log ""
	log "===== the anchor again                                             ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== 2a is the control; 2b is the round; 256 of 256 is full width. ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
