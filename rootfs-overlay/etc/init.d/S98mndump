# ---------------------------------------------------------------------------
# 2026-08-22 round 321. WHAT THE 23 ms IS MADE OF, AND WHETHER BIGGER SLICES
# MAKE IT SMALLER.
#
# ROUND 320 MEASURED THE SPLIT INSTEAD OF INFERRING IT, and two of my earlier
# inferences were wrong.
#
#   rung                     gen ms/tok   hardware   CPU     GB/s   tok/s
#   all 113                  179.8        156.1      23.7    7.92   5.56
#   all 113, 1 task/submit   218.4        195.1      23.3    6.34   4.58
#   112, head on the CPU     192.2        127.2      65.0    7.65   5.20
#   head alone                265.8        28.7     237.1    9.14   3.76
#   everything on the CPU     266.5          -      266.5      -    3.75
#
#   - THE HARDWARE PATH IS 87% OF A TOKEN. Only about 24 ms is CPU. My "58 ms of
#     CPU" was the CPU's output head, which is now on the NPU.
#   - THE HEAD ALONE REACHES 9.14 GB/s, near the bench's 10.35. ⚠ My round 319
#     claim that it only managed 4.2 was WRONG; it came from subtracting whole
#     token times across two different regimes. Fourth inference refuted by a
#     measurement.
#   - The head costs 29 ms on the NPU against 58 on the CPU, which is exactly
#     why routing it wins.
#   - Chaining is worth 39 ms a token, and (156-195)/(113-606) puts a submit at
#     79 us -- the same number round 317 got a different way.
#
#   NPU 5.56 against the best CPU path's 5.53. Ahead for the first time, by half
#   a percent, which is not a number to dress up.
#
# ---------------------------------------------------------------------------
# WHY THIS ROUND EXISTS
# ---------------------------------------------------------------------------
#
# 156 ms of hardware path is about 124 ms of irreducible weight fetch at the
# hardware's own ceiling, about 9 ms of submit, and **about 23 ms left over**.
#
# ⚠ THAT 23 IS A RESIDUAL, NOT A MEASUREMENT, and residuals are what the last
# four wrong calls were made of. So the runtime now splits its own hardware path
# three ways and prints it:
#
#     of that, A ms submitting, B ms waiting for the fence, C ms reading back
#
# bo_prep is not a read: it WAITS for the job. So B is the fence and C is the
# copy, and they have completely different fixes. A big B would justify merging
# the independent projections -- q, k and v all read one RMSNorm output, and so
# do gate and up -- into one submit each, which would remove 48 fences a token
# as well as 48 submits. A big C would not.
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# 1) THE THREE WAY SPLIT IN ENTRY 2 IS THE ROUND. A and C are charsiu's own
#    cost; B is the hardware plus the driver. Note that B necessarily contains
#    the real compute, so it cannot go to zero -- what matters is whether it is
#    much larger than the 124 ms the bytes alone need.
#
# 2) ENTRIES 3 AND 4 ask whether fewer, larger slices help. Both change a shape
#    nothing has verified at acc_out, so **read `wrote`-style evidence first:
#    the text has to be identical, character for character, or the timing is a
#    timing of a wrong answer.** N = 2048 and K = 4096 are both untested here.
#
# 3) Entry 5 is the control that everything is diffed against.
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT
# ---------------------------------------------------------------------------
#
# A) B, THE FENCE, IS MOST OF IT, because it contains the compute. The number
#    worth having is B minus the 124 ms the bytes need: that is what the fence
#    costs beyond the work, and it is what merging submits could remove.
#
# B) LARGER SLICES HELP A LITTLE OR NOT AT ALL. Round 319's task cap sweep was
#    flat across a thirty-two fold range, which already says per submit cost is
#    not the limiter, and slice size mostly changes the same quantity.
#    ⚠ If N = 2048 turns out to be much faster, that would contradict 319 and
#    the contradiction is the result.
#
# C) The text stays identical at every slice size. If it does not, acc_out has a
#    shape dependence nobody has looked for and that is worth more than the
#    round.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
RUN=/opt/charsiu/charsiu_run
M8=/opt/charsiu/models/Llama-3.2-1B-Instruct-Q8_0.gguf
PROMPT="The capital of France is"
LIMIT=420
CE=CHARSIU_COEF_ELEMS=65536
HEAD=CHARSIU_NPU_MAXN=131072
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

capped() {
	lim="$1"; shift
	"$@" &
	pid=$!
	i=0
	while [ "$i" -lt "$lim" ]; do
		kill -0 "$pid" 2>/dev/null || { wait "$pid"; return $?; }
		sleep 1
		i=$((i + 1))
	done
	kill -9 "$pid" 2>/dev/null
	wait "$pid" 2>/dev/null
	return 124
}

rung() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $1"; return 0; }
	lbl="$1"; shift
	before=$(nbad)
	log ""
	log "  -- $lbl"
	sleep 1
	capped "$LIMIT" env "$@" "$RUN" "$M8" -p "$PROMPT" -n 32 \
		--ignore-eos -q -c 512 -t 4 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the rung exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This rung is VOID."; health; }
	return 0
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	[ -w /sys/module/rocket/parameters/reset_autosuspend ] && \
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend

	log ""
	log "===== 0) the limit's own control. expect rc 124 after ~3s.         ====="
	t0=$(cut -d. -f1 /proc/uptime)
	capped 3 sleep 60
	rc=$?
	t1=$(cut -d. -f1 /proc/uptime)
	log "  -- capped 3 sleep 60  ->  rc $rc after $((t1 - t0))s"
	[ "$rc" = "124" ] || log "  !! THE LIMIT DID NOT FIRE. Nothing below can be trusted to end."

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "##### ROUND 321: submit, fence and copy, told apart.              #####"

	log ""
	log "===== 2) THE ROUND. everything, split three ways.                  ====="
	rung "all 113, N=1024 K=2048" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 "$CE" "$HEAD"

	log ""
	log "===== 3) fewer, wider slices. N = 2048 is untested at acc_out.     ====="
	rung "all 113, N=2048" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 "$CE" "$HEAD" \
		CHARSIU_NPU_NMAX=2048

	log ""
	log "===== 4) and a deeper K. 4096 is untested too.                     ====="
	rung "all 113, K=4096" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 "$CE" "$HEAD" \
		CHARSIU_NPU_KMAX=4096

	log ""
	log "===== 5) both at once, the fewest slices this can make             ====="
	rung "all 113, N=2048 K=4096" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 "$CE" \
		"$HEAD" CHARSIU_NPU_NMAX=2048 CHARSIU_NPU_KMAX=4096

	log ""
	log "===== 6) the CPU reference the text is diffed against              ====="
	rung "CPU, NPU number format" CHARSIU_NPU_QUANT=1

	log ""
	log "===== the anchor again                                             ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== the three way split, then whether wider slices changed it.   ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
