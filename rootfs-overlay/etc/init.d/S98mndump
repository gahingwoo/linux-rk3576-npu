# ---------------------------------------------------------------------------
# 2026-08-11 round 67. Which 128 channels are alive?
#
# Round 66's control passed and the answer is sharp:
#
#   dw1_t4    32 ch, one tap everywhere    32/32 correct,    0 flat
#   dw25_t4   1024 ch, centre tap          0/1024 correct, 896 flat
#   dw25_t0   1024 ch, corner tap          0/1024 correct, 896 flat
#   dw25_imp  1024 ch, tap = c mod 9     112/1024 correct,  89 flat
#
# With ONE tap at the same position in every channel, exactly 128 of 1024
# channels produce anything at all, and moving that tap from the centre to the
# corner does not change the count. 128 is 1024/8.
#
# That also finishes off the "fixed tap per group of 64" story from round 65:
# under it, dw25_t4 would light up whole groups whose tap is 4 and flatten the
# rest, in blocks of 64. 896 flat is not a multiple-of-64 pattern of groups, it
# is seven eighths of everything.
#
# The one thing needed now is WHICH 128. A contiguous block means the weight
# fetch is truncated, and 128 channels is exactly 512 bytes of each 2048 byte
# spatial block. Evenly spread means it is strided, and the stride names the
# unit. Nothing else in the report can tell those apart, so perch.py now prints
# the live channels as runs.
#
# Nothing in the driver changed this round.
#
# DECISION RULE, written before the run:
#   live = 0..127, one run           the weight fetch is truncated at 512 bytes
#                                    per spatial block, and the next round is
#                                    about the byte count
#   live = every 8th channel         it is strided, and the stride is the unit
#                                    the block is addressed in
#   live = 128 spread in 64 runs     it follows the pair packing, two channels
#                                    of every sixteen
#   the 32 channel case has none     it never truncates because 32 channels fit
#     flat                           whole, which is why it has always worked
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
p() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== 1..2) one tap everywhere at 1024: WHICH 128 are alive? ====="
	p dw25_t4.tflite ""
	p dw25_t0.tflite ""

	log ""
	log "===== 3) the per-channel-tap model, for its 89 flat ones ====="
	p dw25_imp.tflite ""

	log ""
	log "===== 4) the real 1024 channel layer, same question ====="
	p mn_dw25.tflite ""

	log ""
	log "===== 5) CONTROL: 32 channels, one tap everywhere, nothing flat ====="
	p dw1_t4.tflite ""

	log ""
	log "===== 6) REGRESSION: the real 112x112 depthwise ====="
	p mn_dw1.tflite ""

	log ""
	log "===== 7) a regular shape, which must be untouched ====="
	p conv2d-cal.tflite ""

	log ""
	log "===== Read the runs line in tests 1 and 2. One run beginning at 0 ====="
	log "===== is a truncated fetch; many short runs is a stride.          ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
