# ---------------------------------------------------------------------------
# 2026-08-22 round 327. STOP SUBTRACTING THE CPU's SHARE AND MEASURE IT.
#
# ROUND 326 ANSWERED BOTH ITS QUESTIONS, AND ONE OF THEM REFUTED MY PREDICTION.
#
# 1) THE BLOCK LENGTH IS NOT IN ANY OF THE THREE REGISTERS. 0x1020 doubled,
#    0x1030 doubled, both together: the map is byte for byte the control's,
#    56 of 56 points on the same form, and the acceptance stays 128 of 256.
#    0x1024 halved breaks the block (2 live points, and it poisoned twice).
#    A clean, complete negative.
#
# 2) ⚠ THE CLIFF IS A BYTE CAPACITY, NOT A COUNT, AND I PREDICTED A COUNT.
#    The N sweep at three K, last good and first bad in each row:
#
#        K=512    N=2048  0.524 MB   505 us     no cliff at all
#        K=1024   N=1024  0.524 MB   273 us  |  N=2048  1.049 MB   7932 us
#        K=2048   N=512   0.524 MB   230 us  |  N=1024  1.049 MB   9238 us
#
#    **Every row survives 0.524 MB and dies at 1.049. int4 has a 512 KiB weight
#    ceiling.** int8 does not: 1.049 MB at K=512 is 282 us, and round 325 ran
#    4.19 MB at 562 us. Same 0x101c value in both, so it is not that field.
#
# 3) AND THE NUMBER THAT ACTUALLY CLOSES int4, from the K=512 row that has no
#    cliff in it -- five clean points, no timeouts, int8 in the same boot:
#
#        int4   661.5 us/MB   1.51 GB/s   + 142.9 us
#        int8   105.8 us/MB   9.45 GB/s   + 166.9 us
#
#    **int4 moves a byte 6.2 times slower than int8.** Half the bytes at a sixth
#    of the rate is 3x SLOWER overall, and that is the whole case: not a cliff
#    nobody understands, a marginal cost measured over five points.
#
# ---------------------------------------------------------------------------
# SO THIS ROUND ASKS THE TWO THINGS THAT ARE LEFT
# ---------------------------------------------------------------------------
#
# A) THE LAST HONEST int4 QUESTION. Every bench number above was taken on the
#    OLD map, where half the weight bytes are dead -- the fetch reads 8 live
#    bytes and skips 8. At `0x40b8 = 3` every byte is live and contiguous. If
#    that is what the 6.2x is, int4 at the new map fetches near 9 GB/s and int4
#    comes back with its 2x intact. If it still reads 1.5, the layout is the
#    ceiling and int4 is closed on a measurement rather than a mystery.
#
# B) WHERE THE TOKEN'S TIME ACTUALLY GOES ON THE CPU. The hardware path is
#    measured to the microsecond and the CPU's 21 ms is a SUBTRACTION -- the
#    kind of number I have had to withdraw five times in this project. Every
#    stage of the forward pass is stamped now (CHARSIU_STAGES), so:
#
#      stage total for the matmuls  -  npudev's hardware path  =  the CPU work
#      INSIDE the matmuls, which is the activation quantise and the output
#      dequantise, and it is invisible today.
#
#    ⚠ Host run, CPU only, as the sanity check this was built against: the
#    elementwise stages -- both rmsnorms, rope, attention, silu, both residuals
#    -- total **0.9 ms of 90.5**. If that ratio holds on the A72 the "21 ms of
#    elementwise" I have been quoting is wrong too, and the time is in the
#    quantise, which is a much easier thing to fix.
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# 1) ENTRY 2 IS THE MEASUREMENT. Add up the five matmul stages (q k v, o proj,
#    gate + up, down, output head) and compare with the hardware path npudev
#    prints in the same run. The difference is the CPU inside the matmuls.
#    Everything else is the elementwise, and it should be small.
# 2) ENTRY 3 IS THE SAME RUN WITHOUT THE NPU, so each stage has a before and
#    after in one boot.
# 3) ENTRY 4 IS int4's LAST ARM. 1.5 GB/s at the new map closes it; 9 reopens
#    it, and nothing in between is a result.
# 4) ENTRY 5 IS THE STANDING NUMBER, uninstrumented, so the timers cannot be
#    blamed for it: about 6.55 tokens a second.
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT
# ---------------------------------------------------------------------------
#
# The elementwise is SMALL and most of the CPU's share is the quantise and
# dequantise around each matvec. I am saying it plainly because it is
# falsifiable in one line of entry 2, and because the alternative -- 21 ms of
# rmsnorm and softmax on a 1B model at one token -- does not survive the host
# measurement above.
#
# On int4 I make no prediction. My last two there were wrong.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
RUN=/opt/charsiu/charsiu_run
BE=/opt/charsiu/charsiu_bench
M8=/opt/charsiu/models/Llama-3.2-1B-Instruct-Q8_0.gguf
PROMPT="The capital of France is"
LIMIT=420
ARMCAP=240
CE=CHARSIU_COEF_ELEMS=65536
HEAD=CHARSIU_NPU_MAXN=131072
B8="CHARSIU_OVERRIDE=0x40b8=3"
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

capped() {
	lim="$1"; shift
	"$@" &
	pid=$!
	i=0
	while [ "$i" -lt "$lim" ]; do
		kill -0 "$pid" 2>/dev/null || { wait "$pid"; return $?; }
		sleep 1
		i=$((i + 1))
	done
	kill -9 "$pid" 2>/dev/null
	wait "$pid" 2>/dev/null
	return 124
}

c() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $*"; return 0; }
	before=$(nbad)
	sleep 1
	capped "$ARMCAP" env $1 $2 $3 $4 $5 $6 $7 $8 $9 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the arm exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This arm is VOID."; health; }
	return 0
}

rung() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $1"; return 0; }
	lbl="$1"; shift
	before=$(nbad)
	log ""
	log "  -- $lbl"
	sleep 1
	capped "$LIMIT" env "$@" "$RUN" "$M8" -p "$PROMPT" -n 32 \
		--ignore-eos -q -c 512 -t 4 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the rung exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This rung is VOID."; health; }
	return 0
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	[ -w /sys/module/rocket/parameters/reset_autosuspend ] && \
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend

	log ""
	log "===== 0) the limit's own control. expect rc 124 after ~3s.         ====="
	t0=$(cut -d. -f1 /proc/uptime)
	capped 3 sleep 60
	rc=$?
	t1=$(cut -d. -f1 /proc/uptime)
	log "  -- capped 3 sleep 60  ->  rc $rc after $((t1 - t0))s"
	[ "$rc" = "124" ] || log "  !! THE LIMIT DID NOT FIRE. Nothing below can be trusted to end."

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "##### ROUND 327: measure the CPU's share instead of subtracting it #####"

	log ""
	log "===== 2) THE MEASUREMENT. every stage of the forward pass, NPU on. ====="
	log "=====    matmul stages minus the hardware path = the quantise.     ====="
	rung "the decode loop on the NPU, stages on" \
		CHARSIU_STAGES=1 CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 "$CE" "$HEAD"

	log ""
	log "===== 3) the same stages with the NPU off, one boot apart.         ====="
	rung "the CPU path, stages on" CHARSIU_STAGES=1 CHARSIU_NPU_QUANT=1

	log ""
	log "===== 4) int4's LAST arm: does the live map fetch any faster?      ====="
	log "=====    1.5 GB/s closes it, 9 reopens it, between is not a result ====="
	c "CHARSIU_W4=1" "$CE" $BE --nsweep 512 20
	c "CHARSIU_W4=1" "$B8" "$CE" $BE --nsweep 512 20
	c "CHARSIU_W4=1" "$B8" "$CE" $BE --nsweep 2048 20
	log "=====    int8 at K=512 again, the denominator                      ====="
	c "$CE" $BE --nsweep 512 20

	log ""
	log "===== 5) the standing number, no timers, so they cannot be blamed  ====="
	rung "the decode loop on the NPU" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 "$CE" "$HEAD"

	log ""
	log "===== the anchor again                                             ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== add the five matmul stages, subtract the hardware path.      ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
