#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-20 round 280. The packer was writing k 0 to 15 and nothing else, on
# purpose, since round 173.
#
# ⚠ WHY EVERY int4 ARM OF 279 WAS IDENTICAL. Channels 0 to 7 came back as
# -6753, -4633, -7670, -9732, -3554, -12306, -706 and -8100 in EVERY arm: HALFK
# on and off, 0x3020 = 111 and not, N = 64, 32 and 16. The output did not move
# by one count while HALFK zeroed 2048 of 4096 weights.
#
# It is not the hardware. charsiu_pack_weights refuses to place k >= 16 for
# int4, deliberately, with a comment saying so, and HALFK only ever touched k
# with (k mod 32) >= 16. The packer never wrote those, so both buffers were
# byte identical and so were the outputs. N invariance falls out of the same
# thing: the row it uses is (n/32)*512 + (n%32)*8, which has no N in it.
#
# ⚠ AND THAT ROW WAS READ WITH THE BROKEN PROBE. It comes from --map before the
# byte width defect was fixed, so it is the stale map as well as an incomplete
# one.
#
# WHAT 265 TO 277 MEASURED, and the packer now writes.
#
#   ADDRESS. With CORE 0x3020 = 111 all 64 channels are written and reachable
#   and each is fed by TWO eight byte groups, one at its base and one 256 bytes
#   later. From a stride 8 sweep of the whole buffer, 128 live groups of 256:
#
#     c 0..7  -> 0      c 16..23 -> 512    c 32..39 -> 1024   c 48..55 -> 1536
#     c 8..15 -> 128    c 24..31 -> 640    c 40..47 -> 1152   c 56..63 -> 1600
#
#   A table, not a formula: seven of the eight steps are 128 or 384 and the last
#   is 64, so a closed form would be fitted to one point.
#
#   k, and it is PER CHANNEL PARITY. byte 0 pairs with k 0 on channel 0, byte 8
#   with k 16 on channel 1, byte 16 with k 0 on channel 2. An EVEN channel is
#   fed k 0..15 and 32..47; an ODD channel is fed k 16..31 and 48..63.
#   Confirmed independently at K = 32.
#
# ⚠ SO THE MASK IN 278 AND 279 WAS BACKWARDS ON HALF THE CHANNELS. Both zeroed
# (k mod 32) >= 16 everywhere, which is what an even channel is fed. Fixed to
# the parity rule.
#
# THE READING RULE, fixed before the run.
#
#   ⚠ ENTRY 2 IS THE ROUND, and the first thing to check is that the numbers
#   MOVED. -6753 on channel 0 has been the same in every int4 arm for two
#   rounds. If it is still -6753, the new packer is not reaching the buffer and
#   nothing below means anything.
#
#     the values move AND one reference is exact    an int4 matmul works, and
#                                                   the shift placement is
#                                                   settled in the same line
#     the values move, neither exact                the address and k map are
#                                                   right about which nibble
#                                                   the hardware reads and
#                                                   wrong about the arithmetic
#                                                   or the order within a group
#     the values do not move                        the packer edit missed. Check
#                                                   the refusal: it returns
#                                                   early unless K is 64 or 32
#                                                   and N is at most 64.
#
#   ENTRY 3 sweeps CHARSIU_INT4_ORDER, which picks the order of the 16 nibbles
#   inside a group and is the one thing in the map still guessed rather than
#   read. Two values, and if one is exact the other must not be.
#
#   ENTRY 4 is the control that must FAIL: no HALFK, so the reference counts the
#   k the hardware is not fed.
#
#   ENTRY 6 is int8, untouched by any of this, and must stay 64 of 64.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
MM=/opt/charsiu/charsiu_matmul
V=CHARSIU_OVERRIDE=0x3020=111
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

c() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $*"; return 0; }
	before=$(nbad)
	sleep 1
	env $1 $2 $3 $4 $5 $6 $7 $8 $9 > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This arm is VOID."; health; }
	return 0
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	if [ -w /sys/module/rocket/parameters/reset_autosuspend ]; then
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend
		log "reset_autosuspend = $(cat /sys/module/rocket/parameters/reset_autosuspend)"
	else
		log "!! reset_autosuspend NOT WRITABLE. A timeout will kill the round."
	fi

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== 2) THE ROUND. new packer, HALFK by parity, v = 111.          ====="
	log "=====    ch 0 must not be -6753 any more.                          ====="
	log ""
	c "CHARSIU_W4=1 CHARSIU_W4_HALFK=1" "$V" $MM 1 64 64

	log ""
	log "===== 3) the intra group order, the one thing still guessed        ====="
	c "CHARSIU_W4=1 CHARSIU_W4_HALFK=1 CHARSIU_INT4_ORDER=1" "$V" $MM 1 64 64

	log ""
	log "===== 4) the control that must FAIL. no HALFK.                     ====="
	c "CHARSIU_W4=1" "$V" $MM 1 64 64

	log ""
	log "===== 5) K = 32, where a channel needs only one group              ====="
	c "CHARSIU_W4=1 CHARSIU_W4_HALFK=1" "$V" $MM 1 32 64

	log ""
	log "===== 6) int8 dense. Untouched by any of this. Must be 64 of 64.   ====="
	c X=1 X=1 $MM 1 64 64

	log ""
	log "===== the anchor again                                             ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== did channel 0 move off -6753. Everything follows from that.  ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
