# ---------------------------------------------------------------------------
# 2026-08-11 round 87. What does conv0 have that the impulse does not?
#
# Round 86's prediction landed exactly:
#
#   fc_imp                  32/32, EVERY ONE COMPUTED
#   shift 25, one bit low   a = 0.5000, min and max both 0.5000
#   shift 27, one bit high  a = 1.9993
#   control, old triple     a back to 0.7096, 0/32
#   mn_conv0dw1             12/32 with 1 COMPUTED, the first non-zero
#   regression              conv2d-cal, mn_dw1, mn_dw25, whole model unchanged
#
# So the requant is derived, not fitted: one bit either way gives exactly half
# and exactly double, which is what pins a shift rather than guessing it. An
# impulse first conv is now byte exact.
#
# mn_conv0 with its real weights is not: 9 of 32 matching, all trivial, a
# 0.9991 and b +0.14 with correlation 0.9994. So the affine map is right and a
# small residual is left, and the per-channel a spreads 0.9486 to 1.0009, which
# a per-layer error cannot do.
#
# fc_imp and mn_conv0 differ in exactly two things, so this round separates
# them rather than reasoning about which it is:
#
#   fc_allw    every tap live, bias still zero. The accumulator sums 27 terms
#              instead of 1, so anything per-tap, and the weight zero point
#              compensation is per tap, shows up here and not in fc_imp.
#   fc_impb    one live tap, but the model's REAL bias. Isolates the bias and
#              the A term.
#
# conv0's weight zero point is 151, not 128, so the compensation is not a no-op
# for it the way it is for a per-axis tensor.
#
# DECISION RULE, written before the run:
#   fc_allw wrong, fc_impb right     it is per tap: the weight zero point
#                                    compensation, B or the weight sum in A
#   fc_impb wrong, fc_allw right     it is the bias term in A
#   both wrong                       both, and the sizes say in what proportion
#   both right                       neither, and what conv0 has that these do
#                                    not is the real weight VALUES, so the
#                                    weight buffer is next
#   fc_imp regresses                 that comes first
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
p() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== 1) the baseline that is exact ====="
	p fc_imp.tflite ""

	log ""
	log "===== 2) every tap live, zero bias: per-tap effects only ====="
	p fc_allw.tflite ""

	log ""
	log "===== 3) one tap, real bias: the bias term only ====="
	p fc_impb.tflite ""

	log ""
	log "===== 4) conv0 itself, which has both ====="
	p mn_conv0.tflite ""

	log ""
	log "===== 5) the chain ====="
	p mn_conv0dw1.tflite ""

	log ""
	log "===== 6..8) REGRESSION ====="
	p conv2d-cal.tflite ""
	p mn_dw1.tflite ""
	p mn_dw25.tflite ""

	log ""
	log "===== 9) whole model ====="
	sleep 2
	env TEFLON_LIB=/usr/lib/libteflon.so \
		python3 "$NPU_DIR/test_model.py" "$NPU_DIR/conv2d-cal.tflite" 2 > "$C" 2>&1

	log ""
	log "===== Test 1 must stay 32/32. Then 2 against 3 says whether what  ====="
	log "===== conv0 has extra is per tap or the bias.                     ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
