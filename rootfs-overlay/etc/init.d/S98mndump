#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-23 round 365. SPLIT THE SLICES TOO, NOT JUST THE GROUPS.
#
# ✅ ROUND 364: THE SPLIT IS ARITHMETICALLY NEUTRAL, which was the first thing
# to check. Two devices and one device produced the SAME SENTENCE word for word,
# and the probe still verified 1024 of 1024 at worst 0.00e+00.
#
#   int8, two cores          7.08 tok/s   fence 7171 ms   (6.4 on one core)
#   int4 g1024, two devices  9.13 tok/s   fence 4788 ms
#   int4 g1024, one device   8.52 tok/s   fence 5439 ms   same sentence
#
# ⚠ **THE GAIN WAS 7%, NOT THE 10 TO 12 I PREDICTED.** int8 got 11%, int4 7%.
#
# THE REASON IS IN THE SUBMIT COUNTS, and it is a limit of what round 364
# actually did rather than a hardware one:
#
#   two devices  6790 submits, 6.37 MB a submit
#   one device   4550 submits, 9.51 MB a submit
#
# Splitting a group into two joblists makes two submits where there was one, and
# **only GROUPS were split**. q, k and v is three tensors going two against one,
# worth 1.5x at best; gate and up is one each, worth 2x. But o_proj, down_proj
# and the 128256 wide output head are grouped with nothing, so they went through
# the single projection path, which submits and waits at once and never touched
# core 1.
#
# The output head alone is 128256 by 2048, about 21% of the model's weights, and
# down_proj across sixteen layers is another 21%. **More than 40% of the weight
# traffic never saw the second core.**
#
# ---------------------------------------------------------------------------
# WHAT CHANGED
# ---------------------------------------------------------------------------
#
# The SLICES of one tensor now alternate between devices, not just the members
# of a group. An entry carries one output buffer per device, each slice knows
# which device it is on, and both the single and the grouped paths build one
# joblist per device and issue both before waiting on either.
#
# The output head's sixteen N slices become eight and eight, and every
# projection splits rather than only the five that share an activation.
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# ⚠ THE SENTENCE FIRST, AGAIN. Which device computes which slice cannot change
# the arithmetic; the slices are summed on the CPU either way. **Entries 2 and 3
# must be word for word identical, and identical to round 364's.** If not, the
# slice split is wrong and no rate matters.
#
# Then the rate against entry 3, which is this same build on one device.
#
#   entry 2 near 11 or better -> the tensors that were never grouped are using
#                                core 1 now, which is where the 40% was
#   entry 2 near 9.1          -> splitting the singles bought nothing and the
#                                limit is somewhere other than which core the
#                                work runs on
#
# ENTRY 1 is int8 on the same build, since it splits too and it is the number
# that was asked for.
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT
# ---------------------------------------------------------------------------
#
# 10 to 11. I said 10 to 12 last round and got 9.1, so treat that accordingly.
# The submit count is the thing to watch: if it climbs again while the fence
# barely moves, the cost of an extra submit is eating the parallelism, and the
# next question becomes how few submits two cores can be fed with.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
VD=/opt/charsiu/charsiu_vendor
V=/opt/charsiu/vendor
RGC=$V/vendor-int4-k2048-n1024.regcmd
WT=$V/vendor-wt-1M.bin
IN=$V/vendor-in.bin
RUN=/opt/charsiu/charsiu_run
M8=/opt/charsiu/models/Llama-3.2-1B-Instruct-Q8_0.gguf
PROMPT="The capital of France is"
LIMIT=420
# 32 tokens does not reach the answer to "17 times 24, show your working"
NGEN=64
CE=CHARSIU_COEF_ELEMS=65536
HEAD=CHARSIU_NPU_MAXN=131072
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block did not come back this time."
		ABORT=1
	fi
}

capped() {
	lim="$1"; shift
	"$@" &
	pid=$!
	i=0
	while [ "$i" -lt "$lim" ]; do
		kill -0 "$pid" 2>/dev/null || { wait "$pid"; return $?; }
		sleep 1
		i=$((i + 1))
	done
	kill -9 "$pid" 2>/dev/null
	wait "$pid" 2>/dev/null
	return 124
}
rung() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $1"; return 0; }
	lbl="$1"; shift
	before=$(nbad)
	log ""
	log "  -- $lbl"
	sleep 1
	capped "$LIMIT" env "$@" "$RUN" "$M8" -p "$PROMPT" -n "${NGEN:-32}" \
		--ignore-eos -q -c 512 -t 4 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the rung exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This rung is VOID."; health; }
	return 0
}
# arm: <label> <regcmd-or-dash> <byte> <high> [extra env, one assignment]
#
# ⚠ THE ENV GOES IN AS AN ARGUMENT, not as a "VAR=x arm ..." prefix. Whether an
# assignment before a FUNCTION call survives the call is unspecified -- dash
# drops it, other shells keep it -- and the arm whose whole job is to time out
# WITHOUT the trailer runs right after the one that has it. Not a question worth
# leaving to the shell.
arm() {
	before=$(nbad)
	log ""
	log "  ---- $1"
	sleep 1
	env ${5:-IGNORED=1} $VD "$2" "$WT" "$IN" "$3" "$4" 4096 > /tmp/vd.txt 2>&1
	cat /tmp/vd.txt > "$C"
	after=$(nbad)
	if [ "$after" != "$before" ]; then
		log "  !! POISONED: $((after - before)) new fault or timeout lines"
		health
		# ⚠ NOT a round abort. Round 342 threw away every arm after the
		# first poisoning and then measured the block healthy at the
		# end. The block recovers; give it a moment and carry on.
		ABORT=0
		sleep 2
	fi
}

# two concurrent probes, so the pair can be repeated without copy and paste
pair() {
	before=$(nbad)
	log ""
	log "  ---- $1"
	env CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_TIME=60 CHARSIU_OUT_KB=64 $2 $VD - "$WT" "$IN" 0 0 4096 > /tmp/vdA.txt 2>&1 &
	pidA=$!
	env CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_TIME=60 CHARSIU_OUT_KB=64 $3 $VD - "$WT" "$IN" 0 0 4096 > /tmp/vdB.txt 2>&1 &
	pidB=$!
	wait "$pidA"
	wait "$pidB"
	log "    A:"
	grep -E "M = |TIME:|baseline:|VERIFY:|CONTROL repeat|VOID|REREAD" /tmp/vdA.txt > "$C"
	log "    B:"
	grep -E "M = |TIME:|baseline:|VERIFY:|CONTROL repeat|VOID|REREAD" /tmp/vdB.txt > "$C"
	after=$(nbad)
	[ "$after" != "$before" ] && log "  !! POISONED: $((after - before)) new lines"
	return 0
}

start() {
	log ""
	log "###############################################################"
	log "##### round 365: split the slices too, not just the groups   #####"
	log "###############################################################"
	log "  int4 is byte exact and 1.42 to 1.78x faster. now decode with it."

	log ""
	log "===== 1) CONTROL: int8 decode. 6.4 tok/s, standing sentence.   ====="
	dmesg 2>/dev/null | grep -i "NPU core" > "$C"
	rung "int8" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 "$CE" "$HEAD"

	log ""
	log "===== 2) int4 g1024, slices split across both cores           ====="
	rung "int4 g1024, two devices" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 CHARSIU_NPU_W4V=1 CHARSIU_NPU_KMAX=1024 CHARSIU_NPU_W4_GROUP=1024 "$CE" "$HEAD"

	log ""
	log "===== 3) the same on ONE device. the control.                 ====="
	log "  the SAME sentence as entry 2, word for word."
	rung "int4 g1024, one device" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 CHARSIU_NPU_W4V=1 CHARSIU_NPU_KMAX=1024 CHARSIU_NPU_W4_GROUP=1024 CHARSIU_NPU_ONEDEV=1 "$CE" "$HEAD"

	log ""
	log "===== 4) the probe, still exact under the two device build     ====="
	arm "solo verify" "-" 0 0 "CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_VERIFY=1 CHARSIU_OUT_KB=64"

	log ""
	log "===== 5) the anchor: int8 conv must still be exact            ====="
	health

	log ""
	log "===== read the CONTROL lines first. VOID means the arm died. ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
