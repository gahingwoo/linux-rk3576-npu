# ---------------------------------------------------------------------------
# 2026-08-21 round 302. Where between 128 and 192 does it stop.
#
# ⚠ THE BYTE BUDGET IS REFUTED and the four predictions split two and two, which
# is what makes it settled rather than dented:
#
#   K =  64  N = 128   4096 exactly, predicted exact    128 of 128   landed
#   K =  64  N = 160   5120, predicted to cap at 128    160 of 160   did not cap
#   K = 128  N =  96   6144, predicted to cap at  64     96 of  96   did not cap
#   K = 256  N =  32   4096 exactly, predicted exact    wrote 24 of 32
#
# There is no byte budget. K up to 128 works at EVERY N that has been tried and
# 192 and 256 fail in two different ways: 192 writes every channel and computes
# none of them, 256 falls back to the N/2 + 8 count from before 0x3020 was fixed.
#
# ⚠ AND N = 160 IS G = 20, well past the G = 11 the slot form was read at, so
# that half of the layout generalises much further than it was measured. int4 now
# holds at K of 32, 64 and 128 across thirteen values of N.
#
# THE READING RULE, fixed before the run.
#
#   ⚠ ENTRIES 3 TO 6 ARE THE ROUND: K of 144, 160, 176 and 192, which is every
#   multiple of 16 between the last K that works and the first that does not.
#   None has ever been run. K/32 is 4.5, 5, 5.5 and 6, so two of them are not
#   whole numbers of runs and the packer will round them.
#
#     they work up to some K and stop
#                          the bound is a K and the round says which. Then the
#                          question is whether an LLM tiles to it.
#     144 and 176 fail where 160 works
#                          it is K/32 being a whole number, not the size of K,
#                          and 192 failing needs another reason
#     all four fail        the bound is 128 and everything above it is the same
#                          fault K = 192 shows
#
#   ⚠ ENTRY 7 IS K = 192's GRID, which 301 captured and this reads properly. It
#   writes every channel and computes none, which is a placement fault, and the
#   grid is the only thing that can say where the bytes went.
#
#   ENTRY 2 is K = 64 at N = 160 and K = 128 at N = 96, the two shapes that just
#   refuted the budget, plus the small ones.
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
MM=/opt/charsiu/charsiu_matmul
CH=/opt/charsiu/charsiu_int4
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

c() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $*"; return 0; }
	before=$(nbad)
	sleep 1
	env $1 $2 $3 $4 $5 $6 $7 $8 $9 > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This arm is VOID."; health; }
	return 0
}

M4="CHARSIU_W4=1 CHARSIU_W4_HALFK=1"

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	if [ -w /sys/module/rocket/parameters/reset_autosuspend ]; then
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend
		log "reset_autosuspend = $(cat /sys/module/rocket/parameters/reset_autosuspend)"
	else
		log "!! reset_autosuspend NOT WRITABLE. A timeout will kill the round."
	fi

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== 2) the shapes that refuted the budget, and the small ones    ====="
	c "$M4" X=1 $MM 1 64 160
	c "$M4" X=1 $MM 1 128 96
	c "$M4" X=1 $MM 1 64 64
	c "$M4" X=1 $MM 1 128 64

	log ""
	log "##### THE ROUND. every multiple of 16 between 128 and 192.         #####"
	for KK in 144 160 176 192
	do
		log ""
		log "===== K = $KK  N = 64      (K/32 = $((KK / 32)) point $((KK % 32)))"
		c "$M4" X=1 $MM 1 $KK 64
	done

	log ""
	log "===== 7) K = 192's grid, which is a placement fault                ====="
	c X=1 X=1 $CH 1 192 64 --map 8

	log ""
	log "===== 8) and K = 160's grid if it is the last that works           ====="
	c X=1 X=1 $CH 1 160 64 --map 8

	log ""
	log "===== the control that must FAIL, and int8 at K = 192              ====="
	c "CHARSIU_W4=1" X=1 $MM 1 128 64
	c X=1 X=1 $MM 1 192 64

	log ""
	log "===== which K is the last one. Then whether K/32 whole is the rule ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
