#!/bin/sh
# ---------------------------------------------------------------------------
# 2026-08-08 round 13. ⚠ Round 12 is UNINTERPRETABLE and this round fixes that.
#
# conv2d-cal with the knob came back md5 80e64aab2f96, identical to untouched,
# which is the control I wrote: the rewrite must not touch a 5x5. Good.
#
# But md003_80 with the knob came back byte identical to md003_80 without it,
# and its task_count did not move, and mn_pw2 still split into exactly 2 tasks
# with 2 OUT_CVT lines. A 3x3 kernel costs nine times the weight bytes and nine
# times the CBUF. Nothing moved at all, which is what "the knob never fired"
# looks like, and "unchanged on a 5x5" is ALSO what "never fires anywhere" looks
# like. So round 12's control could not tell the two apart. Same mistake as
# round 8, and this time I caught it before drawing the conclusion.
#
# The check is trivial and it is a size, not a value:
#
#   1x1 path        weight buffer = ic*oc                 = 256 bytes
#   3x3 rewrite     weight buffer = 9 * oc * ALIGN(ic,A) * 2, thousands
#
# Steps 2 and 3 dump it both ways. If the size does not change, the knob is not
# firing and round 12 measured nothing. If it does change, then a real 3x3 conv
# with 16 in and 16 out at 80x80 also fails, which is a much bigger fact: it
# would put the failure on the KERNEL SIZE rather than on 1x1 encoding, with
# 5x5 working at both strides and 3x3 not.
#
# Step 4 prints the regcmd under the knob. There is a vendor .rknn compiled on
# the host at exactly that geometry (16 in, 16 out, 80x80, 3x3, stride 1), so
# whatever it says can be diffed against a known good reference.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }

# $1 tag, $2 model, $3.. env
dump() {
	d="/tmp/$1"; m="$2"; shift 2
	rm -rf "$d"; mkdir -p "$d"; cd "$d" || return 0
	env TEFLON_LIB=/usr/lib/libteflon.so ROCKET_DEBUG=dump_bos "$@" \
		python3 "$NPU_DIR/test_dw.py" "$NPU_DIR/$m" > /dev/null 2>&1
	for f in "$d"/mesa-weights-*.bin; do
		[ -f "$f" ] && python3 "$NPU_DIR/bstat.py" "$f" > "$C" 2>&1
	done
	cd / || return 0
}

many() {
	m="$1"; n="$2"; mark="$3"; shift 3
	echo "SMARK-$mark" > /dev/kmsg 2>/dev/null
	env TEFLON_LIB=/usr/lib/libteflon.so "$@" \
		python3 "$NPU_DIR/test_model.py" "$NPU_DIR/$m" "$n" > "$C" 2>&1
	dmesg | sed -n "/SMARK-$mark/,\$p" | grep -a "job: task_count=" | head -2 > "$C" 2>&1
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	# -n 8 floods the serial console and wedges the box. Learned the hard way.
	dmesg -n 4 2>/dev/null

	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/job_log 2>/dev/null
	log ""
	log "  task_con16=$(cat /sys/module/rocket/parameters/task_con16 2>/dev/null)"

	log ""
	log "===== 1) CONTROL: conv2d-cal ====="
	many conv2d-cal.tflite 2 cal-first

	log ""
	log "===== 2) md003_80 weight buffer WITHOUT the knob: expect 256 bytes ====="
	sleep 2
	dump wpw md003_80.tflite

	log ""
	log "===== 3) md003_80 weight buffer WITH the knob ====="
	log "  still 256 means it never fired and round 12 measured nothing."
	log "  thousands of bytes means a real 3x3 conv also fails."
	sleep 2
	dump w3x3 md003_80.tflite ROCKET_PW_AS_3X3=1

	log ""
	log "===== 4) regcmd under the knob: did the geometry actually widen ====="
	log "  watch 1024 (kernel word), 101c and 1020 (weight DMA), 1030, 1080"
	sleep 2
	rm -rf /tmp/rc; mkdir -p /tmp/rc; cd /tmp/rc || return 0
	env TEFLON_LIB=/usr/lib/libteflon.so ROCKET_DEBUG=dump_bos ROCKET_PW_AS_3X3=1 \
		python3 "$NPU_DIR/test_dw.py" "$NPU_DIR/md003_80.tflite" > /dev/null 2>&1
	for f in /tmp/rc/mesa-regcmd-*.bin; do
		[ -f "$f" ] || continue
		python3 "$NPU_DIR/extract_regcmd.py" "$f" 8 > "$C" 2>&1
	done
	cd / || return 0

	log ""
	log "===== 5) md003_80 under the knob, the actual test again ====="
	sleep 2
	many md003_80.tflite 3 md003-3x3 ROCKET_PW_AS_3X3=1

	log ""
	log "===== 6) REPEAT CONTROL: conv2d-cal ====="
	sleep 2
	many conv2d-cal.tflite 2 cal-last

	log ""
	log "===== 2 against 3 decides whether round 12 meant anything. Read it ====="
	log "===== before reading 5.                                            ====="
	sync
}

case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
