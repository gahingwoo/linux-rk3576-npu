#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-11 round 64. The 1024 channel depthwise uses the wrong TAP.
#
# Round 63's impulse decode at 1024 channels:
#
#   CPU control decodes to its own impulse   1019/1024
#   hardware reads its OWN input plane        897/1024
#   hardware decodes to the same impulse      112/1024
#   correlation on every printed row          +1.000
#
#   ch     0  1  2  3  4  5  6  7  8      the tap the impulse was placed at
#   npu    0  8  7  6  5  4  3  2  1      the tap the hardware used
#
# So the hardware computes a PERFECT single tap of the RIGHT input plane and
# picks the wrong one, by (-p) mod 9. It is not noise: correlation is 1.000,
# the plane is right for 897 channels, and the CPU decodes its own impulse
# 1019 times out of 1024 through the same code.
#
# And it cannot be globally wrong, because dw_imp and mn_dw1 at 112x112 are
# byte-exact against the CPU on the same buffer and the same packing code, both
# re-run at the top of this round.
#
# What differs is not the channel count but the PATH. rkt_regcmd's `split` is
# `capped`, which is only true for a row-windowed layer, so a depthwise that
# does not window gets 0x1018 = 0x40000404 and CBUF_CON0 = 0x10000000 where a
# windowed one gets 0x40000505 and 0x14000000. mn_dw1 windows; mn_dw25 at 7x7
# does not. ROCKET_DW_SPLITVALS forces the windowed values for any depthwise
# and has been sitting unused in the driver.
#
# ROCKET_DW_TAPREV is the other half: write the spatial blocks in exactly the
# order the board reported. That turns the observation into a test rather than
# a story.
#
# DECISION RULE, written before the run:
#   SPLITVALS fixes mn_dw25            the two CNA words are the tap traversal,
#                                      and they belong to depthwise rather than
#                                      to windowing
#   TAPREV fixes mn_dw25 and breaks    the traversal really does depend on
#     mn_dw1                           something, and SPLITVALS says what
#   TAPREV fixes BOTH                  the order was wrong all along and
#                                      112x112 was compensating somewhere else
#   neither moves it                   the tap reading is wrong; go to the row
#                                      and column profile on 7x7
#   dw_imp or mn_dw1 regress           the round 62 fix comes first
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
p() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }
d() { log ""; log "  -- decode $1   $2"; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so $2 \
	python3 "$NPU_DIR/dwimp.py" "$NPU_DIR/$1" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== 1..2) REGRESSION: 112x112 depthwise must still be exact ====="
	p dw_imp.tflite ""
	p mn_dw1.tflite ""

	log ""
	log "===== 3..4) mn_dw25: the windowed CNA words, forced ====="
	p dw25_imp.tflite ROCKET_DW_SPLITVALS=1
	p mn_dw25.tflite ROCKET_DW_SPLITVALS=1

	log ""
	log "===== 5..6) mn_dw25: the tap order the board reported ====="
	p dw25_imp.tflite ROCKET_DW_TAPREV=1
	p mn_dw25.tflite ROCKET_DW_TAPREV=1

	log ""
	log "===== 7) both together ====="
	p dw25_imp.tflite "ROCKET_DW_SPLITVALS=1 ROCKET_DW_TAPREV=1"

	log ""
	log "===== 8) does TAPREV break the 112x112 case? ====="
	p dw_imp.tflite ROCKET_DW_TAPREV=1

	log ""
	log "===== 9) decode again, whichever way test 3 to 7 came out ====="
	d dw25_imp.tflite ROCKET_DW_SPLITVALS=1

	log ""
	log "===== 10) a regular shape, which must be untouched ====="
	p conv2d-cal.tflite ""

	log ""
	log "===== Read tests 1 and 2 first: the 112x112 depthwise is solved  ====="
	log "===== and must stay solved, whatever the 1024 channel case does. ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
