#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-19 round 260. The five fields in 0x4050 nobody can explain.
#
# WHY THIS ONE. It is the only thing owed on the list that is also late. I told
# Igor Paunovic that a value nobody can explain is a value nobody should be
# asked to review, said the sweep would happen before the Mesa series went out,
# then opened MR 43804 carrying all five, and said so again on-list today.
#
# Checked before building, because the last six rounds re-derived something the
# repository already had. No board log contains RGP_CNTER or OW_SRC, no round
# has varied them, and neither existing knob can: ROCKET_DPU4050_CONST forces
# upstream's whole word and ROCKET_DPU4050_MOD32 picks the other rule.
# ROCKET_DPU4050 replaces the word outright, which is what this needs.
#
# WHAT IS BEING SWEPT. Against registers.xml, this driver's 0x80011111 and
# upstream's 0x124 differ in five fields. Each entry moves exactly ONE of them
# to upstream's value and leaves the other four alone. The words are derived
# from the field positions rather than typed by hand.
#
#   field        ours  upstream  word
#   RGP_CNTER       8         0  0x00011111
#   RESERVED_0     34         0  0x80000111
#   SIZE_E_1        0         1  0x80011131
#   SIZE_E_0        4         1  0x80011105
#   OW_SRC          1         0  0x80011110
#
# SIZE_E_2 is not in the sweep. It is the one field that already has a reason:
# it is what the two words this driver picks between differ in, and forcing it
# was measured to time out at 16 output channels.
#
# THE READING RULE, fixed before the run.
#
#   Baseline is entry 1 and the same model unchanged. Every sweep entry is read
#   against it, on the same model, in the same boot.
#
#     a field whose entry is identical to the baseline is NOT load bearing.
#     Say so in the commit that emits it, or drop it and use upstream's value.
#
#     a field whose entry degrades or hangs IS load bearing, and the answer to
#     the reviewer is that line of the log.
#
#   ⚠ Both outcomes are useful and neither is a failure. The point is that
#   five values currently sit in an open merge request with nothing behind them.
#
#   ⚠ Two models, because one is not enough to tell "this field does nothing"
#   from "this field does nothing at this shape". conv2d-cal is 128 output
#   channels and takes the even word; pw64x88w56 is 88 and takes the same word,
#   and it is a pointwise, so the datapath differs.
#
#   ⚠ A hang poisons what follows. The gate is in place and a poisoned entry is
#   void.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	after=$(nbad)
	if [ "$after" != "$before" ]; then
		log "  !! POISON in this entry. The block faulted. This result is VOID."
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" \
			> /tmp/hc.txt 2>&1
		if grep -q "128/128 channels match" /tmp/hc.txt; then
			log "  !! health OK, the block recovered, continuing"
		else
			log "  !! health FAILED, the block is gone. ABORTING the round."
			ABORT=1
		fi
	fi
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	if [ -w /sys/module/rocket/parameters/reset_autosuspend ]; then
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend
		log "reset_autosuspend = $(cat /sys/module/rocket/parameters/reset_autosuspend)"
	else
		log "!! reset_autosuspend NOT WRITABLE. A timeout will kill the round."
	fi

	log ""
	log "===== 1) the baseline, our word unchanged                          ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== 2-6) ONE FIELD AT A TIME, moved to upstream's value          ====="
	w conv2d-cal.tflite "ROCKET_DPU4050=0x00011111"
	w conv2d-cal.tflite "ROCKET_DPU4050=0x80000111"
	w conv2d-cal.tflite "ROCKET_DPU4050=0x80011131"
	w conv2d-cal.tflite "ROCKET_DPU4050=0x80011105"
	w conv2d-cal.tflite "ROCKET_DPU4050=0x80011110"

	log ""
	log "===== 7) the baseline again, so drift across the sweep is visible  ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== 8-13) the same five on a pointwise at 88 output channels     ====="
	w pw64x88w56.tflite ""
	w pw64x88w56.tflite "ROCKET_DPU4050=0x00011111"
	w pw64x88w56.tflite "ROCKET_DPU4050=0x80000111"
	w pw64x88w56.tflite "ROCKET_DPU4050=0x80011131"
	w pw64x88w56.tflite "ROCKET_DPU4050=0x80011105"
	w pw64x88w56.tflite "ROCKET_DPU4050=0x80011110"

	log ""
	log "===== 14) upstream's whole word, which is expected to fail and is  ====="
	log "=====     here so the knob has a control that must break           ====="
	w conv2d-cal.tflite "ROCKET_DPU4050=0x00000124"

	log ""
	log "===== a final anchor                                               ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== Read 1 and 2, then 3 against 4. The bar is the arm beside it ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
