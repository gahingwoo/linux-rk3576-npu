# ---------------------------------------------------------------------------
# 2026-08-20 round 264. Half the channels have no home, and half the bytes are
# dead. Whether those are the same half.
#
# WHERE 263 LEFT IT. Six unmeasured bytes came back at exactly the k and the
# channel the rule predicted, and two predicted dead were dead. The k side is a
# reading rather than a fit now. The channel side turned out to be TWO
# consecutive channels per nibble.
#
#   G = B/128,  b = B%128,  blk = b/8
#   b >= 64                       dead
#   channel = 4*blk + 32*(G & 1)  and that channel + 1
#   k = 16*(blk & 1) + 2*(b % 8) + 32*(G >> 1), high nibble +1
#
# That addresses c mod 4 in {0, 1}, which is 32 of 64 channels, and leaves the
# b >= 64 half of every 128 byte region dead. Two halves missing. Nothing so far
# says they are the same half.
#
# WHAT THIS ROUND DOES. Sweeps the dead half properly, because four points is
# not a sweep and two of them sat on block boundaries. And sweeps N, because a
# map that covers half the channels whatever N is differs from one that covers
# all of a small N and runs out later.
#
# ⚠ NO TWO OPTION PREDICTION THIS TIME, and that is deliberate. Three rounds
# running the answer was outside the two written down. Byte 8 was channel 4 at
# k = 16 when the choices offered were channel 1 at k = 0 or channel 0 at
# k = 16. The channel width was two when the choices were one and four. The
# predeclared rule keeps earning its place because it forces the controls, but
# picking between my two readings has gone nought for three, so what is written
# below is what each observation would MEAN, with room for none of them.
#
# THE READING RULE, fixed before the run.
#
#   At N = 16 the rule addresses channels 0, 1, 4, 5, 8, 9, 12, 13 and nothing
#   else. Read the channel lists at N = 16 first.
#
#     the same eight        the map skips c mod 4 in {2,3} at every N, and the
#                           other half is somewhere no byte probed so far
#     all sixteen           the map depends on N, and the rule above is a
#                           special case of something wider
#     something else        write down what, and do not force it into either
#
#   Then the dead half, bytes 64 to 127. If any of them lights, the b >= 64
#   reading is wrong and where it lights says what b really indexes. If none
#   does across nineteen points, the dead half is real and the missing channels
#   are not in it.
#
#   ⚠ Byte 0 must be channel 0 and 1 at k = 0 in every one of the three runs.
#   It is the same byte at three different N and it must not move.
#
#   ⚠ Anchors either side, so a dead sweep is a dead sweep and not a dead block.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	after=$(nbad)
	if [ "$after" != "$before" ]; then
		log "  !! POISON in this entry. The block faulted. This result is VOID."
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" \
			> /tmp/hc.txt 2>&1
		if grep -q "128/128 channels match" /tmp/hc.txt; then
			log "  !! health OK, the block recovered, continuing"
		else
			log "  !! health FAILED, the block is gone. ABORTING the round."
			ABORT=1
		fi
	fi
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	if [ -w /sys/module/rocket/parameters/reset_autosuspend ]; then
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend
		log "reset_autosuspend = $(cat /sys/module/rocket/parameters/reset_autosuspend)"
	else
		log "!! reset_autosuspend NOT WRITABLE. A timeout will kill the round."
	fi

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== 2) N = 16. The rule says channels 0 1 4 5 8 9 12 13 only.    ====="
	log ""
	sleep 1
	/opt/charsiu/charsiu_int4 1 64 16 --kpair > "$C" 2>&1

	log ""
	log "===== 3) N = 32                                                    ====="
	sleep 1
	/opt/charsiu/charsiu_int4 1 64 32 --kpair > "$C" 2>&1

	log ""
	log "===== 4) N = 64, the same bytes as 263 so the two logs compare     ====="
	sleep 1
	/opt/charsiu/charsiu_int4 1 64 64 --kpair > "$C" 2>&1

	log ""
	log "===== 5) the anchor again                                          ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== Read 1 and 2, then 3 against 4. The bar is the arm beside it ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
