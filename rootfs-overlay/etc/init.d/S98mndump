#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-21 round 300. The layout scales in K. The CHANNEL COUNT does not.
#
# ⚠⚠ K = 128 IS EXACT AT THREE N. 64 of 64, 32 of 32 and 24 of 24, with the
# eleven K = 64 geometries untouched beside it. Both halves of that layout were
# measured rather than predicted, so the address rule and the K/32 run count both
# hold at a K nothing had ever been run at.
#
# ⚠ K = 256 IS EXACTLY HALF, AND NOT FOR A LAYOUT REASON. 32 of 64 and 16 of 32,
# and the reason is in the line above the score:
#
#   K = 256  N = 64    wrote 40 of 64    g0..g3 8/8, g4..g7 0/8
#   K = 256  N = 32    wrote 24 of 32    g0, g1 8/8, g2, g3 0/8
#
# 40 and 24 are N/2 + 8. That is the channel count from BEFORE round 283 fixed
# 0x3020, which now emits 2*(ALIGN_UP(n,16) - 8) - 1, or 111 at N = 64, and
# 111 gives 64 channels at K = 64 and at K = 128. At K = 256 it gives 40, which
# is what v = 63 gives. The register stops being honoured somewhere between
# K = 128 and K = 256, and the failing channels are exactly the ones never
# written.
#
# THE READING RULE, fixed before the run.
#
#   ⚠ ENTRY 3 IS THE ROUND: 0x3020 swept higher at K = 256. If the count is
#   still ceil((v+1)/2) + 8 and something merely shifted it, a larger v buys the
#   channels back.
#
#     a value gives 64      the register still works and the mapping from v to
#                           channels depends on K. Read the new mapping.
#     none does, and wrote
#     stays at 40           there is a CAP that is not 0x3020, and 40 at K = 256
#                           against 64 at K = 128 says it scales with K. That is
#                           the thing an LLM shape hits, so measure the cap.
#     wrote moves but not to 64
#                           write down what it moves to. Two points on a cap are
#                           worth more than one value that works.
#
#   ENTRY 4 IS K = 192, between the last K that works and the first that does
#   not. Nothing has ever run there and it is one arm.
#
#   ENTRY 5 sweeps SIZE_E_2, which is the additive term in that same count and
#   was measured at K = 64 only.
#
#   ENTRY 2 is K = 64 and K = 128, which must not move.
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
MM=/opt/charsiu/charsiu_matmul
CH=/opt/charsiu/charsiu_int4
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

c() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $*"; return 0; }
	before=$(nbad)
	sleep 1
	env $1 $2 $3 $4 $5 $6 $7 $8 $9 > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This arm is VOID."; health; }
	return 0
}

M4="CHARSIU_W4=1 CHARSIU_W4_HALFK=1"

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	if [ -w /sys/module/rocket/parameters/reset_autosuspend ]; then
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend
		log "reset_autosuspend = $(cat /sys/module/rocket/parameters/reset_autosuspend)"
	else
		log "!! reset_autosuspend NOT WRITABLE. A timeout will kill the round."
	fi

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== 2) K = 64 and K = 128, which must not move                   ====="
	c "$M4" X=1 $MM 1 64 64
	c "$M4" X=1 $MM 1 64 88
	c "$M4" X=1 $MM 1 128 64
	c "$M4" X=1 $MM 1 128 24

	log ""
	log "##### THE ROUND. 0x3020 higher at K = 256. wrote is 40 of 64.      #####"
	for v in 111 127 143 175 207 255
	do
		log ""
		log "===== K = 256  N = 64   0x3020 = $v"
		c "$M4" "CHARSIU_OVERRIDE=0x3020=$v" $MM 1 256 64
	done

	log ""
	log "===== 4) K = 192, between the last that works and the first not    ====="
	c "$M4" X=1 $MM 1 192 64
	c "$M4" X=1 $MM 1 192 32

	log ""
	log "##### 5) SIZE_E_2 at K = 256, measured at K = 64 only              #####"
	for v in 0x00023133 0x00023233 0x00023333
	do
		log ""
		log "===== K = 256  N = 64   0x4050 = $v"
		c "$M4" "CHARSIU_OVERRIDE=0x4050=$v" $MM 1 256 64
	done

	log ""
	log "===== the control that must FAIL, and int8 at K = 256              ====="
	c "CHARSIU_W4=1" X=1 $MM 1 128 64
	c X=1 X=1 $MM 1 256 64

	log ""
	log "===== the anchor again                                             ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== read wrote, not the score. 40 of 64 is the whole story.      ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
