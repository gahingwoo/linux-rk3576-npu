#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-11 round 73. Which ONE of the four registers wants the extra channel?
#
# Round 72 gave three facts and exposed one flaw of mine.
#
#   1024 channels, +1     1024/1024, and every larger value too
#     32 channels, +32       0/32, from 32/32
#   regular convs, +32    unchanged, 128/128 and 16/16
#
# So the minimum is ONE, not a group of 32: at 1024 channels the count has to
# read 1024 and not 1023. It is a boundary, and 1023 is 0x3ff, a ten bit field
# exactly full. A 32 channel depthwise does NOT tolerate the same addition, so
# no unconditional "add 32" rule can be right, and the fix must not be a
# constant fitted to one shape. That is how CNA 0x1080's padding constant stood
# wrong for months.
#
# The flaw: rounds 71 and 72 moved FOUR registers at once. CORE 0x3020, DPU
# 0x402c, DPU 0x4030 and RDMA 0x5014 all carry the output channel count, and
# nothing so far says which of them the hardware is reading short. This round
# splits them.
#
# 0x4030 is the interesting one because the count is PACKED there, at bit 16
# beside a mode field, while the other three carry it alone. If the packed
# field is ten bits then 1023 fills it and 1024 spills into the next bit, which
# would explain both why the tail exists and why one extra is enough.
#
# DECISION RULE, written before the run:
#   exactly one knob closes the tail   that register is the one, and its field
#                                      width explains the boundary
#   several do                         they are redundant copies and the fix
#                                      can use whichever is cleanest
#   none does alone                    the hardware needs them consistent, so
#                                      the fix moves all four together and the
#                                      32 channel case says what the rule is
#   the same knob at 32 channels       whichever register it is, its rule has
#     breaks mn_dw1                    to depend on the channel count
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
p() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== 1..2) REGRESSION and the baseline ====="
	p mn_dw1.tflite ""
	p dw25_t4.tflite ""

	log ""
	log "===== 3..6) one register at a time, +1, at 1024 channels ====="
	p dw25_t4.tflite ROCKET_OC_CORE_ADD=1
	p dw25_t4.tflite ROCKET_OC_DPU_ADD=1
	p dw25_t4.tflite ROCKET_OC_CUBE_ADD=1
	p dw25_t4.tflite ROCKET_OC_RDMA_ADD=1

	log ""
	log "===== 7) all four, which is known to work, for comparison ====="
	p dw25_t4.tflite ROCKET_OC_OUT_ADD=1

	log ""
	log "===== 8..11) the same four at 32 channels, which must not break ====="
	p mn_dw1.tflite ROCKET_OC_CORE_ADD=1
	p mn_dw1.tflite ROCKET_OC_DPU_ADD=1
	p mn_dw1.tflite ROCKET_OC_CUBE_ADD=1
	p mn_dw1.tflite ROCKET_OC_RDMA_ADD=1

	log ""
	log "===== 12) the real 1024 layer with whichever knob wins, all four ====="
	p mn_dw25.tflite ROCKET_OC_OUT_ADD=1

	log ""
	log "===== 13) a regular shape, untouched ====="
	p conv2d-cal.tflite ""

	log ""
	log "===== Compare 3 to 6 against 2. Then check the same knob in 8 to  ====="
	log "===== 11: a fix that closes 1024 and breaks 32 is not a fix.      ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
