# ---------------------------------------------------------------------------
# 2026-08-22 round 316. THE HARDWARE NEVER RAN IN 315, AND THE CONTROL SAID SO.
#
# ⚠⚠ ROUND 315 IS VOID, AND THE WAY IT WAS CAUGHT IS THE POINT. Every rung
# produced the reference text character for character -- including ffn_gate and
# ffn_down, the ones that wedged 313. It looked like a complete success.
#
# Then entry 5, THE CONTROL THAT WAS SUPPOSED TO FAIL, produced the same correct
# text in 7912 ms, the FASTEST rung of the whole round, with no timeout and no
# "stopped answering". That configuration is exactly what wedged 313. It cannot
# both wedge and be the fastest thing in the log.
#
# So the NPU never ran, and the whole ladder was the CPU wearing an NPU label.
# Two other numbers agree: the full rung took 8623 ms against the CPU
# reference's 8563, so no work moved; and peak RSS rose by 2 MB where 973 MB of
# weight buffers would have shown, because charsiu_bo_alloc mmaps every buffer.
#
# ⚠ AND MY OWN READING RULE FOR 315 SAID TO CHECK THE PER TENSOR "on the NPU"
# LINES FIRST -- AND I HAD REMOVED THE FLAG THAT PRINTS THEM. A silent fallback
# is worse than a loud failure: it produces something that looks like evidence.
#
# FIXED: every reason a tensor does not reach the hardware now prints itself,
# once, unconditionally; and every run ends with
#
#     charsiu NPU: N tensors, M slices, S submits
#
# and says outright when S is zero.
#
# ---------------------------------------------------------------------------
# THE PRIME SUSPECT, FOUND ON THE HOST
# ---------------------------------------------------------------------------
#
# charsiu_coef_bytes is `table + k*n*4`, so THE COEFFICIENT BUFFER IS FOUR TIMES
# THE WEIGHT BUFFER: 8.4 MB for a K=2048 N=1024 slice, 67 MB at N=8192. A whole
# model's projections would want 3.9 GB of it on top of 973 MB of weights.
#
# That bound is a guess from the driver era, kept because UNDER allocating hangs
# the block and nobody wanted to find the edge. The reads it was sized against
# are tens of kilobytes: round 147's wall was 4.7 KB allocated against 33 KB
# read, and the driver's was 1280 against 20800. Nothing has ever measured the
# read growing with k*n.
#
# CHARSIU_COEF_ELEMS overrides it. 480 slices need 4031 MB at the default and
# 130 MB at 65536.
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# 1) ENTRY 2 IS THE ROUND. One tensor, verbose. The two lines that matter:
#      charsiu: NOT on the NPU -- <reason> (K=.. N=..)
#      charsiu NPU: n tensors, m slices, s submits
#    THE REASON IS THE RESULT. Everything else this round does depends on it.
#
# 2) ENTRY 3 measures the coefficient buffer's real floor, on the probe that
#    scores exactness. Its CONTROL is the default, which must give 1024 of 1024
#    words exact; then each smaller value must too, until one does not. **The
#    smallest value that is still exact is the answer, and the first one that is
#    not is what proves the floor is real rather than assumed.**
#
# 3) ENTRY 4 re-runs the ladder with a coefficient buffer that fits. A rung is
#    only readable if its report says a NON ZERO submit count. Read that line
#    before the text, which is the mistake 315 made.
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT
# ---------------------------------------------------------------------------
#
# A) THE REASON IS "a buffer would not allocate", at the coefficient buffer.
#    Round 315's peak RSS rose by exactly 2 MB, which is one weight buffer, so
#    the weight allocated and the next one did not.
#
# B) THE COEFFICIENT FLOOR IS FAR BELOW k*n. If 8192 elements is still exact at
#    K=2048 N=1024, the bound was over by a factor of two thousand and the whole
#    scaling problem disappears. If instead exactness dies somewhere in between,
#    that value is a real measurement of what the RDMA reads and is worth more
#    than the ladder.
#
# C) With a coefficient buffer that fits, the ladder runs on the hardware and
#    every rung is character for character the reference. That is what 313
#    showed for attention before the shapes got out of hand.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
RUN=/opt/charsiu/charsiu_run
WD=/opt/charsiu/charsiu_wide
M8=/opt/charsiu/models/Llama-3.2-1B-Instruct-Q8_0.gguf
PROMPT="The capital of France is"
LIMIT=420
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

capped() {
	lim="$1"; shift
	"$@" &
	pid=$!
	i=0
	while [ "$i" -lt "$lim" ]; do
		kill -0 "$pid" 2>/dev/null || { wait "$pid"; return $?; }
		sleep 1
		i=$((i + 1))
	done
	kill -9 "$pid" 2>/dev/null
	wait "$pid" 2>/dev/null
	return 124
}

# $1 label, $2 tokens, $3.. env
rung() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $1"; return 0; }
	lbl="$1"; ntok="$2"; shift 2
	before=$(nbad)
	log ""
	log "  -- $lbl"
	sleep 1
	capped "$LIMIT" env "$@" "$RUN" "$M8" -p "$PROMPT" -n "$ntok" \
		--ignore-eos -q -c 512 -t 4 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the rung exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This rung is VOID."; health; }
	return 0
}

c() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $*"; return 0; }
	before=$(nbad)
	sleep 1
	capped "$LIMIT" env $1 $2 $3 $4 $5 $6 $7 $8 $9 > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This arm is VOID."; health; }
	return 0
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	[ -w /sys/module/rocket/parameters/reset_autosuspend ] && \
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend

	log ""
	log "===== 0) the limit's own control. expect rc 124 after ~3s.         ====="
	t0=$(cut -d. -f1 /proc/uptime)
	capped 3 sleep 60
	rc=$?
	t1=$(cut -d. -f1 /proc/uptime)
	log "  -- capped 3 sleep 60  ->  rc $rc after $((t1 - t0))s"
	[ "$rc" = "124" ] || log "  !! THE LIMIT DID NOT FIRE. Nothing below can be trusted to end."

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "##### ROUND 316: why the hardware did not run, and what the       #####"
	log "#####            coefficient buffer actually needs.               #####"

	log ""
	log "===== 2) THE ROUND. one tensor, verbose. THE REASON IS THE RESULT. ====="
	rung "blk.0.attn_q, and say why if it does not go" 4 \
		CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 CHARSIU_NPU_ONLY=blk.0.attn_q \
		CHARSIU_NPU_VERBOSE=1

	log ""
	log "===== 3) the coefficient buffer's floor. control first: default.   ====="
	log "=====    read 'words exact'; 1024 of 1024 or it is too small.      ====="
	log ""
	log "===== CHARSIU_COEF_ELEMS unset (k*n, 8.4 MB)"
	c "CHARSIU_ACC=1" X=1 $WD 1 2048 1024
	for E in 1048576 262144 65536 16384 8192
	do
		log ""
		log "===== CHARSIU_COEF_ELEMS = $E"
		c "CHARSIU_COEF_ELEMS=$E" X=1 $WD 1 2048 1024
	done

	log ""
	log "===== the anchor, before the ladder                                 ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== 4) the ladder, with a coefficient buffer that fits.          ====="
	log "=====    READ THE SUBMIT COUNT BEFORE THE TEXT.                    ====="

	log ""
	log "===== attn_q"
	rung "attn_q on the NPU" 32 CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 \
		CHARSIU_NPU_ONLY=attn_q CHARSIU_COEF_ELEMS=65536

	log ""
	log "===== every attention projection"
	rung "attn on the NPU" 32 CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 \
		CHARSIU_NPU_ONLY=attn CHARSIU_COEF_ELEMS=65536

	log ""
	log "===== every feed forward projection"
	rung "ffn on the NPU" 32 CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 \
		CHARSIU_NPU_ONLY=ffn CHARSIU_COEF_ELEMS=65536

	log ""
	log "===== everything under n = 8192"
	rung "all projections on the NPU" 32 CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 \
		CHARSIU_COEF_ELEMS=65536

	log ""
	log "===== 5) the CPU reference, for the text every rung is diffed on   ====="
	rung "CPU, NPU number format" 32 CHARSIU_NPU_QUANT=1

	log ""
	log "===== the anchor again                                             ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== the reason, then the coefficient floor, then submit counts.  ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
