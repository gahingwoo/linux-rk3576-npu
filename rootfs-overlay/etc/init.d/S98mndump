#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-23 round 338. IS int4 EVEN A MATMUL? THE GRID SAYS NO.
#
# ⚠⚠ A CORRECTION THAT INVALIDATES WHAT int4 WAS SIGNED OFF ON. The arithmetic
# this tree measured for int4 and has been checking against since round 265 is
#
#     out = ((int16)fp16bits(w) * (int16)abits) >> 16
#
# and fp16bits is the BIT PATTERN of the nibble converted to a half, which is
# not proportional to the nibble. Work out what weights that can represent:
#
#     nibble    0     1     2     3     4     5     6     7
#     effective 0.000 1.000 1.067 1.100 1.133 1.150 1.167 1.183
#
# **Sixteen levels crammed into eighteen percent of range.** A weight can be
# zero or about one, and nothing else. That is not a grid a weighted sum can
# use, so "1024 of 1024 exact" in round 334 was exact against a NONLINEAR
# reference, and none of the int4 correctness in this tree is a matmul.
#
# The speed, the layout, the pairing and the three count registers are all real
# and all still stand. What they compute is not.
#
# ---------------------------------------------------------------------------
# AND THE SAME FORMULA NAMES THE FIX
# ---------------------------------------------------------------------------
#
# A half weight multiplied by an INTEGER activation is exactly what that shape
# looks like. charsiu puts an int8 in the HIGH BYTE of a sixteen bit slot; the
# vendor is W4A16 with real halves. So fill the slot properly and ask the
# hardware which reference it matches:
#
#   CHARSIU_W4_AF16    packs the activation as a real half
#   the tool now prints a PLAIN WEIGHTED SUM line beside the old one, fitted
#   to one global scale, because the hardware's units are its own
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# 1) ENTRY 2 IS THE CONTROL: today's int8-in-a-half-slot packing. The old
#    reference must still score, and the PLAIN WEIGHTED SUM line must NOT,
#    because that is the whole claim being made here.
# 2) ENTRY 3 IS THE ROUND: the same job with a real half in the slot. If the
#    plain weighted sum line comes back at n of n, int4 is a matmul after all
#    and everything since round 265 was measuring a misconfiguration.
# 3) IF NEITHER SCORES at entry 3, the half is not what the slot wants either,
#    and the next question is what the DPU converts before it multiplies.
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT
# ---------------------------------------------------------------------------
#
# The real half makes it a weighted sum. The formula's shape, the vendor being
# W4A16, and charsiu already telling the hardware sixteen bit activations while
# feeding it eight all point the same way. ⚠ But I have been wrong about int4
# six times, and this round exists because I nearly wired a nonlinear operation
# into a language model.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
RUN=/opt/charsiu/charsiu_run
BE=/opt/charsiu/charsiu_bench
MM=/opt/charsiu/charsiu_matmul
I4=/opt/charsiu/charsiu_int4
M4="CHARSIU_W4=1 CHARSIU_W4_HALFK=1"
M8=/opt/charsiu/models/Llama-3.2-1B-Instruct-Q8_0.gguf
PROMPT="The capital of France is"
LIMIT=420
ARMCAP=240
CE=CHARSIU_COEF_ELEMS=65536
HEAD=CHARSIU_NPU_MAXN=131072
B8="CHARSIU_OVERRIDE=0x40b8=3"
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

# Igor's scorer, not ours: it compares against the RAW cpu output and prints
# the constant-reference-channel guard on every model.
ocp() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $1"; return 0; }
	before=$(nbad)
	log ""
	log "  -- $1"
	sleep 1
	capped "$ARMCAP" env TEFLON_LIB=$WORK python3 "$NPU_DIR/oc_perch.py" \
		"$NPU_DIR/$1" > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the arm exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This arm is VOID."; health; }
	return 0
}

capped() {
	lim="$1"; shift
	"$@" &
	pid=$!
	i=0
	while [ "$i" -lt "$lim" ]; do
		kill -0 "$pid" 2>/dev/null || { wait "$pid"; return $?; }
		sleep 1
		i=$((i + 1))
	done
	kill -9 "$pid" 2>/dev/null
	wait "$pid" 2>/dev/null
	return 124
}

c() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $*"; return 0; }
	before=$(nbad)
	sleep 1
	capped "$ARMCAP" env $1 $2 $3 $4 $5 $6 $7 $8 $9 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the arm exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This arm is VOID."; health; }
	return 0
}

rung() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $1"; return 0; }
	lbl="$1"; shift
	before=$(nbad)
	log ""
	log "  -- $lbl"
	sleep 1
	capped "$LIMIT" env "$@" "$RUN" "$M8" -p "$PROMPT" -n 32 \
		--ignore-eos -q -c 512 -t 4 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the rung exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This rung is VOID."; health; }
	return 0
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	[ -w /sys/module/rocket/parameters/reset_autosuspend ] && \
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend

	log ""
	log "===== 0) the limit's own control. expect rc 124 after ~3s.         ====="
	t0=$(cut -d. -f1 /proc/uptime)
	capped 3 sleep 60
	rc=$?
	t1=$(cut -d. -f1 /proc/uptime)
	log "  -- capped 3 sleep 60  ->  rc $rc after $((t1 - t0))s"
	[ "$rc" = "124" ] || log "  !! THE LIMIT DID NOT FIRE. Nothing below can be trusted to end."

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "##### ROUND 338: is int4 even a matmul?                           #####"

	log ""
	log "===== 2) THE MEASUREMENT. every stage of the forward pass, NPU on. ====="
	log "=====    matmul stages minus the hardware path = the quantise.     ====="
	rung "the decode loop on the NPU, stages on" \
		CHARSIU_STAGES=1 CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 "$CE" "$HEAD"

	log ""
	log "===== 2b) the same stages with the NPU off, one boot apart.        ====="
	rung "the CPU path, stages on" CHARSIU_STAGES=1 CHARSIU_NPU_QUANT=1

	log ""
	log "===== 2) CONTROL: today's packing, an int8 in a 16 bit slot.       ====="
	log "=====    the old reference scores, the plain sum must NOT.         ====="
	c "$M4" "CHARSIU_OVERRIDE=0x40b8=3,0x3020=0x7f" $MM 1 64 64
	c "CHARSIU_W4=1 CHARSIU_W4_PAIRED=1" "$CE" $MM 1 64 64

	log ""
	log "===== 3) THE ROUND: a REAL half in the slot.                       ====="
	log "=====    read the PLAIN WEIGHTED SUM line.                          ====="
	c "CHARSIU_W4=1 CHARSIU_W4_AF16=1" "CHARSIU_OVERRIDE=0x40b8=3,0x3020=0x7f" $MM 1 64 64
	c "CHARSIU_W4=1 CHARSIU_W4_PAIRED=1 CHARSIU_W4_AF16=1" "$CE" $MM 1 64 64
	c "CHARSIU_W4=1 CHARSIU_W4_PAIRED=1 CHARSIU_W4_AF16=1" "$CE" $MM 1 2048 256

	log ""
	log "===== 4) and the halfk zeroing off, since a real half needs all k  ====="
	c "CHARSIU_W4=1 CHARSIU_W4_AF16=1" $MM 1 64 64

	log ""
	log "===== 5) the standing number, no timers, so they cannot be blamed  ====="
	rung "the decode loop on the NPU" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 "$CE" "$HEAD"

	log ""
	log "===== the anchor again                                             ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== the PLAIN WEIGHTED SUM line is the round.                     ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
