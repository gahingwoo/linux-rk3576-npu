# ---------------------------------------------------------------------------
# 2026-08-20 round 266. The same hole one level up, and the six G points.
#
# WHAT 265 SETTLED. The output element is a four byte signed little endian
# integer and the word index is the channel: +7100 came back 00001bbc lighting
# two bytes, -6800 came back ffffe570 lighting four, and the two arms agreed on
# every word and every k across 48 points. Every nibble lights exactly ONE word,
# so 264's "two consecutive channels" was the byte pair artefact and is gone.
# Both maps closed on their own data, 40 of 40 at N = 16 and 48 of 48 at N = 64:
#
#   N=16, B<128:  word = B/8
#                 k    = 16*((B/8)&1) + 2*(B%8) + nib
#
#   N=64:         G = B/128, b = B%128,  b >= 64 dead
#                 word = b/8 + 8*(G&1) + 16*(G>>2)
#                 k    = 16*((b/8)&1) + 32*((G>>1)&1) + nib
#
# THE CONTROL FIRED AND THAT IS WHY IT WAS THERE. Byte 512 was declared dark
# and came back live at word 16, k 0. The old G term 32*(G>>1) and the right one
# 32*((G>>1)&1) agree at G of 0 to 3 and first differ at G of 4, which is 512.
#
# ⚠ WHAT 265 GOT WRONG ON ITS OWN TERMS. It read m*n*4, which is words 0 to
# n-1, out of a buffer allocated m*n*4 + 4096. A byte whose element lands at
# word n or beyond reads back dead, which is EXACTLY the mistake 264 made, one
# level up, and eleven bytes came back dead. It also filled with zero, so a word
# the hardware wrote 0 into is indistinguishable from one it never touched.
# Fixed both: the whole bo is read, and the fill is 0xa5 like every other probe
# in that file.
#
# THE READING RULE, fixed before the run.
#
#   ⚠ EVERY LINE NOW ENDS "hw wrote N words, highest H". That is the extent of
#   the write, measured against the sentinel, and it does not depend on any of
#   the address arithmetic.
#
#     N words = n exactly     the write is one element per channel and the
#                             element is four bytes. Confirms 265 independently.
#     more than n             the surface is bigger than the channel count and
#                             the dead bytes have somewhere to have gone
#     fewer than n            the hardware is not writing every channel and the
#                             missing half is a write problem, not a fetch one
#
#   THE SIX G POINTS, at b = 0. This is the prediction of the round.
#
#     640  G 5  -> word 24 k 0      1024 G 8  -> word 32 k 0
#     768  G 6  -> word 16 k 32     1536 G 12 -> word 48 k 0
#     896  G 7  -> word 24 k 32     1920 G 15 -> word 56 k 32
#
#     all six land            the G bit assignment is a reading and it holds
#                             across the whole 2048 byte buffer, not the first
#                             quarter of it
#     they land elsewhere     write down where. G bit 1 going to k and the rest
#                             to word is the part with the least data behind it.
#
#   ⚠ THESE SIX CONTRADICT SOMETHING THIS PROJECT ALREADY WROTE DOWN. --bmap's
#   reading, still in the README, is "640 bytes light something, 1408 light
#   nothing, and the entire second half of the buffer is dark". All six of these
#   are in that second half and the rule says all six are live. One of the two
#   is wrong and this settles which. --bmap agrees with --kpair on everything
#   else, including "each slot is fed by 16 bytes, two runs of eight, 256
#   apart", which is exactly word 0 being fed by bytes 0 to 7 and 256 to 263,
#   so the disagreement is narrow and worth the six submissions.
#
#   b MOD 8 AT N = 64, bytes 1 to 7. 265 has no point for this at all, because
#   its only b%8 samples were 65 and 66 and those are in the dead half at N=64.
#   The N=16 rule carried over says word 0 throughout, k = 2, 4, 6, 8, 10, 12,
#   14. If instead they land in different words, then b%8 is a channel index at
#   N = 64 and the two N do not share a rule.
#
#   THE DEAD HALF AT ANOTHER G, bytes 192 and 320. Every dead point in 265 was
#   in G = 0. Both dark means bit 6 of the address really is the dead one. Either
#   one live means G = 0 has a hole and it is not a bit.
#
#   N = 32 is the third geometry. Two points cannot separate a rule that scales
#   with N from one that scales with the block, and the dead bit sat at B bit 7
#   at N = 16 and B bit 6 at N = 64.
#
#   ⚠ Byte 0 must be word 0 at k = 0 in all three runs. Same byte, three
#   geometries, it must not move.
#
#   The negative arm is NOT repeated. It answered its question at 48 points.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	after=$(nbad)
	if [ "$after" != "$before" ]; then
		log "  !! POISON in this entry. The block faulted. This result is VOID."
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" \
			> /tmp/hc.txt 2>&1
		if grep -q "128/128 channels match" /tmp/hc.txt; then
			log "  !! health OK, the block recovered, continuing"
		else
			log "  !! health FAILED, the block is gone. ABORTING the round."
			ABORT=1
		fi
	fi
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	if [ -w /sys/module/rocket/parameters/reset_autosuspend ]; then
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend
		log "reset_autosuspend = $(cat /sys/module/rocket/parameters/reset_autosuspend)"
	else
		log "!! reset_autosuspend NOT WRITABLE. A timeout will kill the round."
	fi

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== 2) N = 16                                                    ====="
	log ""
	sleep 1
	/opt/charsiu/charsiu_int4 1 64 16 --kpair > "$C" 2>&1

	log ""
	log "===== 3) N = 32, the third geometry                                ====="
	sleep 1
	/opt/charsiu/charsiu_int4 1 64 32 --kpair > "$C" 2>&1

	log ""
	log "===== 4) N = 64. The six G points and bytes 1 to 7 are here.       ====="
	sleep 1
	/opt/charsiu/charsiu_int4 1 64 64 --kpair > "$C" 2>&1

	log ""
	log "===== 5) the anchor again                                          ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== Read the write extent first, then 640 768 896 1024 1536 1920 ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
