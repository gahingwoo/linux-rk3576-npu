#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-24 round 369. THE 10.6 MS NOBODY HAD MEASURED.
#
# ROUND 368: 10.53 tok/s exact, and ONE OF ITS FOUR IDEAS WAS A REGRESSION.
#
#   1 everything on, unpinned    9.11 tok/s  109.5 ms   attention 22.70
#   2 the same, pinned to A72   10.53         94.6      attention  7.42
#   3 CONTROL, r367 behaviour   10.10         98.6      attention  7.75
#   4 pinned + fast exp         10.69         93.2      silu 1.95 not 2.96
#
# All four sentences identical, probe 1024/1024 at 0.00e+00, anchor clean.
# **Entry 4 did NOT move a token on the board** where it moved one on the host
# -- luck on this prompt, not a guarantee, so the fast exp stays opt in.
#
# 🔑 THREADING ATTENTION COST 15 MS AND BOUGHT 0.33.
#
# Left where the scheduler put it, splitting 32 heads over four threads ran
# 22.70 ms a token against 7.75 serial. Pinned to the four A72s it ran 7.42
# against 7.75 -- a 4% gain for a fan out and fan in around two milliseconds of
# work. **It is serial again**; CHARSIU_ATTN_POOL keeps the path, because
# attention grows with the context and 38 positions is not where that question
# gets settled.
#
# WHAT EACH IDEA ACTUALLY BOUGHT, against what I wrote down before the run:
#
#   rope angle table      1.79 -> 0.16 ms      predicted 1.7   ✓
#   attention on the pool     -15 / +0.33      predicted -5.7  ✗✗
#   contiguous scales      9.1 -> 8.5          predicted -4    ✗
#   130 ioctls dropped          about 0.2      predicted -1.5  ✗
#   pinning to the A72s         about 0.3      no prior
#
# Three of four were optimistic. The one that paid was the one where the work
# itself disappeared rather than moving.
#
# ---------------------------------------------------------------------------
# AND A 10.6 MS HOLE, IN EVERY ARM
# ---------------------------------------------------------------------------
#
# Sum the stage table's five NPU rows and subtract what npudev measures inside
# them and 10.6 ms a token is left over, in every arm of round 368. It is the
# work npudev does BEFORE its own timer starts: packing the activation.
#
# A token packs about 463 thousand halves -- every K slice of every projection,
# into both devices -- and it was doing it with a function call and two byte
# stores per element, out of a scratch buffer that had just been filled by a
# float copy per element, plus a double add per element for a grid that is off
# by default.
#
# ---------------------------------------------------------------------------
# WHAT CHANGED
# ---------------------------------------------------------------------------
#
#   1. THE HALF CONVERSION IS VECTORISED. ⚠ NOT with vcvt_f16_f32: that rounds
#      to nearest and this project's converter TRUNCATES, which is a different
#      number by up to 5e-4 relative -- four thousand times the gap that moved
#      a token in the SiLU experiment. It is hand written from the same shifts
#      and masks, and checked against the scalar one over 464 million float bit
#      patterns spanning the whole 32 bit space: zero differ. The packer as a
#      whole was then compared byte for byte at thirteen shapes including the
#      odd tails.
#   2. NO SCRATCH COPY. At m = 1 the packer reads src[kk], so it can be handed
#      the activation where it already lives. The running total it was also
#      computing belongs to the midrise grid, which is off by default and
#      measured worse when it was on.
#   3. THE SUM LANDS IN THE CALLER'S BUFFER. A grouped int4 tensor applies its
#      scale per slice on the way in, so the last step was y[i] = accf[i]: a
#      staging buffer written and read for nothing, half a megabyte a token on
#      the output head alone.
#   4. ATTENTION IS SERIAL AGAIN (above).
#   5. AND THE PACKING IS TIMED, so the hole stops being a subtraction. ⚠ The
#      new line is ON TOP of the hardware path, not inside it.
#
# CHARSIU_NPU_PLAIN puts 1, 2 and 3 back together. All three are provably
# neutral, so that control is not about whether they are right -- it is so a
# slower round can say which one did it, which is what round 368 taught.
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# THE SENTENCE FIRST. All three decode arms must be the Louvre sentence and
# must match each other. Nothing in this round is allowed to change a word:
# the packer is byte identical and the rest is where a number is stored.
#
# THEN THE NEW PACKING LINE, which is the whole point. It is the first direct
# measurement of a cost this project has only ever inferred.
#
# THEN THE FIVE NPU ROWS of the stage table against round 368's
# (q k v 12.24, o proj 9.56, gate + up 25.86, down 25.47, head 10.18 pinned).
# ⚠ Recompute the hole: those five rows, minus the hardware path, minus the
# new packing number. If packing is small AND the hole is still ten
# milliseconds, then packing was never the cost and it is somewhere I have not
# looked -- say so rather than reading the drop as a win.
# ⚠ And check the table total against the run's own generation time first, as
# ever.
#
# THEN ARM 2 AGAINST ARM 1, which is the A72 question asked cleanly this time:
# same build, serial attention in both, only the pin differs. Round 368 could
# only answer it by subtracting a flush.
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT
# ---------------------------------------------------------------------------
#
# Packing between 1 and 2 ms where the hole was 10.6, the five NPU rows down 5
# to 7 ms between them, and the run near 11.3 tok/s. The pin worth about 0.3 ms
# again, which would mean the CPU thread was never on a little core and that
# question can be closed.
#
# ⚠ I have been optimistic three rounds running. Read the control.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
VD=/opt/charsiu/charsiu_vendor
V=/opt/charsiu/vendor
RGC=$V/vendor-int4-k2048-n1024.regcmd
WT=$V/vendor-wt-1M.bin
IN=$V/vendor-in.bin
RUN=/opt/charsiu/charsiu_run
M8=/opt/charsiu/models/Llama-3.2-1B-Instruct-Q8_0.gguf
PROMPT="The capital of France is"
LIMIT=420
# 32 tokens does not reach the answer to "17 times 24, show your working"
NGEN=64
CE=CHARSIU_COEF_ELEMS=65536
HEAD=CHARSIU_NPU_MAXN=131072
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block did not come back this time."
		ABORT=1
	fi
}

capped() {
	lim="$1"; shift
	"$@" &
	pid=$!
	i=0
	while [ "$i" -lt "$lim" ]; do
		kill -0 "$pid" 2>/dev/null || { wait "$pid"; return $?; }
		sleep 1
		i=$((i + 1))
	done
	kill -9 "$pid" 2>/dev/null
	wait "$pid" 2>/dev/null
	return 124
}
rung() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $1"; return 0; }
	lbl="$1"; shift
	before=$(nbad)
	log ""
	log "  -- $lbl"
	sleep 1
	capped "$LIMIT" env "$@" "$RUN" "$M8" -p "$PROMPT" -n "${NGEN:-32}" \
		--ignore-eos -q -c 512 -t 4 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the rung exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This rung is VOID."; health; }
	return 0
}
# arm: <label> <regcmd-or-dash> <byte> <high> [extra env, one assignment]
#
# ⚠ THE ENV GOES IN AS AN ARGUMENT, not as a "VAR=x arm ..." prefix. Whether an
# assignment before a FUNCTION call survives the call is unspecified -- dash
# drops it, other shells keep it -- and the arm whose whole job is to time out
# WITHOUT the trailer runs right after the one that has it. Not a question worth
# leaving to the shell.
arm() {
	before=$(nbad)
	log ""
	log "  ---- $1"
	sleep 1
	env ${5:-IGNORED=1} $VD "$2" "$WT" "$IN" "$3" "$4" 4096 > /tmp/vd.txt 2>&1
	cat /tmp/vd.txt > "$C"
	after=$(nbad)
	if [ "$after" != "$before" ]; then
		log "  !! POISONED: $((after - before)) new fault or timeout lines"
		health
		# ⚠ NOT a round abort. Round 342 threw away every arm after the
		# first poisoning and then measured the block healthy at the
		# end. The block recovers; give it a moment and carry on.
		ABORT=0
		sleep 2
	fi
}

# two concurrent probes, so the pair can be repeated without copy and paste
pair() {
	before=$(nbad)
	log ""
	log "  ---- $1"
	env CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_TIME=60 CHARSIU_OUT_KB=64 $2 $VD - "$WT" "$IN" 0 0 4096 > /tmp/vdA.txt 2>&1 &
	pidA=$!
	env CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_TIME=60 CHARSIU_OUT_KB=64 $3 $VD - "$WT" "$IN" 0 0 4096 > /tmp/vdB.txt 2>&1 &
	pidB=$!
	wait "$pidA"
	wait "$pidB"
	log "    A:"
	grep -E "M = |TIME:|baseline:|VERIFY:|CONTROL repeat|VOID|REREAD" /tmp/vdA.txt > "$C"
	log "    B:"
	grep -E "M = |TIME:|baseline:|VERIFY:|CONTROL repeat|VOID|REREAD" /tmp/vdB.txt > "$C"
	after=$(nbad)
	[ "$after" != "$before" ] && log "  !! POISONED: $((after - before)) new lines"
	return 0
}

start() {
	log ""
	log "###############################################################"
	log "##### round 369: the 10.6 ms nobody had measured           #####"
	log "###############################################################"
	log "  attention is serial again. the packing is timed."

	log ""
	log "===== 1) everything on, where the scheduler puts it            ====="
	log "  read the PACKING line. the hole was 10.6 ms a token."
	rung "int4 g1024, two devices, stages" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 CHARSIU_NPU_W4V=1 CHARSIU_NPU_KMAX=1024 CHARSIU_NPU_W4_GROUP=1024 CHARSIU_STAGES=1 "$CE" "$HEAD"

	log ""
	log "===== 2) the same, pinned to the four A72s                     ====="
	log "  the A72 question asked cleanly: same build, serial"
	log "  attention in both, only the pin differs."
	rung "int4 g1024, CPUS=4-7" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 CHARSIU_NPU_W4V=1 CHARSIU_NPU_KMAX=1024 CHARSIU_NPU_W4_GROUP=1024 CHARSIU_STAGES=1 CHARSIU_CPUS=4-7 "$CE" "$HEAD"

	log ""
	log "===== 3) THE CONTROL: the scalar packer, the scratch copy,     ====="
	log "=====    and the staging accumulator, all three back          ====="
	log "  same pin as arm 2, so the pair differ in one thing."
	rung "int4 g1024, CPUS=4-7, NPU_PLAIN" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 CHARSIU_NPU_W4V=1 CHARSIU_NPU_KMAX=1024 CHARSIU_NPU_W4_GROUP=1024 CHARSIU_STAGES=1 CHARSIU_CPUS=4-7 CHARSIU_NPU_PLAIN=1 "$CE" "$HEAD"

	log ""
	log "===== 4) the probe, still exact                                ====="
	arm "solo verify" "-" 0 0 "CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_VERIFY=1 CHARSIU_OUT_KB=64"

	log ""
	log "===== 5) the anchor: int8 conv must still be exact            ====="
	health

	log ""
	log "===== read the CONTROL lines first. VOID means the arm died. ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
