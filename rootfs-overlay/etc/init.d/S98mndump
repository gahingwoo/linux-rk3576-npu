#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-23 round 358. THE SECOND NPU CORE HAS BEEN IDLE THE WHOLE TIME.
#
# ⛔ ROUND 357'S MAIN ARMS COULD NOT ANSWER, AND THAT WAS MY FAULT. The merge
# carries the vendor's M = 32 geometry and I ran it at M = 1: entry 7's verify
# says 8 of 1024. Round 347 had already measured exactly that and I had written
# it down. Entries 2, 3 and 5 are void.
#
# What survives is one clean negative and one number:
#
#   the five at 0x2810   270.1 us against a 275.9 baseline, controls clean
#                        -> they do NOTHING for speed
#   int8 at the shape    374.1 us for 2 MiB against int4's 275.9 for 1 MiB
#
# ⚠ AND ROUND 357'S PREMISE IS RETRACTED. I argued that 620 MB a token at 6.7
# GB/s is 92 ms and therefore the decode is bandwidth bound. **6.7 GB/s was
# computed by dividing those bytes by that time.** Circular, and it proved
# nothing.
#
# The marginal fit over round 351's four points, which is not circular:
#
#     per element   int4 61 ns      int8 79.5 ns
#     solving       compute 42.5 ns an element, fetch 37 ns a byte an element
#     check         42.5 + 0.5*37 = 61  ✓
#
# 🔑 **int4 is already getting the entire byte saving it is entitled to.** About
# 53% of the marginal cost is COMPUTE, so 2x was never on the table and no
# register was going to find it. The way out is not more int4.
#
# ---------------------------------------------------------------------------
# THE THING THAT HAS BEEN SITTING THERE ALL ALONG
# ---------------------------------------------------------------------------
#
#     rocket 27700000.npu: Rockchip NPU core 0 version: 1179210311
#
# One line, one core. rk3576.dtsi carries rknn_core_0 at 0x27700000 AND
# rknn_core_1 at 0x27708000, both `status = "disabled"`, and this board's dts
# has only ever turned on core 0. **Every charsiu decode ever measured has used
# half of this chip.**
#
# This round turns core 1 on. Six lines of dts and not a line of charsiu.
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# ENTRY 0 IS THE WHOLE POINT AND IT IS ONE LINE OF dmesg. rocket must now print
# a core 1 as well as a core 0. If it does not, the rest is noise and the
# question becomes why it did not probe.
#
# ENTRY 2 RUNS TWO JOB STREAMS AT ONCE in separate processes, which means
# separate DRM files and so separate scheduler entities. rocket initialises each
# file's entity with the list of EVERY core, so two entities can sit on two
# cores where one entity cannot.
#
#   both still near 275 us  -> the cores are genuinely parallel, and charsiu's
#                              decode has a factor of two waiting inside it
#   both near 550 us        -> they are sharing one core and turning on the
#                              second changed nothing that matters
#
# That is the entire question and it needs no charsiu change to answer.
#
# ENTRY 3 runs the decode itself, which should NOT move -- charsiu still opens
# one device and waits on every submit, so a second core cannot help it yet.
# If it moves anyway, something about the scheduling is not what I think.
#
# ENTRY 4 is the anchor. A second core and a second IOMMU is exactly the kind
# of change that breaks the first one.
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT
# ---------------------------------------------------------------------------
#
# It probes. Whether two processes then land on two cores I do not know:
# drm_sched load balances across the scheduler list, but nothing here has ever
# exercised that, and the dtsi chains both power domains into both cores in
# opposite order for reasons nobody has written down.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
VD=/opt/charsiu/charsiu_vendor
V=/opt/charsiu/vendor
RGC=$V/vendor-int4-k2048-n1024.regcmd
WT=$V/vendor-wt-1M.bin
IN=$V/vendor-in.bin
RUN=/opt/charsiu/charsiu_run
M8=/opt/charsiu/models/Llama-3.2-1B-Instruct-Q8_0.gguf
PROMPT="The capital of France is"
LIMIT=420
# 32 tokens does not reach the answer to "17 times 24, show your working"
NGEN=64
CE=CHARSIU_COEF_ELEMS=65536
HEAD=CHARSIU_NPU_MAXN=131072
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block did not come back this time."
		ABORT=1
	fi
}

capped() {
	lim="$1"; shift
	"$@" &
	pid=$!
	i=0
	while [ "$i" -lt "$lim" ]; do
		kill -0 "$pid" 2>/dev/null || { wait "$pid"; return $?; }
		sleep 1
		i=$((i + 1))
	done
	kill -9 "$pid" 2>/dev/null
	wait "$pid" 2>/dev/null
	return 124
}
rung() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $1"; return 0; }
	lbl="$1"; shift
	before=$(nbad)
	log ""
	log "  -- $lbl"
	sleep 1
	capped "$LIMIT" env "$@" "$RUN" "$M8" -p "$PROMPT" -n "${NGEN:-32}" \
		--ignore-eos -q -c 512 -t 4 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the rung exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This rung is VOID."; health; }
	return 0
}
# arm: <label> <regcmd-or-dash> <byte> <high> [extra env, one assignment]
#
# ⚠ THE ENV GOES IN AS AN ARGUMENT, not as a "VAR=x arm ..." prefix. Whether an
# assignment before a FUNCTION call survives the call is unspecified -- dash
# drops it, other shells keep it -- and the arm whose whole job is to time out
# WITHOUT the trailer runs right after the one that has it. Not a question worth
# leaving to the shell.
arm() {
	before=$(nbad)
	log ""
	log "  ---- $1"
	sleep 1
	env ${5:-IGNORED=1} $VD "$2" "$WT" "$IN" "$3" "$4" 4096 > /tmp/vd.txt 2>&1
	cat /tmp/vd.txt > "$C"
	after=$(nbad)
	if [ "$after" != "$before" ]; then
		log "  !! POISONED: $((after - before)) new fault or timeout lines"
		health
		# ⚠ NOT a round abort. Round 342 threw away every arm after the
		# first poisoning and then measured the block healthy at the
		# end. The block recovers; give it a moment and carry on.
		ABORT=0
		sleep 2
	fi
}

start() {
	log ""
	log "###############################################################"
	log "##### round 358: the second NPU core has been idle the whole time #####"
	log "###############################################################"
	log "  int4 is byte exact and 1.42 to 1.78x faster. now decode with it."

	log ""
	log "===== 0) DOES ROCKET SEE TWO CORES NOW                        ====="
	dmesg 2>/dev/null | grep -i "NPU core" > "$C"
	n=$(dmesg 2>/dev/null | grep -ci "NPU core")
	log "  -> $n core line(s). anything but 2 and the rest is noise."

	log ""
	log "===== 1) one job stream alone. the 275.9 us baseline.         ====="
	arm "int4, alone" "-" 0 0 "CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_TIME=200 CHARSIU_OUT_KB=64"

	log ""
	log "===== 2) TWO AT ONCE, separate processes and so separate      ====="
	log "  scheduler entities. near 275 each means two real cores;"
	log "  near 550 each means they are sharing one."
	before=$(nbad)
	env CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_TIME=200 CHARSIU_OUT_KB=64 \
		$VD - "$WT" "$IN" 0 0 4096 > /tmp/vdA.txt 2>&1 &
	pidA=$!
	env CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_TIME=200 CHARSIU_OUT_KB=64 \
		$VD - "$WT" "$IN" 0 0 4096 > /tmp/vdB.txt 2>&1 &
	pidB=$!
	wait "$pidA"
	wait "$pidB"
	log "  -- process A"
	grep -E "TIME:|CONTROL repeat|VOID" /tmp/vdA.txt > "$C"
	log "  -- process B"
	grep -E "TIME:|CONTROL repeat|VOID" /tmp/vdB.txt > "$C"
	after=$(nbad)
	[ "$after" != "$before" ] && log "  !! POISONED: $((after - before)) new lines"

	log ""
	log "===== 3) and the int4 decode itself, in case it moved         ====="
	rung "int4 g1024 decode" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 CHARSIU_NPU_W4V=1 \
		CHARSIU_NPU_KMAX=1024 CHARSIU_NPU_W4_GROUP=1024 "$CE" "$HEAD"

	log ""
	log "===== 4) the anchor: int8 conv must still be exact            ====="
	health

	log ""
	log "===== read the CONTROL lines first. VOID means the arm died. ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
