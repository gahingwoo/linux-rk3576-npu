#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-23 round 362. TWO CORES, ONE CBUF CONFIGURATION.
#
# 🔑 ROUND 361 IS AS CLEAN A SPLIT AS THIS PROJECT HAS PRODUCED, and it refutes
# my hypothesis rather than confirming it.
#
#   ONE core, a pair of processes, three times   6 of 6 CLEAN, 0 words differ
#   rebind core 1, SAME BOOT, same binaries      3 of 4 CORRUPT: 183, 113, 281
#                                                and one baseline at 1022 live
#
# ⛔ **The domain switching theory is dead**, and it died on its own strongest
# case: two processes on ONE core put TWO domains on the SAME iommu, taking
# turns every job, which is the most stress that theory could ask for. Six for
# six clean.
#
# 🔑 **So the second core is the variable. Two NPU cores interfere in hardware.**
#
# ---------------------------------------------------------------------------
# WHAT POINTS AT THE CBUF
# ---------------------------------------------------------------------------
#
# rocket's own uapi says a job's tasks run "sequentially on the same core, to
# benefit from memory residency in SRAM". The cores have SRAM, the driver keeps
# a job on one core because of it, and NOTHING partitions it between the two.
#
# And the vendor's capture has the same op prepared for both cores. The two
# streams differ in exactly seven entries and every one is CBUF:
#
#            task 16 (core 0)   task 17 (core 1)
#   0x1038     00000007           0000010e
#   0x1018     40000404           4000040b
#   0x103c     08000000           08001c00
#   0x1040     10000000           2c001c00
#   0x2818     00000000           1c000000
#   0x2820     00000000           00000038
#
# 0x1c00 is 7168 and reads like a base offset: each core is told where ITS part
# of the buffer begins. **charsiu gives both cores the same configuration**, so
# they use the same part.
#
# The five at 0x2810 are emitted natively now, all zero, which is what the
# vendor writes on core 0 -- so nothing changes today and they can finally be
# overridden. Round 357 measured inserting them at 270.1 us against 275.9.
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# ⚠ NOTHING HERE CHOOSES WHICH CORE A PROCESS LANDS ON. The uapi has no such
# field and the scheduler decides. So entry 3 gives ONE of the two processes the
# vendor's core 1 CBUF values and hopes the scheduler separates them, which it
# has no obligation to do. That makes entry 3 suggestive at best:
#
#   corruption clearly drops -> the CBUF configuration is the variable and the
#       real fix is per core streams, which needs a core field in the uapi
#   no change -> either the scheduler did not separate them, or the CBUF is not
#       it. **This arm cannot tell those apart**, which is why entry 4 exists.
#
# ENTRY 4 gives BOTH processes core 1's values. If matching the core is what
# matters, this should be as bad as entry 2 or worse. If it is BETTER, then it
# is not about matching a core and something in those values is simply kinder.
#
# ENTRY 1 is the one core control and must be clean again; entry 2 is two cores
# unchanged and must reproduce.
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT
# ---------------------------------------------------------------------------
#
# Honestly, not much from entry 3: a coin flip on core assignment halves
# whatever signal is there. The value of this round is entry 4 and the
# reproduction. My last three predictions were wrong and I am not going to
# dress this one up.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
VD=/opt/charsiu/charsiu_vendor
V=/opt/charsiu/vendor
RGC=$V/vendor-int4-k2048-n1024.regcmd
WT=$V/vendor-wt-1M.bin
IN=$V/vendor-in.bin
RUN=/opt/charsiu/charsiu_run
M8=/opt/charsiu/models/Llama-3.2-1B-Instruct-Q8_0.gguf
PROMPT="The capital of France is"
LIMIT=420
# 32 tokens does not reach the answer to "17 times 24, show your working"
NGEN=64
CE=CHARSIU_COEF_ELEMS=65536
HEAD=CHARSIU_NPU_MAXN=131072
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block did not come back this time."
		ABORT=1
	fi
}

capped() {
	lim="$1"; shift
	"$@" &
	pid=$!
	i=0
	while [ "$i" -lt "$lim" ]; do
		kill -0 "$pid" 2>/dev/null || { wait "$pid"; return $?; }
		sleep 1
		i=$((i + 1))
	done
	kill -9 "$pid" 2>/dev/null
	wait "$pid" 2>/dev/null
	return 124
}
rung() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $1"; return 0; }
	lbl="$1"; shift
	before=$(nbad)
	log ""
	log "  -- $lbl"
	sleep 1
	capped "$LIMIT" env "$@" "$RUN" "$M8" -p "$PROMPT" -n "${NGEN:-32}" \
		--ignore-eos -q -c 512 -t 4 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the rung exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This rung is VOID."; health; }
	return 0
}
# arm: <label> <regcmd-or-dash> <byte> <high> [extra env, one assignment]
#
# ⚠ THE ENV GOES IN AS AN ARGUMENT, not as a "VAR=x arm ..." prefix. Whether an
# assignment before a FUNCTION call survives the call is unspecified -- dash
# drops it, other shells keep it -- and the arm whose whole job is to time out
# WITHOUT the trailer runs right after the one that has it. Not a question worth
# leaving to the shell.
arm() {
	before=$(nbad)
	log ""
	log "  ---- $1"
	sleep 1
	env ${5:-IGNORED=1} $VD "$2" "$WT" "$IN" "$3" "$4" 4096 > /tmp/vd.txt 2>&1
	cat /tmp/vd.txt > "$C"
	after=$(nbad)
	if [ "$after" != "$before" ]; then
		log "  !! POISONED: $((after - before)) new fault or timeout lines"
		health
		# ⚠ NOT a round abort. Round 342 threw away every arm after the
		# first poisoning and then measured the block healthy at the
		# end. The block recovers; give it a moment and carry on.
		ABORT=0
		sleep 2
	fi
}

# two concurrent probes, so the pair can be repeated without copy and paste
pair() {
	before=$(nbad)
	log ""
	log "  ---- $1"
	env CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_TIME=60 CHARSIU_OUT_KB=64 $2 $VD - "$WT" "$IN" 0 0 4096 > /tmp/vdA.txt 2>&1 &
	pidA=$!
	env CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_TIME=60 CHARSIU_OUT_KB=64 $3 $VD - "$WT" "$IN" 0 0 4096 > /tmp/vdB.txt 2>&1 &
	pidB=$!
	wait "$pidA"
	wait "$pidB"
	log "    A:"
	grep -E "M = |TIME:|baseline:|CONTROL repeat|VOID|REREAD" /tmp/vdA.txt > "$C"
	log "    B:"
	grep -E "M = |TIME:|baseline:|CONTROL repeat|VOID|REREAD" /tmp/vdB.txt > "$C"
	after=$(nbad)
	[ "$after" != "$before" ] && log "  !! POISONED: $((after - before)) new lines"
	return 0
}

start() {
	log ""
	log "###############################################################"
	log "##### round 362: two cores, one CBUF configuration           #####"
	log "###############################################################"
	log "  int4 is byte exact and 1.42 to 1.78x faster. now decode with it."

	log ""
	log "===== 1) CONTROL: a pair on ONE core. must be clean again.     ====="
	dmesg 2>/dev/null | grep -i "NPU core" > "$C"
	echo 27708000.npu > /sys/bus/platform/drivers/rocket/unbind 2>/dev/null \
		|| log "  !! unbind failed; this round is void"
	sleep 1
	ls /sys/bus/platform/drivers/rocket/ 2>/dev/null | grep npu > "$C"
	pair "pair, one core" "" ""

	log ""
	log "===== 2) rebind. two cores, unchanged. must reproduce.         ====="
	echo 27708000.npu > /sys/bus/platform/drivers/rocket/bind 2>/dev/null
	sleep 1
	ls /sys/bus/platform/drivers/rocket/ 2>/dev/null | grep npu > "$C"
	pair "pair, two cores 1" "" ""
	pair "pair, two cores 2" "" ""

	log ""
	log "===== 3) B carries the vendor's CORE 1 CBUF values             ====="
	log "  suggestive only: nothing here picks which core B runs on."
	pair "pair, B core-1 cbuf 1" "" "CHARSIU_OVERRIDE=0x1038=0x0000010e,0x1018=0x4000040b,0x103c=0x08001c00,0x1040=0x2c001c00,0x2818=0x1c000000,0x2820=0x00000038"
	pair "pair, B core-1 cbuf 2" "" "CHARSIU_OVERRIDE=0x1038=0x0000010e,0x1018=0x4000040b,0x103c=0x08001c00,0x1040=0x2c001c00,0x2818=0x1c000000,0x2820=0x00000038"

	log ""
	log "===== 4) BOTH carry core 1's values. the control for entry 3.  ====="
	log "  as bad as entry 2 means matching a core is what matters."
	log "  better means those values are simply kinder, core or not."
	pair "pair, both core-1 cbuf 1" "CHARSIU_OVERRIDE=0x1038=0x0000010e,0x1018=0x4000040b,0x103c=0x08001c00,0x1040=0x2c001c00,0x2818=0x1c000000,0x2820=0x00000038" "CHARSIU_OVERRIDE=0x1038=0x0000010e,0x1018=0x4000040b,0x103c=0x08001c00,0x1040=0x2c001c00,0x2818=0x1c000000,0x2820=0x00000038"
	pair "pair, both core-1 cbuf 2" "CHARSIU_OVERRIDE=0x1038=0x0000010e,0x1018=0x4000040b,0x103c=0x08001c00,0x1040=0x2c001c00,0x2818=0x1c000000,0x2820=0x00000038" "CHARSIU_OVERRIDE=0x1038=0x0000010e,0x1018=0x4000040b,0x103c=0x08001c00,0x1040=0x2c001c00,0x2818=0x1c000000,0x2820=0x00000038"

	log ""
	log "===== 5) the anchor: int8 conv must still be exact            ====="
	health

	log ""
	log "===== read the CONTROL lines first. VOID means the arm died. ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
