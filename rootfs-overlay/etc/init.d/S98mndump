# ---------------------------------------------------------------------------
# 2026-08-21 round 288. Eight geometries at once, and the third closed form.
#
# ⚠⚠ 287 CLOSED int4 AT M = 1. All eight exact in one boot, no override, no
# CHARSIU_OVERRIDE anywhere in the script:
#
#   N = 16 16/16   N = 24 24/24   N = 32 32/32   N = 40 40/40
#   N = 48 48/48   N = 56 56/56   N = 64 64/64   N = 64 K=32 64/64
#   control 0 of 64, int8 64 of 64
#
# Every one of those had been exact at some point in the previous three rounds
# and never all at once, which is what the round was for.
#
# ⚠ AND G = 9 MADE THE IRREGULAR PART FALL OUT. N = 72 swept clean, 72 channels
# written with 0x3020 at 143, and with a ninth table the slot patterns stop
# being a list. Written as flat slot indices, block times 8 plus slot:
#
#   G=2  0 1              G=3  0 2 3
#   G=4  0 2 8 9          G=5  0 2 8 9 11
#   G=6  0 2 8 10 16 17   G=7  0 2 8 10 11 17 19
#   G=8  0 2 8 10 16 18 24 25
#   G=9  0 2 8 10 16 17 19 25 27
#
#   EVEN G  pairs at slots 0 and 2 in every block but the last, which takes 0
#           and 1. Four points and no exceptions.
#   ODD G   one block of three at b3 = (G-1)/4, slots 0 and 2 before it, 1 and
#           3 after it, and the three itself {0,2,3} when G mod 4 is 3 and
#           {0,1,3} when it is 1.
#
# ⚠ THIS IS THE THIRD CLOSED FORM WRITTEN FOR THIS LAYOUT. The first two died
# in the round after they were written: wbytes/4 in 284, which also broke three
# working geometries, and "the last block takes the odd slots" in 286, which put
# g4 of N = 56 at 1024 where --map found it at 704. Both were fitted to a single
# point. This one has eight tables behind it, with four points on the even arm,
# four on b3, and two on each arm of the mod 4. That is better and it is not
# proof, and the way to find out is the two G it predicts outright.
#
# THE READING RULE, fixed before the run.
#
#   ⚠ ENTRIES 9 AND 10 ARE THE ROUND. N = 80 and N = 88, G = 10 and G = 11,
#   neither swept and both predicted:
#
#     G=10  0 2 8 10 16 18 24 26 32 33   bases 0 128 512 640 1024 1152 1536
#                                              1664 2048 2112
#     G=11  0 2 8 10 16 18 19 25 27 33 35
#
#     both exact          the form is read across ten geometries and int4 is
#                         closed for any N that is a multiple of 8
#     one exact           the arm that failed is the one still fitted, and the
#                         --map grid beside it says what it should have been
#     neither             back to the table, which is measured and refuses
#                         outside itself
#
#   ENTRY 8 is N = 72 as a matmul rather than a sweep, which the table could not
#   do before and the form can.
#
#   ⚠ ENTRIES 2 TO 7 ARE THE REGRESSION. The addressing was replaced again, for
#   the third time in five rounds, and 284 broke three working geometries with
#   one line.
#
#   ENTRIES 11 AND 12 sweep --map at N = 80 and 88 in the same boot, so a miss
#   is diagnosable without spending another round on it. That is what saved 286.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
MM=/opt/charsiu/charsiu_matmul
CH=/opt/charsiu/charsiu_int4
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

c() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $*"; return 0; }
	before=$(nbad)
	sleep 1
	env $1 $2 $3 $4 $5 $6 $7 $8 $9 > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This arm is VOID."; health; }
	return 0
}

M4="CHARSIU_W4=1 CHARSIU_W4_HALFK=1"

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	if [ -w /sys/module/rocket/parameters/reset_autosuspend ]; then
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend
		log "reset_autosuspend = $(cat /sys/module/rocket/parameters/reset_autosuspend)"
	else
		log "!! reset_autosuspend NOT WRITABLE. A timeout will kill the round."
	fi

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "##### the regression. addressing replaced for the third time.      #####"
	for nn in 16 24 32 40 48 56 64
	do
		log ""
		log "===== N = $nn  K = 64"
		c "$M4" X=1 $MM 1 64 $nn
	done
	log ""
	log "===== N = 64  K = 32                                               ====="
	c "$M4" X=1 $MM 1 32 64

	log ""
	log "##### the new ones. 72 was swept, 80 and 88 are predicted.         #####"
	log ""
	log "===== 8) N = 72, G = 9. Swept in 287, never run as a matmul.       ====="
	c "$M4" X=1 $MM 1 64 72
	log ""
	log "===== 9) N = 80, G = 10. PREDICTED, never swept.                   ====="
	c "$M4" X=1 $MM 1 64 80
	log ""
	log "===== 10) N = 88, G = 11. PREDICTED, never swept.                  ====="
	c "$M4" X=1 $MM 1 64 88

	log ""
	log "===== the control that must FAIL, and int8                         ====="
	c "CHARSIU_W4=1" X=1 $MM 1 64 64
	c X=1 X=1 $MM 1 64 64

	log ""
	log "##### and the grids, so a miss above is readable in this boot      #####"
	log ""
	log "===== 11) --map at N = 80                                          ====="
	c X=1 X=1 $CH 1 64 80 --map 8
	log ""
	log "===== 12) --map at N = 88                                          ====="
	c X=1 X=1 $CH 1 64 88 --map 8

	log ""
	log "===== the anchor again                                             ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== 80 and 88 exact would make it any N that is a multiple of 8. ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
