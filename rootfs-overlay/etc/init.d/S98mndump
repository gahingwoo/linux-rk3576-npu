#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-23 round 356. THE LOAD, AND FOUR PROMPTS.
#
# ⚠ FIRST, THE LOAD IS NOT AN int4 PROBLEM. Round 355's two columns:
#
#   int4 group 1024   20.3 s = 4.3 adding + 16.0 quantising
#   int8              18.4 s = 8.9 adding +  9.5 quantising
#
# **int8 takes 18 seconds too.** The vendor is fast because a .rkllm holds
# weights that are ALREADY quantised and ALREADY laid out -- they mmap and DMA.
# charsiu dequantises 1.24 billion Q8_0 weights to float and re-quantises them
# at every start. That is an architectural difference, not a bug.
#
# WHAT WAS FIXED, measured on the host over 440 million real weights with three
# repeats each rather than guessed:
#
#   int4, before          3.37 ns a weight
#   int4, one pass        2.2  ns          <- this round
#   int8                  1.85 ns
#   of which dequant      0.32 ns          (15%, so NOT the bottleneck)
#
# The int4 branch walked each group a SECOND time to find the signed value of
# largest magnitude, calling fabsf on the running maximum every iteration too.
# The first pass now carries the signed extreme with it. **The generated text is
# byte identical before and after, checked end to end on the host with the real
# model** -- only the timing line differs.
#
# ⚠ AND ONE GUESS OF MINE MEASURED AS WRONG, AGAIN. I wrote that the per weight
# error accounting "costs a third of the load". Three repeats say 3.37 ns
# against 3.46: it costs 3%. The comment is corrected in the source. It is
# behind CHARSIU_NPU_RMS now anyway, because nothing in the decode reads it.
#
# ⛔ WHAT IS LEFT IS INHERENT. About 10 s of quantising, and the only thing that
# removes it is a CACHE: quantise once, write q and the scales, mmap after.
# That is what the vendor's file IS. It costs 620 MB on the card and a new
# format, so it is a feature and not a patch, and it is not in this round.
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# ⚠ ENTRY 0 NO LONGER DECIDES ANYTHING -- it is kept because it characterises
# the test rig, not because it settles the design. The card's bandwidth stopped
# mattering the moment the deployment target turned out to be a PCIe SSD, where
# 596 MB reads in about a second against 10 s of quantising.
#
# THE CACHE IS BUILT AND HOST VERIFIED, and it is NOT in this round on purpose:
# writing 596 MB on the first rung and reading it on every rung after would
# destroy the very measurement this round is for. It also does not fit in the
# 3.5 GiB rootfs beside 2.7 GB of models, and growing that needs host disk this
# machine does not have at 98% full.
#
#   charsiu_run --cache, on the host, with the real model:
#     cold, writes   prompt 4886 ms, wall 5.64 s, cache 596 MB
#     warm, reads    prompt 1188 ms, wall 1.90 s
#     the generated text is IDENTICAL, and peak RSS falls 2497 to 1363 MB
#
#   All five staleness guards behave: the model's mtime, the group size and the
#   bit width each force a rebuild, a settled cache reads back, and without
#   --cache nothing is written at all.
#
# ORIGINAL NOTE, kept because the inference in it is still how the card was
# characterised without measuring it: A weight cache -- quantise once,
# write the PACKED bytes, mmap after -- would take the load from 20 s to the
# time it takes to read 620 MB plus the 4.3 s of copying into buffer objects,
# and the user never converts anything: the first run is what it is today and
# writes a sidecar. Whether that is worth building depends entirely on what the
# card reads at. Two inferences already point at "yes": the quantising column
# FALLS across a boot (143978, 131547, 114571 in round 354; 16036 then 10659 in
# 355) which is the page cache warming and says CPU is about 80% of it, and the
# 18 s staging already reads the whole 1.3 GB gguf, which puts the card at 72
# MB/s or better. Entry 0 measures it instead of inferring it. Below about 70
# MB/s the cache is not worth building.
#
# THE QUANTISING COLUMN should fall from 16.0 s to about 10, and int8's 9.5
# must NOT move -- int8 never took the second pass, so it is the control for
# this change as it was for the getenv hoist.
#
# **8.96 tok/s and the Louvre sentence must not move either.** The host says the
# text is byte identical; the board is where that gets to be true.
#
# THEN THE ACCURACY, which two sentences have never established. Four prompts,
# chosen to fail differently rather than to agree:
#
#   1  the standing one, comparable with every round before this
#   2  an explanation, where being wrong is visible
#   3  code, where being wrong is unambiguous
#   4  arithmetic, which is what a narrow quantiser fails first
#
# Each on int4 group 1024 and on the CPU. Sampling is greedy already, so a
# divergence is the model changing its mind and not a die roll. 64 tokens,
# because 32 does not reach the answer to "17 times 24".
#
# ⚠ Word for word agreement with the CPU is NOT the bar. int8 is the arm that
# matches the CPU exactly; four bit weights are four bit weights. The bar is
# whether int4 says something TRUE and stops circling.
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT
# ---------------------------------------------------------------------------
#
# Quantising near 10 s, everything else unchanged. On the prompts: 1 and 2 fine,
# and code is the one I would bet against -- a wrong token in a Python function
# is not a paraphrase. If 3 or 4 fail while 1 and 2 look fine, the honest
# summary is "good for prose, not yet for code", and the next thing is GPTQ
# rather than a smaller group.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
VD=/opt/charsiu/charsiu_vendor
V=/opt/charsiu/vendor
RGC=$V/vendor-int4-k2048-n1024.regcmd
WT=$V/vendor-wt-1M.bin
IN=$V/vendor-in.bin
RUN=/opt/charsiu/charsiu_run
M8=/opt/charsiu/models/Llama-3.2-1B-Instruct-Q8_0.gguf
PROMPT="The capital of France is"
LIMIT=420
# 32 tokens does not reach the answer to "17 times 24, show your working"
NGEN=64
CE=CHARSIU_COEF_ELEMS=65536
HEAD=CHARSIU_NPU_MAXN=131072
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block did not come back this time."
		ABORT=1
	fi
}

capped() {
	lim="$1"; shift
	"$@" &
	pid=$!
	i=0
	while [ "$i" -lt "$lim" ]; do
		kill -0 "$pid" 2>/dev/null || { wait "$pid"; return $?; }
		sleep 1
		i=$((i + 1))
	done
	kill -9 "$pid" 2>/dev/null
	wait "$pid" 2>/dev/null
	return 124
}
rung() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $1"; return 0; }
	lbl="$1"; shift
	before=$(nbad)
	log ""
	log "  -- $lbl"
	sleep 1
	capped "$LIMIT" env "$@" "$RUN" "$M8" -p "$PROMPT" -n "${NGEN:-32}" \
		--ignore-eos -q -c 512 -t 4 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the rung exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This rung is VOID."; health; }
	return 0
}
# arm: <label> <regcmd-or-dash> <byte> <high> [extra env, one assignment]
#
# ⚠ THE ENV GOES IN AS AN ARGUMENT, not as a "VAR=x arm ..." prefix. Whether an
# assignment before a FUNCTION call survives the call is unspecified -- dash
# drops it, other shells keep it -- and the arm whose whole job is to time out
# WITHOUT the trailer runs right after the one that has it. Not a question worth
# leaving to the shell.
arm() {
	before=$(nbad)
	log ""
	log "  ---- $1"
	sleep 1
	env ${5:-IGNORED=1} $VD "$2" "$WT" "$IN" "$3" "$4" 4096 > /tmp/vd.txt 2>&1
	cat /tmp/vd.txt > "$C"
	after=$(nbad)
	if [ "$after" != "$before" ]; then
		log "  !! POISONED: $((after - before)) new fault or timeout lines"
		health
		# ⚠ NOT a round abort. Round 342 threw away every arm after the
		# first poisoning and then measured the block healthy at the
		# end. The block recovers; give it a moment and carry on.
		ABORT=0
		sleep 2
	fi
}

start() {
	log ""
	log "###############################################################"
	log "##### round 356: four prompts, because two are not a measurement #####"
	log "###############################################################"
	log "  int4 is byte exact and 1.42 to 1.78x faster. now decode with it."

	log ""
	log "===== 0) WHAT THE CARD ACTUALLY READS AT                       ====="
	log "  the whole weight cache question turns on this one number."
	log "  a packed cache would be 620 MB; below about 70 MB/s reading"
	log "  it back is no faster than re-quantising and the cache is not"
	log "  worth building."
	sync
	echo 3 > /proc/sys/vm/drop_caches 2>/dev/null || \
		log "  (could not drop caches; the figure below will be warm)"
	log "  -- cold, 512 MB of the model file"
	dd if=/opt/charsiu/models/Llama-3.2-1B-Instruct-Q8_0.gguf \
		of=/dev/null bs=1M count=512 2>&1 | tail -1 > "$C"
	log "  -- warm, the same 512 MB again"
	dd if=/opt/charsiu/models/Llama-3.2-1B-Instruct-Q8_0.gguf \
		of=/dev/null bs=1M count=512 2>&1 | tail -1 > "$C"

	log ""
	log "===== 1) the standing one                    ====="
	PROMPT="The capital of France is"
	rung "int4 g1024: the standing one" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 CHARSIU_NPU_W4V=1 CHARSIU_NPU_KMAX=1024 CHARSIU_NPU_W4_GROUP=1024 "$CE" "$HEAD"
	rung "cpu:       the standing one" CHARSIU_NO_NPU=1
	log ""
	log "===== 2) an explanation                    ====="
	PROMPT="Explain in one paragraph why the sky is blue"
	rung "int4 g1024: an explanation" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 CHARSIU_NPU_W4V=1 CHARSIU_NPU_KMAX=1024 CHARSIU_NPU_W4_GROUP=1024 "$CE" "$HEAD"
	rung "cpu:       an explanation" CHARSIU_NO_NPU=1
	log ""
	log "===== 3) code                    ====="
	PROMPT="Write a Python function that reverses a string:"
	rung "int4 g1024: code" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 CHARSIU_NPU_W4V=1 CHARSIU_NPU_KMAX=1024 CHARSIU_NPU_W4_GROUP=1024 "$CE" "$HEAD"
	rung "cpu:       code" CHARSIU_NO_NPU=1
	log ""
	log "===== 4) arithmetic                    ====="
	PROMPT="What is 17 times 24? Show your working."
	rung "int4 g1024: arithmetic" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 CHARSIU_NPU_W4V=1 CHARSIU_NPU_KMAX=1024 CHARSIU_NPU_W4_GROUP=1024 "$CE" "$HEAD"
	rung "cpu:       arithmetic" CHARSIU_NO_NPU=1

	log ""
	log "===== 5) CONTROL: int8 on prompt 1. the standing sentence.    ====="
	PROMPT="The capital of France is"
	rung "int8, the standing number" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 "$CE" "$HEAD"

	log ""
	log "===== 6) the anchor: int8 conv must still be exact           ====="
	health

	log ""
	log "===== read the CONTROL lines first. VOID means the arm died. ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
