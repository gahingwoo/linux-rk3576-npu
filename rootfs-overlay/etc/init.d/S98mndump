#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-21 round 298. K has only ever been 32 or 64, and an LLM wants
# thousands.
#
# ⚠ M > 1 IS CLOSED WITH A NEGATIVE. 297's sweep had its own controls and both
# held: g = 8 came back 16 of 32 and g = 64 came back 0 of 32, so the rewrite
# generalised the shipped path rather than changing it. Every other granularity,
# 1, 2, 4, 16, 32 and 64, is 0 of 32.
#
# So after SIX registers and NINE packings, M > 1 does not work. The hardware
# computes M rows and feeds every one of them from row 0's activation, and
# nothing that carries m and no arrangement of the activation buffer moves that.
# g = 32's row 1 map lights 16 of 16 and still computes wrong, which is the same
# shape all three register arms had.
#
# ⚠ AND IT DOES NOT BLOCK THE PROJECT. charsiu exists to decode LLM tokens, one
# at a time, which is M = 1, and int4 at M = 1 is exact across eleven geometries.
# M > 1 is a chaining problem: run M jobs. Recorded as a negative and left.
#
# ⚠ WHAT DOES BLOCK IT IS K. Every int4 measurement in this project is at K = 32
# or K = 64. A projection in a small model is K = 2048 by N = 1024. The packer
# refuses everything else, deliberately, and the bench has no int4 path at all,
# so "what does int4 buy" cannot be asked yet.
#
# The skeleton is K independent everywhere it has been checked: the slot table by
# group count reproduces K = 32 and K = 64 alike, and only the block stride 8*K
# and the k+ offset 4*K scale with it. So K = 128 and 256 are allowed now as a
# PREDICTION and refused above that.
#
#   K = 128  bases 0 128 1024 1152 2048 2176 3072 3136, k+ at +512
#   K = 256  bases 0 128 2048 2176 4096 4224 6144 6208, k+ at +1024
#
# THE READING RULE, fixed before the run.
#
#   ⚠ ENTRIES 4 AND 5 ARE THE ROUND: --map at K = 128 and K = 256, N = 64.
#
#     the bases land            the block stride really is 8*K and the layout
#                               scales, which is what an LLM shape needs
#     the bases land but the
#     k+ group does not         the stride scales and the half offset does not,
#                               and the grid says what it is instead
#     something else            K = 32 and 64 were two points of something that
#                               is not linear in K, and the grid is the data
#
#   ENTRIES 6 AND 7 are the matmuls at those K, which is the only thing that
#   says the k PARITY still holds. The map places bytes; only cpu_reference says
#   a channel got the right 32 of its k.
#
#   ENTRY 2 is K = 64 at M = 1, the eleven geometry path, which must not move.
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
MM=/opt/charsiu/charsiu_matmul
CH=/opt/charsiu/charsiu_int4
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

c() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $*"; return 0; }
	before=$(nbad)
	sleep 1
	env $1 $2 $3 $4 $5 $6 $7 $8 $9 > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This arm is VOID."; health; }
	return 0
}

M4="CHARSIU_W4=1 CHARSIU_W4_HALFK=1"

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	if [ -w /sys/module/rocket/parameters/reset_autosuspend ]; then
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend
		log "reset_autosuspend = $(cat /sys/module/rocket/parameters/reset_autosuspend)"
	else
		log "!! reset_autosuspend NOT WRITABLE. A timeout will kill the round."
	fi

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== 2) K = 64 at M = 1. The eleven geometry path.                ====="
	c "$M4" X=1 $MM 1 64 16
	c "$M4" X=1 $MM 1 64 64
	c "$M4" X=1 $MM 1 32 64

	log ""
	log "##### THE ROUND. K = 128 and 256, which nothing has ever swept.    #####"
	log ""
	log "===== 4) --map  K = 128  N = 64                                    ====="
	log "=====    predicted 0 128 1024 1152 2048 2176 3072 3136, k+ at +512 ====="
	c X=1 X=1 $CH 1 128 64 --map 8
	log ""
	log "===== 5) --map  K = 256  N = 64                                    ====="
	log "=====    predicted 0 128 2048 2176 4096 4224 6144 6208             ====="
	c X=1 X=1 $CH 1 256 64 --map 8 2304

	log ""
	log "##### and the matmuls, which are the only test of the k parity     #####"
	log ""
	log "===== 6) M = 1  K = 128  N = 64                                    ====="
	c "$M4" X=1 $MM 1 128 64
	log ""
	log "===== 7) M = 1  K = 256  N = 64                                    ====="
	c "$M4" X=1 $MM 1 256 64
	log ""
	log "===== 8) M = 1  K = 128  N = 32 and N = 24, other group counts     ====="
	c "$M4" X=1 $MM 1 128 32
	c "$M4" X=1 $MM 1 128 24

	log ""
	log "===== the control that must FAIL, and int8 at K = 128              ====="
	c "CHARSIU_W4=1" X=1 $MM 1 64 64
	c X=1 X=1 $MM 1 128 64

	log ""
	log "===== the anchor again                                             ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== the bases at entry 4 first, then whether entry 6 is exact.   ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
