#!/bin/sh
# ---------------------------------------------------------------------------
# 2026-08-08 round 11. Round 10 answered the "was anything written" question.
#
#   md003_80  raw output BO  204800 bytes  distinct=2  first bytes ff ff ff ff
#   conv2d-cal raw output BO 409600 bytes  distinct=128 first bytes 00 10 0e 00
#
# So the DPU DID run and DID write the whole surface. 0xff is -1 signed, and
# teflon adds 0x80 to get 127, which is exactly the out_zp the test reports. The
# DPU wrote out_offset everywhere, so MAC + A came out as exactly 0.
#
# Which is a sharp fact, because A is not supposed to be 0. md003 has input zero
# point 0, so A carries -128*sum(w), and dropping that term in round 9 changed
# nothing either. Either the DPU is not reading the coefficient buffer at all,
# or it is and A really does arrive as 0.
#
# ROCKET_ATEST=<value> forces A directly, for any op rather than depthwise only.
# requant(0 + A) with a large A must saturate the output away from out_zp.
#
#   output MOVES off 127  -> the DPU reads the coefficient buffer, the requant
#                            and the write path are alive, and the dead stage is
#                            specifically CNA feeding the CMAC
#   output STAYS at 127   -> the coefficient buffer is not read either, and the
#                            problem is upstream of the whole DPU input side
#
# ⚠ conv2d-cal gets the same knob in step 5. It computes correctly, so forcing A
# there MUST wreck its output. If it does not, the knob is not reaching the
# hardware and the null result in 3 means nothing. Round 8 shipped a control
# that could not fail and cost a round; this one can.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }

# $1 model, $2 marker, $3.. env
one() {
	m="$1"; mark="$2"; shift 2
	echo "SMARK-$mark" > /dev/kmsg 2>/dev/null
	env TEFLON_LIB=/usr/lib/libteflon.so "$@" \
		python3 "$NPU_DIR/test_dw.py" "$NPU_DIR/$m" > "$C" 2>&1
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	# -n 8 floods the serial console and wedges the box. Learned the hard way.
	dmesg -n 4 2>/dev/null

	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/job_log 2>/dev/null
	log ""
	log "  task_con16=$(cat /sys/module/rocket/parameters/task_con16 2>/dev/null)"

	log ""
	log "===== 1) CONTROL: conv2d-cal untouched ====="
	env TEFLON_LIB=/usr/lib/libteflon.so \
		python3 "$NPU_DIR/test_model.py" "$NPU_DIR/conv2d-cal.tflite" 2 > "$C" 2>&1

	log ""
	log "===== 2) md003_80 untouched: distinct=1 mean=127, the reference ====="
	sleep 2
	one md003_80.tflite md003-plain

	log ""
	log "===== 3) md003_80 with A forced to 0x2000 ====="
	log "  moves off 127 -> the DPU reads the coefficients, only CNA is dead"
	log "  stays at 127  -> the coefficient buffer is not read either"
	sleep 2
	one md003_80.tflite md003-a2000 ROCKET_ATEST=0x2000

	log ""
	log "===== 4) md003_80 with A forced to 0x40000, a second value ====="
	log "  two values so a coincidence at one of them is visible"
	sleep 2
	one md003_80.tflite md003-a40000 ROCKET_ATEST=0x40000

	log ""
	log "===== 5) THE CONTROL THAT CAN FAIL: conv2d-cal with A forced ====="
	log "  this model computes correctly. Forcing A MUST wreck it."
	log "  If its output is unchanged, the knob never reached the hardware"
	log "  and step 3 measured nothing."
	sleep 2
	one conv2d-cal.tflite cal-a2000 ROCKET_ATEST=0x2000

	log ""
	log "===== 6) conv2d-cal untouched again ====="
	sleep 2
	one conv2d-cal.tflite cal-plain

	log ""
	log "===== Read 5 FIRST: it must differ from 6. Then 3 and 4 against 2. ====="
	sync
}

case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
