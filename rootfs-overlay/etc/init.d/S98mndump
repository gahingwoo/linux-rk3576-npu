# ---------------------------------------------------------------------------
# 2026-08-22 round 325. READ THE WHOLE MAP, THEN REPACK.
#
# ROUND 324 FOUND THE THING int4 HAS BEEN MISSING SINCE 280, AND IT IS NOT A
# COMPUTATION LIMIT. It is half the weight buffer never being read.
#
# The instrument is --map: one live nibble at a time, printing the output word
# it reaches. Byte offset against the word it lights, at K=64 N=64:
#
#     byte      0..63    64..127   128..191   192..255
#     today     w0..w7    DEAD      w8..w15     DEAD
#     0x40b8=3  w0..w7   w8..w15   w16..w23   w24..w31
#
# **The dead runs come alive.** Every byte of the buffer feeds a channel at the
# new setting, where half of them fed nothing before, and words written go 64 to
# 112 at N=64 and 136 to 256 at N=256. That is what "half width" always was.
#
# AND THAT EXPLAINS THE SCORE FALLING. charsiu's packer still writes the old
# layout, so its group of 8 channels lands two runs further out than the reader
# looks: 324 measured ch8..15 at w16..23 and ch16..23 at w32..39, which is
# exactly what the new address map predicts. **The values did not change. The
# map under them did.** int4 reopens, and the work is a repack.
#
# ⚠ THREE THINGS 324 GOT WRONG OR COULD NOT SAY, ALL OF THEM MINE
#
#   1  ITS OWN PROBE WAS UNREADABLE and the control is what caught it. The tool
#      generated weights as `i * 13 % 15`, which is FIFTEEN distinct channel
#      patterns, doubled to thirty by the halfk parity. So ref[c] == ref[c+30],
#      the search for a value found a duplicate, and "256 of 256 present" was
#      free. Entry 2a printed ident = 30 where the score said 64 of 64, which is
#      a metric disagreeing with a known answer. Fixed: a per channel hash, and
#      a line that counts how many references are actually distinct.
#   2  ⚠ AND r312's "the survivors are g0 and g30" IS THE SAME ARTIFACT.
#      ref[240] IS ref[0]. My "240 is 256 minus one feature atom, a wrapping
#      stride would do that" was wrong, and it was a suspicion I wrote down
#      before the run precisely so it could be killed. It is killed.
#   3  I LIMITED THE MAP TO 512 OF 2048 BYTES, so it shows w0..w31 and stops.
#      What feeds w32 and up, and how many k-runs a channel gets, is unmeasured.
#      A packer cannot be written from a quarter of a map, and this file records
#      three closed forms fitted to one point that died in the round after.
#
# ---------------------------------------------------------------------------
# WHAT THIS ROUND DOES
# ---------------------------------------------------------------------------
#
# 1) THE WHOLE MAP, at the new setting, at three geometries. Not a sample: every
#    byte at K=64 N=64, then K=128 N=64 and K=64 N=128 at half resolution, so
#    the K scaling and the N scaling are separated. `8*K` and `4*K` were once
#    the same number here and the wrong one was picked.
# 2) THE INSTRUMENT'S OWN CALIBRATION, entry 2e: the same map on int8 at the
#    same setting, where the layout is known good and byte exact.
# 3) THE PLACEMENT AGAIN with weights that do not repeat, so `found` means
#    something. The `distinct` line has to read n of n before anything else
#    on those arms is read at all.
# 4) THE CLIFF, AND A NEW SUSPECT FOR IT. int4 is fine to N=512 and collapses
#    60x at N=1024 -- with no timeout and no IOMMU error, so it is a real slow
#    completion, not a failure. ⚠ The bench does not cap the coefficient buffer,
#    and `charsiu_coef_bytes` is table + k*n*4, which at K=2048 N=1024 asks for
#    8.4 MB. Capping that is what made the int8 projections work in round 316.
#    Entry 4 runs the sweep with and without the cap.
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# A) ENTRY 2b IS THE ROUND. Read it as a table of byte -> word and write down
#    the rule, including what happens past byte 512 where 324 stopped. The
#    question the packer needs answered: for channel c, WHICH bytes feed it, and
#    how many of them -- because 8 bytes is 16 nibbles and K=64 needs 64.
# B) ENTRY 2a IS THE CONTROL and must reproduce 324's alternating dead runs.
#    If the old map is not what it was, the instrument moved, not the hardware.
# C) THE `distinct` LINE GATES ENTRY 3. n of n or stop reading.
# D) ENTRY 4: if the cap moves the cliff, int4's closing argument from round 310
#    was measuring my own buffer, and the whole shape ceiling goes with it.
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT
# ---------------------------------------------------------------------------
#
# THE MAP: I expect the run structure to continue past 512 and to be indexed by
# k as well as by channel, but I am not predicting the form -- that is the
# mistake this file already records three times. The map is being READ.
#
# THE CLIFF: honestly, I doubt the coefficient buffer explains a 60x step
# between N=512 and N=1024 when the buffer only doubles. It is in the round
# because it costs one arm and round 316 already caught that buffer once.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
RUN=/opt/charsiu/charsiu_run
MM=/opt/charsiu/charsiu_matmul
I4=/opt/charsiu/charsiu_int4
BE=/opt/charsiu/charsiu_bench
M8=/opt/charsiu/models/Llama-3.2-1B-Instruct-Q8_0.gguf
PROMPT="The capital of France is"
LIMIT=420
ARMCAP=240
CE=CHARSIU_COEF_ELEMS=65536
HEAD=CHARSIU_NPU_MAXN=131072
M4="CHARSIU_W4=1 CHARSIU_W4_HALFK=1"
B8="CHARSIU_OVERRIDE=0x40b8=3"
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

capped() {
	lim="$1"; shift
	"$@" &
	pid=$!
	i=0
	while [ "$i" -lt "$lim" ]; do
		kill -0 "$pid" 2>/dev/null || { wait "$pid"; return $?; }
		sleep 1
		i=$((i + 1))
	done
	kill -9 "$pid" 2>/dev/null
	wait "$pid" 2>/dev/null
	return 124
}

c() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $*"; return 0; }
	before=$(nbad)
	sleep 1
	capped "$ARMCAP" env $1 $2 $3 $4 $5 $6 $7 $8 $9 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the arm exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This arm is VOID."; health; }
	return 0
}

rung() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $1"; return 0; }
	lbl="$1"; shift
	before=$(nbad)
	log ""
	log "  -- $lbl"
	sleep 1
	capped "$LIMIT" env "$@" "$RUN" "$M8" -p "$PROMPT" -n 32 \
		--ignore-eos -q -c 512 -t 4 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the rung exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This rung is VOID."; health; }
	return 0
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	[ -w /sys/module/rocket/parameters/reset_autosuspend ] && \
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend

	log ""
	log "===== 0) the limit's own control. expect rc 124 after ~3s.         ====="
	t0=$(cut -d. -f1 /proc/uptime)
	capped 3 sleep 60
	rc=$?
	t1=$(cut -d. -f1 /proc/uptime)
	log "  -- capped 3 sleep 60  ->  rc $rc after $((t1 - t0))s"
	[ "$rc" = "124" ] || log "  !! THE LIMIT DID NOT FIRE. Nothing below can be trusted to end."

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "##### ROUND 325: read the whole map, then repack.                 #####"

	log ""
	log "===== 2a) THE CONTROL MAP. today's setting, K=64 N=64, all 2048 B. ====="
	log "=====     must reproduce 324: alternating 64 byte runs are DEAD.   ====="
	c "CHARSIU_W4=1" $I4 1 64 64 --map 16

	log ""
	log "===== 2b) THE ROUND. the same map at 0x40b8 = 3, EVERY byte.       ====="
	log "=====     read the rule off it, including past byte 512.           ====="
	c "CHARSIU_W4=1" "$B8" $I4 1 64 64 --map 8

	log ""
	log "===== 2c) the K scaling: K=128 N=64 at the new setting             ====="
	c "CHARSIU_W4=1" "$B8" $I4 1 128 64 --map 16

	log ""
	log "===== 2d) the N scaling: K=64 N=128 at the new setting             ====="
	c "CHARSIU_W4=1" "$B8" $I4 1 64 128 --map 16

	log ""
	log "===== 2e) the instrument's calibration: int8, same setting.        ====="
	log "=====     a layout that is known byte exact, read by the same probe ====="
	c "CHARSIU_MAP_W8=1" "$B8" $I4 1 64 64 --map 16

	log ""
	log "===== 3) the placement again, with weights that do not repeat.     ====="
	log "=====    READ THE distinct LINE FIRST: n of n, or stop.            ====="
	c "$M4" $MM 1 64 64
	c "$M4" "$B8" $MM 1 64 64
	c "$M4" $MM 1 2048 256
	c "$M4" "$B8" $MM 1 2048 256

	log ""
	log "===== 4) the cliff, and whether it is my own coefficient buffer.   ====="
	log "=====    int4 fine to N=512, 60x slower at N=1024, no timeout.     ====="
	c "CHARSIU_W4=1" $BE --nsweep 2048 20
	c "CHARSIU_W4=1" "$CE" $BE --nsweep 2048 20
	c "CHARSIU_W4=1" "$B8" "$CE" $BE --nsweep 2048 20
	log "=====    and int8 in the same boot, as the denominator             ====="
	c "$CE" $BE --nsweep 2048 20

	log ""
	log "===== 5) the standing number, and a witness the block was well     ====="
	rung "the decode loop on the NPU" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 "$CE" "$HEAD"

	log ""
	log "===== the anchor again                                             ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== 2a is the control, 2b is the round, distinct gates entry 3.  ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
