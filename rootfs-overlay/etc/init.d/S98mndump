#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-21 round 307. THE FIRST ROUND THAT IS NOT ABOUT THE NPU.
#
# int4 is parked. What replaces it is the thing charsiu never had: a decode
# loop. Until today the repo was device.c, job.c, regcmd.c and four probes --
# it could compute a matmul and could not run a model, and the 11.8 tok/s in
# the README was a division, not a measurement.
#
# There is now a whole CPU decode path: a gguf reader, byte level BPE, RMSNorm,
# RoPE, GQA attention with a KV cache, SwiGLU, and argmax. On the host it is
# verified two ways:
#
#   tokenizer   3094 cases against huggingface's own implementation, 0 diffs
#   forward     10 prompts against llama.cpp on an f32 model: 480 greedy
#               tokens identical, worst logit delta 0.01027 near 16
#
# THIS ROUND ASKS THE ONE QUESTION THE HOST CANNOT ANSWER: what does it do on
# the RK3576, and what is the CPU number the NPU has to beat. That is step 3 of
# PLAN.md, and it is the denominator for everything after it.
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# 1) READ THE TEXT FIRST, NOT THE TOKENS PER SECOND. Entry 2 must print, byte
#    for byte, what the host printed:
#
#      Paris. The capital of Germany is Berlin. The capital of Italy is Rome.
#      The capital of Spain is Madrid. The capital of Portugal is Lisbon. The
#      capital
#
#    (one line, greedy, --ignore-eos, q4_0). Different text means the loop is
#    wrong on this silicon and EVERY TIMING BELOW IT IS A TIMING OF A WRONG
#    ANSWER. Do not read them.
#
# 2) THEN THE CONTROL. Entry 3 is the same code with the NEON kernels compiled
#    out. It must print the SAME text and be SLOWER. Same text and slower means
#    the vector kernels are right on an ARMv8.0 core. Different text means the
#    NEON path is wrong on a Cortex-A72 and nothing above it counts -- and this
#    is a control that can fail, because a wrong vector kernel still produces
#    fluent English.
#
# 3) THE TOKENIZER, entry 1, must be exactly six ids:
#
#      128000 791 6864 315 9822 374
#
#    Anything else and the file reader or the byte tables are broken on this
#    ABI, and the text above is not evidence of anything.
#
# 4) ONLY THEN the numbers. Host, for scale (6 fast cores, not this board):
#
#      q4_0  18.70 tok/s     q8_0  20.96 tok/s
#      q4_0 by threads: 1 -> 7.93, 2 -> 14.41, 4 -> 21.22, 6 -> 18.80
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT, SO THAT BEING WRONG COSTS SOMETHING
# ---------------------------------------------------------------------------
#
# A) FOUR THREADS WILL BE THE BEST AND EIGHT WILL NOT BEAT IT. The RK3576 is
#    four Cortex-A72 and four Cortex-A53, and the pool splits the rows of a
#    matmul EVENLY. An A53 handed a quarter of the rows finishes last and the
#    A72s wait for it, so eight threads should be no better than four and may
#    be worse. If eight clearly wins, the even split is not the limiter and the
#    pool does not need to know about big.LITTLE -- which would be good news
#    and is the reason to ask.
#
# B) Q4_0 WILL BEAT Q8_0 ON THIS BOARD, and it does not on the host. The host
#    is compute bound, so the cheaper unpacking of q8_0 wins there. If a board
#    with much less memory bandwidth STILL prefers q8_0, then this decode step
#    is not bandwidth bound on the RK3576 either -- and that would say the NPU's
#    advantage here is arithmetic and not bytes, which changes what step 2 is
#    for. This is the discriminating entry of the round.
#
# C) The NPU anchors still pass. Nothing this round touches the NPU, but the
#    image is a full rebuild with a 3072 MiB rootfs and a new partition size,
#    so the anchors are there to catch a rebuild that broke something unrelated.
#
# ---------------------------------------------------------------------------
# WHAT IS NEW IN THE IMAGE
# ---------------------------------------------------------------------------
#   /opt/charsiu/charsiu_run          the decode loop, NEON
#   /opt/charsiu/charsiu_run_scalar   the same source, CHARSIU_NO_NEON
#   /opt/charsiu/models/*.gguf        Llama-3.2-1B-Instruct q4_0 and q8_0
#   rootfs is 3072 MiB now, not 512, because the models live in it
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
RUN=/opt/charsiu/charsiu_run
RUNS=/opt/charsiu/charsiu_run_scalar
M4=/opt/charsiu/models/Llama-3.2-1B-Instruct-Q4_0.gguf
M8=/opt/charsiu/models/Llama-3.2-1B-Instruct-Q8_0.gguf
PROMPT="The capital of France is"
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

# One decode run. $1 binary, $2 model, $3 tokens, $4 threads.
gen() {
	log ""
	log "  -- $(basename $1)  $(basename $2)  -n $3  -t $4"
	sleep 1
	"$1" "$2" -p "$PROMPT" -n "$3" --ignore-eos -q -c 512 -t "$4" > "$C" 2>&1
	return 0
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || log "no accel device (the charsiu entries do not need it)"
	dmesg -n 4 2>/dev/null
	[ -w /sys/module/rocket/parameters/reset_autosuspend ] && \
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend

	log ""
	log "===== 0) the NPU anchor, before anything                           ====="
	w conv2d-cal.tflite ""

	log ""
	log "##### THE ROUND: the CPU decode loop on the RK3576.                #####"

	log ""
	log "===== 1) the tokenizer. must be 128000 791 6864 315 9822 374       ====="
	log ""
	"$RUN" "$M4" --tokens -p "$PROMPT" > "$C" 2>&1

	log ""
	log "===== 2) THE TEXT. q4_0, 32 tokens, greedy. must match the host.   ====="
	gen "$RUN" "$M4" 32 4

	log ""
	log "===== 3) THE CONTROL. same source, no NEON. same text, slower.     ====="
	gen "$RUNS" "$M4" 32 4

	log ""
	log "===== 4) threads. I say 4 wins and 8 does not beat it.             ====="
	for T in 1 2 4 6 8
	do
		gen "$RUN" "$M4" 24 "$T"
	done

	log ""
	log "===== 5) THE DISCRIMINATING ONE. q4_0 against q8_0, 4 threads.     ====="
	log "=====    host prefers q8_0. a bandwidth bound board should not.    ====="
	gen "$RUN" "$M4" 24 4
	gen "$RUN" "$M8" 24 4

	log ""
	log "===== 6) and at 8 threads, in case the winner moves with them      ====="
	gen "$RUN" "$M4" 24 8
	gen "$RUN" "$M8" 24 8

	log ""
	log "===== the NPU anchor again                                         ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== text first, then the control, then the numbers.              ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
