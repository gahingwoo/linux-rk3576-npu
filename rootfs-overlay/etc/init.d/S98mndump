#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-21 round 291. Sixteen BYTES, not sixteen elements.
#
# ⚠ 290's DUMP ANSWERED IT WITHOUT A GUESS, which is what it was for. At M = 2,
# N = 16 the raw surface reads:
#
#   w0..w3    -1887  2330  -7904  2249      row 0, channels 0 to 3
#   w8..w11   -7603  -5524  -9626  -5262    row 0, channels 4 to 7
#
# so an atom group is FOUR elements and the stride between groups is 4*m. The
# surface groups by SIXTEEN BYTES. int8 writes one byte an element and its atom
# is 16 elements; w4a16 writes four and its atom is 4. One statement for both
# paths, where "atom 16" and "the feature atom" were two guesses that each
# covered one path and neither was read.
#
# At M = 1 every atom collapses to n, which is why eleven geometries passed
# without this ever mattering.
#
# ⚠ AND ROW 1 IS A SECOND, SEPARATE FAULT. The row 1 reference values, 2586,
# -77, -846 and 88, appear NOWHERE in the surface. The hardware is not computing
# row 1 wrong in the sense of putting it somewhere else; it is not producing
# those numbers at all, which points at the input packing rather than the read.
#
# ⚠ THE PARTIAL GROUP IS NOT AN ADDRESS PROBLEM. --map at N = 20 and N = 36
# gives bases 0, 128, 192 and 0, 128, 512, 576, 704, and the packer places at
# exactly those. So the four channels each loses are placed correctly and come
# back wrong anyway, and at M = 1 the reader is not in question either.
#
# ⚠ AND "g1 4/8" NEVER SAID WHICH FOUR. It is as consistent with the even
# channels failing as the odd, and both open questions turn on that. The matmul
# names them now.
#
# THE READING RULE, fixed before the run.
#
#   ⚠ ENTRIES 2 TO 4 FIRST. M = 1, because the reader changed for the third
#   round running. Eleven geometries have passed and none may drop.
#
#   ENTRY 5 IS THE ROUND. M = 2 at N = 64.
#
#     row 0 exact, rows 1+ not   the surface is settled and what is left is the
#                                input packing for M > 1, alone
#     row 0 still short          sixteen bytes is not the atom either, and the
#                                dump beside it says what is
#     everything exact           the atom was both faults at once
#
#   ENTRY 8 IS N = 20 AND IT IS THE OTHER HALF OF THE ROUND. The bases are
#   right and four channels of g1 are wrong. The mismatch list says which four,
#   and even-or-odd is the k parity, which is the one part of the layout that
#   was read at N = 64 and never re-read at a partial group.
#
#   ENTRY 10 is the control that must FAIL and ENTRY 11 is int8 at M = 1 and
#   M = 4, both of which were exact.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
MM=/opt/charsiu/charsiu_matmul
CH=/opt/charsiu/charsiu_int4
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

c() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $*"; return 0; }
	before=$(nbad)
	sleep 1
	env $1 $2 $3 $4 $5 $6 $7 $8 $9 > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This arm is VOID."; health; }
	return 0
}

M4="CHARSIU_W4=1 CHARSIU_W4_HALFK=1"

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	if [ -w /sys/module/rocket/parameters/reset_autosuspend ]; then
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend
		log "reset_autosuspend = $(cat /sys/module/rocket/parameters/reset_autosuspend)"
	else
		log "!! reset_autosuspend NOT WRITABLE. A timeout will kill the round."
	fi

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "##### M = 1. The reader changed for the third round running.       #####"
	for nn in 16 64 88
	do
		log ""
		log "===== M = 1  N = $nn"
		c "$M4" X=1 $MM 1 64 $nn
	done

	log ""
	log "##### THE ROUND. atom is four elements, sixteen bytes.             #####"
	log ""
	log "===== 5) M = 2  N = 16, the shape the surface was read from        ====="
	c "$M4" X=1 $MM 2 64 16
	log ""
	log "===== 6) M = 2  N = 64                                             ====="
	c "$M4" X=1 $MM 2 64 64
	log ""
	log "===== 7) M = 4  N = 64                                             ====="
	c "$M4" X=1 $MM 4 64 64

	log ""
	log "##### the partial group. The bases are right; which four fail.     #####"
	log ""
	log "===== 8) N = 20                                                    ====="
	c "$M4" X=1 $MM 1 64 20
	log ""
	log "===== 9) N = 36                                                    ====="
	c "$M4" X=1 $MM 1 64 36

	log ""
	log "===== 10) the control that must FAIL, and int8 at M = 1 and M = 4  ====="
	c "CHARSIU_W4=1" X=1 $MM 1 64 64
	c X=1 X=1 $MM 1 64 64
	c X=1 X=1 $MM 4 64 64

	log ""
	log "===== the anchor again                                             ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== row 0 at entry 5, then the mismatch list at entry 8.         ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
