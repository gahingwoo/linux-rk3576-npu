# ---------------------------------------------------------------------------
# 2026-08-20 round 272. One of 270's two hits is real. Map it, and find out
# what it costs.
#
# ⚠ 270 FOUND TWO FIELDS THAT DOUBLE THE RUN AND THEY ARE NOT THE SAME THING.
# --map could not tell them apart because it only reports which word lights.
# --kpair did, in one entry:
#
#   0x100c RESERVED_1 = 0        byte 0 low k0, byte 0 HIGH ALSO k0 with a
#                                different value, byte 8 k8, k = byte mod 32
#                                -> the byte is being read as ONE weight. This
#                                   does not fix int4, it TURNS IT OFF.
#
#   0x100c PROC_PRECISION = 0    byte 0 low k0 high k1, byte 8 low k16 high k17,
#                                byte 16 -> w1 k0
#                                -> nibble packing intact and the run really is
#                                   32 k a pass. This one is real.
#
# The derived prediction was byte 8 at k 16 and that is what the second arm did,
# four of six points. The other two moved meaning: bytes 256 and 264 used to be
# the same channel at k+32 and are now channel 8 at k 0 and 16. So where k 32
# through 63 comes from is no longer known, and entry 2 of this round is that.
#
# ⚠ AND ENTRY 4 OF 271 MEASURED THE WRONG ARM. The script fixed $FIX to the
# RESERVED_1 value before anything knew which of the two was real, so the full
# sweep that was meant to be the new map is a map of byte mode. Redone here.
#
# THE REST OF 271, all null for the halving.
#
#   SIZE_E_2   0 -> 32   1 -> 32   2 -> 36   3 -> 40   4..7 hang
#              an additive 0, 0, 4, 8 on top of N/2. NOTHING gives 64.
#   OUT_PRECISION on 0x4010   4 runs and fetches nothing, everything else
#              except the shipped 5 hangs. Not the halving either.
#
# So after four rounds NOTHING has moved the N/2. Every clean arm ever run
# reports wrote = 40 unless SIZE_E_2 changed the additive part.
#
# THE READING RULE, fixed before the run.
#
#   ⚠ ENTRY 3 IS WHAT DECIDES IF THE FIX IS USABLE. PROC_PRECISION is the
#   arithmetic mode. Under it the measured value at byte 0 fell from 0x1bbc,
#   7100, to 0x379, 889, so the multiply is NOT the same operation. The output
#   formula in the README, ((int16)fp16bits(w) * (int16)fp16bits(a)) >> 16, was
#   solved at 18 of 18 points under the SHIPPED setting and has no standing
#   under this one. Sweeping the live nibble over seven values under both says
#   whether a formula still exists here at all.
#
#     the values move monotonically with the nibble    a formula exists and can
#                                                      be re-derived
#     they do not move, or move without order          the mode is unusable and
#                                                      the layout fix costs the
#                                                      output, which is a trade
#                                                      not a fix
#
#   ENTRY 2 is the whole buffer under the real arm. It should reach the same 40
#   channels with twice the k, and it says where k 32 to 63 lives now.
#
#   ENTRY 4 asks a geometry question nothing has ever asked: M = 2. Every
#   measurement of the channel count in this project has been at M = 1, and
#   N/2 + 8 is fitted entirely inside that. If M moves it, the halving is not
#   about N.
#
#   ENTRY 5 sweeps the DPU's own PROC_PRECISION at 0x4010, which is the same
#   field name in a different register and has never been varied. 271 swept
#   OUT_PRECISION there and held this one at 2 throughout.
#
#   ENTRY 6 combines the real fix with SIZE_E_2 = 2, which is the only other
#   value that runs and changes anything.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
CH=/opt/charsiu/charsiu_int4
FIX=0x100c=0x20600020
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

c() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $*"; return 0; }
	before=$(nbad)
	sleep 1
	env $1 $2 $CH $3 $4 $5 $6 $7 $8 > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This arm is VOID."; health; }
	return 0
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	if [ -w /sys/module/rocket/parameters/reset_autosuspend ]; then
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend
		log "reset_autosuspend = $(cat /sys/module/rocket/parameters/reset_autosuspend)"
	else
		log "!! reset_autosuspend NOT WRITABLE. A timeout will kill the round."
	fi

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== 2) the whole buffer under the REAL fix, PROC_PRECISION=0     ====="
	log ""
	c "CHARSIU_OVERRIDE=$FIX" X=1 1 64 64 --map 8

	log ""
	log "===== 3) k 32 to 63. Where does the second half live now.          ====="
	c "CHARSIU_OVERRIDE=$FIX" CHARSIU_KPAIR_BYTES=0,8,16,128,256,512,1024 1 64 64 --kpair

	log ""
	log "##### 4) DOES A FORMULA STILL EXIST. live nibble 1 2 3 4 5 7 15    #####"
	for L in 1 2 3 4 5 7 15
	do
		log ""
		log "===== nibble $L   SHIPPED"
		c "CHARSIU_INT4_LIVE=$L" X=1 1 64 64 --map 8 8
		log "===== nibble $L   PROC_PRECISION=0"
		c "CHARSIU_INT4_LIVE=$L" "CHARSIU_OVERRIDE=$FIX" 1 64 64 --map 8 8
	done

	log ""
	log "===== 5) M = 2. Nothing has ever varied M. Does wrote move.        ====="
	c "X=1" X=2 2 64 64 --map 8 128

	log ""
	log "===== 6) the DPU's own PROC_PRECISION at 0x4010, 2 -> 0            ====="
	c "CHARSIU_OVERRIDE=0x4010=0xa0000000" X=1 1 64 64 --map 8 128

	log ""
	log "===== 7) the real fix plus SIZE_E_2 = 2                            ====="
	c "CHARSIU_OVERRIDE=$FIX,0x4050=0x00023233" X=1 1 64 64 --map 8 256

	log ""
	log "===== the anchor again                                             ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== entry 4 decides whether the fix is a fix or a trade.         ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
