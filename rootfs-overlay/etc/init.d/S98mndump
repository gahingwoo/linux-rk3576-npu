#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-23 round 353. THE SENTENCE, NOT THE RATE. THE RATE IS DONE.
#
# ✅✅✅ ROUND 352: int4 DECODES, AND IT IS 55% FASTER.
#
#   int8   gen 32 tok in 4897 ms,  6.53 tok/s   5028 ms hardware, 2036 us/submit
#   int4   gen 32 tok in 3163 ms, 10.12 tok/s   3052 ms hardware, 1235 us/submit
#
# 10.12 against 6.53, and the bounded estimate written before the run was 8.8 to
# 10.6. The hardware path is 1.65x faster, which is what the shape sweep said.
#
# ✅ AND THE BLOCK IS NOT THE PROBLEM: entry 4 verified the matmul under the
# decode's OWN packers at 1024 of 1024, worst 0.00e+00.
#
# ⚠ TWO FAULTS, AND THE HEARTBEAT EARNED ITS PLACE BY TELLING THEM APART.
#
# 1. STAGING TOOK 101 SECONDS. Steady, about a second a tensor -- 64 at 50.6 s,
#    80 at 65.4, 96 at 82.5, 112 at 101.0 -- so it was slow work and not a
#    wedge, which is exactly what the heartbeat was added to distinguish.
#    **The int4 layout writes STRIDED into the buffer object: sixteen
#    consecutive bytes, then a jump of 256.** A buffer object's mapping does
#    not absorb that the way it absorbs int8's nearly sequential write. It now
#    packs into ordinary memory and copies once, sequentially.
#
# 2. THE SENTENCE IS REPETITIVE.
#
#      int8  "Paris. The Eiffel Tower is located in Paris. The Eiffel Tower is
#             one of the most famous landmarks in the world. It was built for"
#      int4  "Paris. Paris is the most populous city in France. Paris is the
#             most famous city in the world. Paris is the most beautiful city"
#
#    English, on topic, grammatical, and stuck in one frame. That is not a
#    hardware fault and not a layout fault -- the matmul is byte exact. **It is
#    ONE absmax scale for a whole 2048 long row**, which is measured offline at
#    0.1067 relative error against group 32's 0.0666.
#
# ---------------------------------------------------------------------------
# WHAT IS NEW IN THE CODE
# ---------------------------------------------------------------------------
#
# GROUPED SCALES FOR FREE. charsiu already cuts K into slices and sums their
# accumulators, so if a slice IS a quantisation group, the group's scale can be
# applied to that slice on the way in and NOTHING extra runs on the hardware.
# Set CHARSIU_NPU_KMAX and CHARSIU_NPU_W4_GROUP to the same value. The
# condition is strict on purpose: the slice must BE the group, because a slice
# covering part of a group would need a scale per part and there is nowhere to
# put one.
#
# ⚠ IT IS NOT FREE IN SUBMITS. K = 2048 in one slice is one job; at KMAX = 512
# it is four, and each pays the fixed submit cost. Entry 4 is int8 at the same
# KMAX so the cost of the slicing is separated from the cost of int4.
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# ENTRY 1: int4 as round 352 ran it, which must reproduce 10.12 tok/s and the
# same repetitive sentence, and whose STAGING should now be seconds rather than
# 101 of them. If the sentence changed without the quantiser changing, the
# staging fix touched something it should not have.
#
# ENTRIES 2 AND 3 are the answer: group 512 and group 128. Read the SENTENCE
# first and the rate second. A sentence that stops circling is the result; a
# rate that falls below 6.53 means the extra submits ate the win.
#
# ENTRY 4 is int8 at KMAX 512, which separates "slicing costs submits" from
# "int4 costs accuracy".
#
# ENTRY 5 is the int8 control and must still be 6.53 tok/s.
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT
# ---------------------------------------------------------------------------
#
# Group 512 helps a little and group 128 helps more, and the rate drops toward
# int8's as the submits multiply -- so the useful answer is probably the
# largest group that fixes the text. If group 128 still circles, the scale is
# not what is wrong and the next thing is the quantiser itself, not its
# granularity.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
VD=/opt/charsiu/charsiu_vendor
V=/opt/charsiu/vendor
RGC=$V/vendor-int4-k2048-n1024.regcmd
WT=$V/vendor-wt-1M.bin
IN=$V/vendor-in.bin
RUN=/opt/charsiu/charsiu_run
M8=/opt/charsiu/models/Llama-3.2-1B-Instruct-Q8_0.gguf
PROMPT="The capital of France is"
LIMIT=420
CE=CHARSIU_COEF_ELEMS=65536
HEAD=CHARSIU_NPU_MAXN=131072
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block did not come back this time."
		ABORT=1
	fi
}

capped() {
	lim="$1"; shift
	"$@" &
	pid=$!
	i=0
	while [ "$i" -lt "$lim" ]; do
		kill -0 "$pid" 2>/dev/null || { wait "$pid"; return $?; }
		sleep 1
		i=$((i + 1))
	done
	kill -9 "$pid" 2>/dev/null
	wait "$pid" 2>/dev/null
	return 124
}
rung() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $1"; return 0; }
	lbl="$1"; shift
	before=$(nbad)
	log ""
	log "  -- $lbl"
	sleep 1
	capped "$LIMIT" env "$@" "$RUN" "$M8" -p "$PROMPT" -n 32 \
		--ignore-eos -q -c 512 -t 4 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the rung exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This rung is VOID."; health; }
	return 0
}
# arm: <label> <regcmd-or-dash> <byte> <high> [extra env, one assignment]
#
# ⚠ THE ENV GOES IN AS AN ARGUMENT, not as a "VAR=x arm ..." prefix. Whether an
# assignment before a FUNCTION call survives the call is unspecified -- dash
# drops it, other shells keep it -- and the arm whose whole job is to time out
# WITHOUT the trailer runs right after the one that has it. Not a question worth
# leaving to the shell.
arm() {
	before=$(nbad)
	log ""
	log "  ---- $1"
	sleep 1
	env ${5:-IGNORED=1} $VD "$2" "$WT" "$IN" "$3" "$4" 4096 > /tmp/vd.txt 2>&1
	cat /tmp/vd.txt > "$C"
	after=$(nbad)
	if [ "$after" != "$before" ]; then
		log "  !! POISONED: $((after - before)) new fault or timeout lines"
		health
		# ⚠ NOT a round abort. Round 342 threw away every arm after the
		# first poisoning and then measured the block healthy at the
		# end. The block recovers; give it a moment and carry on.
		ABORT=0
		sleep 2
	fi
}

start() {
	log ""
	log "###############################################################"
	log "##### round 353: the sentence, not the rate. the rate is done. #####"
	log "###############################################################"
	log "  int4 is byte exact and 1.42 to 1.78x faster. now decode with it."

	log ""
	log "===== 1) int4 as round 352 ran it. 10.12 tok/s, same sentence. ====="
	log "  staging should be seconds now, not 101 of them."
	rung "int4, one scale a row" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 CHARSIU_NPU_W4V=1 "$CE" "$HEAD"

	log ""
	log "===== 2) int4 with a scale every 512. READ THE SENTENCE.       ====="
	rung "int4, group 512" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 CHARSIU_NPU_W4V=1 \
		CHARSIU_NPU_KMAX=512 CHARSIU_NPU_W4_GROUP=512 "$CE" "$HEAD"

	log ""
	log "===== 3) int4 with a scale every 128                           ====="
	rung "int4, group 128" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 CHARSIU_NPU_W4V=1 \
		CHARSIU_NPU_KMAX=128 CHARSIU_NPU_W4_GROUP=128 "$CE" "$HEAD"

	log ""
	log "===== 4) int8 at KMAX 512: what the SLICING alone costs        ====="
	rung "int8, KMAX 512" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 CHARSIU_NPU_KMAX=512 "$CE" "$HEAD"

	log ""
	log "===== 5) CONTROL: the standing int8 decode, 6.53 tok/s        ====="
	rung "int8, the standing number" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 "$CE" "$HEAD"

	log ""
	log "===== 6) the anchor: int8 conv must still be exact           ====="
	health

	log ""
	log "===== read the CONTROL lines first. VOID means the arm died. ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
