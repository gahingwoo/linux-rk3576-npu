#!/bin/sh
# ---------------------------------------------------------------------------
# 2026-08-08 round 10. Round 9's control worked this time, so round 8 stands.
#
#   weight buffer plain   distinct=125  md5 c6cc3072  first bytes b7 b4 dc 06
#   weight buffer forced  distinct=1    md5 ec80de13  first bytes 7f 7f 7f 7f
#
# The knob fires, and forcing every weight to 0x7f changes nothing. Neither does
# ROCKET_CBUF_DERIVE=1 on this model, which closes 0x1018 and 0x1040 for the one
# geometry they are actually wrong for. Neither does ROCKET_BIAS_NOSW=1, and
# that one is not a small change: md003 has input zero point 0, so the term it
# drops is -128*sum(w).
#
# So a 1x1 conv's output depends on NONE of: the weights, the input, the bias
# and A term. Every comparable register matches a vendor .rknn compiled at the
# same geometry, and the weight layout matches the vendor's own compiled buffer.
# The output is a fixed constant.
#
# That is stronger than "the MAC is dead" and it changes the question from what
# is being computed to whether anything is being written at all. A fresh shmem
# BO is zeroed and teflon's readback adds 0x80, so an output buffer that was
# never touched comes back as a uniform 128 and looks exactly like a computed
# constant from userspace. This round looks at the RAW buffer instead.
#
#   2  what IS the constant. test_dw.py prints distinct, min, max, mean.
#   3  the raw output BO for md003_80, before teflon converts it.
#   4  the same for conv2d-cal, which is the positive control: a buffer the
#      hardware definitely wrote.
#
# All zero in 3 with 4 populated means the DPU never wrote for the 1x1 and the
# whole job is a no-op. A written constant means the DPU ran and the CNA fed it
# nothing.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }

run() {
	m="$1"; n="$2"; mark="$3"; shift 3
	echo "SMARK-$mark" > /dev/kmsg 2>/dev/null
	env TEFLON_LIB=/usr/lib/libteflon.so "$@" \
		python3 "$NPU_DIR/test_model.py" "$NPU_DIR/$m" "$n" > "$C" 2>&1
	dmesg | sed -n "/SMARK-$mark/,\$p" | grep -a "job: task_count=" | head -2 > "$C" 2>&1
}

# $1 tag, $2 model
dump() {
	d="/tmp/$1"
	rm -rf "$d"; mkdir -p "$d"; cd "$d" || return 0
	env TEFLON_LIB=/usr/lib/libteflon.so ROCKET_DEBUG=dump_bos \
		python3 "$NPU_DIR/test_dw.py" "$NPU_DIR/$2" > "$C" 2>&1
	log "  raw buffers for $2:"
	for f in "$d"/mesa-input-*.bin "$d"/mesa-output-*.bin; do
		[ -f "$f" ] && python3 "$NPU_DIR/bstat.py" "$f" > "$C" 2>&1
	done
	cd / || return 0
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	# -n 8 floods the serial console and wedges the box. Learned the hard way.
	dmesg -n 4 2>/dev/null

	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/job_log 2>/dev/null
	log ""
	log "  task_con16=$(cat /sys/module/rocket/parameters/task_con16 2>/dev/null)"

	log ""
	log "===== 1) CONTROL: conv2d-cal ====="
	run conv2d-cal.tflite 2 cal-first

	log ""
	log "===== 2) md003_80: what IS the constant it returns ====="
	sleep 2
	env TEFLON_LIB=/usr/lib/libteflon.so \
		python3 "$NPU_DIR/test_dw.py" "$NPU_DIR/md003_80.tflite" > "$C" 2>&1

	log ""
	log "===== 3) md003_80 RAW output BO, before teflon adds 0x80 ====="
	log "  all zero means it was never written. 128 everywhere after"
	log "  conversion is what an untouched buffer looks like."
	sleep 2
	dump omd003 md003_80.tflite

	log ""
	log "===== 4) POSITIVE CONTROL: conv2d-cal RAW output BO ====="
	log "  the hardware definitely wrote this one. If 3 and 4 look the"
	log "  same kind of populated, the DPU ran for both."
	sleep 2
	dump ocal conv2d-cal.tflite

	log ""
	log "===== 5) REPEAT CONTROL: conv2d-cal ====="
	sleep 2
	run conv2d-cal.tflite 2 cal-last

	log ""
	log "===== 3 against 4. Zero versus populated says whether the 1x1 job  ====="
	log "===== writes anything at all.                                      ====="
	sync
}

case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
