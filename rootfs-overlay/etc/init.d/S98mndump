# ---------------------------------------------------------------------------
# 2026-08-11 round 77. conv0, which has never worked and was never measured.
#
# Round 76 was going to test chaining and could not. mn_conv0 FAILS ON ITS OWN,
# 0 of 32 with all 32 channels constant and every row at 129, so mn_conv0dw1's
# 5 of 32 says nothing about the handoff. By the rule written before that run,
# conv0 comes first.
#
# It is not a regression from this week's work: the logs of 2026-08-08 and
# 2026-08-09 show the same failure. conv0 was simply never in the regression
# set being run, which is a gap in how this has been measured, and it is in the
# set from now on.
#
# Four things were checked OFFLINE before building anything, by compiling the
# vendor's own first conv at the same geometry and diffing:
#
#   22 of 22 hardcoded registers    IDENTICAL to the vendor
#   the ARGB weight layout          864 of 864 lanes, exact
#   0x104c and 0x1050               differ only because the compiled model's
#                                   calibration spans 0..250; the field is
#                                   2^14 * 255 / span, and mn_conv0's input is
#                                   full range, so mesa's 0x4000 is right for it
#   the requant literals            NOT claimed as the bug, see below
#
# So the register stream and the weight buffer are both vendor-exact, and conv0
# still writes a constant per channel.
#
# The requant is the one place a difference is visible: in_sc*wt_sc/out_sc for
# mn_conv0 gives scale 0x76be at shift 22, while the code writes 0x5391 at
# shift 25, which is 11 times smaller. But the comment beside those literals
# says they came from a live vendor conv0 capture on this board and that the
# computed pair is wrong, and the first conv also enables a CNA CVT pre-scale,
# 0x104c = 0x4000 against the generic path's bypass, which the ratio ignores.
# So it is a QUESTION here, not a fix.
#
# ROCKET_OUT_SHIFT_ABS is the knob that separates the two ways a constant
# happens: a real MAC crushed by too small a requant lights up as the shift
# drops, an empty MAC stays flat across the whole sweep. That is the first
# thing to know about conv0 and it has never been asked.
#
# DECISION RULE, written before the run:
#   conv0 lights up as the shift     the MAC is real and the requant is the
#     drops                          problem; the literals go
#   flat across the whole sweep      the MAC is empty and the requant is
#                                    innocent; the next round goes at the CNA
#                                    input path for a 3 channel surface
#   the computed pair fixes it       the comment beside the literals was
#                                    written before this week's fixes and is
#                                    now stale
#   anything else regresses          that comes first
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
p() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== 1) conv0 as it stands ====="
	p mn_conv0.tflite ""

	log ""
	log "===== 2..6) crushed MAC or empty MAC? drop the output shift ====="
	p mn_conv0.tflite ROCKET_FC_SHIFT=22
	p mn_conv0.tflite ROCKET_FC_SHIFT=18
	p mn_conv0.tflite ROCKET_FC_SHIFT=14
	p mn_conv0.tflite ROCKET_FC_SHIFT=10
	p mn_conv0.tflite ROCKET_FC_SHIFT=6

	log ""
	log "===== 7) the COMPUTED pair, which the code comment calls wrong ====="
	p mn_conv0.tflite "ROCKET_FC_SCALE=0x76be ROCKET_FC_SHIFT=22 ROCKET_FC_OFFSET=0xffffff80"

	log ""
	log "===== 8) the computed scale with the captured offset ====="
	p mn_conv0.tflite "ROCKET_FC_SCALE=0x76be ROCKET_FC_SHIFT=22"

	log ""
	log "===== 9) the coefficient arrangement from before round 52 ====="
	p mn_conv0.tflite ROCKET_SCALE_OFF=1

	log ""
	log "===== 10..12) REGRESSION: depthwise and regular must not move ====="
	p mn_dw1.tflite ""
	p mn_dw25.tflite ""
	p conv2d-cal.tflite ""

	log ""
	log "===== Read 2 to 6 as a sweep. A constant that never moves as the  ====="
	log "===== requant is amplified is an empty MAC, not a crushed one.    ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
