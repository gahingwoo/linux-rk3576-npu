# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-11 round 75. DEPTHWISE IS DONE. A full regression, with every control.
#
# Round 74 closed it. The derived DPU 0x4050 alone takes the 1024 channel layer
# to 1024 of 1024, with no workaround on top:
#
#   dw25_t4, derived 0x4050            1024/1024, every one COMPUTED
#   mn_dw25, derived 0x4050            1024/1024
#   dw25_t4, old constant 0x00013133    992/1024, live 0..991
#   mn_dw1, dw1_t4, conv2d-cal, cal_oc16, whole model    all unchanged
#
# So the +1 on DPU 0x4030 was masking this, and it is gone: it disagreed with
# the vendor, which writes oc-1 there at every channel count.
#
# Three separate bugs were behind depthwise, all found in the last two days:
#
#   the coefficient record    48 bytes, [A|C] and no B, twice as many records
#                             as a regular conv, with the fp16 table after it
#   the row window staging    a window overlapping the previous one by a row
#                             was staging those rows a SECOND time, so every
#                             row after the overlap convolved input two rows
#                             late
#   the weight buffer, and    channel groups of 64, not one group of C, and
#     DPU 0x4050              SIZE_E_2 = (DIV_ROUND_UP(oc,16) - 1) & 3 rather
#                             than the hardcoded 32 channel case
#
# This round changes nothing. It runs everything that has ever passed, plus
# every control, in one boot, so the state is one log rather than a memory of
# fifteen.
#
# DECISION RULE, written before the run:
#   every default passes and every    depthwise is finished at both channel
#     control fails as recorded       sizes and the next target is chaining
#   any default regresses             that comes first
#   any control PASSES                it is not testing what it claims and the
#                                     result it was guarding is not evidence
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
p() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== DEPTHWISE, 32 channels ====="
	p mn_dw1.tflite ""
	p dw1_t4.tflite ""
	p dw_imp.tflite ""

	log ""
	log "===== DEPTHWISE, 1024 channels ====="
	p mn_dw25.tflite ""
	p dw25_t4.tflite ""
	p dw25_t0.tflite ""
	p dw25_imp.tflite ""

	log ""
	log "===== REGULAR convolutions ====="
	p conv2d-cal.tflite ""
	p cal_k3.tflite ""
	p cal_k1.tflite ""
	p cal_s1.tflite ""
	p cal_oc16.tflite ""
	p mn_pw2.tflite ""

	log ""
	log "===== THE CONTROLS, each must FAIL in its own way ====="
	log "-- staging: the overlap rows twice, expect 200s past row 90"
	p dw_imp.tflite ROCKET_STAGE_ALL=1
	log "-- weight layout: one group of C, expect 0/1024"
	p dw25_t4.tflite ROCKET_DW_GROUP=1024
	log "-- 0x4050: the old constant, expect 992/1024"
	p dw25_t4.tflite ROCKET_DW_OW_CFG=0x00013133
	log "-- the coefficient record: 64 bytes, expect depthwise to fall apart"
	p mn_dw1.tflite ROCKET_DW_REC64=1

	log ""
	log "===== whole model ====="
	sleep 2
	env TEFLON_LIB=/usr/lib/libteflon.so \
		python3 "$NPU_DIR/test_model.py" "$NPU_DIR/conv2d-cal.tflite" 2 > "$C" 2>&1

	log ""
	log "===== Every default must pass and every control must fail. A     ====="
	log "===== control that passes means its result was never evidence.   ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
