# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-11 round 63. The 1024 channel depthwise, with the method that worked.
#
# Round 62 SOLVED the 112x112 depthwise: dw_imp 32 of 32 all COMPUTED, mn_dw1
# 32 of 32 with the other nine references genuinely constant, the row profile
# flat, the control reproducing the old breakage, and the fix holding with the
# seam at 46 and at 64. Regular shapes untouched, whole model 2/2.
#
# mn_dw25 did not move: 7x7 with 1024 channels, 2 COMPUTED of 1024. It is a
# single window so the staging fix cannot touch it, and it is a different bug.
#
# Two candidates were killed offline before building anything:
#
#   task->output_channels has an ad-hoc doubling for depthwise only when the
#   channel count is 32 or fewer, which looked like exactly the kind of special
#   case that breaks at 1024. It is not used by the RK3576 path at all; that
#   path takes output_channels_real.
#
#   calc_weights_banks() counts k*k*ic bytes for a depthwise layer while the
#   CNA is programmed to DMA twice that, since the buffer carries two bytes per
#   channel. At 1024 channels that is a 9216 byte shortfall. But the function
#   adds a whole spare bank and a bank is 512 entries of 128 bytes, so even the
#   1024 channel case has 65536 bytes for 18432. No overflow, at any width.
#
# So use the instrument that worked. dw25_imp.tflite is mn_dw25 with every tap
# at the weight zero point except one per channel at c mod 9, and a zero bias;
# its input and output scales are equal, so the correct output of channel c is
# its own input shifted by that tap. dwimp.py now scales to 1024 channels by
# checking each channel's own plane plus the neighbours a packing error would
# reach: the pair partner and the 16, 32, 64 and C/2 strides.
#
# DECISION RULE, written before the run:
#   CPU control decodes, hardware      the wiring is right at 1024 channels too
#     agrees                           and what is left is the value
#   hardware reads a NEIGHBOURING      the channel packing breaks above some
#     plane                            width, and the offset names the stride
#   hardware fits no tap               neither, and the next step is the row and
#                                      column profile on a 7x7 surface
#   mn_dw1 or dw_imp regress           the round 62 fix is not stable and that
#                                      comes first
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
p() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }
d() { log ""; log "  -- decode $1"; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so \
	python3 "$NPU_DIR/dwimp.py" "$NPU_DIR/$1" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== 1) REGRESSION: the round 62 fix must still hold ====="
	p dw_imp.tflite ""
	p mn_dw1.tflite ""

	log ""
	log "===== 2) the 1024 channel impulse: which tap, which channel ====="
	d dw25_imp.tflite

	log ""
	log "===== 3) the same model through the ordinary metric ====="
	p dw25_imp.tflite ""

	log ""
	log "===== 4) mn_dw25 with its real weights ====="
	p mn_dw25.tflite ""

	log ""
	log "===== 5) the 32 channel impulse decode, as the method's control ====="
	d dw_imp.tflite

	log ""
	log "===== 6) a regular shape, which must be untouched ====="
	p conv2d-cal.tflite ""

	log ""
	log "===== Read test 1 first. If the 112x112 depthwise regressed, the ====="
	log "===== 1024 channel result is not the thing to work on.           ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
