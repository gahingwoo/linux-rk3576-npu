#!/bin/sh
# ---------------------------------------------------------------------------
# 2026-08-08 round 19. ⚠ ROUND 18 IS VOID and its control is why.
#
# The k=5 impulse model, which MUST work because that kernel size computes
# correctly, came back distinct=1 mean=128 min=128 max=128, and with the SAME
# md5 66a83b6c3142 as the k=3 one. Both impulse models returned a flat zero
# point surface, so the "best match cpu ch16 at 71.6%" in step 2 was a constant
# 128 agreeing with the reference wherever the reference sits below the zero
# point. No mapping could be read from either.
#
# The fault was mine, in the model rather than the hardware: one live tap out of
# 400 carries about 1/400 of the dynamic range the full kernel had, and I left
# the output scale at the original 32, so the result underflowed the requant to
# out_zp. mutate_impulse.py now sets the output scale from the largest product a
# single tap can produce, 32 -> 4.34 here, and on the CPU both models now span
# the full byte range with 200 or more distinct values per channel.
#
# taps.py also refuses to report a mapping when the NPU surface is flat, so this
# particular trap cannot be walked into silently a second time.
#
# The question is unchanged. For k=3 every buffer and every register is verified
# against the vendor, the CMAC reads the weights and the DPU reads the
# coefficients, and the answer is still out_zp plus a couple of counts. A tap
# paired with the wrong input pixel is what makes 144 products cancel while
# everything is read correctly, and an impulse kernel names that pairing.
#
#   2  k=5 impulse, THE CONTROL: this kernel size computes, so the mapping MUST
#      come back identity at a high percentage. Anything else voids step 3 too.
#   3  k=3 impulse: which input pixel each tap actually got.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	# -n 8 floods the serial console and wedges the box. Learned the hard way.
	dmesg -n 4 2>/dev/null

	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null
	log ""
	log "  task_con16=$(cat /sys/module/rocket/parameters/task_con16 2>/dev/null)"

	log ""
	log "===== 1) CONTROL: conv2d-cal computes ====="
	env TEFLON_LIB=/usr/lib/libteflon.so \
		python3 "$NPU_DIR/test_model.py" "$NPU_DIR/conv2d-cal.tflite" 2 > "$C" 2>&1

	log ""
	log "===== 2) k=5 IMPULSE, THE CONTROL: mapping MUST be identity ====="
	log "  5x5 computes correctly, so every channel must match its own tap."
	log "  If it does not, taps.py is broken and step 3 means nothing."
	sleep 2
	env TEFLON_LIB=/usr/lib/libteflon.so \
		python3 "$NPU_DIR/taps.py" "$NPU_DIR/cal_k5_imp.tflite" 5 > "$C" 2>&1

	log ""
	log "===== 3) k=3 IMPULSE: which input pixel did each tap get ====="
	sleep 2
	env TEFLON_LIB=/usr/lib/libteflon.so \
		python3 "$NPU_DIR/taps.py" "$NPU_DIR/cal_k3_imp.tflite" 3 > "$C" 2>&1

	log ""
	log "===== 4) k=3 impulse, plain stats, to see if it is even structured ====="
	sleep 2
	env TEFLON_LIB=/usr/lib/libteflon.so \
		python3 "$NPU_DIR/test_dw.py" "$NPU_DIR/cal_k3_imp.tflite" > "$C" 2>&1

	log ""
	log "===== 5) k=5 impulse, plain stats, for comparison ====="
	sleep 2
	env TEFLON_LIB=/usr/lib/libteflon.so \
		python3 "$NPU_DIR/test_dw.py" "$NPU_DIR/cal_k5_imp.tflite" > "$C" 2>&1

	log ""
	log "===== 6) REPEAT CONTROL: conv2d-cal ====="
	sleep 2
	env TEFLON_LIB=/usr/lib/libteflon.so \
		python3 "$NPU_DIR/test_model.py" "$NPU_DIR/conv2d-cal.tflite" 2 > "$C" 2>&1

	log ""
	log "===== Read 2 FIRST. It must be an identity mapping at high percent, ====="
	log "===== or step 3 is meaningless.                                      ====="
	sync
}

case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
