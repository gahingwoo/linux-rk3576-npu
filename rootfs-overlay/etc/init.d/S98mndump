#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-23 round 350. THE PRODUCTION PACKERS, AND THE RATE AS A SLOPE.
#
# ROUND 349, and my own instrument check failed for a reason that was my fault:
#
#   int8  349.7 us/submit   2 MiB   6.00 GB/s
#   int4  277.6 us/submit   1 MiB   3.78 GB/s
#   int8 with the 4 MiB buffer back  1163.2 us  1.80 GB/s  (the fix's control)
#   correctness 1024 of 1024, W4_BITPAT 0 of 1024
#
# I had written "int8 must land near 9.4 GB/s". **9.38 is a MARGINAL rate, fitted
# as a slope with the fixed submit cost excluded, and what entry 1 measures is
# TOTAL time per submit with roughly 160 us of fixed cost inside it.** Comparing
# a total against a marginal is a mis-specified check, not a broken harness.
#
# What can be said without any fit or subtraction, and it is the answer:
#
#   🔑 SAME SHAPE, SAME BOOT, SAME CODE: int4 277.6 us against int8's 349.7.
#      **A projection finishes 1.26x sooner in int4.** Not 2x, because the fixed
#      cost per submit does not shrink.
#
# To know the MARGINAL rate the shape has to be swept, which entries 4 and 5 do,
# and then the slope is the rate and the intercept is the fixed cost -- with no
# single point standing in for either.
#
# 🔑 AND THE PACKER IS WRITTEN AND UNIT CHECKED ON THE HOST. Fed the values
# decoded out of the vendor's own 1 MiB weight buffer, charsiu_pack_weights now
# reproduces that buffer **byte for byte, 0 of 1048576 different**.
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# ENTRIES 1 AND 2 ARE A DIFFERENT CLAIM FROM EVERY ROUND SO FAR. Up to now the
# operands were the vendor's captured buffers, which proved the HARDWARE.
# CHARSIU_GEN builds them with charsiu_pack_weights and charsiu_pack_input_f16,
# **the same two the LLM path calls**, which proves the CODE THAT WILL FEED IT.
# The reference is computed from the source arrays and not from the packed ones,
# so a packer that is wrong in the same way as the reference cannot pass.
# Entry 2 is a second shape so it is not one point.
#
# ENTRIES 4 AND 5 sweep N at fixed K for both precisions. Read the SLOPE, in
# us per MiB, not any single row.
#
# ENTRY 3 is the control that must fail: the same generated operands with
# CHARSIU_W4_BITPAT, which reverts both the registers and the layout together.
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT
# ---------------------------------------------------------------------------
#
# Entry 1 passes: the packer already reproduces the vendor's bytes exactly on
# the host, and the input packer at M = 1 collapses to plain order. If it does
# NOT pass, the difference is the input or the output reading and not the
# weights, because the weights are the part that is already checked.
#
# For the slope I expect int4's to be about half of int8's per MiB and the two
# intercepts to be the same, which would make int4 worth roughly 2x on a job
# large enough to hide the submit -- and 1.26x on this one.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
VD=/opt/charsiu/charsiu_vendor
V=/opt/charsiu/vendor
RGC=$V/vendor-int4-k2048-n1024.regcmd
WT=$V/vendor-wt-1M.bin
IN=$V/vendor-in.bin
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block did not come back this time."
		ABORT=1
	fi
}

# arm: <label> <regcmd-or-dash> <byte> <high> [extra env, one assignment]
#
# ⚠ THE ENV GOES IN AS AN ARGUMENT, not as a "VAR=x arm ..." prefix. Whether an
# assignment before a FUNCTION call survives the call is unspecified -- dash
# drops it, other shells keep it -- and the arm whose whole job is to time out
# WITHOUT the trailer runs right after the one that has it. Not a question worth
# leaving to the shell.
arm() {
	before=$(nbad)
	log ""
	log "  ---- $1"
	sleep 1
	env ${5:-IGNORED=1} $VD "$2" "$WT" "$IN" "$3" "$4" 4096 > /tmp/vd.txt 2>&1
	cat /tmp/vd.txt > "$C"
	after=$(nbad)
	if [ "$after" != "$before" ]; then
		log "  !! POISONED: $((after - before)) new fault or timeout lines"
		health
		# ⚠ NOT a round abort. Round 342 threw away every arm after the
		# first poisoning and then measured the block healthy at the
		# end. The block recovers; give it a moment and carry on.
		ABORT=0
		sleep 2
	fi
}

start() {
	log ""
	log "###############################################################"
	log "##### round 350: the production packers, and the rate as a slope #####"
	log "###############################################################"
	log "  no fitted reference. one nibble changes, the output difference"
	log "  is that nibble. a straight line means int4 is real."

	log ""
	log "===== 1) OUR OWN PACKERS: generated operands, M=1, N=1024      ====="
	log "  charsiu_pack_weights + charsiu_pack_input_f16, the two the"
	log "  LLM path calls. reference from the SOURCE arrays."
	arm "generated, N=1024" "-" 0 0 "CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_VERIFY=1 CHARSIU_OUT_KB=64"

	log ""
	log "===== 2) the same at N=256, so it is not one shape             ====="
	arm "generated, N=256" "-" 0 0 "CHARSIU_M=1 CHARSIU_N=256 CHARSIU_GEN=1 CHARSIU_VERIFY=1 CHARSIU_OUT_KB=64"

	log ""
	log "===== 3) CONTROL: W4_BITPAT reverts registers AND layout       ====="
	log "  must be 0 of 1024."
	arm "generated, W4_BITPAT" "-" 0 0 "CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_VERIFY=1 CHARSIU_W4_BITPAT=1 CHARSIU_OUT_KB=64"

	log ""
	log "===== 4) int4 rate against N. read the SLOPE, us per MiB.      ====="
	arm "int4 N=256" "-" 0 0 "CHARSIU_M=1 CHARSIU_N=256 CHARSIU_GEN=1 CHARSIU_TIME=100 CHARSIU_OUT_KB=64"
	arm "int4 N=512" "-" 0 0 "CHARSIU_M=1 CHARSIU_N=512 CHARSIU_GEN=1 CHARSIU_TIME=100 CHARSIU_OUT_KB=64"
	arm "int4 N=1024" "-" 0 0 "CHARSIU_M=1 CHARSIU_N=1024 CHARSIU_GEN=1 CHARSIU_TIME=100 CHARSIU_OUT_KB=64"
	arm "int4 N=2048" "-" 0 0 "CHARSIU_M=1 CHARSIU_N=2048 CHARSIU_GEN=1 CHARSIU_TIME=100 CHARSIU_OUT_KB=64"

	log ""
	log "===== 5) int8 rate against N, same four points                 ====="
	arm "int8 N=256" "-" 0 0 "CHARSIU_M=1 CHARSIU_N=256 CHARSIU_W8=1 CHARSIU_TIME=100 CHARSIU_OUT_KB=64"
	arm "int8 N=512" "-" 0 0 "CHARSIU_M=1 CHARSIU_N=512 CHARSIU_W8=1 CHARSIU_TIME=100 CHARSIU_OUT_KB=64"
	arm "int8 N=1024" "-" 0 0 "CHARSIU_M=1 CHARSIU_N=1024 CHARSIU_W8=1 CHARSIU_TIME=100 CHARSIU_OUT_KB=64"
	arm "int8 N=2048" "-" 0 0 "CHARSIU_M=1 CHARSIU_N=2048 CHARSIU_W8=1 CHARSIU_TIME=100 CHARSIU_OUT_KB=64"

	log ""
	log "===== 6) the anchor: int8 conv must still be exact           ====="
	health

	log ""
	log "===== read the CONTROL lines first. VOID means the arm died. ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
