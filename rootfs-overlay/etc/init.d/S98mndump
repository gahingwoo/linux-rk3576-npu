# ---------------------------------------------------------------------------
# 2026-08-23 round 351. THE SAME ROUND, WITH MY TWO BUGS OUT OF IT.
#
# ⛔ ROUND 350 HAD TWO FAULTS AND BOTH WERE MINE. Neither is a hardware result.
#
# 1. CHARSIU_N DID NOTHING. Two lines below the ones that read the environment
#    reassigned k and n to 2048 and 1024, so **the whole N sweep ran four times
#    at the same shape** and printed four nearly equal times as if they were a
#    slope. int4 read 230.2, 222.5, 227.6, 217.2 us at "N = 256, 512, 1024,
#    2048" -- all of them N = 1024.
#
# 2. THE REFERENCE WAS WRONG, NOT THE BOARD. The generated activations were
#    multiples of 0.05, which fp16 cannot represent. charsiu_pack_input_f16
#    rounds them, so the hardware multiplied by the rounded value while the
#    reference multiplied by the float:
#
#        board -45.989502   ref -46.000001    rel 2.28e-04
#        board  -2.000488   ref  -2.000000    rel 2.44e-04
#
#    **The board is right in both.** 256 of 1024 "passed" only where the
#    rounding happened to cancel. The activations are now exact sixteenths and
#    the reference rounds through fp16 anyway, so neither can drift again.
#
# ✅ WHAT ROUND 350 DID ESTABLISH, because its controls held:
#    - the packers run on the board and the block computes with what they write
#    - CHARSIU_W4_BITPAT, reverting registers AND layout together, gives 0 of
#      1024 with nan and zero in the output, so the control still fails
#    - every repeat and restore control passed in all eleven arms
#
# ⚠ AND ONE THING WORTH CARRYING: int4 at this shape read 277.6 us in round 349
# and 217 to 230 us in round 350. **A single shape timing moves 20% between
# boots**, which is one more reason to read a slope and not a row.
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# ENTRY 1 must now print N = 256 for the N = 256 arm. If the header line still
# says 1024, the fix did not land and nothing else in the round counts.
#
# ENTRIES 1 TO 3 are correctness through charsiu_pack_weights and
# charsiu_pack_input_f16, the two the LLM path calls, at three shapes. With the
# reference honest about fp16 these should be **all of N within 1e-5**, not 256
# of 1024. Entry 4 is the control that must still score 0.
#
# ENTRIES 5 AND 6 are the sweep, now at four genuinely different shapes.
# **Read the SLOPE in us per MiB of weights**, and the intercept is the fixed
# submit cost. A single row means nothing, as round 350 just demonstrated.
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT
# ---------------------------------------------------------------------------
#
# Correctness clean at all three shapes. For the slope, int4 about half of
# int8's us per MiB with the same intercept -- which would put int4 near 2x on
# a job big enough to hide the submit, against the 1.26x measured at one shape.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
VD=/opt/charsiu/charsiu_vendor
V=/opt/charsiu/vendor
RGC=$V/vendor-int4-k2048-n1024.regcmd
WT=$V/vendor-wt-1M.bin
IN=$V/vendor-in.bin
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block did not come back this time."
		ABORT=1
	fi
}

# arm: <label> <regcmd-or-dash> <byte> <high> [extra env, one assignment]
#
# ⚠ THE ENV GOES IN AS AN ARGUMENT, not as a "VAR=x arm ..." prefix. Whether an
# assignment before a FUNCTION call survives the call is unspecified -- dash
# drops it, other shells keep it -- and the arm whose whole job is to time out
# WITHOUT the trailer runs right after the one that has it. Not a question worth
# leaving to the shell.
arm() {
	before=$(nbad)
	log ""
	log "  ---- $1"
	sleep 1
	env ${5:-IGNORED=1} $VD "$2" "$WT" "$IN" "$3" "$4" 4096 > /tmp/vd.txt 2>&1
	cat /tmp/vd.txt > "$C"
	after=$(nbad)
	if [ "$after" != "$before" ]; then
		log "  !! POISONED: $((after - before)) new fault or timeout lines"
		health
		# ⚠ NOT a round abort. Round 342 threw away every arm after the
		# first poisoning and then measured the block healthy at the
		# end. The block recovers; give it a moment and carry on.
		ABORT=0
		sleep 2
	fi
}

start() {
	log ""
	log "###############################################################"
	log "##### round 351: the same round, with my two bugs out of it #####"
	log "###############################################################"
	log "  no fitted reference. one nibble changes, the output difference"
	log "  is that nibble. a straight line means int4 is real."

	log ""
	log "===== 1) correctness through our packers, N=256               ====="
	log "  the header MUST print N = 256. if it says 1024, stop here."
	arm "generated, N=256" "-" 0 0 "CHARSIU_M=1 CHARSIU_N=256 CHARSIU_GEN=1 CHARSIU_VERIFY=1 CHARSIU_OUT_KB=64"

	log ""
	log "===== 2) correctness, N=1024                                  ====="
	arm "generated, N=1024" "-" 0 0 "CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_VERIFY=1 CHARSIU_OUT_KB=64"

	log ""
	log "===== 3) correctness, N=2048 and K=1024                       ====="
	arm "generated, N=2048 K=1024" "-" 0 0 "CHARSIU_M=1 CHARSIU_N=2048 CHARSIU_K=1024 CHARSIU_GEN=1 CHARSIU_VERIFY=1 CHARSIU_OUT_KB=64"

	log ""
	log "===== 4) CONTROL: W4_BITPAT, registers and layout both back    ====="
	arm "generated, W4_BITPAT" "-" 0 0 "CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_VERIFY=1 CHARSIU_W4_BITPAT=1 CHARSIU_OUT_KB=64"

	log ""
	log "===== 5) int4 rate against N. READ THE SLOPE, us per MiB.      ====="
	arm "int4 N=256" "-" 0 0 "CHARSIU_M=1 CHARSIU_N=256 CHARSIU_GEN=1 CHARSIU_TIME=200 CHARSIU_OUT_KB=64"
	arm "int4 N=512" "-" 0 0 "CHARSIU_M=1 CHARSIU_N=512 CHARSIU_GEN=1 CHARSIU_TIME=200 CHARSIU_OUT_KB=64"
	arm "int4 N=1024" "-" 0 0 "CHARSIU_M=1 CHARSIU_N=1024 CHARSIU_GEN=1 CHARSIU_TIME=200 CHARSIU_OUT_KB=64"
	arm "int4 N=2048" "-" 0 0 "CHARSIU_M=1 CHARSIU_N=2048 CHARSIU_GEN=1 CHARSIU_TIME=200 CHARSIU_OUT_KB=64"

	log ""
	log "===== 6) int8 rate against N, the same four shapes             ====="
	arm "int8 N=256" "-" 0 0 "CHARSIU_M=1 CHARSIU_N=256 CHARSIU_W8=1 CHARSIU_TIME=200 CHARSIU_OUT_KB=64"
	arm "int8 N=512" "-" 0 0 "CHARSIU_M=1 CHARSIU_N=512 CHARSIU_W8=1 CHARSIU_TIME=200 CHARSIU_OUT_KB=64"
	arm "int8 N=1024" "-" 0 0 "CHARSIU_M=1 CHARSIU_N=1024 CHARSIU_W8=1 CHARSIU_TIME=200 CHARSIU_OUT_KB=64"
	arm "int8 N=2048" "-" 0 0 "CHARSIU_M=1 CHARSIU_N=2048 CHARSIU_W8=1 CHARSIU_TIME=200 CHARSIU_OUT_KB=64"

	log ""
	log "===== 6) the anchor: int8 conv must still be exact           ====="
	health

	log ""
	log "===== read the CONTROL lines first. VOID means the arm died. ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
