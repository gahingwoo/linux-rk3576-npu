#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-20 round 276. 64 channels get WRITTEN. Do 64 get LIT.
#
# THE FORMULA IS A READING NOW, six for six, derived from two points:
#
#   channels = ceil((v+1)/2) + extra(SIZE_E_2)      v = CORE 0x3020
#   v =  31 -> 24    v =  79 -> 48    v = 111 -> 64
#   v =  47 -> 32    v =  95 -> 56    v = 127 -> 72
#
# So 0x3020 = 111 writes all 64 channels at N = 64, and the channel shortfall is
# not a wall, it is a value.
#
# ⚠ AND I NEVER MEASURED WHETHER THEY ARE REACHABLE. Every arm in 275's entry 2
# ran --map with a 128 byte limit, which is sixteen probes and reaches w0 to w7.
# "wrote 64" is the extent of the WRITE. Whether 64 distinct channels can be lit
# by a weight byte is a different question and this project has confused those
# two before, in round 266, which is why the sentinel exists at all.
#
# ⚠ MY BUFFER EXPLANATION WAS WRONG. 275 predicted that 111 would not fight the
# k fix, because 64 channels times 32 bytes is exactly the 2048 the buffer
# holds. It hung: 235 groups swept and 4 alive. The other route, 127 with
# SIZE_E_2 = 1, also reaches 64 on its own and drops to 32 under the k fix
# rather than hanging. So the interaction is not "it does not fit".
#
# What is measured about the interaction, and it is only three points:
#
#   v = 63,  extra 8, k fix  -> 40      unchanged from without the fix
#   v = 127, extra 0, k fix  -> 32      halved from 64
#   v = 111, extra 8, k fix  -> hangs
#
# THE READING RULE, fixed before the run.
#
#   ⚠ ENTRY 2 IS THE ROUND, and its prediction is derived. At v = 111 with no k
#   fix a channel takes 16 weight bytes, so 64 channels take 1024 of the 2048,
#   which is 128 live groups out of 256.
#
#     64 words lit, 128 live groups   the channel half is solved outright. Every
#                                     channel reachable, 32 k each, and the k
#                                     fix is the only thing left.
#     64 written, fewer lit           the write reaches further than the fetch,
#                                     and the gap in groups says by how much
#     more than 128 live groups       a channel is taking more than 16 bytes at
#                                     this v, which would be new
#
#   ENTRY 3 asks whether the hang is the size registers after all, by raising
#   0x101c and 0x1020 to say the buffer is twice as big. The bo is allocated
#   with 4096 spare so 4096 is inside it. One arm each and one with both, so a
#   hit names which.
#
#   ENTRY 4 walks v upward under the k fix to find the largest that survives. 63
#   gives 40 and 111 hangs, and nothing in between has been tried.
#
#   No prediction on entry 3 or 4. The buffer explanation was a prediction and
#   it was wrong, and that is the second time this week that an explanation good
#   enough to write down did not survive the round after it.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
CH=/opt/charsiu/charsiu_int4
FIX=0x100c=0x20600020
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

c() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $*"; return 0; }
	before=$(nbad)
	sleep 1
	env $1 $2 $CH $3 $4 $5 $6 $7 $8 > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This arm is VOID."; health; }
	return 0
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	if [ -w /sys/module/rocket/parameters/reset_autosuspend ]; then
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend
		log "reset_autosuspend = $(cat /sys/module/rocket/parameters/reset_autosuspend)"
	else
		log "!! reset_autosuspend NOT WRITABLE. A timeout will kill the round."
	fi

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== 2) THE ROUND. 0x3020 = 111, NO k fix, the WHOLE buffer.      ====="
	log "=====    derived: 128 live groups of 256, and 64 words lit.        ====="
	log ""
	c "CHARSIU_OVERRIDE=0x3020=111" X=1 1 64 64 --map 8

	log ""
	log "===== 3) and its k map. 32 k a channel is what 16 bytes means.     ====="
	c "CHARSIU_OVERRIDE=0x3020=111" CHARSIU_KPAIR_BYTES=0,8,16,256,512,1024 1 64 64 --kpair

	log ""
	log "##### 4) is the hang the size registers. one at a time, then both. #####"
	for a in \
		"$FIX,0x3020=111,0x101c=0x1000" \
		"$FIX,0x3020=111,0x1020=0x40" \
		"$FIX,0x3020=111,0x101c=0x1000,0x1020=0x40" \
		"$FIX,0x3020=111,0x1030=0x00400000"
	do
		log ""
		log "===== ARM $a"
		c "CHARSIU_OVERRIDE=$a" X=1 1 64 64 --map 8 128
	done

	log ""
	log "##### 5) how far v goes under the k fix. 63 is 40, 111 hangs.      #####"
	for v in 71 79 87 95 103
	do
		log ""
		log "===== ARM 0x3020=$v + k fix"
		c "CHARSIU_OVERRIDE=$FIX,0x3020=$v" X=1 1 64 64 --map 8 128
	done

	log ""
	log "===== the anchor again                                             ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== 64 lit at v=111 and the channel half is done.                ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
