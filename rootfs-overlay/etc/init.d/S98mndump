#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-11 round 54. The depthwise coefficient table, decoded offline.
#
# Every earlier depthwise probe looked for the vendor's per-channel table in
# the .rknn and did not find one, and concluded there was none. There is one:
# librknnrt builds it at load time, and the runtime capture of sv_dwu has it
# in plain sight. sv_dwu's 0x5020 points immediately past its 576 byte weight
# buffer and its 0x5024 448 bytes later, and those 448 bytes are
#
#     8 records of 48 bytes   [A 8 x int32][C 8 x int16], no B
#     32 fp16 weight scales
#
# against the regular conv's 4 records of 64 and the same 32 fp16 entries. All
# of it reproduces with nothing fitted: C is round(0x4000 * wt_sc / max wt_sc)
# for 32 of 32 channels, and A is this driver's own existing expression,
# bias - (in_zp - 0x80) * sum(w - wt_zp), for 32 of 32 channels of BOTH models.
#
# So A was right all along and three other things were wrong at once, which is
# why changing any one of them alone never moved anything:
#
#     the record is 48 bytes, not 64
#     there are twice as many records as a regular conv has
#     the fp16 table, and the 0x5024 operand past it, both move with that
#
# The weight buffer is now checked too: mesa's depthwise packing reproduces the
# vendor's 288 weight lanes exactly, so it was never the problem.
#
# DECISION RULE, written before the run:
#   dwconv/mn_dw1 improve            the depthwise table was the bug
#   dwconv unchanged at 6 distinct   the table is not enough; the record count
#                                    is the one part this geometry could not
#                                    pin, so try 8 and 4 with ROCKET_DW_RECS
#   a REGULAR shape regresses        the table-size change leaked into the
#                                    regular path, which it must not
#
# ROCKET_DW_REC64 restores the old 64 byte depthwise record. It is the control:
# it has to reproduce the old depthwise behaviour exactly, or the comparison
# above is not measuring what it claims.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
p() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== 1..2) DEPTHWISE on the derived table, no knobs ====="
	p dwconv.tflite ""
	p mn_dw1.tflite ""

	log ""
	log "===== 3..4) the CONTROL: the old 64 byte record ====="
	p dwconv.tflite ROCKET_DW_REC64=1
	p mn_dw1.tflite ROCKET_DW_REC64=1

	log ""
	log "===== 5..6) the record count, the one part 32 channels cannot pin ====="
	p dwconv.tflite ROCKET_DW_RECS=4
	p dwconv.tflite ROCKET_DW_RECS=16

	log ""
	log "===== 7) the vendor's Q14 C instead of this driver's Q4 ====="
	p dwconv.tflite ROCKET_DW_C14=1

	log ""
	log "===== 8..11) REGULAR shapes, which must be untouched ====="
	p conv2d-cal.tflite ""
	p cal_k3.tflite ""
	p cal_k1.tflite ""
	p cal_oc16.tflite ""

	log ""
	log "===== 12) whole model, for the record ====="
	sleep 2
	env TEFLON_LIB=/usr/lib/libteflon.so \
		python3 "$NPU_DIR/test_model.py" "$NPU_DIR/conv2d-cal.tflite" 2 > "$C" 2>&1

	log ""
	log "===== Read 3 and 4 first. If the control does not reproduce the  ====="
	log "===== old depthwise behaviour, 1 and 2 are not a comparison.     ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
