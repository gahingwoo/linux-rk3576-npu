#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-13 round 133. The pointwise weight layout, third and final form.
#
# Round 132's ladder said the fault is not the tap count and not the sum. With
# two live taps in input group 0, output channels 0 to 31 computed and 32 to 63
# came out CONSTANT; with the taps in input group 1 the two halves swapped
# exactly. So an output channel only ever sees the input group with its own
# index, which is a buffer address, not an adder.
#
# Read off the vendor's own compiler afterwards, at a shape big enough to see
# it. The 1x1 weight buffer is 32x32 tiles, tiled in BOTH axes:
#
#     [oc/32][ic/32][oc%32][ic%32]
#
# with the edge tiles cut short, not padded. Every layout this driver has used
# agrees with that whenever oc or ic is 32 or less, which is every shape the
# layout had ever been checked at, and the flat form is 3968 of 4096 bytes
# wrong at 64 by 64 while round 128's ic grouping is 2048 of 4096 wrong,
# exactly the half with ic above 32.
#
# That was measured with two position encoded models rather than one: with one
# byte per (oc, ic) pair the probe caps at 255 positions, which is why every
# earlier reading stopped at 32 output channels. One model whose weight depends
# only on the output channel and one only on the input channel need 64 levels
# each, and a byte then names its coordinates in the pair of them. Confirmed at
# 64 by 64 and again at 48 by 40 for the cut tiles.
#
# DECISION RULE, written before the run:
#
#   pw64x64w56 and pw64x128w56 correct, and pw32x64w56 still correct
#             the layout is the answer. Then mn_L04 is the next thing to read,
#             and if op4 is correct the whole chain moves.
#   the 64 channel shapes improve but are not correct
#             the layout was one of two faults, and the residual is what to
#             measure next. Read the affine slope: 1.0 means an arithmetic
#             residue, 0.5 means another whole group is misplaced.
#   nothing changes
#             the buffer is not what the CMAC reads, which contradicts round
#             132, so suspect the build before the theory.
#
# CONTROL that can fail: ROCKET_PW_ICGROUP restores round 128's layout, so
# entry 3 must reproduce today's failure exactly, 25 of 64. If the knob changes
# nothing then it is not reaching the path and entry 2 proves nothing either.
# This project has been caught by that five times.
#
# The tap ladder is kept as the mechanism check. pwt_lo2 and pwt_hi2 must go
# from 0 of 64 to 64 of 64 and their constant halves must disappear, because
# under the new layout the taps land in the tile their own output channel
# reads. pwt_all was already correct and must stay correct: its weights are the
# same for ic and ic+32, so it is invariant under the old fault and cannot
# improve, which makes it the sharpest regression in the set.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
p() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== 1..2) THE TEST: the shapes that fail on input channels ====="
	p pw64x64w56.tflite ""
	p pw64x128w56.tflite ""

	log ""
	log "===== 3) CONTROL: round 128's layout, which must still fail ====="
	p pw64x64w56.tflite "ROCKET_PW_ICGROUP=1"

	log ""
	log "===== 4..5) the other input channel counts, and the boundary ====="
	p pw128x128w56.tflite ""
	p pw33x64w56.tflite ""

	log ""
	log "===== 6..8) the mechanism: the taps must now land in their own tile ====="
	p pwt_lo2.tflite "ROCKET_SEED=249"
	p pwt_hi2.tflite "ROCKET_SEED=249"
	p pwt_lo32.tflite "ROCKET_SEED=249"

	log ""
	log "===== 9) REGRESSION: invariant under the old fault, must stay 64/64 ====="
	p pwt_all.tflite "ROCKET_SEED=249"

	log ""
	log "===== 10) MobileNet operator 4, the reason for all of this ====="
	p mn_L04.tflite ""

	log ""
	log "===== 11..15) REGRESSION ====="
	p pw32x64w56.tflite ""
	p pwimp64x64w40.tflite ""
	p mn_L03.tflite ""
	p conv2d-cal.tflite ""
	p mn_conv0.tflite ""

	log ""
	log "===== Entry 3 must FAIL and entry 9 must PASS. Only then do 1 and 2 ====="
	log "===== mean anything.                                                ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
