# ---------------------------------------------------------------------------
# 2026-08-22 round 326. THE BLOCK IS SIZED FOR 16 CHANNELS AND INDEXED FOR 32.
#
# ⚠ FIRST, THE CORRECTION. ROUND 324's HEADLINE WAS WRONG AND ROUND 325's OWN
# DATA IS WHAT KILLED IT.
#
# 324 said `0x40b8 = 3` brings int4's dead weight bytes alive and therefore ends
# the half width. The first half of that is true and the conclusion does not
# follow. 325 read the WHOLE map at three geometries and it fits one form, at
# every live point, 1376 of 1376:
#
#     w = 32 * floor(s / K) + (s mod 32),      s = byte / 8
#
# and the old map fits a different one, with alternate 8 slot runs dead. Count
# the slots each channel actually receives and they are THE SAME: two 8 byte
# slots per channel, K/2 nibbles, in both. The old map wastes half the buffer on
# DEAD runs; the new map wastes half of it on words BEYOND N -- at K=64 N=64 it
# addresses w0..w111 where only w0..w63 exist. Two mechanisms, one outcome.
#
# And the acceptance test says so directly. With weights that no longer repeat,
# K=2048 N=256:
#
#     as it is today     128 of 256 present, all at their own index
#     0x40b8 = 3         128 of 256 present, at (n/8)*16 + n%8
#
# **Same count. The values moved; there are still only half of them.** int4's
# half width is NOT solved and 324's "the work is a repack" was my error.
#
# ---------------------------------------------------------------------------
# WHAT THE MEASURED FORM ACTUALLY SAYS, AND THE ONE NUMBER THAT IS OFF BY 2
# ---------------------------------------------------------------------------
#
# charsiu emits, for int4 at K=64 N=64 (wbytes 2048, n_pad 64):
#
#     0x101c   wbytes            2048
#     0x1020   wbytes / n_pad      32     bytes a channel = 64 nibbles = ALL of K
#     0x1030   the same, << 16    32      (int8 doubles this, int4 does not)
#
# So the registers declare 32 bytes a channel, which is the whole of K. The map
# delivers 16. The block in the measured form is K slots = 8K bytes = 512 bytes
# at K=64, which is SIXTEEN channels at 32 bytes each -- and the form indexes
# THIRTY TWO channels into it, `s mod 32`. **The byte budget is for 16 and the
# indexing is for 32, and that factor of two IS the half width.**
#
# ---------------------------------------------------------------------------
# WHAT THIS ROUND DOES
# ---------------------------------------------------------------------------
#
# 1) SWEEP THE REGISTERS THAT COULD CARRY THE BLOCK LENGTH, one at a time, and
#    READ THE BLOCK OFF THE MAP rather than reasoning about it: 0x1020 doubled,
#    0x1030 doubled, both, and 0x1024 (n_pad - 1) halved. If any of them moves
#    the block to 2K slots, or the indexing to `s mod 16`, a channel gets four
#    slots instead of two and int4 is full width.
# 2) ACCEPTANCE, in the same boot, for each: does `found` reach n of n at
#    K=2048 N=256? That is the only line that settles it.
# 3) AND THE CLIFF, with the discriminating sweep that has been written down
#    since round 310 and never run: the same N sweep at K=512, K=1024 and
#    K=2048. **If the cliff N halves as K doubles it is a BYTE capacity; if it
#    sits at the same N regardless of K it is a count or a field width.**
#    ⚠ This matters more than the width does. Round 325 measured int8 at
#    10.76 GB/s and int4 at 0.13 in the same boot, and capping the coefficient
#    buffer did not fix it. A correct int4 that cannot make a big job is worth
#    nothing, and at N <= 512 int4 already takes the same time as int8 for half
#    the bytes, because 157 us of it is fixed cost.
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# A) ENTRY 2a IS THE CONTROL and must reproduce w = 32*floor(s/K) + s%32.
#    If it does not, the instrument moved and nothing else on the page counts.
# B) In 2b..2e read ONE thing off each map: at which byte does the word base
#    step, and how many distinct words appear before it does. Control is 512 and
#    32. Half the words (16) or twice the byte (1024) is the answer.
# C) ENTRY 3 IS THE ACCEPTANCE. `distinct` must read n of n first, then `found`.
#    128 of 256 is today. 256 of 256 is int4 at full width.
# D) ENTRY 4 IS THE ONE THAT DECIDES WHETHER ANY OF THIS IS WORTH DOING.
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT
# ---------------------------------------------------------------------------
#
# ⚠ I HAVE NOW BEEN WRONG ABOUT int4 TWICE IN THREE ROUNDS -- "the survivors are
# g0 and g30 mean a wrapping stride" (an artifact of my own weights) and "the
# dead bytes coming alive ends the half width" (they feed phantom channels).
# Both were stated before the data and both were killed by the round after, and
# that is the system working. So: no prediction on the registers.
#
# On the cliff I will commit to one, because it is falsifiable and cheap: the
# cliff is a COUNT, not a capacity, and N=1024 will collapse at K=512 as well.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
RUN=/opt/charsiu/charsiu_run
MM=/opt/charsiu/charsiu_matmul
I4=/opt/charsiu/charsiu_int4
BE=/opt/charsiu/charsiu_bench
M8=/opt/charsiu/models/Llama-3.2-1B-Instruct-Q8_0.gguf
PROMPT="The capital of France is"
LIMIT=420
ARMCAP=240
CE=CHARSIU_COEF_ELEMS=65536
HEAD=CHARSIU_NPU_MAXN=131072
M4="CHARSIU_W4=1 CHARSIU_W4_HALFK=1"
B8=0x40b8=3
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

capped() {
	lim="$1"; shift
	"$@" &
	pid=$!
	i=0
	while [ "$i" -lt "$lim" ]; do
		kill -0 "$pid" 2>/dev/null || { wait "$pid"; return $?; }
		sleep 1
		i=$((i + 1))
	done
	kill -9 "$pid" 2>/dev/null
	wait "$pid" 2>/dev/null
	return 124
}

c() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $*"; return 0; }
	before=$(nbad)
	sleep 1
	capped "$ARMCAP" env $1 $2 $3 $4 $5 $6 $7 $8 $9 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the arm exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This arm is VOID."; health; }
	return 0
}

rung() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $1"; return 0; }
	lbl="$1"; shift
	before=$(nbad)
	log ""
	log "  -- $lbl"
	sleep 1
	capped "$LIMIT" env "$@" "$RUN" "$M8" -p "$PROMPT" -n 32 \
		--ignore-eos -q -c 512 -t 4 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the rung exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This rung is VOID."; health; }
	return 0
}

# one map arm and its acceptance test, so a register that moves the block is
# read next to the only line that says whether it helped.
pair() {
	lbl="$1"; ov="$2"
	log ""
	log "  == $lbl   OVERRIDE=$ov"
	c "CHARSIU_W4=1" "CHARSIU_OVERRIDE=$ov" $I4 1 64 64 --map 32
	c "$M4" "CHARSIU_OVERRIDE=$ov" $MM 1 64 64
	c "$M4" "CHARSIU_OVERRIDE=$ov" $MM 1 2048 256
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	[ -w /sys/module/rocket/parameters/reset_autosuspend ] && \
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend

	log ""
	log "===== 0) the limit's own control. expect rc 124 after ~3s.         ====="
	t0=$(cut -d. -f1 /proc/uptime)
	capped 3 sleep 60
	rc=$?
	t1=$(cut -d. -f1 /proc/uptime)
	log "  -- capped 3 sleep 60  ->  rc $rc after $((t1 - t0))s"
	[ "$rc" = "124" ] || log "  !! THE LIMIT DID NOT FIRE. Nothing below can be trusted to end."

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "##### ROUND 326: sized for 16 channels, indexed for 32.           #####"

	log ""
	log "===== 2) the block length, one register at a time.                 ====="
	log "=====    read WHERE the word base steps and HOW MANY words first.  ====="
	pair "2a CONTROL: 0x40b8 = 3 alone. block 512 B, 32 words." "$B8"
	pair "2b 0x1020 doubled: 64 bytes a channel"      "$B8,0x1020=64"
	pair "2c 0x1030 doubled: 0x00400000"              "$B8,0x1030=0x00400000"
	pair "2d both doubled"                            "$B8,0x1020=64,0x1030=0x00400000"
	pair "2e 0x1024 halved: declare 32 channels"      "$B8,0x1024=31"

	log ""
	log "===== 3) today's two arms, unchanged, as the denominator           ====="
	c "$M4" $MM 1 64 64
	c "$M4" $MM 1 2048 256

	log ""
	log "===== 4) THE CLIFF: does its N move with K? unrun since r310.      ====="
	log "=====    halves as K doubles -> a BYTE capacity                    ====="
	log "=====    same N at every K   -> a count or a field width           ====="
	c "CHARSIU_W4=1" "$CE" $BE --nsweep 512 20
	c "CHARSIU_W4=1" "$CE" $BE --nsweep 1024 20
	c "CHARSIU_W4=1" "$CE" $BE --nsweep 2048 20
	log "=====    and int8 at K=512 in the same boot, as the denominator    ====="
	c "$CE" $BE --nsweep 512 20

	log ""
	log "===== 5) the standing number, and a witness the block was well     ====="
	rung "the decode loop on the NPU" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 "$CE" "$HEAD"

	log ""
	log "===== the anchor again                                             ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== 2a is the control; entry 3 is the denominator; 4 decides.    ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
