#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-20 round 283. The write quantises to sixteen channels.
#
# 282 SETTLED THE LAST GROUP. Every N whose highest group is ODD came back
# exact, and the per group line says every group:
#
#   N = 16  16/16      N = 32  32/32      N = 48  48/48      N = 64  64/64
#
# 32 and 16 were 24 and 8 before the fix, and 48 had never been run at all and
# was exact first time. So the irregular 64 in the base expression belongs to
# the highest group in use, and that part is now read across four values of N
# and two values of K rather than fitted to one.
#
# ⚠ THE THREE THAT FAILED DID NOT FAIL ON THE PACKING. The per group line, which
# 281 did not have, shows whole groups at 0 of 8 at the TOP, and the count of
# words WRITTEN is short by the same amount:
#
#   n     16  24  32  40  48  56  64
#   wrote 16  16  32  32  48  48  64      = floor(n/16) * 16, seven for seven
#
# So at n of 24, 40 and 56 the top eight channels were placed correctly and
# never written. The DPU writes in units of sixteen channels and truncates.
#
# Asking for the next multiple of sixteen covers the real count and the extra
# channels are computed and thrown away, so 0x3020 is now
# 2*(ALIGN_UP(n,16) - 8) - 1, which is 47 at n of 24 and 32, 79 at 40 and 48,
# and 111 at 56 and 64. glast reads the same rounded number, which changes no
# base on any case measured so far but stops the register and the table
# disagreeing about how many channels there are.
#
# THE READING RULE, fixed before the run.
#
#   ⚠ ENTRIES 3, 4 AND 5 ARE THE ROUND. n of 24, 40 and 56, which were 16 of
#   24, 32 of 40 and 48 of 56.
#
#     wrote goes to 32, 48 and 64 and all three are exact
#                        the write quantum is sixteen, the fix is the rounding,
#                        and seven values of n now hold with no override
#     wrote goes up but the top group is still 0/8
#                        the channels are written now and the packing is wrong
#                        for them, which is the opposite of what 282 said and
#                        would mean the base for a group depends on the rounded
#                        n after all
#     wrote does not move
#                        floor(n/16)*16 is not a function of what 0x3020 asks
#                        for, and the quantum is somewhere else entirely
#
#   ⚠ ENTRY 2 AND ENTRIES 6 TO 8 MUST NOT REGRESS. n of 16, 32, 48 and 64 were
#   all exact and their 0x3020 changed for 16 alone. If any of them moves, the
#   rounding broke a case that already worked.
#
#   ENTRY 9 is the control that must FAIL and ENTRY 10 is int8.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
MM=/opt/charsiu/charsiu_matmul
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

c() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $*"; return 0; }
	before=$(nbad)
	sleep 1
	env $1 $2 $3 $4 $5 $6 $7 $8 $9 > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This arm is VOID."; health; }
	return 0
}

M4="CHARSIU_W4=1 CHARSIU_W4_HALFK=1"

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	if [ -w /sys/module/rocket/parameters/reset_autosuspend ]; then
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend
		log "reset_autosuspend = $(cat /sys/module/rocket/parameters/reset_autosuspend)"
	else
		log "!! reset_autosuspend NOT WRITABLE. A timeout will kill the round."
	fi

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "##### the three that were short. wrote must go to 32, 48, 64.      #####"
	log ""
	log "===== 3) N = 24. Was 16 of 24.                                     ====="
	c "$M4" X=1 $MM 1 64 24
	log ""
	log "===== 4) N = 40. Was 32 of 40.                                     ====="
	c "$M4" X=1 $MM 1 64 40
	log ""
	log "===== 5) N = 56. Was 48 of 56.                                     ====="
	c "$M4" X=1 $MM 1 64 56

	log ""
	log "##### the four that already worked. None may regress.              #####"
	log ""
	log "===== 6) N = 16                                                    ====="
	c "$M4" X=1 $MM 1 64 16
	log ""
	log "===== 7) N = 32                                                    ====="
	c "$M4" X=1 $MM 1 64 32
	log ""
	log "===== 8) N = 48                                                    ====="
	c "$M4" X=1 $MM 1 64 48
	log ""
	log "===== 2) N = 64                                                    ====="
	c "$M4" X=1 $MM 1 64 64
	log ""
	log "=====    and K = 32 at N = 64, the other K                         ====="
	c "$M4" X=1 $MM 1 32 64

	log ""
	log "===== 9) the control that must FAIL                                ====="
	c "CHARSIU_W4=1" X=1 $MM 1 64 64

	log ""
	log "===== 10) int8 dense                                               ====="
	c X=1 X=1 $MM 1 64 64

	log ""
	log "===== the anchor again                                             ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== seven N and two K exact with no override would close M = 1.  ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
