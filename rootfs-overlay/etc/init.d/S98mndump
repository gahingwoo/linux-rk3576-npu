#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-11 round 69. The depthwise weight buffer is CHANNEL GROUPS OF 64.
#
# Round 68 measured the fault exactly. With the live tap at the same position
# in every channel, the channels that produce anything are one contiguous run
# that moves with the tap:
#
#   tap   0    1    2    3    4    5    6    7    8
#   from  0   64  192  320  448  512  640  768  896
#   to  127  255  383  511  575  703  831  959  991
#
# Inverted, each output channel can reach only ONE OR TWO of its nine spatial
# blocks. A depthwise needs all nine, so nothing computes.
#
# Then the layout was settled OFFLINE, with no board. The depthwise weights are
# in the .rknn even though the coefficient table is not, so vendor models were
# compiled at 32, 128, 256 and 1024 channels with weights generated on the host,
# which makes the test exact rather than a correlation:
#
#   group of 64        288/288, 1152/1152, 2304/2304, 9208/9216 weight lanes
#   one group of C     288/288 at 32 channels, about 4 in 1000 above it
#
# The eight lanes that miss at 1024 are all ONE channel, whose kernel the
# quantiser treated differently; 1023 of 1024 channels are exact.
#
# So the buffer is channel groups of 64, each group tap major inside itself,
# groups laid end to end. A group of C, which this driver wrote, puts a
# channel's nine taps 2C bytes apart, 2048 at 1024 channels; a group of 64 puts
# them 128 apart whatever C is. The two are identical up to 64 channels, which
# is exactly why every depthwise here has been byte exact and the 1024 channel
# one has not.
#
# The total size does not change: 16 groups of 9 x 128 is the same 18432 bytes,
# so the CNA weight byte count at 0x101c is untouched.
#
# ROCKET_DW_GROUP overrides the group size, and setting it to the channel count
# restores the old single group. That is the control: it has to reproduce the
# old breakage.
#
# DECISION RULE, written before the run:
#   mn_dw25 COMPUTED jumps          the depthwise weight layout is solved and
#                                   the remaining wrongness, if any, is a
#                                   different question
#   dw25_t4 lights every channel    the nine taps are all reachable now, which
#                                   is the direct form of the same claim
#   ROCKET_DW_GROUP=1024 restores   the control passes and the comparison is
#     the old numbers                real
#   mn_dw1 or conv2d-cal regress    a group of 64 is not identical to a group
#                                   of 32 after all, and that comes first
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
p() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== 1..2) REGRESSION FIRST: 32 channels must be unchanged ====="
	p mn_dw1.tflite ""
	p dw1_t4.tflite ""

	log ""
	log "===== 3) the real 1024 channel depthwise, on groups of 64 ====="
	p mn_dw25.tflite ""

	log ""
	log "===== 4..5) one tap everywhere: are all nine reachable now? ====="
	p dw25_t4.tflite ""
	p dw25_t0.tflite ""

	log ""
	log "===== 6) the per-channel-tap impulse at 1024 ====="
	p dw25_imp.tflite ""

	log ""
	log "===== 7..8) the CONTROL: one group of C, the old behaviour ====="
	p mn_dw25.tflite ROCKET_DW_GROUP=1024
	p dw25_t4.tflite ROCKET_DW_GROUP=1024

	log ""
	log "===== 9) a regular shape, which must be untouched ====="
	p conv2d-cal.tflite ""

	log ""
	log "===== 10) whole model, for the record ====="
	sleep 2
	env TEFLON_LIB=/usr/lib/libteflon.so \
		python3 "$NPU_DIR/test_model.py" "$NPU_DIR/conv2d-cal.tflite" 2 > "$C" 2>&1

	log ""
	log "===== Read tests 1 and 2 first: a group of 64 must be identical to ====="
	log "===== a group of 32 when there are only 32 channels.               ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
