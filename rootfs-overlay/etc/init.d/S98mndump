#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-23 round 361. IS IT THE SECOND CORE AT ALL, OR THE SECOND DOMAIN?
#
# ⛔⛔ ROUND 360 REFUTED BOTH OF MY HYPOTHESES, AND ONE OF THEM WAS THE ROUND'S
# WHOLE PREMISE.
#
# 1. NOT LATE DATA. CHARSIU_REREAD took the output buffer through a second
#    cache round trip on every one of six concurrent processes and printed
#    **no REREAD line at all**. Each submit's output is stable once the fence
#    fires. What differs is what two IDENTICAL submits COMPUTE.
#
#    I predicted "the reread finds them" and gave three reasons why. It found
#    nothing.
#
# 2. NOT POWER MANAGEMENT. control=on, which stops runtime suspend outright,
#    still gave 371, 426 and 39 words differing. autosuspend_delay_ms=60000
#    still gave 499. Both sides of the hypothesis, both refuted.
#
# So: two concurrent jobs compute DIFFERENT RESULTS FROM THE SAME INPUT, the
# readback is innocent, and power is innocent.
#
# ---------------------------------------------------------------------------
# THE ONE LINE IN THE DRIVER THAT FITS
# ---------------------------------------------------------------------------
#
#     ret = iommu_attach_group(job->domain->domain, core->iommu_group);
#     ...
#     iommu_detach_group(NULL, iommu_group_get(core->dev));
#
# **Every job attaches its own IOMMU domain and detaches it when it finishes.**
# One process has ONE domain, so re-attaching the same one is harmless even if
# a translation lingers. TWO processes have TWO domains taking turns on the
# same IOMMU, and a stale translation then points into the OTHER process's
# pages: wrong data, no fault, intermittent, worse for the job that touches
# more memory. That is every symptom.
#
# ⚠ AND IT PREDICTS SOMETHING THAT SEPARATES IT FROM "THE SECOND CORE IS BAD":
# if this is domain switching, **two processes sharing ONE core corrupt just as
# happily**, and the second core is innocent.
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# ENTRY 1 UNBINDS CORE 1 before anything opens the device -- it has to be
# before, because each open file's scheduler entity is built from the core list
# as it stands at open time. rocket_remove handles one core going away and only
# tears the DRM device down when the last one does.
#
# ENTRY 3 IS THE WHOLE ROUND: a pair of processes on ONE core.
#
#   it still corrupts  -> the second core is innocent, this is domain
#                         switching, and the fix is an IOMMU flush in the
#                         driver rather than anything about two cores
#   it is clean        -> the two cores genuinely interfere and the second core
#                         cannot be used until that is understood
#
# ENTRY 4 rebinds and reproduces with two cores, so the two configurations sit
# in one boot rather than in two logs a round apart.
#
# ENTRY 2 is the solo control on one core and must be clean, as it has been
# every time.
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT
# ---------------------------------------------------------------------------
#
# It corrupts on one core. Two of my last three predictions were wrong, so that
# is worth exactly what it is worth -- but this one at least has a mechanism
# behind it that explains why only the bigger job suffers and why a solo run
# never does.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
VD=/opt/charsiu/charsiu_vendor
V=/opt/charsiu/vendor
RGC=$V/vendor-int4-k2048-n1024.regcmd
WT=$V/vendor-wt-1M.bin
IN=$V/vendor-in.bin
RUN=/opt/charsiu/charsiu_run
M8=/opt/charsiu/models/Llama-3.2-1B-Instruct-Q8_0.gguf
PROMPT="The capital of France is"
LIMIT=420
# 32 tokens does not reach the answer to "17 times 24, show your working"
NGEN=64
CE=CHARSIU_COEF_ELEMS=65536
HEAD=CHARSIU_NPU_MAXN=131072
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block did not come back this time."
		ABORT=1
	fi
}

capped() {
	lim="$1"; shift
	"$@" &
	pid=$!
	i=0
	while [ "$i" -lt "$lim" ]; do
		kill -0 "$pid" 2>/dev/null || { wait "$pid"; return $?; }
		sleep 1
		i=$((i + 1))
	done
	kill -9 "$pid" 2>/dev/null
	wait "$pid" 2>/dev/null
	return 124
}
rung() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $1"; return 0; }
	lbl="$1"; shift
	before=$(nbad)
	log ""
	log "  -- $lbl"
	sleep 1
	capped "$LIMIT" env "$@" "$RUN" "$M8" -p "$PROMPT" -n "${NGEN:-32}" \
		--ignore-eos -q -c 512 -t 4 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the rung exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This rung is VOID."; health; }
	return 0
}
# arm: <label> <regcmd-or-dash> <byte> <high> [extra env, one assignment]
#
# ⚠ THE ENV GOES IN AS AN ARGUMENT, not as a "VAR=x arm ..." prefix. Whether an
# assignment before a FUNCTION call survives the call is unspecified -- dash
# drops it, other shells keep it -- and the arm whose whole job is to time out
# WITHOUT the trailer runs right after the one that has it. Not a question worth
# leaving to the shell.
arm() {
	before=$(nbad)
	log ""
	log "  ---- $1"
	sleep 1
	env ${5:-IGNORED=1} $VD "$2" "$WT" "$IN" "$3" "$4" 4096 > /tmp/vd.txt 2>&1
	cat /tmp/vd.txt > "$C"
	after=$(nbad)
	if [ "$after" != "$before" ]; then
		log "  !! POISONED: $((after - before)) new fault or timeout lines"
		health
		# ⚠ NOT a round abort. Round 342 threw away every arm after the
		# first poisoning and then measured the block healthy at the
		# end. The block recovers; give it a moment and carry on.
		ABORT=0
		sleep 2
	fi
}

# two concurrent probes, so the pair can be repeated without copy and paste
pair() {
	before=$(nbad)
	log ""
	log "  ---- $1"
	env CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_TIME=60 CHARSIU_OUT_KB=64 $2 $VD - "$WT" "$IN" 0 0 4096 > /tmp/vdA.txt 2>&1 &
	pidA=$!
	env CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_TIME=60 CHARSIU_OUT_KB=64 $3 $VD - "$WT" "$IN" 0 0 4096 > /tmp/vdB.txt 2>&1 &
	pidB=$!
	wait "$pidA"
	wait "$pidB"
	log "    A:"
	grep -E "M = |TIME:|baseline:|CONTROL repeat|VOID|REREAD" /tmp/vdA.txt > "$C"
	log "    B:"
	grep -E "M = |TIME:|baseline:|CONTROL repeat|VOID|REREAD" /tmp/vdB.txt > "$C"
	after=$(nbad)
	[ "$after" != "$before" ] && log "  !! POISONED: $((after - before)) new lines"
	return 0
}

start() {
	log ""
	log "###############################################################"
	log "##### round 361: the second core, or the second domain?      #####"
	log "###############################################################"
	log "  int4 is byte exact and 1.42 to 1.78x faster. now decode with it."

	log ""
	log "===== 1) UNBIND CORE 1, before anything opens the device       ====="
	dmesg 2>/dev/null | grep -i "NPU core" > "$C"
	echo 27708000.npu > /sys/bus/platform/drivers/rocket/unbind 2>/dev/null \
		|| log "  !! unbind failed; the rest of this round is void"
	sleep 1
	log "  bound now:"
	ls /sys/bus/platform/drivers/rocket/ 2>/dev/null | grep npu > "$C"

	log ""
	log "===== 2) CONTROL: one process on one core. must be clean.      ====="
	arm "solo, one core" "-" 0 0 "CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_TIME=40 CHARSIU_OUT_KB=64"

	log ""
	log "===== 3) THE WHOLE ROUND: a pair on ONE core                   ====="
	log "  still corrupts -> the second core is innocent and this is"
	log "  domain switching. clean -> the two cores interfere."
	pair "pair, one core 1" "" ""
	pair "pair, one core 2" "" ""
	pair "pair, one core 3" "" ""

	log ""
	log "===== 4) rebind, and reproduce with two cores in the same boot ====="
	echo 27708000.npu > /sys/bus/platform/drivers/rocket/bind 2>/dev/null \
		|| log "  !! rebind failed"
	sleep 1
	ls /sys/bus/platform/drivers/rocket/ 2>/dev/null | grep npu > "$C"
	pair "pair, two cores 1" "" ""
	pair "pair, two cores 2" "" ""

	log ""
	log "===== 5) the anchor: int8 conv must still be exact            ====="
	health

	log ""
	log "===== read the CONTROL lines first. VOID means the arm died. ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
