# ---------------------------------------------------------------------------
# 2026-08-11 round 81. Ask conv0 which input plane it is reading.
#
# Round 80 re-ran the requant sweep with the accumulator alive, which round 77
# could not. The output MOVES now, distinct 254, 218, 252, 256, 231, 114 across
# shifts 25, 27, 26, 24, 22, 20, so the sweep is live where the earlier one was
# meaningless. And COMPUTED stays 0 at every point. The match counts that rise,
# 4 then 8 then 9, are all TRIVIAL, and the constant channel count rises with
# them, 10 then 19 then 20: that is channels saturating, not channels computing.
#
# So no requant value lands near correct, and the accumulator is wrong rather
# than its scaling. What is left, and has never been checked, is the INPUT.
#
# Everything else about conv0 already matches the vendor. Its 22 hardcoded
# registers are identical for the same geometry, and its ARGB weight layout
# reproduces the vendor's bytes 864 of 864. A first conv has THREE channels and
# the CNA reads four byte groups with an alpha lane, while mesa hands the
# tflite tensor over exactly as it is, three bytes per pixel. If the hardware
# wants four, every pixel after the first is read from the wrong address.
#
# fc_imp.tflite gives output channel c a single live tap at input channel
# c mod 3 and tap (c / 3) mod 9. conv0 is stride 2, so the correct output is
# in[2y + ky - 1][2x + kx - 1][c mod 3], and fcimp.py scores every output
# channel against all three planes and all nine taps.
#
# ⚠ The impulse code had to be clamped. An effective weight of one would need
# code 289 and the field is a byte, so it uses 255, an effective 0.75. The
# response is still a single tap and the CPU reference comes from the same
# patched file, so nothing about the comparison changes.
#
# DECISION RULE, written before the run:
#   CPU control not near 32/32     void, the model or the decoder is wrong
#   hardware reads the right       the input path is fine and the fault is
#     plane and tap                further in
#   the plane is offset by a       three channels are being read as four, or
#     constant                     the reverse, and the offset says which
#   the plane wanders with c       the pixel stride is wrong, and how fast it
#                                  wanders gives the stride
#   nothing fits any single tap    the accumulator is summing several taps and
#                                  the weight buffer is not being consumed the
#                                  way its layout says
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
p() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== 1) the first-conv impulse decode ====="
	sleep 2
	env TEFLON_LIB=/usr/lib/libteflon.so \
		python3 "$NPU_DIR/fcimp.py" > "$C" 2>&1

	log ""
	log "===== 2) the same model through the ordinary metric ====="
	p fc_imp.tflite ""

	log ""
	log "===== 3) conv0 with its real weights, for comparison ====="
	p mn_conv0.tflite ""

	log ""
	log "===== 4..6) REGRESSION ====="
	p conv2d-cal.tflite ""
	p mn_dw1.tflite ""
	p mn_dw25.tflite ""

	log ""
	log "===== Read the CONTROL line first: the CPU must decode to its own ====="
	log "===== impulse, or the hardware column says nothing.               ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
