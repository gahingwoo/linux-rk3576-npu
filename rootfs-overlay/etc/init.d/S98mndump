# ---------------------------------------------------------------------------
# 2026-08-22 round 315. THE FEED FORWARD, IN SHAPES THAT HAVE BEEN MEASURED.
#
# ⚠ ROUND 314 PRODUCED NO DATA AT ALL. Every rung exited 127, "timeout: applet
# not found": CONFIG_TIMEOUT is not built into this busybox. I had checked with
# `strings` on the binary, found the word, and read that as the applet being
# there -- it is in the name table, which lists applets that are NOT compiled
# in. **I verified the wrong thing, and it voided a whole round.**
#
# So the limit is now plain shell, which depends on nothing, AND ENTRY 0 PROVES
# IT WORKS BEFORE ANY RUNG RELIES ON IT. A guard that has not been shown to
# fire is not a guard.
#
# ROUND 313 WORKED, AND THEN COST A POWER CYCLE. Three rungs of its ladder
# produced the reference text CHARACTER FOR CHARACTER against the CPU:
#
#     blk.0.attn_q on the NPU          identical
#     all sixteen attn_q               identical
#     EVERY attention projection       identical      <- 64 tensors
#
# So a Llama-3.2-1B decode loop with all 64 attention projections computed on
# this NPU produces the same tokens as the CPU model of the same arithmetic.
# That is the substitution working, and it is the point of having built the CPU
# loop first.
#
# ⚠ THEN THE ffn RUNG WEDGED THE BOARD AND KEPT WEDGING IT. "NPU job timed out"
# every 1.86 seconds, 61 times, 539 IOMMU errors, until the power was pulled.
#
# TWO THINGS WERE WRONG AND BOTH ARE FIXED.
#
# 1) THE SHAPE. Attention is N = 2048 or 512 with K = 2048. The feed forward is
#    N = 8192 (gate, up) and K = 8192 (down), and the largest shape ANY of this
#    has been measured at is round 312's N = 1024, K = 2048. ffn_gate asks for
#    16.8 MB of weights in one job against the 2.1 MB that is known to work.
#
#    So a projection is now CUT INTO SLICES of a measured shape, N at 1024 and
#    K at 2048 by default. The output stage is what makes that exact rather than
#    approximate: acc_out returns a raw int32 sum, so partial sums over a split
#    K add with no rounding at all.
#
# 2) THE HANG. A wedged block answers every submit with a driver side timeout
#    and the ioctl STILL RETURNS SUCCESS, so charsiu never noticed. The only
#    reliable detector is the clock. Three slow submits (over 100 ms) now retire
#    the hardware path: it prints the shape that stopped answering and every
#    matvec after it runs on the CPU, so the run finishes and reports instead of
#    repeating a timeout until someone pulls the power.
#
#    And every rung below is wrapped in a hard `timeout`, because a guard inside
#    the program cannot help if the program is not the thing that is stuck.
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# 1) ENTRY 2 IS THE REFERENCE, on the CPU. Every rung is diffed against this and
#    nothing else:
#
#      Paris. The Eiffel Tower is located in Paris. The Eiffel Tower is one of
#      the most famous landmarks in the world. It was built for
#
# 2) THE LADDER AGAIN, AND READ THE FIRST RUNG THAT DIFFERS. Note that the
#    attention rungs are NOT a repeat: attn_q is two slices now where it was one
#    job, so 313's result does not carry over and rung 1 is a real test.
#
# 3) A rung that prints "the NPU stopped answering at K=.. N=.." DEGRADED. Its
#    text came partly from the CPU and says nothing about the hardware. The
#    SHAPE in that line is the result of that rung.
#
# 4) TOKENS PER SECOND ARE STILL NOT THE POINT. Slicing multiplies the submits:
#    about 30 a layer, 480 a token, none of them chained. Record it.
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT
# ---------------------------------------------------------------------------
#
# A) EVERY RUNG PRODUCES THE REFERENCE TEXT, ffn INCLUDED. Every slice is
#    N <= 1024 and K <= 2048, and round 312 measured 1024 of 1024 elements exact
#    at exactly that shape.
#
# B) THE FULL RUNG WANTS 480 SLICES AND 1440 BUFFERS, which is far more than
#    this driver has ever been asked for. If it runs out, it degrades quietly --
#    the tensor stays on the CPU and says so -- so the per tensor lines are how
#    that is caught, not the text.
#
# C) ENTRY 5 IS THE CONTROL FOR THE NEW GUARD AND IT IS SUPPOSED TO FAIL. It
#    sets the slice limits back to the whole tensor, which is what wedged 313.
#    It must print "the NPU stopped answering", finish, and leave the block
#    healthy enough for the anchor after it. If it hangs instead, the guard does
#    not work and that is the most important line in the log.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
RUN=/opt/charsiu/charsiu_run
M8=/opt/charsiu/models/Llama-3.2-1B-Instruct-Q8_0.gguf
PROMPT="The capital of France is"
LIMIT=420
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

# Run a command with a wall clock limit, in plain shell.
#
# No applet, no external binary: round 314 lost everything to `timeout` not
# being compiled into this busybox. $1 is the limit in seconds, the rest is the
# command. Returns 0 if it finished, 124 if it had to be killed.
capped() {
	lim="$1"; shift
	"$@" &
	pid=$!
	i=0
	while [ "$i" -lt "$lim" ]; do
		kill -0 "$pid" 2>/dev/null || { wait "$pid"; return $?; }
		sleep 1
		i=$((i + 1))
	done
	kill -9 "$pid" 2>/dev/null
	wait "$pid" 2>/dev/null
	return 124
}

# $1 label, $2.. env.  A limit outside the program as well as inside it.
rung() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $1"; return 0; }
	lbl="$1"; shift
	before=$(nbad)
	log ""
	log "  -- $lbl"
	sleep 1
	capped "$LIMIT" env "$@" "$RUN" "$M8" -p "$PROMPT" -n 32 --ignore-eos \
		-q -c 512 -t 4 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the rung exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This rung is VOID."; health; }
	return 0
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	[ -w /sys/module/rocket/parameters/reset_autosuspend ] && \
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend

	log ""
	log "===== 0) THE GUARD'S OWN CONTROL. 314 lost every rung to an applet ====="
	log "=====    that was not there, so this proves the limit fires before  ====="
	log "=====    anything depends on it. Expect: killed, rc 124, ~3s.       ====="
	t0=$(cut -d. -f1 /proc/uptime)
	capped 3 sleep 60
	rc=$?
	t1=$(cut -d. -f1 /proc/uptime)
	log "  -- capped 3 sleep 60  ->  rc $rc after $((t1 - t0))s"
	if [ "$rc" = "124" ]; then
		log "  -- the limit FIRES. the rungs below can be trusted to end."
	else
		log "  !! THE LIMIT DID NOT FIRE. Everything below may hang; the"
		log "  !! most important line in this log is this one."
	fi

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "##### ROUND 315: the feed forward, cut into measured shapes.       #####"

	log ""
	log "===== 2) THE REFERENCE. the same arithmetic, on the CPU.           ====="
	rung "CPU, NPU number format" CHARSIU_NPU_QUANT=1

	log ""
	log "===== 3) THE LADDER. attention first, because slicing changed it.  ====="

	log ""
	log "===== attn_q, now two slices each"
	rung "attn_q on the NPU" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 \
		CHARSIU_NPU_ONLY=attn_q

	log ""
	log "===== every attention projection"
	rung "attn on the NPU" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 \
		CHARSIU_NPU_ONLY=attn

	log ""
	log "===== THE ONE THAT WEDGED 313: ffn_gate alone, N=8192 in 8 slices"
	rung "ffn_gate on the NPU" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 \
		CHARSIU_NPU_ONLY=ffn_gate

	log ""
	log "===== ffn_down alone, K=8192 in 4 slices summed on the CPU"
	rung "ffn_down on the NPU" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 \
		CHARSIU_NPU_ONLY=ffn_down

	log ""
	log "===== every feed forward projection"
	rung "ffn on the NPU" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 \
		CHARSIU_NPU_ONLY=ffn

	log ""
	log "===== the anchor, before the biggest rung                          ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== everything under n = 8192: 112 tensors, about 480 slices"
	rung "all projections on the NPU" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1

	log ""
	log "===== the anchor again                                             ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== 5) THE CONTROL FOR THE GUARD. this is SUPPOSED to fail.      ====="
	log "=====    slice limits back to whole tensors, which is what wedged   ====="
	log "=====    313. It must SAY it stopped and FINISH, not hang.          ====="
	rung "no slicing, the 313 shape" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 \
		CHARSIU_NPU_ONLY=ffn_gate CHARSIU_NPU_NMAX=8192 CHARSIU_NPU_KMAX=8192

	log ""
	log "===== the anchor, after the deliberate wedge                        ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== reference, then the first rung that differs, then the guard. ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
