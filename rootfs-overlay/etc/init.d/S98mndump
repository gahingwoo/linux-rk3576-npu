# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-13 round 138. The second operand has to be 16 byte aligned.
#
# Round 137 ruled out its own candidate and its dumps found the real one.
#
#   the record table padding did nothing   entries 2 and 3 read identically, so
#                                          a partial group of 8 in the A/B/C
#                                          table is not the fault
#   every geometry register MATCHES        our stream at 34 output channels and
#                                          at 40 differ from the vendor's in the
#                                          same 15 entries, all of them
#                                          addresses, requant values or the
#                                          0x4050 nibble, and in nothing else
#   the weight layout MATCHES              the tiled layout was checked against
#                                          the vendor's compiler at 64 by 34 and
#                                          64 by 56 as well, byte for byte
#
# So it is a buffer, and it is the one address computed from the channel count:
#
#     0x5024 = bias + rkt_coef_table_bytes(oc) + oc * 2
#
# The record table in front is always a multiple of 64 bytes, so that address
# is 16 byte aligned exactly when oc is a multiple of 8, and ODD when oc is odd.
# Every count that comes back empty is one that lands unaligned and both counts
# that work are already aligned:
#
#     oc 33  operand at  386  odd          oc 40  operand at  400  aligned
#     oc 34               388  4 only      oc 64               640  aligned
#     oc 36               392  4 only      oc 56               560  aligned
#     oc 41               466  odd
#     oc 47               478  odd         MobileNet's last operator, 1001
#                                          output channels, lands at 10066, odd
#
# The fp16 scale table is now padded to a whole group of eight channels, with
# the last real scale carried across the padding, which moves the operand to
# 400, 480 and 10080. It CANNOT change 40, 64 or 56: their offsets are the same
# number before and after, so they are a regression control built into the fix.
#
# DECISION RULE, written before the run:
#
#   33, 34, 36, 41, 47 come alive and 40, 64 are untouched
#             the alignment was it, and MobileNet should produce a real output
#             for the first time.
#   they stay empty
#             wrong again. Then the operand VALUE, not its address, is what
#             those shapes cannot satisfy, and ROCKET_OP2 sweeps it.
#   40 or 64 changes
#             impossible by construction, since their bytes are identical.
#             That would mean the padding is writing somewhere it should not.
#
# CONTROL that can fail: entry 6 runs 34 with ROCKET_SCALE_NOPAD=1, which puts
# the unpadded table back and must restore the empty convolution.
#
# ⚠ ORDER. pw64x56w56 TIMES OUT the NPU, and the entry that follows a timeout
# comes back flat 128 with an rk_iommu reset error in the log. That is what
# rounds 136 and 137 read as "33 is a flat 128" and "40 regressed": both were
# collateral from the entry before them. It runs LAST here, after everything
# that has to be believed.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
p() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== 1..5) THE TEST: every count that was an empty convolution ====="
	p pw64x34w56.tflite ""
	p pw64x41w56.tflite ""
	p pw64x33w56.tflite ""
	p pw64x36w56.tflite ""
	p pw64x47w56.tflite ""

	log ""
	log "===== 6) CONTROL: the same shape with the table unpadded ====="
	p pw64x34w56.tflite "ROCKET_SCALE_NOPAD=1"

	log ""
	log "===== 7..8) the aligned counts, whose bytes do not change at all ====="
	p pw64x40w56.tflite ""
	p pw64x64w56.tflite ""

	log ""
	log "===== 9) the whole MobileNet, whose last operator has 1001 ====="
	p mobilenet_v1_1.0_224_quant.tflite ""

	log ""
	log "===== 10..14) REGRESSION ====="
	p pw48x64w56.tflite ""
	p mn_L04.tflite ""
	p mn_L03.tflite ""
	p conv2d-cal.tflite ""
	p mn_conv0.tflite ""

	log ""
	log "===== 15) LAST, because it times out and poisons whatever follows ====="
	p pw64x56w56.tflite ""

	log ""
	log "===== Entry 6 must be EMPTY and entries 7 and 8 must be unchanged. ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
