#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-19 round 247. The weight zero point, and whether the clamp is in it.
#
# WHAT THIS IS ABOUT. No model in the regression set has a weight zero point of
# 128. conv2d-cal is 133. The shipped path writes the weight bytes as w - 0x80
# and corrects for that in the ABC B column, which is 0x80 - wt_zp, so -5 here.
# The two TODOs beside that line ask why the blob converts to signed, so the
# 0x80 is copied rather than derived. The development branch has another form,
# w - wt_zp with no correction needed, whose commit from 26 June says it is
# byte exact offline against the CPU reference on this exact model. The two are
# equal only if the hardware applies B the way this driver assumes. The clamp
# appears on the shipped one and the other has never run on hardware.
#
# ⚠ WHY THIS IS NOT A ONE KNOB TEST, which is what I first wrote it as.
# ROCKET_WT_ZP changes the weight bytes ONLY. The B column is written
# unconditionally. Turning it on alone gives the correction twice, which is a
# third thing rather than the alternative design. The alternative is
# ROCKET_WT_ZP=1 with ROCKET_B_VALUE=0 together.
#
# THE READING RULE, fixed before the run. Entry 2 is the question and the
# answer is whether npu min stops being 128. Nothing else needs reading first.
#
# ⚠ THE INSTRUMENT CHECK, and the round is void without it. Entries 3 and 4
# each apply one half of the change alone, so each is arithmetically wrong in a
# known direction. They exist to prove the two knobs reach the hardware at all.
# If 3 and 4 both come back identical to entry 1 then neither knob is live,
# entry 2 proves nothing whatever it says, and the right next step is to find
# out why rather than to read the result. This is the control the task_con16
# round did not have.
#
# THE BASELINE is entry 1. Rounds 240 through 246 all got 128 of 128 with npu
# min 128 max 255 across 128 distinct values.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
log() { echo "$@" > "$C"; }
w() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null

	log ""
	log "===== 1) THE BASELINE. 240 through 246 all got 128 of 128 with    ====="
	log "=====    npu min 128 max 255 and 128 distinct values.             ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== 2) THE QUESTION. Weights as w - wt_zp and B switched off,   ====="
	log "=====    which is the form proven byte exact offline in June.     ====="
	log "=====    Read npu min.                                            ====="
	w conv2d-cal.tflite "ROCKET_WT_ZP=1 ROCKET_B_VALUE=0"

	log ""
	log "===== 3) INSTRUMENT CHECK A. Weights moved, B left on, so the     ====="
	log "=====    correction is applied twice. Must differ from entry 1.   ====="
	w conv2d-cal.tflite "ROCKET_WT_ZP=1"

	log ""
	log "===== 4) INSTRUMENT CHECK B. B off, weights left alone, so the    ====="
	log "=====    correction is missing. Must differ from entry 1.         ====="
	w conv2d-cal.tflite "ROCKET_B_VALUE=0"

	log ""
	log "===== 5) the baseline again, so a drift across the log is visible ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== 6) if entry 2 lifted the floor, does the same pair hold on  ====="
	log "=====    a shape that already computes. wt_zp is 130 here and     ====="
	log "=====    out_zp is 0, so the clamp was never visible on it.       ====="
	w pw33x64w56.tflite ""
	w pw33x64w56.tflite "ROCKET_WT_ZP=1 ROCKET_B_VALUE=0"

	log ""
	log "===== Read entry 3 and 4 first. If neither moved, entry 2 is void ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
