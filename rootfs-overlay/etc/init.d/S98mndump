#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-23 round 348. IT IS NATIVE NOW. IS IT FAST?
#
# ✅✅ ROUND 347: int4 IS CORRECT AT M = 1, WHICH IS THE DECODE CASE.
#
#   M = 1, charsiu's own stream plus THREE register values, nothing else:
#     VERIFY 1024 of 1024 within 1e-4, 1017 within 1e-5, worst 5.46e-05
#   M = 32 anchor, the merge:      1280 of 1280
#   M = 1 with the M = 32 merge:   0 of 1024   (the contrast, wrong as designed)
#   M = 8 with the three:          8 of 4096   (see below)
#   control, this tree's stream:   the old sixteen values
#
# ⚠ M > 1 IS NOT SOLVED and I am not going to pretend it is. At M = 8 the same
# three registers give 8 of 4096, because the vendor puts M on the WIDTH axis
# and this tree puts it on the height axis, and only at M = 1 do the two
# collapse to the same thing. LLM decode is M = 1, so this is enough to be
# useful and not enough to be called general.
#
# THE THREE REGISTERS ARE NOW IN job.c, not an override:
#     0x3018 = 0x10000200        (this is the one that changes the arithmetic)
#     0x301c = M-1 in the LOW half
#     0x3020 = N-1, plainly
# int8 is untouched, checked on the host. CHARSIU_W4_BITPAT restores the old
# behaviour so the fault can be brought back on demand.
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# ENTRY 1 must reproduce 1024 of 1024 with NO override anywhere. That is the
# whole point of making it native: if the value moved from the environment into
# the file and the answer changed, the file is wrong.
#
# ENTRY 2 is the control that brings the fault back: CHARSIU_W4_BITPAT must
# score 0 of 1024 and its sweep must show the old band. A fix whose control does
# not reproduce the fault has not been shown to be the fix.
#
# ⚠⚠ ENTRIES 3 AND 4 ARE THE QUESTION THAT MATTERS NOW: SPEED. Every int4
# timing this project has ever taken -- 661.5 us/MB, 1.51 GB/s, "6.2x slower
# than int8" -- was taken on a configuration that did not compute a weighted
# sum, so none of it is a measurement of this. Entry 3 times int4 and entry 4
# times int8 at the SAME K and N through the SAME code in the SAME boot.
#
#   int4 above about 4.7 GB/s  -> it wins, because it moves half the bytes
#   int4 below that            -> correctness bought nothing and the decode
#                                 loop stays int8
#
# The standing number to beat is int8 at 9.38 GB/s and 6.55 tok/s, of which
# 132.1 ms of a 153 ms token is hardware.
#
# ENTRY 5 is the anchor.
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT
# ---------------------------------------------------------------------------
#
# I genuinely do not know, and this is the first time the question can be asked
# fairly. The old 1.51 GB/s was measured while half the buffer was dead and the
# fetch pattern was whatever the wrong mode produced.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
VD=/opt/charsiu/charsiu_vendor
V=/opt/charsiu/vendor
RGC=$V/vendor-int4-k2048-n1024.regcmd
WT=$V/vendor-wt-1M.bin
IN=$V/vendor-in.bin
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block did not come back this time."
		ABORT=1
	fi
}

# arm: <label> <regcmd-or-dash> <byte> <high> [extra env, one assignment]
#
# ⚠ THE ENV GOES IN AS AN ARGUMENT, not as a "VAR=x arm ..." prefix. Whether an
# assignment before a FUNCTION call survives the call is unspecified -- dash
# drops it, other shells keep it -- and the arm whose whole job is to time out
# WITHOUT the trailer runs right after the one that has it. Not a question worth
# leaving to the shell.
arm() {
	before=$(nbad)
	log ""
	log "  ---- $1"
	sleep 1
	env ${5:-IGNORED=1} $VD "$2" "$WT" "$IN" "$3" "$4" 4096 > /tmp/vd.txt 2>&1
	cat /tmp/vd.txt > "$C"
	after=$(nbad)
	if [ "$after" != "$before" ]; then
		log "  !! POISONED: $((after - before)) new fault or timeout lines"
		health
		# ⚠ NOT a round abort. Round 342 threw away every arm after the
		# first poisoning and then measured the block healthy at the
		# end. The block recovers; give it a moment and carry on.
		ABORT=0
		sleep 2
	fi
}

start() {
	log ""
	log "###############################################################"
	log "##### round 348: it is native now. is it fast? #####"
	log "###############################################################"
	log "  no fitted reference. one nibble changes, the output difference"
	log "  is that nibble. a straight line means int4 is real."

	log ""
	log "===== 1) NATIVE: M=1, no override anywhere. 1024 of 1024.     ====="
	arm "native int4, M=1" "-" 0 0 "CHARSIU_M=1 CHARSIU_VERIFY=1"

	log ""
	log "===== 2) CONTROL: bring the fault back. must be 0 of 1024.    ====="
	arm "M=1, W4_BITPAT" "-" 0 0 "CHARSIU_M=1 CHARSIU_VERIFY=1 CHARSIU_W4_BITPAT=1"

	log ""
	log "===== 3) THE RATE: int4, K=2048 N=1024, 1 MiB of weights      ====="
	arm "int4 time" "-" 0 0 "CHARSIU_M=1 CHARSIU_TIME=200"

	log ""
	log "===== 4) THE RATE: int8, same shape, same code, same boot     ====="
	log "  2 MiB of weights against int4's 1 MiB, so int4 needs more"
	log "  than HALF of int8's GB/s to finish a projection sooner."
	arm "int8 time" "-" 0 0 "CHARSIU_M=1 CHARSIU_TIME=200 CHARSIU_W8=1"

	log ""
	log "===== 5) M=32 anchor, the merge. still 1280 of 1280?          ====="
	arm "anchor, merge M=32" "+$RGC" 0 0 CHARSIU_VERIFY=1

	log ""
	log "===== 6) the anchor: int8 conv must still be exact           ====="
	health

	log ""
	log "===== read the CONTROL lines first. VOID means the arm died. ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
