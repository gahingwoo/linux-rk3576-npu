#!/bin/sh
# ---------------------------------------------------------------------------
# 2026-08-08 round 8. Round 7 landed the 0x4050 fix and isolated the 1x1 conv.
#
#   cal_oc16, derived 0x4050 = 0x80011011   3/3 OK, relu maxdiff 0
#   cal_oc16, ROCKET_DPU4050_CONST=1        0/3 FAIL, round 6's numbers
#
# Three geometries compute now. ⚠ One prediction missed: md003_80 was called
# fixed and is not. Its numbers moved (raw 117/relu 70 to 116/71), so 0x4050 did
# reach it, and something else is also wrong.
#
# With the channel-count bug gone the split is clean: every 5x5 conv computes,
# every 1x1 conv fails. So it IS the kernel, which round 6 could not show
# because two bugs were on top of each other.
#
# The 1x1 case is now cornered:
#   its regcmd matches the vendor .rknn compiled at the same geometry, apart
#   from 0x1018 and 0x1040 (shown inert) and 0x40ac and 0x40b4 (requant, not
#   comparable across differently quantized models)
#   its weight layout is confirmed against the vendor's own compiled buffer: a
#   position-encoded 1x1 built on the host reads back oc-major, ic contiguous,
#   which is exactly what mesa writes
#   and its output is CONSTANT across different inputs
#
# A constant output is not something a wrong weight value or a wrong requant can
# produce. It means the input is not reaching the MAC. So stop looking at values
# and ask what the block is reading.
#
#   4  ROCKET_PW_WTEST=1 fills the whole pointwise weight buffer with 0x7f.
#      Output unchanged means the CMAC never reads it.
#   5  ROCKET_BIAS_NOSW=1 drops the input zero point correction from the BS add
#      operand A. md003 has input zp 0, so that correction is -128*sum(w) and
#      large; conv2d-cal has zp 128 and never exercises it. If A is saturating
#      the requant, the output is constant for that reason.
#   6  verifies the knob in 4 actually fired, by dumping the weight buffer.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }

run() {
	m="$1"; n="$2"; mark="$3"; shift 3
	echo "SMARK-$mark" > /dev/kmsg 2>/dev/null
	env TEFLON_LIB=/usr/lib/libteflon.so "$@" \
		python3 "$NPU_DIR/test_model.py" "$NPU_DIR/$m" "$n" > "$C" 2>&1
	dmesg | sed -n "/SMARK-$mark/,\$p" | grep -a "job: task_count=" | head -2 > "$C" 2>&1
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	# -n 8 floods the serial console and wedges the box. Learned the hard way.
	dmesg -n 4 2>/dev/null

	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/job_log 2>/dev/null
	log ""
	log "  task_con16=$(cat /sys/module/rocket/parameters/task_con16 2>/dev/null)"

	log ""
	log "===== 1) CONTROL: conv2d-cal, 5x5 ====="
	run conv2d-cal.tflite 2 cal-first

	log ""
	log "===== 2) CONTROL: cal_oc16, the geometry 0x4050 won ====="
	sleep 2
	run cal_oc16.tflite 2 oc16-keep

	log ""
	log "===== 3) md003_80 plain, for the numbers to compare against ====="
	sleep 2
	run md003_80.tflite 3 md003-plain

	log ""
	log "===== 4) md003_80 with EVERY pointwise weight forced to 0x7f ====="
	log "  identical output to 3 means the CMAC never reads the weights"
	sleep 2
	run md003_80.tflite 3 md003-wtest ROCKET_PW_WTEST=1

	log ""
	log "===== 5) md003_80 without the input zero point correction in A ====="
	log "  md003 has input zp 0, conv2d-cal has 128 and never exercises it"
	sleep 2
	run md003_80.tflite 3 md003-nosw ROCKET_BIAS_NOSW=1

	log ""
	log "===== 6) did the knob in 4 actually fire? dump the weight buffer ====="
	log "  distinct must be 1 for the forced run, or 4 measured nothing"
	sleep 2
	rm -rf /tmp/rc; mkdir -p /tmp/rc; cd /tmp/rc || return 0
	env TEFLON_LIB=/usr/lib/libteflon.so ROCKET_DEBUG=dump_bos ROCKET_PW_WTEST=1 \
		python3 "$NPU_DIR/test_dw.py" "$NPU_DIR/md003_80.tflite" > /dev/null 2>&1
	for f in /tmp/rc/mesa-weights-*.bin; do
		[ -f "$f" ] && python3 "$NPU_DIR/where.py" "$f" > "$C" 2>&1
	done
	cd / || return 0

	log ""
	log "===== 7) REPEAT CONTROL: conv2d-cal ====="
	sleep 2
	run conv2d-cal.tflite 2 cal-last

	log ""
	log "===== 3 against 4 is the round: does a 1x1 conv read its weights   ====="
	log "===== at all. Read 6 before believing 4.                           ====="
	sync
}

case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
