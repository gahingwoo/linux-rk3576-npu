# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-10 round 52. Move the pointer, keep mesa's own operand value.
#
# Round 51 ran the combination the capture calls the vendor's arrangement, the
# weight scale in the table with the pointer moved past it, and it failed with
# distinct 1, an empty convolution. The round 49 combination beside it failed
# identically. So the table CONTENT is not the issue and the POINTER MOVE is.
#
# And that is consistent rather than mysterious. When the pointer moves, the new
# target gets 0x0E0E, the vendor's own operand value, and round 49 already
# showed that exact word produces an empty convolution in the slot mesa's 0x5024
# already points at. Same word, same failure, once directly and once after
# moving the pointer to it.
#
# So the operand value is what is wrong in both, not the move. Move the pointer
# and keep 0x1004, which mesa's configuration demonstrably accepts.
#
# DECISION RULE, written before the run:
#   2 is 128/128            the layout is adoptable with mesa's operand value,
#                           the fp16 table is in place, and only the operand
#                           content still differs from the vendor
#   2 fails too             the move itself is wrong regardless of the value,
#                           and mesa's surface differs from the vendor's in a
#                           way the pointer cannot express; stop moving it
#   4 moves depthwise       the table matters for depthwise even where the
#                           regular shapes are indifferent
#   1 or 9 not 128/128      the build is wrong, stop
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
p() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }
V="ROCKET_SCALE_TABLE=1 ROCKET_SCALE_TABLE_WT=1 ROCKET_SCALE_PTR=1"

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== 1) BASELINE: must be 128/128 ====="
	p conv2d-cal.tflite ""

	log ""
	log "===== 2) pointer moved, operand kept at mesa's 0x1004 ====="
	p conv2d-cal.tflite "$V"
	p cal_k3.tflite "$V"
	p cal_k1.tflite "$V"

	log ""
	log "===== 3) the same but with the vendor's 0x0E0E, which must FAIL ====="
	p conv2d-cal.tflite "$V ROCKET_OP2=0x0E0E"

	log ""
	log "===== 4) the arrangement on depthwise ====="
	p dwconv.tflite "$V"
	p mn_dw1.tflite "$V"
	p dwconv.tflite "$V ROCKET_DW_REC48=1"

	log ""
	log "===== 9) CONTROL that can fail: baseline again ====="
	p conv2d-cal.tflite ""

	log ""
	log "===== Read 1 and 9, then 2 against 3. If 2 passes and 3 fails, the ====="
	log "===== layout is fine and only the operand value is still mesa's.   ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
