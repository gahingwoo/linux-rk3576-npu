#!/bin/sh
# ---------------------------------------------------------------------------
# 2026-08-08 round 23. Round 22 found the last k-dependent thing.
#
# The coefficient buffer sizes came back 206080, 75008 and 34048 bytes for k=5,
# 3 and 1, and mesa's own expression reproduces all three exactly:
#
#   bufsize = groups*64 + MAX2(wt_elems, 8192)*4 + 0x100,  wt_elems = ic*oc*k*k
#
# So that buffer is an A/B/C table of groups*64 = 1024 bytes followed by a FLOAT
# SURFACE region whose size is derived from the weight count, and therefore from
# the kernel. Its first 12 bytes are identical across all three, which is the
# A values, as expected from a shared bias tensor.
#
# That region is the only k-dependent thing left. Everything else about these
# three models is either verified identical or verified correct against a vendor
# .rknn compiled at the same geometry: the regcmd in absolute terms, the weight
# layout including the 32-channel grouping, the bias tensor, the requant, and A,
# B and C. And mesa's comment says the size is a guess, "a float region bounded
# by the full weight count", with the content left zeroed and the real content a
# TODO.
#
# ROCKET_FS_ELEMS overrides that element count, so the three models can be given
# a byte-identical coefficient buffer with only the kernel differing.
#
#   2  the three constant-input baselines with FS_ELEMS forced to 51200, which
#      is the k=5 value. If k=3 and k=1 start behaving like k=5, the float
#      surface region is the k dependence.
#   3  the same on real inputs.
#   4  ⚠ THE CONTROL: conv2d-cal with FS_ELEMS forced SMALL, 8192. It computes
#      correctly today, so shrinking a region the hardware reads should change
#      something. If nothing changes anywhere in this round, the knob is not
#      load bearing and the answer is elsewhere.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }

flat() { m="$1"; shift; env TEFLON_LIB=/usr/lib/libteflon.so "$@" \
	python3 "$NPU_DIR/flatin.py" "$NPU_DIR/$m" > "$C" 2>&1; }
many() { m="$1"; n="$2"; shift 2; env TEFLON_LIB=/usr/lib/libteflon.so "$@" \
	python3 "$NPU_DIR/test_model.py" "$NPU_DIR/$m" "$n" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	# -n 8 floods the serial console and wedges the box. Learned the hard way.
	dmesg -n 4 2>/dev/null

	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null
	log ""
	log "  task_con16=$(cat /sys/module/rocket/parameters/task_con16 2>/dev/null)"

	log ""
	log "===== 1) CONTROL: conv2d-cal computes ====="
	many conv2d-cal.tflite 2

	log ""
	log "===== 2) constant input, all three with FS_ELEMS = 51200 (the k=5 value) ====="
	log "  makes the coefficient buffer identical; only the kernel differs"
	sleep 2
	flat conv2d-cal.tflite ROCKET_FS_ELEMS=51200
	flat cal_k3.tflite     ROCKET_FS_ELEMS=51200
	flat cal_k1.tflite     ROCKET_FS_ELEMS=51200

	log ""
	log "===== 3) real input, k=3 and k=1 with FS_ELEMS = 51200 ====="
	sleep 2
	many cal_k3.tflite 2 ROCKET_FS_ELEMS=51200
	many cal_k1.tflite 2 ROCKET_FS_ELEMS=51200

	log ""
	log "===== 4) THE CONTROL: conv2d-cal with FS_ELEMS forced SMALL (8192) ====="
	log "  it computes today, so shrinking a region the hardware reads should"
	log "  change something. Nothing changing anywhere means the knob is inert."
	sleep 2
	many conv2d-cal.tflite 2 ROCKET_FS_ELEMS=8192

	log ""
	log "===== 5) buffer sizes with the knob, to prove it fired ====="
	sleep 2
	rm -rf /tmp/fs; mkdir -p /tmp/fs; cd /tmp/fs || return 0
	env TEFLON_LIB=/usr/lib/libteflon.so ROCKET_DEBUG=dump_bos ROCKET_FS_ELEMS=51200 \
		python3 "$NPU_DIR/test_dw.py" "$NPU_DIR/cal_k3.tflite" > /dev/null 2>&1
	for f in /tmp/fs/mesa-biases-*.bin; do
		[ -f "$f" ] && python3 "$NPU_DIR/bstat.py" "$f" > "$C" 2>&1
	done
	log "  (k=3 was 75008 bytes without the knob; 206080 means it fired)"
	cd / || return 0

	log ""
	log "===== 6) REPEAT CONTROL: conv2d-cal untouched ====="
	sleep 2
	many conv2d-cal.tflite 2

	log ""
	log "===== Read 5 first for whether the knob fired, then 2.              ====="
	sync
}

case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
