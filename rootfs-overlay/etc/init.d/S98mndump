# ---------------------------------------------------------------------------
# 2026-08-09 round 35. It is not a float. Find which BITS of that word matter.
#
# Round 34's round trip passed, so the knob is sound, and it also explains why
# round 33 failed: the real word is 0xc2db1a44 and the string "-109.55" parses
# to a different low mantissa. Every value swept in round 33 missed the low bits.
#
# The probes derived from the real word:
#   exact             0xc2db1a44   128/128
#   sign flipped      0x42db1a44   128/128
#   exponent + 1      0xc35b1a44   128/128
#   mantissa cleared  0xc2800000     0/128
#   LOW BYTE cleared  0xc2db1a00     0/128
#   zero              0x00000000     0/128
#
# Flipping the sign and doubling the value change nothing, and clearing the low
# byte, worth 0.0005 as a float, destroys every channel. No float is read that
# way. The upper bits look like don't care and the low bits look like a field.
#
# So take the word apart. Every probe keeps the low byte 0x44 or moves exactly
# one field, so each result names a bit range.
#
# DECISION RULE, written before the run:
#   0x00000044 passes            ONE BYTE is the whole thing, and the fix is to
#                                write a single known byte, not a float surface
#   0x00000044 fails but
#     0xffffff44 passes          the low byte matters and the upper bits must be
#                                nonzero but not any particular value
#   bits8_15 / bits16_22 fail    those fields matter too; the passing set is the
#                                answer, read it off the table
#   only the exact word passes   every low bit matters, so it is data after all
#                                and the next step is what mesa computes into it
#   step 1 or the exact-word
#     round trip fails           the build is wrong, stop
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
base() { env TEFLON_LIB=/usr/lib/libteflon.so ROCKET_FS_FLOATS=1 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > "$C" 2>&1; }
one() { log ""; log "===== FS_F0 = $2   ($1) ====="; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so ROCKET_FS_FLOATS=1 \
	ROCKET_FS_KEEP=4 ROCKET_FS_F0="$2" \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== 1) BASELINE: must be 128/128 ====="
	base

	log ""
	log "===== 2) the real word again, the round trip that must hold ====="
	one "exact, known good" 0xc2db1a44

	# Strip the upper bits away, a field at a time.
	one "low byte only"        0x00000044
	one "upper bits all ones"  0xffffff44
	one "clear bits 8..15"     0xc2db0044
	one "clear bits 16..22"    0xc2801a44
	one "clear sign+exponent"  0x005b1a44

	# Move the low byte itself, keeping everything above it.
	one "low byte 0x45"        0xc2db1a45
	one "low byte 0x04"        0xc2db1a04
	one "low byte 0x40"        0xc2db1a40
	one "low byte 0xff"        0xc2db1aff

	log ""
	log "===== 12) CONTROL that can fail: baseline again ====="
	sleep 2
	base

	log ""
	log "===== Read step 2 first, it must pass. Then: does 0x00000044     ====="
	log "===== alone work? That would make this one byte, not a surface.  ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
