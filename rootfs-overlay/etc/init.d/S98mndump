# ---------------------------------------------------------------------------
# 2026-08-11 round 76. Chaining, with both halves now known good.
#
# Round 75 closed depthwise. Every default passed and every control failed in
# exactly the way it was recorded to:
#
#   defaults   dw 32ch 32/32 x3, dw 1024ch 1024/1024 x4, six regular shapes,
#              whole model 2/2
#   controls   STAGE_ALL 0/32 with 1 x12 then 200,200
#              DW_GROUP=1024 0/1024 with live 448..575
#              DW_OW_CFG old constant 992/1024 with live 0..991
#              DW_REC64 5/32 with 0 COMPUTED and every row at 255
#
# So chaining is the last thing between this driver and MobileNet, and it can
# now be tested properly for the first time, because until yesterday one half
# of every chain was broken on its own and nothing could be attributed.
#
# mn_conv0dw1 is the ladder: it is exactly CONV_2D then DEPTHWISE_CONV_2D, and
# both operators are in this run on their own as mn_conv0 and mn_dw1. If both
# halves pass alone and the chain does not, the fault is the handoff between
# them and nothing else, which is a much smaller thing than "chaining is
# broken".
#
# dwconv and conv2x are longer chains, six and nine tensors, and are here for
# context rather than attribution.
#
# Nothing in the driver changed this round.
#
# DECISION RULE, written before the run:
#   the chain passes              chaining works now and MobileNet is next
#   both halves pass, chain does   the handoff is the fault: the intermediate
#     not                         buffer, its layout, or the second task's
#                                 input address
#   mn_conv0 alone fails          it is not chaining, and that comes first
#   mn_dw1 alone fails            the depthwise close regressed, and that comes
#                                 first
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
p() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== 1..2) the two halves, each on its own ====="
	p mn_conv0.tflite ""
	p mn_dw1.tflite ""

	log ""
	log "===== 3) the same two, chained ====="
	p mn_conv0dw1.tflite ""

	log ""
	log "===== 4..5) longer chains, for context ====="
	p dwconv.tflite ""
	p conv2x.tflite ""

	log ""
	log "===== 6..7) regular shapes, so a regression cannot hide ====="
	p conv2d-cal.tflite ""
	p mn_pw2.tflite ""

	log ""
	log "===== 8) the 1024 channel depthwise, likewise ====="
	p mn_dw25.tflite ""

	log ""
	log "===== 9) whole model ====="
	sleep 2
	env TEFLON_LIB=/usr/lib/libteflon.so \
		python3 "$NPU_DIR/test_model.py" "$NPU_DIR/conv2d-cal.tflite" 2 > "$C" 2>&1

	log ""
	log "===== Read 1 and 2 before 3. A chain whose halves do not pass    ====="
	log "===== separately says nothing about chaining.                    ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
