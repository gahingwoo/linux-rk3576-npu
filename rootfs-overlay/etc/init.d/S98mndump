# ---------------------------------------------------------------------------
# 2026-08-21 round 287. Stop deriving it. The table is the measurement.
#
# 286 FIXED TWO AND MISSED ONE, AND THE MISS IS INSTRUCTIVE. N = 24 went to
# 24 of 24 and N = 40 to 40 of 40, both from the block and slot rule, and every
# other geometry held. N = 56 came back 48 of 56 with exactly ONE group wrong:
#
#   g0 8/8  g1 8/8  g2 8/8  g3 8/8  g4 0/8  g5 8/8  g6 8/8
#
# The rule put g4 at 1024 and --map, swept in the same boot so the miss cost no
# round, found it at 704. Slots 1 and 3 of that last block were right and slot 0
# was not, which is not a thing a wrong stride does.
#
# ⚠ TWO CLOSED FORMS HAVE NOW BEEN FITTED TO THIS AND BOTH DIED IN ONE ROUND.
# wbytes/4 in 284, which also broke three working geometries. "The last block
# takes the odd slots" in 286. Written as (block, slot) the skeleton is regular
# and K independent, and WHICH slots is not:
#
#   G=2  (0,0)(0,1)                    G=6  (0,0)(0,2)(1,0)(1,2)(2,0)(2,1)
#   G=3  (0,0)(0,2)(0,3)               G=7  (0,0)(0,2)(1,0)(1,2)(1,3)(2,1)(2,3)
#   G=4  (0,0)(0,2)(1,0)(1,1)          G=8  (0,0)(0,2)(1,0)(1,2)(2,0)(2,2)(3,0)(3,1)
#   G=5  (0,0)(0,2)(1,0)(1,1)(1,3)
#
# G=5's three group block is {0,1,3} and G=7's is {0,2,3}. G=7's last block is
# {1,3} where every other last block of two is {0,1}. Any rule covering both is
# a rule fitted to one point each, which is what 284 and 286 were.
#
# So the packer holds the measurement and refuses outside it. --map has now
# swept the whole buffer at every N that is a multiple of 8 up to 64, and the
# table reproduces all eight tables including K = 32, where only the block
# stride 8*K changes and the slot pattern does not.
#
# THE READING RULE, fixed before the run.
#
#   ⚠ THIS ROUND IS ALL REGRESSION AND THAT IS THE POINT. Eight geometries, and
#   the packer's addressing was replaced rather than adjusted. Every one has been
#   exact at some point in the last three rounds but never all at once.
#
#     all eight exact       int4 is closed for every N that is a multiple of 8
#                           up to 64, at K of 32 and 64, M = 1, with no override
#     any one short         the table was transcribed wrong, and the per group
#                           line says which G to re-read off its --map grid
#
#   ENTRIES 10 AND 11 EXTEND IT rather than test it. --map at N = 72 and N = 8,
#   which are G = 9 and G = 1 and have never been swept. The packer refuses both,
#   so these produce a grid and nothing else; they are what the next round would
#   need to widen the table.
#
#   ⚠ N = 72 IS ALSO PAST WHERE 0x3020 HAS BEEN CHECKED. It emits 143 there and
#   the largest ever measured is 111. If the grid comes back empty or short that
#   is the first thing to suspect, not the layout.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
MM=/opt/charsiu/charsiu_matmul
CH=/opt/charsiu/charsiu_int4
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

c() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $*"; return 0; }
	before=$(nbad)
	sleep 1
	env $1 $2 $3 $4 $5 $6 $7 $8 $9 > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This arm is VOID."; health; }
	return 0
}

M4="CHARSIU_W4=1 CHARSIU_W4_HALFK=1"

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	if [ -w /sys/module/rocket/parameters/reset_autosuspend ]; then
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend
		log "reset_autosuspend = $(cat /sys/module/rocket/parameters/reset_autosuspend)"
	else
		log "!! reset_autosuspend NOT WRITABLE. A timeout will kill the round."
	fi

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "##### eight geometries. all of them, at once, for the first time.  #####"
	for nn in 16 24 32 40 48 56 64
	do
		log ""
		log "===== N = $nn  K = 64"
		c "$M4" X=1 $MM 1 64 $nn
	done
	log ""
	log "===== N = 64  K = 32                                               ====="
	c "$M4" X=1 $MM 1 32 64

	log ""
	log "===== 9) the control that must FAIL, and int8                      ====="
	c "CHARSIU_W4=1" X=1 $MM 1 64 64
	c X=1 X=1 $MM 1 64 64

	log ""
	log "##### widen the table: two G that have never been swept            #####"
	log ""
	log "===== 10) --map at N = 72, G = 9.  0x3020 emits 143 here.          ====="
	c X=1 X=1 $CH 1 64 72 --map 8
	log ""
	log "===== 11) --map at N = 8, G = 1                                    ====="
	c X=1 X=1 $CH 1 64 8 --map 8

	log ""
	log "===== the anchor again                                             ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== eight exact closes int4 at M = 1 for N a multiple of 8.      ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
