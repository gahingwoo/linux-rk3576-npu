#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-23 round 368. THE CPU'S 37 MILLISECONDS.
#
# 🏁 ROUND 367 ITEMISED THE TOKEN, and every prediction it wrote down held.
#
#   int4 two devices, sized buffers   9.86 tok/s   sum 9.2 ms   flush 3.4 ms
#   the same, no output flush        10.26 tok/s   sum 9.1      flush 0.02
#   one device                        8.40 tok/s   sum 9.2      flush 3.2
#
# All four sentences word for word identical, INCLUDING the arm that skipped
# the cache clean. The prediction was "maybe 9 summing and 4 flushing"; it read
# 9.2 and 3.4. **The flush is gone for good now -- default, and
# CHARSIU_NPU_FINI puts it back.**
#
# AND THE STAGE TABLE RAN, its total 100.3 ms against the run's own 100.6, so
# it is generation and not prompt (the round 327 trap, checked):
#
#   q k v 13.61   o proj 9.69   gate + up 26.89   down 26.36   head 10.41
#   attention 7.67   silu * up 3.08   rope + kv copy 1.79   the rest 0.76
#
# Which splits a 97.5 ms token three ways:
#
#     60.2  the fence            at 9.3 GB/s, which IS the measured ceiling
#     23.5  npudev's own rest    sum 9.1, submit 3.2, and 11 ms of wrapper
#     13.3  the pure CPU stages  attention 7.7, silu 3.1, rope 1.8
#
# The fence is done. **This round goes after the other 37.**
#
# ---------------------------------------------------------------------------
# WHAT CHANGED
# ---------------------------------------------------------------------------
#
# EXACT, ON BY DEFAULT, NO SWITCH -- the arithmetic is unchanged, so the tokens
# cannot move:
#
#   1. ONE ROPE ANGLE TABLE A TOKEN. theta depends on the dimension pair and
#      the position and on nothing else, so cosf and sinf were being asked for
#      the same 32 numbers 640 times over: 40 head passes times 16 layers.
#   2. EACH SLICE'S GROUP SCALES GATHERED CONTIGUOUSLY WHEN THE TENSOR IS
#      STAGED. The sum walked scale[channel * ngroups + group], eight cache
#      lines apart on the down projection and unvectorisable everywhere.
#
# EXACT, ON BY DEFAULT, WITH A CONTROL:
#
#   3. ATTENTION OVER THE POOL. Each head writes its own slice of xb and its
#      own row of att, and the sum over t inside a head keeps its order, so
#      four threads change nothing but the wall clock. CHARSIU_CPU_PLAIN=1
#      puts it back on the calling thread.
#   4. NO CLEAN ON THE OUTPUT BUFFERS (round 367's result, now the default).
#      CHARSIU_NPU_FINI=1 puts it back.
#   5. NO PREP ON THE ACTIVATION BUFFER. The device only READS it, so there is
#      no write fence to wait on, and the CPU is about to overwrite every byte
#      the next job will read, so there is nothing stale worth dropping. Its
#      fini stays. That is 130 ioctls and 130 cache walks a token.
#      CHARSIU_NPU_INPREP=1 puts them back. ⚠ This one is an ARGUMENT, like the
#      flush was, and the sentence is the check on it.
#
# OPT IN, BECAUSE IT MOVES TOKENS:
#
#   6. CHARSIU_FAST_SILU. A NEON exp, accurate to about one last bit where
#      glibc's expf is correctly rounded -- so the vector path is the slightly
#      WORSE of the two, and on the host it turned "Claude Monet painted the
#      water lilies" into "Claude Monet was born in Paris" at token 25. Neither
#      is wrong. What it costs is the anchor every round since 352 has quoted.
#
# AND ONE QUESTION THIS RUNTIME HAS NEVER ASKED:
#
#   7. CHARSIU_CPUS. RK3576 is four A53 at 0..3 and four A72 at 4..7. In NPU
#      mode the pool is nearly idle -- every projection returns from the
#      CALLING thread -- so the whole CPU side is ONE thread, and nothing has
#      ever told the scheduler which core that thread deserves.
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# THE SENTENCE FIRST. Entries 1, 2 and 3 must be round 367's Louvre sentence
# and must match EACH OTHER. **Entry 4 is expected to differ** -- that is what
# the fast exp does, it is documented above, and it is a measurement rather
# than a failure. Entry 3 is the control: if only 1 and 2 drift, the suspect is
# the activation prep, which is the one argument in this round nobody has run.
#
# THEN THE STAGE TABLE, entry 1 against round 367's rows quoted above.
# ⚠ THE ROPE TABLE IS BUILT INSIDE THE TOKEN EMBEDDING WINDOW. So "rope + kv
# copy" should collapse to the memcpy alone and "token embedding" should rise
# off zero. Read the two together or the table will look like it lost time.
# ⚠ AND CHECK THE TOTAL against the run's own generation time again first.
#
# THEN THE STAT LINE: summing was 9.1 ms a token, flush already 0.
#
# THEN ENTRY 2 AGAINST ENTRY 1. That is the only thing in this round that
# could be large and is entirely outside my hands: if pinning to the four A72s
# is worth several milliseconds, the CPU side has been running on a little
# core all along and every CPU number this project has ever printed was taken
# at half rate.
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT
# ---------------------------------------------------------------------------
#
# rope to 0.05, attention to about a quarter of 7.67, the sum from 9.1 to
# maybe 5, the wrapper down by a millisecond or two from the missing ioctls.
# Call it 97.5 -> 85 ms, which is 11.7 tok/s. The A72 arm I have no prior on.
# The fast exp should be worth 2.5 ms of the 3.08 and cost the anchor.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
VD=/opt/charsiu/charsiu_vendor
V=/opt/charsiu/vendor
RGC=$V/vendor-int4-k2048-n1024.regcmd
WT=$V/vendor-wt-1M.bin
IN=$V/vendor-in.bin
RUN=/opt/charsiu/charsiu_run
M8=/opt/charsiu/models/Llama-3.2-1B-Instruct-Q8_0.gguf
PROMPT="The capital of France is"
LIMIT=420
# 32 tokens does not reach the answer to "17 times 24, show your working"
NGEN=64
CE=CHARSIU_COEF_ELEMS=65536
HEAD=CHARSIU_NPU_MAXN=131072
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block did not come back this time."
		ABORT=1
	fi
}

capped() {
	lim="$1"; shift
	"$@" &
	pid=$!
	i=0
	while [ "$i" -lt "$lim" ]; do
		kill -0 "$pid" 2>/dev/null || { wait "$pid"; return $?; }
		sleep 1
		i=$((i + 1))
	done
	kill -9 "$pid" 2>/dev/null
	wait "$pid" 2>/dev/null
	return 124
}
rung() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $1"; return 0; }
	lbl="$1"; shift
	before=$(nbad)
	log ""
	log "  -- $lbl"
	sleep 1
	capped "$LIMIT" env "$@" "$RUN" "$M8" -p "$PROMPT" -n "${NGEN:-32}" \
		--ignore-eos -q -c 512 -t 4 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the rung exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This rung is VOID."; health; }
	return 0
}
# arm: <label> <regcmd-or-dash> <byte> <high> [extra env, one assignment]
#
# ⚠ THE ENV GOES IN AS AN ARGUMENT, not as a "VAR=x arm ..." prefix. Whether an
# assignment before a FUNCTION call survives the call is unspecified -- dash
# drops it, other shells keep it -- and the arm whose whole job is to time out
# WITHOUT the trailer runs right after the one that has it. Not a question worth
# leaving to the shell.
arm() {
	before=$(nbad)
	log ""
	log "  ---- $1"
	sleep 1
	env ${5:-IGNORED=1} $VD "$2" "$WT" "$IN" "$3" "$4" 4096 > /tmp/vd.txt 2>&1
	cat /tmp/vd.txt > "$C"
	after=$(nbad)
	if [ "$after" != "$before" ]; then
		log "  !! POISONED: $((after - before)) new fault or timeout lines"
		health
		# ⚠ NOT a round abort. Round 342 threw away every arm after the
		# first poisoning and then measured the block healthy at the
		# end. The block recovers; give it a moment and carry on.
		ABORT=0
		sleep 2
	fi
}

# two concurrent probes, so the pair can be repeated without copy and paste
pair() {
	before=$(nbad)
	log ""
	log "  ---- $1"
	env CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_TIME=60 CHARSIU_OUT_KB=64 $2 $VD - "$WT" "$IN" 0 0 4096 > /tmp/vdA.txt 2>&1 &
	pidA=$!
	env CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_TIME=60 CHARSIU_OUT_KB=64 $3 $VD - "$WT" "$IN" 0 0 4096 > /tmp/vdB.txt 2>&1 &
	pidB=$!
	wait "$pidA"
	wait "$pidB"
	log "    A:"
	grep -E "M = |TIME:|baseline:|VERIFY:|CONTROL repeat|VOID|REREAD" /tmp/vdA.txt > "$C"
	log "    B:"
	grep -E "M = |TIME:|baseline:|VERIFY:|CONTROL repeat|VOID|REREAD" /tmp/vdB.txt > "$C"
	after=$(nbad)
	[ "$after" != "$before" ] && log "  !! POISONED: $((after - before)) new lines"
	return 0
}

start() {
	log ""
	log "###############################################################"
	log "##### round 368: the CPU's 37 milliseconds                 #####"
	log "###############################################################"
	log "  the fence is at its ceiling. this round is everything else."

	log ""
	log "===== 1) everything on, with the stage table                   ====="
	log "  sentence must be round 367's. check the table total against"
	log "  the run's own generation time before reading a row."
	rung "int4 g1024, two devices, stages" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 CHARSIU_NPU_W4V=1 CHARSIU_NPU_KMAX=1024 CHARSIU_NPU_W4_GROUP=1024 CHARSIU_STAGES=1 "$CE" "$HEAD"

	log ""
	log "===== 2) the same, pinned to the four A72s                     ====="
	log "  cores 0-3 are A53 and 4-7 are A72. nothing has ever said"
	log "  which one the single CPU thread of a token should be on."
	rung "int4 g1024, CPUS=4-7" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 CHARSIU_NPU_W4V=1 CHARSIU_NPU_KMAX=1024 CHARSIU_NPU_W4_GROUP=1024 CHARSIU_STAGES=1 CHARSIU_CPUS=4-7 "$CE" "$HEAD"

	log ""
	log "===== 3) THE CONTROL: the three switchable ones put back       ====="
	log "  serial attention, the output clean, the activation prep."
	log "  the rope table and the scale gather stay: they are exact."
	rung "int4 g1024, round 367 behaviour" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 CHARSIU_NPU_W4V=1 CHARSIU_NPU_KMAX=1024 CHARSIU_NPU_W4_GROUP=1024 CHARSIU_STAGES=1 CHARSIU_CPU_PLAIN=1 CHARSIU_NPU_FINI=1 CHARSIU_NPU_INPREP=1 "$CE" "$HEAD"

	log ""
	log "===== 4) the fast exp. THIS ONE IS EXPECTED TO CHANGE WORDS.   ====="
	log "  read the silu row, not the sentence. a different sentence"
	log "  here is the documented cost, not a fault."
	rung "int4 g1024, CPUS=4-7, fast silu" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 CHARSIU_NPU_W4V=1 CHARSIU_NPU_KMAX=1024 CHARSIU_NPU_W4_GROUP=1024 CHARSIU_STAGES=1 CHARSIU_CPUS=4-7 CHARSIU_FAST_SILU=1 "$CE" "$HEAD"

	log ""
	log "===== 5) the probe, still exact                                ====="
	arm "solo verify" "-" 0 0 "CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_VERIFY=1 CHARSIU_OUT_KB=64"

	log ""
	log "===== 6) the anchor: int8 conv must still be exact            ====="
	health

	log ""
	log "===== read the CONTROL lines first. VOID means the arm died. ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
