# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-21 round 292. Slot 2 is wrong at M > 1, and the weight map has never
# been swept at M > 1.
#
# ⚠ THE ATOM FIX LANDED. Sixteen bytes was right: at M = 2, N = 16 row 0 came
# back with NO mismatches at all, where it had been 4 of 8 a group. Every M = 1
# geometry still exact, three rounds of reader changes and no regression.
#
# ⚠ AND THE MISMATCH LIST NAMED THE REST. At M = 2 and M = 4, N = 64, row 0
# fails on channels 8-15, 24-31 and 40-47, which are groups g1, g3 and g5.
# Against the packer's own (block, slot) placement:
#
#   fails   g1 (0,2)   g3 (1,2)   g5 (2,2)          every slot 2 group
#   passes  g0 (0,0)   g2 (1,0)   g4 (2,0)   g6 (3,0)   g7 (3,1)
#
# and N = 16 has no slot 2 group at all, which is why its row 0 was perfect.
# SLOT 2 IS WRONG AT M > 1 and the other slots are not.
#
# ⚠ THE WEIGHT MAP HAS ONLY EVER BEEN SWEPT AT M = 1. Every base in the table,
# all eleven geometries of it, was read with one row. So this round sweeps
# --map at M = 2 rather than reasoning about why one slot moved. That is the
# instrument that settled the layout, twice, after two closed forms guessed at
# it and were refuted.
#
# ⚠ THE PARTIAL GROUP IS SOLVED AND IT IS NOT A PLACEMENT FAULT EITHER. Pulling
# the per CHANNEL map out of 290's sweeps rather than just the group leaders:
#
#   N = 20  the hardware's live channels are 0-11 and 16-23. Bytes 160-191 are
#           dead, and the packer puts logical channels 12-15 in them.
#   N = 36  live channels are 0-19 and 24-39. Bytes 544-575 are dead and
#           logical 20-23 go there.
#
# Both match the mismatch lists exactly, 12 13 14 15 and 20 21 22 23. When N is
# not a multiple of 8 the hardware does not put the short group LAST, it puts it
# in the middle, and its channel numbering runs on past the gap. Two points, no
# rule written.
#
# THE READING RULE, fixed before the run.
#
#   ⚠ ENTRY 5 IS THE ROUND. --map at M = 2, N = 64, the whole buffer.
#
#     the bases move          the weight layout depends on M and the table needs
#                             an M term. Read the new bases off the grid.
#     the bases are identical  the weights are placed right and slot 2's failure
#                             is on the read or the output side, and entry 6's
#                             M = 2 N = 16 grid says which since that shape
#                             works
#     slot 2's group is dead   the hardware stops fetching it at M > 1, which is
#                             a fetch bound and not an address
#
#   ENTRIES 2 TO 4 are the M = 1 regression, unchanged.
#
#   ENTRY 7 runs M = 2 at N = 24, which is G = 3 with slots (0,0)(0,2)(0,3), so
#   it has a slot 2 AND a slot 3. If slot 3 also fails the fault is "not slot 0
#   or 1"; if only slot 2 does, it is slot 2 alone.
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
MM=/opt/charsiu/charsiu_matmul
CH=/opt/charsiu/charsiu_int4
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

c() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $*"; return 0; }
	before=$(nbad)
	sleep 1
	env $1 $2 $3 $4 $5 $6 $7 $8 $9 > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This arm is VOID."; health; }
	return 0
}

M4="CHARSIU_W4=1 CHARSIU_W4_HALFK=1"

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	if [ -w /sys/module/rocket/parameters/reset_autosuspend ]; then
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend
		log "reset_autosuspend = $(cat /sys/module/rocket/parameters/reset_autosuspend)"
	else
		log "!! reset_autosuspend NOT WRITABLE. A timeout will kill the round."
	fi

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "##### the M = 1 regression                                         #####"
	for nn in 16 64 88
	do
		log ""
		log "===== M = 1  N = $nn"
		c "$M4" X=1 $MM 1 64 $nn
	done

	log ""
	log "##### THE ROUND. the weight map at M = 2. Never swept above M = 1. #####"
	log ""
	log "===== 5) --map  M = 2  N = 64                                      ====="
	c X=1 X=1 $CH 2 64 64 --map 8
	log ""
	log "===== 6) --map  M = 2  N = 16, the shape whose row 0 is perfect     ====="
	c X=1 X=1 $CH 2 64 16 --map 8

	log ""
	log "##### and the matmuls beside them, for the mismatch lists          #####"
	log ""
	log "===== 7) M = 2  N = 24, which has a slot 2 AND a slot 3            ====="
	c "$M4" X=1 $MM 2 64 24
	log ""
	log "===== 8) M = 2  N = 64                                             ====="
	c "$M4" X=1 $MM 2 64 64
	log ""
	log "===== 9) M = 2  N = 16                                             ====="
	c "$M4" X=1 $MM 2 64 16

	log ""
	log "===== 10) the control that must FAIL, and int8 at M = 1 and M = 4  ====="
	c "CHARSIU_W4=1" X=1 $MM 1 64 64
	c X=1 X=1 $MM 1 64 64
	c X=1 X=1 $MM 4 64 64

	log ""
	log "===== the anchor again                                             ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== entry 5's bases against the M = 1 table. That is the round.  ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
