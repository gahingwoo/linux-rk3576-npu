# ---------------------------------------------------------------------------
# 2026-08-09 round 38. The constant is now the DEFAULT. Try everything that
# has never worked.
#
# Round 37, both baselines clean:
#   0x1004  conv2d-cal   128/128     the smallest word the rule allows, never
#                                    run before, so this was a prediction
#   0x3fc4  conv2d-cal   128/128     every free bit set
#   0x1005  conv2d-cal     0/128     near miss, as predicted
#   0x0fc4  conv2d-cal   128/128     ⚠ predicted to FAIL. The rule's second
#                                    clause was wrong and is refitted below.
#   0x1004  cal_s1       128/128
#   0x1004  cal_oc16      16/16      oc=16, so a different offset too
#   cal_k3  baseline       0/128
#   0x1004  cal_k3       128/128     <-- THE 3x3 KERNEL COMPUTES
#
# ⚠ The kernel size was never the dividing line. rkt_coefs.c filled that word
# with a dequantised weight, so whether a model worked came down to whether its
# FIRST WEIGHT happened to carry the right bits. conv2d-cal's did, cal_k3's did
# not, and every round that tried to explain k=5 against k=3 was chasing that
# coincidence.
#
# Refitted against all 24 words:
#     (w & 0x3f) == 0x04   and   ((w >> 6) & 0xff) >= T,  0x21 < T <= 0x3f
#
# mesa now writes 0x1004 there by default and nothing else in the region. The
# buffer SIZE is deliberately left alone this round, so content is the only
# thing that changed.
#
# DECISION RULE, written before the run:
#   1 and 2 both 128/128        the default reproduces the tested state
#   cal_k1 computes             the 1x1 kernel was the same coincidence
#   depthwise computes          so was that
#   the chain computes          so was that, and MobileNet becomes reachable
#   any of them still fails     it has a separate cause, and now it can be
#                               attacked without the weight-bit confound
#   1 or 2 not 128/128          the build is wrong, stop and check the image
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
perch() { log ""; log "===== $1: $2 (default, constant word) ====="; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$2" > "$C" 2>&1; }
many() { log ""; log "===== $1: $2 whole-model ====="; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so \
	python3 "$NPU_DIR/test_model.py" "$NPU_DIR/$2" 2 > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== 1) the new DEFAULT on the model that always worked ====="
	perch 1 conv2d-cal.tflite

	log ""
	log "===== 2) the new DEFAULT on the 3x3 that never worked ====="
	perch 2 cal_k3.tflite

	log ""
	log "===== 3..6) everything else that has never worked ====="
	perch 3 cal_k1.tflite
	perch 4 cal_s1.tflite
	perch 5 cal_oc16.tflite
	perch 6 cal_izp0.tflite

	log ""
	log "===== 7) whole-model numbers, for the record ====="
	many 7 conv2d-cal.tflite
	many 8 cal_k3.tflite

	log ""
	log "===== 9) the old float surface, to show the difference ====="
	sleep 2
	env TEFLON_LIB=/usr/lib/libteflon.so ROCKET_FS_FLOATS=1 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/cal_k3.tflite" > "$C" 2>&1
	log "  cal_k3 with the old surface: this is the 0/128 that stood all along"

	log ""
	log "===== 10) CONTROL that can fail: default on conv2d-cal again ====="
	perch 10 conv2d-cal.tflite

	log ""
	log "===== Read 1 and 10 first, then 2. If cal_k3 is 128/128 with no    ====="
	log "===== knobs set, the kernel size wall is gone.                     ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
