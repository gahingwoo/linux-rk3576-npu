#!/bin/sh
# ---------------------------------------------------------------------------
# 2026-08-08 round 20. Round 19 was VOID again and the guard caught it cleanly.
#
#   k=5 impulse   npu distinct=1 min=128 max=128   cpu distinct=128 128..255
#   k=3 impulse   npu distinct=1 min=128 max=128   cpu distinct=128 128..255
#
# The rescale worked on the CPU side and mesa recomputed the requant, shift 25
# to 22, and the NPU still returned exactly 128. So the output scale was not the
# real problem: the impulse KERNEL is badly conditioned. It needs 399 taps
# sitting exactly at the weight zero point to cancel against one live tap, and
# mesa stores weights as w - 0x80 with the B operand doing that correction, so
# the signal is a four hundredth of a large cancellation. It fails at k=5 too,
# which is the kernel size that computes correctly, so it was never going to
# measure anything.
#
# Put the impulse in the INPUT instead and keep the real kernel. Nothing has to
# cancel, the model is the one that already computes, and the response to a
# single raised input pixel IS the kernel footprint. Where that footprint lands
# says which output pixels an input pixel reached:
#
#   out[y][x] responds iff  stride*y + ky - pad_top == y0  for some tap ky
#
#   2  k=5, THE CONTROL: this computes, so its footprint is the reference for
#      what a correct one looks like, and the CPU footprint in the same run is
#      a second reference.
#   3  k=3: same measurement. A footprint in the wrong place or of the wrong
#      extent names the mis-pairing; no response at all says the input never
#      reaches the MAC for k=3.
#
# ⚠ Both steps print the CPU footprint alongside, so a step that shows nothing
# on both sides is a broken probe rather than a hardware fact.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	# -n 8 floods the serial console and wedges the box. Learned the hard way.
	dmesg -n 4 2>/dev/null

	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null
	log ""
	log "  task_con16=$(cat /sys/module/rocket/parameters/task_con16 2>/dev/null)"

	log ""
	log "===== 1) CONTROL: conv2d-cal computes ====="
	env TEFLON_LIB=/usr/lib/libteflon.so \
		python3 "$NPU_DIR/test_model.py" "$NPU_DIR/conv2d-cal.tflite" 2 > "$C" 2>&1

	log ""
	log "===== 2) k=5 INPUT IMPULSE, THE CONTROL: the reference footprint ====="
	log "  real kernel, nothing has to cancel. cpu and npu must agree here."
	sleep 2
	env TEFLON_LIB=/usr/lib/libteflon.so \
		python3 "$NPU_DIR/impulse_in.py" "$NPU_DIR/conv2d-cal.tflite" 20 20 > "$C" 2>&1

	log ""
	log "===== 3) k=3 INPUT IMPULSE: where does the response land ====="
	log "  wrong place or wrong extent names the mis-pairing;"
	log "  no response at all means the input never reaches the MAC"
	sleep 2
	env TEFLON_LIB=/usr/lib/libteflon.so \
		python3 "$NPU_DIR/impulse_in.py" "$NPU_DIR/cal_k3.tflite" 20 20 > "$C" 2>&1

	log ""
	log "===== 4) k=1 INPUT IMPULSE, for the third kernel size ====="
	sleep 2
	env TEFLON_LIB=/usr/lib/libteflon.so \
		python3 "$NPU_DIR/impulse_in.py" "$NPU_DIR/cal_k1.tflite" 20 20 > "$C" 2>&1

	log ""
	log "===== 5) k=5 again at a different impulse position, as a sanity check ====="
	sleep 2
	env TEFLON_LIB=/usr/lib/libteflon.so \
		python3 "$NPU_DIR/impulse_in.py" "$NPU_DIR/conv2d-cal.tflite" 30 14 > "$C" 2>&1

	log ""
	log "===== 6) REPEAT CONTROL: conv2d-cal ====="
	sleep 2
	env TEFLON_LIB=/usr/lib/libteflon.so \
		python3 "$NPU_DIR/test_model.py" "$NPU_DIR/conv2d-cal.tflite" 2 > "$C" 2>&1

	log ""
	log "===== Read 2 first: cpu and npu footprints must agree there. Then 3. ====="
	sync
}

case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
