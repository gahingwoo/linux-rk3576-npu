#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-19 round 250. Re-score the ledger, and pay a debt.
#
# WHY. Round 249 fixed the output stage's floor and retired the reference that
# hid it. 31 of the 133 models here have at least one operator with a nonzero
# output zero point, so every score they ever got was against max(cpu, out_zp),
# with both surfaces flattened the same way below it. We do not currently know
# which of them are correct. Deciding what to build next on top of that ledger
# is deciding on a number nobody has measured, so this round measures it.
#
# ⚠ I already got this wrong once today by assuming instead of measuring. I
# wrote in public that MobileNet was unaffected because every layer in it has
# an output zero point of zero. Its classifier convolution, op28, a 1x1 over
# 1024 channels to 1001, has an output zero point of 66. The graph output is a
# softmax whose zero point IS zero, so the 1000 of 1001 figure was not itself
# inflated, but everything upstream of it was floored and has not been
# re-measured. Entry 5 is that measurement.
#
# THE READING RULE, fixed before the run.
#
#   perch.py's primary reference is now the raw CPU output, so the headline
#   "N of M channels match" is already the honest score and readlog.py's match
#   column can be read directly. No second lookup.
#
#   Entries 1 and 2 are the anchor. conv2d-cal must reproduce round 249: 128 of
#   128 with the lift, and 0 of 128 with ROCKET_NO_LIFT=1. If it does not, the
#   image is not what I think it is and nothing below counts.
#
#   ⚠ EXPECT REGRESSIONS AND DO NOT EXPLAIN THEM AWAY. A model that scored well
#   before and scores badly now was probably never right; the old reference
#   just could not see it. That is the result, not a setback.
#
#   ⚠ conv2x and dwconv carry NEGATIVE output zero points, down to -128, so
#   their offset becomes out_zp - 0x80 - 128, as low as -384. This driver has
#   never written a value like that. Read those two as a question about the
#   fix's range, separately from the rest.
#
# PART B pays a promise. rfc-send-v7/reply-igor-clamp.eml said the 88 and 120
# sweep was queued for the next flash and I would send what it says either way.
# The board has been flashed three times since and it was in none of them.
# Both counts are discriminating: DIV_ROUND_UP(oc,16) is even for each while
# oc % 32 is nonzero, so the parity rule and the modulo rule disagree there.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
log() { echo "$@" > "$C"; }
w() { log ""; log "  -- $1   $2"; sleep 1; \
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null

	log ""
	log "===== 1-2) THE ANCHOR. Must reproduce round 249 or the round is void ====="
	w conv2d-cal.tflite ""
	w conv2d-cal.tflite "ROCKET_NO_LIFT=1"

	log ""
	log "===== 3-6) PART B, THE DEBT. 0x4050 at oc 88 and 120, each with the ====="
	log "=====      parity rule and with the modulo rule it replaced.        ====="
	log "=====      Both counts are discriminating. Owed to Igor since v7.   ====="
	w pw64x88w56.tflite ""
	w pw64x88w56.tflite "ROCKET_DPU4050_MOD32=1"
	w pw64x120w56.tflite ""
	w pw64x120w56.tflite "ROCKET_DPU4050_MOD32=1"

	log ""
	log "===== 7) MOBILENET END TO END. Its op28 has out_zp 66 and was       ====="
	log "=====    floored. The public 1000 of 1001 is measured downstream of ====="
	log "=====    that, on a softmax whose zero point is 0.                  ====="
	w mobilenet_v1_1.0_224_quant.tflite ""

	log ""
	log "===== 8+) THE RE-SCORE. Every model with a nonzero output zero      ====="
	log "=====     point, against the raw CPU output for the first time.     ====="
	for m in cal_izp0 cal_k1 cal_k3_imp cal_k5_imp cal_s1 pw2_zp128 \
	         md003 md003_80 md003_oc128 md003_s2 md011; do
		w "$m.tflite" ""
	done

	log ""
	log "===== NEGATIVE OUTPUT ZERO POINTS. offset goes as low as -384,      ====="
	log "=====   a value this driver has never written. Read separately.     ====="
	w add.tflite ""
	w conv2x.tflite ""
	w dwconv.tflite ""

	log ""
	log "===== the MobileNet layer slices, all out_zp 0 and 66               ====="
	for m in mn_L00 mn_L01 mn_L02 mn_L03 mn_L04 mn_L05 mn_L06 mn_L07 mn_L08 \
	         mn_L12 mn_L18 mn_L24 mn_L26; do
		w "$m.tflite" ""
	done

	log ""
	log "===== Read entries 1 and 2 first. Regressions here are results.     ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
