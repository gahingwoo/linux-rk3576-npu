#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-10 round 50. B is PER CHANNEL in the vendor. mesa has never used the
# per-channel zero point, although the interface has carried it all along.
#
# Round 49 established that the second-operand field takes different acceptable
# contents in the two configurations, so the difference is elsewhere in the
# surface. Decoding the vendor's A/B/C table found it:
#
#   sv_rgu B column   26 distinct values over 32 channels, -25 to 23, mean 0.16
#                     correlates with NOTHING: not bias, weight sum, A, C, scale
#   mesa              B = 0x80 - wt_zp, ONE value for the whole layer
#
# A small spread centred on zero is what 0x80 - wt_zp[oc] looks like when the
# per-channel zero points sit near 128, which is what an asymmetric uint8
# quantiser gives. And `pipe_tensor` carries a `zero_points` ARRAY beside
# `scales`; rkt_ml.c already tests it to decide whether a tensor is per-axis
# quantised. rkt_coefs.c has only ever read the scalar.
#
# ROCKET_B_PERCH uses zero_points[oc] when the array is present.
#
# DECISION RULE, written before the run:
#   2 is 128/128 and 1 is too    harmless on per-tensor models, as expected,
#                                since there the array is absent or uniform
#   any per-axis model improves  the per-channel zero point was a real missing
#                                term and the second operand puzzle may follow
#   dwconv moves again           depthwise is per-channel, so this is where it
#                                should show
#   2 regresses                  the array is not what this reading says, and
#                                the scalar was right
#   1 or 9 not 128/128           the build is wrong, stop
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
p() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== 1) BASELINE: must be 128/128 ====="
	p conv2d-cal.tflite ""

	log ""
	log "===== 2..4) per-channel B on the shapes that work ====="
	p conv2d-cal.tflite ROCKET_B_PERCH=1
	p cal_k3.tflite ROCKET_B_PERCH=1
	p cal_k1.tflite ROCKET_B_PERCH=1

	log ""
	log "===== 5..7) per-channel B where it should matter ====="
	p dwconv.tflite ROCKET_B_PERCH=1
	p mn_dw1.tflite ROCKET_B_PERCH=1
	p mn_pw24.tflite ROCKET_B_PERCH=1

	log ""
	log "===== 8) per-channel B together with the depthwise record ====="
	p dwconv.tflite "ROCKET_B_PERCH=1 ROCKET_DW_REC48=1"

	log ""
	log "===== 9) CONTROL that can fail: baseline again ====="
	p conv2d-cal.tflite ""

	log ""
	log "===== Read 1 and 9. Then 5: depthwise is per-channel quantised, so ====="
	log "===== if the missing zero point matters anywhere it is there.      ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
