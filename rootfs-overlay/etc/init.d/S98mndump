#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-10 round 45. Depthwise uses a 48-BYTE coefficient record, not 64.
#
# Captured from the vendor runtime with the single-variable pair sv_rgu and
# sv_dwu, ic = oc = 32 at 112x112, k=3, s=1, only `groups` differing, whose
# biases are known here exactly. Decoded with the same oracle as the .rknn work,
# control first:
#
# Round 44 said depthwise takes a float32 bias. That was WRONG, and reading the
# registers out of the capture is what corrected it: 0x5020 points at
# bo01+0x240, immediately after the 576-byte depthwise weight buffer, and NOT at
# the float bias at 0x3198, which is librknnrt's own copy. Decoding 0x240:
#
#   record 48 bytes:  A 8 x int32 at +0, C 8 x int16 at +32, NO B
#     A vs the known per-channel weight sum   corr +0.9696
#     C peaks at exactly 0x4000, 32 distinct  the layout's own signature
#   record 64 bytes (what mesa writes):
#     A corr -0.15, C maximum is not 0x4000   both collapse
#
# ⚠ This also corrects the two "no coefficient table for depthwise" results in
# FINDINGS.md. Both scans tried 64, 32 and 128 byte blocks and never 48.
#
# The two formats are mutually exclusive. And the register that selects between
# them is one this driver ALREADY SETS CORRECTLY: 0x501c is 0x0710 for a regular
# conv and 0x0510 for depthwise, which rkt_regcmd.c emits and which matched the
# vendor in the offline audit.
#
# So mesa has been telling the DPU to read that surface in depthwise mode and
# then filling it with the regular integer table. That is exactly round 43's
# measurement: dwconv fires and saturates to 6 distinct values against a
# 101-value reference, rather than producing nothing.
#
# ROCKET_DW_REC48 writes A and C in 48-byte records for depthwise layers.
#
# DECISION RULE, written before the run:
#   dwconv computes             the record size was the depthwise bug
#   dwconv moves but is wrong    the record is right and a term is not; compare
#                               the written A and C against the capture directly
#   dwconv unchanged at 0/16    the record size is not it either, and the next
#                               step is to diff mesa's written buffer against
#                               the captured one byte by byte
#   a regular conv regresses    the knob leaks outside depthwise, a bug in the
#                               knob rather than a finding
#   step 1 or 8 not 128/128     the build is wrong, stop
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
p() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== 1) BASELINE: conv2d-cal, must be 128/128 ====="
	p conv2d-cal.tflite ""

	log ""
	log "===== 2..3) depthwise as it is now, the 64-byte record ====="
	p dwconv.tflite ""
	p mn_dw1.tflite ""

	log ""
	log "===== 4..5) THE TEST: depthwise gets a 48-byte record ====="
	p dwconv.tflite ROCKET_DW_REC48=1
	p mn_dw1.tflite ROCKET_DW_REC48=1

	log ""
	log "===== 6) the chained model that contains a depthwise ====="
	p mn_conv0dw1.tflite ROCKET_DW_REC48=1

	log ""
	log "===== 7) the knob must NOT touch a regular conv ====="
	p conv2d-cal.tflite ROCKET_DW_REC48=1
	p cal_k3.tflite ROCKET_DW_REC48=1

	log ""
	log "===== 8) CONTROL that can fail: conv2d-cal plain again ====="
	p conv2d-cal.tflite ""

	log ""
	log "===== Read 1 and 8 first. Then 2 against 4: any movement off      ====="
	log "===== 0/16 means the record size was the depthwise bug.           ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
