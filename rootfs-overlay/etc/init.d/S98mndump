# ---------------------------------------------------------------------------
# 2026-08-11 round 80. Re-ask the requant question, now that conv0's MAC is on.
#
# Round 79 un-regressed conv0. Leaving the coefficient region zero for a first
# conv gives distinct 254 with 4 of 32 channels constant, the control
# ROCKET_FC_SCALE_TABLE reproduces the old distinct 1 with all 32 constant, and
# nothing else moved: conv2d-cal, cal_k3, cal_k1, cal_oc16, mn_dw1, mn_dw25 and
# the whole model are all exactly as they were.
#
# ⚠ AND ROUND 77'S CONCLUSION HAS TO BE WITHDRAWN. That round swept the OUT_CVT
# shift over 2^16, saw the output never move, and concluded the requant
# literals were innocent. But it ran while the MAC was EMPTY. An output of
# 128 plus the offset cannot respond to a requant sweep no matter what the
# requant is, because there is nothing to scale. The sweep proved the MAC was
# empty, which was worth knowing, and proved NOTHING about the requant.
#
# So ask it again with the accumulator alive. conv0 now produces a full range
# output, distinct 254 against the reference's 253, that disagrees everywhere,
# which is what a wrong requant multiplier looks like as much as anything else.
#
# The two candidates are on the table:
#
#   captured   scale 0x5391, shift 25, offset -2, which the comment beside them
#              says came from a live vendor conv0 capture on this board
#   computed   in_sc * wt_sc / out_sc = 0.007247 gives scale 0x76be at shift
#              22, the same expression the generic path uses for every other
#              shape, all of which are byte exact
#
# DECISION RULE, written before the run:
#   a sweep point makes conv0        the requant was it after all, and round
#     COMPUTED anywhere              77's withdrawal was necessary
#   the output moves but never       the requant is wrong AND something else
#     becomes correct                is too; the shape of the best point says
#                                    which direction
#   the output does not move at all  the requant really is innocent, this time
#                                    measured with a live MAC, and the next
#                                    round goes at the ARGB input path
#   any other model moves            that comes first
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
p() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== 1) conv0 as it stands, the baseline for this sweep ====="
	p mn_conv0.tflite ""

	log ""
	log "===== 2..6) the SHIFT, with the MAC alive this time ====="
	p mn_conv0.tflite ROCKET_FC_SHIFT=27
	p mn_conv0.tflite ROCKET_FC_SHIFT=26
	p mn_conv0.tflite ROCKET_FC_SHIFT=24
	p mn_conv0.tflite ROCKET_FC_SHIFT=22
	p mn_conv0.tflite ROCKET_FC_SHIFT=20

	log ""
	log "===== 7..8) the computed pair, and it with the captured offset ====="
	p mn_conv0.tflite "ROCKET_FC_SCALE=0x76be ROCKET_FC_SHIFT=22"
	p mn_conv0.tflite "ROCKET_FC_SCALE=0x76be ROCKET_FC_SHIFT=22 ROCKET_FC_OFFSET=0xffffff80"

	log ""
	log "===== 9..10) the offset on its own ====="
	p mn_conv0.tflite ROCKET_FC_OFFSET=0
	p mn_conv0.tflite ROCKET_FC_OFFSET=0xffffff80

	log ""
	log "===== 11..13) REGRESSION ====="
	p conv2d-cal.tflite ""
	p mn_dw1.tflite ""
	p mn_dw25.tflite ""

	log ""
	log "===== Round 77 swept this with an EMPTY MAC and concluded nothing ====="
	log "===== could be concluded. This is the same sweep, done properly.  ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
