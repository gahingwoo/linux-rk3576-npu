#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-23 round 342. THE VENDOR'S OWN STREAM, PLAYED BACK.
#
# THE CAPTURE WORKED. The vendor LLM runtime ran under the interposer and left
# 835 MB on the card: the task array, the register command buffer, the weights
# and the activations of a real int4 projection. It looked like a hang and was
# a slow write.
#
# What came out of it, before any board time:
#
#  1. THE VENDOR'S int4 GRID HAS NO ZERO. The nibble histogram over 1 MB of
#     their weights is symmetric under u -> ~u, and reading the code as two's
#     complement s gives mean -0.5 while reading it as s + 0.5 gives mean
#     -0.026. Three separate megabytes agree. Their levels are +-0.5, +-1.5 ...
#     +-7.5 times a per channel step. A midrise grid, sixteen levels, no code
#     for zero.
#
#  2. THEIR PROJECTION IS K=2048 N=1024, 1 MiB of weights, NO bias buffer, and
#     the DPU output stage is identity (0x40ac=0, 0x40b0=1, 0x40b4=0) -- they
#     read the RAW accumulator and dequantise off the NPU, which is what
#     charsiu already does.
#
#  3. THE STREAM DIFF, at the vendor's own shape, is 15 registers plus three
#     whole groups:
#         charsiu sets 0x100c bit 29, the vendor does not
#         0x3018   charsiu 10000001   vendor 10000200
#         0x40b8   charsiu 00000020   vendor 00000060
#         0x103c   charsiu surf=64    vendor surf=2048
#         five registers at 0x2810..0x2820 that NOTHING in this tree has ever
#           written -- and they are the two that differ between the two
#           subcores, so that block is the CBUF split
#         the whole DPU_RDMA block, which charsiu writes and the vendor does not
#         the 0x1d enable trailer, which charsiu writes and the vendor does not
#     and five more where charsiu and the vendor put the SAME 0x1f in OPPOSITE
#     HALVES of the word: charsiu's matmul is the transpose of theirs.
#
# Every int4 round so far changed one of those at a time. This one changes all
# of them by deciding none of them: the stream submitted IS the captured one,
# with three addresses substituted and nothing else touched.
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# THE MEASUREMENT HAS NO FITTED REFERENCE. Submit, keep the output, change ONE
# nibble of the weight buffer, submit again, subtract. The difference is that
# nibble's contribution and nothing else. Sweeping it 0..15 gives the value the
# hardware assigns each code, up to one common activation factor.
#
#   a STRAIGHT LINE in v, or a straight line with a step at v=8 (two's
#   complement), means the block is a real int4 multiplier and the 1.00 to 1.18
#   band was a configuration fault of ours;
#
#   the SAME BAND again -- deltas whose ratios are 1.067, 1.100, 1.133 -- under
#   the vendor's own stream means it is the silicon, and int4 is closed.
#
# TWO CONTROLS, BOTH OF WHICH CAN FAIL, and they are inside the tool:
#   CONTROL repeat   the same job twice must be byte identical, or the board is
#                    not repeatable and nothing under it can be read;
#   CONTROL restore  putting the nibble back must return the baseline, which
#                    catches a stale buffer or a job that stopped running.
# A POISON GATE: an all zero baseline prints VOID and the arm scores nothing.
# Round 339 printed "64 of 64" on a job that timed out and returned zeros.
#
# THE CONTROL ARM is the first entry: a regcmd of "-" runs the identical
# measurement under the stream THIS TREE emits, same buffers, same board, same
# code, so the only difference between the two curves is the 123 registers.
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT
# ---------------------------------------------------------------------------
#
# I do not know, and that is why it is worth a round. The one thing I will
# predict is that the CONTROL arm reproduces the band, because that is the
# configuration every previous round measured. If the control does NOT
# reproduce it, the tool is the thing that changed and the vendor arm means
# nothing either.
#
# The vendor arm may simply hang: it carries no DPU_RDMA and no enable trailer,
# and this tree has never submitted a stream without them. A hang is a result
# too, and it is the one that says the trailer is load bearing.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
VD=/opt/charsiu/charsiu_vendor
V=/opt/charsiu/vendor
RGC=$V/vendor-int4-k2048-n1024.regcmd
WT=$V/vendor-wt-1M.bin
IN=$V/vendor-in.bin
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

# arm: <label> <regcmd-or-dash> <byte> <high>
arm() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  ---- $1"
	sleep 1
	$VD "$2" "$WT" "$IN" "$3" "$4" 4096 > /tmp/vd.txt 2>&1
	cat /tmp/vd.txt > "$C"
	after=$(nbad)
	if [ "$after" != "$before" ]; then
		log "  !! POISONED: $((after - before)) new fault or timeout lines"
		health
	fi
}

start() {
	log ""
	log "###############################################################"
	log "##### round 342: the vendor's own int4 stream, played back #####"
	log "###############################################################"
	log "  no fitted reference. one nibble changes, the output difference"
	log "  is that nibble. a straight line means int4 is real."

	log ""
	log "===== 1) CONTROL: charsiu's own stream, byte 0 low nibble    ====="
	arm "control arm, this tree's stream" "-" 0 0

	log ""
	log "===== 2) the vendor's stream, byte 0 low nibble              ====="
	arm "vendor stream, byte 0 low" "$RGC" 0 0

	log ""
	log "===== 3) the vendor's stream, byte 0 HIGH nibble             ====="
	log "  the same byte's other half. the two halves must give the same"
	log "  curve if the nibbles are peers, and a different one if the"
	log "  packing pairs them the way round 334 found."
	arm "vendor stream, byte 0 high" "$RGC" 0 1

	log ""
	log "===== 4) the vendor's stream, byte 1024 and byte 100000      ====="
	log "  a second and third position, so the curve is not a property"
	log "  of one place in the buffer."
	arm "vendor stream, byte 1024 low" "$RGC" 1024 0
	arm "vendor stream, byte 100000 low" "$RGC" 100000 0

	log ""
	log "===== 5) the anchor: int8 conv must still be exact           ====="
	health

	log ""
	log "===== read the CONTROL lines first. VOID means the arm died. ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
