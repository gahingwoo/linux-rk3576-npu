#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-19 round 249. The lift and the offset, moved together this time.
#
# WHAT ROUND 248 SAID. Lifting the accumulator alone did not lower the floor,
# it raised the whole surface into the top rail. Four sweep points and the
# regression guard between them determine the output stage completely:
#
#     byte = clamp(max(requant + L, 0) + offset, -128, 127) + 128
#
# Every entry fits it. conv2d-cal at L=128 with offset 0 rails everything above
# requant 0 and comes back maxdiff 127 with half the wrong pixels sitting on a
# rail, which is what the equation says. L=192 and L=256 push the floor up to
# 171 and 235 and collapse the distinct count to 80 and 16, same reason.
# ⚠And pw33x64w56, whose out_zp is 0 so its offset is already -128, came back
# uniformly maxdiff 128 -- the lift with nothing taking it back. That entry is
# the one that fixes the sign and the amount.
#
# So a byte of clamp(requant + out_zp, 0, 255), which is what the operation
# means, needs L + offset == out_zp - 128 AND L >= 128 so the floor never
# bites. This driver shipped L = 0 with offset = out_zp - 0x80: the sum is
# satisfied and the floor bites. Round 248 changed L and left the offset, which
# breaks the sum. This round is L = 128 with the offset 128 lower, which is the
# only pair that satisfies both, and rkt_out_lift() is now the single place
# both read so they cannot drift apart again.
#
# THE READING RULE, fixed before the run.
#
#   Read entry 1 FIRST. ROCKET_NO_LIFT=1 sets L to 0 AND restores the old
#   offset, so it must reproduce rounds 240 through 248 exactly: 128 of 128
#   against max(cpu,zp), npu min 128, 0 of 128 against the UNCLAMPED cpu. If it
#   does not, the round is void.
#
#   The answer is entry 2's "vs UNCLAMPED cpu" count. It has been 0 of 128 every
#   round since the metric existed. 128 of 128 means the floor is gone and the
#   arithmetic underneath was right all along.
#
#   ⚠If entry 2 is neither 0 nor 128, read "npu min" and the maxdiff before
#   concluding anything: a partial result means the pair is right in form and
#   wrong in amount, and entries 3 and 4 are there to say by how much.
#
#   Entries 6 to 9 are the regression guard and they are the real risk. Both
#   shapes were correct before at out_zp 0. The offset there goes from -128 to
#   -256, which is a value this driver has never written. If they break while
#   entry 2 works, the fix is right for out_zp 128 and wrong in general.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
log() { echo "$@" > "$C"; }
w() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null

	log ""
	log "===== 1) THE CONTROL, and read it first. L=0 and the old offset,  ====="
	log "=====    so this must reproduce 240 to 248: 128/128 clamped, npu  ====="
	log "=====    min 128, 0/128 UNCLAMPED. Otherwise the round is void.   ====="
	w conv2d-cal.tflite "ROCKET_NO_LIFT=1"

	log ""
	log "===== 2) THE QUESTION. L=128 with the offset 128 lower.           ====="
	log "=====    Read the UNCLAMPED count.                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== 3-4) only if 2 is partial: is the amount off. Both keep the ====="
	log "=====      pair intact, since the offset follows the knob.        ====="
	w conv2d-cal.tflite "ROCKET_LIFT=129"
	w conv2d-cal.tflite "ROCKET_LIFT=160"

	log ""
	log "===== 5) the control again, so a drift across the log is visible  ====="
	w conv2d-cal.tflite "ROCKET_NO_LIFT=1"

	log ""
	log "===== 6-9) THE REGRESSION GUARD, and the real risk. Both were     ====="
	log "=====      correct before at out_zp 0, where the offset now goes  ====="
	log "=====      to -256, a value this driver has never written.        ====="
	w pw33x64w56.tflite "ROCKET_NO_LIFT=1"
	w pw33x64w56.tflite ""
	w cal_k3.tflite "ROCKET_NO_LIFT=1"
	w cal_k3.tflite ""

	log ""
	log "===== 10-11) and the two the MR's table quotes, at out_zp 128.    ====="
	w cal_oc16.tflite "ROCKET_NO_LIFT=1"
	w cal_oc16.tflite ""

	log ""
	log "===== Read entry 1 first. Then entry 2's UNCLAMPED count.         ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
