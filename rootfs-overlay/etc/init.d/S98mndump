#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-18 round 244. A regression run for the v8 series, and one real
# prediction inside it.
#
# WHAT IS NEW IN THE IMAGE. Only the two v8 changes that have a runtime
# effect and were not already here.
#
#   synchronize_irq(core->irq) in rocket_reset(), after drm_sched_stop()
#   and outside job_lock. drm_sched_stop() returns without waiting for a
#   threaded handler that is already running, so the comment saying the
#   remaining interrupts have been handled was an assumption.
#
#   usleep_range(10, 20) where the reset pulse used udelay(10).
#
# The rail already follows the domain in this tree from round 242, and the
# match table rework in v8 is enumeration equivalent so it is not here.
#
# THE PREDICTION, and it can fail. In round 241 the entry after a timed out
# job came back wedged: 88 output channels under the modulo form timed out,
# and the next entry hung with RCU stalls on one CPU and the log stopped.
# synchronize_irq is exactly the fence that was missing there. So entries 3
# and 5 deliberately time the block out, and entries 4 and 6 must compute.
#
#   READING RULE. Entry 4 and entry 6 are the test. If both come back
#   128 of 128 the reset path now survives a timeout. If either hangs, this
#   change did not fix that and I say so.
#
#   ⚠ WHAT THIS CANNOT PROVE. In round 242 a timeout at 120 did NOT wedge
#   the entry after it, the log ran to the end. So the wedge was never
#   universal, and two clean recoveries here are consistent with the fence
#   working AND with the wedge simply being intermittent. Two pairs is
#   better than one and still not a proof. Do not write it up as one.
#
#   THE CONTROL is entry 1. Rounds 240 through 243 all got 128 of 128 with
#   npu min 128 max 255 across 128 distinct values. If that moved, one of
#   the two new changes did it and nothing else here counts.
#
#   THE RAIL must read exactly as round 243 did, open_count 1 and use_count
#   0 at rest. If synchronize_irq or the sleep changed that, they reach
#   further than they should.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
RD=
GD=/sys/kernel/debug/pm_genpd
log() { echo "$@" > "$C"; }
w() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }

counters() {
	log ""
	log "  COUNTERS $1"
	st=
	for r in /sys/class/regulator/regulator.*; do
		[ "$(cat $r/name 2>/dev/null)" = vdd_npu_s0 ] && st=$(cat $r/state 2>/dev/null)
	done
	log "    rail  open_count=$(cat $RD/open_count 2>/dev/null)  use_count=$(cat $RD/use_count 2>/dev/null)  state=$st"
	for g in npu nputop npu0 npu1; do
		[ -d "$GD/$g" ] && log "    genpd $g  state=$(cat $GD/$g/current_state 2>/dev/null)  active_us=$(cat $GD/$g/active_time 2>/dev/null)"
	done
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	mount -t debugfs none /sys/kernel/debug 2>/dev/null
	for d in /sys/kernel/debug/regulator/*vdd_npu*; do
		[ -r "$d/open_count" ] && RD="$d"
	done
	[ -n "$RD" ] || log "  the rail has no debugfs directory, the counter lines will be empty"

	log ""
	log "===== 1) THE CONTROL. 240 through 243 all got 128 of 128, npu    ====="
	log "=====    min 128 max 255, 128 distinct.                          ====="
	w conv2d-cal.tflite ""
	counters "after the control, must match round 243"

	log ""
	log "===== 2) a second clean run, so a recovery can be told from a    ====="
	log "=====    first run that happened to work                         ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== 3) FORCE A TIMEOUT. 88 out under the modulo form did this  ====="
	log "=====    in round 241 and wedged the entry after it.             ====="
	w pw64x88w56.tflite "ROCKET_DPU4050_MOD32=1"

	log ""
	log "===== 4) THE TEST. This entry hung in round 241. It must compute ====="
	log "=====    128 of 128 now.                                         ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== 5) force a second timeout, at the other count              ====="
	w pw64x120w56.tflite "ROCKET_DPU4050_MOD32=1"

	log ""
	log "===== 6) THE TEST again                                          ====="
	w conv2d-cal.tflite ""
	counters "after two timeouts and two recoveries"

	log ""
	log "===== Read entry 1, then 4 and 6. Entry 3 and 5 are meant to     ====="
	log "=====    fail, they are the fixture and not the result.          ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
