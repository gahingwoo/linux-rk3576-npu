# ---------------------------------------------------------------------------
# 2026-08-09 round 29. Round 28 moved TWO things at once. This separates them.
#
# What round 28 established, and it is not in question:
#   1) old float surface        2/2 OK   (and again at the end, 2/2, no drift)
#   4) the table zeroed         0/2 FAIL <- the control fired, the region IS read
#   2) fp16 per-channel scale   0/2 FAIL
#   5) the same, relative       0/2 FAIL
# The value was not the problem either: conv2d-cal's weight scale really is
# 3.9125464 and fp16 of that really is 0x43d3, which is what the dump showed.
#
# ⚠ MY ERROR: round 28 wrote the table at 0x400 AND left everything after it
# zero. Round 27 zeroed both as well. So no run yet distinguishes
#     "0x400..0x400+2*oc must hold mesa's floats"
# from
#     "0x500..0x0b90 is what is load bearing, and the table is fine".
#
# ROCKET_FS_TABLE_OVER writes the float surface exactly as the configuration
# that computes does, then overwrites ONLY the table's bytes. ROCKET_FS_HOLE is
# its complement, the same surface with only those bytes zeroed.
#
# DECISION RULE, written before the run:
#   2 is 2/2            the fp16 table is compatible, and what broke rounds 27
#                       and 28 is the zeroed remainder, not the table. The
#                       offline result stands and mesa keeps the table.
#   2 breaks, 3 is 2/2  those bytes need mesa's floats specifically. The vendor
#                       puts a per-channel scale there and this driver cannot,
#                       which means the rest of the buffer differs too.
#   2 and 3 both break  the slice is load bearing whatever is in it, and only
#                       the exact float content works. Stop guessing at values
#                       and go decode 0x500..0x0b90 offline instead.
#   1 or 5 not 2/2      the build is not what I think it is. Stop and check the
#                       image before reading anything else.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
many() { m="$1"; n="$2"; shift 2; env TEFLON_LIB=/usr/lib/libteflon.so "$@" \
	python3 "$NPU_DIR/test_model.py" "$NPU_DIR/$m" "$n" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null
	log ""
	log "  task_con16=$(cat /sys/module/rocket/parameters/task_con16 2>/dev/null)"

	log ""
	log "===== 1) BASELINE: the float surface that computes ====="
	many conv2d-cal.tflite 2 ROCKET_FS_FLOATS=1

	log ""
	log "===== 2) THE TEST: that same surface, table overwritten at 0x400 ====="
	log "  the ONLY difference from 1 is 2*oc bytes"
	sleep 2
	many conv2d-cal.tflite 2 ROCKET_FS_TABLE_OVER=1

	log ""
	log "===== 3) COMPLEMENT: that same surface, table bytes ZEROED ====="
	log "  makes 2 readable: if this computes, the slice is not load bearing"
	sleep 2
	many conv2d-cal.tflite 2 ROCKET_FS_HOLE=1

	log ""
	log "===== 4) if 2 worked, does it also hold for k=3 ====="
	sleep 2
	many cal_k3.tflite 2 ROCKET_FS_TABLE_OVER=1

	log ""
	log "===== 5) REPEAT BASELINE: 1 again, to show nothing drifted ====="
	sleep 2
	many conv2d-cal.tflite 2 ROCKET_FS_FLOATS=1

	log ""
	log "===== 6) dump under 2: floats everywhere, table at 0x400 ====="
	rm -rf /tmp/m1; mkdir -p /tmp/m1; cd /tmp/m1 || return 0
	env TEFLON_LIB=/usr/lib/libteflon.so ROCKET_DEBUG=dump_bos \
		ROCKET_FS_TABLE_OVER=1 \
		python3 "$NPU_DIR/test_dw.py" "$NPU_DIR/conv2d-cal.tflite" \
		> /dev/null 2>&1
	for f in /tmp/m1/mesa-biases-*.bin; do
		[ -f "$f" ] || continue
		python3 - "$f" > "$C" 2>&1 <<'PY'
import struct, sys
d = open(sys.argv[1], 'rb').read()
print(f"    size {len(d)}")
print(f"    nonzero 0x400..0x500 (table): {sum(1 for x in d[0x400:0x500] if x)}")
print(f"    nonzero 0x500..0x0b90      : {sum(1 for x in d[0x500:0x0b90] if x)}  (expect ~1936, floats)")
print(f"    table[0:4] raw   {[hex(x) for x in struct.unpack_from('<4H', d, 0x400)]}  (expect 0x43d3)")
PY
	done
	cd / || return 0

	log ""
	log "===== Read 1 and 5 first: both must be 2/2 or nothing else counts. ====="
	log "===== Then 2 against 3.                                            ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
