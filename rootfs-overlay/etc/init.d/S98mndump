# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-20 round 267. The hardware writes N/2 + 8 channels, and a sparse
# sweep cannot see the shape of what is left.
#
# ⚠ THE NUMBER THIS ROUND IS ABOUT. 266's sentinel measured the extent of the
# write, and it is not N:
#
#     N = 16   ->  16 words written        N = 64   ->  40 words written
#     N = 32   ->  24 words written        which is N/2 + 8, three for three
#
# At N = 16 that equals N, which is why every clean closed result this project
# has is at N = 16. At N = 32 eight declared channels are never written and at
# N = 64 it is twenty four. That is an OUTPUT configuration fact and it does not
# depend on any of the weight address arithmetic.
#
# HOW 266's SIX WENT. Three of six, and the three that missed are all in the
# second half of the buffer, which came back dark. 640 gave word 24, 768 gave
# word 16 at k 32 and 896 gave word 24 at k 32, all as predicted. 1024, 1536 and
# 1920 were predicted at words 32, 48 and 56 and lit nothing. Word 32 is inside
# the 40 that get written, so that one is a real miss and not an invisible one.
#
# ⚠ AND THAT VINDICATES SOMETHING I PUT IN DOUBT. charsiu's README says --bmap
# found "the entire second half of the buffer is dark". Round 266's script
# called that in doubt and predicted all six live. --bmap was right and the rule
# was wrong to keep adding 16 per G past G = 7.
#
# Bytes 1 to 7 landed 7 for 7 at N = 64, word 0 throughout with k = 2, 4, 6, 8,
# 10, 12, 14. Bytes 192 and 320 were dark at N = 64, so the dead half is not a
# G = 0 hole.
#
# WHAT THIS ROUND DOES. Stops sampling. --map holds one live nibble and feeds a
# full input, so it needs ONE submit per byte instead of the 64 --kpair needs to
# sweep k, and every nibble has now been shown across more than a hundred points
# to pair with exactly one k, which retires the summation objection that --map
# was written under. That buys a sweep of the WHOLE buffer at a stride of 8 at
# all three geometries for under a thousand submits.
#
# ⚠ --map HAD THE SAME BYTE WIDTH DEFECT, the third place in that file to carry
# it. It is correct as written for int8, where a channel is a byte, which is how
# it passed its int8 validation and kept the bug on the w4a16 path. Fixed the
# same way, whole bo against a sentinel.
#
# THE READING RULE, fixed before the run.
#
#   ⚠ THE DISCRIMINATOR, and it is at N = 64. Forty words get written. The
#   sweep covers every byte of the buffer at a stride of 8, so if a word is
#   reachable at all this finds it.
#
#     words 0..39 all lit     the map was under sampled and nothing is wrong
#                             with the output side. 24 channels of 64 are simply
#                             not addressable and the weight side owes the rest.
#     words 32..39 never lit  the hardware writes eight channels it computes
#                             NOTHING for. That is an overrun past the real
#                             channel count and the number to explain becomes
#                             the 8, not the N/2.
#     something above 39 lit  the sentinel read is wrong too and the extent
#                             measurement goes back in the bin with the rest.
#
#   THE INSTRUMENT CHECK, free. 39 bytes were covered by --kpair in 266 and are
#   covered again here by a different probe with a different input. Every one of
#   them must report the same word. If any disagrees, this round is about that
#   and nothing else.
#
#   ⚠ N = 16 IS THE CONTROL GEOMETRY. Sixteen words written, sixteen channels,
#   and 266 lit every one of them. It must come back 16 of 16 lit with no word
#   above 15, or the new probe is not measuring what the old one measured.
#
#   THE LIVE BYTE SET. 266 could only say "these 39 bytes". A stride of 8 across
#   the whole buffer says what fraction is fetched and whether it is contiguous
#   runs, an interleave, or one bit. Count it before fitting anything to it.
#
#   No two option prediction on the shape. Predictions written in advance have
#   gone 4 of 6, then 3 of 6, and both times the misses were where the rule was
#   extrapolated past its data rather than where it was read off it.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	after=$(nbad)
	if [ "$after" != "$before" ]; then
		log "  !! POISON in this entry. The block faulted. This result is VOID."
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" \
			> /tmp/hc.txt 2>&1
		if grep -q "128/128 channels match" /tmp/hc.txt; then
			log "  !! health OK, the block recovered, continuing"
		else
			log "  !! health FAILED, the block is gone. ABORTING the round."
			ABORT=1
		fi
	fi
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	if [ -w /sys/module/rocket/parameters/reset_autosuspend ]; then
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend
		log "reset_autosuspend = $(cat /sys/module/rocket/parameters/reset_autosuspend)"
	else
		log "!! reset_autosuspend NOT WRITABLE. A timeout will kill the round."
	fi

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== 2) N = 16, the control geometry. 16 written, 16 reachable.   ====="
	log ""
	sleep 1
	/opt/charsiu/charsiu_int4 1 64 16 --map 8 > "$C" 2>&1

	log ""
	log "===== 3) N = 32. 24 written. How many are reachable.               ====="
	sleep 1
	/opt/charsiu/charsiu_int4 1 64 32 --map 8 > "$C" 2>&1

	log ""
	log "===== 4) N = 64. 40 written. Are words 32 to 39 EVER lit.          ====="
	sleep 1
	/opt/charsiu/charsiu_int4 1 64 64 --map 8 > "$C" 2>&1

	log ""
	log "===== 5) the anchor again                                          ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== Count the lit words per N against wrote. Then the live set.  ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
