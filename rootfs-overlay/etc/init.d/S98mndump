#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-24 round 370. THE LAST TWO CPU LOOPS.
#
# 🏁 ROUND 369: 11.62 tok/s, AND THE HOLE IS CLOSED.
#
#   1 everything on, unpinned   11.56 tok/s   86.2 ms   packing 2.75 ms
#   2 the same, pinned to A72   11.62          85.7     packing 2.73
#   3 CONTROL, all three back   10.57          94.2     packing 8.47
#
# All three sentences identical, probe 1024/1024 at 0.00e+00, anchor clean.
#
# 🔑 THE 10.6 MS HOLE WAS THE PACKING, and the pre-declared test for being
# WRONG about that did not fire. Recomputed as the round asked:
#
#   arm 1    five NPU rows 74.62 - hardware 70.20 - packing 2.75 = 1.67 left
#   control  five NPU rows 82.62 - hardware 71.98 - packing 8.47 = 2.17 left
#
# So packing accounts for it: 8.47 ms a token became 2.75, and summing into the
# caller's buffer took the read back from 8.5 to 7.0. **10.57 -> 11.62 tok/s.**
#
# And pinning to the A72s is worth 0.06 tok/s with attention serial, which
# CLOSES that question: the CPU thread was never on a little core.
#
# ---------------------------------------------------------------------------
# WHERE AN 86 MS TOKEN GOES NOW
# ---------------------------------------------------------------------------
#
#     60.0  the fence          9.63 GB/s, the measured ceiling. done.
#      7.75 attention          scalar C, one element at a time
#      7.03 summing the slices 1.2 M scaled adds over 4.8 MB
#      3.14 submitting
#      2.93 silu               1.0 ms of it is the exp, opt in since 368
#      2.75 packing
#      1.67 what is left of the wrapper
#      0.9  everything else
#
# Two loops are 15 ms of that and both were still scalar. This round is them.
#
# ---------------------------------------------------------------------------
# WHAT CHANGED, AND WHY ONLY ONE PIECE NEEDS A SWITCH
# ---------------------------------------------------------------------------
#
# BIT IDENTICAL, ON BY DEFAULT:
#
#   1. THE SLICE SUM. acc[j] += fo[j] * sc[j] is not a reduction -- each j has
#      its own accumulator -- and the product of two floats has at most 48
#      significant bits, so the double the scalar loop formed it in was exact
#      and the cast back was the correctly rounded float product.
#   2. ATTENTION'S SECOND HALF, out[i] += a * vt[i], for the same reason.
#
#      ⚠ AND BOTH NEEDED A COMPILER BARRIER. Left alone, gcc fuses the multiply
#      and the add into fmla, which rounds ONCE where the source rounds twice:
#      460190 of 20.5 million accumulations came out different in the host
#      check. With the barrier, zero do, and there is no fmla in the built
#      object.
#
# OPT IN, BECAUSE IT REORDERS A REDUCTION:
#
#   3. CHARSIU_FAST_ATTN vectorises the q.k dot product, which four lanes add
#      up in a different order. On the host that moved a token -- and it halved
#      attention, 0.78 ms to 0.39.
#
# CHARSIU_CPU_PLAIN and CHARSIU_NPU_PLAIN now also switch off 2 and 1.
#
# ---------------------------------------------------------------------------
# AND THE COLD START, WHICH NEEDED NO BOARD TO FIX
# ---------------------------------------------------------------------------
#
# Round 369's own heartbeat says a cold start is 4.4 seconds "adding" and 7.9
# "quantising", and BOTH ran on one core while three sat idle. Both split
# cleanly by output channel:
#
#   QUANTISING. Each row writes its own k bytes of q, its own scales and its
#   own wsum, and reads the weight file through gguf_row_f32, which only writes
#   the buffer it is handed. On the host it went 3.65 s to 0.93 with four
#   threads, and 1, 2, 4 and 6 threads give the SAME 64 tokens.
#   ⚠ The one thing that crosses rows is the squared error --info accumulates,
#   so a run that asks for it stays serial.
#
#   ADDING. The gather and the weight packer both index by output channel and
#   write disjoint bytes. Checked byte for byte against the whole matrix call
#   at nine shapes and five split counts, int4 and int8, odd channel counts
#   included. ⚠ The legacy bit pattern layout accumulates with |= and cannot be
#   split, so CHARSIU_W4_BITPAT forces the serial packer.
#
# ⚠ AND IT MAY HAVE OBSOLETED --cache. On the host, staging with the cache now
# costs 930 ms against 799 without it: reading 620 MB back is slower than
# quantising it on four cores. The board has slower storage AND slower cores,
# so the answer there is genuinely unknown -- read the heartbeat, do not
# assume the cache is still a win.
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# THE SENTENCE FIRST. **Arms 1 and 3 must be the Louvre sentence and match each
# other**: the default path is bit identical by construction and by host check.
# **Arms 2 and 4 are expected to differ** -- and if they do not, that is luck on
# this prompt rather than evidence, because round 368's fast exp differed on the
# host and not on the board.
#
# THEN THE TWO ROWS, against round 369: attention 7.75 and summing 7.03.
# ⚠ The sum is partly reading 4.8 MB out of memory that was just invalidated,
# and no arrangement of multiplies makes a cache miss faster. If it barely
# moves, that is the answer -- it is memory, not arithmetic -- and NOT a reason
# to try again with wider vectors.
#
# AND THE STAGING HEARTBEAT, free in every arm: "N tensors staged, X ms of
# which Y adding and Z quantising". Round 369 read 4375 adding and 7871
# quantising at 112 tensors. Arm 3 is the control for BOTH halves, since
# CHARSIU_NPU_PLAIN serialises the packer too.
#
# THEN ARM 2'S attention ROW against arm 1'S. That number is what the anchor
# would cost. Below about 2 ms it is not worth a re-baseline; above 3 it
# probably is, and the honest way to take it is to say so and re-anchor
# deliberately rather than let the sentence drift in some later round.
#
# ---------------------------------------------------------------------------
# AND THE QUESTION BEHIND CPU + GPU + NPU TOGETHER
# ---------------------------------------------------------------------------
#
# The board is LPDDR5 at 2736 MHz over two 16 bit channels: about 21.9 GB/s of
# bus. The NPU alone pulls 9.63 of it, and the CPU decoding Q8_0 on its own
# managed about 4.5 (round 356, 3.41 tok/s at 1.32 GB a token). So on paper
# there is room -- IF the controller will actually give it out.
#
# That matters because decode is a strict DEPENDENCY CHAIN. Every projection
# feeds the next, so there is nothing for a second engine to run in parallel:
# it has to take part of the SAME tensor and read the SAME weights from the
# SAME DRAM at the same moment. If the controller has nothing spare, the split
# is zero sum however it is scheduled, and no amount of GPU is going to help.
#
# Arms 5 and 6 ask exactly that, and need no GPU stack to do it:
#
#   ⚠ IF THE DECODE'S gen 128 IS UNCHANGED and the reader got several GB/s,
#     there is spare bandwidth and a CPU/NPU row split is worth building. The
#     cheap version costs NO extra scheduling at all: submit the NPU's rows,
#     compute the CPU's rows on the calling thread in the time we currently
#     spend BLOCKED in prep_bo, then wait. npu_matvec already takes a row
#     range.
#
#   ⚠ IF THE DECODE SLOWS BY ROUGHLY WHAT THE READER GAINED, the controller is
#     the wall, and the whole heterogeneous idea is dead for decode -- say so
#     and stop, rather than spending a fortnight on Mesa to find out.
#
# ⚠ THE READER STARTS 7 SECONDS IN, to be past staging and inside generation.
# If the staging heartbeat says otherwise, its window overlapped the load
# instead and the pair does not mean what it says. Check that first.
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT
# ---------------------------------------------------------------------------
#
# Summing 7.0 -> 4, attention 7.75 -> 6.5, so about 83 ms and 12.0 tok/s, and
# arm 2 near 3 ms below that. ⚠ Four rounds of predictions: rope was right, the
# packing was right, the pool and the scale gather were badly wrong. The ones
# that were right removed work; the ones that were wrong moved it.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
VD=/opt/charsiu/charsiu_vendor
V=/opt/charsiu/vendor
RGC=$V/vendor-int4-k2048-n1024.regcmd
WT=$V/vendor-wt-1M.bin
IN=$V/vendor-in.bin
RUN=/opt/charsiu/charsiu_run
M8=/opt/charsiu/models/Llama-3.2-1B-Instruct-Q8_0.gguf
PROMPT="The capital of France is"
LIMIT=420
# 32 tokens does not reach the answer to "17 times 24, show your working"
NGEN=64
CE=CHARSIU_COEF_ELEMS=65536
HEAD=CHARSIU_NPU_MAXN=131072
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block did not come back this time."
		ABORT=1
	fi
}

capped() {
	lim="$1"; shift
	"$@" &
	pid=$!
	i=0
	while [ "$i" -lt "$lim" ]; do
		kill -0 "$pid" 2>/dev/null || { wait "$pid"; return $?; }
		sleep 1
		i=$((i + 1))
	done
	kill -9 "$pid" 2>/dev/null
	wait "$pid" 2>/dev/null
	return 124
}
rung() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $1"; return 0; }
	lbl="$1"; shift
	before=$(nbad)
	log ""
	log "  -- $lbl"
	sleep 1
	capped "$LIMIT" env "$@" "$RUN" "$M8" -p "$PROMPT" -n "${NGEN:-32}" \
		--ignore-eos -q -c 512 -t 4 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the rung exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This rung is VOID."; health; }
	return 0
}
# arm: <label> <regcmd-or-dash> <byte> <high> [extra env, one assignment]
#
# ⚠ THE ENV GOES IN AS AN ARGUMENT, not as a "VAR=x arm ..." prefix. Whether an
# assignment before a FUNCTION call survives the call is unspecified -- dash
# drops it, other shells keep it -- and the arm whose whole job is to time out
# WITHOUT the trailer runs right after the one that has it. Not a question worth
# leaving to the shell.
arm() {
	before=$(nbad)
	log ""
	log "  ---- $1"
	sleep 1
	env ${5:-IGNORED=1} $VD "$2" "$WT" "$IN" "$3" "$4" 4096 > /tmp/vd.txt 2>&1
	cat /tmp/vd.txt > "$C"
	after=$(nbad)
	if [ "$after" != "$before" ]; then
		log "  !! POISONED: $((after - before)) new fault or timeout lines"
		health
		# ⚠ NOT a round abort. Round 342 threw away every arm after the
		# first poisoning and then measured the block healthy at the
		# end. The block recovers; give it a moment and carry on.
		ABORT=0
		sleep 2
	fi
}

# two concurrent probes, so the pair can be repeated without copy and paste
pair() {
	before=$(nbad)
	log ""
	log "  ---- $1"
	env CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_TIME=60 CHARSIU_OUT_KB=64 $2 $VD - "$WT" "$IN" 0 0 4096 > /tmp/vdA.txt 2>&1 &
	pidA=$!
	env CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_TIME=60 CHARSIU_OUT_KB=64 $3 $VD - "$WT" "$IN" 0 0 4096 > /tmp/vdB.txt 2>&1 &
	pidB=$!
	wait "$pidA"
	wait "$pidB"
	log "    A:"
	grep -E "M = |TIME:|baseline:|VERIFY:|CONTROL repeat|VOID|REREAD" /tmp/vdA.txt > "$C"
	log "    B:"
	grep -E "M = |TIME:|baseline:|VERIFY:|CONTROL repeat|VOID|REREAD" /tmp/vdB.txt > "$C"
	after=$(nbad)
	[ "$after" != "$before" ] && log "  !! POISONED: $((after - before)) new lines"
	return 0
}

BW=/opt/charsiu/charsiu_membw
DEC="CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 CHARSIU_NPU_W4V=1 CHARSIU_NPU_KMAX=1024 CHARSIU_NPU_W4_GROUP=1024"

# decode and a memory reader at the same time, both numbers kept
squeeze() {
	log ""
	log "  ---- $1"
	sleep 1
	env $DEC "$CE" "$HEAD" "$RUN" "$M8" -p "$PROMPT" -n 128 --ignore-eos \
		-q -c 512 -t 4 > /tmp/dec.txt 2>&1 &
	dpid=$!
	# past staging and into generation before the reader starts
	sleep "$2"
	if [ -n "$3" ]; then
		env CHARSIU_THREADS=4 CHARSIU_SECONDS="$3" $BW > /tmp/bw.txt 2>&1
	fi
	wait "$dpid"
	grep -E "tensors staged|gen 128|GB/s of weights|of that," /tmp/dec.txt > "$C"
	[ -n "$3" ] && cat /tmp/bw.txt > "$C"
	return 0
}

start() {
	log ""
	log "###############################################################"
	log "##### round 370: the last two CPU loops                    #####"
	log "###############################################################"
	log "  the fence is 60 of 86 ms. attention and the sum are 15."

	log ""
	log "===== 1) everything on                                         ====="
	log "  read the attention and summing rows against 7.75 and 7.03."
	rung "int4 g1024, two devices, stages" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 CHARSIU_NPU_W4V=1 CHARSIU_NPU_KMAX=1024 CHARSIU_NPU_W4_GROUP=1024 CHARSIU_STAGES=1 "$CE" "$HEAD"

	log ""
	log "===== 2) the vectorised dot product. EXPECTED TO CHANGE WORDS. ====="
	log "  a reduction added up in a different order. read the"
	log "  attention row: that is what the anchor would cost."
	rung "int4 g1024, FAST_ATTN" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 CHARSIU_NPU_W4V=1 CHARSIU_NPU_KMAX=1024 CHARSIU_NPU_W4_GROUP=1024 CHARSIU_STAGES=1 CHARSIU_FAST_ATTN=1 "$CE" "$HEAD"

	log ""
	log "===== 3) THE CONTROL: both vector paths off                    ====="
	rung "int4 g1024, CPU_PLAIN + NPU_PLAIN" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 CHARSIU_NPU_W4V=1 CHARSIU_NPU_KMAX=1024 CHARSIU_NPU_W4_GROUP=1024 CHARSIU_STAGES=1 CHARSIU_CPU_PLAIN=1 CHARSIU_NPU_PLAIN=1 "$CE" "$HEAD"

	log ""
	log "===== 4) and everything at once, for the best number it has    ====="
	log "  fast exp and fast dot together. both move tokens, both"
	log "  are documented, and this is what the runtime COULD do."
	rung "int4 g1024, FAST_ATTN + FAST_SILU" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 CHARSIU_NPU_W4V=1 CHARSIU_NPU_KMAX=1024 CHARSIU_NPU_W4_GROUP=1024 CHARSIU_STAGES=1 CHARSIU_FAST_ATTN=1 CHARSIU_FAST_SILU=1 "$CE" "$HEAD"

	log ""
	log "===== 5) WHAT THE MEMORY CONTROLLER HAS LEFT                   ====="
	log "  LPDDR5 2736 MHz over two 16 bit channels is about 21.9"
	log "  GB/s of bus, and the NPU alone pulls 9.63. Everything"
	log "  about CPU+GPU+NPU together turns on whether the rest of"
	log "  that is REACHABLE, because decode is a dependency chain:"
	log "  a second engine can only take part of the SAME tensor,"
	log "  from the SAME DRAM, at the SAME time."
	for n in 1 2 4; do
		log ""
		log "  ---- memory read alone, $n thread(s)"
		env CHARSIU_THREADS=$n CHARSIU_SECONDS=5 $BW > "$C" 2>&1
	done

	log ""
	log "===== 6) the same decode alone, then under memory pressure     ====="
	log "  compare gen 128 in the two, and read what the reader got."
	squeeze "int4 g1024, 128 tokens, NOTHING ELSE RUNNING" 0 ""
	squeeze "int4 g1024, 128 tokens, WITH four threads reading DRAM" 7 9

	log ""
	log "===== 7) the probe, still exact                                ====="
	arm "solo verify" "-" 0 0 "CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_VERIFY=1 CHARSIU_OUT_KB=64"

	log ""
	log "===== 8) the anchor: int8 conv must still be exact            ====="
	health

	log ""
	log "===== read the CONTROL lines first. VOID means the arm died. ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
