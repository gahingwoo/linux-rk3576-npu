#!/bin/sh
# ---------------------------------------------------------------------------
# 2026-08-09 round 24. The vendor capture ran and it corrected something I had
# said, so read the correction first.
#
# ⚠ I claimed mesa "writes zeros" in the region after the A/B/C table. It does
# not. By default rkt_coefs.c fills it with a float32 dequantised weight
# surface, thousands of entries, sized MAX2(ic*oc*k*k, 8192) floats.
#
# The vendor writes something else entirely at the same address, groups*64:
#
#   0x000..0x400   the A/B/C table, ~870 of 1024 bytes nonzero, same as mesa
#   0x400..0x500   128 uint16, ONE PER OUTPUT CHANNEL, values 5400..6400,
#                  correlating +0.87 with the per-channel weight scale
#   0x500 onward   0e 0e, then zeros
#
# Same address, different element type, different length, different meaning.
#
# ⚠ What is NOT claimed: that this explains the kernel-size split. The two
# captured models carry different weights, so nothing separates the per-channel
# part from the geometry, and the exact formula is unknown. This round asks only
# whether the region is load bearing at all, which is a yes or no question that
# a single constant can answer.
#
#   ROCKET_FS_PERCH=<u16>  writes the vendor SHAPE: one uint16 per output
#                          channel, then 0e 0e, then zeros.
#   ROCKET_FS_ZERO=1       zeroes the region entirely, already existed.
#
# DECISION RULE, before the run:
#   conv2d-cal changes under FS_ZERO or FS_PERCH -> the region is load bearing,
#       the vendor shape is worth deriving properly, and the float surface mesa
#       writes today is wrong
#   conv2d-cal is unchanged under BOTH            -> the region is inert for a
#       working geometry, and any effect on k=3 is the interesting part
#   nothing changes anywhere                      -> inert, dead end, say so
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }

many() { m="$1"; n="$2"; shift 2; env TEFLON_LIB=/usr/lib/libteflon.so "$@" \
	python3 "$NPU_DIR/test_model.py" "$NPU_DIR/$m" "$n" > "$C" 2>&1; }
flat() { m="$1"; shift; env TEFLON_LIB=/usr/lib/libteflon.so "$@" \
	python3 "$NPU_DIR/flatin.py" "$NPU_DIR/$m" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	# -n 8 floods the serial console and wedges the box. Learned the hard way.
	dmesg -n 4 2>/dev/null

	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null
	log ""
	log "  task_con16=$(cat /sys/module/rocket/parameters/task_con16 2>/dev/null)"

	log ""
	log "===== 1) CONTROL: conv2d-cal untouched, the float surface as today ====="
	many conv2d-cal.tflite 2

	log ""
	log "===== 2) conv2d-cal with the region ZEROED ====="
	log "  it computes today, so if the region matters this must change"
	sleep 2
	many conv2d-cal.tflite 2 ROCKET_FS_ZERO=1

	log ""
	log "===== 3) conv2d-cal with the VENDOR SHAPE, one u16 per channel ====="
	log "  0x1700 is mid range of the captured 5400..6400"
	sleep 2
	many conv2d-cal.tflite 2 ROCKET_FS_PERCH=0x1700

	log ""
	log "===== 4) k=3 with the vendor shape ====="
	sleep 2
	many cal_k3.tflite 2 ROCKET_FS_PERCH=0x1700
	log "  and zeroed, for the pair"
	many cal_k3.tflite 2 ROCKET_FS_ZERO=1

	log ""
	log "===== 5) the constant input, which isolates requant(bias) ====="
	log "  k=5 returns it correctly today, k=3 returns a flat zero point"
	sleep 2
	flat conv2d-cal.tflite ROCKET_FS_PERCH=0x1700
	flat cal_k3.tflite     ROCKET_FS_PERCH=0x1700

	log ""
	log "===== 6) prove the knob fired: the coefficient buffer both ways ====="
	sleep 2
	rm -rf /tmp/p1 /tmp/p2; mkdir -p /tmp/p1 /tmp/p2
	cd /tmp/p1 && env TEFLON_LIB=/usr/lib/libteflon.so ROCKET_DEBUG=dump_bos \
		python3 "$NPU_DIR/test_dw.py" "$NPU_DIR/conv2d-cal.tflite" > /dev/null 2>&1
	cd /tmp/p2 && env TEFLON_LIB=/usr/lib/libteflon.so ROCKET_DEBUG=dump_bos ROCKET_FS_PERCH=0x1700 \
		python3 "$NPU_DIR/test_dw.py" "$NPU_DIR/conv2d-cal.tflite" > /dev/null 2>&1
	cd /
	for f in /tmp/p1/mesa-biases-*.bin /tmp/p2/mesa-biases-*.bin; do
		[ -f "$f" ] && python3 "$NPU_DIR/bstat.py" "$f" > "$C" 2>&1
	done

	log ""
	log "===== 7) REPEAT CONTROL: conv2d-cal untouched ====="
	sleep 2
	many conv2d-cal.tflite 2

	log ""
	log "===== Read 6 first for whether the knob fired, then 2 and 3.        ====="
	sync
}

case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
