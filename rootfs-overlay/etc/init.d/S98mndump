#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-20 round 261. Where int4's k = 16 and above live.
#
# WHY THIS AND NOT MORE MESA. int4 is the only 2x left and its semantics are
# settled: the w4a16 output is
#
#   out = ((int16)fp16bits(w) * (int16)fp16bits(a)) >> 16
#
# exact at 18 measured points, with a four point prediction written into the
# board script before the run and no error in it. The wedge that used to leave
# the NPU unable to start the next job is localised and fixed. What is left
# between here and an int4 projection is ONE thing, the layout above k = 15.
#
# WHAT IS ACTUALLY MISSING. The layout charsiu has is
#
#   channel n at (n / 32) * 512 + (n % 32) * 8, eight bytes
#   byte b nibble h is k = 2b + h
#
# Eight bytes is sixteen nibbles, so that describes k = 0 to 15 and nothing
# above it. At 64 by 64 the weight buffer is 2048 bytes and the formula accounts
# for 512, so three quarters of it is unexplained and k = 16 upward is in there.
# ⚠The map calls those bytes dead. They are not dead, they were never paired
# with an input past k = 15, which is the only reason nothing lit.
#
# THE PROBE ALREADY EXISTS. --kpair puts one live nibble at a byte, walks a one
# hot input through every k, and prints BOTH the k it pairs with and the first
# channel that lights. It was only ever pointed at bytes 0 to 8 and 512. This
# round points it at the unexplained region.
#
# THE READING RULE, fixed before the run, and two bytes decide it alone.
#
#   byte 8    channel 1 and k = 0   eight bytes per channel, a k block elsewhere
#             channel 0 and k = 16  sixteen contiguous bytes per channel
#
#   byte 256  channel 0 and k = 16  the k block is at +256
#             nothing, or channel 32 with k = 0
#                                   the k block is further out and 256 is
#                                   still channel space
#
#   ⚠ Byte 0 is the baseline and must come back channel 0, k = 0. If it does
#   not, the shape or the packer moved under me and nothing below counts.
#
#   ⚠ A byte that pairs with MORE THAN ONE k is a broadcast, which is the thing
#   this probe was written to catch. Read the count in brackets, not just the
#   first number.
#
#   ⚠ Bytes 1024 and up only exist because the buffer is 2048. If they light
#   nothing at all, the layout does not use the top half at 64 by 64 and that
#   is a result too.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	after=$(nbad)
	if [ "$after" != "$before" ]; then
		log "  !! POISON in this entry. The block faulted. This result is VOID."
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" \
			> /tmp/hc.txt 2>&1
		if grep -q "128/128 channels match" /tmp/hc.txt; then
			log "  !! health OK, the block recovered, continuing"
		else
			log "  !! health FAILED, the block is gone. ABORTING the round."
			ABORT=1
		fi
	fi
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	if [ -w /sys/module/rocket/parameters/reset_autosuspend ]; then
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend
		log "reset_autosuspend = $(cat /sys/module/rocket/parameters/reset_autosuspend)"
	else
		log "!! reset_autosuspend NOT WRITABLE. A timeout will kill the round."
	fi

	log ""
	log "===== 1) the NPU still computes, so a null result means the probe  ====="
	log "=====    and not a dead block                                      ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== 2) THE LAYOUT PROBE. One live nibble per byte, a one hot     ====="
	log "=====    input walking k, reading the k AND the channel.           ====="
	log ""
	sleep 1
	/opt/charsiu/charsiu_int4 1 64 64 --kpair > "$C" 2>&1

	log ""
	log "===== 3) the same at a wider k, so a block boundary that is a      ====="
	log "=====    function of k rather than a constant shows up             ====="
	sleep 1
	/opt/charsiu/charsiu_int4 1 128 64 --kpair > "$C" 2>&1

	log ""
	log "===== 4) the anchor again                                          ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== Read 1 and 2, then 3 against 4. The bar is the arm beside it ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
