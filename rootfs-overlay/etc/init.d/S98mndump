#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-13 round 124. Reuse the CBUF instead of running off the end of it.
#
# Round 123 confirmed the second budget with four predictions at three channel
# counts, and a channel count story cannot produce them:
#
#   dw32w136   4624 entries   PASS, predicted    dw32w152  5776   FAIL, predicted
#   dw128w64   4096 entries   PASS, predicted    dw128w80  6400   FAIL, predicted
#   dw64w102   5202 entries   FAIL, which tightens the limit to [5000, 5202)
#
# Ten banks is 5120 and sits in that range. So a window may stage about 2560
# entries, five banks, and the whole layer about 5120, ten.
#
# The reason is in the addressing. Window 0 writes at CBUF row 0 and every
# later window addresses the buffer by ABSOLUTE input row: the write position
# is the running staged count and the reuse base at 0x103c is in_lo, and those
# two agree only because staging starts at row 0 and never skips. So the whole
# layer's input has to be resident at once, and nothing ever checks that it
# fits.
#
# The fix is to let it not fit. When the running total would run past the
# buffer, start again at CBUF row 0, restage that window in full, and make both
# bases relative to whatever input row now sits at row 0. For a restarted
# window both come out zero, which is exactly what window 0 already writes.
#
# On dw64w112 that gives 45 rows, then 43 at CBUF row 45, then a restart: the
# third window would have needed 6272 entries resident and instead stages its
# own 26 rows from row 0, 1456 entries.
#
# DECISION RULE, written before the run:
#   the four over-budget layers come good and nothing else moves
#             the buffer simply had to be reused, and both faults are closed
#   they improve but are not exact
#             reuse is right and one of the two bases is not
#   they do not move
#             the budget is real but this is not how the hardware wants it met
#
# Test 10 is the control: ROCKET_CBUF_TOTAL=100000 makes the overflow test
# never fire, so dw64w104 must break again exactly as it did in round 122.
#
# ⚠ mn_L03 is the one that matters. It is 64 channels, 112 wide, stride 2, and
# 6272 entries, which is why the round 119 window budget left it at 1 of 64. If
# the reuse is right it should come good too, and MobileNet's operator 3 with
# it.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
p() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== 1..4) the over-budget layers ====="
	p dw64w104.tflite ""
	p dw64w112.tflite ""
	p dw32w152.tflite ""
	p dw128w80.tflite ""

	log ""
	log "===== 5) THE ONE THAT MATTERS: MobileNet operator 3 ====="
	p mn_L03.tflite ""

	log ""
	log "===== 6..7) and the ladder either side of it ====="
	p mn_L02.tflite ""
	p mn_L04.tflite ""

	log ""
	log "===== 8..9) CONTROL: under budget, must not move ====="
	p dw64w100.tflite ""
	p dw32w136.tflite ""

	log ""
	log "===== 10) CONTROL: no total budget, dw64w104 must break again ====="
	p dw64w104.tflite "ROCKET_CBUF_TOTAL=100000"

	log ""
	log "===== 11..14) REGRESSION ====="
	p mn_dw1.tflite ""
	p mn_dw25.tflite ""
	p conv2d-cal.tflite ""
	p mn_conv0.tflite ""

	log ""
	log "===== Test 5 first. If op3 is right, the ladder moves on.         ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
