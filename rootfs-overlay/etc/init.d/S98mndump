# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-09 round 39. Every regular conv shape now computes. Go at depthwise,
# the chain, and MobileNet.
#
# Round 38, with the constant word as the DEFAULT and no knobs set anywhere:
#   conv2d-cal  5x5 s2      128/128        cal_s1     5x5 s1     128/128
#   cal_k3      3x3         128/128        cal_oc16   oc=16        16/16
#   cal_k1      1x1         128/128        cal_izp0   in_zp=0    128/128
#   whole model conv2d-cal 2/2 OK, cal_k3 2/2 OK
#   cal_k3 with the OLD float surface        0/128
#
# 1x1 was the last non-depthwise shape on the open list and it computes. So does
# 3x3. The kernel size wall and the pointwise wall were the same bug: a
# dequantised weight landing in a bitfield, and a model worked or not depending
# on whether its first weight carried the right bits.
#
# What is left from before all this: depthwise, chained operations, and
# MobileNet, which has both. Those were always attributed to separate causes.
# This asks whether they were the same coincidence.
#
# DECISION RULE, written before the run:
#   dwconv computes           depthwise was the same bug, and only the chain is
#                             left
#   dwconv still fails        it has its own cause, now attackable without the
#                             weight-bit confound in the way
#   conv2x computes           chaining works, and MobileNet is reachable
#   MobileNet top1 matches    the whole point of the driver, from end to end
#   MobileNet runs but is
#     wrong                   report which layer, the per-channel view is there
#   step 1 or 12 not 128/128  the build is wrong, stop and check the image
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
perch() { log ""; log "===== $1: $2 per channel ====="; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$2" > "$C" 2>&1; }
many() { log ""; log "===== $1: $2 whole model ====="; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so \
	python3 "$NPU_DIR/test_model.py" "$NPU_DIR/$2" "${3:-2}" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== 1) BASELINE: conv2d-cal, must be 128/128 ====="
	perch 1 conv2d-cal.tflite

	log ""
	log "===== 2..4) DEPTHWISE, which has its own history ====="
	perch 2 dwconv.tflite
	perch 3 mn_dw1.tflite
	perch 4 mn_conv0.tflite

	log ""
	log "===== 5..6) POINTWISE from the real model ====="
	perch 5 mn_pw2.tflite
	perch 6 mn_pw24.tflite

	log ""
	log "===== 7..8) CHAINED: two ops in one graph ====="
	perch 7 conv2x.tflite
	perch 8 mn_conv0dw1.tflite

	log ""
	log "===== 9) MOBILENET V1, the whole thing ====="
	sleep 2
	env TEFLON_LIB=/usr/lib/libteflon.so \
		python3 "$NPU_DIR/test_model.py" \
		"$NPU_DIR/mobilenet_v1_1.0_224_quant.tflite" 2 > "$C" 2>&1

	log ""
	log "===== 10..11) the md003 pair, for continuity with older rounds ====="
	perch 10 md003.tflite
	perch 11 md011.tflite

	log ""
	log "===== 12) CONTROL that can fail: conv2d-cal again ====="
	perch 12 conv2d-cal.tflite

	log ""
	log "===== Read 1 and 12 first. Then 2 for depthwise, 7 for the chain, ====="
	log "===== 9 for MobileNet.                                            ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
