# ---------------------------------------------------------------------------
# 2026-08-12 round 101. Solve the requant instead of guessing at bits.
#
# Round 100 tested DPU 0x4044 and it does nothing. mn_dw1 with the bit set is
# byte identical to mn_dw1 without it, 85.50% and 56125 either way, and
# conv2d-cal with the bit CLEARED is byte identical to conv2d-cal with it set,
# 99.99% and 10 either way. The control predicted a drop to about 75% and did
# not fire, which is what makes this a clean negative: the bit is written, in
# both directions, on both paths, and the output does not care.
#
# Six registers still differ between the depthwise and regular emissions:
# 0x400c bit 3, 0x4030 bit 10, 0x4038 in two bytes, 0x4050, and RDMA 0x501c
# and 0x5044. That is six more flashes to sweep one at a time, for a question
# that does not need them.
#
# The offline model reproduces the CPU reference exactly from the model file
# and the same ramp perch.py feeds: 9 constant channels of 32 for mn_dw1, 5 at
# the zero point, 256 distinct values, and 10 constant channels and 253
# distinct for mn_conv0. So given the hardware's own outputs at known
# coordinates, the map from accumulator to output can be SOLVED. perch.py now
# prints two rows of sixteen raw values from the worst channel, with the
# reference beside them, at fixed coordinates.
#
# DECISION RULE, written before the run:
#   the samples fit (acc*S) >> SH exactly
#                         the depthwise truncates and the search is for what
#                         turns rounding on, with the arithmetic confirmed
#   they fit with a different S or SH than mesa emits
#                         it is not the rounding at all, it is the multiplier,
#                         and the offline fit says what to write
#   they fit neither      the accumulator entering the OUT_CVT is not the one
#                         the model computes, and the BS stage is next
#
# The rest of the round is the standing regression, because a solved map is
# worth nothing if conv0 or the regular path moved while it was measured.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
p() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== 1) mn_dw1, the one to solve ====="
	p mn_dw1.tflite ""

	log ""
	log "===== 2) conv2d-cal, the same instrument on a path that is right ====="
	p conv2d-cal.tflite ""

	log ""
	log "===== 3) mn_dw25, depthwise but nearly exact ====="
	p mn_dw25.tflite ""

	log ""
	log "===== 4) conv0, half-up by the model and 0.2% low on the board ====="
	p mn_conv0.tflite ""

	log ""
	log "===== 5) fc_kx2, which must stay 32 of 32 ====="
	p fc_kx2.tflite ""

	log ""
	log "===== The RAW lines in 1 and 2 are the round. Everything else is  ====="
	log "===== the regression that says the map was measured on a good     ====="
	log "===== build.                                                      ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
