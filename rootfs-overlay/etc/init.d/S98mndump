#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-21 round 285. Stop guessing the stride and sweep an N that is not 64.
#
# ⚠ wbytes/4 IS REFUTED, and not narrowly. It did not fix the three that were
# wrong and it broke the three that were right:
#
#           8*K (283)      wbytes/4 (284)
#   N = 16    16/16            0/16
#   N = 32    32/32            0/32
#   N = 48    48/48            8/48
#   N = 64    64/64           64/64      the two forms are equal here by
#   N = 24    16/24            0/24      construction, so it proves nothing
#   N = 40    24/40            0/40
#   N = 56    32/56            0/56
#
# So 8*K is right everywhere there is data and the failures at 24, 40 and 56 are
# something else. Reverted.
#
# ⚠ AND THE REASONING THAT PRODUCED wbytes/4 WAS TIDY AND WRONG. It went: the
# map must scale with the buffer, and at N = 24 the second group of g2 lands at
# 768 which is exactly that buffer's size, so the stride is a fraction of the
# buffer. Both premises were fine and the conclusion did not survive one round.
# Round 284's own reading rule said what to do about that and this is it: the
# N = 64 table came off a --map sweep, so run the same sweep at an N that is not
# 64 rather than fitting a third form to the same seven numbers.
#
# WHAT IS SETTLED AND MUST NOT MOVE. With 8*K restored:
#
#   N = 16, 32, 48, 64 at K = 64, and N = 64 at K = 32, are byte exact against
#   cpu_reference with no override. 0x3020 = 2*(ALIGN_UP(n,16) - 8) - 1, the
#   write quantum is 16 channels, k is per channel parity, and the intra group
#   order is byte j holding k = 2j low and k = 2j+1 high.
#
# THE READING RULE, fixed before the run.
#
#   ⚠ ENTRIES 2 AND 3 ARE THE ROUND and they are measurements, not tests. A
#   stride 8 --map sweep of the whole buffer at N = 24 and at N = 40, which is
#   the instrument that produced the N = 64 table in the first place. Read the
#   grid, write down the eight group bases, and compare them to what 8*K
#   predicts:
#
#     N = 24  predicted 0, 128, 512   (g0, g1, g2)
#     N = 40  predicted 0, 128, 512, 640, 1024
#
#   The groups that WORK are g0 and g1 at N = 24 and g0 to g2 at N = 40, so the
#   first divergence should be at g2 and g3 respectively. If the measured bases
#   agree with the prediction there, the address is not the fault and the k side
#   is, which entry 4 asks directly.
#
#   ENTRY 4 is --kpair at N = 24 on bytes 0, 8, 128, 512 and 768. It says which
#   channel and which k each byte reaches, which is the pair the address table
#   alone cannot give.
#
#   ⚠ ENTRIES 5 TO 8 ARE THE REGRESSION CHECK and they matter as much as the
#   sweep. 284 broke three working geometries with a one line change, so 16, 32,
#   48 and 64 have to come back exact before anything measured above is worth
#   reading.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
MM=/opt/charsiu/charsiu_matmul
CH=/opt/charsiu/charsiu_int4
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

c() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $*"; return 0; }
	before=$(nbad)
	sleep 1
	env $1 $2 $3 $4 $5 $6 $7 $8 $9 > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This arm is VOID."; health; }
	return 0
}

M4="CHARSIU_W4=1 CHARSIU_W4_HALFK=1"

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	if [ -w /sys/module/rocket/parameters/reset_autosuspend ]; then
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend
		log "reset_autosuspend = $(cat /sys/module/rocket/parameters/reset_autosuspend)"
	else
		log "!! reset_autosuspend NOT WRITABLE. A timeout will kill the round."
	fi

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== 2) MEASURE. --map over the whole buffer at N = 24.           ====="
	log "=====    8*K predicts group bases 0, 128, 512.                     ====="
	log ""
	c X=1 X=1 $CH 1 64 24 --map 8

	log ""
	log "===== 3) MEASURE. the same at N = 40. predicted 0 128 512 640 1024 ====="
	log ""
	c X=1 X=1 $CH 1 64 40 --map 8

	log ""
	log "===== 4) and the k at N = 24, which the address alone cannot give  ====="
	c X=1 CHARSIU_KPAIR_BYTES=0,8,128,136,512,520 $CH 1 64 24 --kpair

	log ""
	log "##### the regression check. 284 broke three of these in one line.  #####"
	log ""
	log "===== 5) N = 16                                                    ====="
	c "$M4" X=1 $MM 1 64 16
	log "===== 6) N = 32                                                    ====="
	c "$M4" X=1 $MM 1 64 32
	log "===== 7) N = 48                                                    ====="
	c "$M4" X=1 $MM 1 64 48
	log "===== 8) N = 64, and K = 32 at N = 64                               ====="
	c "$M4" X=1 $MM 1 64 64
	c "$M4" X=1 $MM 1 32 64

	log ""
	log "===== 9) the control that must FAIL, and int8                      ====="
	c "CHARSIU_W4=1" X=1 $MM 1 64 64
	c X=1 X=1 $MM 1 64 64

	log ""
	log "===== the anchor again                                             ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== read the N = 24 grid first. Bases, not counts.               ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
