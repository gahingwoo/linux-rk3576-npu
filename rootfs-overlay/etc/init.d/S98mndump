#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-21 round 296. Six registers ruled out. The row term in the input
# packing has never been tested.
#
# ⚠ 295 CLOSED THE REGISTER LINE. All three arms that light row 1 on --map come
# back 16 of 32 as a matmul, which is row 0 exact and everything else wrong,
# identical to changing nothing:
#
#   0x1044 = surf*m       16 of 32      0x1078 = 0            16 of 32
#   0x103c = surf*m << 16 16 of 32      the two combinations  16 of 32
#   the same three at M = 4             16 of 64 each
#   0x1094 = 1            0 of 32, and it breaks row 0 as well
#   0x118c = 0            16 of 32, the baseline
#
# So they move data around and none of them is a row count. That was branch four
# of 295's reading rule.
#
# ⚠ WHAT WAS NEVER TESTED IS THE PACKING ITSELF. charsiu writes the activation
# as [k/atom][m][atom] and every matmul in this project ran M = 1 until round
# 289, where m drops out of that expression entirely and ANY arrangement of the
# rows is correct. The layout has one measurement behind it, round 179's, and
# that was at M = 1 too.
#
# CHARSIU_A_LAYOUT picks it now:
#   0  [k/atom][m][atom]   rows inside a k group, what has always been written
#   1  [m][k/atom][atom]   rows outermost
#   2  [k/atom][atom][m]   rows innermost, element interleaved
#
# THE READING RULE, fixed before the run.
#
#   ⚠ THE TEST IS THE MATMUL AND THE MAP TOGETHER. A layout that lights row 1
#   and gets it wrong is what all six registers already did; a layout that is
#   right will be 32 of 32.
#
#     a layout is 32 of 32        the row term was the fault all along, and the
#                                 register sweep was looking in the wrong half
#     a layout lights row 1 but
#     is not exact                the arrangement is closer and the atom or the
#                                 element size inside it is still wrong
#     all three are 16 of 32      the packing is not it either, and what is left
#                                 is that the hardware reads one row per job
#                                 whatever it is told, which would make M > 1 a
#                                 chaining problem and not a layout one
#
#   ⚠ LAYOUT 0 AT M = 1 MUST STAY EXACT in every arm. It is the shipped layout
#   and eleven geometries depend on it; if entry 2 moves, the knob broke the
#   default path rather than adding a branch.
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
MM=/opt/charsiu/charsiu_matmul
CH=/opt/charsiu/charsiu_int4
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

c() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $*"; return 0; }
	before=$(nbad)
	sleep 1
	env $1 $2 $3 $4 $5 $6 $7 $8 $9 > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This arm is VOID."; health; }
	return 0
}

M4="CHARSIU_W4=1 CHARSIU_W4_HALFK=1"

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	if [ -w /sys/module/rocket/parameters/reset_autosuspend ]; then
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend
		log "reset_autosuspend = $(cat /sys/module/rocket/parameters/reset_autosuspend)"
	else
		log "!! reset_autosuspend NOT WRITABLE. A timeout will kill the round."
	fi

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== 2) layout 0 at M = 1. The shipped path. Must not move.       ====="
	c "$M4" X=1 $MM 1 64 16
	c "$M4" X=1 $MM 1 64 64

	log ""
	log "##### THE ROUND. three arrangements of the row term, at M = 2.     #####"
	for L in 0 1 2
	do
		log ""
		log "===== M = 2  N = 16  layout $L"
		c "$M4 CHARSIU_A_LAYOUT=$L" X=1 $MM 2 64 16
	done

	log ""
	log "##### and the map beside them, row 1 held live                     #####"
	for L in 1 2
	do
		log ""
		log "===== --map M=2 N=16 row 1, layout $L"
		c "CHARSIU_MAP_ROW=1 CHARSIU_A_LAYOUT=$L" X=1 $CH 2 64 16 --map 8 64
	done

	log ""
	log "##### whichever lights, at M = 4 too                               #####"
	for L in 1 2
	do
		log ""
		log "===== M = 4  N = 16  layout $L"
		c "$M4 CHARSIU_A_LAYOUT=$L" X=1 $MM 4 64 16
	done

	log ""
	log "===== layout 1 and 2 at M = 1, which must also be exact if the     ====="
	log "=====   arrangement is right, since m = 1 makes all three equal    ====="
	c "$M4 CHARSIU_A_LAYOUT=1" X=1 $MM 1 64 16
	c "$M4 CHARSIU_A_LAYOUT=2" X=1 $MM 1 64 16

	log ""
	log "===== the control that must FAIL, and int8 at M = 4                ====="
	c "CHARSIU_W4=1" X=1 $MM 1 64 64
	c X=1 X=1 $MM 4 64 64

	log ""
	log "===== the anchor again                                             ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== 32 of 32 is the answer. 16 of 32 is row 0 and nothing more.  ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
