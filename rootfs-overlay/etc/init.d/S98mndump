#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-23 round 367. WHERE THE OTHER 41 MS GOES.
#
# 🏁 ROUND 366: 9.71 tok/s, AND IT IS CORRECT THIS TIME.
#
#   int8, two cores          6.73 tok/s   fence 7367 ms   standing sentence
#   int4 g1024, two devices  9.71 tok/s   fence 3977 ms   Louvre, and IDENTICAL
#   int4 g1024, one device   8.53 tok/s   fence 5439 ms   to entry 2 word for word
#
# Probe 1024 of 1024 at 0.00e+00, anchor clean. **1.52x over int8's 6.4.**
#
# 🔑 THE TWO CORE GAIN IS AT ITS CEILING, which is worth knowing because it
# says where NOT to look next. The marginal fit is 42.5 ns of compute an element
# and 37 ns of fetch a byte an element; int4 carries half a byte an element, so
#
#     one core   42.5 + 0.5*37 = 61.00 ns      two cores  21.25 + 18.5 = 39.75
#     ceiling 1.53x        measured on the fence 5439/3977 = 1.37x, 90% of it
#
# **More parallelism cannot buy much more. The lever is less memory traffic, or
# the CPU side.** So this round goes at the 41 ms a token that is NOT the fence.
#
# ---------------------------------------------------------------------------
# WHERE A 103 MS TOKEN GOES
# ---------------------------------------------------------------------------
#
#     fence (the NPU)                 62 ms
#     readback                        13.4
#     submitting                       3
#     outside the NPU path            24     <- never itemised
#
# ---------------------------------------------------------------------------
# ⚠ AND THE FENCE NUMBER IS NOT PURE WAITING
# ---------------------------------------------------------------------------
#
# rocket_ioctl_prep_bo is a dma_resv_wait_timeout FOLLOWED BY
# dma_sync_sgtable_for_cpu, so the invalidate over every output buffer has
# always been charged to the fence and never to the read back. Its pair,
# fini_bo, is a dma_sync_sgtable_for_device -- an arm64 cache CLEAN over the
# whole buffer -- and that one IS separable, so this build separates it.
#
# The geometry says how much cache those two walk. Per token the hardware
# writes, and the CPU reads back:
#
#     16 layers x 59392 floats  +  the 128256 wide head x 2 k slices
#     = 1206784 floats = 4.8 MB, invalidated once and cleaned once
#
# ---------------------------------------------------------------------------
# WHAT CHANGED, AND WHAT IS ONLY MEASURED
# ---------------------------------------------------------------------------
#
# ONE FIX. Each entry's two output buffers were both allocated for ALL of a
# tensor's slices, though the slices alternate and each device holds half.
# prep and fini work over a WHOLE buffer object, so the two device build was
# paying twice the cache maintenance of the one device build -- and the readback
# did go from 11.6 ms a token to 13.4. They are sized for what each device
# actually gets now.
#
# ONE ARGUMENT TO TEST. CHARSIU_NPU_NOFINI skips fini_bo on the OUTPUT buffers.
# The CPU only reads those, so their lines are clean already and the clean walks
# 4.8 MB to write nothing back; what makes skipping it safe is that the next
# read is preceded by prep_bo, whose invalidate drops those stale clean lines
# before the CPU can see them. That is an argument, not a measurement, and the
# sentence entry 3 writes is the check on it.
#
# ONE SECOND FIX, free and unconditional. Every entry cleared BOTH accumulators
# before summing, the int32 one and the float one, though a run uses exactly
# one of them: 2 MB a token of writes to an array nothing reads, half a megabyte
# of it in the output head alone. It also sat inside the read back timer, which
# is the number this round exists to read.
#
# ONE INSTRUMENT. CHARSIU_STAGES has never been run on this configuration. It
# costs two clock reads a stage, about 5 us a token, and it itemises the 24 ms
# that has only ever been a subtraction.
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# THE SENTENCE FIRST, as ever. Buffer sizing cannot change arithmetic, so
# entries 1, 2 and 4 must still be the Louvre. **Entry 3 is the one allowed to
# fail**: if skipping the clean is unsafe the words drift or go to salad, and
# that kills the idea rather than the round.
#
# THEN THE NEW STAT LINE, which now reads "summing the slices" and "in the
# flush" where it used to say one "reading back" number. 13.4 ms was the two
# together. If the flush is most of it, entry 3 is worth 10 ms a token; if the
# sum is most of it, the flush is a rounding error and the loop is the target.
#
# THEN THE STAGE TABLE in entry 2, the only genuinely new information here.
# ⚠ Round 327 was lost to a stage table that was 86% prompt and read as though
# it were generation, so check its total is near the GENERATION time and not
# near the whole run before believing any row of it.
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT
# ---------------------------------------------------------------------------
#
# The readback splits maybe 9 summing and 4 flushing: 4.8 MB of scaled adds is
# real work and a clean of the same 4.8 MB is a cache walk, and the walk is the
# cheaper of the two. So entry 3 should be worth a few ms, not ten. On the stage
# table I have no prior -- that is the point of running it.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
VD=/opt/charsiu/charsiu_vendor
V=/opt/charsiu/vendor
RGC=$V/vendor-int4-k2048-n1024.regcmd
WT=$V/vendor-wt-1M.bin
IN=$V/vendor-in.bin
RUN=/opt/charsiu/charsiu_run
M8=/opt/charsiu/models/Llama-3.2-1B-Instruct-Q8_0.gguf
PROMPT="The capital of France is"
LIMIT=420
# 32 tokens does not reach the answer to "17 times 24, show your working"
NGEN=64
CE=CHARSIU_COEF_ELEMS=65536
HEAD=CHARSIU_NPU_MAXN=131072
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block did not come back this time."
		ABORT=1
	fi
}

capped() {
	lim="$1"; shift
	"$@" &
	pid=$!
	i=0
	while [ "$i" -lt "$lim" ]; do
		kill -0 "$pid" 2>/dev/null || { wait "$pid"; return $?; }
		sleep 1
		i=$((i + 1))
	done
	kill -9 "$pid" 2>/dev/null
	wait "$pid" 2>/dev/null
	return 124
}
rung() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $1"; return 0; }
	lbl="$1"; shift
	before=$(nbad)
	log ""
	log "  -- $lbl"
	sleep 1
	capped "$LIMIT" env "$@" "$RUN" "$M8" -p "$PROMPT" -n "${NGEN:-32}" \
		--ignore-eos -q -c 512 -t 4 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the rung exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This rung is VOID."; health; }
	return 0
}
# arm: <label> <regcmd-or-dash> <byte> <high> [extra env, one assignment]
#
# ⚠ THE ENV GOES IN AS AN ARGUMENT, not as a "VAR=x arm ..." prefix. Whether an
# assignment before a FUNCTION call survives the call is unspecified -- dash
# drops it, other shells keep it -- and the arm whose whole job is to time out
# WITHOUT the trailer runs right after the one that has it. Not a question worth
# leaving to the shell.
arm() {
	before=$(nbad)
	log ""
	log "  ---- $1"
	sleep 1
	env ${5:-IGNORED=1} $VD "$2" "$WT" "$IN" "$3" "$4" 4096 > /tmp/vd.txt 2>&1
	cat /tmp/vd.txt > "$C"
	after=$(nbad)
	if [ "$after" != "$before" ]; then
		log "  !! POISONED: $((after - before)) new fault or timeout lines"
		health
		# ⚠ NOT a round abort. Round 342 threw away every arm after the
		# first poisoning and then measured the block healthy at the
		# end. The block recovers; give it a moment and carry on.
		ABORT=0
		sleep 2
	fi
}

# two concurrent probes, so the pair can be repeated without copy and paste
pair() {
	before=$(nbad)
	log ""
	log "  ---- $1"
	env CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_TIME=60 CHARSIU_OUT_KB=64 $2 $VD - "$WT" "$IN" 0 0 4096 > /tmp/vdA.txt 2>&1 &
	pidA=$!
	env CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_TIME=60 CHARSIU_OUT_KB=64 $3 $VD - "$WT" "$IN" 0 0 4096 > /tmp/vdB.txt 2>&1 &
	pidB=$!
	wait "$pidA"
	wait "$pidB"
	log "    A:"
	grep -E "M = |TIME:|baseline:|VERIFY:|CONTROL repeat|VOID|REREAD" /tmp/vdA.txt > "$C"
	log "    B:"
	grep -E "M = |TIME:|baseline:|VERIFY:|CONTROL repeat|VOID|REREAD" /tmp/vdB.txt > "$C"
	after=$(nbad)
	[ "$after" != "$before" ] && log "  !! POISONED: $((after - before)) new lines"
	return 0
}

start() {
	log ""
	log "###############################################################"
	log "##### round 367: where the other 41 ms goes                  #####"
	log "###############################################################"
	log "  int4 is byte exact and 1.42 to 1.78x faster. now decode with it."

	log ""
	log "===== 1) int4 g1024, two devices. sized output buffers.        ====="
	log "  the sentence must still be the Louvre; read the readback line."
	rung "int4 g1024, two devices" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 CHARSIU_NPU_W4V=1 CHARSIU_NPU_KMAX=1024 CHARSIU_NPU_W4_GROUP=1024 "$CE" "$HEAD"

	log ""
	log "===== 2) the same, with the STAGE TABLE                        ====="
	log "  check its total is near the GENERATION time, not the whole"
	log "  run: round 327 read a table that was 86% prompt."
	rung "int4 g1024, stages" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 CHARSIU_NPU_W4V=1 CHARSIU_NPU_KMAX=1024 CHARSIU_NPU_W4_GROUP=1024 CHARSIU_STAGES=1 "$CE" "$HEAD"

	log ""
	log "===== 3) the same, WITHOUT the flush on the output buffers     ====="
	log "  this is the arm allowed to fail. read the SENTENCE: if the"
	log "  words drift, the clean is load bearing and the idea dies."
	rung "int4 g1024, no output flush" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 CHARSIU_NPU_W4V=1 CHARSIU_NPU_KMAX=1024 CHARSIU_NPU_W4_GROUP=1024 CHARSIU_NPU_NOFINI=1 "$CE" "$HEAD"

	log ""
	log "===== 4) one device, for the readback comparison               ====="
	rung "int4 g1024, one device" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 CHARSIU_NPU_W4V=1 CHARSIU_NPU_KMAX=1024 CHARSIU_NPU_W4_GROUP=1024 CHARSIU_NPU_ONEDEV=1 "$CE" "$HEAD"

	log ""
	log "===== 5) the probe, still exact                                ====="
	arm "solo verify" "-" 0 0 "CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_VERIFY=1 CHARSIU_OUT_KB=64"

	log ""
	log "===== 6) the anchor: int8 conv must still be exact            ====="
	health

	log ""
	log "===== read the CONTROL lines first. VOID means the arm died. ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
