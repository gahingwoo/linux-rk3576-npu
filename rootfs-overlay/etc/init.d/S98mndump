#!/bin/sh
# ---------------------------------------------------------------------------
# 2026-08-08 round 16. Round 15 excluded the requant and gave the failure shapes.
#
#   md003_80 with OUT_CVT shift 23 -> 21, and 23 -> 17 (both confirmed emitted
#   in the log): output BYTE IDENTICAL both times. A 64x change in the requant
#   scale moves nothing, which is only possible if MAC + A is exactly 0.
#   REQUANT EXCLUDED for that family.
#
# And the first 64 outputs say the three cases fail in three different ways:
#
#   k=5  npu == cpu wherever cpu > out_zp, npu == out_zp below it. That is the
#        hardware ReLU at out_zp, and it is correct.
#   k=3  npu = out_zp + 0..2 everywhere. The MAC is near zero with a residue.
#   k=1  wild, saturating to 0 and to 128. Large amplitude and wrong.
#
# So k=3 is the informative one: not dead like md003, not correct like k=5, but
# a MAC that almost cancels. This round gets its regcmd, because there is now a
# vendor .rknn compiled at exactly cal_k3's geometry to diff it against, and
# that diff is the method that found both 0x1080 and 0x4050.
#
# ⚠ One thing to check in the diff, spotted in the vendor builds: the vendor
# stages a KERNEL DEPENDENT number of input rows. At 80x80 stride 2 it uses 79
# rows for a 1x1 and 80 for a 3x3 and a 5x5 (0x1028 high = surf * rows, 0x102c
# low = rows - 1). mesa always uses the full input height whatever the kernel.
#
# ⚠ job_log was left off in round 15, which is why every jobs= read 0. It is
# back on here. That column meant nothing last round; do not read it as "no job
# was submitted".
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }

many() {
	m="$1"; n="$2"; mark="$3"; shift 3
	echo "SMARK-$mark" > /dev/kmsg 2>/dev/null
	env TEFLON_LIB=/usr/lib/libteflon.so "$@" \
		python3 "$NPU_DIR/test_model.py" "$NPU_DIR/$m" "$n" > "$C" 2>&1
	dmesg | sed -n "/SMARK-$mark/,\$p" | grep -a "job: task_count=" | head -2 > "$C" 2>&1
}

regcmd() {
	rm -rf /tmp/rc; mkdir -p /tmp/rc; cd /tmp/rc || return 0
	env TEFLON_LIB=/usr/lib/libteflon.so ROCKET_DEBUG=dump_bos \
		python3 "$NPU_DIR/test_dw.py" "$NPU_DIR/$1" > /dev/null 2>&1
	for f in /tmp/rc/mesa-weights-*.bin; do
		[ -f "$f" ] && python3 "$NPU_DIR/bstat.py" "$f" > "$C" 2>&1
	done
	for f in /tmp/rc/mesa-regcmd-*.bin; do
		[ -f "$f" ] || continue
		log "--- $1 $(basename "$f") ---"
		python3 "$NPU_DIR/extract_regcmd.py" "$f" 8 > "$C" 2>&1
	done
	cd / || return 0
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	# -n 8 floods the serial console and wedges the box. Learned the hard way.
	dmesg -n 4 2>/dev/null

	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/job_log 2>/dev/null
	log ""
	log "  task_con16=$(cat /sys/module/rocket/parameters/task_con16 2>/dev/null)" \
	    "job_log=$(cat /sys/module/rocket/parameters/job_log 2>/dev/null)"

	log ""
	log "===== 1) CONTROL: conv2d-cal ====="
	many conv2d-cal.tflite 2 cal-first

	log ""
	log "===== 2) REGCMD: cal_k3, the near cancelling MAC ====="
	log "  to diff on the host against a vendor build at 16 in, 128 out,"
	log "  80x80, 3x3, stride 2, which is exactly this geometry"
	sleep 2
	regcmd cal_k3.tflite

	log ""
	log "===== 3) REGCMD: conv2d-cal, the same model at 5x5, as the pair ====="
	log "  mesa against mesa, one variable apart, alongside vendor against"
	log "  vendor at the same two kernels. Four streams, two contrasts."
	sleep 2
	regcmd conv2d-cal.tflite

	log ""
	log "===== 4) cal_k3 again for the verdict line ====="
	sleep 2
	many cal_k3.tflite 2 cal-k3

	log ""
	log "===== 5) REPEAT CONTROL: conv2d-cal ====="
	sleep 2
	many conv2d-cal.tflite 2 cal-last

	log ""
	log "===== 2 and 3 are the payload. The verdicts are already known; the ====="
	log "===== register streams are what this round is for.                  ====="
	sync
}

case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
