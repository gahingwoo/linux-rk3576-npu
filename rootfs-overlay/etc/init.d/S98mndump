# ---------------------------------------------------------------------------
# 2026-08-13 round 135. The last operator, and the register that is not the
# stride's.
#
# Round 134 walked the ladder and MobileNet is on the model from operator 3 to
# operator 7 to the channel and to the maxdiff, and within a few channels the
# rest of the way. The whole network is not, and the log says why: its output
# is every value at the zero point, an empty convolution, and the operator that
# produces it is number 28, 1024 to 1001 at ONE PIXEL. That shape has two
# things nothing here has ever run: an output channel count that is not a
# multiple of 32, and a 1x1 surface.
#
# Two separate things are under test this round.
#
# 1. WHICH AXIS THE CUT TILE BREAKS. pw48 and pw33 fail with 105 and 255
#    maxdiff, and both are INPUT channel tails. Yet the tiled weight layout was
#    checked against the vendor's own compiler at 48 by 64 and at 64 by 40 after
#    that run, and it matches byte for byte at both, so the tail is not the
#    layout. Operator 28's tail is on the OUTPUT axis, which no probe has ever
#    had. pw64x40 and pw64x33 are that, and the w1 models are the single pixel.
#
# 2. 0x1018 AND 0x1040 ARE NOT KEYED OFF THE STRIDE. They were `s != 2` here,
#    fitted to two captures. Reading 0x1018 out of 87 compiled .rknn and
#    comparing it against each one's own window count, the split pair appears
#    exactly when the window holds fewer rows than the layer has, in 86 of 87.
#    The one exception is a 1x1 whose window is 79 rows of 80.
#
#    That rule now runs by default. It changes the value for every stride 1
#    layer that fits in one window, which includes pw48x64w56, where the vendor
#    emits 0x40000404 and this driver has been emitting 0x40000505.
#
# DECISION RULE, written before the run:
#
#   pw48 and pw33 correct, everything else unchanged
#             the split pair was the input tail fault. Ship the derived rule.
#   pw48 and pw33 unchanged, and entry 3 reproduces today's numbers
#             the pair is not it. Then read the dump in entry 11 against the
#             vendor's stream for the same shape, which is already extracted.
#   a shape that passes today FAILS
#             the derived rule is wrong somewhere. pw32x64w56 is the one to
#             watch: it fits in one window, so its pair changes this round,
#             and it has been correct since round 133.
#
#   the w1 models empty or wrong while pw64x64w56 stays correct
#             the single pixel surface is its own fault and is what stands
#             between here and the whole network.
#
# CONTROL that can fail: entry 3 runs pw48 with ROCKET_CBUF_STRIDE=1, which
# puts the stride keyed value back. It must reproduce round 134's 28 of 64 at
# maxdiff 105. If entry 2 and entry 3 read the same, the knob is not reaching
# the path and neither number means anything.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
p() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== 1..2) the INPUT channel tails, with the derived split pair ====="
	p pw33x64w56.tflite ""
	p pw48x64w56.tflite ""

	log ""
	log "===== 3) CONTROL: the same shape with the stride keyed pair back ====="
	p pw48x64w56.tflite "ROCKET_CBUF_STRIDE=1"

	log ""
	log "===== 4..5) the OUTPUT channel tails, which no probe has ever had ====="
	p pw64x40w56.tflite ""
	p pw64x33w56.tflite ""

	log ""
	log "===== 6..8) ONE PIXEL surfaces, which operator 28 runs on ====="
	p pw64x64w1.tflite ""
	p pw32x64w1.tflite ""
	p pw64x40w1.tflite ""

	log ""
	log "===== 9..10) REGRESSION, both change their pair this round ====="
	p pw32x64w56.tflite ""
	p pw64x64w56.tflite ""

	log ""
	log "===== 11) our register stream for the failing shape ====="
	p pw48x64w56.tflite "ROCKET_DUMP_REGCMD=1"

	log ""
	log "===== 12..15) REGRESSION ====="
	p mn_L04.tflite ""
	p mn_L03.tflite ""
	p conv2d-cal.tflite ""
	p mn_conv0.tflite ""

	log ""
	log "===== Entry 3 must reproduce 28 of 64 at maxdiff 105, or entry 2 ====="
	log "===== proves nothing.                                            ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
