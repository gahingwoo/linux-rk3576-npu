# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-19 round 253. The lift is the output zero point, not a constant.
#
# WHAT 252 SETTLED. The depthwise record was the second site and fixing it
# worked: mn_dw1 at 32 of 32 and mn_dw25 at 1024 of 1024 are now byte identical
# with and without the lift, exactly as pw33x64w56 is, and MobileNet went from
# 977 back to 999. conv2x and md003_s2 came back identical on both arms, so
# those two are old failures and not mine.
#
# WHAT IT DID NOT SETTLE. The regression is not fully undone. MobileNet is 999
# of 1001 against 1000 without any lift, and mn_L02 is 16 of 64 against 22. The
# residual is rounding: lift/mult goes into A as an integer while lift/mult is
# not one, so each layer lands within half a count of where it should and a
# chain accumulates it. Invisible on one operator, which is why all three
# single operator cases were identical.
#
# THE CHANGE, and it is derived rather than swept. A valid uint8 output means
# the requantised value lies in [-out_zp, 255 - out_zp], so out_zp is the
# SMALLEST lift that clears the floor, and with it
#
#   clamp(max(rq + out_zp, 0) - 128, -128, 127) + 128 == clamp(rq + out_zp, 0, 255)
#
# which is what the operation means, with the offset a constant -128. The floor
# stops being an obstacle and becomes the output's own lower clamp. Where the
# zero point is 0 the lift is 0 and there is nothing left to round.
#
# THE READING RULE, fixed before the run, and it is sharp on purpose.
#
#   ⚠ Every model whose output zero point is 0 must come back BYTE IDENTICAL to
#   its no-lift arm, because the lift is now literally zero there. Not close.
#   Identical. mn_L02 must be exactly 22 of 64 at maxdiff 6, mn_L26 exactly 574
#   of 1024, pw33x64w56 64 of 64. If any of them differs at all, the lift is
#   reaching somewhere it should not and the reasoning above is wrong.
#
#   ⚠ MobileNet must be at least 1000 of 1001. Its op28 has out_zp 66 and is
#   the one place in it the floor ever bit, so it should now be fixed at no cost
#   to the 27 layers around it.
#
#   ⚠ conv2d-cal must stay 128 of 128. Its zero point is 128, so its lift is
#   unchanged from 249 and this must not move it.
#
#   ⚠ POISON means void, for that entry and everything after it until an OK
#   health check.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	after=$(nbad)
	if [ "$after" != "$before" ]; then
		log "  !! POISON in this entry. The block faulted. This result is VOID."
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" \
			> /tmp/hc.txt 2>&1
		if grep -q "128/128 channels match" /tmp/hc.txt; then
			log "  !! health OK, the block recovered, continuing"
		else
			log "  !! health FAILED, the block is gone. ABORTING the round."
			ABORT=1
		fi
	fi
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	if [ -w /sys/module/rocket/parameters/reset_autosuspend ]; then
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend
		log "reset_autosuspend = $(cat /sys/module/rocket/parameters/reset_autosuspend)"
	else
		log "!! reset_autosuspend NOT WRITABLE. A timeout will kill the round."
	fi

	log ""
	log "===== 1-2) THE ANCHOR. out_zp 128, so its lift is unchanged from   ====="
	log "=====      249 and this must not move it.                          ====="
	w conv2d-cal.tflite ""
	w conv2d-cal.tflite "ROCKET_NO_LIFT=1"

	log ""
	log "===== 3-4) MOBILENET. op28 has out_zp 66 and is the only place in  ====="
	log "=====      it the floor ever bit. Must be at least 1000 of 1001.   ====="
	w mobilenet_v1_1.0_224_quant.tflite ""
	w mobilenet_v1_1.0_224_quant.tflite "ROCKET_NO_LIFT=1"

	log ""
	log "===== 5+) EVERY out_zp 0 MODEL, PAIRED. The lift is now literally  ====="
	log "=====     zero on these, so each pair must be IDENTICAL. Any       ====="
	log "=====     difference at all falsifies the reasoning.               ====="
	for m in mn_L02 mn_L26 mn_L01 mn_L08 mn_L24 pw33x64w56 mn_dw1 mn_dw25; do
		w "$m.tflite" ""
		w "$m.tflite" "ROCKET_NO_LIFT=1"
	done

	log ""
	log "===== the cal family, out_zp 128, where the lift does the work     ====="
	for m in cal_izp0 cal_k1 cal_k3 cal_k3_imp cal_k5_imp cal_s1 cal_oc16 \
	         pw2_zp128; do
		w "$m.tflite" ""
	done

	log ""
	log "===== md003 family, out_zp 127, and the two old failures           ====="
	w md003.tflite ""
	w md003_oc128.tflite ""
	w md003_s2.tflite ""
	w conv2x.tflite ""
	w dwconv.tflite ""

	log ""
	log "===== the rest of the MobileNet slices                             ====="
	for m in mn_L00 mn_L03 mn_L04 mn_L05 mn_L06 mn_L07 mn_L12 mn_L18; do
		w "$m.tflite" ""
	done

	log ""
	log "===== a final anchor                                               ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== Read 1 and 2, then 3 against 4. The bar is the arm beside it ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
