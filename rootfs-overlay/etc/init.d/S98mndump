#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-09 round 36. Map the remaining bits of the word at groups*64.
#
# Round 35 separated cleanly. Writing the low 16 bits as hh ll:
#
#   0x1a44 PASS   0xff44 PASS   0x1a04 PASS      bit0=0, bit2=1, hh nonzero
#   0x0044 FAIL   hh = 0
#   0x1a40 FAIL   bit2 = 0        0x1a00 FAIL   bit2 = 0
#   0x1a45 FAIL   bit0 = 1        0x1aff FAIL   bit0 = 1
#
# and 0xffffff44, 0xc2801a44 and 0x005b1a44 all pass, so bits 16 to 31 are
# don't care entirely. Every pass has bit0 clear, bit2 set and a nonzero high
# byte; every failure breaks exactly one of those three. That is a bitfield in
# the low 16 bits of a word this driver fills with a dequantised weight.
#
# Two things are still unknown: WHICH bits of 8..15 have to be set, and whether
# bits 1, 3, 4, 5, 6, 7 are free. This maps both. Everything is written with
# bits 16..31 zero, since they are known not to matter, so each word is only the
# field under test.
#
# DECISION RULE, written before the run:
#   one single bit in 8..15 passes alone   that bit plus bit2 is the whole
#                                          requirement, and mesa can write one
#                                          constant instead of 197888 bytes
#   several pass alone                     any of them will do; report the set
#   none passes alone but 0x1a44 does      it needs a combination, report which
#   the free-bit probes all pass           bits 1 and 3..7 are genuinely free
#   a free-bit probe fails                 that bit matters too, add it
#   step 1 or 2 not 128/128                the build is wrong, stop
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
base() { env TEFLON_LIB=/usr/lib/libteflon.so ROCKET_FS_FLOATS=1 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > "$C" 2>&1; }
one() { log ""; log "===== FS_F0 = $2   ($1) ====="; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so ROCKET_FS_FLOATS=1 \
	ROCKET_FS_KEEP=4 ROCKET_FS_F0="$2" \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== 1) BASELINE: must be 128/128 ====="
	base

	log ""
	log "===== 2) the known good word with the upper half zeroed ====="
	log "  bits 16..31 are don't care, so this must still be 128/128"
	one "low 16 only, known good" 0x00001a44

	log ""
	log "===== which single bit of 8..15 is enough, with bit2 set ====="
	one "hh=0x01" 0x00000144
	one "hh=0x02" 0x00000244
	one "hh=0x04" 0x00000444
	one "hh=0x08" 0x00000844
	one "hh=0x10" 0x00001044
	one "hh=0x20" 0x00002044
	one "hh=0x40" 0x00004044
	one "hh=0x80" 0x00008044

	log ""
	log "===== are bits 1 and 3..7 free, holding hh=0x1a and bit2 set ====="
	one "bit2 only"      0x00001a04
	one "bit2+bit1"      0x00001a06
	one "bit2+bit3"      0x00001a0c
	one "bit2+bit4"      0x00001a14
	one "bit2+bit7"      0x00001a84
	one "bit0 set, must FAIL" 0x00001a05

	log ""
	log "===== 18) CONTROL that can fail: baseline again ====="
	sleep 2
	base

	log ""
	log "===== Read 1, 2 and 18 first. Then the smallest passing word is  ====="
	log "===== what mesa should write, and the surface can go.            ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
