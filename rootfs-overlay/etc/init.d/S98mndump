#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-10 round 47. Separate the two things round 46 changed together.
#
# Round 46 wrote the real fp16 per-channel scale table AND moved 0x5024 past it,
# and conv2d-cal went from 128/128 to 0/128, distinct 256, so it ran and was
# wrong rather than collapsing. cal_k3 and cal_k1 the same. Both baselines
# passed, so the result is real; it just cannot be attributed, because two
# things moved.
#
# ⚠ That is the mistake this project keeps making and I made it again. The two
# are separate knobs now:
#
#   ROCKET_SCALE_TABLE   write oc fp16 scales at groups*64 (instead of 0x1004)
#   ROCKET_SCALE_PTR     move 0x5024 to groups*64 + oc*2
#
# What is not in doubt is the decode: the 64 bytes before the vendor's 0x5024
# target are 32 uint16 that read as fp16 and match the scale implied by A at
# +0.998. The question is only which half of that mesa can adopt.
#
# DECISION RULE, written before the run:
#   TABLE alone is 128/128       the fp16 table is right and the POINTER is
#                                what broke round 46
#   PTR alone is 128/128         the pointer is fine and the TABLE is wrong,
#                                which would mean 0x1004 is doing something the
#                                real scales do not
#   both alone fail              each is individually harmful, so mesa's layout
#                                differs from the vendor's in a third way
#   both alone pass, together
#     fails                      they interact, and the interaction is the find
#   1 or 9 not 128/128           the build is wrong, stop
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
p() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== 1) BASELINE: must be 128/128 ====="
	p conv2d-cal.tflite ""

	log ""
	log "===== 2) TABLE alone, pointer left where it is ====="
	p conv2d-cal.tflite ROCKET_SCALE_TABLE=1

	log ""
	log "===== 3) POINTER alone, still writing the magic word ====="
	p conv2d-cal.tflite ROCKET_SCALE_PTR=1

	log ""
	log "===== 4) both, which is what round 46 ran ====="
	p conv2d-cal.tflite "ROCKET_SCALE_TABLE=1 ROCKET_SCALE_PTR=1"

	log ""
	log "===== 5..6) whichever passes, try it on the other regular shapes ====="
	p cal_k3.tflite ROCKET_SCALE_TABLE=1
	p cal_k3.tflite ROCKET_SCALE_PTR=1

	log ""
	log "===== 7..8) and on depthwise ====="
	p dwconv.tflite ROCKET_SCALE_TABLE=1
	p dwconv.tflite "ROCKET_SCALE_TABLE=1 ROCKET_SCALE_PTR=1 ROCKET_DW_REC48=1"

	log ""
	log "===== 9) CONTROL that can fail: baseline again ====="
	p conv2d-cal.tflite ""

	log ""
	log "===== Read 1 and 9, then 2 against 3. One of them is the culprit. ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
