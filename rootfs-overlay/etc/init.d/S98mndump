#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-23 round 363. THE CBUF IS SHARED. IS THE SECOND WINDOW CORRECT?
#
# 🔑🔑 ROUND 362 ANSWERED IT, AND THE CONTROL IS WHAT MAKES IT AN ANSWER.
#
#   one core, a pair                       2 of 2 CLEAN
#   two cores, both core-0 CBUF values     3 of 4 CORRUPT  361, 462, 699
#   two cores, A core-0 and B core-1       **4 of 4 CLEAN**
#   two cores, BOTH core-1 values          4 of 4 CORRUPT  405, 96, 270, 101
#
# The last line is the control and it failed as it had to. If core 1's numbers
# were simply kinder, giving them to both would have been clean too. It was not.
# The only thing separating the clean arm from the two dirty ones is whether the
# two concurrent jobs carry DIFFERENT CBUF configurations.
#
# ⇒ **THE CBUF IS SHARED BETWEEN THE TWO NPU CORES, and charsiu was handing both
# of them the same window.**
#
# 🔑 And better than expected: it does not matter WHICH core gets which window,
# only that two jobs in flight together do not collide. **So this needs no core
# selection in the uapi**, which is the thing I thought it would need.
#
# CHARSIU_CBUF_WINDOW=1 is a first class switch now and produces exactly the
# seven entries the vendor's two captured streams differ in -- 0x1038 twice,
# 0x1018, 0x103c, 0x1040, 0x2818, 0x2820. 0x1040 is taken literally rather than
# derived: both its halves change and one capture cannot say what either means.
#
# ---------------------------------------------------------------------------
# ⚠ THE HOLE IN ROUND 362, WHICH THIS ROUND EXISTS TO CLOSE
# ---------------------------------------------------------------------------
#
# **The pair helper only ran the repeat control. It never ran VERIFY.** So the
# clean arm proves the two jobs were REPEATABLE, not that either was CORRECT.
# A job that is stably wrong passes a repeat control every time.
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# ENTRY 2 IS THE ROUND. One process, alone, on window 1, with VERIFY. If window
# 1 does not compute 1024 of 1024 against the CPU reference then the second
# window is not usable and round 362's clean arm was two processes agreeing with
# themselves rather than with arithmetic.
#
# ENTRY 1 is the same on window 0 and must be 1024 of 1024, as it always has
# been.
#
# ENTRY 4 is the pair on different windows WITH VERIFY on both, which is the
# claim in full: two cores, concurrent, repeatable AND correct.
#
# ENTRY 3 reproduces the corruption with both on window 0, so the round carries
# its own before and after.
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT
# ---------------------------------------------------------------------------
#
# Window 1 verifies. The seven registers look like a base offset into a buffer
# rather than an arithmetic mode, and the arithmetic registers -- CORE 0x3018,
# 0x301c, 0x3020 -- are untouched by the window. But that is reasoning from what
# registers look like, which is exactly what this project keeps punishing, so
# entry 2 is the one to read first.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
VD=/opt/charsiu/charsiu_vendor
V=/opt/charsiu/vendor
RGC=$V/vendor-int4-k2048-n1024.regcmd
WT=$V/vendor-wt-1M.bin
IN=$V/vendor-in.bin
RUN=/opt/charsiu/charsiu_run
M8=/opt/charsiu/models/Llama-3.2-1B-Instruct-Q8_0.gguf
PROMPT="The capital of France is"
LIMIT=420
# 32 tokens does not reach the answer to "17 times 24, show your working"
NGEN=64
CE=CHARSIU_COEF_ELEMS=65536
HEAD=CHARSIU_NPU_MAXN=131072
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block did not come back this time."
		ABORT=1
	fi
}

capped() {
	lim="$1"; shift
	"$@" &
	pid=$!
	i=0
	while [ "$i" -lt "$lim" ]; do
		kill -0 "$pid" 2>/dev/null || { wait "$pid"; return $?; }
		sleep 1
		i=$((i + 1))
	done
	kill -9 "$pid" 2>/dev/null
	wait "$pid" 2>/dev/null
	return 124
}
rung() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $1"; return 0; }
	lbl="$1"; shift
	before=$(nbad)
	log ""
	log "  -- $lbl"
	sleep 1
	capped "$LIMIT" env "$@" "$RUN" "$M8" -p "$PROMPT" -n "${NGEN:-32}" \
		--ignore-eos -q -c 512 -t 4 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the rung exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This rung is VOID."; health; }
	return 0
}
# arm: <label> <regcmd-or-dash> <byte> <high> [extra env, one assignment]
#
# ⚠ THE ENV GOES IN AS AN ARGUMENT, not as a "VAR=x arm ..." prefix. Whether an
# assignment before a FUNCTION call survives the call is unspecified -- dash
# drops it, other shells keep it -- and the arm whose whole job is to time out
# WITHOUT the trailer runs right after the one that has it. Not a question worth
# leaving to the shell.
arm() {
	before=$(nbad)
	log ""
	log "  ---- $1"
	sleep 1
	env ${5:-IGNORED=1} $VD "$2" "$WT" "$IN" "$3" "$4" 4096 > /tmp/vd.txt 2>&1
	cat /tmp/vd.txt > "$C"
	after=$(nbad)
	if [ "$after" != "$before" ]; then
		log "  !! POISONED: $((after - before)) new fault or timeout lines"
		health
		# ⚠ NOT a round abort. Round 342 threw away every arm after the
		# first poisoning and then measured the block healthy at the
		# end. The block recovers; give it a moment and carry on.
		ABORT=0
		sleep 2
	fi
}

# two concurrent probes, so the pair can be repeated without copy and paste
pair() {
	before=$(nbad)
	log ""
	log "  ---- $1"
	env CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_TIME=60 CHARSIU_OUT_KB=64 $2 $VD - "$WT" "$IN" 0 0 4096 > /tmp/vdA.txt 2>&1 &
	pidA=$!
	env CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_TIME=60 CHARSIU_OUT_KB=64 $3 $VD - "$WT" "$IN" 0 0 4096 > /tmp/vdB.txt 2>&1 &
	pidB=$!
	wait "$pidA"
	wait "$pidB"
	log "    A:"
	grep -E "M = |TIME:|baseline:|VERIFY:|CONTROL repeat|VOID|REREAD" /tmp/vdA.txt > "$C"
	log "    B:"
	grep -E "M = |TIME:|baseline:|VERIFY:|CONTROL repeat|VOID|REREAD" /tmp/vdB.txt > "$C"
	after=$(nbad)
	[ "$after" != "$before" ] && log "  !! POISONED: $((after - before)) new lines"
	return 0
}

start() {
	log ""
	log "###############################################################"
	log "##### round 363: the CBUF is shared. is window 1 correct?    #####"
	log "###############################################################"
	log "  int4 is byte exact and 1.42 to 1.78x faster. now decode with it."

	log ""
	log "===== 1) CONTROL: solo on window 0. must be 1024 of 1024.      ====="
	dmesg 2>/dev/null | grep -i "NPU core" > "$C"
	arm "solo, window 0" "-" 0 0 "CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_VERIFY=1 CHARSIU_OUT_KB=64"

	log ""
	log "===== 2) THE ROUND: solo on window 1. is it CORRECT?           ====="
	log "  round 362 proved the pair was repeatable, never that it was"
	log "  right. a stably wrong job passes a repeat control every time."
	arm "solo, window 1" "-" 0 0 "CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_VERIFY=1 CHARSIU_OUT_KB=64 CHARSIU_CBUF_WINDOW=1"

	log ""
	log "===== 3) the pair, BOTH on window 0. must reproduce the fault. ====="
	pair "pair, same window 1" "" ""
	pair "pair, same window 2" "" ""

	log ""
	log "===== 4) the pair on DIFFERENT windows, with VERIFY on both    ====="
	log "  the claim in full: two cores, concurrent, repeatable AND right."
	pair "pair, split 1" "CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_VERIFY=1 CHARSIU_OUT_KB=64" "CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_VERIFY=1 CHARSIU_OUT_KB=64 CHARSIU_CBUF_WINDOW=1"
	pair "pair, split 2" "CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_VERIFY=1 CHARSIU_OUT_KB=64" "CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_VERIFY=1 CHARSIU_OUT_KB=64 CHARSIU_CBUF_WINDOW=1"
	pair "pair, split 3" "CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_VERIFY=1 CHARSIU_OUT_KB=64" "CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_VERIFY=1 CHARSIU_OUT_KB=64 CHARSIU_CBUF_WINDOW=1"

	log ""
	log "===== 5) the anchor: int8 conv must still be exact            ====="
	health

	log ""
	log "===== read the CONTROL lines first. VOID means the arm died. ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
