# ---------------------------------------------------------------------------
# 2026-08-11 round 85. Make the affine fit mean something, then read it.
#
# Round 84's pad value change is INERT. fc_imp gives a 0.3446 against 0.3445
# with the control and correlation 0.8897 either way, identical to four
# decimals, and conv0 barely moves.
#
# ⚠ AND THAT KILLS ROUND 83'S READING, WHICH WAS MINE AND WAS WRONG. That round
# saw the decode report correlation 1.000 on a 32x32 interior crop while the
# affine fit over the whole 112x112 reached only 0.89, and called the
# difference a border error. It is not. With pad_top and pad_left at 0 the
# padding touches ONE row and ONE column, 1.8 percent of the surface, which
# cannot pull a correlation from 1.000 to 0.89.
#
# The real cause is the instrument. perch.py's reference is max(cpu, out_zp),
# ReLU clipped, and both surfaces saturate at 255. A straight line fitted
# between two DIFFERENTLY clipped shapes cannot reach correlation 1 however
# right the underlying map is, and the NPU's clipping differs from the
# reference's precisely because its scale is wrong. The 0.89 was the clipping
# all along.
#
# So the fit now excludes any pixel where either surface is at the floor or the
# ceiling. On the unclipped remainder a and b are the real affine map, and the
# multiplier being written is 0x5391 / 2^25 while the one wanted is a times
# that.
#
# The pad value change stays. It is derived the same way the generic path
# derives it, it matches the vendor for a zero point of 0, and it affects one
# row and one column here, which is too little for this measurement to resolve
# either way. It is correct by derivation and unproven by experiment, and it is
# recorded as that rather than as a fix.
#
# DECISION RULE, written before the run:
#   correlation goes to 1.000 and     the map is affine after all and a names
#     a is consistent across          the requant; write it and be done
#     channels
#   correlation rises but a varies     it is per channel, not per layer, and
#     per channel                      the coefficient buffer is the target
#   correlation stays near 0.89        the error is not affine at all and the
#                                      window, not the scaling, is still wrong
#   conv2d-cal's fit is not a=1 b=0    the fit itself is broken; nothing else
#     where it has wrong channels      can be read
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
p() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== 1) the impulse model, where the map should be exact ====="
	p fc_imp.tflite ""

	log ""
	log "===== 2..4) and at three shifts: a must track the multiplier now ====="
	p fc_imp.tflite ROCKET_FC_SHIFT=26
	p fc_imp.tflite ROCKET_FC_SHIFT=27
	p fc_imp.tflite ROCKET_FC_SHIFT=28

	log ""
	log "===== 5) conv0 with its real weights ====="
	p mn_conv0.tflite ""

	log ""
	log "===== 6..8) REGRESSION, and cal_k1 has a wrong channel to fit ====="
	p conv2d-cal.tflite ""
	p mn_dw1.tflite ""
	p mn_dw25.tflite ""

	log ""
	log "===== If a is about 0.34 and halving the multiplier doubles it,   ====="
	log "===== the shift is short by log2(1/a) and that is the whole fix.  ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
