#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-22 round 331. THE WORDS ARE THERE. READ THE PAIRING.
#
# ⚠ ROUND 330 WAS REFUTED, the sixth time on int4, and I said in its header
# that entry 3 would sweep the two things the packer guesses -- and then wrote
# a third shape there instead. The sweep the header promised was not in the
# script. That is on me and this round is it.
#
# BUT ONE THING IN 330 WORKED, AND IT IS THE HALF THAT MATTERS:
#
#   at N=64:  128 words written, highest index 127
#
# **That is exactly 2N, and it is the first time charsiu has made the hardware
# compute and write 2N words.** `0x40b8 = 3` with `0x3020 = 2N-1` does what the
# count said it would. The phantom words exist and hold real computed sums.
#
# What was wrong is the PAIRING: out[c] + out[c+N] scored zero of 64. The packer
# guessed that the second half of a channel's k lands in word c+N, and it does
# not. ⚠ There is a measured reason to expect that: the existing packer's own
# halfk rule says **a channel is fed the k whose bit 4 equals its own parity**,
# and c and c+N have the SAME parity when N is even -- so both words would want
# the same half of k and the sum would double count.
#
# ---------------------------------------------------------------------------
# SO STOP GUESSING THE PAIRING AND READ IT
# ---------------------------------------------------------------------------
#
# charsiu_matmul now searches. For every channel it takes the reference and asks
# whether any two written words sum to it, and prints the rule:
#
#   pairing: channel -> the two words that sum to its reference
#   pairing: <hit> of <n> channels are the sum of two written words
#
# **If that count is n, int4 is at full width and the only thing left is to read
# the index rule off the line above it.** If it is zero, the second half of k is
# not in the buffer at all and the count in round 330 is wrong somewhere.
#
# Entry 3 sweeps the two knobs the packer still guesses, now that there is a
# reader that can tell which one landed: which half of k goes to the phantom
# word (the top half, the odd k, or the bit-4 parity the halfk rule uses) and
# the order inside a slot.
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# 1) THE `pairing:` COUNT IS THE ROUND. Everything else is diagnosis.
# 2) THEN THE RULE on the line above it: c=w0+w64 for every c is a clean
#    answer; a scatter is not, and a scatter means the packer put the halves
#    somewhere the map does not send them.
# 3) ENTRY 2a IS STILL THE CONTROL and must print 64 of 64 and 128 of 256.
# 4) ⚠ A pairing found at ONE shape and not the others is a coincidence, which
#    is why N=64, N=256 and N=512 all run.
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT
# ---------------------------------------------------------------------------
#
# No prediction. Six wrong ones is enough, and this round is built so the
# hardware writes the answer down rather than scoring mine.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
RUN=/opt/charsiu/charsiu_run
BE=/opt/charsiu/charsiu_bench
MM=/opt/charsiu/charsiu_matmul
I4=/opt/charsiu/charsiu_int4
M4="CHARSIU_W4=1 CHARSIU_W4_HALFK=1"
M8=/opt/charsiu/models/Llama-3.2-1B-Instruct-Q8_0.gguf
PROMPT="The capital of France is"
LIMIT=420
ARMCAP=240
CE=CHARSIU_COEF_ELEMS=65536
HEAD=CHARSIU_NPU_MAXN=131072
B8="CHARSIU_OVERRIDE=0x40b8=3"
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

capped() {
	lim="$1"; shift
	"$@" &
	pid=$!
	i=0
	while [ "$i" -lt "$lim" ]; do
		kill -0 "$pid" 2>/dev/null || { wait "$pid"; return $?; }
		sleep 1
		i=$((i + 1))
	done
	kill -9 "$pid" 2>/dev/null
	wait "$pid" 2>/dev/null
	return 124
}

c() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $*"; return 0; }
	before=$(nbad)
	sleep 1
	capped "$ARMCAP" env $1 $2 $3 $4 $5 $6 $7 $8 $9 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the arm exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This arm is VOID."; health; }
	return 0
}

rung() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $1"; return 0; }
	lbl="$1"; shift
	before=$(nbad)
	log ""
	log "  -- $lbl"
	sleep 1
	capped "$LIMIT" env "$@" "$RUN" "$M8" -p "$PROMPT" -n 32 \
		--ignore-eos -q -c 512 -t 4 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the rung exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This rung is VOID."; health; }
	return 0
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	[ -w /sys/module/rocket/parameters/reset_autosuspend ] && \
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend

	log ""
	log "===== 0) the limit's own control. expect rc 124 after ~3s.         ====="
	t0=$(cut -d. -f1 /proc/uptime)
	capped 3 sleep 60
	rc=$?
	t1=$(cut -d. -f1 /proc/uptime)
	log "  -- capped 3 sleep 60  ->  rc $rc after $((t1 - t0))s"
	[ "$rc" = "124" ] || log "  !! THE LIMIT DID NOT FIRE. Nothing below can be trusted to end."

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "##### ROUND 331: the words are there, read the pairing            #####"

	log ""
	log "===== 2) THE MEASUREMENT. every stage of the forward pass, NPU on. ====="
	log "=====    matmul stages minus the hardware path = the quantise.     ====="
	rung "the decode loop on the NPU, stages on" \
		CHARSIU_STAGES=1 CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 "$CE" "$HEAD"

	log ""
	log "===== 2b) the same stages with the NPU off, one boot apart.        ====="
	rung "the CPU path, stages on" CHARSIU_STAGES=1 CHARSIU_NPU_QUANT=1

	log ""
	log "===== 2) the pairing, READ rather than guessed.                    ====="
	log "===== 2a CONTROL, today's packing: 64 of 64 and 128 of 256"
	c "$M4" $MM 1 64 64
	c "$M4" $MM 1 2048 256
	log "===== 2b phantom + the register pair, at three shapes"
	c "CHARSIU_W4=1 CHARSIU_W4_PHANTOM=1" "CHARSIU_OVERRIDE=0x40b8=3,0x3020=0x7f" $MM 1 64 64
	c "CHARSIU_W4=1 CHARSIU_W4_PHANTOM=1" "CHARSIU_OVERRIDE=0x40b8=3,0x3020=0x1ff" $MM 1 2048 256
	c "CHARSIU_W4=1 CHARSIU_W4_PHANTOM=1" "CHARSIU_OVERRIDE=0x40b8=3,0x3020=0x3ff" $MM 1 1024 512

	log ""
	log "===== 3) the two knobs the packer still guesses                    ====="
	log "===== 3a split by ODD k instead of the top half"
	c "CHARSIU_W4=1 CHARSIU_W4_PHANTOM=1 CHARSIU_W4_PH_SPLIT=1" "CHARSIU_OVERRIDE=0x40b8=3,0x3020=0x7f" $MM 1 64 64
	c "CHARSIU_W4=1 CHARSIU_W4_PHANTOM=1 CHARSIU_W4_PH_SPLIT=1" "CHARSIU_OVERRIDE=0x40b8=3,0x3020=0x1ff" $MM 1 2048 256
	log "===== 3b split by bit 4 of k, which is the halfk rule"
	c "CHARSIU_W4=1 CHARSIU_W4_PHANTOM=1 CHARSIU_W4_PH_SPLIT=2" "CHARSIU_OVERRIDE=0x40b8=3,0x3020=0x7f" $MM 1 64 64
	c "CHARSIU_W4=1 CHARSIU_W4_PHANTOM=1 CHARSIU_W4_PH_SPLIT=2" "CHARSIU_OVERRIDE=0x40b8=3,0x3020=0x1ff" $MM 1 2048 256
	log "===== 3c intra-slot order k=j / k=j+16 instead of k=2j / k=2j+1"
	c "CHARSIU_W4=1 CHARSIU_W4_PHANTOM=1 CHARSIU_W4_PH_ORDER=1" "CHARSIU_OVERRIDE=0x40b8=3,0x3020=0x7f" $MM 1 64 64
	c "CHARSIU_W4=1 CHARSIU_W4_PHANTOM=1 CHARSIU_W4_PH_ORDER=1" "CHARSIU_OVERRIDE=0x40b8=3,0x3020=0x1ff" $MM 1 2048 256

	log ""
	log "===== 5) the standing number, no timers, so they cannot be blamed  ====="
	rung "the decode loop on the NPU" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 "$CE" "$HEAD"

	log ""
	log "===== the anchor again                                             ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== the pairing count is the round; the rule is the line above.   ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
