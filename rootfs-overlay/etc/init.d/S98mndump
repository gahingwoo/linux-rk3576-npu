#!/bin/sh
# ---------------------------------------------------------------------------
# 2026-08-08 round 18. Round 17 had both controls working and gave a clear
# answer, and it also exposed a weak probe of mine.
#
#   knob fired            weights distinct 224 -> 1, first bytes 7f
#   control that failed   conv2d-cal with forced weights, md5 80e64aab ->
#                         07852cc6, relu maxdiff 1 -> 127
#   cal_k3 + A forced     md5 2cae07f3 -> f9a4969a, mean 128.32 -> 135.82
#   cal_k3 + weights forced  md5 changed, mean 128.32 -> 128.04
#
# So for k=3 the DPU DOES read the coefficient buffer, unlike the md003 family
# where forcing A changed nothing, and the CMAC DOES read the weights. Every
# stage is alive and the answer is still out_zp plus a couple of counts.
#
# ⚠ But forcing every weight to one value makes a box filter, and a box filter
# on a smooth ramp input gives a nearly constant output anyway. The md5 change
# proves the buffer is read; the small magnitude proves nothing. That probe
# could not have shown a large effect even if everything worked.
#
# An impulse kernel can. mutate_impulse.py gives output channel c a single live
# tap at (c/k, c%k) and the weight zero point everywhere else, on input channel
# 0 only, so a correct convolution makes channel c a copy of the input shifted
# by that tap. If the hardware pairs a tap with the wrong input pixel, NPU
# channel c matches the CPU's channel c' instead, and taps.py recovers that
# mapping. A wrong pairing is exactly what would make 144 products cancel to
# zero while every buffer is read correctly.
#
#   2  k=3 impulse. Identity mapping means the pairing is right.
#   3  ⚠ k=5 impulse, THE CONTROL: this kernel size computes correctly, so its
#      mapping MUST come back as identity. If it does not, taps.py is wrong and
#      step 2 means nothing.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	# -n 8 floods the serial console and wedges the box. Learned the hard way.
	dmesg -n 4 2>/dev/null

	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null
	log ""
	log "  task_con16=$(cat /sys/module/rocket/parameters/task_con16 2>/dev/null)"

	log ""
	log "===== 1) CONTROL: conv2d-cal computes ====="
	env TEFLON_LIB=/usr/lib/libteflon.so \
		python3 "$NPU_DIR/test_model.py" "$NPU_DIR/conv2d-cal.tflite" 2 > "$C" 2>&1

	log ""
	log "===== 2) k=5 IMPULSE, THE CONTROL: mapping MUST be identity ====="
	log "  5x5 computes correctly, so every channel must match its own tap."
	log "  If it does not, taps.py is broken and step 3 means nothing."
	sleep 2
	env TEFLON_LIB=/usr/lib/libteflon.so \
		python3 "$NPU_DIR/taps.py" "$NPU_DIR/cal_k5_imp.tflite" 5 > "$C" 2>&1

	log ""
	log "===== 3) k=3 IMPULSE: which input pixel did each tap get ====="
	sleep 2
	env TEFLON_LIB=/usr/lib/libteflon.so \
		python3 "$NPU_DIR/taps.py" "$NPU_DIR/cal_k3_imp.tflite" 3 > "$C" 2>&1

	log ""
	log "===== 4) k=3 impulse, plain stats, to see if it is even structured ====="
	sleep 2
	env TEFLON_LIB=/usr/lib/libteflon.so \
		python3 "$NPU_DIR/test_dw.py" "$NPU_DIR/cal_k3_imp.tflite" > "$C" 2>&1

	log ""
	log "===== 5) k=5 impulse, plain stats, for comparison ====="
	sleep 2
	env TEFLON_LIB=/usr/lib/libteflon.so \
		python3 "$NPU_DIR/test_dw.py" "$NPU_DIR/cal_k5_imp.tflite" > "$C" 2>&1

	log ""
	log "===== 6) REPEAT CONTROL: conv2d-cal ====="
	sleep 2
	env TEFLON_LIB=/usr/lib/libteflon.so \
		python3 "$NPU_DIR/test_model.py" "$NPU_DIR/conv2d-cal.tflite" 2 > "$C" 2>&1

	log ""
	log "===== Read 2 FIRST. It must be an identity mapping at high percent, ====="
	log "===== or step 3 is meaningless.                                      ====="
	sync
}

case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
