# ---------------------------------------------------------------------------
# 2026-08-10 round 46. The surface at 0x5020 is decoded. Write the real thing.
#
# From the runtime capture, the layout is
#
#     0x5020 -> [A/B/C table]   64 B per 8 ch regular, 48 B per 8 ch depthwise
#               [oc x fp16]     the per-channel WEIGHT SCALE, 2 bytes each
#     0x5024 -> 0x0E0E, then zeros            (identical in both models)
#
# The 32 uint16 immediately before the 0x5024 target decode as fp16 and match
# the per-channel scale implied by A at +0.998, ratio 0.933 to 1.040, which is
# fp16 rounding. Against max|w|/127 they only reach +0.875, which is why every
# earlier attempt that assumed that scale looked like a mismatch.
#
# ⚠ THIS EXPLAINS THE MAGIC WORD. mesa's 0x5024 is bias_addr + groups*64, which
# lands ON the fp16 scale table instead of past it, so rounds 32 to 37 were
# sweeping values INTO channel 0's scale slot. 0x1004 is fp16 0.00049, a small
# positive scale, and the bitfield rule (w & 0x3f) == 0x04 with a magnitude
# floor was describing valid fp16 encodings the whole time.
#
# ROCKET_SCALE_TABLE writes oc fp16 scales there and moves 0x5024 past them.
#
# DECISION RULE, written before the run:
#   1 and 8 still 128/128        the real table is at least as good as the
#                                magic word on the shapes that already work
#   any regular shape regresses  the pointer move is wrong, revert it first
#   depthwise moves              the scale table matters for depthwise too and
#                                the record size can be retried on top of it
#   nothing changes anywhere     the fp16 table is equivalent to the constant
#                                for these models, which is expected for
#                                per-tensor quantisation where every entry is
#                                the same value
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
p() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== 1) BASELINE: the magic word, must be 128/128 ====="
	p conv2d-cal.tflite ""

	log ""
	log "===== 2..4) THE TEST: the real fp16 scale table ====="
	p conv2d-cal.tflite ROCKET_SCALE_TABLE=1
	p cal_k3.tflite ROCKET_SCALE_TABLE=1
	p cal_k1.tflite ROCKET_SCALE_TABLE=1

	log ""
	log "===== 5..6) and on the shapes that never worked ====="
	p dwconv.tflite ROCKET_SCALE_TABLE=1
	p mn_pw24.tflite ROCKET_SCALE_TABLE=1

	log ""
	log "===== 7) scale table AND the 48-byte depthwise record ====="
	p dwconv.tflite "ROCKET_SCALE_TABLE=1 ROCKET_DW_REC48=1"

	log ""
	log "===== 8) CONTROL that can fail: baseline again ====="
	p conv2d-cal.tflite ""

	log ""
	log "===== Read 1 and 8 first. Then 2: if the real table computes, the   ====="
	log "===== magic word can go and this is a derived value at last.        ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
