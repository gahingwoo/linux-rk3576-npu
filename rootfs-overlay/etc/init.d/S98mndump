# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-09 round 41. One word is not enough at 1024 channels. How many?
#
# Round 40, both baselines 128/128:
#   dwconv    0/16 for ALL SIX known-good words AND for the old float surface
#   conv2x    0/16 likewise
#   mn_pw24   297/1024 for all six words, identical every time
#             408/1024 for the OLD FLOAT SURFACE
#
# Two clean results. Depthwise and chaining do NOT depend on this word at all,
# so they have separate causes and the coefficient word is settled for them.
#
# And one regression, which the decision rule named in advance: at 1024 output
# channels the old surface beats the constant, 408 against 297. So the constant
# is NOT a strict improvement, and something consumed there scales with
# something mn_pw24 has more of. One word is enough at oc=128 and at oc=16,
# measured both ways, so the count is not simply one per output channel either.
#
# ROCKET_FS_FILL=<n> writes the word into the first n slots, 0 meaning fill the
# whole region. If filling fixes mn_pw24 the question becomes what n is; if it
# does not, the region is not a repeat of this word and the 408 is telling us
# the floats carry something else.
#
# DECISION RULE, written before the run:
#   fill fixes mn_pw24 outright   the region is n copies, and the sweep below
#                                 says what n is
#   fill beats 408 but is not
#     1024/1024                   right shape, wrong value or wrong stride
#   fill is no better than 297    the region is NOT copies of this word, and
#                                 the float surface is doing something the
#                                 constant cannot; say so and stop pushing it
#   fill breaks conv2d-cal        writing past what the layer needs is harmful,
#                                 which is itself worth knowing
#   step 1 or 9 not 128/128       the build is wrong, stop
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
p() { log ""; log "  -- $2  FS_FILL=$1"; sleep 1; \
	env TEFLON_LIB=/usr/lib/libteflon.so ROCKET_FS_FILL="$1" \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$2" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== 1) BASELINE: conv2d-cal default, must be 128/128 ====="
	env TEFLON_LIB=/usr/lib/libteflon.so \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > "$C" 2>&1

	log ""
	log "===== 2) mn_pw24: how many copies of the word ====="
	log "  297 is one word, 408 is the old float surface. Beat both."
	for n in 1 2 8 32 128 512 1024 0; do
		p $n mn_pw24.tflite
	done

	log ""
	log "===== 3) does filling HARM the layers that already work ====="
	p 0 conv2d-cal.tflite
	p 0 cal_k3.tflite
	p 0 mn_pw2.tflite

	log ""
	log "===== 4) and does filling do anything for the separate causes ====="
	p 0 dwconv.tflite
	p 0 conv2x.tflite

	log ""
	log "===== 9) CONTROL that can fail: conv2d-cal default again ====="
	sleep 2
	env TEFLON_LIB=/usr/lib/libteflon.so \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > "$C" 2>&1

	log ""
	log "===== Read 1 and 9 first. Then mn_pw24: any n beating 408 means   ====="
	log "===== the region is copies of the word; none means it is not.     ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
