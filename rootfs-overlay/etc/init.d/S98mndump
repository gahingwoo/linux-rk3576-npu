#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-22 round 311. CAN AN int8 JOB HAND BACK THE RAW ACCUMULATOR?
#
# int4 is closed. Round 310 measured why, and it was not bandwidth: int4
# computes CORRECTLY at every N up to 2048 (half width, exact = N/2, which
# nobody knew because a guard of mine had been refusing N >= 512 for four
# rounds) and is 9 to 22 percent FASTER than int8 at N <= 256 -- and then falls
# off a cliff. K = 2048, single task, healthy block, and entry 4 of that round
# proves these same shapes compute right:
#
#     N     int8      int4
#     128   175.5     136.8      int4 22% faster
#     256   177.0     161.1      int4  9% faster
#     512   213.1    1345.2      6.3x slower
#     1024  369.7   12047.6     32.6x slower
#     2048  554.6   18942.6     34.2x slower
#
# So int4 cannot make a big job: a K=2048 N=2048 projection needs eight N=256
# jobs, 1288 us, against int8's one at 554.6. 2.3x slower. Parked, with the
# discriminating experiment for the cliff written down for whoever returns.
#
# ---------------------------------------------------------------------------
# SO int8 IT IS, AND int8 HAS ONE THING IN THE WAY
# ---------------------------------------------------------------------------
#
# charsiu's int8 path requantises through the coefficient buffer and writes a
# BYTE. A coefficient buffer holds ONE set of numbers for the whole run, so that
# output scale cannot follow the token.
#
# ⚠ MEASURED ON THE HOST, in the CPU model of this exact format, so it is not a
# story about outliers. Per tensor, the smallest and largest |y| across calls:
#
#     blk.1.ffn_down     0.132  ->  392.429    ratio 2971
#     blk.0.ffn_down     0.120  ->   20.588    ratio  171
#     blk.15.ffn_down    1.651  ->  246.019    ratio  149
#
# A scale sized for the largest vector leaves a typical one 127/2971 of a level,
# which is zero. And the model says so: with a per call optimal output scale
# Llama-3.2-1B still writes "Paris. The Eiffel Tower is a famous landmark...";
# with a FROZEN scale it writes "a country", at every calibration length tried
# from 8 calls to 512.
#
# **So a projection cannot leave the NPU as a byte, and step 2 needs the raw
# accumulator.** The w4a16 path already writes FOUR bytes an element under an
# identity requant. This round asks whether that output stage works with int8
# WEIGHTS, one register at a time.
#
#   CHARSIU_WIDE8=<mask>   bit 0 0x4010   bit 1 0x4030   bit 2 0x4038
#                          bit 3 0x4044   bit 4 0x4050   bit 5 0x40ac/b0/b4
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# 1) ENTRY 2 IS THE CONTROL AND IT MUST PASS FIRST. No mask at all, so this is
#    today's int8 job with a 4x output buffer. It must read
#      BYTES  64 of 64 exact      WORDS  0 of 64
#      and "0 of 64 elements have a non sentinel byte above the low one"
#    because a one byte output leaves the top three bytes of every word at the
#    0xa5 sentinel. If the control does not look like that, the reader is wrong
#    and nothing below it can be read.
#
# 2) THEN THE SWEEP. For each single bit and then the whole bundle, the two
#    numbers that matter are:
#      "elements with a non sentinel byte ABOVE the low one"  -> the WIDTH
#      "reading as WORDS ... exact"                           -> and correct
#    A register that widens the output but gets the arithmetic wrong is still
#    the answer to which register carries the width, and is worth more than one
#    that changes nothing.
#
# 3) A run that writes NOTHING (0 bytes off the sentinel) is a dead job, not a
#    narrow one. Say so rather than reading it as "no change".
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT
# ---------------------------------------------------------------------------
#
# **0x4050 (bit 4) CARRIES THE WIDTH.** int8 writes 0x80011111 and w4a16 writes
# 0x00023333; the nibble runs 1111 against 3333 look like a per byte enable and
# the 8 in the top nibble like a mode. Round 260 already swept 0x4050 field by
# field on the int8 path, so it is the register with the most reason to be it.
#
# I also expect the identity requant alone (bit 5) NOT to widen anything: an
# identity requant behind an eight bit output stage just means the byte holds
# the low eight bits of the accumulator, which is exactly what round 178's note
# in job.c already warns about.
#
# ⚠ THE WHOLE BUNDLE GOES LAST among the masks, because if it wedges, the single
# bit results above it are the round.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
WD=/opt/charsiu/charsiu_wide
MM=/opt/charsiu/charsiu_matmul
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

c() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $*"; return 0; }
	before=$(nbad)
	sleep 1
	env $1 $2 $3 $4 $5 $6 $7 $8 $9 > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This arm is VOID."; health; }
	return 0
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	[ -w /sys/module/rocket/parameters/reset_autosuspend ] && \
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "##### ROUND 311: which register makes an int8 output four bytes.   #####"

	log ""
	log "===== 2) THE CONTROL. no mask. bytes 64/64, words 0/64, no high    ====="
	log "=====    bytes touched. If this is not what it says, stop reading.  ====="
	c X=1 X=1 $WD 1 64 64

	log ""
	log "===== 3) one register at a time                                    ====="
	for B in 1 2 4 8 16 32
	do
		log ""
		log "===== CHARSIU_WIDE8=$B"
		c "CHARSIU_WIDE8=$B" X=1 $WD 1 64 64
	done

	log ""
	log "===== 4) the identity requant WITH the width candidate             ====="
	log "=====    0x4050 and the requant together, which is what w4a16 does  ====="
	c "CHARSIU_WIDE8=48" X=1 $WD 1 64 64

	log ""
	log "===== the anchor again, before the bundle is allowed to wedge       ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== 5) LAST: the whole bundle                                    ====="
	c "CHARSIU_WIDE8=63" X=1 $WD 1 64 64

	log ""
	log "===== 6) and the int8 regression, so the tree is still sane        ====="
	c X=1 X=1 $MM 1 64 64

	log ""
	log "===== control, then which bit widened it, then whether it is right ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
