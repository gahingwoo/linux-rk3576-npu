# ---------------------------------------------------------------------------
# 2026-08-20 round 262. Name int4's weight map, by measuring it rather than
# fitting it.
#
# WHAT 261 SETTLED, all of it with the anchor computing either side.
#
#   k = 16 and above ARE reachable and they live in the FIRST 256 bytes.
#   byte 8 pairs with k = 16. The map calling those bytes dead was a reading
#   error: they had never been paired with an input past k = 15.
#
#   The byte to (k, channel) map DOES NOT DEPEND ON K. Every byte live at both
#   K = 64 and K = 128 gave the identical k and the identical channel. K only
#   sets how far the live region extends, which is about 8K bytes.
#
#   Every live byte pairs with EXACTLY ONE k, so nothing is broadcast.
#
#   ⚠ And both predictions written into round 261 were wrong. Byte 8 is
#   channel 4 at k = 16, where the two readings on offer said channel 1 at
#   k = 0 or channel 0 at k = 16. The truth was a third thing.
#
# WHAT IS LEFT, and why this round is dense rather than clever.
#
#   byte    0  1  2  3  4  7    8   16  256  257  264
#   k       0  2  4  6  8 14   16    0   32   34   48
#   channel 0  0  0  0  0  0    4    8    0    0    4
#
# Bytes 248 and 255 are dead, so the live set inside the first 256 is not
# contiguous either. ⚠ Every reading tried against those points ends with bit 3
# of the byte contributing to BOTH the k and the channel, which is not how a
# bitfield splits. That is a sign the points are too sparse, not that the
# hardware is strange, and fitting through gaps is what this project has had to
# retract before. So bytes 9 through 15 and 17 through 31 get measured.
#
# THE READING RULE, fixed before the run.
#
#   Read 9 through 15 first. If they continue channel 4 with k = 18, 20 ... 30,
#   then an eight byte block is one channel and one k block, and the only
#   question left is how the block index maps to (channel, k block).
#
#   If they do anything else, the block is not the unit and the answer is in
#   whatever they do instead.
#
#   ⚠ 17 through 31 are the control on that. Under the block reading they must
#   be channel 8 with k = 2, 4 ... 14 and then channel 12 with k = 16 upward.
#
#   ⚠ Byte 0 must come back channel 0, k = 0, or the shape moved and nothing
#   below counts. The conv2d-cal anchor either side says whether a dead byte is
#   a dead byte or a dead block.
#
#   ⚠ Do not write a formula into the tree from this log alone. Whatever it
#   says, the next round predicts three unmeasured bytes from it and checks
#   them before it goes anywhere near the packer.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	after=$(nbad)
	if [ "$after" != "$before" ]; then
		log "  !! POISON in this entry. The block faulted. This result is VOID."
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" \
			> /tmp/hc.txt 2>&1
		if grep -q "128/128 channels match" /tmp/hc.txt; then
			log "  !! health OK, the block recovered, continuing"
		else
			log "  !! health FAILED, the block is gone. ABORTING the round."
			ABORT=1
		fi
	fi
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	if [ -w /sys/module/rocket/parameters/reset_autosuspend ]; then
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend
		log "reset_autosuspend = $(cat /sys/module/rocket/parameters/reset_autosuspend)"
	else
		log "!! reset_autosuspend NOT WRITABLE. A timeout will kill the round."
	fi

	log ""
	log "===== 1) the anchor, so a dead byte is not a dead block            ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== 2) THE DENSE SWEEP. Bytes 0 to 31 with no gaps, then one     ====="
	log "=====    per eight byte block out to 72, then the sparse points    ====="
	log "=====    261 already has so the two logs can be compared directly. ====="
	log ""
	sleep 1
	/opt/charsiu/charsiu_int4 1 64 64 --kpair > "$C" 2>&1

	log ""
	log "===== 3) the anchor again                                          ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== Read 1 and 2, then 3 against 4. The bar is the arm beside it ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
