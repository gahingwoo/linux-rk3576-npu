#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-10 round 49. The magic word slot IS the second operand, and round 46
# moved the pointer without writing anything at the new target.
#
# The vendor's layout, from the capture:
#
#     0x5020 -> [A/B/C table][oc x fp16 scales]
#     0x5024 -> 0x0E0E, then zeros          (identical in both models)
#
# mesa's 0x5024 is bias_addr + groups*64, which is where the fp16 scales belong.
# So the word this driver writes at groups*64 has been serving as the SECOND
# OPERAND all along, not as a scale. That is what the round 36 "bitfield rule"
# actually describes, and it is why the vendor's scale entries violate it in
# 30 of 32 while its models compute: they are not the same field.
#
# It also says what round 46 got wrong. It wrote the scales and moved the
# pointer, but never wrote anything at the NEW target, so the second operand
# read zeros.
#
# Two tests, cheapest first:
#   2  put the vendor's second-operand value, 0x0E0E, where mesa's 0x5024
#      already points. No layout change at all. ROCKET_FS_F0 does this already.
#   3  the full vendor layout: fp16 scales at groups*64, 0x0E0E at
#      groups*64 + oc*2, and 0x5024 moved there.
#
# DECISION RULE, written before the run:
#   2 is 128/128            the slot is the second operand and 0x0E0E is its
#                           value; the magic word retires with an explanation
#   2 fails                 0x0E0E is not sufficient there, so the slot's
#                           content depends on something else as well
#   3 is 128/128            the whole vendor layout is adoptable and the
#                           surface is finally derived end to end
#   3 fails but 2 passes    the layout move is still wrong somewhere; keep the
#                           simple version and stop moving the pointer
#   1 or 9 not 128/128      the build is wrong, stop
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
p() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== 1) BASELINE: the magic word, must be 128/128 ====="
	p conv2d-cal.tflite ""

	log ""
	log "===== 2) THE CHEAP TEST: the vendor's 0x0E0E in the same slot ====="
	p conv2d-cal.tflite ROCKET_FS_F0=0x0E0E
	p cal_k3.tflite ROCKET_FS_F0=0x0E0E
	p dwconv.tflite ROCKET_FS_F0=0x0E0E

	log ""
	log "===== 3) THE FULL LAYOUT: scales, 0x0E0E past them, pointer moved ====="
	p conv2d-cal.tflite "ROCKET_SCALE_TABLE=1 ROCKET_SCALE_PTR=1"
	p cal_k3.tflite "ROCKET_SCALE_TABLE=1 ROCKET_SCALE_PTR=1"

	log ""
	log "===== 4) the full layout on depthwise ====="
	p dwconv.tflite "ROCKET_SCALE_TABLE=1 ROCKET_SCALE_PTR=1"
	p mn_dw1.tflite "ROCKET_SCALE_TABLE=1 ROCKET_SCALE_PTR=1"
	p dwconv.tflite "ROCKET_SCALE_TABLE=1 ROCKET_SCALE_PTR=1 ROCKET_DW_REC48=1"

	log ""
	log "===== 9) CONTROL that can fail: baseline again ====="
	p conv2d-cal.tflite ""

	log ""
	log "===== Read 1 and 9, then 2. 0x0E0E is the vendor's own value for   ====="
	log "===== the field mesa has been sweeping blind since round 32.       ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
