# ---------------------------------------------------------------------------
# 2026-08-21 round 306. The last int4 round. One number decides whether it is
# worth anything, and then this line is parked.
#
# ⚠⚠ 305 SHOWED THE CEILING WAS MINE. The layout works at every K tried up to
# 2048:
#
#   K = 288, 384, 512, 1024, 2048 at N = 64    wrote 40 of 64, exact 32, all
#   K = 512 at N = 16                          16 of 16 EXACT
#   bench K = 512 N = 64                       int8 24.6 us, int4 16.7 us, -32%
#
# exact is N/2 at every one of them, independent of K. That is a WORKING HALF
# WIDTH JOB, not a failure, which is the distinction the reading rule was
# written to keep and the reason it said to read wrote rather than exact.
#
# ⚠ SO THE TWELVE TIMES FROM 304 IS WRONG AND THE ARITHMETIC HAS TO BE REDONE.
# An int4 job at a declared K and N gives K/2 real k a channel and N/2 usable
# channels:
#
#   int4   NK/4 MACs for NK/8 weight bytes fetched   2 MACs a byte
#   int8   NK   MACs for NK   bytes                  1 MAC a byte
#
# int4 really is twice the work per byte, which is what a 4 bit weight should
# buy. It pays for it in JOBS: four times as many for the same total work, each
# with a fixed cost. Whether the 2x survives that depends on one thing only, HOW
# BIG A JOB CAN BE, and that is the largest N at a large K.
#
#   N = 1024 works at K = 2048   4 int4 jobs of 262 kB against one int8 job of
#                                2 MB and 201.5 us. At 10 GB/s and a 15 us fixed
#                                cost that is 164 us against 201, int4 by 19%.
#   N caps at 64                 32 usable channels a job, and a projection needs
#                                64 jobs. Slower by an order of magnitude and
#                                int4 is not worth it on this hardware.
#
# THE READING RULE, fixed before the run.
#
#   ⚠ THE ROUND IS ONE COLUMN: wrote, at K = 2048, as N grows. Every N so far at
#   a large K has been 16 or 64.
#
#     wrote keeps up with N/2 + 8 to N = 1024
#                         jobs can be big, int4 is worth about 19% on a
#                         projection, and it is worth coming back to
#     wrote stops at some N
#                         that N is the job size, and the projection arithmetic
#                         above says whether it is worth anything
#     wrote stays at 40 whatever N is
#                         the count is a fixed 40 rather than N/2 + 8, and int4
#                         tops out at 32 usable channels a job forever
#
#   ENTRY 4 benches the largest shape that works, against int8 at the same
#   shape, which is the only number that matters for the decision.
#
#   ⚠ AFTER THIS ROUND THE int4 LINE IS PARKED whichever way it goes. charsiu
#   has no softmax, no rmsnorm, no RoPE, no KV cache, no sampling and no
#   tokeniser, and 11.8 tok/s has never been measured. Those are precision
#   independent and they are what stands between this project and a token.
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
MM=/opt/charsiu/charsiu_matmul
BE=/opt/charsiu/charsiu_bench
CH=/opt/charsiu/charsiu_int4
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

c() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $*"; return 0; }
	before=$(nbad)
	sleep 1
	env $1 $2 $3 $4 $5 $6 $7 $8 $9 > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This arm is VOID."; health; }
	return 0
}

M4="CHARSIU_W4=1 CHARSIU_W4_HALFK=1"

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	if [ -w /sys/module/rocket/parameters/reset_autosuspend ]; then
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend
		log "reset_autosuspend = $(cat /sys/module/rocket/parameters/reset_autosuspend)"
	else
		log "!! reset_autosuspend NOT WRITABLE. A timeout will kill the round."
	fi

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "##### THE ROUND. how big can a job be. wrote, at K = 2048.         #####"
	for NN in 64 128 160 256 512 1024
	do
		log ""
		log "===== K = 2048  N = $NN     N/2 + 8 would be $((NN / 2 + 8))"
		c "$M4" X=1 $MM 1 2048 $NN
	done

	log ""
	log "===== 3) and at K = 512, in case the N limit moves with K          ====="
	c "$M4" X=1 $MM 1 512 256
	c "$M4" X=1 $MM 1 512 512

	log ""
	log "##### 4) the bench that decides it, at the biggest shapes          #####"
	log ""
	log "===== K = 2048  N = 256   int8 then int4                           ====="
	c X=1 X=1 $BE 1 2048 256 50
	c "CHARSIU_W4=1" X=1 $BE 1 2048 256 50
	log ""
	log "===== K = 2048  N = 1024  int8 then int4                           ====="
	c X=1 X=1 $BE 1 2048 1024 50
	c "CHARSIU_W4=1" X=1 $BE 1 2048 1024 50

	log ""
	log "===== 5) the regression, so the numbers above are of a right answer ====="
	c "$M4" X=1 $MM 1 224 160
	c "CHARSIU_W4=1" X=1 $MM 1 224 160

	log ""
	log "===== the anchor again                                             ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== wrote against N/2 + 8, then the two benches. Then park it.   ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
