# ---------------------------------------------------------------------------
# 2026-08-22 round 318. THE OUTPUT HEAD, THE LAST BIG THING ON THE CPU.
#
# ROUND 317: CHAINING WORKS AND MY NUMBER FOR IT WAS WRONG.
#
#   all projections, chained     4256 submits (112/token)   8.69 MB   5.08 tok/s
#   the same, UNCHAINED         18240 submits (480/token)   2.03 MB   4.42 tok/s
#
# Text character for character the reference in every rung, zero IOMMU errors.
# So the slices really do address different regions and chaining is correct.
#
# ⚠ I PREDICTED ABOUT 6 tok/s AND SAID IT WOULD PUT THE NPU AHEAD OF THE CPU.
# It did neither. And the reason is a second number of mine that was wrong:
# removing 368 submits a token saved 29 ms, which is **79 us a submit**, not the
# 190 us the round 165 figure implied. Chaining was worth 15%, not 40%.
#
# ⚠ AND THE DENOMINATOR NEEDS SAYING PROPERLY. Entry 6 measured charsiu's plain
# CPU path on the SAME FILE at 3.68 tok/s, which matches round 309's q8_0 number
# of 3.74. The 5.53 that has been quoted as "the CPU" is round 309's PURE q4_0
# model, a different file. So:
#
#   same file, CPU 3.68  ->  NPU 5.08     1.38x, and real
#   best CPU on this board, 5.53          the NPU is still 8% BEHIND it
#
# ---------------------------------------------------------------------------
# WHERE THE 197 ms A TOKEN ACTUALLY GOES
# ---------------------------------------------------------------------------
#
#   ~97 ms   the NPU fetching 973 MB of projection weights at about 10 GB/s
#   ~58 ms   THE CPU COMPUTING THE OUTPUT HEAD, 128256 x 2048 = 263 MB
#   the rest attention scores and softmax, the norms, RoPE, SwiGLU, sampling
#
# The head is 21% of all the matmul weight and it is still on the CPU, because
# CHARSIU_NPU_MAXN defaults to 8192 and the head is 128256 wide. On the NPU it
# would be 263 MB at 10 GB/s, about 26 ms, saving roughly 32 ms a token.
#
# It costs 126 slices and 298 MB of buffers, and its submit fetches 263 MB in
# one go, which is the largest single submit this project has ever made. The
# slow submit guard now scales with the bytes -- 100 ms plus a millisecond a
# megabyte, ten times slower than this hardware has ever been -- because a flat
# limit would have retired a legitimate big submit as a wedge.
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# 1) THE REPORT LINE FIRST. Entry 2 must say 113 tensors and about 606 slices.
#    112 tensors means the head did not go and the rung is round 317 again.
#
# 2) THEN THE TEXT, against entry 5, character for character. The head is the
#    ONE matmul whose output is compared directly against a vocabulary rather
#    than fed onward, so an error there changes the token immediately and
#    visibly -- this is the easiest place in the model to catch a wrong answer.
#
# 3) THEN TOKENS PER SECOND, which is the measurement.
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT
# ---------------------------------------------------------------------------
#
# A) IDENTICAL TEXT, 113 tensors, 606 slices, 113 submits a token.
#
# B) **ABOUT 6.1 tok/s, WHICH WOULD FINALLY PUT THE NPU AHEAD OF 5.53.** 32 ms
#    off 197. ⚠ I have now been wrong about a tokens per second prediction twice
#    running, both times by assuming a cost I had not measured at the shape in
#    question, so treat this as the thing being tested rather than the thing
#    being confirmed.
#
# C) The head's submit is 263 MB and 126 chained tasks. If anything is going to
#    find a limit in the driver or the block, it is this entry. It goes AFTER
#    the anchor and BEFORE the smaller rungs for that reason.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
RUN=/opt/charsiu/charsiu_run
M8=/opt/charsiu/models/Llama-3.2-1B-Instruct-Q8_0.gguf
PROMPT="The capital of France is"
LIMIT=420
CE=CHARSIU_COEF_ELEMS=65536
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

capped() {
	lim="$1"; shift
	"$@" &
	pid=$!
	i=0
	while [ "$i" -lt "$lim" ]; do
		kill -0 "$pid" 2>/dev/null || { wait "$pid"; return $?; }
		sleep 1
		i=$((i + 1))
	done
	kill -9 "$pid" 2>/dev/null
	wait "$pid" 2>/dev/null
	return 124
}

rung() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $1"; return 0; }
	lbl="$1"; shift
	before=$(nbad)
	log ""
	log "  -- $lbl"
	sleep 1
	capped "$LIMIT" env "$@" "$RUN" "$M8" -p "$PROMPT" -n 32 \
		--ignore-eos -q -c 512 -t 4 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the rung exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This rung is VOID."; health; }
	return 0
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	[ -w /sys/module/rocket/parameters/reset_autosuspend ] && \
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend

	log ""
	log "===== 0) the limit's own control. expect rc 124 after ~3s.         ====="
	t0=$(cut -d. -f1 /proc/uptime)
	capped 3 sleep 60
	rc=$?
	t1=$(cut -d. -f1 /proc/uptime)
	log "  -- capped 3 sleep 60  ->  rc $rc after $((t1 - t0))s"
	[ "$rc" = "124" ] || log "  !! THE LIMIT DID NOT FIRE. Nothing below can be trusted to end."

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "##### ROUND 318: the output head. 113 tensors or it did not go.    #####"

	log ""
	log "===== 2) THE ROUND. everything, the 128256 wide head included.     ====="
	rung "all 113, head included" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 "$CE" \
		CHARSIU_NPU_MAXN=131072

	log ""
	log "===== the anchor, right after the biggest submit ever made         ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== 3) THE CONTROL. the same run without the head: round 317.    ====="
	rung "112 projections, head on the CPU" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 "$CE"

	log ""
	log "===== 4) the head ALONE, so its cost can be attributed             ====="
	rung "only the head on the NPU" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 "$CE" \
		CHARSIU_NPU_MAXN=131072 CHARSIU_NPU_ONLY=token_embd

	log ""
	log "===== 5) the CPU reference the text is diffed against              ====="
	rung "CPU, NPU number format" CHARSIU_NPU_QUANT=1

	log ""
	log "===== 6) and charsiu's plain CPU path on the same file             ====="
	rung "plain CPU, q8_0" X=1

	log ""
	log "===== the anchor again                                             ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== 113 tensors, then the text, then tokens per second.          ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
