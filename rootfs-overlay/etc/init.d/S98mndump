# ---------------------------------------------------------------------------
# 2026-08-21 round 305. The K ceiling is mine, not the hardware's.
#
# ⚠⚠ 304 ANSWERED THE QUESTION THE WHOLE int4 LINE WAS FOR, and the answer is a
# negative worth more than the forty rounds that produced it.
#
#             int8 us/task    int4 us/task
#   K=224 N=160   22.7           18.4      -19%
#   K=128 N=160   16.0           14.9      - 7%
#   K=224 N= 64   14.7           13.3      -10%
#   K=2048 N=1024 201.5        cannot run this shape
#
# NOT 2x, and the reason is measurable. At 0.04 MB of weights the achieved
# bandwidth is 1.58 GB/s where at 2.10 MB it is 10.41. These shapes are LATENCY
# bound, not bytes bound, so halving the weight traffic buys almost nothing.
#
# ⚠ AND THE TILING IS THE REAL NUMBER. A K = 2048 by N = 1024 projection is ONE
# int8 job at 201.5 us. int4 caps K at 224 with K/2 real k a job, so 2048 needs
# 19 K tiles, and N caps at 160, so 1024 needs 7. That is 133 jobs at 18.4 us,
# 2447 us, TWELVE TIMES SLOWER than int8.
#
# The memory this project carries says "int4, 2x, and the road is half open".
# Measured, the road as it stands leads somewhere twelve times worse.
#
# ⚠ BUT THE CEILING THAT FORCES THAT IS MINE. The packer refused K above 256
# because 256 was the largest anything had been run at, and K = 256 fails on the
# CHANNEL COUNT, not the layout: K/32 is whole there and exact is N/2 exactly.
# Nothing has ever said the LAYOUT stops. The guard now goes to 2048.
#
# THE READING RULE, fixed before the run.
#
#   ⚠ ENTRIES 3 TO 7 ARE THE ROUND: K of 288, 384, 512, 1024 and 2048 at N = 64,
#   all multiples of 32, none ever run.
#
#     the layout holds and only the count falls back
#                         then the ceiling is the count, and a job at K = 2048
#                         with N/2 channels is still one job, not nineteen. That
#                         changes the whole arithmetic above.
#     the layout stops somewhere
#                         the round says where, and that K is the real tile size
#     everything above 256 is wrong
#                         224 is the envelope and int4 is not usable for a
#                         projection on this hardware, which is a result and
#                         should be written as one
#
#   ⚠ READ wrote, NOT exact. At K = 256 exact is N/2 and wrote is N/2 + 8; if
#   that pattern continues, exact of N/2 at K = 2048 is a WORKING half width
#   job, not a failure, and the two are only told apart by which channels.
#
#   ENTRY 2 is the regression at K = 64, 128 and 224.
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
MM=/opt/charsiu/charsiu_matmul
BE=/opt/charsiu/charsiu_bench
CH=/opt/charsiu/charsiu_int4
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

c() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $*"; return 0; }
	before=$(nbad)
	sleep 1
	env $1 $2 $3 $4 $5 $6 $7 $8 $9 > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This arm is VOID."; health; }
	return 0
}

M4="CHARSIU_W4=1 CHARSIU_W4_HALFK=1"

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	if [ -w /sys/module/rocket/parameters/reset_autosuspend ]; then
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend
		log "reset_autosuspend = $(cat /sys/module/rocket/parameters/reset_autosuspend)"
	else
		log "!! reset_autosuspend NOT WRITABLE. A timeout will kill the round."
	fi

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== 2) the regression at K = 64, 128 and 224                     ====="
	c "$M4" X=1 $MM 1 64 64
	c "$M4" X=1 $MM 1 128 160
	c "$M4" X=1 $MM 1 224 160

	log ""
	log "##### THE ROUND. K above 256, which only my own guard forbade.     #####"
	for KK in 288 384 512 1024 2048
	do
		log ""
		log "===== K = $KK  N = 64      read wrote, not exact"
		c "$M4" X=1 $MM 1 $KK 64
	done

	log ""
	log "===== 8) and K = 512 at N = 16, where N/2 + 8 would cover N        ====="
	c "$M4" X=1 $MM 1 512 16

	log ""
	log "===== 9) if any large K works, what it costs                       ====="
	c "CHARSIU_W4=1" X=1 $BE 1 512 64 50
	c X=1 X=1 $BE 1 512 64 50

	log ""
	log "===== the control that must FAIL, and int8 at K = 512              ====="
	c "CHARSIU_W4=1" X=1 $MM 1 224 64
	c X=1 X=1 $MM 1 512 64

	log ""
	log "===== the anchor again                                             ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== one job at a large K would undo the twelve times.            ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
