# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-12 round 108. The stride 2 depthwise is fixed. Now 64 channels.
#
# Round 107, on dw1_s2, which is mn_dw1 with only its stride patched to 2:
#
#   default, the stride key          2/32   maxdiff 255
#   ROCKET_DW_SPLITVALS=1           32/32   maxdiff 1
#   ROCKET_CBUF_DERIVE=1            32/32   maxdiff 1
#   mn_dw1 under both knobs         32/32   unmoved, as required
#   conv2d-cal under CBUF_DERIVE   128/128  unmoved, as required
#
# So CNA 0x1018 and 0x1040 were keyed off the stride and a depthwise wants the
# split pair whatever its stride. That is now the default, narrowed to
# depthwise so no regular conv can be affected by it, with
# ROCKET_DW_NOSPLITVALS as the control.
#
# I am not taking the vendor's rule as the default yet even though round 107's
# own decision rule said to prefer it. It is the more general answer and it
# works here, but it changes REGULAR convs too and exactly one of them has been
# put against it. Tests 8 to 12 put the rest of them against it in this flash;
# if they all hold, it replaces the narrow fix.
#
# What the fix does NOT do is repair op3: mn_L03 with the knob was still 1 of
# 64 at maxdiff 255. dw1_s2 is 32 channels and op3 is 64, and 64 has never been
# run on this hardware in any layer. 32 and 1024 are both correct at stride 1
# and 32 is now correct at stride 2, so 64 is the last untried count, and the
# depthwise weight buffer is laid out in groups of exactly 64.
#
# DECISION RULE, written before the run:
#   L03 is now near its model, 21/64 md13   the split pair was the whole of it
#                                           and the ladder moves to op4
#   L03 still collapses                     64 channels is a second and
#                                           separate fault, and the group
#                                           boundary is where to look
#   L05, 128 channels at stride 1, is also wrong once L03 is right
#                                           it is channel count, not stride
#
# Tests 2 to 7 are the ladder. Tests 8 to 12 are the regular conv set against
# the vendor's rule, and every one of them is currently correct, so any of them
# can fail. Tests 13 to 15 are the standing regression.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
p() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== 1) dw1_s2, which the fix makes 32/32. CONTROL for the build ====="
	p dw1_s2.tflite ""

	log ""
	log "===== 2..7) the ladder with the fix in. L03 model 21/64 md13 ====="
	p mn_L02.tflite ""
	p mn_L03.tflite ""
	p mn_L04.tflite ""
	p mn_L05.tflite ""
	p mn_L07.tflite ""
	p mn_L08.tflite ""

	log ""
	log "===== 8..12) the vendor rule against every regular conv we have ====="
	p conv2d-cal.tflite "ROCKET_CBUF_DERIVE=1"
	p cal_s1.tflite "ROCKET_CBUF_DERIVE=1"
	p cal_k1.tflite "ROCKET_CBUF_DERIVE=1"
	p cal_k3.tflite "ROCKET_CBUF_DERIVE=1"
	p cal_oc16.tflite "ROCKET_CBUF_DERIVE=1"

	log ""
	log "===== 13) CONTROL: the stride key back. dw1_s2 must break again ====="
	p dw1_s2.tflite "ROCKET_DW_NOSPLITVALS=1"

	log ""
	log "===== 14..16) REGRESSION ====="
	p mn_dw1.tflite ""
	p mn_dw25.tflite ""
	p mn_conv0.tflite ""

	log ""
	log "===== L03 first, then 8..12, then check 13 breaks it again.       ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
