#!/bin/sh
# ---------------------------------------------------------------------------
# 2026-08-09 round 25. Round 24 found the k-dependence. This one calibrates it.
#
# WHAT ROUND 24 ESTABLISHED, controls first:
#   knob fired            coefficient buffer md5 1beebc1f -> 84278999
#   control that failed   conv2d-cal with the region ZEROED went 2/2 to 0/2,
#                         relu maxdiff 1 to 128. THE REGION IS LOAD BEARING.
#   and the payload       on a constant input, conv2d-cal and cal_k3 with the
#                         vendor-shaped table returned BYTE IDENTICAL results,
#                         where before k=5 was correct and k=3 was a flat zero
#                         point.
#
# So the thing that depends on the kernel is that region. mesa writes a float32
# surface there whose size is MAX2(ic*oc*k*k, 8192) floats and whose content is
# one entry per weight, so both its length and its values move with the kernel,
# and it is load bearing. The vendor writes a per-output-channel uint16 table
# instead, which does not depend on the kernel at all. Replacing one with the
# other made the two kernel sizes agree.
#
# That explains why every single variable before this was refuted: the regcmd,
# the weight layout, the bias, the requant and A, B and C are all correct, and
# this was the only k-dependent payload, mistaken for padding against an
# out-of-bounds read.
#
# WHAT IS NOT KNOWN: the value. 0x1700 was the middle of the captured range and
# it over-scales, both models saturating to 255. The captured values were 5400
# to 6400 across 128 channels for models whose weights differ per channel; for
# a per-tensor model like conv2d-cal the correct table should be uniform, so a
# single constant can be right, and this sweeps for it.
#
# DECISION RULE: conv2d-cal is the oracle, it must return to 2/2 at the right
# value. If some value makes it correct, that value against its known scales
# gives the formula. If nothing in the sweep helps, the table is per-channel in
# a way a constant cannot express and the next step is deriving it from the
# capture instead.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }

try() {
	log "--- FS_PERCH=$1 ---"
	env TEFLON_LIB=/usr/lib/libteflon.so ROCKET_FS_PERCH="$1" \
		python3 "$NPU_DIR/test_model.py" "$NPU_DIR/conv2d-cal.tflite" 1 > "$C" 2>&1
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	# -n 8 floods the serial console and wedges the box. Learned the hard way.
	dmesg -n 4 2>/dev/null

	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null
	log ""
	log "  task_con16=$(cat /sys/module/rocket/parameters/task_con16 2>/dev/null)"

	log ""
	log "===== 1) CONTROL: conv2d-cal untouched, the oracle for correct ====="
	env TEFLON_LIB=/usr/lib/libteflon.so \
		python3 "$NPU_DIR/test_model.py" "$NPU_DIR/conv2d-cal.tflite" 2 > "$C" 2>&1

	log ""
	log "===== 2) SWEEP the per-channel value on conv2d-cal ====="
	log "  0x1700 saturated, so walk down. relu maxdiff going to 1 is correct."
	sleep 2
	for v in 0x1700 0x1000 0x0c00 0x0800 0x0600 0x0400 0x0300 0x0200 0x0100 0x0080 0x0040 0x0010; do
		try $v
		sleep 1
	done

	log ""
	log "===== 3) the two nearest neighbours of 0x4000, the Q14 unit ====="
	log "  mesa's C coefficient uses 0x4000 as unity, so try around it"
	sleep 2
	for v in 0x4000 0x2000; do try $v; sleep 1; done

	log ""
	log "===== 4) whichever value looked best, on k=3 as well ====="
	log "  read section 2 first and compare; this is only a convenience run"
	sleep 2
	for v in 0x0400 0x0100; do
		log "--- k=3 FS_PERCH=$v ---"
		env TEFLON_LIB=/usr/lib/libteflon.so ROCKET_FS_PERCH=$v \
			python3 "$NPU_DIR/test_model.py" "$NPU_DIR/cal_k3.tflite" 1 > "$C" 2>&1
		sleep 1
	done

	log ""
	log "===== 5) REPEAT CONTROL: conv2d-cal untouched ====="
	sleep 2
	env TEFLON_LIB=/usr/lib/libteflon.so \
		python3 "$NPU_DIR/test_model.py" "$NPU_DIR/conv2d-cal.tflite" 2 > "$C" 2>&1

	log ""
	log "===== look for relu maxdiff dropping toward 1 in section 2. That    ====="
	log "===== value against conv2d-cal's known scales gives the formula.    ====="
	sync
}

case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
