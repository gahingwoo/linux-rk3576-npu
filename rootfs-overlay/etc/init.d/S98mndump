#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-23 round 366. THE SAME ROUND, WITH THE ACTIVATION IN BOTH DEVICES.
#
# ⛔ ROUND 365 PRODUCED WORD SALAD AND THE RULE CAUGHT IT. "Read the sentence
# first, not the rate" was written into the round before it ran, and it is the
# only reason the 10.13 tok/s was not reported as a result:
#
#   int8, two devices    "soundingampedferballwick accompany gubit..."
#   int4, two devices    "AN Aud Emer masterittleassandra mastersmerart..."
#   int4, ONE device     "Paris. The Eiffel Tower is located in Paris..."
#
# The one device control was perfect, so the slice split broke the arithmetic --
# and it broke int8 as well, which had been fine on two devices in round 364.
#
# ⛔ THE BUG WAS MINE AND IT WAS THE SAME ONE TWICE. The single projection path
# packed the activation into ONE device's input buffer:
#
#     charsiu_bo_prep(g->dev[e->di], &g->in[e->di], ...);
#         ... pack ...
#     charsiu_bo_fini(g->dev[e->di], &g->in[e->di]);
#
# Round 365 spread a tensor's SLICES across both devices, so the slices on the
# other device read an input buffer nobody had written. **The grouped path had
# already been fixed for exactly this and the single path was not.**
#
# ⚠ AND IT COULD NOT HAVE BEEN CAUGHT ON THE HOST. There is no accel device
# there, so npudev never runs. The board is the only test this code has, which
# is an argument for auditing it rather than iterating on it: every place that
# assumed one device per entry has now been walked, e->di is gone entirely, and
# both accumulate loops read e->out[s->di] rather than an entry wide buffer.
#
# ---------------------------------------------------------------------------
# WHAT ROUND 365's NUMBERS ARE WORTH
# ---------------------------------------------------------------------------
#
#   int4, two devices, slices split   10.13 tok/s, fence 3877 ms, 9100 submits
#   int4, one device                   8.45 tok/s, fence 5509 ms, 4550 submits
#
# The hardware fetched the same weights and ran the same MACs either way, so
# these are probably representative -- but they came out of a run that computed
# nonsense, so they are a hint and not a measurement. This round measures them
# again with the answer right.
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# ENTRY 2 AND ENTRY 3 MUST BE THE SAME SENTENCE, word for word, and it must be
# the Eiffel Tower and the Louvre. Anything else and the split is still wrong.
#
# Only then the rate, against entry 3 in the same boot. If it lands near 10 the
# slice split is worth about 20%, and the remaining question is the submit
# count: 9100 against 4550 is twice the submits for half the bytes each, which
# is a lot of per submit cost to be paying for parallelism.
#
# ENTRY 1 is int8, which also splits and which also produced salad last time.
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT
# ---------------------------------------------------------------------------
#
# The sentence comes back and the rate stays near 10.1. If the sentence comes
# back but the rate drops, then some of last round's speed was the broken input
# -- an all zero activation is cheaper to multiply than a real one only if the
# hardware short circuits, which it has never shown any sign of doing.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
VD=/opt/charsiu/charsiu_vendor
V=/opt/charsiu/vendor
RGC=$V/vendor-int4-k2048-n1024.regcmd
WT=$V/vendor-wt-1M.bin
IN=$V/vendor-in.bin
RUN=/opt/charsiu/charsiu_run
M8=/opt/charsiu/models/Llama-3.2-1B-Instruct-Q8_0.gguf
PROMPT="The capital of France is"
LIMIT=420
# 32 tokens does not reach the answer to "17 times 24, show your working"
NGEN=64
CE=CHARSIU_COEF_ELEMS=65536
HEAD=CHARSIU_NPU_MAXN=131072
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block did not come back this time."
		ABORT=1
	fi
}

capped() {
	lim="$1"; shift
	"$@" &
	pid=$!
	i=0
	while [ "$i" -lt "$lim" ]; do
		kill -0 "$pid" 2>/dev/null || { wait "$pid"; return $?; }
		sleep 1
		i=$((i + 1))
	done
	kill -9 "$pid" 2>/dev/null
	wait "$pid" 2>/dev/null
	return 124
}
rung() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $1"; return 0; }
	lbl="$1"; shift
	before=$(nbad)
	log ""
	log "  -- $lbl"
	sleep 1
	capped "$LIMIT" env "$@" "$RUN" "$M8" -p "$PROMPT" -n "${NGEN:-32}" \
		--ignore-eos -q -c 512 -t 4 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the rung exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This rung is VOID."; health; }
	return 0
}
# arm: <label> <regcmd-or-dash> <byte> <high> [extra env, one assignment]
#
# ⚠ THE ENV GOES IN AS AN ARGUMENT, not as a "VAR=x arm ..." prefix. Whether an
# assignment before a FUNCTION call survives the call is unspecified -- dash
# drops it, other shells keep it -- and the arm whose whole job is to time out
# WITHOUT the trailer runs right after the one that has it. Not a question worth
# leaving to the shell.
arm() {
	before=$(nbad)
	log ""
	log "  ---- $1"
	sleep 1
	env ${5:-IGNORED=1} $VD "$2" "$WT" "$IN" "$3" "$4" 4096 > /tmp/vd.txt 2>&1
	cat /tmp/vd.txt > "$C"
	after=$(nbad)
	if [ "$after" != "$before" ]; then
		log "  !! POISONED: $((after - before)) new fault or timeout lines"
		health
		# ⚠ NOT a round abort. Round 342 threw away every arm after the
		# first poisoning and then measured the block healthy at the
		# end. The block recovers; give it a moment and carry on.
		ABORT=0
		sleep 2
	fi
}

# two concurrent probes, so the pair can be repeated without copy and paste
pair() {
	before=$(nbad)
	log ""
	log "  ---- $1"
	env CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_TIME=60 CHARSIU_OUT_KB=64 $2 $VD - "$WT" "$IN" 0 0 4096 > /tmp/vdA.txt 2>&1 &
	pidA=$!
	env CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_TIME=60 CHARSIU_OUT_KB=64 $3 $VD - "$WT" "$IN" 0 0 4096 > /tmp/vdB.txt 2>&1 &
	pidB=$!
	wait "$pidA"
	wait "$pidB"
	log "    A:"
	grep -E "M = |TIME:|baseline:|VERIFY:|CONTROL repeat|VOID|REREAD" /tmp/vdA.txt > "$C"
	log "    B:"
	grep -E "M = |TIME:|baseline:|VERIFY:|CONTROL repeat|VOID|REREAD" /tmp/vdB.txt > "$C"
	after=$(nbad)
	[ "$after" != "$before" ] && log "  !! POISONED: $((after - before)) new lines"
	return 0
}

start() {
	log ""
	log "###############################################################"
	log "##### round 366: the activation, into BOTH devices           #####"
	log "###############################################################"
	log "  int4 is byte exact and 1.42 to 1.78x faster. now decode with it."

	log ""
	log "===== 1) CONTROL: int8 decode. 6.4 tok/s, standing sentence.   ====="
	dmesg 2>/dev/null | grep -i "NPU core" > "$C"
	rung "int8" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 "$CE" "$HEAD"

	log ""
	log "===== 2) int4 g1024, slices split. THE SENTENCE FIRST.        ====="
	rung "int4 g1024, two devices" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 CHARSIU_NPU_W4V=1 CHARSIU_NPU_KMAX=1024 CHARSIU_NPU_W4_GROUP=1024 "$CE" "$HEAD"

	log ""
	log "===== 3) the same on ONE device. the control.                 ====="
	log "  the SAME sentence as entry 2, word for word."
	rung "int4 g1024, one device" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 CHARSIU_NPU_W4V=1 CHARSIU_NPU_KMAX=1024 CHARSIU_NPU_W4_GROUP=1024 CHARSIU_NPU_ONEDEV=1 "$CE" "$HEAD"

	log ""
	log "===== 4) the probe, still exact under the two device build     ====="
	arm "solo verify" "-" 0 0 "CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_VERIFY=1 CHARSIU_OUT_KB=64"

	log ""
	log "===== 5) the anchor: int8 conv must still be exact            ====="
	health

	log ""
	log "===== read the CONTROL lines first. VOID means the arm died. ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
