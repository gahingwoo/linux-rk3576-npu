#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-24 round 374. THE KV CACHE, LAID OUT THE WAY IT IS READ.
#
# 🏁 ROUND 373 CONFIRMED THE DIAGNOSIS, and the clause that would have ended it
# did not fire.
#
#   384 tok, grouped     10.19 tok/s   97.8 ms   attention 23.26   10.15 GB/s
#   384 tok, per head     8.84        112.7      attention 37.93   10.10
#   64 tok, grouped      13.08         76.1      attention  3.96   10.44
#
# **The host said 9% and the board says 38.7%.** The two 384 token arms
# generated byte identical text, 401 bytes each, so only the interleaving
# changed, exactly as claimed. Short context did not regress.
#
# ⚠ WORTH KEEPING FROM THAT: the host was the wrong machine to ask. Its caches
# are large enough and its memory fast enough that reading a row four times is
# nearly free. **A cache residency question has to be asked where the cache
# is**, and if I had believed the host's 9% the 14.7 ms would still be there.
#
# ---------------------------------------------------------------------------
# WHAT IS LEFT IN ATTENTION, AND WHAT THIS ROUND TAKES
# ---------------------------------------------------------------------------
#
#     redundant traffic removed in 373   14.7 ms
#     traffic left, one pass              4.9 ms   12.9 MB at 2.65 GB/s
#     everything else                    18.4 ms   <- now the larger half
#
# 2.65 GB/s is a walk, not a read: the cache was [layer][position][kv dim], so
# one kv head's consecutive positions sit 2048 bytes apart -- and attention
# goes exactly that way, one head across every position. This CPU reads
# SEQUENTIALLY at 7.13 GB/s (round 370).
#
# It is [layer][kv head][position][head dim] now, which makes that walk
# contiguous. The write becomes one memcpy a kv head rather than one a layer,
# eight copies of 256 bytes instead of one of 2048, 128 a token -- nothing
# against 12.9 MB of reading. **No value moves, so no token can.** Checked on
# the host across five configurations, every one reproducing its hash.
#
# CHARSIU_KV_POSMAJOR puts the old layout back, and the branch that picks
# between them is taken once a GROUP, not once a position.
#
# ---------------------------------------------------------------------------
# AND A DEFECT THE LOG ITSELF SHOWED
# ---------------------------------------------------------------------------
#
# Round 372's 384 token arm printed <|eot_id|> and <|start_header_id|> into the
# text. Those are CONTROL tokens -- the model steers with them and nobody reads
# them -- and tokenizer_decode hands back their literal SPELLING. The loop
# intercepted only end-of-generation and wrote whatever else came back, so four
# of them landed in the output as 58 characters of tag.
#
# They are suppressed now. ⚠ They still COUNT and still go back into the model:
# each cost a forward pass and each is real context, so only the printing
# changes. --show-special prints them anyway, which is how this was confirmed
# to fire rather than to do nothing.
#
# ⚠ SO THE 384 TOKEN TEXT WILL NOT MATCH ROUND 373'S ARCHIVED OUTPUT, and that
# is this change, not the layout. Arms 1 and 2 must still match EACH OTHER.
#
# The end-of-generation handling itself was never broken: with --chat and
# without --ignore-eos the model stops on its own after seventeen tokens with a
# well formed answer. It is the benchmark's --ignore-eos, which exists so a
# timing round generates a fixed count, that lets a control token be sampled at
# all.
#
# One more, found next to it: this tool passed a hard 1 for add_bos where
# tokenizer_encode has always taken -1 to mean "ask the file". Llama 3's file
# says true, so nothing moves here, but a model whose file said otherwise got a
# begin-of-text it did not ask for. It asks the file now.
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# THE SENTENCES. Arms 1 and 2 must be identical to each other and arm 3 must be
# the Louvre sentence. A layout change that moves a word is a bug.
#
# ⚠ THEN THE attention ROW AGAINST A FLOOR THIS ROUND CAN STATE IN ADVANCE.
# Only the 4.9 ms of traffic can improve, and at best it becomes 4.9 * 2.65 /
# 7.13 = 1.8 ms. So:
#
#     attention CANNOT go below about 20.2 ms
#
# and the honest window is 20 to 21.5, the token 97.8 to about 95, the rate
# 10.19 to about 10.5.
#
# **If it comes back well BELOW 20 ms, the decomposition was wrong** -- traffic
# was a bigger share of attention than the four times model implied, and the
# 18.4 ms of "everything else" is smaller than I think. That would be good news
# and a correction, not a win to file quietly.
#
# **If it comes back at 23 unchanged**, the strided walk was not costing
# anything and 2.65 GB/s was measuring something other than what I think.
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT
# ---------------------------------------------------------------------------
#
# About 3 ms, which is a quarter of what round 373 got and the last of the easy
# traffic. The host measured 15% of its own attention, against 9% for the
# regrouping it under-reported by four times -- but the ceiling above is
# arithmetic and the host cannot argue with it.
#
# After this the remaining 18.4 ms is arithmetic and loop overhead, not
# traffic, and the next thing to look at is the dot product's dependency chain:
# two accumulators over eight dependent FMAs. That one REORDERS a sum and would
# move tokens, so it does not belong in the same round as a layout change.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
VD=/opt/charsiu/charsiu_vendor
V=/opt/charsiu/vendor
RGC=$V/vendor-int4-k2048-n1024.regcmd
WT=$V/vendor-wt-1M.bin
IN=$V/vendor-in.bin
RUN=/opt/charsiu/charsiu_run
M8=/opt/charsiu/models/Llama-3.2-1B-Instruct-Q8_0.gguf
PROMPT="The capital of France is"
LIMIT=420
# 32 tokens does not reach the answer to "17 times 24, show your working"
NGEN=64
CE=CHARSIU_COEF_ELEMS=65536
HEAD=CHARSIU_NPU_MAXN=131072
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block did not come back this time."
		ABORT=1
	fi
}

capped() {
	lim="$1"; shift
	"$@" &
	pid=$!
	i=0
	while [ "$i" -lt "$lim" ]; do
		kill -0 "$pid" 2>/dev/null || { wait "$pid"; return $?; }
		sleep 1
		i=$((i + 1))
	done
	kill -9 "$pid" 2>/dev/null
	wait "$pid" 2>/dev/null
	return 124
}
rung() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $1"; return 0; }
	lbl="$1"; shift
	before=$(nbad)
	log ""
	log "  -- $lbl"
	sleep 1
	capped "$LIMIT" env "$@" "$RUN" "$M8" -p "$PROMPT" -n "${NGEN:-32}" \
		--ignore-eos -q -c 512 -t 4 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the rung exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This rung is VOID."; health; }
	return 0
}
# arm: <label> <regcmd-or-dash> <byte> <high> [extra env, one assignment]
#
# ⚠ THE ENV GOES IN AS AN ARGUMENT, not as a "VAR=x arm ..." prefix. Whether an
# assignment before a FUNCTION call survives the call is unspecified -- dash
# drops it, other shells keep it -- and the arm whose whole job is to time out
# WITHOUT the trailer runs right after the one that has it. Not a question worth
# leaving to the shell.
arm() {
	before=$(nbad)
	log ""
	log "  ---- $1"
	sleep 1
	env ${5:-IGNORED=1} $VD "$2" "$WT" "$IN" "$3" "$4" 4096 > /tmp/vd.txt 2>&1
	cat /tmp/vd.txt > "$C"
	after=$(nbad)
	if [ "$after" != "$before" ]; then
		log "  !! POISONED: $((after - before)) new fault or timeout lines"
		health
		# ⚠ NOT a round abort. Round 342 threw away every arm after the
		# first poisoning and then measured the block healthy at the
		# end. The block recovers; give it a moment and carry on.
		ABORT=0
		sleep 2
	fi
}

# two concurrent probes, so the pair can be repeated without copy and paste
pair() {
	before=$(nbad)
	log ""
	log "  ---- $1"
	env CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_TIME=60 CHARSIU_OUT_KB=64 $2 $VD - "$WT" "$IN" 0 0 4096 > /tmp/vdA.txt 2>&1 &
	pidA=$!
	env CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_TIME=60 CHARSIU_OUT_KB=64 $3 $VD - "$WT" "$IN" 0 0 4096 > /tmp/vdB.txt 2>&1 &
	pidB=$!
	wait "$pidA"
	wait "$pidB"
	log "    A:"
	grep -E "M = |TIME:|baseline:|VERIFY:|CONTROL repeat|VOID|REREAD" /tmp/vdA.txt > "$C"
	log "    B:"
	grep -E "M = |TIME:|baseline:|VERIFY:|CONTROL repeat|VOID|REREAD" /tmp/vdB.txt > "$C"
	after=$(nbad)
	[ "$after" != "$before" ] && log "  !! POISONED: $((after - before)) new lines"
	return 0
}

BW=/opt/charsiu/charsiu_membw
DEC="CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 CHARSIU_NPU_W4V=1 CHARSIU_NPU_KMAX=1024 CHARSIU_NPU_W4_GROUP=1024"

# decode and a memory reader at the same time, both numbers kept
squeeze() {
	log ""
	log "  ---- $1"
	sleep 1
	env $DEC "$CE" "$HEAD" "$RUN" "$M8" -p "$PROMPT" -n 128 --ignore-eos \
		-q -c 512 -t 4 > /tmp/dec.txt 2>&1 &
	dpid=$!
	# past staging and into generation before the reader starts
	sleep "$2"
	if [ -n "$3" ]; then
		env CHARSIU_THREADS=4 CHARSIU_SECONDS="$3" $BW > /tmp/bw.txt 2>&1
	fi
	wait "$dpid"
	grep -E "tensors staged|gen 128|GB/s of weights|of that," /tmp/dec.txt > "$C"
	[ -n "$3" ] && cat /tmp/bw.txt > "$C"
	return 0
}

start() {
	log ""
	log "###############################################################"
	log "##### round 374: the kv cache laid out the way it is read   #####"
	log "###############################################################"
	log "  one head across every position, contiguous at last."

	B="CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 CHARSIU_NPU_W4V=1 CHARSIU_NPU_KMAX=1024 CHARSIU_NPU_W4_GROUP=1024 CHARSIU_STAGES=1"

	log ""
	log "===== 1) 384 tokens, head major                                ====="
	log "  attention CANNOT go below about 20.2 ms. below that and"
	log "  the decomposition was wrong, not the change good."
	NGEN=384
	rung "int4 g1024, 384 tokens, head major" $B "$CE" "$HEAD"

	log ""
	log "===== 2) THE CONTROL: 384 tokens, position major               ====="
	log "  the old layout. must reproduce 23.26 ms and the SAME words."
	rung "int4 g1024, 384 tokens, pos major" $B CHARSIU_KV_POSMAJOR=1 "$CE" "$HEAD"
	NGEN=64

	log ""
	log "===== 3) 64 tokens, the short case                             ====="
	log "  about 13.08 tok/s, attention at or below 3.96 ms."
	rung "int4 g1024, 64 tokens" $B "$CE" "$HEAD"

	log ""
	log "===== 4) the probe, still exact                                ====="
	arm "solo verify" "-" 0 0 "CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_VERIFY=1 CHARSIU_OUT_KB=64"

	log ""
	log "===== 5) the anchor: int8 conv must still be exact            ====="
	health

	log ""
	log "===== read the CONTROL lines first. VOID means the arm died. ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
