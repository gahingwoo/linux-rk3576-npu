# ---------------------------------------------------------------------------
# 2026-08-12 round 119. The window is the budget, derived.
#
# Round 118 pinned it, and the two tests that could have embarrassed the
# reading came out the way capacity predicts and the opposite way to channels:
#
#   dw64w70    2450 entries   64/64    pass, predicted pass
#   dw64w72    2592 entries    0/64    fail, predicted fail
#   dw32w111   3108 entries    0/32    fail, predicted fail, 32 channels
#   dw128w44   1936 entries  128/128   pass, predicted pass, 128 channels
#
# So one task may stage about 2560 entries of input, five CBUF banks, and the
# channel count only matters through how much a row costs. calc_input_banks is
# allowed fifteen banks, three times what the hardware will take, and the
# generic path never checks.
#
# The 91 that was hardcoded as the row window is that same capacity divided by
# the single case it was measured on: 2560 / 28 entries per row, at 32 channels
# and 112 wide, is 91.4. So max_iwin is now derived from the budget and the
# path is entered whenever a layer is over it, at any width. The derivation
# reproduces 91 exactly for the case it came from, which is the check that
# matters, and it is checked by tests 6 to 9 rather than asserted.
#
# DECISION RULE, written before the run:
#   dw64w72, dw32w111, dw64w80 and dw64w96 all come good
#             the budget is the whole of it on the generic path
#   they come good and mn_L03 does not
#             the row-window path has a second fault of its own, which round
#             111 already hinted at: L03 at ROCKET_ROWWIN=24 needs three banks
#             and still failed
#   they do not come good
#             the budget is real but splitting is not how the hardware wants it
#             met, and the next question is what a window costs that a whole
#             surface does not
#
# Tests 6 to 9 are the control and they are the calibrated cases: mn_dw1 and
# dw32 are 112 wide at 32 channels, where the derived window must come out at
# exactly the 91 that was there before, and conv2d-cal and mn_dw25 are under
# the budget so they must not be split at all. Any of them moving means the
# derivation changed the case it was fitted to.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
p() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== 1..4) the four that were over budget and failed ====="
	p dw64w72.tflite ""
	p dw32w111.tflite ""
	p dw64w80.tflite ""
	p dw64w96.tflite ""

	log ""
	log "===== 5) and the 64 channel layer in the real graph ====="
	p mn_L03.tflite ""

	log ""
	log "===== 6..9) CONTROL: the calibrated cases must not move ====="
	p mn_dw1.tflite ""
	p dw32.tflite ""
	p conv2d-cal.tflite ""
	p mn_dw25.tflite ""

	log ""
	log "===== 10..11) and the ones that were already under budget ====="
	p dw64w70.tflite ""
	p dw128w44.tflite ""

	log ""
	log "===== 12) CONTROL: the old budget back, dw64w72 must break again ====="
	p dw64w72.tflite "ROCKET_CBUF_ENTRIES=100000"

	log ""
	log "===== 1..4 are the round. 6..9 must be unchanged.                 ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
