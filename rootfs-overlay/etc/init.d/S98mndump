#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-09 round 33. It is ONE float32. Find out what "the right one" means.
#
# Round 32, both baselines 128/128:
#   KEEP 256, 128, 64, 32, 16, 8, 4   all 128/128
#   KEEP 0                            0/128
# So the whole 197888 byte float surface comes down to the FIRST FOUR BYTES.
# Everything else in it can be zero and conv2d-cal is still byte correct.
#
# And it is not merely "nonzero": round 30 put 0x43d343d3 there, about 423.3,
# and every channel died. The value mesa happens to write is
#   fs[0] = wt_sc * (w[0][0][0][0] - wt_zp) = -109.55 = 0xc2db199a
#
# One scalar decides the whole layer. ROCKET_FS_F0 sets exactly that word, as a
# float or as a raw hex pattern, since it is not established that the hardware
# reads it as a float at all. Everything runs with KEEP=4 so the word under test
# is the only live byte in the region.
#
# Note the two known points differ in SIGN as well as magnitude:
#   works  -109.55  0xc2db199a   high byte 0xc2
#   fails   423.3   0x43d3a666   high byte 0x43
#
# DECISION RULE, written before the run:
#   every negative passes, every positive fails   it is the SIGN, and mesa is
#       right by luck; the fix is to write any negative constant, not a weight
#   only -109.55 passes                           it is the exact dequantised
#       weight, so the hardware really does read channel 0 tap 0 from here
#   a magnitude band passes                       report the band
#   the hex probes pass or fail against the float ordering  it is a BIT PATTERN
#       and not a float, which changes what to write entirely
#   step 1 or 12 not 128/128                      the build is wrong, stop
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
one() { v="$1"; log ""; log "===== FS_F0 = $v ====="; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so ROCKET_FS_FLOATS=1 \
	ROCKET_FS_KEEP=4 ROCKET_FS_F0="$v" \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > "$C" 2>&1; }
base() { env TEFLON_LIB=/usr/lib/libteflon.so ROCKET_FS_FLOATS=1 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null
	log ""
	log "  task_con16=$(cat /sys/module/rocket/parameters/task_con16 2>/dev/null)"

	log ""
	log "===== 1) BASELINE, untouched surface: must be 128/128 ====="
	base

	log ""
	log "===== 2) KEEP=4 with mesa's own word, must be 128/128 ====="
	sleep 2
	env TEFLON_LIB=/usr/lib/libteflon.so ROCKET_FS_FLOATS=1 ROCKET_FS_KEEP=4 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > "$C" 2>&1

	# 0 must fail, and 423.3 is the value already known to fail.
	one 0
	one -109.55
	one 109.55
	one -1.0
	one 1.0
	one -1000000.0
	one -0.000001
	one 0x43d3a666
	one 0xc2db199a

	log ""
	log "===== 12) CONTROL that can fail: baseline again ====="
	sleep 2
	base

	log ""
	log "===== Read 1 and 12 first. Then: does every NEGATIVE pass?        ====="
	log "===== If so it is the sign, not the weight, and the fix is one    ====="
	log "===== constant. -109.55 and 0xc2db199a are the same word, so they ====="
	log "===== must agree; if they do not, the parser is wrong.            ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
