# ---------------------------------------------------------------------------
# 2026-08-18 round 242. The rail again, now with the flag the driver gates it
# behind, and the one count round 241 did not reach.
#
# WHAT 241 SETTLED. Wiring domain-supply to the NPU domain and dropping
# regulator-always-on does nothing on its own:
#
#   vdd_npu_s0  state=enabled  num_users=0   at boot
#   vdd_npu_s0  state=enabled  num_users=0   after an inference
#
# rockchip_pd_regulator_enable returns before it looks at the property unless
# the domain carries need_regulator, and no RK3576 domain does, because the
# macro they are built from does not have the field. The rail was up because
# boot-on left it up and nothing claimed it. This image threads the field
# through DOMAIN_M_O_R_G_W and gives PD_NPU a spelling that sets it.
#
#   READING RULE for the rail. num_users of 1 or more after entry 1 means the
#   domain took it, which is the whole point. Still 0 means the flag is not
#   the only thing in the way and I stop guessing and go read genpd. Entry 4
#   is the one that matters after that: if the rail really follows the domain
#   it must go down when the NPU idles, and entry 5 must still compute after
#   it has been down. That is the power cycle the withdrawn SError sentence
#   was about, so it gets measured rather than asserted either way.
#
#   THE CONTROL is entry 1. Round 240 and 241 both got 128 of 128 with npu
#   min 128 max 255 across 128 distinct values. Anything else and the domain
#   flag did it, and the rest of the log does not count.
#
# WHAT 241 LEFT. 88 answered both ways, 88 of 88 under the parity form and
# 64 of 88 with a job timeout under the modulo form, losing exactly channels
# 64 to 87. 120 only answered the parity side, 120 of 120, because the 88
# timeout wedged the block and took the next entry with it. So 120 under the
# modulo form runs here, alone, at the end, after everything that matters.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
log() { echo "$@" > "$C"; }
w() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }

rail() {
	log ""
	log "  RAIL $1"
	for r in /sys/class/regulator/regulator.*; do
		[ -r "$r/name" ] || continue
		n=$(cat "$r/name" 2>/dev/null)
		case "$n" in vdd_npu*)
			log "    $n  state=$(cat $r/state 2>/dev/null)  num_users=$(cat $r/num_users 2>/dev/null)" ;;
		esac
	done
	mount -t debugfs none /sys/kernel/debug 2>/dev/null
	for g in /sys/kernel/debug/pm_genpd/*npu*; do
		[ -r "$g/current_state" ] && log "    genpd $(basename $g)  $(cat $g/current_state 2>/dev/null)"
	done
	log "    runtime_status $(cat /sys/devices/platform/*.npu/power/runtime_status 2>/dev/null | tr '\n' ' ')"
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null

	rail "at boot, before the NPU has been touched"

	log ""
	log "===== 1) THE CONTROL. 240 and 241 both got 128 of 128, npu min   ====="
	log "=====    128 max 255, 128 distinct.                              ====="
	w conv2d-cal.tflite ""

	rail "right after an inference, the NPU still powered"

	log ""
	log "===== 2) idle for 30s, long enough for the NPU to suspend        ====="
	sleep 30
	rail "after 30s idle"

	log ""
	log "===== 3) idle for another 60s                                    ====="
	sleep 60
	rail "after 90s idle"

	log ""
	log "===== 4) THE POWER CYCLE. If the rail went down above, this run  ====="
	log "=====    brings it back. It must compute, and it is the claim I  ====="
	log "=====    withdrew from the commit message either way.            ====="
	w conv2d-cal.tflite ""

	rail "after the second inference"

	log ""
	log "===== 5) 120 out, modulo form. The half 241 could not reach.     ====="
	log "=====    The parity form gave 120 of 120. If this degrades the   ====="
	log "=====    way 88 did, both counts agree on the rule. Runs last    ====="
	log "=====    because it may time out and wedge whatever follows.     ====="
	w pw64x120w56.tflite "ROCKET_DPU4050_MOD32=1"

	log ""
	log "===== Read entry 1 and the num_users line above it first.        ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
