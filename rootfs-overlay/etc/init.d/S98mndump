# ---------------------------------------------------------------------------
# 2026-08-20 round 281. It computed. Now without the override, and at K = 32.
#
# ⚠⚠ 280 RAN AN int4 MATMUL AND IT WAS EXACT. 64 of 64 words, every channel,
# against cpu_reference. First one on this stack.
#
#   entry 2   ch 0 moved off -6753 to -1887 and 64 of 64 EXACT
#   entry 3   CHARSIU_INT4_ORDER=1 gave 0 of 64, so the intra group order is
#             settled: byte j holds k = 2j low and k = 2j+1 high
#   entry 4   the no HALFK control gave 0 of 64, and its npu values were
#             IDENTICAL to entry 2's, which is the model confirming itself:
#             the hardware computed the same thing and only the reference moved
#   entry 6   int8 still 64 of 64
#
# BOTH SHIFT PLACEMENTS SCORED 64, AND THAT IS NOT A WEAK TEST. fp16 bits of an
# integer have a zero low byte, 0x3C00, 0x4000, 0x4700, and abits is (a-0x80)<<8
# which is also a multiple of 256, so every product is a multiple of 65536 and
# the shift loses nothing per element. The two readings are identically equal
# here, so the question does not arise for this packing rather than being
# undecided by a kind test.
#
# WHAT DID NOT WORK. K = 32 came back 16 of 64, and the reason is in the base
# table: it ran to 1656 while a K = 32 buffer is 1024, so channels 32 and up
# were written past the end. 277's own sweep has the K = 32 table and the two
# turn out to be one expression:
#
#   K=64  0 128 512 640 1024 1152 1536 1600
#   K=32  0 128 256 384  512  640  768  832
#
#   base[g] = (g/2) * 8K + (g odd ? (g == 7 ? 64 : 128) : 0)
#
# sixteen points, one expression. The last pair sits 64 bytes in rather than
# 128 in BOTH tables independently, so that is read and not fitted, and it is
# not a cap either: 3*512 + 128 + 56 is well inside 2048.
#
# ⚠ AND 0x3020 IS IN THE DRIVER NOW. Every int4 result of 280 needed an
# override on the command line. The DPU writes ceil((v+1)/2) + 8 channels, so
# v = 2*(n-8) - 1, which is 15, 47 and 111 at n of 16, 32 and 64. int8 keeps
# n-1. Nothing in this round passes CHARSIU_OVERRIDE at all.
#
# THE READING RULE, fixed before the run.
#
#   ⚠ ENTRY 2 IS THE ROUND. N = 64, K = 64, NO override. It has to reproduce
#   280's 64 of 64, or the emitted 0x3020 is not the value the layout was
#   measured at.
#
#   ENTRY 3 IS K = 32 AND IT IS THE NEW CLAIM. 16 of 64 last time, and the base
#   table is the only thing changed. 64 of 64 means the expression holds at both
#   K rather than the K = 64 table being memorised.
#
#   ENTRY 4 and 5 are N = 32 and N = 16, which the layout has never been run at.
#   The base table is indexed by n/8 and stops early at small N, and 0x3020 now
#   moves with N, so both could be wrong independently.
#
#     all four exact          the layout, the k parity, the order, the base
#                             expression and the channel register are all one
#                             consistent reading across four geometries
#     N = 64 exact, others not  the tables were memorised at 64 and the
#                             expression does not generalise
#     none exact              the driver's 0x3020 is not what the override was
#
#   ENTRY 6 is the control that must FAIL and ENTRY 7 is int8, unchanged.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
MM=/opt/charsiu/charsiu_matmul
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

c() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $*"; return 0; }
	before=$(nbad)
	sleep 1
	env $1 $2 $3 $4 $5 $6 $7 $8 $9 > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This arm is VOID."; health; }
	return 0
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	if [ -w /sys/module/rocket/parameters/reset_autosuspend ]; then
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend
		log "reset_autosuspend = $(cat /sys/module/rocket/parameters/reset_autosuspend)"
	else
		log "!! reset_autosuspend NOT WRITABLE. A timeout will kill the round."
	fi

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== 2) THE ROUND. K=64 N=64, NO override. Must be 64 of 64.      ====="
	log ""
	c "CHARSIU_W4=1 CHARSIU_W4_HALFK=1" X=1 $MM 1 64 64

	log ""
	log "===== 3) K = 32. Was 16 of 64. One base expression for both K.     ====="
	c "CHARSIU_W4=1 CHARSIU_W4_HALFK=1" X=1 $MM 1 32 64

	log ""
	log "===== 4) N = 32, never run with this layout                        ====="
	c "CHARSIU_W4=1 CHARSIU_W4_HALFK=1" X=1 $MM 1 64 32

	log ""
	log "===== 5) N = 16                                                    ====="
	c "CHARSIU_W4=1 CHARSIU_W4_HALFK=1" X=1 $MM 1 64 16

	log ""
	log "===== 6) the control that must FAIL. no HALFK.                     ====="
	c "CHARSIU_W4=1" X=1 $MM 1 64 64

	log ""
	log "===== 7) int8 dense, unchanged. Must be 64 of 64.                  ====="
	c X=1 X=1 $MM 1 64 64

	log ""
	log "===== the anchor again                                             ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== four geometries, no override, or the reading does not hold.  ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
