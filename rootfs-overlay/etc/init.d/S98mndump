# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-21 round 295. Three registers wake row 1 up. Only a matmul says which
# one wakes it up CORRECTLY.
#
# ⚠ 294 FOUND THEM, and the baseline pair reproduced first, which is what made
# the rest readable. Of eight arms, three light row 1 and five leave it dark:
#
#   0x1044 = 0x00010004   DATA_ENTRIES = surf*m instead of surf
#   0x103c = 0x00040000   surf*m << 16 instead of surf << 16
#   0x1078 = 0x00000000   charsiu emits rows-1 here, into a field mesa calls
#                         DATA_BURST_LEN, and 0 is the M = 1 value
#
# and all three light the RIGHT words: byte 8j lights w(4j'+...) for row 1's
# channel j and nothing else, so the address is right in every one of them.
#
# ⚠ THE VALUES ARE ALL DIFFERENT AND NONE IS RIGHT. Byte 0 low comes back 284,
# 7739 and 7739. The probe's ramp gives row 1 the same k = 0 activation as row 0,
# so the correct answer is row 0's own 71. Three arms make row 1 read SOMETHING;
# nothing yet says any of them makes it read its own data.
#
# ⚠ AND ONE THING I SAID LAST ROUND NEEDS TIGHTENING. "Row 1's activation is
# never read" is right; "row 1 is never computed" is not. In the row 0 only
# baseline, byte 0 lights w0 at 71 AND w4 at 1207, and w4 is row 1's channel 0
# with row 1's activation held at the zero point. Row 1's output is computed and
# nonzero. Both output rows are computed from ROW 0's activation slot.
#
# THE READING RULE, fixed before the run.
#
#   ⚠ A MATMUL, NOT A MAP. --map says a byte reaches a word; only
#   cpu_reference says the number is right. Three candidates, at M = 2 and then
#   at M = 4 where surf*m is 8 rather than 4.
#
#     one arm is exact               that register is the input row count and
#                                    M > 1 is done. Bake it in and re-run the
#                                    eleven geometries.
#     an arm is exact at M = 2 and not at M = 4
#                                    it is not the count, it is something that
#                                    happens to be right at one M
#     row 1 exact, row 0 broken      the register trades one row for the other,
#                                    which the map could not have shown
#     none exact                     all three only move data around, and the
#                                    next place is 0x1094 and 0x118c, which
#                                    carry rows and rows-1 and were dark in 294
#
#   ⚠ ENTRIES 2 AND 3 ARE M = 1, unmodified. Nothing in the packer changed this
#   round, so they must be exact, and the overrides below only apply to their
#   own arms.
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
MM=/opt/charsiu/charsiu_matmul
CH=/opt/charsiu/charsiu_int4
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

c() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $*"; return 0; }
	before=$(nbad)
	sleep 1
	env $1 $2 $3 $4 $5 $6 $7 $8 $9 > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This arm is VOID."; health; }
	return 0
}

M4="CHARSIU_W4=1 CHARSIU_W4_HALFK=1"

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	if [ -w /sys/module/rocket/parameters/reset_autosuspend ]; then
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend
		log "reset_autosuspend = $(cat /sys/module/rocket/parameters/reset_autosuspend)"
	else
		log "!! reset_autosuspend NOT WRITABLE. A timeout will kill the round."
	fi

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== 2) M = 1 N = 16 and N = 64, unmodified                       ====="
	c "$M4" X=1 $MM 1 64 16
	c "$M4" X=1 $MM 1 64 64

	log ""
	log "##### THE ROUND. M = 2, surf*m = 4. A matmul, not a map.           #####"
	for a in \
		"0x1044=0x00010004" \
		"0x103c=0x00040000" \
		"0x1078=0x00000000" \
		"0x1044=0x00010004,0x1078=0x00000000" \
		"0x103c=0x00040000,0x1078=0x00000000"
	do
		log ""
		log "===== M=2 N=16   $a"
		c "$M4 CHARSIU_W4_HALFK=1" "CHARSIU_OVERRIDE=$a" $MM 2 64 16
	done

	log ""
	log "##### and at M = 4, where surf*m is 8. Same three.                 #####"
	for a in \
		"0x1044=0x00010008" \
		"0x103c=0x00080000" \
		"0x1078=0x00000000"
	do
		log ""
		log "===== M=4 N=16   $a"
		c "$M4 CHARSIU_W4_HALFK=1" "CHARSIU_OVERRIDE=$a" $MM 4 64 16
	done

	log ""
	log "===== the two that were dark in 294, as matmuls anyway             ====="
	c "$M4" "CHARSIU_OVERRIDE=0x1094=0x00000001" $MM 2 64 16
	c "$M4" "CHARSIU_OVERRIDE=0x118c=0x00000000" $MM 2 64 16

	log ""
	log "===== the control that must FAIL, and int8 at M = 4                ====="
	c "CHARSIU_W4=1" X=1 $MM 1 64 64
	c X=1 X=1 $MM 4 64 64

	log ""
	log "===== the anchor again                                             ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== an arm at 32 of 32 is the answer. 16 of 32 is still row 0.   ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
