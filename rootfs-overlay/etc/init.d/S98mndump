#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-23 round 345. int4 IS A WEIGHTED SUM. WHICH REGISTER, AND WHAT LAYOUT.
#
# 🔑🔑🔑 ROUND 344 SETTLED IT. With the vendor's twenty register values in
# place, one nibble's contribution to the output is EXACTLY s times a constant,
# s being the nibble read as a signed int4, at three independent byte positions
# with three different constants:
#
#   byte 0 low    8744*s      v=1..7 -> 8744..61208, v=8..15 -> -69952..-8744
#   byte 0 high  10312*s
#   byte 1024    3532*s
#
# All fifteen rows exact at all three. **That is the pre declared criterion for
# a real int4 multiplier, and it means the 1.00 to 1.18 band was OUR
# configuration and never the silicon.**
#
# The output is float32, not the raw accumulator: the first eight words decode
# as +11.38 -5.16 -1.79 +3.14 -35.38 +56.29 -38.33 -36.35.
#
# And the four arms bracket each other properly:
#   MERGE (our stream, their values)                straight line, fp32
#   verbatim replay + the three 0x1d enables        output BYTE IDENTICAL to it
#   verbatim replay without them                    still timed out
#   plain control                                   all sixteen old values
# So the DPU_RDMA block is irrelevant, the missing enable was the whole reason
# round 343 timed out, and **the twenty registers are the entire story**.
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# TWO QUESTIONS, and the round is split between them.
#
# WHICH REGISTERS. CHARSIU_MERGE_UNITS narrows the merge to one range, host
# checked: "1" = CNA, eight values; "2" = the five inserted at 0x2810; "3" =
# CORE, three; "4" = DPU, four. Entries 2 to 5 run one group each at byte 0.
#   a group that alone gives 8744*s      -> that group is sufficient
#   a group that alone gives the old band -> that group is not it
#   several groups needed                 -> the sum of the ones that move it
# Entry 1 is the full merge and must reproduce 8744*s, or the groups mean
# nothing.
#
# WHAT LAYOUT. The slope IS the activation the nibble meets. So sweeping the
# BYTE instead of the value maps the weight layout directly: entry 6 walks the
# first 64 bytes, both halves, and prints slope and the output word it lands in.
# Two submits a byte. **A byte whose slope is 0 is not fetched at all**, which
# is the half width question asked in one line.
#
# Every arm keeps the tool's controls: repeat must be byte identical, restore
# must return the baseline, per row live counts, VOID on an all zero output.
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT
# ---------------------------------------------------------------------------
#
# DPU, on 0x40b8 going from our 0x20 to their 0x60 -- it is the output stage
# register, and the output changed from int32 to float32 at the same time. If a
# CNA value turns out to be needed as well I would not be surprised, because
# the fetch geometry differs too (surf 64 against their 2048).
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
VD=/opt/charsiu/charsiu_vendor
V=/opt/charsiu/vendor
RGC=$V/vendor-int4-k2048-n1024.regcmd
WT=$V/vendor-wt-1M.bin
IN=$V/vendor-in.bin
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block did not come back this time."
		ABORT=1
	fi
}

# arm: <label> <regcmd-or-dash> <byte> <high> [extra env, one assignment]
#
# ⚠ THE ENV GOES IN AS AN ARGUMENT, not as a "VAR=x arm ..." prefix. Whether an
# assignment before a FUNCTION call survives the call is unspecified -- dash
# drops it, other shells keep it -- and the arm whose whole job is to time out
# WITHOUT the trailer runs right after the one that has it. Not a question worth
# leaving to the shell.
arm() {
	before=$(nbad)
	log ""
	log "  ---- $1"
	sleep 1
	env ${5:-IGNORED=1} $VD "$2" "$WT" "$IN" "$3" "$4" 4096 > /tmp/vd.txt 2>&1
	cat /tmp/vd.txt > "$C"
	after=$(nbad)
	if [ "$after" != "$before" ]; then
		log "  !! POISONED: $((after - before)) new fault or timeout lines"
		health
		# ⚠ NOT a round abort. Round 342 threw away every arm after the
		# first poisoning and then measured the block healthy at the
		# end. The block recovers; give it a moment and carry on.
		ABORT=0
		sleep 2
	fi
}

start() {
	log ""
	log "###############################################################"
	log "##### round 345: which register, and what layout #####"
	log "###############################################################"
	log "  no fitted reference. one nibble changes, the output difference"
	log "  is that nibble. a straight line means int4 is real."

	log ""
	log "===== 1) the full merge. MUST give 8744*s, or nothing below   ====="
	log "  it means anything."
	arm "full merge, byte 0 low" "+$RGC" 0 0

	log ""
	log "===== 2) CNA only, eight values                               ====="
	arm "merge units=1 (CNA)" "+$RGC" 0 0 CHARSIU_MERGE_UNITS=1

	log ""
	log "===== 3) the five inserted at 0x2810                          ====="
	arm "merge units=2 (0x2810 block)" "+$RGC" 0 0 CHARSIU_MERGE_UNITS=2

	log ""
	log "===== 4) CORE only, three values                              ====="
	arm "merge units=3 (CORE)" "+$RGC" 0 0 CHARSIU_MERGE_UNITS=3

	log ""
	log "===== 5) DPU only, four values. my guess is that this is it.  ====="
	arm "merge units=4 (DPU)" "+$RGC" 0 0 CHARSIU_MERGE_UNITS=4

	log ""
	log "===== 6) THE LAYOUT: slope per byte, first 64, both halves    ====="
	log "  the slope is the activation that nibble meets. slope 0 means"
	log "  the byte is not fetched at all."
	arm "slope map, 64 bytes" "+$RGC" 0 0 CHARSIU_SLOPE_MAP=64

	log ""
	log "===== 7) CONTROL: charsiu's own stream. the old sixteen.      ====="
	arm "control arm, this tree's stream" "-" 0 0

	log ""
	log "===== 8) the anchor: int8 conv must still be exact           ====="
	health

	log ""
	log "===== read the CONTROL lines first. VOID means the arm died. ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
