#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-11 round 58. Are A and the MAC in the same units for depthwise?
#
# Round 57 swept the OUT_CVT shift from -3 to +3 on the honest metric:
#
#   mn_dw1    COMPUTED  1 1 1 1 0 0 0        never moves
#   mn_dw25   COMPUTED  2 2 0
#   conv2d-cal at +1     128 of 128 -> 0     so the knob does reach the HW
#
# A global scale is not what is left. But a global OUTPUT shift cannot fix a
# mismatch between the two things added before it: A is added to the MAC, and
# if the depthwise accumulator sits at a different power of two from the
# regular one, then shifting the sum moves both together and nothing improves.
# That is exactly the shape of round 57's flat sweep.
#
# The signature was already visible offline. Sorting mn_dw1's channels by |A|
# puts every saturated channel at one end: the channels whose output is pinned
# are the ones with the largest |A|, which is what an A too large for its MAC
# looks like. rkt_fill_biases has carried the same idea for regular convs since
# the beginning as ROCKET_BIAS_SCALE80, defaulting off because it measured
# wrong there. It has never been tried on depthwise, because until this week
# the depthwise record was the wrong shape anyway.
#
# ⚠ Round 57's tests 11 and 12 are VOID. They swept ROCKET_C_VALUE on a
# depthwise model and came back identical to the default at 4 and at 64, which
# reads as C being inert. It is not evidence: that variable is only read by the
# regular branch, so the sweep never changed a byte. The same failure as round
# 50. ROCKET_DW_C_VALUE is the depthwise one and is swept properly below.
#
# DECISION RULE, written before the run:
#   one ASHIFT makes COMPUTED jump      A and the MAC are in different units,
#                                       and the exponent names the factor
#   COMPUTED flat across ASHIFT and     A is not the remaining bug either, and
#     across DW_C_VALUE                 what is left is the MAC's operands, so
#                                       the next round goes at the CNA feeding
#                                       the CMAC rather than the coefficients
#   conv2d-cal moves at all             the depthwise knobs are leaking into
#                                       the regular path and the round is void
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
p() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== 1..8) mn_dw1, A scaled on its own ====="
	p mn_dw1.tflite ROCKET_DW_ASHIFT=-7
	p mn_dw1.tflite ROCKET_DW_ASHIFT=-4
	p mn_dw1.tflite ROCKET_DW_ASHIFT=-2
	p mn_dw1.tflite ROCKET_DW_ASHIFT=-1
	p mn_dw1.tflite ""
	p mn_dw1.tflite ROCKET_DW_ASHIFT=1
	p mn_dw1.tflite ROCKET_DW_ASHIFT=4
	p mn_dw1.tflite ROCKET_DW_ASHIFT=7

	log ""
	log "===== 9..11) mn_dw25, the same at the ends ====="
	p mn_dw25.tflite ROCKET_DW_ASHIFT=-7
	p mn_dw25.tflite ""
	p mn_dw25.tflite ROCKET_DW_ASHIFT=7

	log ""
	log "===== 12..14) C on the depthwise path, properly this time ====="
	p mn_dw1.tflite ROCKET_DW_C_VALUE=4
	p mn_dw1.tflite ROCKET_DW_C_VALUE=64
	p mn_dw1.tflite ROCKET_DW_C_VALUE=256

	log ""
	log "===== 15..16) REGULAR shapes, which the depthwise knobs must not touch ====="
	p conv2d-cal.tflite ROCKET_DW_ASHIFT=7
	p cal_k3.tflite ""

	log ""
	log "===== Read COMPUTED. Test 15 must be 128 of 128: a depthwise knob  ====="
	log "===== that moves a regular conv means the gating is wrong.         ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
