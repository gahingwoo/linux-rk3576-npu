# ---------------------------------------------------------------------------
# 2026-08-11 round 62. The overlap rows were being staged twice.
#
# Round 61 moved the seam and it followed:
#
#   ROWWIN  tasks  first bad row
#     91      2       ~90        the default
#     64      2       ~64
#     46      3       ~48
#    113      1        0         one window, and the WHOLE surface is wrong
#
# So the bug is per window, not at row 90, and a single oversized window is not
# a fix: 91 input rows is a real CBUF limit and 112 rows overruns it. The
# windowing is forced, not chosen.
#
# The vendor's capture of this exact layer then names the bug. Its second
# window writes TWO different row counts where mesa writes one:
#
#   0x102c  22 -> 23 rows   the rows the window SPANS       mesa 23, correct
#   0x1028  0x498/56 = 21   the rows the window STAGES      mesa 23, wrong
#   0x1078  20 -> 21        the same                        mesa 23, wrong
#   0x1098  2352/112 = 21   the same                        mesa 23, wrong
#
# A window overlaps the one before it by one row each side, and those rows are
# already in the CBUF: the reuse base at 0x103c is 56 x 89, pointing straight
# back at them, and mesa already computes that correctly. Staging them again
# writes them a second time at the next free CBUF row, so every row after the
# overlap sits two rows late and the window convolves shifted input. Round 60's
# reading fits exactly: right value range, perfect correlation on an interior
# crop of window 0, garbage in window 1.
#
# So rkt_split_tasks now stages from the first row that is NOT already there,
# and the three staging registers carry that count while 0x102c keeps the span.
#
# ROCKET_STAGE_ALL=1 restores the old behaviour and is the control: it has to
# reproduce the broken second window exactly, or this round is not measuring
# what it claims.
#
# DECISION RULE, written before the run:
#   dw_imp COMPUTED 32/32          the depthwise conv is SOLVED
#   the row profile goes flat but  the shift is fixed and something smaller is
#     COMPUTED stays low           left, read the new profile
#   unchanged                      the double staging is not the mechanism and
#                                  the eighteen per-window registers get read
#                                  one at a time
#   STAGE_ALL does not reproduce   the control failed, the round is void
#     the old profile
#   regular shapes regress         the change leaked outside the windowed path
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
p() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== 1..2) dw_imp: the fix, then the control that must break ====="
	p dw_imp.tflite ""
	p dw_imp.tflite ROCKET_STAGE_ALL=1

	log ""
	log "===== 3..4) mn_dw1: the fix, then the control ====="
	p mn_dw1.tflite ""
	p mn_dw1.tflite ROCKET_STAGE_ALL=1

	log ""
	log "===== 5..6) move the seam again: the fix must hold anywhere ====="
	p dw_imp.tflite ROCKET_ROWWIN=46
	p dw_imp.tflite ROCKET_ROWWIN=64

	log ""
	log "===== 7) mn_dw25 is 7x7, one window, so it must not move ====="
	p mn_dw25.tflite ""

	log ""
	log "===== 8..9) REGULAR shapes, which never take the windowed path ====="
	p conv2d-cal.tflite ""
	p cal_k3.tflite ""

	log ""
	log "===== 10) whole model, for the record ====="
	sleep 2
	env TEFLON_LIB=/usr/lib/libteflon.so \
		python3 "$NPU_DIR/test_model.py" "$NPU_DIR/conv2d-cal.tflite" 2 > "$C" 2>&1

	log ""
	log "===== Read test 2 first: the control must reproduce the broken   ====="
	log "===== second window, or test 1 is not a comparison.              ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
