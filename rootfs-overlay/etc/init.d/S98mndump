# ---------------------------------------------------------------------------
# 2026-08-09 round 43. Round 42 was never worth flashing. Registers are ruled
# out for depthwise, offline. Ask what the hardware is actually producing.
#
# ⚠ ROUND 42's HYPOTHESIS IS DEAD AND WAS KILLED WITHOUT THE BOARD. It came
# from diffing vendor g_dw1 against g_k3s1, which differ in channels and spatial
# size as well as in being depthwise, so 41 registers differed and there was no
# way to tell which were about depthwise. Compiling a proper pair, ic = oc = 32,
# 112x112, k=3, s=1, same calibration, moving ONLY `groups`, leaves 15:
#
#   0x100c 0x101c 0x1024 0x1030 0x3018 0x400c 0x4030 0x4038 0x4044
#   0x4050 0x40b0 0x40b4 0x40b8 0x501c 0x5044
#
# 0x1018 and 0x1040 are NOT in that list. They differed on geometry alone.
#
# And every one of those 15 that is a MODE bit already matches mesa:
#   0x100c  dw ? 1 : 0                     matches
#   0x101c  dw ? oc*k*k*2 : ic*oc*k*k      0x240 / 0x2400, matches
#   0x1024  dw ? 1 : oc-1                  matches
#   0x1030  wbpk = dw ? k*k*ic/8 : ...     0x24 / 0x240, matches
#   0x3018 0x400c 0x4030 0x4038 0x4044 0x4050 0x501c 0x5044   all match
#   0x40b0 0x40b4 0x40b8   OUT_CVT, and the pair necessarily has different
#                          weights, so these must differ
#
# So the registers are not the depthwise bug, exactly as the coefficient region
# turned out not to be. Two hypotheses closed offline in one sitting.
#
# What has never been asked is what the depthwise output actually LOOKS like. A
# maxdiff cannot tell "the MAC never fired" from "the MAC fired on the wrong
# operands", and those need completely different next steps. perch.py now
# reports the distinct count and how many channels are pinned at the output zero
# point.
#
# DECISION RULE, written before the run:
#   dwconv pinned at out_zp everywhere   an EMPTY convolution: the MAC never
#                                        fires, so look at the weight DMA and
#                                        the CBUF, not at arithmetic
#   dwconv varying but wrong             the MAC fires on wrong operands, so
#                                        look at the weight LAYOUT
#   some channels empty, some varying    it is per channel, and the split says
#                                        which
#   mn_dw1's 3 correct channels are
#     the non-empty ones                 the layout is right for a few channels
#                                        and wrong for the rest, which names it
#   step 1 or 9 not 128/128              the build is wrong, stop
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
p() { log ""; log "  -- $1"; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== 1) BASELINE: a conv that works, for the new fields ====="
	log "  128/128, and it should report 0 constant channels"
	p conv2d-cal.tflite

	log ""
	log "===== 2..3) DEPTHWISE: empty, or wrong? ====="
	p dwconv.tflite
	p mn_dw1.tflite

	log ""
	log "===== 4) the first conv, which also fails ====="
	p mn_conv0.tflite

	log ""
	log "===== 5..6) CHAINED ====="
	p conv2x.tflite
	p mn_conv0dw1.tflite

	log ""
	log "===== 7) the partial one, 297 of 1024 ====="
	p mn_pw24.tflite

	log ""
	log "===== 8) a pointwise that works, for contrast ====="
	p mn_pw2.tflite

	log ""
	log "===== 9) CONTROL that can fail: conv2d-cal again ====="
	p conv2d-cal.tflite

	log ""
	log "===== Read 1 and 9 first. Then 2: 'EMPTY conv' means the MAC never  ====="
	log "===== fired and the next step is the weight DMA, not arithmetic.    ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
