# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-24 round 372. THE TWO SWITCHES BECOME THE DEFAULT, AND A LONG CONTEXT.
#
# ⛔ ROUND 371 KILLED THE CPU AS A SECOND ENGINE, and the trap the round wrote
# down is the one that fired.
#
#   f = 0     12.33 tok/s   80.8 ms   fence 3778 ms   CPU share 0
#   f = 0.10   7.20        138.7      fence  177      CPU share  8449
#   f = 0.20   3.98        251.1      fence  186      CPU share 16388
#   f = 0.30   2.76        362.4      fence  196      CPU share 24211
#
# The fence collapsed because the hardware finishes long before the CPU does,
# so prep_bo returns at once and the CPU is the whole critical path.
#
# 🔑 AND THE FAILURE IS COMPUTE, NOT BANDWIDTH:
#
#   f=0.10  0.94 G weights/s      f=0.20  0.97      f=0.30  0.98
#   the NPU, for comparison:     21.0 G weights/s
#
# Dead flat with f, which is what a compute bound loop looks like. The CPU
# never came near the 5.62 GB/s round 370 measured it READING at; it managed
# 0.47. Four widening steps a weight, int4 to int8 to int16 to int32 to float,
# on a core with no fp16 arithmetic to shorten them. Best possible split even
# perfectly tuned is f = 0.043 and 3.2%.
#
# **So round 371 says nothing about whether the spare bandwidth can be spent.
# It says the CPU is not what spends it.** The bar for anything else is now a
# number: about 10 G weights a second, which is 5 GB/s of int4.
#
# ✅ All four sentences were identical, at f = 0.30 with three tenths of every
# projection computed by a different engine in a different order. The kernel is
# right; it is just slow.
#
# ---------------------------------------------------------------------------
# WHAT CHANGED
# ---------------------------------------------------------------------------
#
# THE TWO FAST PATHS ARE THE DEFAULT NOW. Both reorder arithmetic by a last
# bit, both moved a token on the HOST, and neither moved one on the BOARD --
# the exponential in round 368, the dot product in round 370, each measured
# against its own unvectorised arm and each writing the same sentence word for
# word. Together they are 5.1 ms a token, 12.30 to 13.13 tok/s.
#
# ⚠ Two rounds agreeing is not proof that no prompt ever diverges, and neither
# round claimed it was. What it is, is enough to stop paying 5 ms for a switch
# nobody turns on. CHARSIU_EXACT_ATTN and CHARSIU_EXACT_SILU put each back, and
# CHARSIU_CPU_PLAIN puts back both.
#
# ⚠ AND THE SCALAR BUILD NO LONGER MATCHES THE DEFAULT ONE. Neither reordering
# has a scalar twin, so the invariant is rewritten rather than quietly dropped:
# charsiu_run_scalar now equals charsiu_run with both EXACT switches, which is
# checked on the host and is still a detector for every vector path that IS
# meant to be bit identical.
#
# ---------------------------------------------------------------------------
# AND THE ONE THING NOBODY HAS MEASURED: A LONG CONTEXT
# ---------------------------------------------------------------------------
#
# Every decode round since 352 has generated 64 tokens from a six token prompt,
# so attention has never been asked about beyond about 70 positions. It is the
# ONE cost in the token that grows with the conversation: at 70 positions it is
# 4.53 ms of 75.8, and it should scale with the position while everything else
# stays flat. Arm 3 generates 384 tokens to find out where that goes.
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# THE SENTENCE. Arms 1 and 2 must both be the Louvre sentence and must match
# each other -- that is the whole claim being locked in, that the board does
# not see the difference the host sees. **If arm 1 differs from arm 2, the flip
# was wrong and the switches go back to opt-in.**
#
# THEN tok/s: arm 1 should reproduce round 370's 13.13 and arm 2 its 12.30.
#
# ⚠ THEN ARM 3, AND READ ITS STAGE TABLE, NOT ITS tok/s. A 384 token run
# averages over positions 6 to 390, so its tok/s is an average of a rising
# cost and cannot be compared with a 64 token run. The row that matters is
# attention, against arm 1's 4.53 ms. Everything else in the table should be
# unchanged, and if it is not, the extra is not attention's.
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT
# ---------------------------------------------------------------------------
#
# Arms 1 and 2 to reproduce 13.13 and 12.30 with one sentence between them.
# Attention is a dot product and an accumulation per position, so at an average
# position of about 200 against about 40 it should be roughly five times 4.53,
# call it 20 to 25 ms, which would make it the second largest cost in the token
# after the fence. If it comes back near 4.53 then it is not scaling with the
# position and I have the shape of it wrong.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
VD=/opt/charsiu/charsiu_vendor
V=/opt/charsiu/vendor
RGC=$V/vendor-int4-k2048-n1024.regcmd
WT=$V/vendor-wt-1M.bin
IN=$V/vendor-in.bin
RUN=/opt/charsiu/charsiu_run
M8=/opt/charsiu/models/Llama-3.2-1B-Instruct-Q8_0.gguf
PROMPT="The capital of France is"
LIMIT=420
# 32 tokens does not reach the answer to "17 times 24, show your working"
NGEN=64
CE=CHARSIU_COEF_ELEMS=65536
HEAD=CHARSIU_NPU_MAXN=131072
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block did not come back this time."
		ABORT=1
	fi
}

capped() {
	lim="$1"; shift
	"$@" &
	pid=$!
	i=0
	while [ "$i" -lt "$lim" ]; do
		kill -0 "$pid" 2>/dev/null || { wait "$pid"; return $?; }
		sleep 1
		i=$((i + 1))
	done
	kill -9 "$pid" 2>/dev/null
	wait "$pid" 2>/dev/null
	return 124
}
rung() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $1"; return 0; }
	lbl="$1"; shift
	before=$(nbad)
	log ""
	log "  -- $lbl"
	sleep 1
	capped "$LIMIT" env "$@" "$RUN" "$M8" -p "$PROMPT" -n "${NGEN:-32}" \
		--ignore-eos -q -c 512 -t 4 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the rung exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This rung is VOID."; health; }
	return 0
}
# arm: <label> <regcmd-or-dash> <byte> <high> [extra env, one assignment]
#
# ⚠ THE ENV GOES IN AS AN ARGUMENT, not as a "VAR=x arm ..." prefix. Whether an
# assignment before a FUNCTION call survives the call is unspecified -- dash
# drops it, other shells keep it -- and the arm whose whole job is to time out
# WITHOUT the trailer runs right after the one that has it. Not a question worth
# leaving to the shell.
arm() {
	before=$(nbad)
	log ""
	log "  ---- $1"
	sleep 1
	env ${5:-IGNORED=1} $VD "$2" "$WT" "$IN" "$3" "$4" 4096 > /tmp/vd.txt 2>&1
	cat /tmp/vd.txt > "$C"
	after=$(nbad)
	if [ "$after" != "$before" ]; then
		log "  !! POISONED: $((after - before)) new fault or timeout lines"
		health
		# ⚠ NOT a round abort. Round 342 threw away every arm after the
		# first poisoning and then measured the block healthy at the
		# end. The block recovers; give it a moment and carry on.
		ABORT=0
		sleep 2
	fi
}

# two concurrent probes, so the pair can be repeated without copy and paste
pair() {
	before=$(nbad)
	log ""
	log "  ---- $1"
	env CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_TIME=60 CHARSIU_OUT_KB=64 $2 $VD - "$WT" "$IN" 0 0 4096 > /tmp/vdA.txt 2>&1 &
	pidA=$!
	env CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_TIME=60 CHARSIU_OUT_KB=64 $3 $VD - "$WT" "$IN" 0 0 4096 > /tmp/vdB.txt 2>&1 &
	pidB=$!
	wait "$pidA"
	wait "$pidB"
	log "    A:"
	grep -E "M = |TIME:|baseline:|VERIFY:|CONTROL repeat|VOID|REREAD" /tmp/vdA.txt > "$C"
	log "    B:"
	grep -E "M = |TIME:|baseline:|VERIFY:|CONTROL repeat|VOID|REREAD" /tmp/vdB.txt > "$C"
	after=$(nbad)
	[ "$after" != "$before" ] && log "  !! POISONED: $((after - before)) new lines"
	return 0
}

BW=/opt/charsiu/charsiu_membw
DEC="CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 CHARSIU_NPU_W4V=1 CHARSIU_NPU_KMAX=1024 CHARSIU_NPU_W4_GROUP=1024"

# decode and a memory reader at the same time, both numbers kept
squeeze() {
	log ""
	log "  ---- $1"
	sleep 1
	env $DEC "$CE" "$HEAD" "$RUN" "$M8" -p "$PROMPT" -n 128 --ignore-eos \
		-q -c 512 -t 4 > /tmp/dec.txt 2>&1 &
	dpid=$!
	# past staging and into generation before the reader starts
	sleep "$2"
	if [ -n "$3" ]; then
		env CHARSIU_THREADS=4 CHARSIU_SECONDS="$3" $BW > /tmp/bw.txt 2>&1
	fi
	wait "$dpid"
	grep -E "tensors staged|gen 128|GB/s of weights|of that," /tmp/dec.txt > "$C"
	[ -n "$3" ] && cat /tmp/bw.txt > "$C"
	return 0
}

start() {
	log ""
	log "###############################################################"
	log "##### round 372: the switches become the default            #####"
	log "###############################################################"
	log "  and the first look at what a long context costs."

	B="CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 CHARSIU_NPU_W4V=1 CHARSIU_NPU_KMAX=1024 CHARSIU_NPU_W4_GROUP=1024 CHARSIU_STAGES=1"

	log ""
	log "===== 1) the new default. both fast paths on.                  ====="
	log "  must be the Louvre sentence and about 13.13 tok/s."
	rung "int4 g1024, default" $B "$CE" "$HEAD"

	log ""
	log "===== 2) THE CONTROL: both put back to the exact arithmetic    ====="
	log "  must be the SAME sentence as arm 1, and about 12.30."
	log "  a different sentence here means the flip was wrong."
	rung "int4 g1024, EXACT_ATTN + EXACT_SILU" $B CHARSIU_EXACT_ATTN=1 CHARSIU_EXACT_SILU=1 "$CE" "$HEAD"

	log ""
	log "===== 3) 384 tokens. READ THE STAGE TABLE, NOT THE tok/s.      ====="
	log "  the rate averages over a rising cost. the row that"
	log "  matters is attention, against arm 1's 4.53 ms."
	# ⚠ A PLAIN ASSIGNMENT, not a "NGEN=384 rung ..." prefix. Whether an
	# assignment before a FUNCTION call survives it is unspecified and dash
	# drops it -- the same trap the arm() helper below already carries a
	# note about, and this script nearly walked into it again.
	NGEN=384
	rung "int4 g1024, 384 tokens" $B "$CE" "$HEAD"
	NGEN=64

	log ""
	log "===== 4) the probe, still exact                                ====="
	arm "solo verify" "-" 0 0 "CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_VERIFY=1 CHARSIU_OUT_KB=64"

	log ""
	log "===== 5) the anchor: int8 conv must still be exact            ====="
	health

	log ""
	log "===== read the CONTROL lines first. VOID means the arm died. ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
