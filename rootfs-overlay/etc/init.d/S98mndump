#!/bin/sh
# ---------------------------------------------------------------------------
# 2026-08-07, after the TASK_CON fix. Is the depthwise datapath broken, or was
# the probe in the wrong quantization regime?
#
# dwconv.tflite was built in June to isolate the depthwise, and its own comment
# says it uses "conv2d-cal's PROVEN regime", uint8 per-tensor. Reading the
# flatbuffer says otherwise: it is THREE ops (QUANTIZE, DEPTHWISE_CONV_2D,
# QUANTIZE) and the depthwise runs on int8 tensors with PER-AXIS weights and
# bias. conv2x.tflite is the same, and its two ops are plain convs, not
# depthwise. mobilenet_v1_1.0_224_quant.tflite, the model we actually want, is
# uint8 per-tensor everywhere with not one per-axis tensor.
#
# So both small failing models test a regime nothing has verified, and mesa
# handles per-axis weights by an approximation it documents in its own comment.
# The mn_* models here are single layers cut straight out of MobileNet with
# slice_tflite.py: real weights, real scales, uint8 per-tensor, no converter in
# the loop. mn_dw1 is what dwconv.tflite was supposed to be.
#
# job_log=1 matters: a delegate that REFUSES an op runs it on the CPU and the
# result comes back correct while the NPU did nothing. jobs=0 in a run line
# means the answer below is about tflite, not about this driver.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
run() {
	env TEFLON_LIB=/usr/lib/libteflon.so \
		python3 "$NPU_DIR/test_model.py" "$NPU_DIR/$1" "${2:-3}" > "$C" 2>&1
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	# -n 8 floods the serial console and wedges the box. Learned the hard way.
	dmesg -n 4 2>/dev/null

	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/job_log 2>/dev/null
	log ""
	log "  task_con16=$(cat /sys/module/rocket/parameters/task_con16 2>/dev/null)" \
	    "job_log=$(cat /sys/module/rocket/parameters/job_log 2>/dev/null)"

	log ""
	log "===== 1) CONTROL: conv2d-cal, the model that is known correct ====="
	log "  (anything below is meaningless unless this is 3/3)"
	run conv2d-cal.tflite 3

	log ""
	log "===== 2) CONTROL: mn_pw2, MobileNet 1x1 pointwise 32->64, uint8 ====="
	log "  (a second regular conv, real MobileNet scales, different shape)"
	sleep 2
	run mn_pw2.tflite 3

	log ""
	log "===== 3) CONTROL: mn_conv0, MobileNet first conv 3x3 s2, 3 channels ====="
	sleep 2
	run mn_conv0.tflite 3

	log ""
	log "===== 4) TEST: mn_dw1, MobileNet depthwise, uint8 PER-TENSOR ====="
	log "  (what dwconv.tflite was meant to be. Correct here means the"
	log "   depthwise datapath is fine and the June result was the regime.)"
	sleep 2
	run mn_dw1.tflite 3

	log ""
	log "===== 5) TEST: mn_conv0dw1, two chained ops, both uint8 per-tensor ====="
	log "  (chaining without the per-axis confound conv2x.tflite carries)"
	sleep 2
	run mn_conv0dw1.tflite 3

	log ""
	log "===== 6) CONTINUITY: dwconv.tflite, the int8 PER-AXIS model ====="
	log "  (expected still wrong. If 4 passes and this fails, the regime is"
	log "   the dividing line, not the depthwise.)"
	sleep 2
	run dwconv.tflite 3

	# Where do the written bytes land? Under the wall the depthwise wrote ONE
	# 256 byte run at offset 0 out of 51200 and stopped. Same question in the
	# per-tensor regime, with the input BO as where.py's own passing control.
	log ""
	log "===== 7) SHAPE: which bytes of mn_dw1's output actually get written ====="
	sleep 2
	rm -rf /tmp/dump; mkdir -p /tmp/dump; cd /tmp/dump || return 0
	env TEFLON_LIB=/usr/lib/libteflon.so ROCKET_DEBUG=dump_bos \
		python3 "$NPU_DIR/test_dw.py" "$NPU_DIR/mn_dw1.tflite" > "$C" 2>&1
	log "  files: $(ls /tmp/dump 2>/dev/null | tr '\n' ' ')"
	for f in /tmp/dump/mesa-input-*.bin /tmp/dump/mesa-output-*.bin; do
		[ -f "$f" ] && python3 "$NPU_DIR/where.py" "$f" > "$C" 2>&1
	done

	log ""
	log "===== read 1 first. Then: does 4 pass? If yes the depthwise works  ====="
	log "===== and the open bug is per-axis requant. If no, and 2 and 3     ====="
	log "===== pass, the depthwise datapath is broken for real.             ====="
	sync
}

case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
