# ---------------------------------------------------------------------------
# 2026-08-21 round 290. M > 1 is int4 only, and the output surface has never
# been measured.
#
# 289 SEPARATED THE TWO THINGS IT WAS BUILT TO SEPARATE.
#
#   M = 1 at N of 16, 64 and 88   all exact. No reader regression.
#   int8 at M = 4                 256 of 256 BYTE EXACT
#
# So M > 1 works on the int8 path, which shares the job setup, the register
# stream's row fields and the surface reading. The failure is int4 only:
#
#   M = 2  N = 64    28 of 128    row 0: g0..g6 4/8, g7 0/8
#   M = 4  N = 64    16 of 256    row 0: g0 4/8, g1 0/8, g2 4/8, g3 0/8, ...
#   M = 8  N = 64    16 of 512    row 0: the same alternation
#
# In every one of them EVERY correct value is in row 0. Rows 1 and up are wrong
# outright.
#
# ⚠ ONE CAUSE IS IDENTIFIED AND IT IS THE READER. The surface is
# [n/atom][m][n%atom] and this reader hardcoded atom 16, which is int8's feature
# atom. w4a16 packs its activation as a 2 byte element whose atom is 8. At M = 1
# both collapse to n, which is why eleven geometries passed without it ever
# mattering. At M = 4 the two readings disagree on exactly the odd numbered
# groups, and the odd numbered groups are exactly what came back 0 of 8.
#
# ⚠ AND IT IS NOT THE WHOLE STORY, WHICH IS WHY THIS ROUND DUMPS RATHER THAN
# GUESSES. The even groups came back 4 of 8 where both readings agree, and M = 2
# gave every group 4 of 8 with only g7 at zero, a different shape again. Two
# closed forms for the weight layout were guessed and refuted before --map was
# pointed at it. The same mistake is available here, so the matmul now prints the
# raw surface and both rows' references at M > 1 and the mapping gets read.
#
# 289 ALSO FOUND THE PARTIAL GROUP. An N that is not a multiple of 8 has never
# been run, and both are close but not exact at M = 1, where the reader is not in
# question:
#
#   N = 20  16 of 20   g0 8/8  g1 4/8  g2 4/4
#   N = 36  32 of 36   g0 8/8  g1 8/8  g2 4/8  g3 8/8  g4 4/4
#
# The last group is short and correct; a FULL group in the middle loses four
# each time. That is a placement question and --map answers it.
#
# THE READING RULE, fixed before the run.
#
#   ⚠ ENTRIES 2 TO 4 FIRST, M = 1 again, because the reader changed again.
#
#   ENTRY 5 IS THE ROUND. M = 2 at N = 64, with the raw surface printed.
#
#     exact                      the atom was the whole story after all
#     row 0 exact, rows 1+ not    the surface's M term is not m*atom, and the
#                                 dump says what it is: find where row 1's
#                                 reference values actually landed
#     row 0 still 4 of 8          the atom was not even the row 0 story and the
#                                 int4 output surface is not this shape at all
#
#   ENTRIES 8 AND 9 sweep --map at N = 20 and N = 36, which is the instrument
#   that settled the layout, pointed at the partial group case.
#
#   ENTRY 10 is the control that must FAIL and ENTRY 11 is int8 at M = 4, which
#   was exact and must stay so.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
MM=/opt/charsiu/charsiu_matmul
CH=/opt/charsiu/charsiu_int4
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

c() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $*"; return 0; }
	before=$(nbad)
	sleep 1
	env $1 $2 $3 $4 $5 $6 $7 $8 $9 > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This arm is VOID."; health; }
	return 0
}

M4="CHARSIU_W4=1 CHARSIU_W4_HALFK=1"

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	if [ -w /sys/module/rocket/parameters/reset_autosuspend ]; then
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend
		log "reset_autosuspend = $(cat /sys/module/rocket/parameters/reset_autosuspend)"
	else
		log "!! reset_autosuspend NOT WRITABLE. A timeout will kill the round."
	fi

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "##### M = 1 again. The reader changed again.                       #####"
	for nn in 16 64 88
	do
		log ""
		log "===== M = 1  N = $nn"
		c "$M4" X=1 $MM 1 64 $nn
	done

	log ""
	log "##### THE ROUND. M > 1, with the raw surface printed.              #####"
	log ""
	log "===== 5) M = 2  N = 64                                             ====="
	c "$M4" X=1 $MM 2 64 64
	log ""
	log "===== 6) M = 4  N = 64                                             ====="
	c "$M4" X=1 $MM 4 64 64
	log ""
	log "===== 7) M = 2  N = 16, a small one so the dump is the whole thing ====="
	c "$M4" X=1 $MM 2 64 16

	log ""
	log "##### the partial group. --map is what settled the layout.         #####"
	log ""
	log "===== 8) --map at N = 20                                           ====="
	c X=1 X=1 $CH 1 64 20 --map 8
	log ""
	log "===== 9) --map at N = 36                                           ====="
	c X=1 X=1 $CH 1 64 36 --map 8

	log ""
	log "===== 10) the control that must FAIL, and int8 at M = 1 and M = 4  ====="
	c "CHARSIU_W4=1" X=1 $MM 1 64 64
	c X=1 X=1 $MM 1 64 64
	c X=1 X=1 $MM 4 64 64

	log ""
	log "===== the anchor again                                             ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== read the raw surface at entry 7 first. It is only 32 words.  ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
