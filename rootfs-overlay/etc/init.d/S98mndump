#!/bin/sh
# ---------------------------------------------------------------------------
# 2026-08-08 round 6. Round 5 settled two things and left one.
#
#   md003_80, a 1x1 conv at 80x80 with ONE row window, failed with byte
#   identical numbers to md003 at 160x160 which splits into two. So the row
#   window split is NOT the discriminator, and the KERNEL is.
#
#   mn_pw24 with and without ROCKET_CBUF_DERIVE=1 gave identical output, and
#   cal_s1 kept computing with the knob on. 0x1018 and 0x1040 are not load
#   bearing. That was the stated expectation, and it held.
#
# The loose end is that md003_80 and cal_s1 differ in output channels too, 16
# against 128, which has never been tested on its own. mutate_oc.py truncates or
# repeats the filters, which per-tensor quantization makes safe:
#
#   cal_oc16     conv2d-cal cut to 16 output channels, still 5x5
#   md003_oc128  md003_80 grown to 128 output channels, still 1x1
#
# cal_oc16 computing and md003_oc128 failing pins it on the kernel.
#
# ⚠ And the register set is probably NOT where the 1x1 bug is. The vendor .rknn
# for this exact geometry (1x1, 16 in, 16 out, 80x80) differs from the 5x5 one
# only in fields mesa already computes: the kernel word and output channels in
# 0x1024, the weight bytes per kernel in 0x1030, and the padding in 0x1080. So
# step 5 dumps the whole regcmd mesa emits for md003_80, to diff against the
# vendor's on the host. If those match, the bug is in the weight or coefficient
# buffer, not in a register.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }

run() {
	m="$1"; n="$2"; mark="$3"; shift 3
	echo "SMARK-$mark" > /dev/kmsg 2>/dev/null
	env TEFLON_LIB=/usr/lib/libteflon.so "$@" \
		python3 "$NPU_DIR/test_model.py" "$NPU_DIR/$m" "$n" > "$C" 2>&1
	dmesg | sed -n "/SMARK-$mark/,\$p" | grep -a "job: task_count=" | head -2 > "$C" 2>&1
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	# -n 8 floods the serial console and wedges the box. Learned the hard way.
	dmesg -n 4 2>/dev/null

	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/job_log 2>/dev/null
	log ""
	log "  task_con16=$(cat /sys/module/rocket/parameters/task_con16 2>/dev/null)"

	log ""
	log "===== 1) CONTROL: conv2d-cal, 5x5, 128 out channels ====="
	run conv2d-cal.tflite 2 cal-first

	log ""
	log "===== 2) cal_oc16: the SAME 5x5 conv cut to 16 out channels ====="
	log "  if this computes, the output channel count is not the variable"
	sleep 2
	run cal_oc16.tflite 3 cal-oc16

	log ""
	log "===== 3) md003_oc128: the 1x1 conv grown to 128 out channels ====="
	log "  if this fails, it is the kernel. 2 and 3 are the whole round."
	sleep 2
	run md003_oc128.tflite 3 md003-oc128

	log ""
	log "===== 4) md003_80 for reference, 1x1 with 16 out channels ====="
	sleep 2
	run md003_80.tflite 3 md003-80

	log ""
	log "===== 5) REGCMD: everything mesa emits for md003_80 ====="
	log "  to diff on the host against the vendor .rknn at this exact geometry"
	sleep 2
	rm -rf /tmp/rc; mkdir -p /tmp/rc; cd /tmp/rc || return 0
	env TEFLON_LIB=/usr/lib/libteflon.so ROCKET_DEBUG=dump_bos \
		python3 "$NPU_DIR/test_dw.py" "$NPU_DIR/md003_80.tflite" > /dev/null 2>&1
	log "  files: $(ls /tmp/rc 2>/dev/null | tr '\n' ' ')"
	for f in /tmp/rc/mesa-regcmd-*.bin; do
		[ -f "$f" ] || continue
		log "--- md003_80 $(basename "$f") ---"
		python3 "$NPU_DIR/extract_regcmd.py" "$f" 8 > "$C" 2>&1
	done
	cd / || return 0

	log ""
	log "===== 6) REPEAT CONTROL: conv2d-cal ====="
	sleep 2
	run conv2d-cal.tflite 2 cal-last

	log ""
	log "===== 2 and 3 separate the kernel from the output channels. 5 says  ====="
	log "===== whether the 1x1 bug is a register at all.                     ====="
	sync
}

case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
