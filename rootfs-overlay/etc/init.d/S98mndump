# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-11 round 74. DPU 0x4050's depthwise value is not a constant.
#
# Round 73 found which register the +1 was acting on. Adding one to the packed
# channel field of DPU 0x4030 closes the 1024 channel tail and leaves a 32
# channel layer alone, while the same addition on CORE 0x3020, DPU 0x402c or
# RDMA 0x5014 does nothing at 1024 and breaks 32 channels outright.
#
# Then the .rknn said not to ship it. Reading the vendor's own registers for a
# depthwise compiled at 32, 128, 256 and 1024 channels, 0x4030 carries oc-1 at
# every size: 0x001f0310, 0x007f0310, 0x00ff0310, 0x03ff0310. mesa writes
# exactly that. So +1 is a WORKAROUND that disagrees with the vendor, and this
# project has shipped a fitted constant before and paid for it for months.
#
# The same comparison found a register mesa really does get wrong. DPU 0x4050
# for a depthwise, from ten compiled channel counts:
#
#   channels    16   32   48   64   80   96  112  128  256 1024
#   SIZE_E_2     0    1    2    3    0    1    2    3    3    3
#
#     SIZE_E_2 = (DIV_ROUND_UP(oc, 16) - 1) & 3
#
# Seven of those were fitted and THREE WERE PREDICTED before being compiled:
# 16 and 80 give 0, a value none of the fitted points showed, and 112 gives 2.
# Ten of ten.
#
# mesa hardcoded 0x00013133, which is the 32 channel case. So every depthwise
# whose channel count is not 32, 96, 160 and so on was configured with the
# wrong one, and mn_dw1 has 32 channels, which is why it never showed.
#
# The derived value is now the default and the +1 knobs are left at zero. If
# 0x4050 alone closes the tail, the workaround was masking this and can go.
#
# DECISION RULE, written before the run:
#   1024 closes with no OC knob     0x4050 was the bug; drop the workaround
#   1024 still 992, and +1 on       the two are independent and 0x4030 needs
#     0x4030 still closes it        its own explanation before anything ships
#   1024 gets worse                 the formula is wrong somewhere the ten
#                                   points did not reach
#   mn_dw1 changes at all           it must not: 32 channels gives back
#                                   exactly 0x00013133, so any change there is
#                                   a bug in the expression
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
p() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== 1..2) REGRESSION: 32 channels must be bit for bit unchanged ====="
	p mn_dw1.tflite ""
	p dw1_t4.tflite ""

	log ""
	log "===== 3..4) 1024 channels on the derived 0x4050, no other knob ====="
	p dw25_t4.tflite ""
	p mn_dw25.tflite ""

	log ""
	log "===== 5) the CONTROL: force the old constant back ====="
	p dw25_t4.tflite ROCKET_DW_OW_CFG=0x00013133

	log ""
	log "===== 6) and the old workaround on top, to see if it still adds ====="
	p dw25_t4.tflite ROCKET_OC_CUBE_ADD=1

	log ""
	log "===== 7) old constant plus the workaround, which used to give 1024 ====="
	p dw25_t4.tflite "ROCKET_DW_OW_CFG=0x00013133 ROCKET_OC_CUBE_ADD=1"

	log ""
	log "===== 8..9) regular shapes, which take the other branch ====="
	p conv2d-cal.tflite ""
	p cal_oc16.tflite ""

	log ""
	log "===== 10) whole model, for the record ====="
	sleep 2
	env TEFLON_LIB=/usr/lib/libteflon.so \
		python3 "$NPU_DIR/test_model.py" "$NPU_DIR/conv2d-cal.tflite" 2 > "$C" 2>&1

	log ""
	log "===== Read 3 against 5. If the derived value closes the tail and  ====="
	log "===== the old constant reopens it, 0x4050 was the bug all along.  ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
