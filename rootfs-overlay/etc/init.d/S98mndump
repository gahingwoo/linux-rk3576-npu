#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-25 round 381. THE WIZARD, ON THE BOARD.
#
# r380 closed the power line: the rail follows the domain, it costs nothing in
# steady state, and it ran twice clean. r380b is the fastest anchor on record
# at 14.77 tok/s.
#
# This round verifies what was built today, on the target rather than the host:
# a model zoo that downloads from Hugging Face, a gate that decides whether a
# file is runnable by READING IT, and a launcher/config/doctor that replace a
# six-variable incantation.
#
# ---------------------------------------------------------------------------
# WHAT WAS BUILT, AND WHY EACH PIECE EXISTS
# ---------------------------------------------------------------------------
#
# charsiu_check   The runtime reads six ggml types (f32 f16 q4_0 q4_1 q8_0 q6_K)
#                 and builds ONE graph (general.architecture == "llama"). The
#                 filename does not tell you whether a file qualifies. MEASURED
#                 on real Hugging Face files:
#                   Q4_0_4_4.gguf -> type 31 in 210 tensors  (a Q4_0 REPACKED
#                                    for ARM dotprod; passes any name test)
#                   Q4_K_M.gguf   -> type 6 (q5_0) in 166 tensors
#                   Qwen2.5-*     -> architecture qwen2
#                 ⚠ And the reverse: Q6_K_L.gguf MEASURED AS RUNNABLE. I had
#                 called it a trap and it is not. Every type in that file is
#                 one charsiu reads. Only the contents decide, both ways.
#                 It uses the RUNTIME's own gguf parser, so the gate cannot
#                 drift from what will load.
#
# charsiu-get     The zoo. Every row was verified against the live repo on
#                 2026-08-25: size from the HF tree API, architecture read out
#                 of the file's own header over a range request. A download is
#                 gated before it is kept, and a file that fails is DELETED
#                 rather than left where the runtime would find it.
#
# charsiu         The launcher. The runtime reads 109 CHARSIU_* variables; six
#                 decide whether a decode reaches the NPU at all, and getting
#                 one wrong does not fail loudly. It quietly runs a third as
#                 fast on the CPU. ⚠ KMAX and W4_GROUP must be EQUAL (npudev
#                 gates the int4 path on it), so config.ini keeps ONE value and
#                 writes both.
#
# charsiu-config  ⚠ NO CURSES, unlike kiln's whiptail TUI. This rootfs has no
#                 whiptail, no dialog, no newt and no slang, and the board is
#                 driven over a 1.5 Mbaud serial console. Plain numbered menu,
#                 zero dependencies. Copying kiln's SHAPE is not copying its
#                 dependencies, and the two stacks are incompatible.
#
# ---------------------------------------------------------------------------
# AND THE BOARD COULD NOT REACH THE NETWORK AT ALL UNTIL THIS ROUND
# ---------------------------------------------------------------------------
#
# Every log up to r380 has "Waiting for interface eth0 to appear......... timeout!"
# and nobody had chased it. Root cause: CONFIG_STMMAC_ETH, STMMAC_PLATFORM and
# DWMAC_ROCKCHIP were all =m and nothing modprobes them at boot. Now =y.
# ⚠ The PHY was NOT the problem: rock-4d.dts says ethernet-phy-id001c.c916,
# which is a Realtek RTL8211F, and CONFIG_REALTEK_PHY=y was already set. I said
# Motorcomm first and that was wrong. The DTS says otherwise.
# The rootfs also had no CA store and no TLS fetcher, so ca-certificates and
# curl were added; busybox wget alone cannot verify a certificate.
#
# ---------------------------------------------------------------------------
# HOW TO READ IT
# ---------------------------------------------------------------------------
#
#   * arm 1: eth0 must EXIST and carry an address. This has never worked here.
#   * arm 2: charsiu-doctor must pass with nothing critical.
#   * arm 3: the gate, against the three models that ship on the card.
#   * arm 4: the zoo, and a REAL download from Hugging Face, on the board.
#     ⚠ The card is tight (2.7 GB of models in a 3584 MB rootfs), so
#     charsiu-get's free-space check may refuse, and refusing is a PASS for
#     that check. df is printed first so the number is visible either way.
#   * arm 5: the launcher must produce the SAME tok/s as the raw incantation.
#     That is the whole claim: convenience with no cost. Both arms are 64
#     tokens on the A72s; r380b's anchor was 14.77 and the band is <= 1%.
#   * probe exact, anchor clean.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
VD=/opt/charsiu/charsiu_vendor
V=/opt/charsiu/vendor
WT=$V/vendor-wt-1M.bin
IN=$V/vendor-in.bin
RUN=/opt/charsiu/charsiu_run
M8=/opt/charsiu/models/Llama-3.2-1B-Instruct-Q8_0.gguf
PROMPT="The capital of France is"
LIMIT=420
NGEN=64
CE=CHARSIU_COEF_ELEMS=65536
HEAD=CHARSIU_NPU_MAXN=131072
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block computes"
	else
		log "  !! health FAILED"; ABORT=1
	fi
}
capped() {
	lim="$1"; shift
	"$@" & pid=$!; i=0
	while [ "$i" -lt "$lim" ]; do
		kill -0 "$pid" 2>/dev/null || { wait "$pid"; return $?; }
		sleep 1; i=$((i + 1))
	done
	kill -9 "$pid" 2>/dev/null; wait "$pid" 2>/dev/null; return 124
}
rung() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED: $1"; return 0; }
	lbl="$1"; shift
	before=$(nbad)
	log ""; log "  -- $lbl"; sleep 1
	capped "$LIMIT" env "$@" "$RUN" "$M8" -p "$PROMPT" -n "${NGEN:-32}" \
		--ignore-eos -q -c 512 -t 4 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the rung exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. VOID."; health; }
	return 0
}
arm() {
	before=$(nbad)
	log ""; log "  ---- $1"; sleep 1
	env ${5:-IGNORED=1} $VD "$2" "$WT" "$IN" "$3" "$4" 4096 > /tmp/vd.txt 2>&1
	cat /tmp/vd.txt > "$C"
	after=$(nbad)
	[ "$after" != "$before" ] && { log "  !! POISONED"; health; ABORT=0; sleep 2; }
}

start() {
	log ""
	log "###############################################################"
	log "##### round 381: the wizard, on the board                   #####"
	log "###############################################################"

	B="CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 CHARSIU_NPU_W4V=1 CHARSIU_NPU_KMAX=1024 CHARSIU_NPU_W4_GROUP=1024 CHARSIU_STAGES=1"

	log ""
	log "===== 1) THE NETWORK, which has never worked on this board     ====="
	log "  stmmac/dwmac-rockchip were modules nobody loaded. Now built in."
	ip addr show eth0 2>/dev/null > "$C" || log "  !! eth0 does not exist"
	log "  -- route"
	ip route 2>/dev/null > "$C"
	log "  -- can it resolve and reach huggingface.co?"
	if curl -s -m 20 -o /dev/null -w '     HTTP %{http_code} in %{time_total}s\n' \
	     https://huggingface.co/api/models/bartowski/SmolLM2-135M-Instruct-GGUF > "$C" 2>&1; then
		log "     (a 200 above means TLS, the CA store and DNS all work)"
	else
		log "  !! could not reach huggingface.co"
	fi

	log ""
	log "===== 1b) the TUI, which is new                                ====="
	log "  whiptail is 1.8 MB of newt+slang. ⚠ It REFUSES to run without"
	log "  TERM, which a serial console often lacks, so charsiu-tui.sh"
	log "  falls back to plain text rather than failing."
	log "     whiptail: $(command -v whiptail || echo MISSING)"
	log "     TERM=${TERM:-(unset)}  -> the tools will use the plain path if unset"
	charsiu-config --help > "$C" 2>&1 || true

	log ""
	log "===== 2) charsiu-doctor                                        ====="
	charsiu-doctor > "$C" 2>&1
	log "  doctor exit $?  (0 = nothing critical)"

	log ""
	log "===== 3) the gate, on the models that ship on the card         ====="
	for m in /opt/charsiu/models/*.gguf; do
		printf '  %-46s ' "$(basename "$m")" > "$C"
		/opt/charsiu/charsiu_check -q "$m" > "$C" 2>&1
	done

	log ""
	log "===== 4) the zoo, and a real download from Hugging Face        ====="
	log "  -- room on the card first; refusing for lack of space is a PASS"
	df -h /opt/charsiu/models > "$C" 2>&1
	charsiu-get > "$C" 2>&1
	log "  -- fetching the smallest entry, 92 MB, onto this board"
	charsiu-get smollm2-135m-q4 > "$C" 2>&1
	log "  fetch exit $?"
	ls -l /opt/charsiu/models/ > "$C" 2>&1

	log ""
	log "===== 5) the launcher must cost NOTHING                        ====="
	log "  same 64 tokens, once by hand and once through config.ini."
	log "  r380b's anchor was 14.77 tok/s and the band is <= 1%."
	rung "by hand: the six variables spelled out" $B "$CE" "$HEAD" CHARSIU_CPUS=4-7
	log ""
	log "  -- through the launcher"
	log "     the command it builds:"
	charsiu --show -p "$PROMPT" -n 64 > "$C" 2>&1
	# ⚠ the same CHARSIU_STAGES as the by-hand arm, or the two are not the
	# same measurement. env inherits, and the launcher's own env adds to it.
	capped "$LIMIT" env CHARSIU_STAGES=1 charsiu -p "$PROMPT" -n 64 \
		--ignore-eos -q > "$C" 2>&1
	log "  launcher exit $?"

	log ""
	log "===== 5b) the UX that was added after the wizard               ====="
	log "  -- charsiu bench: one command instead of six variables"
	charsiu bench > "$C" 2>&1 || log "  !! bench failed"
	log "  -- charsiu-doctor --paste: the block to put in an issue"
	charsiu-doctor --paste > "$C" 2>&1 || true
	log "  -- and a real conversation: does turn 2 remember turn 1?"
	log "     (the model stays staged, so turn 2 costs a token not 20 s)"
	printf 'My name is Bob. Just say OK.\nWhat is my name?\n/quit\n' \
		| charsiu -i -n 24 > "$C" 2>&1 || log "  !! interactive failed"
	log "     ^ the second answer must contain Bob"

	log ""
	log "===== 6) the probe, still exact                                ====="
	arm "solo verify" "-" 0 0 "CHARSIU_M=1 CHARSIU_GEN=1 CHARSIU_VERIFY=1 CHARSIU_OUT_KB=64"

	log ""
	log "===== 7) the anchor                                            ====="
	health

	log ""
	log "===== read arm 1 first: nothing else matters if eth0 is down.  ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
