# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-19 round 258. Score against what the operation means.
#
# 🔑 WHAT 257 SETTLED, and it ends the one count hunt rather than continuing it.
#
# With ROCKET_ABIAS asking every operator the same question, the best value is
# per operator and there is no single constant: conv2d-cal wants -1, mn_pw2
# wants 0, mn_dw25 mn_pw24 and mn_dw1 want +1. That looked like a dead end, so
# the reference itself got checked, offline, with no board involved.
#
#   model      tflite vs EXACT          board, this driver vs tflite
#   mn_dw1     14.41% differ, HIGH 100%  14.38% differ, LOW 100%
#   mn_pw2      0.86% differ, HIGH 100%   0.78% differ, LOW 100%
#   mn_pw24     0.18% differ, HIGH 100%   0.19% differ, LOW 100%
#
# Three models, matching to a tenth of a percent, one sided in exactly opposite
# directions. THE HARDWARE IS THE ACCURATE ONE. tflite's requant is a
# SaturatingRoundingDoublingHighMul then a RoundingDivideByPOT which rounds a
# half away from zero, and where the final divide is by two, which is mn_dw1's
# case at a multiplier of 0.292, that is one pixel in seven.
#
# ⚠ SO ROCKET_ABIAS=1 IS A TRAP and I nearly recommended it. Taking mn_dw1 from
# 85.62 to 98.88 percent agreement means adopting the interpreter's error. The
# same goes for MobileNet at 98.80 to 99.70. Both were moves away from correct.
#
# conv2d-cal is the one that does not fit: the interpreter deviates on only
# 0.07 percent there while the board sees 0.19 percent the other way, so that
# model has a small deviation of its own. It is still every channel within one
# count.
#
# WHAT THIS ROUND CHANGES. perch.py now also scores a single operator model
# against exact arithmetic computed in integers with one rounding at the end,
# and prints how far the interpreter is from it. Nothing else moved, and any
# failure in that path leaves the rest of the report untouched.
#
# THE READING RULE, fixed before the run.
#
#   The new line is "EXACT ARITHMETIC reference". Read it, not the old one.
#
#   ⚠ The prediction is sharp and it is falsifiable. mn_dw1, mn_pw2 and mn_pw24
#   should come back at or very near BYTE EXACT against exact arithmetic, since
#   their entire disagreement with the interpreter is accounted for by the
#   interpreter's own deviation. If they do not, the accounting above is wrong
#   and this is a coincidence of totals rather than the same pixels.
#
#   ⚠ conv2d-cal should NOT go byte exact. Its 0.19 percent is its own. If it
#   does go exact then I have mismatched the padding or the input somewhere in
#   the new reference and the whole line needs rechecking.
#
#   ⚠ The knobs are off. This measures what the driver already does.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	after=$(nbad)
	if [ "$after" != "$before" ]; then
		log "  !! POISON in this entry. The block faulted. This result is VOID."
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" \
			> /tmp/hc.txt 2>&1
		if grep -q "128/128 channels match" /tmp/hc.txt; then
			log "  !! health OK, the block recovered, continuing"
		else
			log "  !! health FAILED, the block is gone. ABORTING the round."
			ABORT=1
		fi
	fi
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	if [ -w /sys/module/rocket/parameters/reset_autosuspend ]; then
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend
		log "reset_autosuspend = $(cat /sys/module/rocket/parameters/reset_autosuspend)"
	else
		log "!! reset_autosuspend NOT WRITABLE. A timeout will kill the round."
	fi

	log ""
	log "===== 1-3) THE PREDICTION. All three should be at or near byte     ====="
	log "=====      exact against exact arithmetic, with the interpreter's  ====="
	log "=====      own deviation printed beside it.                        ====="
	w mn_dw1.tflite ""
	w mn_pw2.tflite ""
	w mn_pw24.tflite ""

	log ""
	log "===== 4) THE FALSIFIER. conv2d-cal must NOT go byte exact. If it   ====="
	log "=====    does, the new reference has a padding or input bug.       ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== 5-7) the rest of the single operator set                     ====="
	w mn_conv0.tflite ""
	w mn_dw25.tflite ""
	w cal_k3.tflite ""

	log ""
	log "===== 8-10) and one pair with ABIAS on, to show in one log that    ====="
	log "=====       agreeing with the interpreter costs exactness          ====="
	w mn_dw1.tflite "ROCKET_ABIAS=1"
	w mn_pw24.tflite "ROCKET_ABIAS=1"
	w mn_dw25.tflite "ROCKET_ABIAS=1"

	log ""
	log "===== 11) a multi operator model, where the new reference declines ====="
	log "=====     and the report should be unchanged                       ====="
	w mobilenet_v1_1.0_224_quant.tflite ""

	log ""
	log "===== a final anchor                                               ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== Read 1 and 2, then 3 against 4. The bar is the arm beside it ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
