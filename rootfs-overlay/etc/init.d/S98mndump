# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-11 round 83. Measure conv0's requant instead of sweeping for it.
#
# Round 82 confirmed the padding fix and its control:
#
#   impulse decode, fixed      CPU 32/32, hardware 32/32, plane 32/32,
#                              correlation +1.000 on every channel
#   control, old padding       hardware 0/32, plane 25/32, the shift is back
#   conv0 row maxdiff          163 to 200 and varying, from 255 pinned
#
# So the window is right now. conv0 is still 0 COMPUTED.
#
# The impulse model says what is left, and says it precisely: fc_imp decodes to
# exactly the right plane and tap on all 32 channels at correlation 1.000, and
# matches nothing. A perfect correlation with wrong values is an AFFINE error,
# a scale and an offset, and that is the requant.
#
# Round 80 swept the requant and learned only that the output moves. Sweeping
# costs a flash per point and cannot land on a value it does not try. perch.py
# now FITS the affine map instead: ref = a * npu + b, per channel, over the
# channels that disagree, reported as a median so one saturated channel cannot
# drag it. On fc_imp, where the correlation is 1.000, a and b are exact.
#
# Then the arithmetic is one step. The driver writes scale S at shift T, so the
# multiplier is S / 2^T; if the reference is a times the hardware's output, the
# multiplier wanted is a times what is being written, and a says whether it is
# a clean power of two, the ratio between the captured and computed pairs, or
# something else entirely.
#
# DECISION RULE, written before the run:
#   a is a clean power of two      the shift alone is wrong, and by log2(a)
#   a matches 0x76be/2^22 over     the computed pair is right and the captured
#     0x5391/2^25, which is 11.4   literals are from another model after all
#   a varies per channel           it is not a per-layer requant at all and the
#                                  next question is per-channel
#   b is far from zero             the OUT_CVT offset is wrong too, and by b
#   conv2d-cal or the depthwise    that comes first
#     models move
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
p() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== 1) the impulse model: a and b are exact here ====="
	p fc_imp.tflite ""

	log ""
	log "===== 2) conv0 with its real weights ====="
	p mn_conv0.tflite ""

	log ""
	log "===== 3..5) and at three shifts, so a can be checked against them ====="
	p fc_imp.tflite ROCKET_FC_SHIFT=24
	p fc_imp.tflite ROCKET_FC_SHIFT=22
	p fc_imp.tflite ROCKET_FC_SHIFT=21

	log ""
	log "===== 6) the computed pair on the impulse model ====="
	p fc_imp.tflite "ROCKET_FC_SCALE=0x76be ROCKET_FC_SHIFT=22"

	log ""
	log "===== 7..9) REGRESSION, and the fit must read a=1 b=0 there ====="
	p conv2d-cal.tflite ""
	p mn_dw1.tflite ""
	p mn_dw25.tflite ""

	log ""
	log "===== Read a and b on test 1. The multiplier being written is     ====="
	log "===== 0x5391 / 2^25; the one wanted is a times that.              ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
