# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-12 v7 VERIFICATION. Not a round; this checks the upstream series.
#
# The v7 branch has never been run. What has been run is the fork with
# task_con16=1 and no_poll=1, which is the same code by inspection and not the
# same tree. The cover letter says "Tested on a Radxa ROCK 4D" and every claim
# under "Where it stands" has to be true of THIS kernel:
#
#   the NPU probes with the two domain list and no attach failure
#   a convolution submitted three times with three DIFFERENT inputs is byte
#     exact each time, no reset in between, nothing retiring it but the IRQ
#   /proc/interrupts counts up
#   unbind and rebind is clean with no warning
#
# It also answers a question the series does not: the fork carries patches that
# v7 does not, including the rk_iommu flush_iotlb_all, which is neither
# upstream nor in this series. If the NPU only works with those, the cover
# letter's tested claim is wrong and the series is incomplete.
#
# perch.py takes ROCKET_SEED now, so the three submits differ in their input.
# Every earlier "byte exact N times in a row" figure fed the same input and
# could not tell a recomputation from an untouched output buffer. This can.
#
# WHAT WOULD SINK IT:
#   any of the three runs not 128/128        the series does not compute here
#   the interrupt count not rising           something still retires jobs
#                                            without the interrupt
#   an attach failure or a probe warning     the domain list move broke probe
#   a warning on unbind or rebind            the teardown lost something with
#                                            the poll
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
p() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null

	log ""
	log "===== kernel and probe ====="
	uname -r > "$C"
	dmesg | grep -iE "rocket|rknn|npu" | tail -12 > "$C"
	log ""
	log "===== power domains and clocks ====="
	dmesg | grep -iE "power domain|attach" | tail -6 > "$C"

	log ""
	log "===== interrupts BEFORE ====="
	grep -iE "npu|rknn|rocket" /proc/interrupts > "$C" 2>/dev/null || \
		log "  no NPU line in /proc/interrupts yet"

	log ""
	log "===== three submits, three DIFFERENT inputs, no reset between ====="
	p conv2d-cal.tflite "ROCKET_SEED=7"
	p conv2d-cal.tflite "ROCKET_SEED=11"
	p conv2d-cal.tflite "ROCKET_SEED=13"

	log ""
	log "===== interrupts AFTER. This must have risen ====="
	grep -iE "npu|rknn|rocket" /proc/interrupts > "$C" 2>/dev/null

	log ""
	log "===== the rest of the standing set, on this kernel ====="
	p mn_conv0.tflite ""
	p mn_dw1.tflite ""
	p mn_dw25.tflite ""
	p dw64w96.tflite ""

	log ""
	log "===== unbind and rebind ====="
	D=$(ls /sys/bus/platform/drivers/rocket/ 2>/dev/null | grep -E "^[0-9a-f]+\." | head -1)
	if [ -n "$D" ]; then
		echo "$D" > /sys/bus/platform/drivers/rocket/unbind 2>"$C"
		sleep 1
		echo "$D" > /sys/bus/platform/drivers/rocket/bind 2>"$C"
		sleep 1
		dmesg | tail -8 > "$C"
	else
		log "  could not find the platform device to unbind"
	fi

	log ""
	log "===== dmesg WARN/BUG, which must be empty ====="
	dmesg | grep -iE "WARNING|BUG:|call trace|refcount" | tail -10 > "$C"

	log ""
	log "===== v7 verification done ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
