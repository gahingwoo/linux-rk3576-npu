#!/bin/sh
# ---------------------------------------------------------------------------
# 2026-08-08 round 7. Round 6 refuted "it is the kernel" and found the register.
#
#   cal_oc16, the SAME 5x5 conv cut to 16 output channels   0/3 FAIL
#   md003_oc128, the 1x1 grown to 128 output channels       0/3 FAIL
#
# Both fail, so neither the kernel nor the channel count explains it alone. But
# the regcmd dump did: mesa's stream for md003_80 differs from the vendor .rknn
# compiled at that exact geometry in only FIVE values, two of which were already
# shown not to matter (0x1018, 0x1040) and two of which are requant fields that
# are not comparable across differently quantized models (0x40ac, 0x40b4).
#
# The fifth is DPU 0x4050, and it depends on the OUTPUT CHANNEL COUNT:
#
#   16 48 80 112 144 -> 0x80011011      32 64 96 128 160 -> 0x80011111
#
# ten out of ten across a sweep with everything else held fixed. mesa emitted
# the 128-channel constant for everything, so it was right for conv2d-cal and
# wrong for every conv whose channel count is 16 more than a multiple of 32.
#
# PREDICTIONS, stated before the run:
#   2 cal_oc16 with the derived value    computes
#   3 the same with the old constant     fails, reproducing round 6
#   4 md003_80, 16 channels              computes, its diff had nothing else
#   5 md003_oc128, 128 channels          STILL FAILS, 0x4050 was already right
#
# 5 failing is not a disappointment, it is the point: it isolates whatever is
# left to a case where this register is correct. Step 6 dumps its regcmd.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }

run() {
	m="$1"; n="$2"; mark="$3"; shift 3
	echo "SMARK-$mark" > /dev/kmsg 2>/dev/null
	env TEFLON_LIB=/usr/lib/libteflon.so "$@" \
		python3 "$NPU_DIR/test_model.py" "$NPU_DIR/$m" "$n" > "$C" 2>&1
	dmesg | sed -n "/SMARK-$mark/,\$p" | grep -a "job: task_count=" | head -2 > "$C" 2>&1
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	# -n 8 floods the serial console and wedges the box. Learned the hard way.
	dmesg -n 4 2>/dev/null

	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/job_log 2>/dev/null
	log ""
	log "  task_con16=$(cat /sys/module/rocket/parameters/task_con16 2>/dev/null)"

	log ""
	log "===== 1) CONTROL: conv2d-cal, 128 channels, 0x4050 unchanged ====="
	run conv2d-cal.tflite 2 cal-first

	log ""
	log "===== 2) cal_oc16, derived 0x4050 = 0x80011011 ====="
	log "  PREDICTED TO COMPUTE. It failed in round 6 with 0x80011111."
	sleep 2
	run cal_oc16.tflite 3 oc16-derived

	log ""
	log "===== 3) A/B: cal_oc16 with ROCKET_DPU4050_CONST=1 ====="
	log "  must reproduce round 6's failure, or 2 proves nothing"
	sleep 2
	run cal_oc16.tflite 3 oc16-const ROCKET_DPU4050_CONST=1

	log ""
	log "===== 4) md003_80, 1x1 with 16 channels, derived 0x4050 ====="
	log "  PREDICTED TO COMPUTE: its regcmd diff had nothing else in it."
	sleep 2
	run md003_80.tflite 3 md003-80

	log ""
	log "===== 5) md003_oc128, 1x1 with 128 channels ====="
	log "  PREDICTED TO STILL FAIL. 0x4050 was already correct for it."
	sleep 2
	run md003_oc128.tflite 3 md003-oc128

	log ""
	log "===== 6) cal_s1, still 3/3? the padding fix must survive ====="
	sleep 2
	run cal_s1.tflite 2 s1-keep

	log ""
	log "===== 7) REGCMD: everything mesa emits for md003_oc128 ====="
	log "  the case where 0x4050 is right and it still fails"
	sleep 2
	rm -rf /tmp/rc; mkdir -p /tmp/rc; cd /tmp/rc || return 0
	env TEFLON_LIB=/usr/lib/libteflon.so ROCKET_DEBUG=dump_bos \
		python3 "$NPU_DIR/test_dw.py" "$NPU_DIR/md003_oc128.tflite" > /dev/null 2>&1
	for f in /tmp/rc/mesa-regcmd-*.bin; do
		[ -f "$f" ] || continue
		log "--- md003_oc128 $(basename "$f") ---"
		python3 "$NPU_DIR/extract_regcmd.py" "$f" 8 > "$C" 2>&1
	done
	cd / || return 0

	log ""
	log "===== 8) REPEAT CONTROL: conv2d-cal ====="
	sleep 2
	run conv2d-cal.tflite 2 cal-last

	log ""
	log "===== 2 against 3 is the A/B. 4 says the 1x1 with 16 channels was  ====="
	log "===== the same bug. 5 is expected to fail and 7 is why it is here. ====="
	sync
}

case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
