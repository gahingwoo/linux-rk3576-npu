# ---------------------------------------------------------------------------
# 2026-08-13 round 134. How far up MobileNet does it go now.
#
# Round 133 landed the tiled 1x1 weight layout and every pointwise shape came
# out correct: 64 to 64, 64 to 128 and 128 to 128 all at maxdiff 1, the tap
# ladder went from 0 of 64 to 64 of 64, and the ROCKET_PW_ICGROUP control put
# the old layout back and reproduced the old failure exactly, 25 of 64.
#
# More to the point, operators 3 and 4 of MobileNet came off the board at 21 of
# 64 maxdiff 13 and 18 of 128 maxdiff 14, which is not "still failing". It is
# EXACTLY what correct hardware scores against tflite there.
#
# That number now comes from a tool rather than a memory: chainmodel.py runs the
# whole graph twice from the model file, once with tflite's requant and once
# with the hardware's, and prints what a perfect accelerator would score. A
# channel count means nothing past the first layer or two without it, because
# tflite's double rounding compounds through the chain.
#
# DECISION RULE, written before the run. For each operator, correct is the
# model's own figure and nothing else:
#
#     op    correct hardware scores        was
#      3    21/64   maxdiff 13    <- board matched this in round 133
#      4    18/128  maxdiff 14    <- board matched this in round 133
#      5     9/128  maxdiff 13
#      6     4/128  maxdiff 23        0/128 maxdiff 255
#      7     7/128  maxdiff 10
#      8    36/256  maxdiff 7         0/256 maxdiff 255
#     12   166/512  maxdiff 11
#     18    92/512  maxdiff 7
#     24   671/1024 maxdiff 6
#     26   572/1024 maxdiff 25
#
#   every operator on its figure
#             MobileNet is correct end to end and the next thing is accuracy on
#             a real image, not a channel count.
#   the first operator that reads maxdiff in the hundreds
#             that operator is the defect and everything above it is downstream.
#             Read its kind: a depthwise at 28 wide or narrower has never been
#             run here, and neither has a 1x1 at 512 or 1024 channels.
#   an operator far BELOW its figure with a small maxdiff
#             not a defect, that is the reference artifact and the model says
#             so. Do not chase it.
#
# CONTROLS that can fail: entries 1 and 2 are operators 3 and 4, which matched
# the model yesterday and must match it again, and conv2d-cal and mn_conv0 must
# stay whole. Nothing in mesa or the kernel changed since round 133, so a move
# in any of those means the image, not the driver.
#
# The two tail shapes at the end are a known gap, not a MobileNet blocker: every
# channel count in MobileNet is a multiple of 32 and pw33 is not. 48 is a 16
# wide tail tile and 33 a one wide one, which says whether the cut edge is
# wrong in general or only when it is very small.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
p() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== 1..2) ANCHOR: operators 3 and 4, which must stay on the model ====="
	p mn_L03.tflite ""
	p mn_L04.tflite ""

	log ""
	log "===== 3..6) the next four operators: 9/128, 4/128, 7/128, 36/256 ====="
	p mn_L05.tflite ""
	p mn_L06.tflite ""
	p mn_L07.tflite ""
	p mn_L08.tflite ""

	log ""
	log "===== 7..10) deeper: 166/512, 92/512, 671/1024, 572/1024 ====="
	p mn_L12.tflite ""
	p mn_L18.tflite ""
	p mn_L24.tflite ""
	p mn_L26.tflite ""

	log ""
	log "===== 11) the whole MobileNet ====="
	p mobilenet_v1_1.0_224_quant.tflite ""

	log ""
	log "===== 12..13) the cut tile, a known gap and not a blocker ====="
	p pw48x64w56.tflite ""
	p pw33x64w56.tflite ""

	log ""
	log "===== 14..16) REGRESSION ====="
	p pw64x128w56.tflite ""
	p conv2d-cal.tflite ""
	p mn_conv0.tflite ""

	log ""
	log "===== Compare each operator against the table in the header. A big  ====="
	log "===== maxdiff is a defect; a low channel count with a small maxdiff ====="
	log "===== is the reference and is not.                                  ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
