# ---------------------------------------------------------------------------
# 2026-08-11 round 84. The first conv's PAD VALUE, the third literal.
#
# Round 83 fitted the affine map instead of sweeping for it, and the fit itself
# pointed somewhere better than its own numbers.
#
# On fc_imp the fit gives a about 0.345 with b about -20, tightly clustered
# across channels, 0.3376 to 0.3449, so it is per layer rather than per
# channel. But its correlation is 0.89, while fcimp.py's decode of the SAME run
# reports 1.000. The difference is where each looks: the decode uses a 32x32
# interior crop, the fit uses the whole 112x112 surface. Interior perfect,
# whole surface not, is a BORDER error.
#
# ⚠ The fitted a is also not trustworthy on its own. As the shift drops the
# output saturates, npu distinct falling 242, 122, 32, 17, and a fitted slope
# over a clipped surface is not the multiplier. That is why a moves 0.345,
# 0.246, 0.196, 0.189 rather than doubling with each shift. The fit named the
# border; it did not name the requant.
#
# And the border is a third hardcoded literal in the same function. The CMAC
# sees the input with 0x80 subtracted, so a padded tap has to read in_zp - 0x80
# to contribute nothing, replicated over the three input lanes:
#
#     R_CNA(0x1084, 0x00808080)
#
# is that byte for an input whose zero point is 0, a plain image tensor, which
# is what the capture this function came from used. MobileNet's conv0 has zero
# point 128 and wants 0x00000000. The generic path already carries this fix and
# its comment records the symptom in as many words: the output border ring is
# wrong and everything inside it is right.
#
# That is the third literal in fill_regcmd_firstconv found wrong this way, after
# the padding amounts and the coefficient region collision. All three were
# correct for the single model the function was written from.
#
# DECISION RULE, written before the run:
#   conv0 gets COMPUTED channels     the border was the last of it
#   the affine correlation rises     the border is fixed and a smaller thing
#     toward 1.000 but 0 COMPUTED    remains; the fit is then trustworthy and
#                                    names the requant directly
#   nothing changes                  in_zp - 0x80 is not what this register
#                                    wants for a first conv
#   ROCKET_FC_PAD_VAL=0x00808080     the control: it must put the old border
#                                    back
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
p() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== 1..2) the impulse model and its control ====="
	p fc_imp.tflite ""
	p fc_imp.tflite ROCKET_FC_PAD_VAL=0x00808080

	log ""
	log "===== 3..4) conv0 and its control ====="
	p mn_conv0.tflite ""
	p mn_conv0.tflite ROCKET_FC_PAD_VAL=0x00808080

	log ""
	log "===== 5) the decode, which should still be 32/32 both sides ====="
	sleep 2
	env TEFLON_LIB=/usr/lib/libteflon.so \
		python3 "$NPU_DIR/fcimp.py" > "$C" 2>&1

	log ""
	log "===== 6) the chain that needs conv0 ====="
	p mn_conv0dw1.tflite ""

	log ""
	log "===== 7..9) REGRESSION ====="
	p conv2d-cal.tflite ""
	p mn_dw1.tflite ""
	p mn_dw25.tflite ""

	log ""
	log "===== 10) whole model ====="
	sleep 2
	env TEFLON_LIB=/usr/lib/libteflon.so \
		python3 "$NPU_DIR/test_model.py" "$NPU_DIR/conv2d-cal.tflite" 2 > "$C" 2>&1

	log ""
	log "===== Watch the affine correlation on test 1. If the border was   ====="
	log "===== it, that number goes to 1.000 and then a means something.   ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
