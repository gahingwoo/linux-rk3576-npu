# ---------------------------------------------------------------------------
# 2026-08-13 round 137. The output channel count and the group of 8.
#
# Round 136 fixed the input side and drew a very clean line on the output side.
#
#   pw48x64w56    28 of 64 maxdiff 105  ->  64 of 64 maxdiff 1
#   the control   ROCKET_SURF_DIV=1 put back exactly 28 of 64 maxdiff 105
#   pw33x64w56    unchanged at maxdiff 255, so 33 INPUT channels has a second
#                 fault of its own
#   regressions   pw64x64, pw32x64, mn_L04, conv2d-cal, mn_conv0 all unmoved
#
# and the output tail ladder, at 64 input channels and 56 wide:
#
#   oc 33   flat 128            oc 40   40 of 40, correct
#   oc 34   EMPTY               oc 56   first 32 channels correct,
#   oc 36   EMPTY                       channels 32..55 wrong
#   oc 41   EMPTY               oc 64   64 of 64, correct
#   oc 47   EMPTY
#
# The empty ones are exactly the counts that are not a multiple of 8, and the
# two that are correct are exactly the multiples of 8 whose last weight tile is
# 8 or 32 channels. MobileNet's last operator has 1001 output channels, which is
# not a multiple of 8, and it comes off the board empty.
#
# The per-channel record table is read in whole groups of 8 channels, 64 bytes
# each, and this driver only ever filled the channels the layer really has. The
# rest of the last group stayed zero, which is a zero requant multiplier sitting
# in the same group as live channels. This round carries the last real channel's
# record across the rest of its group.
#
# DECISION RULE, written before the run:
#
#   34, 36, 41, 47 come alive
#             the partial group was the fault. Then 56 is a separate matter,
#             since it is a whole number of groups and still wrong past channel
#             32, and MobileNet's last operator should move.
#   they stay empty
#             the group is not it. Entries 9 and 10 dump our register stream at
#             34 and at 40, and the vendor's for both is already extracted here
#             (ocp34, ocp40, ocp56, compiled at this exact shape), so the diff
#             is one command.
#   oc 56 changes at all
#             unexpected, since 56 is 7 whole groups and the padding cannot
#             touch it. That would mean the knob is doing something else.
#
# CONTROL that can fail: entry 3 runs oc 34 with ROCKET_OC_NOPAD=1, which must
# put the empty convolution back. If entries 2 and 3 read the same, the padding
# is not reaching the buffer and nothing else here means anything.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
p() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== 1..2) THE TEST: the counts that were empty ====="
	p pw64x34w56.tflite ""
	p pw64x41w56.tflite ""

	log ""
	log "===== 3) CONTROL: the same shape with the group left unpadded ====="
	p pw64x34w56.tflite "ROCKET_OC_NOPAD=1"

	log ""
	log "===== 4..6) the rest of the ladder ====="
	p pw64x36w56.tflite ""
	p pw64x47w56.tflite ""
	p pw64x33w56.tflite ""

	log ""
	log "===== 7..8) the whole number of groups, unchanged by the padding ====="
	p pw64x56w56.tflite ""
	p pw64x40w56.tflite ""

	log ""
	log "===== 9..10) our register stream at 34 and at 40 ====="
	p pw64x34w56.tflite "ROCKET_DUMP_REGCMD=1"
	p pw64x40w56.tflite "ROCKET_DUMP_REGCMD=1"

	log ""
	log "===== 11) the whole MobileNet, whose last operator has 1001 ====="
	p mobilenet_v1_1.0_224_quant.tflite ""

	log ""
	log "===== 12..16) REGRESSION ====="
	p pw48x64w56.tflite ""
	p pw64x64w56.tflite ""
	p mn_L04.tflite ""
	p conv2d-cal.tflite ""
	p mn_conv0.tflite ""

	log ""
	log "===== Entry 3 must be EMPTY. If entries 2 and 3 read the same, the ====="
	log "===== padding never reached the buffer.                            ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
