#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-11 round 68. Nine taps, nine live ranges, one addressing law.
#
# Round 67 answered "which 128" and the answer is a CONTIGUOUS RUN that MOVES
# WITH THE TAP:
#
#   dw25_t0   live channels    0..127     one run
#   dw25_t4   live channels  448..575     one run
#
# 128 wide either way. So the weight fetch is not truncated and not strided: for
# a given output channel the hardware reads a WINDOW of the weight buffer, and
# which channels see a live byte depends on where that window falls. Only 128
# channels of 1024 can reach any one spatial block.
#
# The 32 channel case never shows this because its whole weight buffer is 576
# bytes: every channel reaches every block, which is why it has always worked
# and why nothing found here in fifteen rounds of coefficient work applied to
# it.
#
# Two points do not determine a law. Fitting them already produced two
# candidates that each explain one point and miss the other by 64 channels, so
# this round measures all nine instead. Each model puts the live tap at the same
# position in every channel, so the live bytes are exactly one 2048 byte spatial
# block of mesa's buffer, and the live channel range says which channels can
# address that block.
#
# What the shape will mean:
#
#   start = k*p, width 128        a linear address map; k is the channels per
#                                 block, and mesa's block stride and the
#                                 hardware's disagree by 2048/k bytes per
#                                 channel
#   width changes with p          the window is not uniform, and the ends will
#                                 say whether it wraps
#   some taps light nothing       those blocks are outside every channel's
#                                 window, and the count of dead taps says by
#                                 how much the buffer overruns
#
# Nothing in the driver changed this round.
#
# DECISION RULE, written before the run:
#   nine starts fall on a line     read the slope, fix the stride, done
#   they do not                    the window is not affine and the next step
#                                  is the CNA weight registers rather than the
#                                  buffer
#   any run is not contiguous      the fetch is strided after all and round 67
#                                  saw two contiguous ones by luck
#   dw1_t4 not 32/32               the control failed, read nothing else
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
log() { echo "$@" > "$C"; }
p() { log ""; log "  -- $1   $2"; sleep 2; \
	env TEFLON_LIB=/usr/lib/libteflon.so $2 \
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1; }

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	echo 1 > /sys/module/rocket/parameters/task_con16 2>/dev/null

	log ""
	log "===== the nine taps, in order. Read the VARIES run of each ====="
	p dw25_t0.tflite ""
	p dw25_t1.tflite ""
	p dw25_t2.tflite ""
	p dw25_t3.tflite ""
	p dw25_t4.tflite ""
	p dw25_t5.tflite ""
	p dw25_t6.tflite ""
	p dw25_t7.tflite ""
	p dw25_t8.tflite ""

	log ""
	log "===== CONTROL: 32 channels, one tap everywhere, must be 32/32 ====="
	p dw1_t4.tflite ""

	log ""
	log "===== REGRESSION: the real 112x112 depthwise ====="
	p mn_dw1.tflite ""

	log ""
	log "===== a regular shape, which must be untouched ====="
	p conv2d-cal.tflite ""

	log ""
	log "===== Nine starts. If they fall on a line, the slope is the number ====="
	log "===== of channels that fit in one spatial block, and that is it.   ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
