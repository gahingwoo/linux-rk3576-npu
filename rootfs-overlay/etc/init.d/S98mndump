# SPDX-License-Identifier: GPL-2.0
# ---------------------------------------------------------------------------
# 2026-08-22 round 310. int4's MARGINAL COST, WHICH HAS NEVER BEEN MEASURED.
#
# ⚠⚠ ROUND 306 PARKED int4 ON A MEASUREMENT THAT DOES NOT SUPPORT IT, AND THE
# EVIDENCE IS IN 306's OWN LOG. Both int4 bench tables died:
#
#   int8 K=2048 N=256              int4 K=2048 N=256
#     1   224.2                      1   222.7
#     2   246.8                      [   33.186739] NPU job timed out
#     4   419.1                      2   10904.3      <- a timeout printed as
#     ...                            [   33.762739] NPU job timed out    a number
#     marginal 57.4 us (9.14 GB/s)
#     fixed    166.8 us
#
# So int4 has ONE point, at one task, where 166.8 of the 224 microseconds is
# fixed submit cost. Halving the weight bytes is worth 28 us there, or 12% of
# the number, and the conclusion drawn was "half the bytes, the same time".
#
# ⚠ THAT SINGLE POINT CANNOT TELL THE TWO ANSWERS APART. Both of these fit it:
#
#   int4 slope EQUALS int8's        166.8 + 57.4 = 224 us     the parking
#   int4 slope is HALF int8's       194   + 28.7 = 223 us     a higher intercept
#
# and nothing has ever measured int4's intercept. A submit's fixed cost is not
# obliged to be the same on a path with its own DPU and RDMA configuration.
#
# TWO OTHER THINGS FROM 306 THAT WERE MY OWN AND NOT THE HARDWARE'S:
#   - N >= 512 came back "exact 0", which was the ngrp > 32 guard REFUSING.
#     The guard went to 256 groups in the parking commit itself and HAS NEVER
#     BEEN ON THE BOARD. Checked on the host today at 36 shapes, K 64..2048 by
#     N 16..2048: the packer writes exactly charsiu_weight_bytes at every one,
#     no overrun, no refusal.
#   - the bench wrote every chained int4 task's output over the one before it
#     (stride m*n, element four bytes). Fixed. Found by inspection, and it is
#     NOT the hang: the allocation always had the factor of four.
#
# ---------------------------------------------------------------------------
# THE INSTRUMENT: A MARGINAL WITHOUT CHAINING
# ---------------------------------------------------------------------------
#
# int4 chaining hangs from TWO tasks up, so the difference-of-task-counts method
# can never give it a marginal. --nsweep gets the same two constants from single
# task runs: hold K at 2048, walk N through 128 256 512 1024 2048, and fit
# microseconds against weight megabytes. The SLOPE is the marginal cost per byte
# and the INTERCEPT is everything that does not scale with them.
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# 1) READ THE FIT LINE, NOT ANY SINGLE ROW. Every row still has the fixed cost
#    in it. That is the mistake this whole round exists to correct.
#
# 2) ENTRY 2 IS THE CONTROL AND IT MUST PASS FIRST. int8's fit has to reproduce
#    what the chained sweep already measured: about 97 us/MB, which is 10.3
#    GB/s, and an intercept near 170 us. If it does not, the instrument is wrong
#    and int4's fit means nothing. Do not read entry 3 until entry 2 checks out.
#
# 3) THEN ENTRY 3. int4's slope against int8's is the whole round:
#      about HALF   -> int4 really is 2x per byte, and step 2 should target int4
#                      rather than int8. On a 1B model that is 16.7 tok/s
#                      against int8's 8.4, and the board's CPU does 5.53.
#      about EQUAL  -> the parking stands, and this time it is measured.
#      in between   -> report the number, do not round it to a story.
#
# 4) ENTRY 4 is correctness at the N values the guard used to refuse. A timing
#    for a shape that computes the wrong answer is not a timing of anything.
#    Read `wrote`, not `exact`: a half width job that is CORRECT is a different
#    thing from a broken layout, and only `wrote` separates them.
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT
# ---------------------------------------------------------------------------
#
# **int4's SLOPE IS ABOUT HALF int8's, AND ITS INTERCEPT IS HIGHER.** That is
# the reading of 306's single point that nobody tested. If instead the slopes
# match and the intercepts match, 306 was right for the right reason and int4
# is closed properly.
#
# I also expect entry 5's chaining probe to still hang. It goes LAST for that
# reason: a wedged block voids everything after it, and everything above it is
# the round.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
MM=/opt/charsiu/charsiu_matmul
BE=/opt/charsiu/charsiu_bench
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

c() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $*"; return 0; }
	before=$(nbad)
	sleep 1
	env $1 $2 $3 $4 $5 $6 $7 $8 $9 > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This arm is VOID."; health; }
	return 0
}

M4="CHARSIU_W4=1 CHARSIU_W4_HALFK=1"

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	if [ -w /sys/module/rocket/parameters/reset_autosuspend ]; then
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend
		log "reset_autosuspend = $(cat /sys/module/rocket/parameters/reset_autosuspend)"
	else
		log "!! reset_autosuspend NOT WRITABLE. A timeout will kill the round."
	fi

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "##### ROUND 310: a marginal for int4, from single task runs.       #####"

	log ""
	log "===== 2) THE CONTROL. int8 --nsweep. must give ~97 us/MB, ~170 us. ====="
	c X=1 X=1 $BE --nsweep 2048 50

	log ""
	log "===== 3) THE ROUND. int4 --nsweep. slope against int8's.           ====="
	c "CHARSIU_W4=1" X=1 $BE --nsweep 2048 50

	log ""
	log "===== 4) correctness where the guard used to refuse. read wrote.   ====="
	for NN in 256 512 1024 2048
	do
		log ""
		log "===== int4  K = 2048  N = $NN     N/2 would be $((NN / 2))"
		c "$M4" X=1 $MM 1 2048 $NN
	done

	log ""
	log "===== the anchor again, before anything is allowed to hang         ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== 5) LAST, BECAUSE IT IS EXPECTED TO WEDGE: int4 chained.      ====="
	log "=====    two tasks at N = 256, which is where 306 died.            ====="
	c "CHARSIU_W4=1" X=1 $BE 1 2048 256 20

	log ""
	log "===== control first, then the two slopes. Nothing else decides it. ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
