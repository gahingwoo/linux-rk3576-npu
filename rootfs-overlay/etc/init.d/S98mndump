# ---------------------------------------------------------------------------
# 2026-08-22 round 328. A MEAN CANNOT TELL SLOW FROM STALLING.
#
# ⚠ TWO INSTRUMENTS WERE WRONG IN ROUND 327 AND BOTH WERE MINE.
#
# 1) THE STAGE TABLE WAS 86% PROMPT. It printed "38 tokens, 948.6 ms a token"
#    on a run whose generation was 152.7 ms a token, because the six prompt
#    tokens fault 1.3 GB of weights in off the card and build the NPU tensors,
#    and that 31 seconds got divided across every stage. ⚠ The host check I
#    built it against had exactly the same defect -- it said 90.5 ms a token
#    where the decode was 29 -- and I quoted it in the round header anyway.
#    Fixed: the timers reset after the prompt. The host now prints 27.4 ms a
#    token against a wall clock of 27.7, which is the check that was missing.
#
# 2) THE BENCH TIMED THE WHOLE LOOP AND DIVIDED BY THE REPS. That number
#    cannot tell "every rep takes 5 ms" from "one rep in twenty takes 100 ms
#    and the other nineteen take 200 us", and those are completely different
#    faults. ⚠ int4's collapse above 512 KiB has been read as a BANDWIDTH for
#    three rounds on exactly that number, and the same arm has come back at
#    4.9, 8.0, 9.2, 14.5 and 17.7 ms across five runs -- a spread that a rate
#    does not have and a count of stalls does. Fixed: every rep is timed, and
#    each point prints min, median, max and how many reps ran over twice the
#    median. The fit is on the MEDIANS now.
#
# ⚠ AND THE DENOMINATOR MOVED TOO. int8 at K=512 fitted 9.45 GB/s in round 326
# and 5.55 in round 327, same shape, same board. So round 326's headline "int4
# moves a byte 6.2x slower than int8" is quoted from a pair of numbers that are
# not reproducible to better than 40%, and it needs re-measuring before it is
# repeated. That is what entry 4 is for.
#
# ---------------------------------------------------------------------------
# WHAT IS STILL SOLID, AND WHY int4 IS STILL OPEN
# ---------------------------------------------------------------------------
#
# The vendor's own .rkllm is the SAME MODEL and its int4 ops run at 1 MiB and
# 2 MiB of weights -- exactly where charsiu collapses and four times past it.
# So the 512 KiB ceiling is charsiu's. And the CNA half of the vendor's stream
# at that shape agrees with charsiu's on 44 of 44 registers once the two
# address placeholders are set aside, with only 0x100c bit 29 (the vendor uses
# EIGHT bit activations for int4) and 0x1098 left over.
#
# Round 327 tried both and every arm landed inside the noise of the arm it was
# being compared with. ⚠ That is not a negative yet, because the noise is the
# thing being fixed this round.
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS, WRITTEN BEFORE THE RUN
# ---------------------------------------------------------------------------
#
# A) ENTRY 3, THE COLUMN THAT DECIDES IT: "reps > 2x median" at N=1024, K=2048.
#
#      0 of 50, median ~9000 us   int4 really is slow. A rate.
#      a few of 50, median ~250   int4 STALLS, and everything since round 310
#                                 has been measuring how often, not how fast.
#
#    Those two want completely different next rounds, and no mean can separate
#    them, which is the whole reason this round exists.
# B) ENTRY 4 RE-MEASURES THE DENOMINATOR at 50 reps with a median, twice in the
#    same boot. If int8 at K=512 is stable now, 326's 6.2x can be restated
#    honestly; if it still swings 40%, no ratio from this bench is quotable.
# C) ENTRY 2 IS THE STAGE SPLIT, now that the instrument agrees with the wall
#    clock. Add the five matmul stages and compare with npudev's hardware path:
#    the difference is the quantise and dequantise, and everything else is the
#    elementwise.
#
# ---------------------------------------------------------------------------
# WHAT I EXPECT
# ---------------------------------------------------------------------------
#
# int4 STALLS rather than being slow, because a 3.5x spread across five runs of
# the same arm is not what a bandwidth does. ⚠ I have been wrong about int4
# three times now -- the wrapping stride, the dead bytes, and a count for the
# cliff -- so this is written down to be killed, and entry 3 kills it in one
# column.
# ---------------------------------------------------------------------------
NPU_DIR=/opt/npu-test
C=/dev/console
WORK=/usr/lib/libteflon-working.so
RUN=/opt/charsiu/charsiu_run
BE=/opt/charsiu/charsiu_bench
M8=/opt/charsiu/models/Llama-3.2-1B-Instruct-Q8_0.gguf
PROMPT="The capital of France is"
LIMIT=420
ARMCAP=240
CE=CHARSIU_COEF_ELEMS=65536
HEAD=CHARSIU_NPU_MAXN=131072
B8="CHARSIU_OVERRIDE=0x40b8=3"
ABORT=0
log() { echo "$@" > "$C"; }
nbad() { dmesg 2>/dev/null | grep -c "MMU_DTE_ADDR\|job timed out"; }

health() {
	python3 "$NPU_DIR/perch.py" "$NPU_DIR/conv2d-cal.tflite" > /tmp/hc.txt 2>&1
	if grep -q "128/128 channels match" /tmp/hc.txt; then
		log "  !! health OK, the block recovered, continuing"
	else
		log "  !! health FAILED, the block is gone. ABORTING the round."
		ABORT=1
	fi
}

w() {
	[ "$ABORT" = "1" ] && return 0
	before=$(nbad)
	log ""
	log "  -- $1   $2"
	sleep 1
	env TEFLON_LIB=$WORK MESA_LOG_LEVEL=info $2 \
		python3 "$NPU_DIR/perch.py" "$NPU_DIR/$1" > "$C" 2>&1
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This entry is VOID."; health; }
	return 0
}

capped() {
	lim="$1"; shift
	"$@" &
	pid=$!
	i=0
	while [ "$i" -lt "$lim" ]; do
		kill -0 "$pid" 2>/dev/null || { wait "$pid"; return $?; }
		sleep 1
		i=$((i + 1))
	done
	kill -9 "$pid" 2>/dev/null
	wait "$pid" 2>/dev/null
	return 124
}

c() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $*"; return 0; }
	before=$(nbad)
	sleep 1
	capped "$ARMCAP" env $1 $2 $3 $4 $5 $6 $7 $8 $9 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the arm exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This arm is VOID."; health; }
	return 0
}

rung() {
	[ "$ABORT" = "1" ] && { log "  -- SKIPPED (round aborted): $1"; return 0; }
	lbl="$1"; shift
	before=$(nbad)
	log ""
	log "  -- $lbl"
	sleep 1
	capped "$LIMIT" env "$@" "$RUN" "$M8" -p "$PROMPT" -n 32 \
		--ignore-eos -q -c 512 -t 4 > "$C" 2>&1
	rc=$?
	[ "$rc" != "0" ] && log "  !! the rung exited $rc (124 is the wall clock limit)"
	[ "$(nbad)" != "$before" ] && { log "  !! POISON. This rung is VOID."; health; }
	return 0
}

start() {
	i=0
	while [ ! -c /dev/accel/accel0 ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
	[ -c /dev/accel/accel0 ] || { log "no accel device"; return 0; }
	dmesg -n 4 2>/dev/null
	[ -w /sys/module/rocket/parameters/reset_autosuspend ] && \
		echo 1 > /sys/module/rocket/parameters/reset_autosuspend

	log ""
	log "===== 0) the limit's own control. expect rc 124 after ~3s.         ====="
	t0=$(cut -d. -f1 /proc/uptime)
	capped 3 sleep 60
	rc=$?
	t1=$(cut -d. -f1 /proc/uptime)
	log "  -- capped 3 sleep 60  ->  rc $rc after $((t1 - t0))s"
	[ "$rc" = "124" ] || log "  !! THE LIMIT DID NOT FIRE. Nothing below can be trusted to end."

	log ""
	log "===== 1) the anchor                                                ====="
	w conv2d-cal.tflite ""

	log ""
	log "##### ROUND 328: a mean cannot tell slow from stalling.           #####"

	log ""
	log "===== 2) THE MEASUREMENT. every stage of the forward pass, NPU on. ====="
	log "=====    matmul stages minus the hardware path = the quantise.     ====="
	rung "the decode loop on the NPU, stages on" \
		CHARSIU_STAGES=1 CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 "$CE" "$HEAD"

	log ""
	log "===== 2b) the same stages with the NPU off, one boot apart.        ====="
	rung "the CPU path, stages on" CHARSIU_STAGES=1 CHARSIU_NPU_QUANT=1

	log ""
	log "===== 3) int4's collapse: EVERY rep, or a few? read the last      ====="
	log "=====    column. 0 of 50 slow means a rate; a few means a stall.   ====="
	log "===== 3a today, K=2048"
	c "CHARSIU_W4=1" "$CE" $BE --nsweep 2048 50
	log "===== 3b the vendor's two registers, 8 bit activations and 1098=1"
	c "CHARSIU_W4=1" "CHARSIU_OVERRIDE=0x100c=0x00600120" "CHARSIU_CNA_1098=1" "$CE" $BE --nsweep 2048 50
	log "===== 3c the live map, 0x40b8 = 3"
	c "CHARSIU_W4=1" "$B8" "$CE" $BE --nsweep 2048 50

	log ""
	log "===== 4) the denominator, twice in one boot, on medians.           ====="
	log "=====    326 fitted int8 K=512 at 9.45 GB/s and 327 at 5.55.       ====="
	c "$CE" $BE --nsweep 512 50
	c "$CE" $BE --nsweep 512 50
	c "$CE" $BE --nsweep 2048 50
	log "=====    and int4 at K=512, where there is no cliff in the row     ====="
	c "CHARSIU_W4=1" "$CE" $BE --nsweep 512 50
	c "CHARSIU_W4=1" "CHARSIU_OVERRIDE=0x100c=0x00600120" "CHARSIU_CNA_1098=1" "$CE" $BE --nsweep 512 50

	log ""
	log "===== 5) the standing number, no timers, so they cannot be blamed  ====="
	rung "the decode loop on the NPU" CHARSIU_NPU_QUANT=1 CHARSIU_NPU=1 "$CE" "$HEAD"

	log ""
	log "===== the anchor again                                             ====="
	w conv2d-cal.tflite ""

	log ""
	log "===== the last column of entry 3 is the round.                     ====="
	sync
}
case "$1" in
	start) start ;;
	stop|restart) : ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
