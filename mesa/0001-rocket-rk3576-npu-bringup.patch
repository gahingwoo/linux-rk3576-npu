+   /*
+    * RK3576 pointwise (1x1) weight layout, captured from the board's working
+    * weight buffer with a position-encoded pointwise conv: a plain oc-major,
+    * ic-contiguous buffer
+    *
+    *   buf[oc*IC + ic] = w[oc][ic] - 0x80
