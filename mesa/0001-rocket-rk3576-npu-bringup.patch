+ *
+ * The RK3576 NPU uses a register layout that differs from the RK3588-derived map
+ * the rest of this driver emits: it has registers RK3588 lacks and the field
+ * packing at shared offsets differs. Established on hardware by sweeping one conv
+ * parameter at a time and observing which register tracks it.
+ *
+ * This emits the exact register sequence the board's working stream uses for the
+ * 224x224x3 -> 112x112x32 first convolution (the in_ch<=4 "ARGB-packed" datapath),
+ * with the five DMA-address fields patched to this run's tensor allocations:
+ *   0x1088 input feature, 0x1110 weights, 0x4018 output, 0x5020/0x5024 bias.
+ * Geometry/const/quant words are the board's known-good values for this shape.
+ * Purpose: validate the RK3576 offset map + arming + addressing end-to-end.
+ */
+static void
+fill_first_regcmd_rk3576_firstconv(struct rkt_ml_subgraph *subgraph,
+                                   const struct rkt_operation *operation,
+                                   struct util_dynarray *regs, unsigned task_num)
+{
+   struct split_task *task =
+      util_dynarray_element(&operation->tasks, struct split_task, task_num);
+
+   uint32_t feature_addr =
+      rkt_get_tensor(subgraph, operation->input_index)->phys_addr +
+      task->input_offset;
+   uint32_t weight_addr = rkt_resource(operation->weights)->phys_addr;
+   uint32_t output_addr =
+      rkt_get_tensor(subgraph, operation->output_index)->phys_addr +
+      task->output_offset;
+   uint32_t bias_addr = rkt_resource(operation->biases)->phys_addr;
+
+#define R_CNA(reg, val)  emit_raw(regs, 0x201, (reg), (val))
+#define R_CORE(reg, val) emit_raw(regs, 0x801, (reg), (val))
+#define R_DPU(reg, val)  emit_raw(regs, 0x1001, (reg), (val))
+#define R_RDMA(reg, val) emit_raw(regs, 0x2001, (reg), (val))
+
+   /* S_POINTER arming for all four units (POINTER=0, PP enabled). */
+   /* S_POINTER per task. 0x0e = ping-pong ON (producer/executer auto-alternate group
+    * each task) -> on the multi-task graph they desync and the geometry lands in a group
+    * the executer never reads -> tasks after the first run on h=0/w=0 (zero output). The
+    * vendor pins group 0 every task. ROCKET_SPTR overrides (0x00 = no PP, group 0 fixed). */
+   uint32_t sptr = rkt_env_u32("ROCKET_SPTR", 0x0000000e);
+   R_CNA(0x1004, sptr);
+   R_CORE(0x3004, sptr);
+   R_CNA(0x1038, 0x00000007);
+   R_DPU(0x4004, sptr);
+   R_RDMA(0x5004, sptr);
+
+   /* CNA config block. */
+   R_CNA(0x100c, 0x2000a006);
+   R_CNA(0x1010, 0x00000fff);
+   R_CNA(0x1014, 0x00000012);   /* stride (2,2) */
+   R_CNA(0x1018, 0x40000404);
+   R_CNA(0x101c, 0x00000600);
+   R_CNA(0x1020, 0x00000030);
+   R_CNA(0x1024, 0x0202001f);   /* out_ch-1 = 31 */
+   R_CNA(0x1028, 0x0d20000b);
+   /*
+    * The input width the CNA is told about, which is no longer the tensor's.
+    * rkt_fc_width() widens it so the last window reads real bytes instead of
+    * the hardware's broken right pad; the five registers below are the ones
+    * that carry it. Each matches its captured literal exactly when the width
+    * is left narrow, which is how they were identified:
+    *
+    *   0x102c  (w-1, in_h-1)       0x00df00df at 224
+    *   0x1044  (w, blocks)         0x00e0000f, and the low field is 15 for
+    *                               both widths, so it is left alone
+    *   0x1078  (stride_units-1, in_h-1)   0x002900df, 42-1
+    *   0x1090  stride in 16 byte units    0x2a, 224*3/16
+    *   0x1094  and 0x1098  that times in_h  0x24c0
+    *   0x118c  (w/16, that-1)      0x000e000d, 224/16
+    *
+    * 0x1080 is deliberately NOT touched. The trailing pad is still requested;
+    * it simply stops being reached on the width axis once the real image
+    * covers the last window.
+    */
+   unsigned fc_w = rkt_fc_width(operation->input_width);
+   unsigned fc_h = operation->input_height;
+   unsigned fc_units = fc_w * 3 / FEATURE_ATOMIC_SIZE;
+   R_CNA(0x102c, ((fc_w - 1) << 16) | (fc_h - 1));
+   R_CNA(0x1030, 0x0060006f);   /* out_w-1 = 111 */
+   R_CNA(0x1034, 0x000030ff);   /* out_w*out_h-1 = 12543 */
+   R_CNA(0x1038, 0x00000007);
+   R_CNA(0x103c, 0x000f0000);
+   R_CNA(0x1040, 0x10000000);   /* CBUF_CON0 — matches the vendor runtime capture */
+   R_CNA(0x1044, (fc_w << 16) | 0x0f);
+   R_CNA(0x1048, 0x000e38e0);
+   R_CNA(0x104c, 0x40004000);   /* CVT (quant) */
+   R_CNA(0x1050, 0x00014000);
+   /*
+    * The three per-lane CVT values, one per ARGB colour lane. The generic path
+    * writes zero in all three and bypasses the CVT; this path enables it and
+    * writes -128 in each.
+    *
+    * -128 is what a raw byte of 0 becomes once 0x80 is subtracted, so as a
+    * DATA offset these say "the input's zero point is 0", which is true of the
+    * image tensor the capture came from and false of MobileNet's conv0, whose
+    * input zero point is 128. They are literals and nothing derives them.
+    *
+    * Round 95 measured that 0x1084 is not what makes the last output column
+    * wrong: every pad byte from 0x00 to 0x80 leaves colN at the same 2122
+    * pixels off by more than one, while the last ROW responds to it exactly as
+    * a pad value should and is best at the value already written. So the row
+    * padding is correct and the column padding is being fed from somewhere
+    * else, and these three are the only other CNA registers this path writes
+    * that the generic path does not.
+    *
+    * ROCKET_FC_LANE_OFF writes all three. If the surface INTERIOR breaks with
+    * it, they are data offsets and this is closed; if only the last column
+    * moves, they are the width-axis pad.
+    */
+   {
+      uint32_t lane = rkt_env_u32("ROCKET_FC_LANE_OFF", 0xffffff80);
+      R_CNA(0x1054, lane);
+      R_CNA(0x1058, lane);
+      R_CNA(0x105c, lane);
+   }
+   /*
+    * The fourth ARGB lane's CVT value. The three colour lanes above hold -128
+    * and this one holds zero, which is why it is a candidate for the right
+    * edge: round 96 measured that the last output column is fed a raw byte of
+    * zero BEFORE the lane values are applied, so whatever supplies it is not
+    * 0x1084, and this is the only neighbouring register left holding a value
+    * the three lanes do not. ROCKET_FC_1060 sweeps it.
+    */
+   R_CNA(0x1060, rkt_env_u32("ROCKET_FC_1060", 0x00000000));
+   /*
+    * FC_CON1 (0x1064) = 0x777, matching the vendor RUNTIME conv0 regcmd (captured
+    * live via the instrumented rknpu, real IOMMU addresses present). An earlier
+    * change zeroed this from a TEMPLATE capture and blamed 0x777 for the +-constant
+    * output, but a register-by-register diff against the live vendor stream shows
+    * 0x777 is the real value: with FC_CON1=0 the CMAC never produces a MAC result
+    * (output stays the bias rail). On RK3576 this DATA_OFFSET is part of the ARGB
+    * first-conv feature addressing, not a bug.
+    */
+   R_CNA(0x1064, 0x00000777);
+   R_CNA(0x1068, 0x00000000);
+   R_CNA(0x106c, 0x00000000);
+   R_CNA(0x1070, 0x00000000);
+   R_CNA(0x1074, 0x00000000);
+   R_CNA(0x1078, rkt_env_u32("ROCKET_FC_1078",
+                             ((fc_units - 1) << 16) | (fc_h - 1)));
+   R_CNA(0x107c, 0x00000002);
+   /*
+    * The PADDING register, derived rather than hardcoded.
+    *
+    * 0x00000101 is pad_left = 1 and pad_top = 1, which is symmetric padding of
+    * one on every side. That is what a torch conv with padding=1 asks for, and
+    * it is what the capture this function was written from contained. tflite
+    * SAME padding on MobileNet's conv0 is NOT symmetric: 224 to 112 at stride 2
+    * with a 3x3 kernel needs one pad in total, so pad_top and pad_left are 0
+    * and pad_bottom and pad_right are 1, which is 0x01010000, the opposite
+    * corner.
+    *
+    * Measured: an impulse first conv, one live tap per output channel, decodes
+    * on hardware to exactly the input shifted one pixel UP AND LEFT of where
+    * the CPU puts it, on all 32 channels at correlation 1.000. Every value is
+    * then wrong and no requant can rescue it, which is what the sweep in round
+    * 80 found.
+    *
+    * The generic path has derived this since the round that found CNA 0x1080
+    * was a padding register at all; the first conv kept the literal.
+    * ROCKET_FC_PAD forces a value, and 0x00000101 restores the old one.
+    */
+   R_CNA(0x1080, rkt_env_u32("ROCKET_FC_PAD",
+                             (task->pad_right << 24) | (task->pad_bottom << 16) |
+                             (task->pad_left << 8) | task->pad_top));
+   /*
+    * The PAD VALUE, derived rather than hardcoded, for the same reason 0x1080
+    * above is.
+    *
+    * A padded tap must contribute nothing, which means it has to read as the
+    * input zero point. The CMAC sees the input with 0x80 subtracted, so the
+    * byte to write is in_zp - 0x80, replicated across the three input lanes.
+    * 0x00808080 is that byte for an input whose zero point is 0, which is what
+    * a plain image tensor has and what the capture this function came from
+    * used. MobileNet's conv0 has zero point 128 and wants 0x00000000.
+    *
+    * The generic path already carries this fix, and its comment records the
+    * symptom: the output border ring is wrong, everything inside it is right.
+    * That is exactly what conv0 shows. Its impulse decodes to the right plane
+    * and tap at correlation 1.000 on a 32x32 interior crop, while an affine
+    * fit over the whole 112x112 surface only reaches 0.89.
+    *
+    * ROCKET_FC_PAD_VAL forces a value, and 0x00808080 restores the literal.
+    */
+   {
+      uint32_t pv = (uint32_t)(((int32_t)task->input_zero_point - 0x80) & 0xff);
+      R_CNA(0x1084, rkt_env_u32("ROCKET_FC_PAD_VAL",
+                                (pv << 16) | (pv << 8) | pv));
+   }
+   R_CNA(0x1088, feature_addr); /* input feature base addr */
+   R_CNA(0x108c, 0x000f000f);
+   R_CNA(0x1090, fc_units);
+   R_CNA(0x1094, fc_units * fc_h);
+   R_CNA(0x1098, fc_units * fc_h);
+   R_CNA(0x109c, 0x00000000);
+   R_CNA(0x1100, 0x00000000);
+   R_CNA(0x1104, 0x00000000);
+   R_CNA(0x1110, weight_addr);  /* weights base addr (DCOMP_ADDR0) */
+   R_CNA(0x1140, 0x00000000);
+   R_CNA(0x1144, 0x00000000);
+   R_CNA(0x118c, rkt_env_u32("ROCKET_FC_118C",
+                             ((fc_w / 16) << 16) | (fc_w / 16 - 1)));
+
+   /* CORE. */
+   R_CORE(0x3018, 0x10000081); /* MISC/MAC cfg (first-conv in_ch=3) */
+   R_CORE(0x301c, 0x006f006f); /* (out_h-1, out_w-1) */
+   R_CORE(0x3020, 0x0000001f); /* out_ch-1 */
+   R_CORE(0x3024, 0x00000000);
+
+   /* DPU. */
+   R_DPU(0x400c, 0x40000004);
+   R_DPU(0x4010, 0x00000000);
+   R_DPU(0x4014, 0x00000000);
+   R_DPU(0x4018, output_addr); /* output (DST) base addr */
+   R_DPU(0x401c, 0x00003100); /* out_w*out_h */
+   R_DPU(0x4020, 0x0000006f); /* out_w-1 */
+   R_DPU(0x4024, 0x0000006f); /* out_h-1 */
+   R_DPU(0x4028, 0x00000000);
+   R_DPU(0x402c, 0x0000001f); /* out_ch-1 */
+   R_DPU(0x4030, 0x001f0710);
+   R_DPU(0x4034, 0x006f006f); /* (out_h-1, out_w-1) */
+   R_DPU(0x4038, 0x00120080);
+   R_DPU(0x403c, 0x00000000);
+   R_DPU(0x4044, 0x00000001);
+   R_DPU(0x4048, 0x80000000);
+   R_DPU(0x404c, 0x7fffffff);
+   R_DPU(0x4050, 0x80011111);
+   R_DPU(0x4058, 0x80000000);
+   R_DPU(0x405c, 0x7fffffff);
+   R_DPU(0x4060, 0x00000903);
+   R_DPU(0x406c, 0x80000000);
+   R_DPU(0x4070, 0x7fffffff);
+   R_DPU(0x4074, 0x80000000);
+   R_DPU(0x4078, 0x7fffffff);
+   R_DPU(0x407c, 0x010041c1);
+   R_DPU(0x4080, 0x00000000);
+   R_DPU(0x4084, 0x00000001);
+   R_DPU(0x4088, 0x80000000);
+   R_DPU(0x408c, 0x7fffffff);
+   R_DPU(0x4090, 0x00000000);
+   R_DPU(0x4094, 0x00000000);
+   R_DPU(0x409c, 0x00000000);
+   R_DPU(0x40a4, 0x80000000);
+   R_DPU(0x40a8, 0x7fffffff);
+   /*
+    * OUT_CVT requant for the first conv: the generic computation with the
+    * shift four larger.
+    *
+    * The literals here were offset -2, scale 0x5391 and shift 25, and the
+    * comment that stood above them said computing them instead gives offset
+    * -128, scale 0x76be and shift 22, "which is wrong for conv0". Two thirds
+    * of that is now measured to be backwards.
+    *
+    * With an impulse first conv, whose output decodes to exactly the right
+    * input plane and tap on all 32 channels, the map from the hardware's
+    * surface to the reference is affine and the same for every channel. Fitted
+    * over unclipped pixels only:
+    *
+    *   shift 25   a 0.7096   b  -89.34     b/a = -125.90
+    *   shift 26   a 1.4197   b -178.84     b/a = -125.97
+    *   shift 27   a 2.8369   b -357.38     b/a = -125.98
+    *   shift 28   a 5.6522   b -711.90     b/a = -125.95
+    *
+    * correlation 0.9999, and a doubles with every halving of the multiplier,
+    * so a IS the ratio between the multiplier written and the one wanted, and
+    * it survived being halved three times.
+    *
+    * Two things fall out of it. The multiplier wanted is 0.000452413, and
+    * in_sc * wt_sc / out_sc is 0.007247427, a ratio of 16.02: the generic
+    * value with FOUR more bits of shift. And b/a is a constant -126 at every
+    * shift, which is the hardware adding 126, which is exactly the gap between
+    * the offset written here, -2, and the generic out_zp - 0x80, -128.
+    *
+    * So the old comment had the offset and the scale right and the shift short
+    * by four, and reading the three together as "the captured values" is what
+    * kept conv0 broken. The 16 is presumably the CNA CVT this path enables,
+    * 0x104c = 0x4000 against the generic path's bypass, leaving the
+    * accumulator four bits hot.
+    *
+    * ROCKET_FC_OFFSET, ROCKET_FC_SCALE and ROCKET_FC_SHIFT still override, so
+    * the old triple can be put back as a control.
+    */
+   {
+      float conv_scale =
+         (task->input_scale * task->weights_scale) / task->output_scale;
+      uint32_t sb = fui(conv_scale);
+      /* The generic path computes this then emits shift - 1; keep both. */
+      unsigned fc_shift = 127 + 31 - 32 - (sb >> 23) + 16 - 1 + 4;
+      unsigned fc_scale = ((sb >> 9) & 0x7fff) + rkt_cvt_round(sb);
+      if (fc_scale > 0x7fff) {
+         fc_scale = 1 << 14;
+         fc_shift--;
+      }
+      if (fc_scale < (1 << 14))
+         fc_scale |= (1 << 14);
+      int32_t fc_off = (int32_t)task->output_zero_point - 0x80;
+
+      /*
+       * ROCKET_FC_CVT_DOWN, the same trade the generic path makes.
+       *
+       * The OUT_CVT computes (accumulator * cvt_scale) >> shift in signed
+       * int32. conv0's accumulator reaches 27 * 128 * 151, which is 2^19, and
+       * cvt_scale is 0x76be, 2^14.9, so the product is 2^33.9 and wraps for
+       * every accumulator above 70646. Scaling the multiplier down by T bits
+       * and the shift by T is arithmetically identical and keeps the product
+       * in range.
+       *
+       * Measured: conv0 is 99.5 percent of pixels exact with a tail off by
+       * more than 8, and only 8 percent of the failures sit at an output rail,
+       * so the tail is not clipping. A wrap on the largest accumulators is the
+       * right size and the right shape for it.
+       *
+       * The generic path's ROCKET_CVT_DOWN does NOT reach here: it lives in
+       * the generic emitter and this is fill_regcmd_firstconv. Round 88 swept
+       * it against conv0 and measured nothing, twice over, because 2 would not
+       * have been enough either.
+       */
+      unsigned fc_down = rkt_env_u32("ROCKET_FC_CVT_DOWN", 0);
+      if (fc_down > fc_shift)
+         fc_down = fc_shift;
+      fc_scale >>= fc_down;
+      fc_shift -= fc_down;
+
+      R_DPU(0x40ac, rkt_env_u32("ROCKET_FC_OFFSET", (uint32_t)fc_off));
+      R_DPU(0x40b0, rkt_env_u32("ROCKET_FC_SCALE", fc_scale));
+      R_DPU(0x40b4, rkt_env_u32("ROCKET_FC_SHIFT", fc_shift));
+   }
+   R_DPU(0x40b8, 0x00003100); /* out_w*out_h */
+   R_DPU(0x40bc, 0x00000000);
+   R_DPU(0x40c0, 0x04440100);
+   R_DPU(0x40c8, 0x00000000);
+   R_DPU(0x40cc, 0x00000000);
+   R_DPU(0x40d0, 0x0040ffff);
+   for (uint32_t r = 0x4100; r <= 0x4120; r += 4)
+      R_DPU(r, 0x00000000);
+   R_DPU(0x4130, 0x00000000);
+   for (uint32_t r = 0x4140; r <= 0x4154; r += 4)
+      R_DPU(r, 0x00000000);
+   R_DPU(0x4160, 0x00000000);
+   R_DPU(0x4170, 0x00000000);
+   R_DPU(0x4174, 0x00000000);
+   R_DPU(0x4184, 0x00000000);
+   R_DPU(0x4188, 0x00000000);
+   R_DPU(0x418c, 0x00000000);
+   R_DPU(0x4190, 0x00000000);
+   R_DPU(0x4194, 0x00000000);
+
+   /* DPU_RDMA. */
+   R_RDMA(0x500c, 0x0000006f); /* out_w-1 */
+   R_RDMA(0x5010, 0x0000006f); /* out_h-1 */
+   R_RDMA(0x5014, 0x0000001f); /* out_ch-1 */
+   R_RDMA(0x5018, 0x00000000);
+   R_RDMA(0x501c, 0x00000710);
+   R_RDMA(0x5020, bias_addr);          /* bias (BS) base addr */
+   R_RDMA(0x5024, bias_addr + 0x100);  /* bias second buffer (+0x100 per board) */
+   R_RDMA(0x5028, 0x00000000);
+   R_RDMA(0x502c, 0x00000000);
+   R_RDMA(0x5030, 0x00000000);
+   R_RDMA(0x5034, 0x00000041);
+   R_RDMA(0x5038, 0x00000000);
+   R_RDMA(0x5040, 0x00000000);
+   R_RDMA(0x5044, 0x40000010);
+   R_RDMA(0x5048, 0x00000000);
+   R_RDMA(0x504c, 0x00000000);
+   R_RDMA(0x5064, 0x00000000);
+   R_RDMA(0x506c, 0x00000000);
+   R_RDMA(0x5078, 0x00000000);
+   R_RDMA(0x507c, 0x00000000);
+
+   /* ROCKET_NEXTPTR: RK3588-style next-pointer trailer (see fill_regcmd_rk3576_normal)
+    * before the op_en, so conv0 (task 0) chains to task 1. Packer fills the values. */
+   if (getenv("ROCKET_NEXTPTR")) {
+      EMIT(REG_PC_BASE_ADDRESS, 0);
+      EMIT(REG_PC_REGISTER_AMOUNTS, 0);
+   }
+
+   /* Broadcast op_en (target 0x81): start all units. Kernel also pulses PC_OP_EN. */
+   emit_raw(regs, 0x81, REG_PC_OPERATION_ENABLE, 0x1d);
+
+#undef R_CNA
+#undef R_CORE
+#undef R_DPU
+#undef R_RDMA
+}
+
+/*
+ * RK3576 general convolution encoder (Phase 2) for the in_ch>4 normal and
+ * depthwise datapaths (MobileNet's pointwise + depthwise layers).
+ *
+ * Geometry/channel/CBUF register formulas were established on hardware by
+ * sweeping one conv parameter at a time and observing which register tracks it;
+ * they reproduce the board's working register stream exactly for every shape
+ * tested. Quantisation (CNA CVT bypass + DPU OUT_CVT scale/shift/offset) uses
+ * the driver's own requant math placed at the RK3576 offsets; the five DMA
+ * addresses are patched to this run's tensors.
+ */
+static void
+fill_regcmd_rk3576_normal(struct rkt_ml_subgraph *subgraph,
+                          const struct rkt_operation *operation,
+                          struct util_dynarray *regs, unsigned task_num)
+{
+   struct split_task *task =
+      util_dynarray_element(&operation->tasks, struct split_task, task_num);
+
+   unsigned inw = task->input_width;
+   unsigned ow = task->output_width;
+   unsigned k = task->weights_width;
+   unsigned s = task->stride_x;
+   /*
+    * The RK3576 register stream uses the REAL channel counts, not fill_task's
+    * CBUF-aligned ones (which double the depthwise channels and round others up
+    * to 32). Using the aligned values emits e.g. out_ch-1 = 63 instead of 31 for
+    * a 32-channel depthwise layer.
+    */
+   unsigned ic = task->input_channels_real;
+   unsigned oc = task->output_channels_real;
+   /*
+    * ROCKET_OC_OUT_ADD: what the OUTPUT side is told the channel count is.
+    *
+    * With the depthwise weight buffer laid out in groups of 64, a 1024 channel
+    * layer computes 992 of its 1024 channels and the last 32 come out
+    * constant. The dead tail does not move when the weight group size changes
+    * from 32 to 64 to 128, and it does not move when the coefficient table
+    * grows, so neither buffer owns it, and 992 is 1023 with its low five bits
+    * cleared. That is the shape of a channel count the output side rounds DOWN
+    * to a multiple of 32.
+    *
+    * This adds to the value written into the four registers that carry the
+    * output channel count, and nothing else, so a sweep says whether the tail
+    * is an off-by-a-group there or somewhere that does not take a count at
+    * all.
+    */
+   bool dw = operation->depthwise;
+
+   /*
+    * The 112-wide in_ch>4 layers are dispatched as multiple row-window tasks
+    * (see rkt_split_tasks): each task produces win_orows output rows from
+    * win_irows staged input rows. A non-windowed layer is a single task whose
+    * window equals the full layer.
+    */
+   unsigned full_inh = operation->input_height;
+   unsigned full_oh = operation->output_height;
+   unsigned win_orows = task->output_height;   /* this window's output rows */
+   unsigned win_irows = task->input_height;     /* rows this window SPANS */
+   /*
+    * Rows this task actually STAGES. A window overlaps the one before it, and
+    * those rows are already in the CBUF, reachable through the reuse base at
+    * 0x103c. The vendor's capture of a 112x112 stride-1 depthwise writes both
+    * numbers for its second window: 0x102c carries 23, the span, while 0x1028,
+    * 0x1078 and 0x1098 carry 21, the rows brought in. Writing the span to all
+    * four stages the overlap twice, so every row after it sits two rows late
+    * and the window convolves shifted input.
+    */
+   unsigned stg_irows = task->staged_rows ? task->staged_rows : win_irows;
