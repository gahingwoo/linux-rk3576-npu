+    * IC*OC bytes total (= the 0x101c weight-DMA count), no atomic padding or
+    * interleave. The generic RK3588 packing below writes oc*ALIGN(ic,32)*2 in a
+    * different order, which the CMAC can't consume on a 1x1 layer.
+    */
+   if (is_rk3576_pointwise) {
+      unsigned ic_n = input_channels_real;
+      unsigned oc_n = output_channels_real;
+
+      /*
+       * The vendor's 1x1 weight buffer is 32x32 tiles, tiled in BOTH axes:
+       *
+       *   [oc/32][ic/32][oc%32][ic%32]
+       *
+       * with the tile edges cut short rather than padded when a channel count
+       * is not a multiple of 32.
+       *
+       * Read off the vendor's own compiler with two position encoded 1x1
+       * models of the same shape, one whose weight depends only on the output
+       * channel and one only on the input channel. A byte in the blob then
+       * names its output channel in the first and its input channel in the
+       * second, which lifts the 255 distinct values limit that had kept every
+       * earlier reading of this at 32 output channels or fewer. Confirmed at
+       * 64 by 64, and at 48 by 40 for the cut tiles.
+       *
+       * That limit is the whole story of the two wrong layouts before this
+       * one. All three agree whenever oc or ic is 32 or less, which is every
+       * shape this had ever been checked at:
+       *
+       *   flat [oc][ic]           3968 of 4096 bytes wrong at 64 by 64
+       *   [ic/32][oc][ic%32]      2048 of 4096 wrong, exactly the half with
+       *                           ic above 32
+       *
+       * Board, round 132, is the same statement from the other side. With two
+       * live taps in the first group of input channels, output channels 0 to
+       * 31 computed and 32 to 63 came out constant; with the taps in the
+       * second group the halves swapped. Under the layout above an output
+       * channel's weights live in the tile chosen by ITS OWN index, so writing
+       * the second input group where the second output group's tile belongs
+       * puts each half of the output on the wrong half of the buffer, which is
+       * exactly what the surfaces showed.
+       *
+       * ROCKET_PW_ICGROUP restores the previous form and ROCKET_PW_FLAT the
+       * one before that.
+       */
+      bool pw_flat = getenv("ROCKET_PW_FLAT") != NULL;
+      bool pw_icgroup = getenv("ROCKET_PW_ICGROUP") != NULL;
+
+      for (unsigned oc = 0; oc < oc_n; oc++)
+         for (unsigned ic = 0; ic < ic_n; ic++) {
+            unsigned n;
+
+            if (pw_flat) {
+               n = oc * ic_n + ic;
+            } else if (pw_icgroup) {
+               unsigned g = ic / WEIGHT_ATOMIC_SIZE;
+               unsigned r = ic % WEIGHT_ATOMIC_SIZE;
+               unsigned gsz = MIN2(ic_n - g * WEIGHT_ATOMIC_SIZE,
+                                   (unsigned)WEIGHT_ATOMIC_SIZE);
+
+               n = g * oc_n * WEIGHT_ATOMIC_SIZE + oc * gsz + r;
+            } else {
+               unsigned og = oc / WEIGHT_ATOMIC_SIZE;
+               unsigned ig = ic / WEIGHT_ATOMIC_SIZE;
+               unsigned ogsz = MIN2(oc_n - og * WEIGHT_ATOMIC_SIZE,
+                                    (unsigned)WEIGHT_ATOMIC_SIZE);
+               unsigned igsz = MIN2(ic_n - ig * WEIGHT_ATOMIC_SIZE,
+                                    (unsigned)WEIGHT_ATOMIC_SIZE);
