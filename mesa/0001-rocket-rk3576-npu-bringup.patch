+      for (int ky = 0; ky < weights_width; ky++) {
+         for (unsigned oc = 0; oc < oc_n; oc++) {
+            for (int kx = 0; kx < weights_height; kx++) {
+               unsigned base = ky * (oc_n * 16) + oc * 16 + kx * 4;
+
+               for (unsigned ic = 0; ic < 3; ic++)
+                  weights_out[base + ic] =
+                     ic < input_channels_real
+                        ? weights_in[oc][ky][kx][ic] - 0x80 : pad;
+               weights_out[base + 3] = pad; /* alpha lane */
+            }
+         }
+      }
+
+      if (DBG_ENABLED(ROCKET_DBG_DUMP_BOS)) {
+         static int task = 0;
+         rkt_dump_buffer(weights_out, "weights", 0, task++, 0, weights_size);
+      }
+
+      pipe_buffer_unmap(pcontext, transfer_out);
+      pipe_buffer_unmap(pcontext, transfer_in);
+      return rsc;
+   }
