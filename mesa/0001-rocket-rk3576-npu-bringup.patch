+                    : (int16_t)(0x80 - zp_oc);
+            /*
+             * C is a Q14 per-channel scale ratio (=0x4000 for the max-scale channel).
+             * If the HW does NOT apply a built-in >>14 after the BS C-multiply, this
+             * 2^14 compounds with the OUT_CVT cvt_scale -> ~2^14 over-scale -> the
+             * output rails (binary, amplitude-invariant). ROCKET_C_VALUE forces C so we
+             * can test: C=1 -> if output de-saturates/correct, the >>14 is missing and
+             * the 2^14 was the over-scale; if it collapses to out_zp, the HW does shift
+             * and C=0x4000 was right (bug elsewhere).
+             */
+            /*
+             * C is the per-channel scale RATIO (max-scale channel = 1.0) applied by the
+             * BS stage, which then shifts right by 4 (Q4) -- so 1.0 = 16, NOT 0x4000.
+             * Emitting Q14 (16384*rel) over-scaled by 2^10 and railed the output; Q4
+             * (16*rel) gives 93.8% byte-exact vs the relu reference on conv2d-cal. The
+             * absolute scale lives in the OUT_CVT cvt_scale (which already = conv_scale).
+             * NB Q4 is coarse for per-axis (1/16 ratio steps); fine if per-tensor (rel=1).
+             */
+            const char *cval = getenv("ROCKET_C_VALUE");
+            *C = cval ? (int16_t)strtol(cval, NULL, 0)
+                      : (int16_t)(16.0f * rel + 0.5f);
+         }
+biases_done:
+
+         /*
+          * (b) board test: the zeroed float surface stalls the SDP (core
+          * wt_rd=0) -- it is load-bearing. Fill it with a DERIVABLE candidate
+          * (the dense dequant weights) to ask whether a correct ABC + any valid
+          * derivable surface computes, or whether the vendor's exact (blob)
+          * tiling is required. ROCKET_FS_ZERO=1 reverts to the zeroed surface.
+          */
+         if (getenv("ROCKET_FS_SKELETON")) {
+            /*
+             * DERIVABLE SKELETON ONLY: the in_sc constant block + the per-channel
+             * bias array (= -bias_float[oc]); the data-dependent weight scatter is
+             * left zeroed. Tests whether that scatter is load-bearing or whether
+             * the engine computes on the skeleton alone (=> per-axis fully
+             * derivable). Offsets are the captured layout of the 16->128 pointwise
+             * float surface (bias contiguous @ slot 2674+oc; in_sc block @1216).
+             */
+            float *fs = (float *)(b8 + groups * 64);
+            unsigned fcap = (bufsize - groups * 64) / sizeof(float);
+            float in_sc = poperation->input_tensors[0]->scale;
+            const float *wsc = poperation->conv.weight_tensor->scales;
+            for (unsigned i = 1216; i < 1216 + 1456 && i < fcap; i++)
+               fs[i] = in_sc;
+            for (unsigned oc = 0; oc < output_channels; oc++) {
+               float wt = wsc ? wsc[oc] : poperation->conv.weight_tensor->scale;
+               unsigned slot = 2674 + oc;
+               if (slot < fcap)
+                  fs[slot] = -(float)biases_in[oc] * in_sc * wt;
+            }
+         } else if (!getenv("ROCKET_FS_ZERO") &&
+                    !getenv("ROCKET_FS_FLOATS") &&
+                    !getenv("ROCKET_FS_TABLE_OVER") &&
+                    !getenv("ROCKET_FS_HOLE")) {
+            /*
+             * ONE CONSTANT WORD at groups*64, and nothing else in the region.
+             *
+             * What used to be here was a float32 array with one entry per
+             * weight, MAX2(ic*oc*k*k, 8192) of them, 197888 bytes for
+             * conv2d-cal. Measured on hardware, per output channel:
+             *
+             *   keep 1936, 1600, 1024, 512, 256, 128, 64, 32, 16, 8, 4 bytes
+             *       of it and zero the rest        every channel still correct
+             *   keep 0                             no channel correct
+             *
+             * so only the first four bytes were ever doing anything. Varying
+             * that word then showed it is not read as a float at all: flipping
+             * its sign changes nothing, doubling it changes nothing, and
+             * clearing its low byte, worth 0.0005 as a float, destroys every
+             * output channel. Twenty four words later the requirement is
+             *
+             *   (w & 0x3f) == 0x04   and   ((w >> 6) & 0xff) >= T
+             *
+             * with T somewhere in (0x21, 0x3f]; bits 14, 15 and everything
+             * above them are free. 0x1004 satisfies it and is used here.
+             *
+             * ⚠ This is why the 3x3 kernel never worked. The old code filled
+             * that word with a dequantised weight, so whether a model computed
+             * came down to whether its FIRST WEIGHT happened to carry the right
+             * bits. conv2d-cal's did and cal_k3's did not, and every attempt to
+             * explain the difference in terms of kernel size was chasing that
+             * coincidence. With the constant, conv2d-cal, cal_s1, cal_oc16 and
+             * cal_k3 are all correct on every output channel.
+             *
+             * ROCKET_FS_FLOATS restores the old surface, ROCKET_FS_F0 sets this
+             * word to something else.
+             */
+            /*
+             * ROCKET_FS_FILL=<n>: write the word into the first n slots
+             * instead of just the first, 0 meaning fill the whole region.
+             *
+             * One word is enough at 128 output channels and at 16, measured
+             * both ways. It is NOT enough at 1024: mn_pw24 gets 297 of its
+             * 1024 channels with any single known-good word and 408 with the
+             * old per-weight float surface, which is worse than the surface it
+             * replaced. Whatever is consumed there scales with something this
+             * layer has more of, and the floats satisfy the requirement for
+             * more channels by accident than one word does on purpose.
+             */
+            /*
+             * ROCKET_SCALE_TABLE: write the per-channel weight scale as fp16,
+             * one entry per output channel, which is what the vendor puts here.
+             *
+             * Decoded from the runtime capture. The surface 0x5020 points at is
+             *
+             *    [A/B/C table]                 64 B per 8 channels regular,
+             *                                  48 B per 8 channels depthwise
+             *    [oc x fp16 weight scale]      2 bytes per channel
+             *    0x5024 ->  0x0E0E, then zeros
+             *
+             * and the 32 uint16 immediately before the 0x5024 target decode as
+             * fp16 matching the per-channel scale implied by A at +0.998.
+             *
+             * That is what this driver has been writing a single magic word
+             * into: mesa's 0x5024 is bias_addr + groups*64, which lands ON this
+             * table rather than past it, and the constant 0x1004 found by
+             * sweeping is simply fp16 0.00049, a plausible small scale. So the
+             * bitfield rule fitted in rounds 36 and 37 was describing valid
+             * fp16 encodings all along.
+             */
+            uint32_t *fs32 = (uint32_t *)(b8 + table_bytes);
+            /*
+             * ⚠ No `goto biases_done` here: that label is EARLIER in the
+             * function, so jumping to it re-executes everything between and
+             * spins forever. It did, on the board, and looked like a hang.
+             * Write the table and skip the constant word with a flag instead.
+             */
+            /*
+             * The slot holds the per-channel REQUANT MULTIPLIER, in_sc *
+             * wt_sc[oc] / out_sc, as fp16. Not the weight scale.
+             *
+             * Round 47 wrote the weight scale and every working shape broke,
+             * because conv2d-cal's weight scale is 3.9125464 and fp16 of that
+             * is 0x43d3, the value round 28 already proved fails. Reading the
+             * words rounds 36 and 37 swept, as fp16, gives the window directly:
+             *
+             *   pass   0.000474 0.00049 0.000521 0.002937 0.003059 0.003181 0.008331
+             *   fail   0.00013 and below, 2.13 and above
+             *
+             * and in_sc * wt_sc / out_sc for conv2d-cal is 0.00095521, inside
+             * it, while wt_sc alone is far outside. That also explains the
+             * magic word: 0x1004 is 0.00049, the same order as the real
+             * multiplier, and the vendor's captured entries are around 0.0012.
+             *
+             * ROCKET_SCALE_TABLE_WT writes the weight scale instead, which is
+             * what round 47 tested and is kept only so the comparison can be
+             * repeated.
+             */
+            /*
+             * DEFAULT since round 52, which measured it: the fp16 per-channel
+             * weight scale table, with the second operand moved past it, gives
+             * 128/128 on conv2d-cal, cal_k3 and cal_k1, the same as the old
+             * arrangement, and it is the vendor's layout rather than a
+             * constant sitting where a table belongs.
+             *
+             * ROCKET_SCALE_OFF restores the single word at groups*64.
+             */
+            /*
+             * The FIRST CONV wants this region left ZERO.
+             *
+             * conv0 is 32 of 32 channels constant with the arrangement round
+             * 52 made the default, and its output is exactly 128 plus the
+             * OUT_CVT offset with no accumulator contribution at all: sweeping
+             * the output shift over 2^16 does not move a bit of it. Both knobs
+             * that skip this block entirely, ROCKET_FS_ZERO and
+             * ROCKET_FS_FLOATS, bring the MAC back and bring it back
+             * IDENTICALLY, distinct 254 with 4 constant channels, so the
+             * content of the region is irrelevant and only writing to it is
+             * not. ROCKET_SCALE_OFF, which still writes one word there, sits
+             * in between at distinct 60.
+             *
+             * The mechanism is an address collision. fill_regcmd_firstconv
+             * points 0x5024, the second SDP operand, at bias_addr + 0x100 and
+             * always has, while the generic path computes it. For 32 output
+             * channels rkt_coef_table_bytes() is 4 * 64 = 256, which IS 0x100,
+             * so round 52 began writing the fp16 scale entries exactly on top
+             * of the first conv's operand.
+             *
+             * Round 52 changed this for every operation and was regression
+             * tested only on the shapes that already passed. conv0 was not
+             * among them, so this went unseen; it is in the regression set
+             * permanently now.
+             *
+             * ROCKET_FC_SCALE_TABLE forces the table on for a first conv, as
+             * the control.
+             */
+            bool first_conv = rkt_screen(pcontext->screen)->soc == RKT_SOC_RK3576 &&
+                              !rkt_is_depthwise(poperation) &&
+                              poperation->input_tensors[0]->dims[3] <= 4;
+            bool scale_table = getenv("ROCKET_SCALE_OFF") == NULL &&
+                               (!first_conv || getenv("ROCKET_FC_SCALE_TABLE"));
+            if (scale_table) {
+               uint16_t *sc16 = (uint16_t *)(b8 + table_bytes);
+               const float *wsc = poperation->conv.weight_tensor->scales;
+               float wt_sc = poperation->conv.weight_tensor->scale;
+               float in_sc = poperation->input_tensors[0]->scale;
+               float out_sc = poperation->output_tensors[0]->scale;
+               /* The capture's entries match the scale implied by A at +0.998,
+                * so the weight scale is the content; the requant multiplier is
+                * kept behind ROCKET_SCALE_MUL for comparison. */
+               bool raw = getenv("ROCKET_SCALE_MUL") == NULL;
+               for (unsigned oc = 0; oc < output_channels; oc++) {
+                  float w = wsc ? wsc[oc] : wt_sc;
+                  sc16[oc] = _mesa_float_to_half(raw ? w
+                                                     : in_sc * w / out_sc);
+               }
+               /*
+                * And the SECOND OPERAND surface, which round 46 forgot.
+                *
+                * The vendor's layout is [A/B/C][oc fp16 scales][0x0E0E, zeros],
+                * with 0x5024 pointing at that last part. mesa's 0x5024 points
+                * at groups*64, which is where the fp16 scales belong, so the
+                * word this driver writes there has been serving as the second
+                * operand all along. That is why sweeping it mattered and why
+                * the "bitfield rule" of round 36 exists at all: it describes
+                * what mesa's second operand tolerates, not a scale format.
+                *
+                * The vendor's second operand starts with 0x0E0E and is zero
+                * after it, identically in both captured models. Round 46 moved
+                * the pointer past the scale table but never wrote anything at
+                * the new target, so the DPU read zeros. Write it.
+                */
+               if (getenv("ROCKET_SCALE_OFF") == NULL) {
+                  /*
+                   * ⚠ The operand VALUE stays mesa's, not the vendor's.
+                   *
+                   * Round 49 wrote the vendor's 0x0E0E into the slot mesa's
+                   * 0x5024 already points at and got an empty convolution,
+                   * because 0x0E0E violates the round 36 rule that mesa's
+                   * configuration imposes. Round 51 then moved the pointer with
+                   * 0x0E0E at the new target and failed identically, whichever
+                   * content the table held. Same failure, same cause.
+                   *
+                   * So move the pointer but keep a value mesa's own
+                   * configuration accepts. ROCKET_OP2 overrides it.
+                   */
+                  const char *o2 = getenv("ROCKET_OP2");
+                  uint32_t *op2 = (uint32_t *)(b8 + table_bytes +
+                                               output_channels * 2);
+                  op2[0] = o2 ? (uint32_t)strtoul(o2, NULL, 0) : 0x1004;
+               }
+            }
+            unsigned cap = (bufsize - table_bytes) / sizeof(uint32_t);
+            const char *fill = getenv("ROCKET_FS_FILL");
+            unsigned n = fill ? strtoul(fill, NULL, 0) : 1;
+            if (n == 0 || n > cap)
+               n = cap;
+            if (!scale_table && !first_conv)
+               for (unsigned i = 0; i < n; i++)
+                  fs32[i] = 0x1004;
+         } else if (getenv("ROCKET_FS_FLOATS") ||
+                    getenv("ROCKET_FS_TABLE_OVER") || getenv("ROCKET_FS_HOLE")) {
+            const float *wsc = poperation->conv.weight_tensor->scales; /* per-axis */
+            float wt_sc = poperation->conv.weight_tensor->scale;
+            unsigned iw = poperation->conv.weight_tensor->dims[1];
+            unsigned ih = poperation->conv.weight_tensor->dims[2];
+            unsigned icn = poperation->input_tensors[0]->dims[3];
+            int8_t (*wqi)[iw][ih][icn] = weights;  /* per-axis weights: int8, wt_zp=0 */
+            uint8_t (*wqu)[iw][ih][icn] = weights; /* per-tensor weights: uint8 */
+            float *fs = (float *)(b8 + groups * 64);
+            unsigned fcap = (bufsize - groups * 64) / sizeof(float);
+            unsigned fi = 0;
+            for (unsigned oc = 0; oc < output_channels; oc++) {
+               float sc = wsc ? wsc[oc] : wt_sc;
+               for (unsigned x = 0; x < iw; x++)
+                  for (unsigned y = 0; y < ih; y++)
+                     for (unsigned c = 0; c < icn; c++)
+                        if (fi < fcap)
+                           fs[fi++] = wsc ? sc * (int)wqi[oc][x][y][c]
+                                          : wt_sc * ((int)wqu[oc][x][y][c] - (int)wt_zp);
+            }
+         }
+      }
+
+      /*
+       * ROCKET_FS_PERCH=<u16>: write the region at groups*64 the way the VENDOR
+       * writes it, instead of as a float array.
+       *
+       * A vendor capture on 2026-08-09, of two convolutions with 128 output
+       * channels, shows that region holding 256 bytes of 128 uint16, one per
+       * output channel, values around 5400 to 6400 and correlating +0.87 with
+       * the per-channel weight scale, followed by 0e 0e and then zeros. It is a
+       * per-channel 16-bit multiplier.
+       *
+       * What this code writes by default is a float32 dequantised weight
+       * surface, thousands of entries, sized MAX2(ic*oc*k*k, 8192) floats. Same
+       * address, different element type, different length, different meaning.
+       *
+       * The value is passed in rather than derived because the exact formula is
+       * not known yet: the capture correlates with the weight scale but the two
+       * captured models carry different weights, so nothing separates the
+       * per-channel part from the geometry. A single constant is enough to ask
+       * whether the region is load bearing at all.
+       */
+      /*
+       * ROCKET_FS_TAIL=<path>: graft the vendor's coefficient tail on.
+       *
+       * A full 8192-byte dump of the vendor's buffer for two convolutions that
+       * differ in kernel size AND in weights is byte identical from 0x0b90
+       * onward: 5232 bytes made of a 13-byte pattern repeated 54 times, more
+       * constant content, zeros, and finally 1280 uint16 all equal to 0x3c00,
+       * which is fp16 1.0. Model independent, and the vendor's whole buffer is
+       * about 8 KB.
+       *
+       * What this file writes at the same address is one float32 per weight,
+       * MAX2(ic*oc*k*k, 8192) of them, which is 204800 bytes for conv2d-cal. So
+       * this writes the vendor's tail at its own offset and zeroes everything
+       * past the end of it, giving the buffer the vendor's shape while keeping
+       * the A/B/C table this driver computes.
+       *
+       * ⚠ conv2d-cal is the control and it must survive: it computes today with
+       * the float surface and fails when that surface is zeroed, so those floats
+       * are doing something for it. If it survives this, mesa's 200 KB of floats
+       * are not needed and the buffer is far simpler than assumed. If it breaks,
+       * the vendor's structure cannot be grafted on piecemeal.
+       */
+      /*
+       * ROCKET_FS_MIDZERO: zero the slice between the A/B/C table and the tail.
+       *
+       * With the tail grafted, everything from 0x0b90 on is byte identical
+       * between models, conv2d-cal is correct and cal_k3 is still flat at the
+       * zero point, so the kernel dependence is not in the tail. What is left
+       * k-dependent in this buffer is 0x400 to 0x0b90, still holding the first
+       * 1936 bytes of the float surface. Zeroing exactly that slice says
+       * whether the buffer carries the dependence at all.
+       */
+      if (getenv("ROCKET_FS_MIDZERO") && bufsize > 0x0b90)
+         memset(b8 + 0x400, 0, 0x0b90 - 0x400);
+
+      /*
+       * ROCKET_FS_KEEP=<n>: keep the first n bytes of the float surface and
+       * zero the rest of it, up to 0x0b90.
+       *
+       * The extent of what this driver actually needs there has never been
+       * measured. 0x0b90 was picked because that is where the VENDOR's constant
+       * tail begins, which says nothing about mesa. What is known is only that
+       * keeping 0x400..0x0b90 works and zeroing all of it fails, so the answer
+       * is somewhere in those 1936 bytes.
+       *
+       * Round 30 ruled out reading it as a per-channel table: changing the first
+       * 256 bytes destroys all 128 output channels uniformly rather than the 64
+       * a 4-byte-per-channel layout would touch, and substituting a plausible
+       * large float fails exactly like substituting zero. So stop assigning it a
+       * meaning and measure its size instead.
+       *
+       * Sizes worth landing on, for conv2d-cal at ic=16 oc=128 k=5:
+       *    512 = 128 floats = one per output channel
+       *   1600 = 400 floats = ic*k*k, one output channel's worth of weights
+       *   1936 = the whole slice, which must pass, and 0 must fail
+       */
+      /*
+       * ROCKET_FS_F0=<value>: overwrite the FIRST float of the surface, and
+       * nothing else. Accepts a decimal float or a 0x raw word, because it is
+       * not yet established that the hardware reads it as a float at all.
+       *
+       * Round 32 bisected the slice down to this one word: keeping 4 bytes
+       * leaves all 128 output channels correct and keeping 0 leaves none. A
+       * different nonzero value there fails too, 0x43d343d3 which is about
+       * 423.3, while the value mesa happens to write, -109.55, works. So one
+       * scalar decides the whole layer and it has to be the right one, and the
+       * question is what "right" means: the exact dequantised weight, a sign, a
+       * magnitude, or a bit pattern that is not a float at all.
+       */
+      const char *f0 = getenv("ROCKET_FS_F0");
+
+      /*
+       * ⚠ The surface starts at groups*64, which is 0x400 only because oc=128
+       * in every model probed so far. With oc=16 it is 0x80, and the knobs
+       * below would have written into the A/B/C table instead of the surface,
+       * making any result on such a model meaningless.
+       */
+      unsigned fs_off = groups * 64;
+      const char *keep = getenv("ROCKET_FS_KEEP");
+      if (keep && bufsize > 0x0b90) {
+         unsigned n = strtoul(keep, NULL, 0);
+         if (fs_off + n < 0x0b90)
+            memset(b8 + fs_off + n, 0, 0x0b90 - fs_off - n);
+      }
+
+      if (f0) {
+         uint32_t w;
+         if (f0[0] == '0' && (f0[1] == 'x' || f0[1] == 'X')) {
+            w = strtoul(f0, NULL, 16);
+         } else {
+            float v = strtof(f0, NULL);
+            memcpy(&w, &v, sizeof(w));
+         }
+         memcpy(b8 + fs_off, &w, sizeof(w));
+      }
+
+      /*
+       * ROCKET_FS_TABLE_OVER / ROCKET_FS_HOLE: separate the two things round 28
+       * changed together.
+       *
+       * Round 27 zeroed 0x400..0x0b90 and conv2d-cal broke. Round 28 wrote the
+       * per-channel fp16 table at 0x400 and left everything after it zero, and
+       * it broke too, while the old float surface computes and the zeroed-table
+       * control fails as it should. Neither round says whether what the model
+       * needs is the table's own bytes or the rest of the surface behind it,
+       * because both rounds moved both.
+       *
+       * TABLE_OVER writes the float surface exactly as the configuration that
+       * computes does, then overwrites only the table's 2*oc bytes, so the
+       * table is the ONLY difference from a passing run. HOLE is its
+       * complement: the same surface with only those bytes zeroed.
+       *
+       *   TABLE_OVER computes  the table is compatible and the earlier
+       *                        breakage was the zeroed remainder
+       *   TABLE_OVER breaks    those bytes must hold mesa's floats, and the
+       *                        offline reading does not carry over to what this
+       *                        driver puts in the rest of the buffer
+       *   HOLE breaks          confirms the slice is load bearing by itself,
+       *                        which is what makes TABLE_OVER readable
+       *   HOLE computes        the slice is NOT load bearing on its own and
+       *                        round 27's failure was entirely the remainder
+       */
+      if (getenv("ROCKET_FS_TABLE_OVER") || getenv("ROCKET_FS_HOLE")) {
+         const float *wsc = poperation->conv.weight_tensor->scales;
+         float wt_sc = poperation->conv.weight_tensor->scale;
+         uint16_t *fs16 = (uint16_t *)(b8 + groups * 64);
+         for (unsigned oc = 0; oc < output_channels; oc++)
+            fs16[oc] = getenv("ROCKET_FS_HOLE")
+                          ? 0
+                          : _mesa_float_to_half(wsc ? wsc[oc] : wt_sc);
+      }
+
+      const char *tailf = getenv("ROCKET_FS_TAIL");
+      if (tailf && bufsize > 0x0b90) {
+         FILE *f = fopen(tailf, "rb");
+         if (f) {
+            size_t n = fread(b8 + 0x0b90, 1, bufsize - 0x0b90, f);
+            fclose(f);
+            if (0x0b90 + n < bufsize)
+               memset(b8 + 0x0b90 + n, 0, bufsize - 0x0b90 - n);
+         }
+      }
+
+      if (getenv("ROCKET_FS_PERCH")) {
+         uint16_t v = (uint16_t)strtoul(getenv("ROCKET_FS_PERCH"), NULL, 0);
+         uint8_t *p8 = b8 + groups * 64;
+         memset(p8, 0, bufsize - groups * 64);
+         for (unsigned oc = 0; oc < output_channels; oc++)
+            ((uint16_t *)p8)[oc] = v;
+         ((uint16_t *)p8)[output_channels] = 0x0e0e;
+      }
+
+      if (DBG_ENABLED(ROCKET_DBG_DUMP_BOS)) {
+         static int task = 0;
+         rkt_dump_buffer(b8, "biases", 0, task++, 0, bufsize);
+      }
+      pipe_buffer_unmap(pcontext, transfer_out);
+      pipe_buffer_unmap(pcontext, transfer_weights);
+      pipe_buffer_unmap(pcontext, transfer_in);
+      return rsc;
+   }
+
    rsc = pipe_buffer_create(pcontext->screen, 0, PIPE_USAGE_DEFAULT,
                             output_channels * sizeof(uint32_t));
    biases = pipe_buffer_map(pcontext, rsc, PIPE_MAP_WRITE, &transfer_out);
diff --git a/src/gallium/drivers/rocket/rkt_coefs.h b/src/gallium/drivers/rocket/rkt_coefs.h
index d670cec..508c8da 100644
--- a/src/gallium/drivers/rocket/rkt_coefs.h
+++ b/src/gallium/drivers/rocket/rkt_coefs.h
@@ -6,6 +6,8 @@
 #ifndef RKT_COEFS_H
 #define RKT_COEFS_H
 
+#include <stdlib.h>
+
 #include "rkt_ml.h"
 
 struct pipe_resource *
@@ -17,4 +19,40 @@ rkt_fill_biases(struct rkt_ml_subgraph *subgraph,
                 const struct pipe_ml_operation *poperation,
                 unsigned *truncate_bits);
 
+/*
+ * Bytes of the per-channel coefficient table that sits at the start of the
+ * 0x5020 surface, before the fp16 weight scale table.
+ *
