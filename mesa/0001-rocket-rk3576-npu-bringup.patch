+    * group0 -> read empty -> zero). Pin all 4 units PP_MODE OFF (0x06) so
+    * producer+consumers stay on group0 together. */
+   uint32_t sptr = tile_jobs ? rkt_env_u32("ROCKET_TILE_SPTR", 0x00000004u)
