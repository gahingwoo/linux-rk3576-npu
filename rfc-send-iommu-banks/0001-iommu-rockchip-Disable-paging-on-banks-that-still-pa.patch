From 03e9a7cba2057b3ec359c8f793324e2a7866f05d Mon Sep 17 00:00:00 2001
From: Jiaxing Hu <gahing@gahingwoo.com>
Date: Mon, 23 Nov 2026 22:13:52 +1300
Subject: [PATCH] iommu/rockchip: Disable paging on banks that still page
 before a force reset

A reset of the master can leave the banks of one IOMMU in different
states. On the RK3576 NPU, after a job timeout makes the NPU driver
reset the core, bank 0 of that core's IOMMU keeps paging with the old
directory (STATUS 0x19) while bank 1 is back in reset state.

rk_iommu_is_paging_enabled() and rk_iommu_is_stall_active() are true
only when every bank agrees, so rk_iommu_enable_stall(),
rk_iommu_disable_paging() and rk_iommu_disable_stall() all do nothing
for such an IOMMU. The force reset in rk_iommu_enable() then finds that
bank 0 ignores its DTE_ADDR write, fails with "MMU_DTE_ADDR is not
functioning", and so does every later enable. The device behind the
IOMMU never gets its translation back.

When the banks disagree on paging, stall each bank that still pages,
disable its paging and release the stall, one bank at a time, before
the normal enable sequence. Banks that agree are not touched. Also print
each bank's STATUS and DTE_ADDR when the DTE_ADDR check fails.

Tested on a Radxa ROCK 4D (RK3576) with forced job timeouts on the NPU,
each followed at once by another job. Without this patch, one of every
2 to 10 such timeouts left the NPU's IOMMUs failing every enable until
the NPU driver was rebound. With it, 20 of 20 recovered, there were no
IOMMU errors, and the new message reported bank 0 still paging, with
status 0x19, on both NPU cores.

Fixes: cd6438c5f844 ("iommu/rockchip: Reconstruct to support multi slaves")
Signed-off-by: Jiaxing Hu <gahing@gahingwoo.com>
---
This came out of testing the RK3576 NPU series [1]: job timeouts forced
on the NPU with a 1 ms scheduler timeout, each followed at once by the
next job. The bank 0 state is the one Fexiven described in [2].

It touches the same file as Anton Sovetov's RFC [3], but not the same
code: that one is about the pm_runtime_get_if_in_use() checks in attach,
zap and the interrupt handler, this one about the enable sequence when
the banks disagree.

Tested only on the RK3576. The RK3588 NPU MMUs have two banks too; I
have not run this there.

Tool use: an LLM helped me find the cause and wrote this patch and its
message. I reviewed both and ran the tests above on the board.

[1] https://lore.kernel.org/all/cover.1794615324.git.gahing@gahingwoo.com/
[2] https://github.com/gahingwoo/linux-rk3576-npu/issues/3
[3] https://lore.kernel.org/all/CANLiQWrVGN00Hn8s3X7nyDZxh3x0wJ1YqTVzYsLUPM3s-Pkp1A@mail.gmail.com/

 drivers/iommu/rockchip-iommu.c | 69 ++++++++++++++++++++++++++++++++++
 1 file changed, 69 insertions(+)

diff --git a/drivers/iommu/rockchip-iommu.c b/drivers/iommu/rockchip-iommu.c
index 1fa3110b142a..aef36e9fce0a 100644
--- a/drivers/iommu/rockchip-iommu.c
+++ b/drivers/iommu/rockchip-iommu.c
@@ -507,6 +507,69 @@ static int rk_iommu_disable_paging(struct rk_iommu *iommu)
 	return ret;
 }
 
+/*
+ * A reset of the master can leave the banks of one IOMMU in different
+ * states: on the RK3576 NPU the core reset puts one bank back to reset
+ * state while the other keeps paging with the old directory. The
+ * helpers above treat "paging enabled" and "stall active" as true only
+ * when every bank agrees, so they skip such an IOMMU, and the paging
+ * bank then ignores the DTE_ADDR writes of the force reset. Stall and
+ * stop paging on the banks that still page, one bank at a time.
+ */
+static void rk_iommu_quiesce_paging_banks(struct rk_iommu *iommu)
+{
+	int i, ret;
+	u32 status;
+
+	for (i = 0; i < iommu->num_mmu; i++) {
+		void __iomem *base = iommu->bases[i];
+
+		if (!(rk_iommu_read(base, RK_MMU_STATUS) & RK_MMU_STATUS_PAGING_ENABLED))
+			continue;
+
+		dev_warn_ratelimited(iommu->dev, "bank %d still paging, status %#08x; disabling it\n",
+				     i, rk_iommu_read(base, RK_MMU_STATUS));
+
+		if (rk_iommu_read(base, RK_MMU_STATUS) & RK_MMU_STATUS_PAGE_FAULT_ACTIVE)
+			writel(RK_MMU_CMD_PAGE_FAULT_DONE, base + RK_MMU_COMMAND);
+
+		rk_iommu_base_command(base, RK_MMU_CMD_ENABLE_STALL);
+		ret = readl_poll_timeout(base + RK_MMU_STATUS, status,
+					 status & RK_MMU_STATUS_STALL_ACTIVE,
+					 RK_MMU_POLL_PERIOD_US, RK_MMU_POLL_TIMEOUT_US);
+		if (ret)
+			dev_err(iommu->dev, "bank %d: stall timed out, status %#08x\n",
+				i, status);
+
+		rk_iommu_base_command(base, RK_MMU_CMD_DISABLE_PAGING);
+		ret = readl_poll_timeout(base + RK_MMU_STATUS, status,
+					 !(status & RK_MMU_STATUS_PAGING_ENABLED),
+					 RK_MMU_POLL_PERIOD_US, RK_MMU_POLL_TIMEOUT_US);
+		if (ret)
+			dev_err(iommu->dev, "bank %d: disable paging timed out, status %#08x\n",
+				i, status);
+
+		rk_iommu_base_command(base, RK_MMU_CMD_DISABLE_STALL);
+		ret = readl_poll_timeout(base + RK_MMU_STATUS, status,
+					 !(status & RK_MMU_STATUS_STALL_ACTIVE),
+					 RK_MMU_POLL_PERIOD_US, RK_MMU_POLL_TIMEOUT_US);
+		if (ret)
+			dev_err(iommu->dev, "bank %d: disable stall timed out, status %#08x\n",
+				i, status);
+	}
+}
+
+static bool rk_iommu_banks_disagree_on_paging(struct rk_iommu *iommu)
+{
+	int i, n = 0;
+
+	for (i = 0; i < iommu->num_mmu; i++)
+		n += !!(rk_iommu_read(iommu->bases[i], RK_MMU_STATUS) &
+			RK_MMU_STATUS_PAGING_ENABLED);
+
+	return n && n != iommu->num_mmu;
+}
+
 static int rk_iommu_force_reset(struct rk_iommu *iommu)
 {
 	int ret, i;
@@ -525,6 +588,9 @@ static int rk_iommu_force_reset(struct rk_iommu *iommu)
 		rk_iommu_write(iommu->bases[i], RK_MMU_DTE_ADDR, dte_addr);
 
 		if (dte_addr != rk_iommu_read(iommu->bases[i], RK_MMU_DTE_ADDR)) {
+			dev_err_ratelimited(iommu->dev, "bank %d status %#08x DTE_ADDR %#08x\n", i,
+					    rk_iommu_read(iommu->bases[i], RK_MMU_STATUS),
+					    rk_iommu_read(iommu->bases[i], RK_MMU_DTE_ADDR));
 			dev_err(iommu->dev, "Error during raw reset. MMU_DTE_ADDR is not functioning\n");
 			return -EFAULT;
 		}
@@ -947,6 +1013,9 @@ static int rk_iommu_enable(struct rk_iommu *iommu)
 	if (ret)
 		return ret;
 
+	if (rk_iommu_banks_disagree_on_paging(iommu))
+		rk_iommu_quiesce_paging_banks(iommu);
+
 	ret = rk_iommu_enable_stall(iommu);
 	if (ret)
 		goto out_disable_clocks;

