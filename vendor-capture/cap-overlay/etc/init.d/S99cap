#!/bin/sh
# Copyright (c) 2026 Jiaxing Hu <gahing@gahingwoo.com>
# SPDX-License-Identifier: GPL-2.0
# Run the vendor LLM capture at boot and put everything on the console, so the
# capture image reads the same way every other round does.
C=/dev/console
case "$1" in
start)
	echo "" > "$C"
	echo "##### VENDOR CAPTURE: one int4 op, with its buffers          #####" > "$C"
	i=0
	while [ ! -e /dev/dri/card0 ] && [ ! -e /dev/rknpu ] && [ "$i" -lt 20 ]; do
		sleep 0.5; i=$((i + 1))
	done
	ls -l /dev/dri /dev/rknpu 2>&1 > "$C" 2>&1
	dmesg | grep -i "rknpu\|npu" | head -20 > "$C" 2>&1
	/opt/vendor/run-llm-capture.sh > "$C" 2>&1
	echo "##### capture done                                            #####" > "$C"
	sync
	;;
esac
exit 0
